	var center_w := 0.46

	func _draw() -> void:
		var w := size.x
		var h := size.y
		if w < 200 or h < raise + 10:
			return
		var cx0 := w * (0.5 - center_w / 2.0)
		var cx1 := w * (0.5 + center_w / 2.0)
		var shape := PackedVector2Array([Vector2(0, raise), Vector2(cx0 - 30, raise), Vector2(cx0, 0), Vector2(cx1, 0), Vector2(cx1 + 30, raise), Vector2(w, raise), Vector2(w, h), Vector2(0, h)])
		draw_colored_polygon(PackedVector2Array([shape[0] + Vector2(0, -6), shape[1] + Vector2(0, -6), shape[2] + Vector2(0, -6), shape[3] + Vector2(0, -6), shape[4] + Vector2(0, -6), shape[5] + Vector2(0, -6), shape[6], shape[7]]), Color(0, 0, 0, 0.45))
		draw_colored_polygon(shape, UIParts.STONE)
		for i in 7:
			var y := raise + 8 + i * (h - raise) / 7.0
			draw_line(Vector2(0, y), Vector2(w, y), Color(1, 1, 1, 0.012), 6.0)
		var edge := PackedVector2Array([shape[0], shape[1], shape[2], shape[3], shape[4], shape[5]])
		draw_polyline(edge, UIParts.BRONZE_DARK, 7.0, true)
		draw_polyline(edge, UIParts.BRONZE, 3.5, true)
		draw_polyline(edge, UIParts.BRONZE_LITE, 1.2, true)
		for x in [cx0, cx1]:
			var stud := Vector2(x, 2)
			draw_circle(stud, 7, UIParts.BRONZE_DARK)
			draw_circle(stud, 5, UIParts.BRONZE)
			draw_circle(stud - Vector2(1.5, 1.5), 2, UIParts.BRONZE_LITE)


