static func tree(hero: String) -> Array:
	var d := champ(hero)
	var cap: Dictionary = CAPSTONES.get(d["role"], CAPSTONES["Fighter"])
	var own: Array = HERO_TALENTS.get(hero, HERO_TALENTS["grond"])
