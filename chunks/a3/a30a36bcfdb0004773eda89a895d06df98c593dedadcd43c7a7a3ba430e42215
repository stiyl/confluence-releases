# 0.17: one hover state for every UIParts button. `hov` eases 0..1 in ~80 ms; the button lifts a touch
# (scale about its centre, so layouts don't move) and hover_draw paints a bright 2 px outline, a brighten
# wash and a darker, sunken pressed state. Off with Settings.hover_hl (the old flat look stays).
static func hover_tick(b: Control, hov: float, delta: float, hovered: bool) -> float:
	var target := 1.0 if hovered and Settings.hover_hl else 0.0
	hov = move_toward(hov, target, delta / 0.08)
	if hov > 0.001 or b.scale != Vector2.ONE:
		b.pivot_offset = b.size / 2.0
		var held := hovered and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
		b.scale = Vector2.ONE * (1.0 + (0.035 - (0.06 if held else 0.0)) * hov)
	return hov


static func hover_held(b: Control) -> bool:
	return b.scale.x < 0.999


static func hover_draw(ci: CanvasItem, r: Rect2, hov: float, held: bool) -> void:
	if hov <= 0.01:
		return
	if held:
		ci.draw_rect(r, Color(0, 0, 0, 0.22 * hov))
	else:
		ci.draw_rect(r, Color(1.0, 0.92, 0.7, 0.1 * hov))
	ci.draw_rect(r.grow(1), Color(1.0, 0.95, 0.78, 0.95 * hov), false, 2.0)
	ci.draw_rect(r.grow(3), Color(1.0, 0.9, 0.6, 0.25 * hov), false, 1.0)


# A square command-card button. icon_kind is a skill act type, "passive", or "mon:<kind>".
class CmdButton extends Button:
	var icon_kind := ""
	var tint := Color(0.5, 0.5, 0.5)
	var hotkey := ""
	var corner := ""          # small text bottom-right (cost); with price_strip, a strip under the icon
	var price_strip := false  # draw `corner` on its own strip below the icon square (shop items)
	var cd_frac := 0.0        # 0..1 remaining cooldown
	var cd_text := ""
	var gold_frame := false
	var unusable := false
	var flash := 0.0
	var locked := false
	var badge := ""
	var rank := -1            # ability rank pips (0-4); -1 hides them
	var learnable := false    # glowing frame: an ability point can go here
	var selected := false
	var warn := false         # amber marker top-left: the shop uses it for a unique passive you already own
	var mark := ""            # short coloured tag along the bottom-left (send buttons: HEAL, HASTE, FLY...)
	var mark_col := Color(1, 1, 1)
	var _t := 0.0
	var _hov := 0.0           # 0.17 hover ease (UIParts.hover_tick)

	const STRIP_H := 15.0

	func _init() -> void:
		focus_mode = Control.FOCUS_NONE
		flat = true
		for st in ["normal", "hover", "pressed", "disabled", "focus", "hover_pressed"]:
			add_theme_stylebox_override(st, StyleBoxEmpty.new())

	func _process(delta: float) -> void:
		_t += delta
		if flash > 0:
			flash -= delta
		_hov = UIParts.hover_tick(self, _hov, delta, is_hovered() and not disabled)
		queue_redraw()

	func _draw() -> void:
		var strip := price_strip and corner != ""
		var sz := Vector2(size.x, size.y - (STRIP_H if price_strip else 0.0))
		var r := Rect2(Vector2.ZERO, sz)
		var tier := UIParts.item_tier(icon_kind)
		ci_fill(r)
		if warn:
			var wc := Vector2(11, 11)
			draw_colored_polygon(PackedVector2Array([wc + Vector2(0, -8), wc + Vector2(8, 0), wc + Vector2(0, 8), wc + Vector2(-8, 0)]), Color(0, 0, 0, 0.85))
			draw_colored_polygon(PackedVector2Array([wc + Vector2(0, -6), wc + Vector2(6, 0), wc + Vector2(0, 6), wc + Vector2(-6, 0)]), Color(1.0, 0.72, 0.25))
			draw_rect(Rect2(wc + Vector2(-1, -4), Vector2(2, 5)), Color(0.15, 0.1, 0.05))
			draw_rect(Rect2(wc + Vector2(-1, 2), Vector2(2, 2)), Color(0.15, 0.1, 0.05))
		var inner := r.grow(-4)
		var is_ab := icon_kind.begins_with("ab:")
		var unlearned := is_ab and rank == 0
		if is_ab:
			var at := UIParts.ability_tex(icon_kind.substr(3), unlearned)
			if at != null:
				draw_texture_rect(at, inner, false, Color(1, 1, 1, 1) if not unlearned else Color(0.92, 0.92, 0.92))
			else:
				UIParts.draw_glyph(self, "passive", inner.grow(-3), tint)
		elif icon_kind.begins_with("mon:"):
			var kind := icon_kind.substr(4)
			if not UIParts.draw_tight(self, Sprites.mon_sheet(kind), inner.grow(-3), 3):
				draw_circle(inner.get_center(), inner.size.x * 0.3, Color(GameData.MON[kind]["col"]))
		elif icon_kind.begins_with("bld:"):
			if not Sprites.draw_fit(self, "bld_" + icon_kind.substr(4), inner.grow(2), 0, 0, 1.15):
				UIParts.draw_glyph(self, "summon", inner.grow(-3), tint)
		elif icon_kind.begins_with("item:"):
			if not Sprites.draw_fit(self, "item_" + icon_kind.substr(5), inner, 0, 0, 1.0):
				UIParts.draw_glyph(self, "passive", inner.grow(-3), tint)
		elif icon_kind.begins_with("prop:"):
			if not Sprites.draw_fit(self, icon_kind.substr(5), inner.grow(2), 0, 0, 1.1):
				UIParts.draw_glyph(self, "passive", inner.grow(-3), tint)
		elif icon_kind == "empty":
			pass
		else:
			UIParts.draw_glyph(self, icon_kind, inner.grow(-3), tint)
		UIParts.bevel(self, inner, Color(1, 1, 1, 0.16), Color(0, 0, 0, 0.45), 2.0)
		if cd_frac > 0.005:
			# clock-sweep cooldown, drawn as a fan of triangles clipped to the square
			var ctr := inner.get_center()
			var start := -PI / 2 + TAU * (1.0 - cd_frac)
			var steps := maxi(2, int(32 * cd_frac))
			var prev := Vector2.ZERO
			for i in steps + 1:
				var d := Vector2.from_angle(start + (TAU * cd_frac) * i / steps)
				var k := minf(inner.size.x / 2.0 / maxf(absf(d.x), 0.001), inner.size.y / 2.0 / maxf(absf(d.y), 0.001))
				var q := ctr + d * k
				if i > 0 and absf((prev - ctr).cross(q - ctr)) > 0.01:
					draw_colored_polygon(PackedVector2Array([ctr, prev, q]), Color(0, 0, 0, 0.62))
				prev = q
		if rank == 0 and not is_ab:
			draw_rect(inner, Color(0.02, 0.02, 0.03, 0.6))
		elif unlearned:
			draw_rect(inner, Color(0.02, 0.02, 0.03, 0.22))
		var mon := icon_kind.begins_with("mon:") or icon_kind.begins_with("bld:")
		if disabled or unusable or locked:
			draw_rect(inner, Color(0.05, 0.03, 0.02, (0.3 if mon else 0.62) if locked else (0.25 if mon else 0.55)))
		if locked:
			if mon:
				# a small corner lock, so the monster stays readable behind it
				UIParts.lock_glyph(self, Vector2(inner.end.x - 9, inner.end.y - 9), 0.75)
			else:
				UIParts.lock_glyph(self, inner.get_center() + Vector2(0, 2), 1.0)
		elif unlearned and not learnable:
			UIParts.lock_glyph(self, Vector2(inner.end.x - 8, inner.position.y + 9), 0.62)
		if is_hovered() and not disabled:
			draw_rect(inner, Color(1, 1, 0.97, 0.1))
		if flash > 0:
			draw_rect(inner, Color(1, 1, 0.97, flash * 1.5))
		if tier > 0:
			UIParts.tier_frame(self, r.grow(-1), tier, _t)
			if is_hovered() and not disabled:
				draw_rect(r.grow(-1), Color(1, 1, 1, 0.35), false, 1.0)
		else:
			UIParts.framed(self, r.grow(-1), gold_frame or selected or (is_hovered() and not disabled))
		if learnable:
			var a := 0.55 + 0.45 * sin(_t * 6.0)
			draw_rect(r.grow(-1), Color(0.55, 1.0, 0.5, a), false, 2.5)
		if selected:
			draw_rect(r.grow(-2), Color(UIParts.GOLD_TEXT, 0.95), false, 2.0)
		if rank >= 0:
			var pw := 7.0
			var gap := 3.0
			var x0 := (sz.x - (4 * pw + 3 * gap)) / 2.0
			for k in 4:
				var pr := Rect2(x0 + k * (pw + gap), sz.y - 10, pw, 5)
				draw_rect(pr.grow(1), Color(0, 0, 0, 0.85))
				draw_rect(pr, UIParts.GOLD_TEXT if k < rank else Color(0.36, 0.33, 0.28))
		var f := UIParts.font("num_semi")
		if hotkey != "":
			UIParts.keycap(self, Vector2(3, 3), hotkey, 11 if sz.x >= 44 else 10, 14.0)
		if cd_text != "":
			draw_string_outline(f, Vector2(0, sz.y * 0.62), cd_text, HORIZONTAL_ALIGNMENT_CENTER, sz.x, 17, 4, Color.BLACK)
			draw_string(f, Vector2(0, sz.y * 0.62), cd_text, HORIZONTAL_ALIGNMENT_CENTER, sz.x, 17, Color.WHITE)
		if badge != "":
			var bw := f.get_string_size(badge, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x + 8.0
			draw_rect(Rect2(sz.x - bw - 4, 4, bw, 16), Color(0.1, 0.35, 0.12, 0.92))
			draw_string(f, Vector2(sz.x - bw - 4, 16.5), badge, HORIZONTAL_ALIGNMENT_CENTER, bw, 12, Color(0.75, 1.0, 0.75))
		if strip:
			var sr := Rect2(1, sz.y + 1, size.x - 2, STRIP_H - 2)
			draw_rect(sr, Color(0.04, 0.035, 0.03, 0.95))
			draw_rect(sr, Color(UIParts.TIER_COL[tier] if tier > 0 else UIParts.BRONZE_DARK, 0.6), false, 1.0)
			var pc := Color(1.0, 0.45, 0.35) if unusable else UIParts.COIN_LITE
			draw_string(f, Vector2(0, sz.y + STRIP_H - 3.5), corner, HORIZONTAL_ALIGNMENT_CENTER, size.x, 11, pc)
		elif corner != "":
			draw_string_outline(f, Vector2(0, sz.y - 6), corner, HORIZONTAL_ALIGNMENT_RIGHT, sz.x - 6, 11, 3, Color.BLACK)
			draw_string(f, Vector2(0, sz.y - 6), corner, HORIZONTAL_ALIGNMENT_RIGHT, sz.x - 6, 11, UIParts.COIN_LITE)
		if mark != "" and badge == "":
			var mw := f.get_string_size(mark, HORIZONTAL_ALIGNMENT_LEFT, -1, 9).x + 6.0
			var mr := Rect2(sz.x - mw - 3, 3, mw, 13)
			draw_rect(mr, Color(mark_col.darkened(0.6), 0.95))
			draw_rect(mr, mark_col, false, 1.0)
			draw_string(f, Vector2(mr.position.x, 13), mark, HORIZONTAL_ALIGNMENT_CENTER, mw, 9, mark_col.lightened(0.5))
		UIParts.hover_draw(self, Rect2(Vector2.ZERO, size).grow(-1), _hov, UIParts.hover_held(self))

	func ci_fill(r: Rect2) -> void:
		var inner := r.grow(-4)
		if icon_kind.begins_with("item:") or icon_kind.begins_with("prop:") or icon_kind == "empty":
			UIParts.gradient_fill(self, inner, Color(0.22, 0.19, 0.15), Color(0.07, 0.06, 0.05))
			var tr := UIParts.item_tier(icon_kind)
			if tr >= 2:
				draw_circle(inner.get_center(), inner.size.x * 0.42, Color(UIParts.TIER_COL[tr], 0.1))
