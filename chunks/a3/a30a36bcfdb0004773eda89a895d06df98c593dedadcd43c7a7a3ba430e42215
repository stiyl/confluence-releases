# ---------------------------------------------------------------- state
# The set the panel edits: the running match's (host or single-player) or the draft.
func live_set() -> Dictionary:
	if main.sim != null and not main.replay_mode:
		return main.sim.tune
	if main.net != null and main.net.in_lobby and main.net.lobby.has("tune"):
		return main.net.lobby["tune"]   # the host's set for the coming match (the host's own draft mirrored)
	return Tune.load_draft()


func _value(name: String) -> float:
	return Tune.value_in(live_set(), name)


func read_only() -> bool:
	return (main.mp() and not main.net.is_host) or main.replay_mode or (main.net != null and main.net.in_lobby and not main.net.is_host)


func in_match() -> bool:
	return main.sim != null and not main.replay_mode


func open() -> void:
	visible = true
	move_to_front()
	save_box.visible = false
	msg_lbl.text = ""
	_fill_presets()
	set_group(group)


func close() -> void:
	visible = false
	save_box.visible = false


func toggle() -> void:
	if visible:
		close()
	else:
		open()


func set_group(g: String) -> void:
	group = g
	for i in tabs.size():
		tabs[i].set_pressed_no_signal(Tune.GROUPS[i] == g)
	for ch in rows_box.get_children():
		rows_box.remove_child(ch)
		ch.queue_free()
	rows.clear()
	mrows.clear()
	msections.clear()
	filter_box.visible = g == "Monsters"
	if g == "Monsters":
		_make_monsters()
	else:
		for n in Tune.names_in(g):
			_make_row(n)
	refresh()


