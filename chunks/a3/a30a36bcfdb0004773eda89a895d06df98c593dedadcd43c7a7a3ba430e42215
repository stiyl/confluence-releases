const PORTRAIT_DIRS := 5


static func portrait_tex(name: String) -> Texture2D:
	var ck := "portrait|" + portrait_dir + name
	if _cache.has(ck):
		return _cache[ck]
	var t: Texture2D = null
	var path := portrait_dir + name + ".png"
	if path.begins_with("res://"):
