# ---- ability icons (art/ui/abilities/<hero>_<i>.png, baked by tools/bake_ability_icons.gd from the fx models).
# icon_kind "ab:<hero>:<i>". Unlearned icons use a desaturated copy that keeps its contrast.
const TIER_COL := [Color("#8a8070"), Color("#a9a39a"), Color("#4fc76a"), Color("#ff8a2a"), Color("#b46cff")]
static var _ab_tex := {}
static var _ab_by_name := {}


static func ability_key(skill_name: String) -> String:
	if _ab_by_name.is_empty():
		for c in GameData.CHAMPS:
			for i in c["skills"].size():
				_ab_by_name[String(c["skills"][i]["name"])] = "%s:%d" % [c["id"], i]
	return _ab_by_name.get(skill_name, "")


static func ability_tex(key: String, grey := false) -> Texture2D:
	var ck := key + ("|g" if grey else "")
	if _ab_tex.has(ck):
		return _ab_tex[ck]
	var t: Texture2D = null
	var path := "res://art/ui/abilities/%s.png" % key.replace(":", "_")
	if ResourceLoader.exists(path):
		t = load(path)
		if grey and t != null:
			var img := t.get_image()
			if img != null:
				img = img.duplicate()
				if img.is_compressed():
					img.decompress()
				img.convert(Image.FORMAT_RGBA8)
				for y in img.get_height():
					for x in img.get_width():
						var c := img.get_pixel(x, y)
						var l := c.r * 0.3 + c.g * 0.55 + c.b * 0.15
						# desaturate, lift the darks a little and stretch the contrast so the shape still reads
						var v := clampf(0.16 + (l - 0.1) * 1.25, 0.0, 1.0)
						img.set_pixel(x, y, Color(v, v * 0.97, v * 0.92, c.a))
				t = ImageTexture.create_from_image(img)
	_ab_tex[ck] = t
	return t


