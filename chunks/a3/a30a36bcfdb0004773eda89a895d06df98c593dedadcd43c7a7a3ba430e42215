func _num_field(name: String) -> LineEdit:
	var field := LineEdit.new()
	field.custom_minimum_size = Vector2(64, 26)
	field.alignment = HORIZONTAL_ALIGNMENT_RIGHT
	field.add_theme_font_override("font", UIParts.font("num"))
