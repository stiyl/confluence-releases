# The highest tier (0 = none, 1..3) a count of cards reaches.
static func syn_tier(n: int) -> int:
	var t := 0
	for i in SYN_TIERS.size():
		if n >= SYN_TIERS[i]:
			t = i + 1
	return t


# ---------------------------------------------------------------- reroll / banish costs
# Rerolling replaces the whole offer, banishing removes one card for the rest of the run (and draws
# another). Both cost gold that grows with the round and with how often you have used them.
const REROLL_BASE := 40.0
const REROLL_ROUND := 14.0
const REROLL_GROW := 0.35      # each reroll in the same draft costs 35% more
const BANISH_K := 1.6          # a banish costs this many rerolls
const BANISH_GROW := 0.12      # each banish this run makes the next 12% dearer


static func reroll_cost(round_no: int, rerolls_this_draft: int) -> int:
	return int(round((REROLL_BASE + REROLL_ROUND * round_no) * (1.0 + REROLL_GROW * rerolls_this_draft)))


static func banish_cost(round_no: int, banished: int) -> int:
	return int(round((REROLL_BASE + REROLL_ROUND * round_no) * BANISH_K * (1.0 + BANISH_GROW * banished)))


# The key a banish blocks: the same hero's ability in the same slot, a hero's passive, or an item.
static func card_key(o: Dictionary) -> String:
	match String(o.get("kind", "")):
		"ability":
			return "a:%s:%d" % [o["hero"], int(o["slot"])]
		"passive":
			return "p:" + String(o["hero"])
		"item":
			return "i:" + String(o["id"])
	return ""


# ---------------------------------------------------------------- daily run
# Everyone playing on the same day gets the same hero, map and seed (the card draws come from their
# own generator, so the same picks bring the same cards).
static func daily_seed(date: int) -> int:
	var h := 2166136261
	for ch in str(date):
		h = ((h ^ ch.unicode_at(0)) * 16777619) & 0x7fffffff
	return h


static func daily_hero(date: int) -> String:
	var ids: Array = GameData.CHAMPS.map(func(d): return d["id"])
	return ids[daily_seed(date) % ids.size()]


static func daily_map(date: int, maps: int) -> int:
	return (daily_seed(date) / 7) % maps


static func today() -> int:
	var d := Time.get_date_dict_from_system()
	return int(d["year"]) * 10000 + int(d["month"]) * 100 + int(d["day"])
