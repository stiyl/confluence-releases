	field.add_theme_stylebox_override("focus", main.sb(Color(UIParts.STONE, 0.95), UIParts.BRONZE, 3, 1, 5))
	field.add_theme_stylebox_override("read_only", main.sb(Color(UIParts.STONE_1, 0.6), Color(UIParts.BRONZE_DARK, 0.5), 3, 1, 5))
	field.tooltip_text = _wrap(String(Tune.DEFS[name]["help"])) + "
Default %s" % Tune.fmt(name, Tune.def_of(name))
	field.text_submitted.connect(func(t: String):
		if t.strip_edges().is_valid_float():
			_change(name, float(t.strip_edges()))
		else:
			refresh()
		field.release_focus())
	field.focus_exited.connect(func():
		if field.text.strip_edges().is_valid_float() and absf(float(field.text.strip_edges()) - _value(name)) > 1e-6:
			_change(name, float(field.text.strip_edges()))
		else:
			refresh())
	return field


func _apply_filter() -> void:
	if mrows.is_empty():
		return
	var q := filter_edit.text.strip_edges().to_lower()
	var shown := {}
	for kind in mrows:
		var r: Dictionary = mrows[kind]
		var bname := String(GameData.BUILDINGS[r["b"]]["name"]).to_lower()
		var hit: bool = q == "" or q in String(r["name"]).to_lower() or q in String(kind) or q in bname or (q == "power" and bool(r["power"]))
		(r["row"] as Control).visible = hit
		if hit:
			shown[r["b"]] = true
	for sec in msections:
		(sec[0] as Control).visible = shown.has(sec[1])


