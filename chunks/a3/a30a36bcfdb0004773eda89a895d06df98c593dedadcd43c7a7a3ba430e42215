# Top of the card: under the top-left column (the "Next duel" line, the blessing timer, the synergy
# icons), whatever it currently holds, so the card never sits on those lines. The 0.16 event_hud stack
# (boss bars, round card) is centred and 620 wide, clear of this 300 px column on any window >= 940 px.
func _top() -> float:
	var y: float = main.TOPBAR_H + 54.0
	for c in [main.duel_lbl, main.bless_lbl, main.syn_hud, main.boss_box]:
		if c == null or not c.is_visible_in_tree():
			continue
		if c is Label and String(c.text) == "":
			continue
		if c is Container and c.get_child_count() == 0:
			continue
		var g: Rect2 = c.get_global_rect()
		y = maxf(y, g.end.y + 6.0)
	return y


func _layout() -> void:
	card.position = Vector2(16.0, _top())
	card.size = Vector2(CARD_W, 0.0)   # a PanelContainer grows to its content, never below it
	banner.position = Vector2(16.0, card.position.y + (card.size.y + 6.0 if card.visible else 0.0))
	banner.size = Vector2(CARD_W, 0.0)


# The top-bar button (Main adds it next to the round timer).
