			var c := spot - get_global_rect().position
			var rr := 26.0 + 5.0 * sin(_t * 6.0)
			draw_arc(c, rr, 0.0, TAU, 40, Color(0, 0, 0, 0.6), 6.0)
			draw_arc(c, rr, 0.0, TAU, 40, Color(GOLD_TEXT, 0.95), 3.0)
			draw_arc(c, rr + 9.0, 0.0, TAU, 40, Color(GOLD_TEXT, 0.35), 2.0)
