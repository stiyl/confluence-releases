␀␀␀␀# Survival as a roguelike run: boons you draft between waves, omens that make the enemy worse every
# fifth round, elite monsters with affixes, and a limited number of lives.
class_name SurvivalData
extends RefCounted

const START_LIVES := 1          # one life: die once and the run is over
const OFFER_EVERY := 2          # a boon draft at the start of every 2nd round
