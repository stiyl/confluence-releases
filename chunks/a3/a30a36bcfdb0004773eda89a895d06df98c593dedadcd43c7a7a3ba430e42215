# The glossary with every Survival omen and synergy tag added (they live in SurvivalData, so they are
# generated here rather than written twice).
static func glossary_rows() -> Array:
	var rows: Array = []
	for r in GLOSSARY:
		rows.append([r[0], CampaignUI.keys(String(r[1]))])   # 0.23: {action} tokens show the player's binding
	for o in SurvivalData.OMENS:
		var od: Dictionary = SurvivalData.OMENS[o]
		rows.append(["Omen: %s" % od["name"], "%s  An omen arrives with every boss round in Survival and lasts for the rest of the run." % od["desc"]])
	for tg in SurvivalData.TAG_ORDER:
		var td: Dictionary = SurvivalData.TAGS[tg]
		var tiers: Array = []
		for i in SurvivalData.SYN_TIERS.size():
			tiers.append("%d cards: %s" % [SurvivalData.SYN_TIERS[i], td["tiers"][i]])
		rows.append(["Synergy: %s" % td["name"], "Survival synergy tag. Own that many different cards (abilities, passives or items) with the tag:\n" + "\n".join(tiers)])
	return rows


