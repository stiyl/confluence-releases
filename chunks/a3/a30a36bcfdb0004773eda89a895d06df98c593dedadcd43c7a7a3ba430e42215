func _sim():
	return main.sim if main != null else null


func press_yes() -> void:
	var sim = _sim()
	if sim == null or main.replay_mode:
		return
	if sim.vote_on[_team()]:
		main.act("vote", [1])
		return
	var why: String = sim.vote_refusal(_team())
	if why != "":
		main.show_error(why)
		return
	main.act("vote", [1])


func press_no() -> void:
	var sim = _sim()
	if sim == null or main.replay_mode or not sim.vote_on[_team()]:
		return
	main.act("vote", [0])


func _team() -> int:
	var sim = _sim()
	return int(sim.players[sim.local].team) if sim != null else 0


# Events from the sim (Main.on_event hands these four kinds here).
func on_event(e: Dictionary) -> void:
	var sim = _sim()
	if sim == null:
		return
	match String(e["k"]):
		"vote_start":
			var tm := int(e.get("team", 0))
			if tm != _team():
				return   # the other team's vote: the banner says so (see _process)
			state = "open"
			card.visible = true
			flash = 0.0
			var by: String = sim.players[int(e["pid"])].name
			title_lbl.text = "Start round %d now?" % int(e["round"])
			sub_lbl.text = ("You called a vote" if bool(e.get("human", false)) else "%s called a vote" % by) + " â€” %d of %d needed" % [sim.vote_need(tm), sim.vote_seats(tm)]
			row.visible = true
			timer_bar.visible = true
			timer_bar.col = UIParts.GOLD
			_layout()
		"vote_cast":
			if int(e["pid"]) == sim.local:
				flash = 0.3
		"vote_result":
			var tm := int(e.get("team", 0))
			if tm != _team():
				return
			state = "result"
			result_t = RESULT_HOLD
			card.visible = true
			row.visible = false
			var passed: bool = bool(e["passed"])
			var start: bool = bool(e.get("start", passed))
			title_lbl.text = ("Vote passed â€” wave incoming" if start else "Vote passed â€” your team is ready") if passed else "Vote failed"
			sub_lbl.text = ("Round %d starts now." % int(e["round"]) if start else "Waiting for %s; the round ends when they are ready too." % Sim.TEAM_NAMES[1 - tm]) if passed else "The round runs its course."
			tally_lbl.text = "Yes %d Â· No %d" % [int(e["yes"]), int(e["no"])]
			timer_bar.col = Color("#8fe08a") if passed else Color("#d0452a")
			timer_bar.frac = 1.0
			flash = 0.6
			_layout()
		"team_ready":
			if int(e.get("team", 0)) != _team():
				flash = 0.4   # the enemy is ready: the banner (below) lights up
		"setup_end":
			pass   # the top bar's text changes by itself ("Round 1 ..."); nothing to show here


# The banner under the card: who is ready for the next round, or that the other team is voting.
func _banner_text(sim) -> String:
	var mine := _team()
	var other := 1 - mine
	if sim.team_ready[mine] and sim.team_ready[other]:
		return ""
	if sim.team_ready[other]:
		return "%s is ready for the next round" % Sim.TEAM_NAMES[other]
	if sim.team_ready[mine]:
		return "Your team is ready â€” waiting for %s" % Sim.TEAM_NAMES[other]
	if sim.vote_on[other]:
		return "%s is voting to start the next round" % Sim.TEAM_NAMES[other]
	return ""


func _process(delta: float) -> void:
	var sim = _sim()
	if sim == null or not main.game.visible:
		if card != null and card.visible:
			card.visible = false
		return
	flash = maxf(0.0, flash - delta)
	# the top-bar button: enabled only when a vote can be called (or one is open to join), the reason as tooltip
	var tm := _team()
	if btn != null and btn.visible != bool(sim.income_per_round):
		# 0.21: no vote in the 10 s modes (campaign, survival): the button leaves the bar instead of sitting greyed
		btn.visible = sim.income_per_round
	if btn != null:
		var why: String = sim.vote_refusal(tm)
		var can: bool = why == "" or sim.vote_on[tm]
		if btn.disabled == can:
			btn.disabled = not can
			btn.queue_redraw()
		var k := Settings.key_name("vote")
		if sim.vote_on[tm]:
			btn.tooltip_text = "Vote yes: start round %d now (%s)" % [sim.round_no + 1, k]
		elif why == "":
			btn.tooltip_text = "Start next round (%s)\nCalls your team's vote: it passes when %d of your %d agree. The round ends and the next wave comes as soon as both teams are ready. One vote per team per round." % [k, sim.vote_need(tm), sim.vote_seats(tm)]
		else:
			btn.tooltip_text = "Start next round (%s)\n%s" % [k, why]
	# the ready / enemy-voting banner reads the sim directly (right after a replay seek or a late join too)
	var bt := _banner_text(sim)
	if bt != banner_lbl.text or banner.visible != (bt != ""):
		banner_lbl.text = bt
		banner.visible = bt != ""
		var other := 1 - tm
		banner_lbl.add_theme_color_override("font_color", ((main.WARD if other == 0 else main.EMBER) if (sim.team_ready[other] or sim.vote_on[other]) else (main.WARD if tm == 0 else main.EMBER)).lightened(0.25))
		_layout()
	elif banner.visible:
		var by := card.position.y + (card.size.y + 6.0 if card.visible else 0.0)
		if absf(banner.position.y - by) > 0.5 or absf(card.position.y - _top()) > 0.5:
			_layout()
	if banner.visible:
		banner.modulate = Color(1, 1, 1, 1).lerp(Color(1.3, 1.25, 1.0, 1), flash)
	if state == "open":
		if not sim.vote_on[tm]:
			# the sim closed it without a result event we saw (a replay seek, a late join): fall back to a plain hide
			state = ""
			card.visible = false
			_layout()
			return
		tally_lbl.text = "Yes %d Â· No %d" % [sim.vote_count(tm, true), sim.vote_count(tm, false)]
		timer_bar.frac = sim.vote_t[tm] / sim.vote_len()
		timer_bar.queue_redraw()
		var mine = sim.votes[tm].get(sim.local)
		yes_btn.disabled = mine != null and bool(mine) == true
		no_btn.disabled = mine != null and bool(mine) == false
		card.modulate = Color(1, 1, 1, 1).lerp(Color(1.3, 1.2, 0.9, 1), flash)
	elif state == "result":
		result_t -= delta
		card.modulate = Color(1, 1, 1, 1).lerp(Color(1.4, 1.3, 1.0, 1), flash)
		if result_t <= 0.0:
			state = ""
			card.visible = false
			card.modulate = Color.WHITE
			_layout()
␀␀␀␀␀␀␀␀␀␀// Additive spell effects: shockwave rings, zone sigils, cone sprays, beams and light pillars,
// plus the world's standing glows: brazier flames, lantern halos and the rift vortex.
// k runs from 1 (just cast) to 0 (gone).
// Colour rule (ART_BIBLE 6): a coloured body and a lighter core mixed at most 35% toward white.
// `peak` caps the brightest channel hue-preservingly: 1.0 in Compatibility (no glow there, so
// anything above 1 just clips to white), up to 1.6 in Forward+ so glow picks the core up.
shader_type spatial;
render_mode blend_add, unshaded, cull_disabled, depth_draw_never, shadows_disabled, fog_disabled;

uniform vec4 col : source_color = vec4(1.0);
uniform vec4 col2 : source_color = vec4(1.0, 0.82, 0.29, 1.0);   // flame core / vortex inner
uniform float k = 1.0;
uniform int mode = 0;
uniform float spin = 0.0;
uniform float span = 1.0;      // cone: half-angle in radians
uniform float seed = 0.0;
uniform float energy = 1.6;
uniform float peak = 1.0;
uniform int billboard = 0;     // 0 none, 1 full (faces the camera), 2 upright (turns about Y only)

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
}

void vertex() {
	if (billboard == 1) {
		MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
		MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
	} else if (billboard == 2) {
		vec3 up = vec3(0.0, 1.0, 0.0);
		vec3 right = normalize(cross(up, INV_VIEW_MATRIX[2].xyz));
		vec3 fwd = normalize(cross(right, up));
		MODELVIEW_MATRIX = VIEW_MATRIX * mat4(vec4(right, 0.0), vec4(up, 0.0), vec4(fwd, 0.0), MODEL_MATRIX[3]);
		MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
	}
}

void fragment() {
	vec2 q = UV * 2.0 - 1.0;
	float d = length(q);
	float ang = atan(q.y, q.x);
	float prog = 1.0 - k;
	float a = 0.0;
	vec3 c = col.rgb;
	vec3 hot = mix(c, vec3(1.0), 0.35);
	vec3 outc = c;
	if (mode == 0 || mode == 5) {
		// shockwave (0 grows outward, 5 implodes inward)
		float e = mode == 0 ? 1.0 - pow(1.0 - prog, 3.0) : 1.0 - prog;
		float rad = mix(0.12, 0.96, e);
		float wob = noise(vec2(ang * 3.0 + seed, prog * 4.0)) * 0.05;
		float band = exp(-pow((d - rad - wob) / (0.035 + 0.05 * k), 2.0));
		float fill = smoothstep(rad, 0.0, d) * 0.22 * k * k;
		float sparks = pow(noise(vec2(ang * 9.0 + seed, d * 6.0 - prog * 8.0)), 6.0) * smoothstep(rad + 0.05, rad - 0.3, d) * 2.0;
		a = (band * (0.6 + 0.4 * k) + fill + sparks * k) * step(d, 1.0);
		outc = mix(c, hot, band);
	} else if (mode == 1) {
		// zone sigil: glowing rim, rotating runes and swirling arms
		float rim = exp(-pow((d - 0.94) / 0.04, 2.0));
		float inner = exp(-pow((d - 0.7) / 0.015, 2.0)) * 0.6;
		float runes = step(0.55, fract((ang + spin * 0.6) * 12.0 / 6.2831)) * smoothstep(0.78, 0.8, d) * smoothstep(0.9, 0.88, d);
		float arms = pow(0.5 + 0.5 * sin(ang * 3.0 + d * 9.0 - spin * 3.0), 5.0) * smoothstep(1.0, 0.2, d);
		float n = noise(q * 4.0 + vec2(spin, -spin) * 0.7);
		a = (rim * 0.9 + inner + runes * 0.3 + arms * 0.22 + 0.03 + n * 0.05) * step(d, 1.0) * k;
		outc = mix(c, hot, rim * 0.4);
	} else if (mode == 2) {
		// cone spray: wedge with a breath front and streaks
		float dang = abs(atan(q.y, q.x));
		float wedge = smoothstep(span, span - 0.12, dang) * step(d, 1.0);
		float front = exp(-pow((d - mix(0.2, 1.0, sqrt(prog))) / 0.12, 2.0));
		float streak = pow(noise(vec2(dang * 25.0 + seed, d * 3.0 - prog * 10.0)), 3.0);
		float body = smoothstep(mix(0.2, 1.0, sqrt(prog)) + 0.1, 0.0, d);
		a = wedge * (front * 1.1 + body * (0.2 + streak * 0.8)) * k;
		outc = mix(c, hot, front * 0.7);
	} else if (mode == 3) {
		// beam: UV.x along the beam, UV.y across
		float y = abs(UV.y - 0.5) * 2.0;
		float core = exp(-pow(y / 0.22, 2.0));
		float halo = exp(-pow(y / 0.6, 2.0)) * 0.8;
		float flow = 0.6 + 0.4 * noise(vec2(UV.x * 18.0 - TIME * 30.0, y * 3.0 + seed));
		float ends = smoothstep(0.0, 0.04, UV.x) * smoothstep(1.0, 0.92, UV.x);
		a = (core * 1.2 + halo * flow) * ends * k;
		outc = mix(c, hot, core);
	} else if (mode == 4) {
		// light pillar (cylinder: UV.y 0 at the top)
		float h = 1.0 - UV.y;
		float rise = 0.5 + 0.5 * sin(UV.y * 14.0 + TIME * 9.0 + UV.x * 6.2831 * 3.0);
		a = pow(1.0 - h, 1.6) * (0.4 + 0.6 * rise) * k;
		outc = mix(c, hot, 0.3);
	} else if (mode == 7) {
		// brazier flame (upright billboard, UV.y 0 at the top): a licking teardrop, orange body,
		// yellow core, scrolling noise for the flicker. `seed` desyncs neighbouring flames.
		float t = TIME * 1.0 + seed;
		float y = 1.0 - UV.y;                       // 0 at the base, 1 at the tip
		float x = UV.x * 2.0 - 1.0;
		float n1 = noise(vec2(x * 3.0 + seed, y * 4.0 - t * 5.5));
		float n2 = noise(vec2(x * 6.0 - seed, y * 7.0 - t * 9.0));
		float sway = (n1 - 0.5) * 0.35 * y + sin(t * 3.1) * 0.05 * y;
		float xx = x - sway;
		float width = (1.0 - pow(y, 1.4)) * mix(0.55, 0.95, smoothstep(0.0, 0.25, y));
		float body = smoothstep(width, width * 0.35, abs(xx));
		float top = smoothstep(1.0, 0.45 + 0.25 * n1, y + (n2 - 0.5) * 0.35);
		float base = smoothstep(0.0, 0.08, y);
		float shape = body * top * base;
		float core = smoothstep(width * 0.55, 0.0, abs(xx)) * smoothstep(0.75, 0.15, y + (n2 - 0.5) * 0.2) * base;
		float flick = 0.88 + 0.12 * sin(t * 13.0) * sin(t * 7.3 + 1.0);
		a = clamp(shape * 0.95 + core * 0.4, 0.0, 1.0) * flick * k;
		vec3 tipc = mix(c, vec3(0.55, 0.12, 0.04), smoothstep(0.45, 1.0, y));
		outc = mix(tipc, mix(col2.rgb, vec3(1.0), 0.3), core);
	} else if (mode == 8) {
		// soft halo (full billboard): lantern glass glow, kept well below white
		float glowr = exp(-d * d * 3.0) * smoothstep(1.0, 0.7, d);
		float inner = exp(-d * d * 18.0);
		float flick = 0.94 + 0.06 * sin(TIME * 7.0 + seed * 3.0);
		a = (glowr * 0.7 + inner * 0.5) * flick * k;
		outc = mix(c, mix(c, vec3(1.0), 0.35), inner);
	} else if (mode == 9) {
		// rift vortex (upright billboard): an oval gate with spiral arms turning slowly inward
		vec2 p = vec2(q.x * 1.0, q.y * 0.62);
		float r = length(q);
		float an = atan(p.y, p.x);
		float swirl = an * 3.0 + log(max(r, 0.02)) * 4.5 + TIME * 1.6 + seed;
		float arms = pow(0.5 + 0.5 * sin(swirl), 3.0);
		float n = noise(vec2(an * 2.0 + TIME * 0.4, r * 5.0 - TIME * 1.2));
		float disk = smoothstep(1.0, 0.7, r);
		float rim = exp(-pow((r - 0.86) / 0.07, 2.0));
		float eye = exp(-r * r * 14.0);
		a = (arms * (0.35 + 0.4 * n) * disk + rim * 0.7 + eye * 0.5) * k;
		outc = mix(c, col2.rgb, clamp(eye + arms * 0.25 * (1.0 - r), 0.0, 1.0));
	} else {
		// soft flash disc: the body colour with a lightly whitened centre (no white bulbs)
		a = pow(max(0.0, 1.0 - d), 2.0) * k;
		outc = mix(c, hot, max(0.0, 1.0 - d * 1.6));
	}
	vec3 lit = outc * energy;
	float mx = max(lit.r, max(lit.g, lit.b));
	if (mx > peak) {
		lit *= peak / mx;
	}
	ALBEDO = lit;
	ALPHA = clamp(a, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀// The battlefield ground in 3D: detail textures blended by the splat map, lit by the sun, plus a "decal"
// layer: a texture the game draws rings, zones and telegraphs into each frame.
// splat: R = dirt road, G = cobblestone, B = water (or lava), A = 1 - wet shore band.
// cobble alpha = a per-stone random id (mortar ~0.12), used to scatter loose setts at the plaza rim.
// Compatibility-safe: no derivatives, 10 texture fetches on land (+2 on water), works in GLES3.
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;

uniform sampler2D splat : filter_linear;
uniform sampler2D forest : filter_linear;
uniform sampler2D grass_tex : source_color, repeat_enable, filter_linear_mipmap_anisotropic;
uniform sampler2D grass2_tex : source_color, repeat_enable, filter_linear_mipmap_anisotropic;
uniform sampler2D dirt_tex : source_color, repeat_enable, filter_linear_mipmap_anisotropic;
uniform sampler2D cobble_tex : source_color, repeat_enable, filter_linear_mipmap_anisotropic;
uniform sampler2D floor_tex : source_color, repeat_enable, filter_linear_mipmap_anisotropic;
uniform sampler2D macro : repeat_enable, filter_linear_mipmap;
uniform sampler2D deco_tex : source_color, filter_linear;
uniform vec4 deco_rect = vec4(0.0, 0.0, 1.0, 1.0);   // world rect the decal texture covers
uniform vec2 world_size = vec2(5184.0, 2048.0);
uniform float k3 = 0.0333333;                         // metres per world unit
uniform float grass_tile = 230.0;
uniform float dirt_tile = 190.0;
uniform float cobble_tile = 150.0;
uniform float floor_tile = 210.0;
uniform vec3 water_deep = vec3(0.05, 0.16, 0.22);
uniform vec3 water_shallow = vec3(0.14, 0.34, 0.38);
uniform vec3 ground_tint = vec3(1.0);                 // campaign chapters: ash, storm, night, the Hollow
uniform float ground_desat = 0.0;
uniform float trench_k = 0.5;                         // strength of the darker worn band along the road edges
// past the map edge (the outer ground plane uses this shader too): the edge splat fades out into forest floor,
// which darkens toward this colour (the look's fog, dimmed) so the world ends in deep woods, not a hard plane
uniform vec3 edge_col = vec3(0.12, 0.16, 0.12);

varying vec3 wpos;

float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 wp = wpos.xz / k3;
	vec2 uv = wp / world_size;
	vec2 cuv = clamp(uv, vec2(0.0004), vec2(0.9996));
	float od = max(max(-wp.x, wp.x - world_size.x), max(-wp.y, wp.y - world_size.y));
	vec4 sp = texture(splat, cuv);
	float fo = texture(forest, cuv).r;
	if (od > 0.0) {
		// roads and plazas run out within a few metres; water (rivers, lava) carries on into the woods
		sp.rg *= 1.0 - smoothstep(0.0, 150.0, od);
		fo = mix(fo, 1.0, smoothstep(10.0, 130.0, od));
	}
	// three scales of soft macro variation: 3900 (region), 1500 (meadow), 520 (patch)
	float m0 = texture(macro, wp / 3900.0 + vec2(0.61, 0.13)).r;
	float m1 = texture(macro, wp / 1500.0).r;
	float m2 = texture(macro, wp / 520.0 + vec2(0.37, 0.71)).r;

	vec3 g1 = texture(grass_tex, wp / grass_tile).rgb;
	vec3 g2 = texture(grass2_tex, wp / (grass_tile * 1.31) + vec2(0.3, 0.6)).rgb;
	vec3 grass = mix(g1, g2, smoothstep(0.38, 0.66, m1));
	vec3 flo = texture(floor_tex, wp / floor_tile).rgb * (0.88 + 0.24 * m2);
	vec3 dirt = texture(dirt_tex, wp / dirt_tile).rgb * (0.94 + 0.12 * m1);
	vec4 cob = texture(cobble_tex, wp / cobble_tile);

	// macro colour: value +-8% at two scales, a warm/cool hue drift of a few degrees
	float mv = (m0 - 0.5) * 0.11 + (m2 - 0.5) * 0.09;
	float mh = clamp((m1 - 0.5) * 1.6 + (m0 - 0.5) * 0.8, -1.0, 1.0);
	vec3 hue = mix(vec3(1.0), mh > 0.0 ? vec3(1.035, 1.0, 0.93) : vec3(0.965, 1.0, 1.05), abs(mh));
	grass *= (1.0 + mv * 1.6) * hue;
	dirt *= 1.0 + mv * 0.6;

	// forest floor, with a soft shade band just inside the forest edge
	float fo_e = clamp((fo - 0.5) * 2.2 + (m2 - 0.5) * 0.9 + 0.5, 0.0, 1.0);
	vec3 col = mix(grass, flo * 0.85, fo_e);
	col *= 1.0 - 0.14 * smoothstep(0.05, 0.45, fo) * (1.0 - fo_e * 0.6);

	// road: wobbly edge, then a worn trench band (~10 units) in the road-edge colour where road meets field
	float road_e = clamp((sp.r - 0.5) * 3.2 + (m2 - 0.5) * 0.7 + (luma(g1) - luma(dirt)) * 0.6 + 0.5, 0.0, 1.0);
	col = mix(col, dirt, road_e);
	float trench = smoothstep(0.12, 0.42, sp.r) * (1.0 - smoothstep(0.5, 0.85, sp.r));
	trench *= 0.75 + 0.5 * m2;
	col = mix(col, dirt * vec3(0.62, 0.62, 0.6), clamp(trench, 0.0, 1.0) * trench_k);

	// paved areas (plazas, the monument's dais, causeways, bridge decks): the splat's G ramps linearly
	// across every paved edge, so G = 0.5 is a clean edge, 0.5-0.75 a kerb of larger dressed stones and
	// above that the setts. A thin shadow falls on the ground just outside the kerb, grooves outline it.
	float cob_e = smoothstep(0.47, 0.53, sp.g);
	float kerb = cob_e * (1.0 - smoothstep(0.72, 0.78, sp.g));
	vec3 cobc = cob.rgb * (0.86 + 0.16 * (cob.a - 0.6));
	vec4 kb = texture(cobble_tex, wp / (cobble_tile * 2.4) + vec2(0.37, 0.11));
	vec3 kerbc = mix(kb.rgb * 0.62, kb.rgb * 1.16, step(0.2, kb.a)) * vec3(1.02, 1.0, 0.96);
	vec3 pave = mix(cobc, kerbc, kerb);
	float groove = 1.0 - smoothstep(0.0, 0.025, abs(sp.g - 0.75));
	pave *= 1.0 - 0.3 * groove;
	col *= 1.0 - 0.3 * smoothstep(0.3, 0.49, sp.g) * (1.0 - cob_e);
	col = mix(col, pave, cob_e);
	float rough = mix(0.92, 0.75, cob_e);
	float spec = 0.35;

	// damp (or scorched) ground on the land side of the water
	float wet = 1.0 - sp.a;
	bool lava = water_deep.r > water_deep.b + 0.3;
	vec3 emit = vec3(0.0);
	if (wet > 0.001) {
		if (lava) {
			col = mix(col, col * vec3(0.42, 0.36, 0.33), wet * 0.9);
			emit += water_deep * smoothstep(0.55, 1.0, wet) * 0.18;
		} else {
			col = mix(col, col * vec3(0.66, 0.68, 0.7), wet * 0.8);
			rough = mix(rough, 0.55, wet);
		}
	}

	float w = sp.b;
	if (w > 0.001) {
		vec2 flow = vec2(TIME * 6.0, TIME * 2.5);
		float r1 = texture(macro, (wp + flow) / 90.0).r;
		float r2 = texture(macro, (wp - flow * 0.7) / 60.0 + vec2(0.5)).r;
		float rip = r1 * r2;
		float wm = smoothstep(0.0, 0.25, w);
		if (lava) {
			// dark floating crust with glowing cracks; the core is the only saturated thing on the map
			// glowing veins along noise contours, a brighter seam down the middle of the flow
			float v1 = 1.0 - smoothstep(0.0, 0.045, abs(r1 - 0.5));
			float v2 = 1.0 - smoothstep(0.0, 0.035, abs(r2 - 0.45));
			float seam = smoothstep(0.8, 1.0, w) * (0.35 + 0.4 * r2);
			float crack = clamp(max(v1, v2 * 0.8) + seam, 0.0, 1.0);
			vec3 hot = mix(water_deep, water_shallow, smoothstep(0.55, 1.0, crack));
			vec3 crust = vec3(0.13, 0.085, 0.07) * (0.75 + 0.5 * r2);
			vec3 lc = mix(crust, hot, crack);
			col = mix(col, lc, wm);
			emit += hot * crack * wm * 0.7;
			rough = mix(rough, 0.8, wm);
		} else {
			vec3 wc = mix(water_shallow, water_deep, smoothstep(0.1, 1.0, w));
			wc = mix(wc, vec3(luma(wc)), 0.3);
			wc += vec3(0.5, 0.58, 0.6) * smoothstep(0.34, 0.46, rip) * 0.1;
			col = mix(col, wc, wm);
			rough = mix(rough, 0.16, wm);
			spec = mix(spec, 0.55, wm);
		}
	}
	col = mix(col, vec3(luma(col)), ground_desat) * ground_tint;
	if (od > 0.0) {
		col = mix(col, edge_col, smoothstep(120.0, 1100.0, od) * 0.85);
	}
	ALBEDO = col * 0.85;
	ROUGHNESS = rough;
	SPECULAR = spec;
	EMISSION = emit;

	vec2 duv = (wp - deco_rect.xy) / deco_rect.zw;
	if (duv.x > 0.0 && duv.y > 0.0 && duv.x < 1.0 && duv.y < 1.0) {
		vec4 d = texture(deco_tex, duv);
		ALBEDO = mix(ALBEDO, d.rgb, d.a * 0.85);
		EMISSION = emit + d.rgb * d.a * 0.9;
	}
}
␀␀␀␀␀␀␀␀// Ground for the whole map: tiled detail textures blended by a splat map.
// splat: R = dirt road, G = cobblestone, B = water. forest: forest floor under the trees.
shader_type canvas_item;

uniform sampler2D splat : filter_linear;
uniform sampler2D forest : filter_linear;
uniform sampler2D grass_tex : repeat_enable, filter_linear_mipmap;
uniform sampler2D grass2_tex : repeat_enable, filter_linear_mipmap;
uniform sampler2D dirt_tex : repeat_enable, filter_linear_mipmap;
uniform sampler2D cobble_tex : repeat_enable, filter_linear_mipmap;
uniform sampler2D floor_tex : repeat_enable, filter_linear_mipmap;
uniform sampler2D macro : repeat_enable, filter_linear_mipmap;
uniform vec2 world_size = vec2(3584.0, 2048.0);
uniform float grass_tile = 230.0;
uniform float dirt_tile = 190.0;
uniform float cobble_tile = 150.0;
uniform float floor_tile = 210.0;
uniform float clouds = 1.0;

float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

void fragment() {
	vec2 wp = UV * world_size;
	vec3 sp = texture(splat, UV).rgb;
	float fo = texture(forest, UV).r;
	float m1 = texture(macro, wp / 1500.0).r;
	float m2 = texture(macro, wp / 520.0 + vec2(0.37, 0.71)).r;

	vec3 g1 = texture(grass_tex, wp / grass_tile).rgb;
	vec3 g2 = texture(grass2_tex, wp / (grass_tile * 1.31) + vec2(0.3, 0.6)).rgb;
	vec3 grass = mix(g1, g2, smoothstep(0.38, 0.66, m1));
	grass *= 0.88 + 0.24 * m2;

	vec3 flo = texture(floor_tex, wp / floor_tile).rgb * (0.85 + 0.3 * m2);
	vec3 dirt = texture(dirt_tex, wp / dirt_tile).rgb * (0.9 + 0.18 * m1);
	vec3 cob = texture(cobble_tex, wp / cobble_tile).rgb;

	// height-aware blends so edges break up naturally instead of fading
	float fo_e = clamp((fo - 0.5) * 2.2 + (m2 - 0.5) * 0.9 + 0.5, 0.0, 1.0);
	vec3 col = mix(grass, flo, fo_e);
	float road_e = clamp((sp.r - 0.5) * 3.0 + (luma(dirt) - 0.42) * 2.5 + 0.5, 0.0, 1.0);
	// a darker damp band where the road meets the grass
	float rim = smoothstep(0.0, 0.5, sp.r) * (1.0 - smoothstep(0.5, 1.0, sp.r));
	col *= 1.0 - rim * 0.18;
	col = mix(col, dirt, road_e);
	float cob_e = clamp((sp.g - 0.5) * 3.5 + (luma(cob) - 0.4) * 1.5 + 0.5, 0.0, 1.0);
	col = mix(col, cob, cob_e);

	// water with drifting ripples
	float w = sp.b;
	if (w > 0.001) {
		vec2 flow = vec2(TIME * 6.0, TIME * 2.5);
		float r1 = texture(macro, (wp + flow) / 90.0).r;
		float r2 = texture(macro, (wp - flow * 0.7) / 60.0 + vec2(0.5)).r;
		float rip = r1 * r2;
		vec3 deep = vec3(0.07, 0.22, 0.3);
		vec3 shallow = vec3(0.18, 0.42, 0.45);
		vec3 wc = mix(shallow, deep, smoothstep(0.1, 1.0, w));
		wc += vec3(0.55, 0.65, 0.7) * smoothstep(0.32, 0.46, rip) * 0.35;
		col = mix(col, wc, smoothstep(0.0, 0.25, w));
	}

	// slow cloud shadows
	float cl = texture(macro, wp / 2600.0 + vec2(TIME * 0.004, TIME * 0.0016)).r;
	col *= 1.0 - clouds * 0.16 * smoothstep(0.52, 0.75, cl);
	COLOR = vec4(col, 1.0);
}
␀␀␀␀␀␀␀␀␀// Hero skins: moves every color of a rendered sprite to one hue while keeping its brightness and
// shading (an HSV recolor), so the lighting baked into the sprite still reads. mix_amt 0 = original.
shader_type canvas_item;

uniform float hue = 0.0;        // target hue, 0..1
uniform float min_sat = 0.4;    // greys and whites get at least this much color
uniform float sat_k = 1.0;
uniform float mix_amt = 0.0;
uniform float bright = 1.0;
uniform float sheen = 0.0;

varying vec4 modulate;

void vertex() {
	modulate = COLOR;
}

vec3 rgb2hsv(vec3 c) {
	vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
	float d = q.x - min(q.w, q.y);
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x);
}

vec3 hsv2rgb(vec3 c) {
	vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	vec3 hsv = rgb2hsv(tex.rgb);
	vec3 rc = hsv2rgb(vec3(hue, clamp(max(hsv.y, min_sat) * sat_k, 0.0, 1.0), hsv.z));
	vec3 col = mix(tex.rgb, rc, mix_amt) * bright;
	col += sheen * pow(hsv.z, 5.0) * rc;
	COLOR = vec4(col, tex.a) * modulate;
}
␀// Material for every 3D model (units, buildings, props). The parameters come from models.json:
// a base colour with procedural surface variation (like the Blender renders), roughness, metal and glow.
// Per-instance: a white hit flash, a tint, the hero skin recolor (HSV) and a fade.
shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

// Models3D strips this line on the Compatibility renderer (no glow there): emission then saturates
// toward the material colour below 1.0 instead of clipping to a white disc. Forward+ keeps an HDR
// peak above 1 so glow still has something to bloom.
#define HDR_EMIT
#ifdef HDR_EMIT
const float EMIT_PEAK = 1.6;
#else
const float EMIT_PEAK = 0.92;
#endif

uniform vec3 albedo : source_color = vec3(0.7);
uniform float lo = 0.9;
uniform float hi = 1.05;
uniform float nscale = 4.0;
uniform float bump = 0.0;
uniform float rough = 0.7;
uniform float metal = 0.0;
uniform float emit = 0.0;
uniform float rim = 0.25;
uniform float peak_k = 1.0;                             // per-material emission ceiling (small lantern glass reads brighter)
uniform float core = 0.0;                                // gems: facets facing the camera glow, edges go deep

instance uniform float flash = 0.0;
instance uniform vec4 tint = vec4(1.0);
instance uniform float desat = 0.0;                      // campaign chapter looks grey out the props
instance uniform vec4 skin = vec4(0.0, 0.0, 1.0, 0.0);   // hue, min_sat, sat_k, mix
instance uniform vec2 skin2 = vec2(1.0, 0.0);            // brightness, sheen

varying vec3 opos;

float hash(vec3 p) {
	p = fract(p * 0.3183099 + 0.1);
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash(i), hash(i + vec3(1, 0, 0)), f.x), mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x), mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

// hue-preserving soft knee: scales all channels by the same factor so the brightest one
// approaches EMIT_PEAK; returns the emission and (in w) how "lit from inside" the surface is
vec3 emit_curve(vec3 raw, out float w) {
	float m = max(raw.r, max(raw.g, raw.b));
	if (m <= 1e-4) {
		w = 0.0;
		return vec3(0.0);
	}
	float pk = EMIT_PEAK * peak_k;
	float k = pk * (1.0 - exp(-m / pk));
	w = clamp(k / pk, 0.0, 1.0);
	return raw * (k / m);
}

float fbm(vec3 p) {
	return 0.55 * vnoise(p) + 0.3 * vnoise(p * 2.03 + 7.1) + 0.15 * vnoise(p * 4.1 + 3.3);
}

vec3 rgb2hsv(vec3 c) {
	vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
	float d = q.x - min(q.w, q.y);
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x);
}

vec3 hsv2rgb(vec3 c) {
	vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

void vertex() {
	opos = VERTEX;
}

void fragment() {
	float n = fbm(opos * nscale);
	vec3 c = albedo * mix(lo, hi, smoothstep(0.25, 0.78, n));
	if (skin.w > 0.0) {
		vec3 hsv = rgb2hsv(c);
		vec3 rc = hsv2rgb(vec3(skin.x, clamp(max(hsv.y, skin.y) * skin.z, 0.0, 1.0), hsv.z));
		c = mix(c, rc, skin.w) * skin2.x + skin2.y * pow(hsv.z, 5.0) * rc;
	}
	c = mix(c, vec3(dot(c, vec3(0.299, 0.587, 0.114))), desat);
	c *= tint.rgb;
	float w;
	vec3 em = emit_curve(albedo * emit * 1.6, w);
	if (core > 0.0) {
		float facing = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
		float f = mix(1.0, 0.3 + 0.8 * facing * facing, core);
		c *= mix(1.0, 0.45 + 0.55 * facing, core);
		em *= f;
		float mx = max(em.r, max(em.g, em.b));
		em *= min(1.0, EMIT_PEAK / max(mx, 1e-4));
	}
	// glowing parts are lit from inside: dim their lit albedo so sun + emission cannot clip to white
	ALBEDO = c * (1.0 - 0.8 * w * w);
	ROUGHNESS = clamp(rough + (n - 0.5) * bump * 0.6, 0.05, 1.0);
	METALLIC = metal;
	// a soft rim keeps silhouettes readable from the high camera
	float fres = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	// the hit flash (0.26): a hot tint of the surface colour toward white, so a struck unit keeps its shape
	// and shading instead of burning out to a silhouette (1.0 a hit, 1.25 an ability, 1.5 a crit)
	EMISSION = em * mix(0.8, 1.0, smoothstep(0.2, 0.8, n)) + (c * 0.45 + 0.55) * flash * 0.62 + c * fres * rim * (1.0 - w);
	//ALPHA
}
