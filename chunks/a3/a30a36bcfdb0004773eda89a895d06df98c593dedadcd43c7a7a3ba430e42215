	return t


# Draws a hero's head and shoulders filling a rectangle (portraits). head_h: head height in model units.
# Uses the dedicated portrait strip when there is one; otherwise crops the unit sheet (old top-down framing).
static func draw_bust(ci: CanvasItem, name: String, r: Rect2, dir := 3, zoom := 2.1, head_h := 1.55, modulate := Color.WHITE) -> bool:
	var pt := portrait_tex(name)
	if pt != null:
		var pf := float(pt.get_height())
		var col := clampi(dir - 1, 0, PORTRAIT_DIRS - 1)
		ci.draw_texture_rect_region(pt, r, Rect2(col * pf, 0, pf, pf), modulate)
		return true
	var t := tex(name)
	if t == null:
		return false
	var m := meta(name)
	var fr := float(m["frame"])
	var src_sz := fr / zoom
	var head_y := fr * float(m["foot"]) - head_h * cos(deg_to_rad(52.0)) / float(m["span"]) * fr
	var top := clampf(head_y - src_sz * 0.42, 0.0, fr - src_sz)
	var src := Rect2(dir * fr + fr / 2.0 - src_sz / 2.0, top, src_sz, src_sz)
	ci.draw_texture_rect_region(t, r, src, modulate)
	return true
