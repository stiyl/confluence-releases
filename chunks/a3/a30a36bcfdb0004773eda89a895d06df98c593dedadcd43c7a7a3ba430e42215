# A textured disc: a circle polygon with UVs onto `src` (pixels) of `tex`. Clips a portrait to a round frame
# without a shader.
static func disc_tex(ci: CanvasItem, c: Vector2, rad: float, tex: Texture2D, src: Rect2, modulate := Color.WHITE, segs := 36) -> void:
	if tex == null:
		return
	var ts := Vector2(tex.get_width(), tex.get_height())
	var pts := PackedVector2Array()
	var uvs := PackedVector2Array()
	var cols := PackedColorArray()
	for i in segs:
		var d := Vector2.from_angle(TAU * i / segs)
		pts.append(c + d * rad)
		uvs.append((src.position + (Vector2(0.5, 0.5) + d * 0.5) * src.size) / ts)
		cols.append(modulate)
	ci.draw_polygon(pts, cols, uvs, tex)


# Portrait disc: a dark disc with a bronze ring holding a hero bust (def) or a whole monster (sheet).
# dir: portrait strip facing 1..5 (3 = front). Dead heroes are drawn dim.
static func portrait_disc(ci: CanvasItem, c: Vector2, rad: float, def: Dictionary, sheet := "", dir := 3, a := 1.0, ring := Color(0, 0, 0, 0), dim := false) -> void:
	var col := Color(def.get("color", "#6b6252")) if not def.is_empty() else Color(0.35, 0.3, 0.25)
	ci.draw_circle(c + Vector2(0, 1), rad + 2.0, Color(0, 0, 0, 0.55 * a))
	var g := col.r * 0.3 + col.g * 0.55 + col.b * 0.15
	var ds := Color(g, g, g).lerp(col, 0.35).darkened(0.55)
	ci.draw_circle(c, rad, Color(ds, a))
	ci.draw_circle(c - Vector2(0, rad * 0.2), rad * 0.72, Color(ds.lightened(0.18), 0.5 * a))
	var mod := Color(1, 1, 1, a) if not dim else Color(0.45, 0.42, 0.4, a)
	if not def.is_empty():
		var nm := "hero_" + String(def["id"])
		var pt := Sprites.portrait_tex(nm)
		if pt != null:
			var pf := float(pt.get_height())
			var ccol := clampi(dir - 1, 0, Sprites.PORTRAIT_DIRS - 1)
			disc_tex(ci, c, rad - 1.0, pt, Rect2(ccol * pf, 0, pf, pf), mod)
		else:
			var t := Sprites.tex(nm)
			if t != null:
				var m := Sprites.meta(nm)
				var fr := float(m["frame"])
				var src_sz := fr / 2.0
				disc_tex(ci, c, rad - 1.0, t, Rect2(dir * fr + fr / 2.0 - src_sz / 2.0, fr * 0.1, src_sz, src_sz), mod)
	elif sheet != "":
		var t := Sprites.tex(sheet)
		if t != null:
			var m := Sprites.meta(sheet)
			var fr := int(m["frame"])
			var d := dir if int(m["dirs"]) > 1 else 0
			var key := "%s|%d|%d" % [sheet, d, 0]
			var s: Rect2 = Rect2(TightRects.RECTS[key]) if TightRects.RECTS.has(key) else Rect2(d * fr, 0, fr, fr)
			# the creature fits inside the disc: a square window around the tight rect
			var side := maxf(s.size.x, s.size.y) * 1.15
			var win := Rect2(s.get_center() - Vector2(side, side) * 0.5, Vector2(side, side))
			disc_tex(ci, c, rad - 1.0, t, win, mod)
	ci.draw_arc(c, rad, 0, TAU, 40, Color(0, 0, 0, 0.6 * a), 2.5, true)
	ci.draw_arc(c, rad, 0, TAU, 40, Color(BRONZE if ring.a <= 0.0 else ring, a), 1.5, true)
	ci.draw_arc(c, rad - 1.5, 0, TAU, 40, Color(BRONZE_LITE, 0.25 * a), 1.0, true)


