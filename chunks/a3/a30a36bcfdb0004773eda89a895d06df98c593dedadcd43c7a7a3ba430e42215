
func tune_set(set: Dictionary) -> void:
	tune = Tune.clean(set)
	_tune_on = tune_applies()
	tune_bind()


# Points the static Tune.active at this sim's set (or the defaults when the knobs don't apply here).
func tune_bind() -> void:
	Tune.active = tune if _tune_on else Tune.LEGACY   # 0.24: the 10 s modes / campaign keep the 0.23 numbers (not the new built-in defaults)


# This sim's value of a knob.
func tv(name: String) -> float:
	tune_bind()
	return Tune.v(name)


# The "tune" command: one knob, snapped to its step; defaults are erased from the set. Some knobs act at once
# on the running round (round and setup length); the rest are read wherever the constant used to be.
func tune_cmd(name: String, value: float) -> bool:
	if not Tune.DEFS.has(name):
		return false
	var old := Tune.value_in(tune, name)
	Tune.set_knob(tune, name, value)
	var nv := Tune.value_in(tune, name)
	tune_cmds += 1
	_tune_on = tune_applies()
	tune_bind()
	if not _tune_on:
		return true
	match name:
		"round_len":
			if mode == "classic":
				round_len = nv
			elif mode == "quick":
				round_len = roundf(nv * 24.0 / 35.0)
			round_t = minf(round_t, round_len)
		"setup_len":
			if in_setup():
				round_t = clampf(round_t + old - nv, 0.0, round_len)
	return true


func apply_cfg(c: Dictionary) -> void:
	cfg = c
	_tune_on = tune_applies()
	enemy_present = bool(c.get("enemy_present", true))
	auto_bosses = bool(c.get("auto_bosses", true))
	camp_on = bool(c.get("camp", true))
	duels_on = bool(c.get("duels", duels_on))
	duel_first = int(c.get("duel_first", duel_first))
	duel_every = int(c.get("duel_every", duel_every))
	wave_scale = float(c.get("wave_scale", 1.0))
	wave_keep = float(c.get("wave_keep", 1.0))
	thin_enemy = bool(c.get("thin_enemy", false))
	if c.has("wave_fn"):
		wave_fn = c["wave_fn"]
	max_tech = c.get("max_tech", [99, 99])
	inc_mult = c.get("inc_mult", [1.0, 1.0])
	send_mult = c.get("send_mult", [1.0, 1.0])
	mon_dmg = float(c.get("mon_dmg", 1.0))
	siege_k = float(c.get("siege", 1.0))
	core_siege = c.get("core_siege", [1.0, 1.0])
	regen_k = c.get("regen_k", [1.0, 1.0])
	if c.has("round_len"):
		round_len = float(c["round_len"])
	if c.has("first_wave"):
		round_t = round_len - float(c["first_wave"])
	for i in c.get("absent", []):
		var pl = players[int(i)]
		pl.absent = true
		pl.champ.ar.champs.erase(pl.champ)
	if not enemy_present:
		enemy_sends = false
		duels_on = false
		for pl in players:
			if pl.team == 1 and not pl.absent:
				pl.absent = true
				pl.champ.ar.champs.erase(pl.champ)
	var cm: Array = c.get("core_mult", [1.0, 1.0])
	var cs: Array = c.get("core_start", [1.0, 1.0])
	for tm in 2:
		arenas[tm].core_max *= float(cm[tm])
		arenas[tm].core_hp = arenas[tm].core_max * float(cs[tm])
	var sg: Array = c.get("start_gold", [])
	for pl in players:
		if sg.size() == 2:
			pl.gold = float(sg[pl.team])
		if c.has("start_income"):
			pl.income = int(c["start_income"][pl.team])
	var pw: Array = c.get("hero_pow", [1.0, 1.0])
	for pl in players:
		var ch = pl.champ
		var k := float(pw[pl.team])
		if absf(k - 1.0) < 0.001:
			continue
		ch.pow *= k
		ch.hp_base *= k
		ch.max_hp = ch.hp_base
		ch.hp = ch.max_hp


# Brings a slot that sat out into the match (a campaign ally arriving), standing at p.
func activate_slot(i: int, p := Vector2.ZERO) -> void:
	var pl = players[i]
	if not pl.absent:
		return
	pl.absent = false
	var ch = pl.champ
	ch.dead = false
	ch.hp = ch.max_hp
	ch.p = p if p != Vector2.ZERO else HOMES[ch.home]
	ch.anchor = HOMES[ch.home]
	ch.moving = false
	ch.route = []
	ch.ar = arenas[pl.team]
	if not ch.ar.champs.has(ch):
		ch.ar.champs.append(ch)
	burst(ch.ar, ch.p, ch.col, 30, 200)
	add_fx(ch.ar, {"type": "ring", "p": ch.p, "r": 90.0, "col": ch.col, "t": 0.7, "dur": 0.7, "fill": true})


# Places a monster part-way along a lane (frac 0 = the rift, 1 = the crystal) and returns it.
func place_mon(ar, kind: String, lane: int, frac: float, hpm := 1.0, sender = null) -> Mon:
	var m := spawn_mon(ar, kind, lane, sender, hpm)
	var total: float = m.cum[m.cum.size() - 1]
	var want := total * clampf(frac, 0.0, 1.0)
	var wi := 1
	while wi < m.cum.size() - 1 and m.cum[wi] < want:
		wi += 1
	m.wi = wi
	m.p = m.path[wi - 1].lerp(m.path[wi], 0.5) + m.norms[wi] * m.lat * 0.5
	if not m.fly:
		m.p = bridge_push(m.p, m.r)
	return m


# Points along a lane, for the campaign's camera and placements.
func lane_point(lane: int, frac: float) -> Vector2:
	ensure_lanes()
	var geo: Dictionary = _lanes[lane]
	var cum: Array = geo["cum"]
	var want: float = cum[cum.size() - 1] * clampf(frac, 0.0, 1.0)
	for i in range(1, cum.size()):
		if cum[i] >= want:
			var u: float = (want - cum[i - 1]) / maxf(0.001, cum[i] - cum[i - 1])
			return geo["pts"][i - 1].lerp(geo["pts"][i], u)
	return geo["pts"][geo["pts"].size() - 1]


func make_champ(d: Dictionary, pl, ar, home: int) -> Champ:
	var c := Champ.new()
	var base: Dictionary = GameData.ROLE[d["role"]].duplicate()
	if d.has("over"):
		base.merge(d["over"], true)
	c.def = d
	c.col = Color(d["color"])
	c.pl = pl
	c.ar = ar
	c.home = home
	# everyone starts gathered at the base, between the Armory and the crystal; the AI then walks out to its
	# post (anchor), a human buys first and heads out when ready
	c.p = START_SPOT + Vector2(-30.0 * (home % 2), (home - 1.5) * 48.0)
	c.anchor = c.p if pl.human else HOMES[home]
	c.base = base
	c.pow = 1.0 if pl.human else DIFF_HERO[pl.diff]
	c.hp_base = float(base["hp"]) * float(d["passive"].get("hpMult", 1.0)) * c.pow
	c.max_hp = c.hp_base
	c.hp = c.max_hp
	c.ai_t = rng.randf_range(0.0, 0.3)
	c.ai_build = ai_build_for(String(d["role"]))
	if not pl.human and String(d["role"]) in ["Tank", "Support", "Mage"] and rng.randf() < 0.5:
		c.ai_build = ai_build_waystone(c.ai_build)   # 0.26: half the tanks, supports and mages take the Waystone
	if not pl.human and rng.randf() < 0.35:
		c.skin = ["shadow", "gilded", "frost", "ember"][rng.randi() % 4]
	if not pl.human:
		ai_learn(c)
	return c


# Fisher-Yates shuffle with the match's own RNG (Array.shuffle() would use the global one).
func _shuffle(a: Array) -> void:
	for i in range(a.size() - 1, 0, -1):
		var j := rng.randi_range(0, i)
		var t = a[i]
		a[i] = a[j]
		a[j] = t


static func f(d: Dictionary, k: String, def_v: float = 0.0) -> float:
	return float(d.get(k, def_v))


# Sent monsters hit harder the higher the building they come from (Beast Warren ... Void Rift): their
# melee, ranged and special attacks on heroes are multiplied by this, so a top-tier send is a real threat
# and not just a bag of health.
const SEND_TIER_DMG := [1.0, 1.3, 1.6, 2.0, 2.4, 2.9]
static var _send_tier := {}


static func send_tier(kind: String) -> int:
	if _send_tier.is_empty():
		for sd in GameData.SENDS:
			_send_tier[sd["k"]] = int(sd["b"])
	return int(_send_tier.get(kind, 0))


# The last two sends of every building ("power" sends) cost income instead of earning it, and arrive much
# stronger than the rest of their building.
# [first power send, last power send] of each building
const POWER_HP_K := [1.0, 2.6, 3.4]
const POWER_DMG_K := [1.0, 2.0, 2.6]
const POWER_LIVES := [0, 1, 2]
static var _power := {}

# Sent monsters carry more health than the same monster in a wave: the wave curve (hp_mult) is tuned so a
# team clears its road, and a send that only ever dies on that road is a gift to the enemy. The bonus
# starts at nothing (early sends and waves are the same monsters, so a weak lineup isn't snowballed by
# round 12) and grows 3.5 % a round: x1.7 at round 20, x2.4 at round 40, so late sends cost the defenders
# time and some of them get through. Power sends grow another 1 % a round on top, up to x1.4 at the
# endgame (round 40): they are the investment that is meant to end a match, not an unkillable wall.
const SEND_HP_BASE := 1.0
const SEND_HP_ROUND := 0.035
const POWER_HP_ROUND := 0.01
const SEND_HP_POWER_MAX := 1.5   # power sends take at most this much of the send bonus (they have their own)
# A sent monster's kill pays a share of a wave monster's bounty and experience, with no round or
# difficulty scaling (sends feed the enemy's hero as little as its purse). 0.18: the bounty share grows
# with the send's price (send_gift_k: SEND_BOUNTY_K at a 300 g send, x(cost/300)^SEND_GIFT_EXP, clamped
# to SEND_GIFT_MIN..SEND_GIFT_MAX), so the dear high-rate sends feed the enemy about twice as much of
# their price when killed (~2.5-6 % of the price) as the cheap ones (~1.5-3 %): the counterweight to
# their better income rate. Experience keeps the flat share.
const SEND_BOUNTY_K := 0.4
const SEND_GIFT_ANCHOR := 300.0
const SEND_GIFT_EXP := 0.45
const SEND_GIFT_MIN := 0.12
const SEND_GIFT_MAX := 1.0
const SEND_XP_K := 0.4
# Power sends hand over a little more bounty than a plain send (x1.25 / x1.5)
const POWER_BOUNTY_K := [1.0, 1.25, 1.5]
# Void Rift power sends cost more income the later they are bought (+5 % a round past round 25), so the
# late Devourer rush costs its income in proportion to what it threatens.
const VOID_POWER_INC_FROM := 25
const VOID_POWER_INC_ROUND := 0.05
# Crystal damage: lives beyond the first count half (and at most six of them count), and the round factor
# grows slowly, so the crystal is worn down by many leaks instead of lost to a single big one.
const SIEGE_BASE := 0.5
const SIEGE_ROUND := 0.03
const SIEGE_LIVES_K := 0.5
const SIEGE_LIVES_MAX := 6
# 0.18: there is no per-round send income cap any more. A cheap-send spam is held down by the send table
# itself: the cheapest sends earn the lowest rate (3 % of the price a round) and the dearest the highest
# (6 %), so compounding on kobolds is slow and the better rates sit behind the building prices.


static func send_hp_k(r: int) -> float:
	return SEND_HP_BASE + Tune.v("send_hp_round") * maxi(0, r)


# The health multiplier a monster sent now will spawn with: it joins the next wave, so the next round's
# wave curve (with the endgame and last-wave multipliers) times the send bonus.
func next_send_hp_mult() -> float:
	var r := round_no + 1
	var hm := hp_mult(r) * wave_scale
	if final_round > 0 and r >= ENDGAME_FROM:
		hm *= 1.0 + ENDGAME_HP_K * (r - ENDGAME_FROM + 1)
		if r >= final_round:
			hm *= 2.0
	return hm * send_hp_k(r)


static func power_hp_k(pw: int, r: int) -> float:
	if pw <= 0:
		return 1.0
	return (1.0 + (float(POWER_HP_K[pw]) - 1.0) * Tune.v("power_hp_k")) * (1.0 + POWER_HP_ROUND * clampi(r, 0, ENDGAME_FROM))


# The power sends' damage multiplier and extra crystal lives (POWER_DMG_K / POWER_LIVES through the knobs).
static func power_dmg_k(pw: int) -> float:
	return 1.0 + (float(POWER_DMG_K[pw]) - 1.0) * Tune.v("power_dmg_k")


static func power_lives(pw: int) -> int:
	return roundi(float(POWER_LIVES[pw]) * Tune.v("power_lives_k"))


# Crystal damage per second of a monster with `lives` lives at the crystal in round r (before the sim's
# team-size and campaign multipliers).
static func siege_rate(lives: int, r: int) -> float:
	if lives <= 0:
		return 0.0
	var eff := 1.0 + SIEGE_LIVES_K * float(mini(lives - 1, SIEGE_LIVES_MAX))
	return eff * GameData.SIEGE_DPS * (SIEGE_BASE + SIEGE_ROUND * mini(r, ENDGAME_FROM))


static func power_level(kind: String) -> int:
	if _power.is_empty():
		for sd in GameData.SENDS:
			_power[sd["k"]] = int(sd.get("power", 0))
	return int(_power.get(kind, 0))


static func is_power_send(kind: String) -> bool:
	return power_level(kind) > 0


static func send_dmg_mult(kind: String) -> float:
	return float(SEND_TIER_DMG[clampi(send_tier(kind), 0, SEND_TIER_DMG.size() - 1)])


static var _send_price := {}


# The table price of the send that fields this monster kind (0 for kinds that are never sent, e.g. pebbles).
static func send_price_of(kind: String) -> int:
	if _send_price.is_empty():
		for sd in GameData.SENDS:
			_send_price[sd["k"]] = int(sd["cost"])
	return int(_send_price.get(kind, 0))


# The share of a wave monster's bounty that killing a sent monster of this kind pays (see SEND_GIFT_EXP).
static func send_gift_k(kind: String) -> float:
	var c := Tune.send_price(kind, send_price_of(kind))
	var gk := Tune.v("send_gift_k")
	if c <= 0:
		return gk
	return clampf(gk * pow(float(c) / SEND_GIFT_ANCHOR, Tune.v("send_gift_exp")), SEND_GIFT_MIN, SEND_GIFT_MAX)


static func hp_mult(r: int) -> float:
	var m := 1.0 + 0.1 * (r - 1)
	if r > 14:
		m += 0.36 * (r - 14)
	if r > 21:
		m += 0.6 * (r - 21)
	var k := Tune.v("wave_hp_k")
	return m if k == 1.0 else 1.0 + (m - 1.0) * k


func send_cost(k: int, team := 0) -> int:
	tune_bind()
	return roundi(float(Tune.send_cost(k, Tune.active)) * float(send_mult[team]))   # fixed price all match (0.18.5: per-monster override or the table x knob)


# Breaks the reference cycles between players, champions and arenas so a finished match is freed.
func dispose() -> void:
	for ar in arenas:
		for c in ar.champs:
			c.pl = null
			c.ar = null
			c.ai_tgt = null
		for list in [ar.champs, ar.mons, ar.projs, ar.zones, ar.pend, ar.sums, ar.fx, ar.parts, ar.texts, ar.queued, ar.spawn_q, ar.mprojs, ar.spawn_now, ar.mpend]:
			list.clear()
	for pl in players:
		pl.champ = null
	players.clear()
	arenas.clear()


# ---------------------------------------------------------------- lane geometry
# Fine polylines (Catmull-Rom through the control points), per-point normals and cumulative length.
# Ground monsters follow the fine road; flyers follow the straight control polyline.
static var _lanes: Array = []        # [{pts, norms, cum}] for ground, per lane
static var _air: Array = []          # same for flyers
const FIELD_CELL := 16.0
static var _field_w := 0
static var _field_h := 0
static var _field_d := PackedFloat32Array()
static var _field_q := PackedVector2Array()


static func _cr(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, u: float) -> Vector2:
	var t2 := u * u
	var t3 := t2 * u
	return 0.5 * ((2.0 * p1) + (-p0 + p2) * u + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2 + (-p0 + 3.0 * p1 - 3.0 * p2 + p3) * t3)


static func _spline(ctrl: Array, seg_len: float, pre = null, post = null) -> PackedVector2Array:
	var out := PackedVector2Array()
	var n := ctrl.size()
	for i in n - 1:
		var p0: Vector2 = ctrl[i - 1] if i > 0 else (pre if pre != null else ctrl[0] * 2.0 - ctrl[1])
		var p1: Vector2 = ctrl[i]
		var p2: Vector2 = ctrl[i + 1]
		var p3: Vector2 = ctrl[i + 2] if i + 2 < n else (post if post != null else ctrl[n - 1] * 2.0 - ctrl[n - 2])
		var segs := maxi(2, int(p1.distance_to(p2) / seg_len))
		for k in segs:
			out.append(_cr(p0, p1, p2, p3, float(k) / segs))
	out.append(ctrl[n - 1])
	return out


static func _pack(pts: PackedVector2Array) -> Dictionary:
	var norms := PackedVector2Array()
	var cum := PackedFloat32Array()
	var acc := 0.0
	for i in pts.size():
		var a: Vector2 = pts[maxi(0, i - 1)]
		var b: Vector2 = pts[mini(pts.size() - 1, i + 1)]
		norms.append((b - a).normalized().orthogonal())
		if i > 0:
			acc += pts[i].distance_to(pts[i - 1])
		cum.append(acc)
	return {"pts": pts, "norms": norms, "cum": cum}


static func ensure_lanes() -> void:
	if PATHS.is_empty():
		set_map(map_id)
	if not _lanes.is_empty():
		return
	var j0: int = JUNCTION_IDX[0]
	var j1: int = JUNCTION_IDX[1]
	var shared: Array = PATHS[0].slice(j0)
	var avg_prev: Vector2 = (PATHS[0][j0 - 1] + PATHS[1][j1 - 1]) / 2.0
	var shared_pts := _spline(shared, 36.0, avg_prev)
	for lane in 2:
		var J: int = JUNCTION_IDX[lane]
		var pre: Array = PATHS[lane].slice(0, J + 1)
		var pts := _spline(pre, 36.0, null, PATHS[lane][J + 1])
		pts.remove_at(pts.size() - 1)
		pts.append_array(shared_pts)
		_lanes.append(_pack(pts))
		var air := PackedVector2Array()
		for q in PATHS[lane]:
			air.append(q)
		_air.append(_pack(air))
	_build_field()


static func lane_points(lane: int) -> PackedVector2Array:
	ensure_lanes()
	return _lanes[lane]["pts"]


# For every grid cell near a road: the distance to the road's centre line and the nearest point on it.
# Maps with a walkable river (Ashfall): heroes can wade along the whole fissure, so it is part of the
# walkable field and of the hero route graph. Same curve as tools/terrain/build_terrain.py.
static func river_line() -> PackedVector2Array:
	var out := PackedVector2Array()
	var m: Dictionary = MAPS[map_id]
	if not m.has("river"):
		return out
	var rx := float(m["river"])
	var y := 0.0
	while y <= H + 0.1:
		out.append(Vector2(rx + 110.0 * sin(y / 330.0) + 40.0 * sin(y / 97.0 + 1.3), y))
		y += 64.0
	return out


static func _build_field() -> void:
	_field_w = int(ceil(W / FIELD_CELL)) + 1
	_field_h = int(ceil(H / FIELD_CELL)) + 1
	_field_d = PackedFloat32Array()
	_field_d.resize(_field_w * _field_h)
	_field_d.fill(1e9)
	_field_q = PackedVector2Array()
	_field_q.resize(_field_w * _field_h)
	var reach := WALK_R + 140.0
	var segs: Array = []
	for lane in _lanes:
		var pts: PackedVector2Array = lane["pts"]
		for i in range(1, pts.size()):
			segs.append([pts[i - 1], pts[i]])
	segs.append([_lanes[0]["pts"][_lanes[0]["pts"].size() - 1], CORE])
	var rv := river_line()
	for i in range(1, rv.size()):
		segs.append([rv[i - 1], rv[i]])
	_camp_trails = _find_camp_trails(segs)
	segs.append_array(_camp_trails)
	for sg in segs:
		var a: Vector2 = sg[0]
		var b: Vector2 = sg[1]
		var x0 := maxi(0, int((minf(a.x, b.x) - reach) / FIELD_CELL))
		var x1 := mini(_field_w - 1, int((maxf(a.x, b.x) + reach) / FIELD_CELL))
		var y0 := maxi(0, int((minf(a.y, b.y) - reach) / FIELD_CELL))
		var y1 := mini(_field_h - 1, int((maxf(a.y, b.y) + reach) / FIELD_CELL))
		for gy in range(y0, y1 + 1):
			for gx in range(x0, x1 + 1):
				var c := Vector2(gx * FIELD_CELL, gy * FIELD_CELL)
				var q := Geometry2D.get_closest_point_to_segment(c, a, b)
				var d := c.distance_to(q)
				var idx := gy * _field_w + gx
				if d < _field_d[idx]:
					_field_d[idx] = d
					_field_q[idx] = q


# A neutral camp stands off the roads. When no road (or walkable river) passes within WALK_R / 2 of it, a
# trail runs straight to it from the nearest point of each lane: part of the walkable field and of the hero
# route graph. Same rule as camp_trails() in tools/terrain/build_terrain.py, which paints them.
static var _camp_trails: Array = []    # [[road point, camp pos, camp index], ...]


static func _find_camp_trails(segs: Array) -> Array:
	var out: Array = []
	for ci in CAMPS.size():
		var cp: Vector2 = CAMPS[ci]["pos"]
		var near := INF
		for sg in segs:
			near = minf(near, cp.distance_to(Geometry2D.get_closest_point_to_segment(cp, sg[0], sg[1])))
		if near <= WALK_R * 0.5:
			continue
		for lane in _lanes:
			var pts: PackedVector2Array = lane["pts"]
			var bq: Vector2 = pts[0]
			for i in range(1, pts.size()):
				var q := Geometry2D.get_closest_point_to_segment(cp, pts[i - 1], pts[i])
				if q.distance_to(cp) < bq.distance_to(cp):
					bq = q
			out.append([bq, cp, ci])
	return out


# Distance from p to the road's centre line (large when far from any road).
static func road_dist(p: Vector2) -> float:
	ensure_lanes()
	var gx := clampi(int(round(p.x / FIELD_CELL)), 0, _field_w - 1)
	var gy := clampi(int(round(p.y / FIELD_CELL)), 0, _field_h - 1)
	var idx := gy * _field_w + gx
	var d: float = _field_d[idx]
	if d > 1e8:
		return 1e9
	return p.distance_to(_field_q[idx])


# ---------------------------------------------------------------- road graph & hero pathing
static var _g_nodes: Array = []
static var _g_edges: Array = []
static var _g_adj: Array = []


static func _ensure_graph() -> void:
	if PATHS.is_empty():
		set_map(map_id)
	if not _g_nodes.is_empty():
		return
	var p0: Array = PATHS[0]
	_g_nodes = p0.duplicate()
	_g_edges = []
	for i in range(1, p0.size()):
		_g_edges.append([i - 1, i])
	var base := _g_nodes.size()
	var j1: int = JUNCTION_IDX[1]
	for i in j1:
		_g_nodes.append(PATHS[1][i])
		if i > 0:
			_g_edges.append([base + i - 1, base + i])
	_g_edges.append([base + j1 - 1, JUNCTION_IDX[0]])
	_g_nodes.append(CORE)
	_g_edges.append([p0.size() - 1, _g_nodes.size() - 1])
	var rv := river_line()
	if rv.size() > 1:
		var road_edges: Array = _g_edges.duplicate()
		var rbase := _g_nodes.size()
		for i in rv.size():
			_g_nodes.append(rv[i])
			if i > 0:
				_g_edges.append([rbase + i - 1, rbase + i])
		# where the river crosses a road, a shared node links the two (at a bridge, the walls are in the
		# way: the river joins the road round the bridge ends instead, see _bridge_graph)
		var xs := {}
		for e in road_edges:
			for i in range(1, rv.size()):
				var x = Geometry2D.segment_intersects_segment(_g_nodes[e[0]], _g_nodes[e[1]], rv[i - 1], rv[i])
				if x != null:
					_g_nodes.append(x)
					var xi := _g_nodes.size() - 1
					_g_edges.append([xi, e[0]])
					_g_edges.append([xi, e[1]])
					var bi := _bridge_at(x)
					if bi >= 0:
						xs[bi] = xi
						continue
					_g_edges.append([xi, rbase + i - 1])
					_g_edges.append([xi, rbase + i])
		if not xs.is_empty():
			_bridge_graph(xs, rbase, rv.size())
	_camp_graph(p0.size() + j1)
	_g_adj = []
	for i in _g_nodes.size():
		_g_adj.append([])
	for e in _g_edges:
		var w: float = _g_nodes[e[0]].distance_to(_g_nodes[e[1]])
		_g_adj[e[0]].append([e[1], w])
		_g_adj[e[1]].append([e[0], w])


# The trails to the camps join the road graph at their road ends (core_i: the crystal's node, the last of
# the road nodes).
static func _camp_graph(core_i: int) -> void:
	ensure_lanes()
	if _camp_trails.is_empty():
		return
	var road_edges: Array = _g_edges.filter(func(e): return e[0] <= core_i and e[1] <= core_i)
	var camp_node := {}
	for tr in _camp_trails:
		var ci_k: int = tr[2]
		if not camp_node.has(ci_k):
			_g_nodes.append(tr[1])
			camp_node[ci_k] = _g_nodes.size() - 1
		var ci: int = camp_node[ci_k]
		var q: Vector2 = tr[0]
		var be: Array = road_edges[0]
		var bd := INF
		for e in road_edges:
			var d := q.distance_squared_to(Geometry2D.get_closest_point_to_segment(q, _g_nodes[e[0]], _g_nodes[e[1]]))
			if d < bd:
				bd = d
				be = e
		_g_nodes.append(q)
		var qi := _g_nodes.size() - 1
		_g_edges.append([qi, be[0]])
		_g_edges.append([qi, be[1]])
		_g_edges.append([qi, ci])


static func _in_bridge(p: Vector2, b: Array) -> bool:
	var d: Vector2 = p - b[0]
	return absf(d.dot(b[1])) <= BRIDGE_WALL_L and absf(d.dot(b[2])) <= BRIDGE_OUT


# 0.26: the walls plus the cutwater piers' reach (with a walker's radius): a river node this close to the
# bridge is not linked to the corner nodes, since the pier stands between (that link had heroes pressed
# against the pier's flank below the deck, the 0.25 Ashfall report).
static func _in_bridge_wide(p: Vector2, b: Array) -> bool:
	var d: Vector2 = p - b[0]
	return absf(d.dot(b[1])) <= BRIDGE_WALL_L and absf(d.dot(b[2])) <= BRIDGE_PIER_OUT + 16.0


static func _bridge_at(p: Vector2) -> int:
	var list := bridges()
	for bi in list.size():
		if _in_bridge(p, list[bi]):
			return bi
	return -1


# Ashfall's wading route at a bridge: the river edges through the bridge are dropped; the river on either side
# joins corner nodes outside the walls, which go round the bridge ends to the road (and to the crossing on the deck).
static func _bridge_graph(xs: Dictionary, rbase: int, rn: int) -> void:
	var list := bridges()
	var extra: Array = []
	for bi in xs:
		var b: Array = list[bi]
		var c: Vector2 = b[0]
		var u: Vector2 = b[1]
		var n: Vector2 = b[2]
		var ea := BRIDGE_WALL_L + 40.0
		var kl := BRIDGE_OUT + 50.0
		var corners: Array = []
		var by_side := {}
		for sa in [-1.0, 1.0]:
			_g_nodes.append(c + u * sa * ea)
			var ei := _g_nodes.size() - 1
			extra.append([ei, xs[bi]])
			for sl in [-1.0, 1.0]:
				_g_nodes.append(c + u * sa * ea + n * sl * kl)
				var ki := _g_nodes.size() - 1
				extra.append([ei, ki])
				corners.append(ki)
				by_side[Vector2(sa, sl)] = ki
		for sl in [-1.0, 1.0]:
			extra.append([by_side[Vector2(-1.0, sl)], by_side[Vector2(1.0, sl)]])
		var keep: Array = []
		for e in _g_edges:
			var river: bool = e[0] >= rbase and e[0] < rbase + rn and e[1] >= rbase and e[1] < rbase + rn
			if river:
				var p0: Vector2 = _g_nodes[e[0]]
				var p1: Vector2 = _g_nodes[e[1]]
				var hit := false
				var steps := int(p0.distance_to(p1) / 8.0) + 1
				for k in steps + 1:
					if _in_bridge_wide(p0.lerp(p1, float(k) / steps), b):
						hit = true
						break
				if hit:
					for k in [e[0], e[1]]:
						if _in_bridge_wide(_g_nodes[k], b):
							continue
						var best: int = corners[0]
						for ki in corners:
							if _g_nodes[ki].distance_to(_g_nodes[k]) < _g_nodes[best].distance_to(_g_nodes[k]):
								best = ki
						extra.append([k, best])
					continue
			keep.append(e)
		_g_edges = keep
	_g_edges.append_array(extra)


static func nearest_edge(p: Vector2) -> Array:
	_ensure_graph()
	var best: Array = _g_edges[0]
	var bd := INF
	for e in _g_edges:
		var q := Geometry2D.get_closest_point_to_segment(p, _g_nodes[e[0]], _g_nodes[e[1]])
		var d := p.distance_squared_to(q)
		if d < bd:
			bd = d
			best = e
	return best


static func road_point(p: Vector2) -> Vector2:
	ensure_lanes()
	var gx := clampi(int(round(p.x / FIELD_CELL)), 0, _field_w - 1)
	var gy := clampi(int(round(p.y / FIELD_CELL)), 0, _field_h - 1)
	var idx := gy * _field_w + gx
	if _field_d[idx] < 1e8:
		return _field_q[idx]
	var best := Vector2.ZERO
	var bd := INF
	for lane in _lanes:
		for q in lane["pts"]:
			var d: float = p.distance_squared_to(q)
			if d < bd:
				bd = d
				best = q
	return best


# ---------------------------------------------------------------- stone bridges
# Where a road crosses a river on a stone bridge (the "bridge" props of art/maps/<map>/dressing.json, written by
# tools/terrain/build_terrain.py bridges(): [x, y, yaw], model scale 66, deck along the road; keep in sync).
# Ground units cross on the deck: they can't walk through the parapets, abutments and piers, and on Riverfork
# not into the water beside the bridge either. On Ashfall the lava fissure stays wadeable (see river_line), so
# the wading route goes round the bridge ends (a walkable apron beside the walls) instead of through the deck.
const BRIDGES := {"riverfork": [[2995.0, 1144.1, 0.369]], "ashfall": [[1361.3, 366.6, 0.292], [1164.0, 1625.0, -0.41]]}
const BRIDGE_IN := 102.0          # half-width of the deck (inner face of the parapets)
const BRIDGE_OUT := 148.0         # outer face of the parapets and abutments
const BRIDGE_WALL_L := 262.0      # parapets, abutments and wing walls run this far along the road either side
const BRIDGE_DECK_L := 238.0      # half-length of the raised deck
const BRIDGE_DECK_H := 4.3        # deck surface above the ground (world units; the view stands things on it)
const BRIDGE_PIER_A := 58.0       # cutwater piers: centre along the road, half-length, outer reach
const BRIDGE_PIER_HW := 22.0
const BRIDGE_PIER_OUT := 172.0
const BRIDGE_APRON := Vector2(70.0, 80.0)   # Ashfall: walkable ground past the wall ends / outside the walls
static var _br: Array = []        # this map's bridges: [centre, along-road unit, across unit]
static var _br_map := -1
static var _br_water := false    # the river is not wadeable (Riverfork): nothing but the deck along the walls
static var _br_apron := false


static func bridges() -> Array:
	if _br_map != map_id:
		_br_map = map_id
		_br = []
		var id: String = MAPS[map_id]["id"]
		for b in BRIDGES.get(id, []):
			var u := Vector2(cos(float(b[2])), -sin(float(b[2])))
			_br.append([Vector2(b[0], b[1]), u, u.orthogonal()])
		_br_apron = MAPS[map_id].has("river")
		_br_water = not _br_apron
	return _br


# Moves a ground unit of radius r out of a bridge's walls, piers and (Riverfork) the water beside it, to the
# nearest free point: units slide along the parapets instead of passing through them. Cheap when no bridge
# is near (one distance test per bridge; maps without bridges return at once).
static func bridge_push(p: Vector2, r := 13.0) -> Vector2:
	var list := bridges()
	if list.is_empty():
		return p
	r = minf(r, 40.0)
	var inner := maxf(BRIDGE_IN - r, 0.0)
	var outer := BRIDGE_OUT + r
	for b in list:
		var c: Vector2 = b[0]
		var u: Vector2 = b[1]
		var n: Vector2 = b[2]
		var d := p - c
		var a := d.dot(u)
		var l := d.dot(n)
		if absf(a) > BRIDGE_WALL_L + r or absf(l) > BRIDGE_PIER_OUT + 200.0:
			continue
		var moved := false
		var aa := absf(a)
		var al := absf(l)
		var sa := 1.0 if a >= 0.0 else -1.0
		var sl := 1.0 if l >= 0.0 else -1.0
		if _br_water and al > inner:
			# a river that is not wadeable: along the walls, the deck is the only way (beside it are the
			# parapets, then water): back onto the deck, or back off the bridge end, whichever is nearer
			if al - inner <= BRIDGE_WALL_L + r - aa:
				l = sl * inner
			else:
				a = sa * (BRIDGE_WALL_L + r)
			p = c + u * a + n * l
			continue
		# parapets, abutments and wing walls
		if al > inner and al < outer and aa < BRIDGE_WALL_L + r:
			var c_in := al - inner
			var c_out := outer - al
			var c_end := BRIDGE_WALL_L + r - aa
			if c_in <= c_out and c_in <= c_end:
				l = sl * inner
			elif c_out <= c_end:
				l = sl * outer
			else:
				a = sa * (BRIDGE_WALL_L + r)
			moved = true
			aa = absf(a)
			al = absf(l)
		# the cutwater piers standing out of the river on both sides
		var pa := aa - BRIDGE_PIER_A
		if al >= outer - 0.5 and al < BRIDGE_PIER_OUT + r and absf(pa) < BRIDGE_PIER_HW + r:
			var c_side := BRIDGE_PIER_HW + r - absf(pa)
			var c_far := BRIDGE_PIER_OUT + r - al
			if c_side <= c_far:
				a = sa * (BRIDGE_PIER_A + (BRIDGE_PIER_HW + r) * (1.0 if pa >= 0.0 else -1.0))
			else:
				l = sl * (BRIDGE_PIER_OUT + r)
			moved = true
		if moved:
			p = c + u * a + n * l
	return p


# Inside a wall, a pier or the water beside a bridge (with a small margin, for route planning).
static func bridge_blocked(p: Vector2, r := 8.0) -> bool:
	return bridge_push(p, r).distance_squared_to(p) > 0.25


# Ashfall: the bank round the bridge ends and alongside the walls, where the wading route leaves the river.
static func bridge_apron(p: Vector2) -> bool:
	var list := bridges()
	if not _br_apron:
		return false
	for b in list:
		var d: Vector2 = p - b[0]
		if absf(d.dot(b[1])) <= BRIDGE_WALL_L + BRIDGE_APRON.x and absf(d.dot(b[2])) <= BRIDGE_OUT + BRIDGE_APRON.y:
			return true
	return false


# Bridges as obstacles for a straight move (dash): the last free point from a toward b.
static func bridge_stop(a: Vector2, b: Vector2, r := 13.0) -> Vector2:
	if bridges().is_empty():
		return b
	var n := int(a.distance_to(b) / 8.0) + 1
	var last := a
	for i in range(1, n + 1):
		var q := a.lerp(b, float(i) / n)
		if bridge_push(q, r).distance_squared_to(q) > 0.25:
			return bridge_push(last, r)
		last = q
	return b


# The height of the walking surface (the bridge decks stand a little above the ground). View only.
static func deck_h(p: Vector2) -> float:
	for b in bridges():
		var d: Vector2 = p - b[0]
		var a := absf(d.dot(b[1]))
		if a < BRIDGE_DECK_L + 6.0 and absf(d.dot(b[2])) < BRIDGE_OUT:
			return BRIDGE_DECK_H * clampf((BRIDGE_DECK_L + 6.0 - a) / 12.0, 0.0, 1.0)
	return 0.0


static func walkable(p: Vector2) -> bool:
	if p.distance_to(CORE) < CASTLE_R:
		return true
	if road_dist(p) > WALK_R + 1.0 and not bridge_apron(p):
		return false
	# 0.26: the margin matches the hero's own wall radius (walk_clamp, 13): a route may no longer hug a wall
	# closer than the walker can follow, which left it pressed against the stone a few px short of its line
	return not bridge_blocked(p, 12.0)


static func walk_clamp(p: Vector2, r := 13.0) -> Vector2:
	if p.distance_to(CORE) < CASTLE_R:
		return p
	if road_dist(p) <= WALK_R or bridge_apron(p):
		return bridge_push(p, r)
	var q := road_point(p)
	var d := p.distance_to(q)
	if d <= WALK_R:
		return bridge_push(p, r)
	return bridge_push(q + (p - q) / d * WALK_R, r)


static func path_clear(a: Vector2, b: Vector2) -> bool:
	var n := int(a.distance_to(b) / 16.0)
	for i in range(1, n + 1):
		if not walkable(a.lerp(b, float(i) / (n + 1))):
			return false
	return true


# 0.26: a bridge's parapet or abutment stands between a and b (melee cannot reach across it; arrows and
# spells fly over). Only the stone itself counts, not the deck, the water or the lava.
static func wall_between(a: Vector2, b: Vector2) -> bool:
	for br in bridges():
		var c: Vector2 = br[0]
		var a0 := Vector2((a - c).dot(br[1]), (a - c).dot(br[2]))
		var b0 := Vector2((b - c).dot(br[1]), (b - c).dot(br[2]))
		if minf(absf(a0.x), absf(b0.x)) > BRIDGE_WALL_L + 40.0:
			continue
		var n := int(a0.distance_to(b0) / 6.0) + 1
		for i in n + 1:
			var q := a0.lerp(b0, float(i) / n)
			var al := absf(q.y)
			if absf(q.x) < BRIDGE_WALL_L and al > BRIDGE_IN and al < BRIDGE_OUT:
				return true
	return false


# 0.26: the graph nodes a unit at p can walk straight to (no wall, no forest between), nearest first, at most
# `want` of them within `r`. The nearest edge's ends used to start and end every route whatever lay between:
# beside a bridge the nearest edge is often the wading route on the far side of a parapet, so the route's first
# (or last) leg ran through the wall and the hero pressed against it for good (0.25 Ashfall report).
static func reach_nodes(p: Vector2, want: int, r := 900.0) -> Array:
	_ensure_graph()
	var near: Array = []
	for k in _g_nodes.size():
		if _g_adj[k].is_empty():
			continue   # a river node under a bridge deck: cut out of the graph, leads nowhere
		var d: float = p.distance_squared_to(_g_nodes[k])
		if d <= r * r:
			near.append([d, k])
	near.sort_custom(func(x, y): return x[0] < y[0] if x[0] != y[0] else x[1] < y[1])
	var out: Array = []
	for pair in near:
		if path_clear(p, _g_nodes[pair[1]]):
			out.append(pair[1])
			if out.size() >= want:
				break
	return out


# Route along the road graph, then skip every waypoint that can be cut straight to.
static func plan_route(from: Vector2, to: Vector2) -> Array:
	if path_clear(from, to):
		return [to]
	_ensure_graph()
	var n := _g_nodes.size()
	var dist: Array = []
	var prev: Array = []
	var done: Array = []
	dist.resize(n)
	dist.fill(INF)
	prev.resize(n)
	prev.fill(-1)
	done.resize(n)
	done.fill(false)
	var starts: Array = reach_nodes(from, 3)
	if starts.is_empty():
		starts = nearest_edge(from)   # walled in: the old straight guess, and unstick() sorts it out
	for k in starts:
		dist[k] = from.distance_to(_g_nodes[k])
	var ends: Array = reach_nodes(to, 3)
	if ends.is_empty():
		ends = nearest_edge(to)
	for _i in n:
		var best := -1
		for k in n:
			if not done[k] and (best == -1 or dist[k] < dist[best]):
				best = k
		if best == -1 or dist[best] == INF:
			break
		done[best] = true
		for pair in _g_adj[best]:
			var nd: float = dist[best] + pair[1]
			if nd < dist[pair[0]]:
				dist[pair[0]] = nd
				prev[pair[0]] = best
	var end_node := -1
	var bc := INF
	for k in ends:
		var cst: float = dist[k] + _g_nodes[k].distance_to(to)
		if cst < bc:
			bc = cst
			end_node = k
	var seq: Array = []
	var u := end_node
	while u != -1:
		seq.push_front(_g_nodes[u])
		u = prev[u]
	seq.append(to)
	var out: Array = []
	var cur := from
	var i := 0
	while i < seq.size():
		var k := seq.size() - 1
		while k > i and not path_clear(cur, seq[k]):
			k -= 1
		out.append(seq[k])
		cur = seq[k]
		i = k + 1
	return out


func order_move(c, to: Vector2) -> void:
	var raw := Vector2(clampf(to.x, 12, W - 12), clampf(to.y, 12, H - 12))
	to = walk_clamp(raw)
	if bridge_blocked(raw):
		# a click on a bridge wall: walk up to it on this side rather than round to its far face
		to = walk_clamp(bridge_stop(c.p, to))
	c.move_to = to
	c.route = plan_route(c.p, to)
	c.moving = true


# ---------------------------------------------------------------- player orders
# move: walk there, ignore monsters.  amove: walk there, fight everything met on the way.
# attack: chase one monster until it dies.  hold: stay put, hit what comes in range.
# idle (after any order finishes): with auto-attack on, engage monsters that come near, but don't wander far.
func hero_order(c, kind: String, pt := Vector2.ZERO, tgt = null) -> void:
	if c.dead:
		return
	c.chan = null   # any order ends a channel (Soul Tether)
	recall_cancel(c)   # ... and a Recall
	c.order_tgt = tgt
	c.cur_tgt = null
	c.chasing = false
	c.repath = 0.0
	match kind:
		"move", "amove":
			c.order = kind
			order_move(c, pt)
			c.order_pt = c.move_to
		"attack":
			c.order = "attack" if tgt != null else "idle"
		"hold":
			c.order = "hold"
			c.moving = false
			c.route.clear()
		_:
			c.order = "idle"
			c.moving = false
			c.route.clear()
			c.anchor = c.p


func _hittable(ar, m, melee: bool) -> bool:
	return m != null and not m.dead and ar.mons.has(m)   # every hero can hit flyers now


func acquire_range(c) -> float:
	return maxf(c_range(c) + 250.0, 380.0)


func human_orders(ar, c, dt: float) -> void:
	var reach := c_range(c)
	var melee := reach <= 60
	var acq := acquire_range(c)
	c.repath -= dt
	var tgt = null
	match c.order:
		"attack":
			if _hittable(ar, c.order_tgt, melee):
				tgt = c.order_tgt
			else:
				c.order = "idle"
				c.order_tgt = null
				c.anchor = c.p
		"amove":
			if _hittable(ar, c.cur_tgt, melee) and c.cur_tgt.p.distance_to(c.p) < acq * 1.5:
				tgt = c.cur_tgt
			else:
				tgt = nearest_mon(ar, c.p, acq)
		"idle":
			if c.auto_acq:
				if c.p.distance_to(c.anchor) > 560.0:
					tgt = null   # leashed: stop chasing and walk back
				elif _hittable(ar, c.cur_tgt, melee) and c.cur_tgt.p.distance_to(c.p) < acq * 1.3:
					tgt = c.cur_tgt
				else:
					tgt = nearest_mon(ar, c.p, acq)
	c.cur_tgt = tgt
	if tgt != null:
		if tgt.p.distance_to(c.p) - tgt.r <= reach:
			c.moving = false
			c.route.clear()
		elif c.repath <= 0 or not c.moving:
			c.repath = 0.25
			order_move(c, tgt.p)
		c.chasing = true
		return
	var was_chasing: bool = c.chasing
	c.chasing = false
	match c.order:
		"amove":
			if c.p.distance_to(c.order_pt) <= 26.0:
				c.order = "idle"
				c.anchor = c.p
			elif was_chasing or not c.moving:
				order_move(c, c.order_pt)
		"move":
			if not c.moving:
				c.order = "idle"
				c.anchor = c.p
		"idle":
			if c.auto_acq and c.p.distance_to(c.anchor) > 40.0 and (was_chasing or not c.moving):
				order_move(c, c.anchor)
			elif was_chasing and not c.auto_acq:
				c.moving = false


# ---------------------------------------------------------------- champion stats
# Levels 1-16 each give an ability point and a little growth; past that, levels give bigger stat gains.
func lvl_mult(c) -> float:
	return 1.0 + 0.06 * (mini(c.lvl, SKILL_LEVELS) - 1) + 0.12 * maxi(0, c.lvl - SKILL_LEVELS)


func istat(c, k: String) -> float:
	return float(c.ist.get(k, 0.0))


func bm(c, k: String) -> float:
	var m := 1.0
	for b in c.buffs:
		if b.has(k):
			m *= float(b[k])
	return m


func bsum(c, k: String) -> float:
	var s := 0.0
	for b in c.buffs:
		if b.has(k):
			s += float(b[k])
	return s


func sm(c) -> float:
	return lvl_mult(c) * bm(c, "dmg") * c.pow


# ---- attributes (see GameData.PRIMARY)
func attr(c, k: String) -> float:
	var role: String = c.def["role"]
	var b: float = float(GameData.ATTR_BASE[role][k])
	var g: float = GameData.ATTR_GROW_PRIMARY if GameData.PRIMARY[role] == k else GameData.ATTR_GROW_OTHER
	return b + g * float(c.lvl - 1) + istat(c, k)


# How far an attribute is above the hero's level-1 base: what its bonuses are paid from.
func attr_gain(c, k: String) -> float:
	return attr(c, k) - float(GameData.ATTR_BASE[c.def["role"]][k])


func primary_attr(c) -> String:
	return GameData.PRIMARY[c.def["role"]]


func attr_hp(c) -> float:
	return GameData.ATTR_HP * attr_gain(c, "mig")


func c_dmg(c) -> float:
	var d := (f(c.base, "dmg") + istat(c, "dmg") + GameData.ATTR_DMG * attr_gain(c, primary_attr(c))) * sm(c) * (1.0 + istat(c, "dmg_pct")) * (1.0 + bsum(c, "oath"))
	# attack speed past the cap is not wasted: half of the excess becomes attack damage
	var raw := c_as_raw(c)
	if raw > MAX_AS:
		d *= 1.0 + AS_OVERFLOW_K * (raw / MAX_AS - 1.0)
	return d


# Attack speed before the cap (see c_as).
func c_as_raw(c) -> float:
	var g := 1.0 + 0.02 * (mini(c.lvl, SKILL_LEVELS) - 1) + 0.05 * maxi(0, c.lvl - SKILL_LEVELS)
	return f(c.base, "as") * g * (1.0 + istat(c, "as") + GameData.ATTR_AS * attr_gain(c, "cun")) * bm(c, "as")


func c_as(c) -> float:
	return minf(MAX_AS, c_as_raw(c))


func c_ms(c) -> float:
	return f(c.base, "ms") * HERO_MS_K * (1.0 + minf(istat(c, "ms"), 1.0)) * bm(c, "ms") * ((1.0 - c.slow) if c.slow_t > 0 else 1.0)


const MAX_AS := 4.0             # attacks per second can never go above this
const AS_OVERFLOW_K := 0.5      # share of attack speed past the cap that turns into attack damage


func c_ap(c) -> float:
	return istat(c, "ap") + GameData.ATTR_AP * attr_gain(c, primary_attr(c))


func c_range(c) -> float:
	return f(c.base, "range") + bsum(c, "rng")


func c_armor(c) -> float:
	return minf(0.6, istat(c, "armor") + bsum(c, "armor_add") + 0.015 * maxi(0, c.lvl - SKILL_LEVELS))


# Trinity Sigil's Attunement: a damage multiplier from every attribute point above the level-1 base.
func attuned_mult(c) -> float:
	if not c.uniq.has("attuned"):
		return 1.0
	var tot := attr_gain(c, "mig") + attr_gain(c, "res") + attr_gain(c, "cun")
	return 1.0 + f(c.uniq["attuned"], "per") * tot


func c_regen(c) -> float:
	return 3.0 + istat(c, "regen") + bsum(c, "regen_add")


func c_cdr(c) -> float:
	return minf(0.4, istat(c, "cdr") + GameData.ATTR_CDR * attr_gain(c, "res") + bsum(c, "cdr_add"))


# Ability strength: rank 1 = 100%, each rank +35%, then ability power from items.
func rank_mult(c, i: int) -> float:
	return (1.0 + 0.35 * maxi(0, c.ranks[i] - 1)) * (1.0 + c_ap(c)) * float(c.skill_k[i]) * float(c.syn_fx.get("skill", 1.0))


func skill_cd(c, i: int) -> float:
	var sk: Dictionary = c.def["skills"][i]
	return f(sk, "cd") * (1.0 - 0.07 * maxi(0, c.ranks[i] - 1)) * (1.0 - c_cdr(c)) * float(c.cd_k[i])


static func rank_req(i: int, rank: int) -> int:
	# Q W E: rank n needs hero level 2n-1 (1, 3, 5, 7). R: levels 6, 9, 12, 15.
	return 2 * rank - 1 if i < 3 else 3 + 3 * rank


func can_learn(c, i: int) -> bool:
	if c.def["skills"][i].get("empty", false):
		return false   # survival: an empty slot is filled from the round's cards
	return c.points > 0 and c.ranks[i] < MAX_RANK and c.lvl >= rank_req(i, c.ranks[i] + 1)


func learn(c, i: int) -> bool:
	if not can_learn(c, i):
		return false
	c.points -= 1
	c.ranks[i] += 1
	if c.ar != null:
		add_text(c.ar, c.p + Vector2(0, -40), "%s rank %d" % [c.def["skills"][i]["name"], c.ranks[i]], Color("#b8e0ff"), 1.3, 12)
	return true


# AI: one point in each basic ability first, then the ultimate whenever possible, then Q > W > E.
func ai_learn(c) -> void:
	while c.points > 0:
		var pick := -1
		for i in 3:
			if c.ranks[i] == 0 and can_learn(c, i):
				pick = i
				break
		if pick < 0 and can_learn(c, 3):
			pick = 3
		if pick < 0:
			for i in 3:
				if can_learn(c, i):
					pick = i
					break
		if pick < 0:
			return
		c.points -= 1
		c.ranks[pick] += 1


static func xp_need(l: int) -> float:
	return 60.0 + 42.0 * l


func gain_xp(ar, c, x: float) -> void:
	# fewer heroes means fewer monsters to learn from: small teams level faster to keep pace
	c.xp += x * (SURV_XP * surv_xp if mode == "survival" else [1.0, 1.9, 1.4, 1.2, 1.0][team_size])
	while c.lvl < MAX_LVL and c.xp >= xp_need(c.lvl):
		c.xp -= xp_need(c.lvl)
		c.lvl += 1
		var grow := 1.06 if c.lvl <= SKILL_LEVELS else 1.1
		c.hp_base *= grow
		c.max_hp = c.hp_base + istat(c, "hp") + attr_hp(c)
		c.hp = minf(c.max_hp, c.hp + c.max_hp * 0.25)
		if c.lvl <= SKILL_LEVELS:
			c.points += 1
		if mode == "survival" and c.pl == players[0]:
			recalc_items(c)
		add_text(ar, c.p + Vector2(0, -26), "LEVEL %d" % c.lvl, Color("#f0d48a"), 1.4, 13)
		ev("level", ar, c.p, {"pid": c.pl.id, "lvl": c.lvl, "human": c.pl.human})
		if not c.pl.human:
			ai_learn(c)


# ---------------------------------------------------------------- items
func near_shop(c) -> bool:
	return c.dead or c.p.distance_to(SHOP) <= SHOP_R


static func calc_ist(items: Array, scrolls: Dictionary, lv: Dictionary = {}) -> Dictionary:
	var st := {}
	for id in items:
		var it := GameData.item(id)
		var lk := item_level_k(int(lv.get(id, 1)))
		for k in GameData.ITEM_STATS:
			if it.has(k):
				st[k] = float(st.get(k, 0.0)) + float(it[k]) * lk
	for sid in scrolls:
		var sc := GameData.scroll(sid)
		st[sc["stat"]] = float(st.get(sc["stat"], 0.0)) + float(sc["per"]) * int(scrolls[sid])
	return st


# The inventory a hero would have after buying an item (components used up).
func items_after(c, id: String) -> Array:
	var inv: Array = c.items.duplicate()
	_price(id, inv)
	inv.append(id)
	return inv


# Survival: each duplicate card of an item you own raises its level; each level adds 30% of its stats.
const ITEM_MAX_LV := 5
const ITEM_LV_STEP := 0.3      # each level above the first adds this share of the item's stats
const SURV_XP := 1.4           # survival experience multiplier (one hero takes every kill)
const SURV_KILL_GOLD := 0.5    # survival items are free from the cards, so kills pay half the gold


static func item_level_k(lv: int) -> float:
	return 1.0 + ITEM_LV_STEP * float(maxi(1, lv) - 1)


func recalc_items(c) -> void:
	var st := calc_ist(c.items, c.scrolls, c.item_lv)
	for k in c.extra:
		st[k] = float(st.get(k, 0.0)) + float(c.extra[k])
	if mode == "survival" and not players.is_empty() and c.pl == players[0]:
		_apply_synergy(c, st)
	var uq := {}
	var tiers := {}
	for id in c.items:
		var it := GameData.item(id)
		if it.has("u"):
			var k: String = it["u"]["k"]
			if int(it["tier"]) > int(tiers.get(k, 0)):
				tiers[k] = int(it["tier"])
				uq[k] = it["u"]
	c.uniq = uq
	var old_max: float = c.max_hp
	c.ist = st
	c.max_hp = c.hp_base + istat(c, "hp") + attr_hp(c)
	if c.max_hp > old_max:
		c.hp += c.max_hp - old_max
	c.hp = minf(c.hp, c.max_hp)


# ---- survival synergies: tags on owned abilities, the passive and items (see SurvivalData.TAGS)
func card_tags(o: Dictionary) -> Array:
	match String(o.get("kind", "")):
		"ability":
			return SurvivalData.skill_tags(TalentData.champ(o["hero"])["skills"][int(o["slot"])]["name"])
		"passive":
			return SurvivalData.passive_tags(TalentData.champ(o["hero"])["passive"]["name"])
		"item":
			return SurvivalData.item_tags(o["id"])
		"rank":
			return []
	return []


func count_tags(c) -> Dictionary:
	var n := {}
	for i in 4:
		var sk: Dictionary = c.def["skills"][i]
		if sk.get("empty", false):
			continue
		for t in SurvivalData.skill_tags(sk["name"]):
			n[t] = int(n.get(t, 0)) + 1
	if c.def["passive"]["t"] != "none":
		for t in SurvivalData.passive_tags(c.def["passive"]["name"]):
			n[t] = int(n.get(t, 0)) + 1
	for id in c.items:
		for t in SurvivalData.item_tags(id):
			n[t] = int(n.get(t, 0)) + 1
	return n


func _apply_synergy(c, st: Dictionary) -> void:
	var counts := count_tags(c)
	var fx := {}
	for tag in counts:
		var tier := SurvivalData.syn_tier(int(counts[tag]))
		if tier == 0:
			continue
		var b: Dictionary = SurvivalData.SYN_BONUS[tag][tier - 1]
		for k in b:
			var v := float(b[k])
			match k:
				"skill", "summon_dmg", "summon_dur":
					fx[k] = float(fx.get(k, 1.0)) * v
				"slow", "burn", "chain4", "crit3":
					fx[k] = maxf(float(fx.get(k, 0.0)), v)
				"hp_pct":
					st["hp"] = float(st.get("hp", 0.0)) + c.hp_base * v
				_:
					st[k] = float(st.get(k, 0.0)) + v
	c.syn_fx = fx
	if true:
		var old := syn_counts
		syn_counts = counts
		for tag in counts:
			var t1 := SurvivalData.syn_tier(int(counts[tag]))
			if t1 > SurvivalData.syn_tier(int(old.get(tag, 0))) and c.ar != null:
				add_text(c.ar, c.p + Vector2(0, -74), "%s %d" % [String(SurvivalData.TAGS[tag]["name"]).to_upper(), SurvivalData.SYN_TIERS[t1 - 1]], Color(SurvivalData.TAGS[tag]["col"]), 1.8, 15)
				ev("synergy", c.ar, c.p, {"tag": tag, "tier": t1})


# Price of an item given what is in `inv` (owned components are used up from `inv`).
static func _price(id: String, inv: Array) -> int:
	var it := GameData.item(id)
	var c := int(it["cost"])
	for k in it["from"]:
		var at := inv.find(k)
		if at >= 0:
			inv.remove_at(at)
		else:
			c += _price(k, inv)
	return c


func item_price(c, id: String) -> int:
	return _price(id, c.items.duplicate())


# Returns "ok", "shop" (too far), "gold", "full" or "over".
func buy_item(pl, id: String, check_range := true) -> String:
	var c = pl.champ
	if over:
		return "over"
	if mode == "survival":
		return "survival"   # survival items come from the round's cards
	if check_range and not near_shop(c):
		return "shop"
	var inv: Array = c.items.duplicate()
	var cost := _price(id, inv)
	if pl.gold < cost:
		return "gold"
	if inv.size() >= GameData.INV_SLOTS:
		return "full"
	pl.gold -= cost
	inv.append(id)
	c.items = inv
	recalc_items(c)
	var it := GameData.item(id)
	if it.has("act") and it["act"]["k"] == "recall":
		c.act_cd[id] = f(it["act"], "buy_cd", 20.0)   # 0.26: no instant escape the moment it is bought
	if c.ar != null and pl.human:
		add_text(c.ar, c.p + Vector2(0, -40), it["name"], Color("#ffd24a"), 1.4, 13)
	return "ok"


func buy_potion(pl, check_range := true) -> String:
	var c = pl.champ
	if over:
		return "over"
	if check_range and not near_shop(c):
		return "shop"
	if c.potions >= POTION_MAX:
		return "full"
	if pl.gold < POTION_COST:
		return "gold"
	pl.gold -= POTION_COST
	c.potions += 1
	return "ok"


# Restores 150 + 35% of max health over 8 seconds.
func use_potion(c) -> bool:
	if c.dead or c.potions <= 0 or c.pot_t > 0 or c.hp >= c.max_hp:
		return false
	c.potions -= 1
	c.pot_t = POTION_DUR
	c.pot_rate = (150.0 + c.max_hp * 0.35) / POTION_DUR
	if c.ar != null:
		add_fx(c.ar, {"type": "ring", "p": c.p, "r": 30.0, "col": Color("#ff5a6a"), "t": 0.5, "dur": 0.5, "follow": c})
	return true


# Each rank read makes the next dearer, and the step itself grows, so the last ranks cost real money.
func scroll_cost(c, sid: String) -> int:
	var n := int(c.scrolls.get(sid, 0))
	if mode == "survival":
		return int(GameData.scroll(sid)["base"]) + GameData.SCROLL_STEP_SURV * n + GameData.SCROLL_STEP2_SURV * n * n
	return int(GameData.scroll(sid)["base"]) + GameData.SCROLL_STEP * n + GameData.SCROLL_STEP2 * n * n


# Scrolls are permanent and take no slot. Returns "ok", "shop", "gold", "max" or "over".
func buy_scroll(pl, sid: String, check_range := true) -> String:
	var c = pl.champ
	if over:
		return "over"
	if check_range and not near_shop(c):
		return "shop"
	if int(c.scrolls.get(sid, 0)) >= GameData.SCROLL_MAX:
		return "max"
	var cost := scroll_cost(c, sid)
	if pl.gold < cost:
		return "gold"
	pl.gold -= cost
	c.scrolls[sid] = int(c.scrolls.get(sid, 0)) + 1
	recalc_items(c)
	return "ok"


const AI_SCROLLS := {
	"Mage": ["s_ap", "s_hp", "s_armor"], "Support": ["s_ap", "s_hp", "s_armor"], "Engineer": ["s_ap", "s_dmg", "s_hp"],
	"Marksman": ["s_dmg", "s_as", "s_crit"], "Assassin": ["s_dmg", "s_crit", "s_as"],
	"Fighter": ["s_hp", "s_dmg", "s_armor"], "Tank": ["s_hp", "s_armor", "s_dmg"],
}


func sell_value(id: String) -> int:
	return GameData.item_total(id) / 2


func sell_item(pl, slot: int) -> String:
	var c = pl.champ
	if over:
		return "over"
	if slot < 0 or slot >= c.items.size():
		return "empty"
	if not near_shop(c):
		return "shop"
	var id: String = c.items[slot]
	pl.gold += sell_value(id)
	c.items.remove_at(slot)
	recalc_items(c)
	return "ok"


# The next purchase toward `target`: the first missing piece, working up from basic items.
static func _next_piece(id: String, inv: Array):
	var at := inv.find(id)
	if at >= 0:
		inv.remove_at(at)
		return null
	for k in GameData.item(id)["from"]:
		var r = _next_piece(k, inv)
		if r != null:
			return r
	return id


# Six legendaries per role, upgraded into their mythics along the way, so an AI hero ends with six items.
const _AI_LEG := {
	"Mage": ["starcaller", "crown", "storm", "phoenix", "trinity", "bastion"],
	"Support": ["starcaller", "trinity", "aegis", "phoenix", "storm", "bastion"],
	"Marksman": ["windrider", "scythe", "doom", "nightshade", "inferno", "phoenix"],
	"Engineer": ["trinity", "storm", "windrider", "crown", "scythe", "phoenix"],
	"Assassin": ["nightshade", "scythe", "inferno", "windrider", "doom", "phoenix"],
	"Fighter": ["warbringer", "warlord", "doom", "inferno", "aegis", "phoenix"],
	"Tank": ["warlord", "aegis", "bastion", "phoenix", "warbringer", "trinity"],
}
const _MYTHIC := {"starcaller": "cosmos", "crown": "archon", "storm": "tempest", "phoenix": "rebirth", "trinity": "ascendant",
	"bastion": "bulwark", "aegis": "eternal", "windrider": "galeforce", "scythe": "soulreaper", "doom": "worldender",
	"nightshade": "eclipse", "inferno": "sunforge", "warbringer": "apocalypse", "warlord": "conqueror"}


# Build order: three legendaries, then alternate a mythic upgrade with a new legendary, then the last upgrades.
static func ai_build_for(role: String) -> Array:
	var l: Array = _AI_LEG.get(role, ["doom", "aegis", "phoenix", "inferno", "trinity", "bastion"])
	var m: Array = l.map(func(x): return _MYTHIC.get(x, x))
	return [l[0], l[1], l[2], m[0], l[3], m[1], l[4], m[2], l[5], m[3], m[4], m[5]]




# 0.26 Waystone of the Ward: a "homeward" build that opens with Phoenix Mantle and upgrades it to the Waystone
# (Recall) at once, instead of later to Phoenix Reborn (bots seldom finish more than two big items in a match).
static func ai_build_waystone(build: Array) -> Array:
	var legs: Array = build.filter(func(x): return int(GameData.item(x)["tier"]) == 3)
	if not legs.has("phoenix"):
		return build
	legs.erase("phoenix")
	var m: Array = legs.map(func(x): return _MYTHIC.get(x, x))
	return ["phoenix", "waystone", legs[0], legs[1], m[0], legs[2], m[1], legs[3], m[2], legs[4], m[3], m[4]]


# True when `id` is `owned` or one of the items `owned` was built from (a mythic still "owns" its legendary).
static func _descends(owned: String, id: String) -> bool:
	if owned == id:
		return true
	for k in GameData.item(owned)["from"]:
		if _descends(k, id):
			return true
	return false


# A build target counts as owned when any item in the inventory is it or was made from it.
static func build_owned(items: Array, id: String) -> bool:
	for o in items:
		if _descends(o, id):
			return true
	return false


func ai_next_price(pl) -> int:
	var c = pl.champ
	for target in c.ai_build:
		if build_owned(c.items, target):
			continue
		var piece = _next_piece(target, c.items.duplicate())
		if piece != null:
			return item_price(c, target if c.items.size() >= GameData.INV_SLOTS - 1 else piece)
	return 0


# One AI shopping step: buys the next piece of its build if it can.
# Returns "bought", "short" (saving up for it) or "none" (build finished or inventory full).
func ai_shop(pl) -> String:
	var c = pl.champ
	if mode == "survival":
		return "none"
	for target in c.ai_build:
		if build_owned(c.items, target):
			continue
		var inv: Array = c.items.duplicate()
		var piece = _next_piece(target, inv)
		if piece == null:
			continue
		if c.items.size() >= GameData.INV_SLOTS - 1:
			piece = target        # no room for loose parts: buy the finished item in one go
		var price := item_price(c, piece)
		# the item purse, or (from round 4) plenty of free gold beyond the building and crystal savings
		var free: float = pl.gold - pl.res_tech - pl.res_core
		if price <= pl.gold and (price <= pl.res_items + 40.0 or (round_no >= 4 and free >= price * 1.5)):
			if not near_shop(c):
				return "walk"
			if buy_item(pl, piece) == "ok":
				pl.res_items = maxf(0.0, pl.res_items - price)
				return "bought"
			return "none"
		return "short"
	return "none"


# ---------------------------------------------------------------- the crystal
func core_cost(ar, k: int) -> int:
	var u: Dictionary = GameData.CORE_UPS[k]
	return int(u["base"]) + int(u["step"]) * int(ar.core_lv[k])


func core_dmg(ar) -> float:
	var small := 1.0 if team_size >= 4 or mode == "survival" else (1.5 if team_size == 1 else 1.25)
	return GameData.CORE_DMG * (1.0 + 0.3 * ar.core_lv[1]) * (1.0 + 0.02 * maxi(0, round_no - 1)) * small


func core_as(ar) -> float:
	return GameData.CORE_AS * (1.0 + 0.15 * ar.core_lv[2])


# Crystal health per second from Mend.
func core_regen(ar) -> float:
	return (GameData.CORE_REGEN * ar.core_lv[3] + ar.regen_bonus) * float(regen_k[ar.team])


# Income the buyer gains from a crystal upgrade that costs this much, at the upgrade's current level:
# the share shrinks with every level, so late upgrades pay back like sends do instead of out-earning them.
static func core_income(cost: int, lv: int = 0, surv := false, per_round := true) -> int:
	var cs := Tune.v("core_inc_share")   # GameData.CORE_INC_SHARE unless tuned
	var share: float = GameData.CORE_INC_SHARE_SURV if surv else (cs if per_round else cs / INC_UNIT)
	return maxi(2, roundi(cost * share / (1.0 + GameData.CORE_INC_DECAY * lv)))


# The income this match's crystal upgrade gives, in this mode's income unit (per round, or per 10 s).
func core_inc(cost: int, lv: int = 0) -> int:
	return core_income(cost, lv, mode == "survival", income_per_round)


# The income floor sends can't go below, in this mode's unit (GameData.MIN_INCOME is per round).
func min_income() -> int:
	var mi := roundi(tv("min_income"))   # GameData.MIN_INCOME unless tuned
	return mi if income_per_round else roundi(float(mi) / INC_UNIT)


# Any player on the team can pay for a crystal upgrade. Returns "ok", "max", "gold" or "over".
func buy_core(pl, k: int) -> String:
	var ar = arenas[pl.team]
	if over:
		return "over"
	if ar.core_lv[k] >= GameData.CORE_MAX_LV:
		return "max"
	var cost := core_cost(ar, k)
	if pl.gold < cost:
		return "gold"
	pl.gold -= cost
	var inc := core_inc(cost, ar.core_lv[k])
	ar.core_lv[k] += 1
	pl.core_buys += 1
	pl.income += inc
	add_text(ar, CORE + Vector2(0, -112), "+%d income for %s" % [inc, pl.name], Color("#9dff8a"), 1.4, 12)
	if k == 0:
		ar.core_max += 600.0
		ar.core_hp = minf(ar.core_max, ar.core_hp + 600.0)
	add_text(ar, CORE + Vector2(0, -90), "%s %d" % [GameData.CORE_UPS[k]["name"], ar.core_lv[k]], Color("#ffd24a"), 1.4, 13)
	feed.push_front({"t": t, "team": pl.team, "who": pl.name, "core": GameData.CORE_UPS[k]["name"], "lv": ar.core_lv[k]})
	if feed.size() > 12:
		feed.resize(12)
	return "ok"


func give_gold(pl, g: float) -> void:
	pl.gold += g
	pl.earned += g
	pl.gold_earned += g


const CORE_HIT_EVERY := 0.5     # seconds between "core_hit" cues while a crystal is battered


func core_hit(ar, d: float, m = null) -> void:
	if over:
		return
	if m != null and m.sender != null:
		m.sender.send_dmg[m.kind] = float(m.sender.send_dmg.get(m.kind, 0.0)) + d
		m.sender.send_core_dmg += d
	ar.core_hp -= d
	ar.core_dmg_taken += d
	ar.core_hit_acc += d
	if ar.core_hit_t < 0.0 or t - ar.core_hit_t >= CORE_HIT_EVERY:
		# one cue per half second of battering; `amount` is the damage since the last cue (siege damage
		# comes in per-step slivers, so a per-call cue would be noise)
		ar.core_hit_t = t
		var owner: int = m.sender.id if m != null and m.sender != null else -1
		ev("core_hit", ar, CORE, {"team": ar.team, "amount": ar.core_hit_acc, "by": "mon", "owner": owner,
			"frac": maxf(0.0, ar.core_hp) / maxf(1.0, ar.core_max)})
		ar.core_hit_acc = 0.0
	ar.leak_flash = 0.35
	if ar.core_floor > 0.0 and ar.core_hp < ar.core_max * ar.core_floor:
		ar.core_hp = ar.core_max * ar.core_floor
	if ar.core_hp <= 0:
		ar.core_hp = 0
		over = true
		winner = 1 - ar.team
		over_t = t


func upd_core(ar, dt: float) -> void:
	if (ar.core_lv[3] > 0 or ar.regen_bonus > 0.0) and ar.core_hp > 0:
		ar.core_hp = minf(ar.core_max, ar.core_hp + core_regen(ar) * dt)
	ar.core_cd -= dt
	if ar.core_cd > 0:
		return
	# sieging monsters first, then whatever is closest
	var best = null
	var bd := INF
	for m in ar.mons:
		if m.dead:
			continue
		var d: float = m.p.distance_to(CORE) - (400.0 if m.siege else 0.0)
		if d < bd and m.p.distance_to(CORE) <= GameData.CORE_RANGE + m.r:
			bd = d
			best = m
	if best == null:
		ar.core_cd = 0.15
		return
	ar.core_cd = 1.0 / core_as(ar)
	var pr := Proj.new()
	pr.homing = true
	pr.p = CORE + Vector2(0, -70)
	pr.tgt = best
	pr.spd = 700
	pr.dmg = core_dmg(ar)
	pr.col = Color("#7fe8d8") if ar.team == 0 else Color("#ff8a5a")
	pr.splash = GameData.CORE_SPLASH
	ar.projs.append(pr)
	ev("core_shot", ar, CORE)


func heal_champ(c, a: float) -> void:
	if not c.dead:
		c.hp = minf(c.max_hp, c.hp + a)


func hurt_champ(ar, c, d: float, src = null, crit := false) -> void:
	if c.inv_t > 0:
		return
	if c.dead or (duel_on and c.ar == duel_ar and ar != duel_ar) or (ar == duel_ar and not duel_on):
		return
	d *= 1.0 - c_armor(c)
	if ar == duel_ar:
		d *= duel_mult()
	if c.shield > 0:
		var s := minf(c.shield, d)
		c.shield -= s
		d -= s
	c.hp -= d
	if src is Champ:
		src.pl.hero_dmg += d
	emit_hit(ar, c, d, crit, src)
	if c.uniq.has("rebirth") and c.hp <= 0 and c.rebirth_cd <= 0:
		var rb: Dictionary = c.uniq["rebirth"]
		c.rebirth_cd = f(rb, "cd")
		c.hp = c.max_hp * f(rb, "pct")
		burst(ar, c.p, Color("#ffb040"), 30, 200)
		add_fx(ar, {"type": "ring", "p": c.p, "r": 90.0, "col": Color("#ffa030"), "t": 0.6, "dur": 0.6, "fill": true})
		add_text(ar, c.p + Vector2(0, -50), "REBIRTH", Color("#ffb040"), 1.4, 15)
		return
	if c.uniq.has("guardian") and c.hp > 0 and c.hp < c.max_hp * 0.35 and c.guard_cd <= 0:
		var gu: Dictionary = c.uniq["guardian"]
		c.guard_cd = f(gu, "cd")
		c.shield += c.max_hp * f(gu, "pct")
		c.shield_t = maxf(c.shield_t, 6.0)
		add_fx(ar, {"type": "ring", "p": c.p, "r": 40.0, "col": Color("#9fd8ff"), "t": 0.5, "dur": 0.5, "follow": c})
		add_text(ar, c.p + Vector2(0, -50), "GUARDIAN", Color("#9fd8ff"), 1.2, 13)
	if c.hp <= 0 and c.ar == duel_ar and duel_on:
		c.hp = 1
		end_duel(duel_pair[1] if duel_pair[0] == c else duel_pair[0])
		return
	if c.hp <= 0:
		c.hp = 0
		c.dead = true
		ev("hdie", ar, c.p, {"team": c.pl.team, "who": c.pl.name, "human": c.pl.id == local})
		c.respawn = 5.0 + c.lvl * 0.4
		c.pl.deaths += 1
		if src is Mon and src.sender != null:
			src.sender.send_kills += 1
		if mode == "survival" and c.pl.team == 0:
			c.respawn = 8.0 + c.lvl * 0.5
			surv_lives -= 1
			ev("life_lost", ar, c.p, {"left": surv_lives})
			if surv_lives <= 0 and not over:
				over = true
				winner = 1
				over_t = t
		c.buffs = []
		c.shield = 0
		c.dash = null
		c.moving = false
		burst(ar, c.p, c.col, 18, 140)
		add_text(ar, c.p + Vector2(0, -20), "SLAIN", Color("#ff8a7a"), 1.4, 13)


# ---------------------------------------------------------------- UI cues
const HIT_EV_MIN := 25.0        # "hit" events: damage below this is skipped unless it's a crit or an ability
const HIT_EV_CAP := 12          # ... and at most this many per arena per step
var _hit_ctx := ""              # "auto" inside auto_hit, "summon" for summon strikes, "dot" for per-tick damage


# A blow landed: presentation-only cue (damage numbers, hit-stop, shake). src is a Champ (hero or its
# summon), a Mon, or null for the crystal's own shots. Never read by the sim.
func emit_hit(ar, vic, d: float, crit: bool, src) -> void:
	if ar == null or ar.hit_n >= HIT_EV_CAP:
		return
	var abil := false
	var ss := "tower"
	var pid := -1
	var team: int = ar.team
	if src is Champ:
		ss = "summon" if _hit_ctx == "summon" else "hero"
		abil = _hit_ctx == ""
		pid = src.pl.id
		team = src.pl.team
	elif src is Mon:
		ss = "mon"
		if src.sender != null:
			pid = src.sender.id
			team = src.sender.team
		else:
			team = 1 - ar.team
	if not (d >= HIT_EV_MIN or crit or abil):
		return
	ar.hit_n += 1
	var vic_pid: int = vic.pl.id if vic is Champ else -1
	ev("hit", ar, vic.p, {"dmg": d, "crit": crit, "abil": abil, "src": ss, "to": "hero" if vic is Champ else "mon",
		"pid": pid, "team": team, "vic_pid": vic_pid})


func ev(k: String, ar, pos := Vector2.ZERO, extra := {}) -> void:
	if events.size() > 400:
		return
	var e := {"k": k, "a": ar.idx if ar != null else -1, "p": pos}
	e.merge(extra)
	events.append(e)


# A sound-only cue (an ability landing, a monster bolt striking): never needed by the game or the campaign
# scripts, so it gives way early when a frame is crowded and the cues those rely on keep their room.
func ev_view(k: String, ar, pos: Vector2, extra: Dictionary) -> void:
	if events.size() < 300:
		ev(k, ar, pos, extra)


# Damage multiplier in the duel ring: 0.28 at the start, about 1.9 after 40 seconds.
func duel_mult() -> float:
	return DUEL_DMG + DUEL_RAMP * (DUEL_TIME - duel_t)


func view_arena(i: int):
	return duel_ar if i == 2 else arenas[i]


# ---------------------------------------------------------------- fx helpers
func add_text(ar, pos: Vector2, s: String, col: Color, dur := 0.9, size := 11) -> void:
	if ar.texts.size() < 70:
		ar.texts.append({"p": pos, "s": s, "col": col, "t": dur, "dur": dur, "size": size})


# Damage numbers pop out and fall in a small arc; crits are bigger and gold.
func dmg_text(ar, pos: Vector2, d: float, crit: bool, col: Color) -> void:
	if ar.texts.size() >= 90:
		return
	var big := crit or d >= 150
	ar.texts.append({"p": pos, "s": str(roundi(d)) + ("!" if crit else ""), "col": Color("#ffd24a") if crit else col,
		"t": 0.95 if big else 0.75, "dur": 0.95 if big else 0.75, "size": 15 if crit else (12 if d >= 150 else 10),
		"v": Vector2(randf_range(-55, 55), randf_range(-150, -115) * (1.2 if big else 1.0)), "pop": true, "crit": crit})


# Sparks where a blow lands, and a camera-shake cue for heavy hits and crits.
func impact(ar, m, src, d: float, crit: bool, max_hp: float) -> void:
	if ar.parts.size() < 460:
		var from: Vector2 = m.p + Vector2(-1, 0)
		if src != null and src.get("p") != null:
			from = src.p
		var dir: Vector2 = (m.p - from).normalized()
		if dir == Vector2.ZERO:
			dir = Vector2.RIGHT
		var col := Color("#ffe08a") if crit else Color("#fff4dc")
		var n := 7 if crit else (4 if d >= 40 else 2)
		for i in n:
			var v: Vector2 = dir.rotated(randf_range(-0.9, 0.9)) * randf_range(140, 320) * (1.3 if crit else 1.0)
			ar.parts.append({"p": m.p + Vector2(0, -6), "v": v, "t": randf_range(0.14, 0.3), "col": col, "s": 1.6, "streak": true})
	var heavy := crit or d >= 160 or d >= max_hp * 0.3
	if heavy and src != null and src.get("pl") != null:
		ev("impact", ar, m.p, {"crit": crit, "d": d, "human": src.pl.id == local})


func add_fx(ar, o: Dictionary) -> void:
	if ar.fx.size() < 180:
		ar.fx.append(o)


func burst(ar, pos: Vector2, col: Color, n: int, sp: float) -> void:
	for i in n:
		if ar.parts.size() >= 500:
			return
		var v := Vector2.from_angle(randf() * TAU) * randf_range(0.3, 1.0) * sp
		ar.parts.append({"p": pos, "v": v, "t": randf_range(0.3, 0.7), "col": col, "s": randf_range(1.2, 2.6)})


# ---------------------------------------------------------------- monsters
static func mon_color(m) -> Color:
	if m.sender == null:
		return Color("#8d8aa0")
	return Color(GameData.MON[m.kind]["col"])


func spawn_mon(ar, kind: String, lane: int, sender, hpm: float) -> Mon:
	ensure_lanes()
	var d: Dictionary = GameData.MON[kind]
	var m := Mon.new()
	m.uid = next_uid
	next_uid += 1
	m.kind = kind
	m.d = d
	m.fly = bool(d.get("fly", false))
	var geo: Dictionary = _air[lane] if m.fly else _lanes[lane]
	m.path = geo["pts"]
	m.norms = geo["norms"]
	m.cum = geo["cum"]
	m.lane = lane
	m.lat = rng.randf_range(-LANE_SPREAD, LANE_SPREAD) * (0.75 if m.fly else 1.0)
	m.p = m.path[0] + m.norms[0] * m.lat + Vector2(-rng.randf_range(0, 30), 0)
	m.ang = (m.path[1] - m.path[0]).angle()
	if mode == "survival" and LATE_BOSSES.has(kind):
		# the campaign's bosses were tuned for scripted missions: in the rotation they take a classic boss's
		# share of health and crystal damage, so their tricks are the difference, not their size
		hpm *= minf(1.0, LATE_BOSS_HP / maxf(1.0, f(d, "hp")))
	m.hpm = hpm
	m.hp = f(d, "hp") * hpm
	m.max_hp = m.hp
	m.spd = f(d, "spd") * SPEED_K * rng.randf_range(0.94, 1.06)
	m.r = f(d, "r")
	m.dps = f(d, "dps") * (1.0 + tv("wave_dmg_round") * maxi(0, round_no - 1)) * mon_dmg
	m.lives = int(d["lives"])
	if mode == "survival" and LATE_BOSSES.has(kind):
		m.lives = mini(m.lives, 20)
	m.bounty = f(d, "bounty")
	m.xp = f(d, "xp")
	m.armor = f(d, "armor")
	m.cci = bool(d.get("cci", false))
	m.ten = f(d, "ten", 1.0)
	if d.has("heal"):
		m.heal_r = f(d["heal"], "r")
		m.heal_hps = f(d["heal"], "hps")
	m.evasion = f(d, "evasion")
	m.regen = f(d, "regen")
	m.frenzy = f(d, "frenzy")
	if d.has("spawner"):
		m.sp_t = f(d["spawner"], "every") * 0.5
	if d.has("blink"):
		m.bl_t = f(d["blink"], "every")
	if d.has("ranged"):
		m.atk_cd = rng.randf_range(0.2, 1.0)
	if mode == "survival" and sender == null and not d.get("camp", false):
		if omens.has("rush"):
			m.spd *= 1.12
		if omens.has("fangs"):
			m.dps *= 1.2
			m.dmg_k *= 1.2
		if omens.has("rot"):
			m.regen += 0.01
	m.sender = sender
	if sender != null:
		var tk := send_dmg_mult(kind)
		var pw := power_level(kind)
		if pw > 0:
			tk *= power_dmg_k(pw)
			# the plain send bonus is capped for power sends (a round-36 Devourer with the whole bonus had 8 M
			# health: nothing on the road could kill it, and three of them deleted a crystal in a round)
			var phk := power_hp_k(pw, round_no) * minf(1.0, SEND_HP_POWER_MAX / maxf(1.0, send_hp_k(round_no)))
			m.hp *= phk
			m.max_hp = m.hp
			m.hpm *= phk
			m.lives += power_lives(pw)
			m.r *= 1.1 + 0.08 * pw
			m.bounty *= POWER_BOUNTY_K[pw]
		m.xp *= tv("send_xp_k")
		m.dps *= tk
		m.dmg_k *= tk
	ar.mons.append(m)
	if d.get("boss", false):
		ar.boss = m
	return m


# Distance travelled along the lane; larger means closer to the crystal.
static func progress(m) -> float:
	if m is Champ:
		return 0.0
	var i := mini(m.wi, m.path.size() - 1)
	return m.cum[i] - m.path[i].distance_to(m.p)


# Boss rounds send a boss down each rift. The living boss furthest along its road (null if none).
func lead_boss(ar):
	var best = null
	for o in ar.mons:
		if not o.dead and o.d.get("boss", false) and (best == null or progress(o) > progress(best)):
			best = o
	return best


# The living boss nearest p (null if none): the one an order to "fight the boss" means.
func boss_near(ar, p: Vector2):
	var best = null
	for o in ar.mons:
		if not o.dead and o.d.get("boss", false) and (best == null or o.p.distance_to(p) < best.p.distance_to(p)):
			best = o
	return best


func apply_slow(m, amount: float, dur: float) -> void:
	if m.cci:
		return
	if amount >= m.slow or m.slow_t <= 0:
		m.slow = amount
	m.slow_t = maxf(m.slow_t, dur * m.ten)


# Where a monster walks at waypoint i: its own lane offset, kept on the deck over a bridge (flyers go over).
static func mon_spot(m, i: int) -> Vector2:
	var tp: Vector2 = m.path[i] + m.norms[i] * m.lat
	return tp if m.fly else bridge_push(tp, m.r)


# Throws a monster back along its road by `dist` (the blink loop run backwards), through as many
# waypoints as it takes. Stationary monsters (totems, obelisks, the camp) stand their ground.
func knock(m, dist: float) -> void:
	if m.cci or m is Champ or m.spd <= 0.0:
		return
	var left: float = dist * m.ten
	while left > 0.0 and m.wi >= 1:
		var tp: Vector2 = mon_spot(m, m.wi - 1)
		var dd: float = m.p.distance_to(tp)
		if dd <= left:
			m.p = tp
			left -= dd
			if m.wi <= 1:
				break
			m.wi -= 1
		else:
			m.p = m.p.move_toward(tp, left)
			left = 0.0
	unsiege(m)


# A monster at the crystal that was thrown or dragged away from it has to walk back before it can
# batter it again.
const SIEGE_R := 150.0


func unsiege(m) -> void:
	if m.siege and (m.wi < m.path.size() - 1 or m.p.distance_to(CORE) > SIEGE_R):
		m.siege = false
		m.wi = mini(m.wi, m.path.size() - 1)


func apply_fx(m, fx, c) -> void:
	if fx == null or fx.is_empty() or m.dead:
		return
	if fx.has("slow"):
		apply_slow(m, float(fx["slow"][0]), float(fx["slow"][1]))
	if fx.has("stun") and not m.cci:
		m.stun = maxf(m.stun, float(fx["stun"]) * m.ten)
	if fx.has("burn"):
		m.burn_dps = float(fx["burn"][0]) * lvl_mult(c)
		m.burn_t = float(fx["burn"][1])
		m.burn_src = c
	if fx.has("knock"):
		knock(m, float(fx["knock"]))
	if fx.has("hex"):
		m.hex = maxf(m.hex, float(fx["hex"]))


# Damage to a monster (or, in duels, a hero). `pure` damage ignores totem shields, armor and wards.
func hurt(ar, m, d: float, src, crit := false, quiet := false, pure := false) -> void:
	if m.dead or d <= 0:
		return
	if m is Champ:
		if m.hex > 0:
			d *= 1.0 + HEX_AMP
		if src != null:
			src.dmg_done += d
		if d >= 30 or crit:
			dmg_text(ar, m.p + Vector2(randf_range(-6, 6), -30), d, crit, Color("#ffb0a0"))
		impact(ar, m, src, d, crit, m.max_hp)
		hurt_champ(ar, m, d, src, crit)
		return
	if m.hex > 0:
		d *= 1.0 + HEX_AMP
	if not pure:
		if m.shielded:
			d *= 0.5
		var arm: float = minf(0.8, m.armor + m.ward)
		if arm > 0:
			d *= 1.0 - arm
	m.hp -= d
	m.flash = 0.08
	if src is Champ:
		src.pl.hero_dmg += d
		if m.d.get("boss", false):
			src.pl.boss_dmg += d
	emit_hit(ar, m, d, crit, src)
	if src is Champ and m.d.get("camp", false):
		# a camp fights back, all of it, when any of it is struck
		for o in ar.mons:
			if o.d.get("camp", false) and o.camp_i == m.camp_i:
				o.provoked = 6.0
				if o.last == null or o.last.dead:
					o.last = src   # the pack charges whoever struck first (camp_act)
	if src != null:
		m.last = src
		src.dmg_done += d
	var mine: bool = src != null and src.get("pl") != null and src.pl.human
	if not quiet and (d >= 45 or crit or (mine and d >= 8)):
		dmg_text(ar, m.p + Vector2(randf_range(-6, 6), -m.r - 6), d, crit, Color("#f3ece0"))
	if not quiet:
		impact(ar, m, src, d, crit, m.max_hp)
	if m.hp <= 0:
		kill_mon(ar, m)


const BOSS_REWARD := 80   # classic: gold to every player on the team per boss killed


# The base bounty a kill pays: a wave monster's grows 2 % a round; a sent monster pays a flat share of
# its base bounty, so sending is never the enemy's second income.
func send_bounty(m) -> float:
	if m.sender != null:
		return m.bounty * send_gift_k(m.kind)
	return m.bounty * (1.0 + 0.02 * maxi(0, round_no - 1)) * tv("wave_gold_k")   # 0.24: F8 "Wave monster gold Ã—"


func kill_mon(ar, m) -> void:
	if m.dead:
		return
	m.dead = true
	burst(ar, m.p, mon_color(m), 8 + int(m.r), 90)
	if m is Mon and m.mark_t > t and m.mark_c != null and m.mark_c.ar == ar and not m.d.get("boss", false) \
			and not m.d.get("camp", false) and m.spd > 0.0 and String(m.mark_c.def["passive"].get("t", "")) == "grave":
		grave_rise(ar, m.mark_c, m)
	var by_pid: int = m.last.pl.id if m.last != null and m.last.get("pl") != null else -1
	ev("mdie", ar, m.p, {"big": m.r >= 14, "kind": m.kind, "team": ar.team, "by_pid": by_pid,
		"owner": m.sender.id if m.sender != null else -1, "sent": m.sender != null, "bounty": roundi(send_bounty(m))})
	if m.d.get("camp", false):
		var left: Array = ar.mons.filter(func(o): return not o.dead and o.d.get("camp", false) and o.camp_i == m.camp_i)
		if left.is_empty() and m.camp_i >= 0:
			camp_cleared(ar, m.camp_i)
	if m.d.has("totems"):
		for tk in m.kids:
			if not tk.dead:
				tk.dead = true
				burst(ar, tk.p, Color("#7dff7a"), 10, 90)
	if m.d.get("boss", false):
		if ar.boss == m:
			# a boss may still march down the other rift: the HUD bar and "fight the boss" follow it
			ar.boss = lead_boss(ar)
		# a flat purse per boss in classic matches (0.15: was 150 + 8 x round, which in the endgame's boss-a-round
		# showered every player with a third of their income on top); survival keeps its growing reward
		var reward := (150 + 8 * round_no) if mode == "survival" else roundi(tv("boss_reward"))
		for pl in players:
			if pl.team == ar.team:
				give_gold(pl, reward)
				if not pl.champ.dead:
					gain_xp(ar, pl.champ, float(m.xp) * 0.5)
		ev("boss_down", ar, m.p, {"name": m.d["name"], "gold": reward, "kind": m.kind})
		if mode == "survival" and lead_boss(ar) == null:
			queue_boons(true)   # one boss draft per boss round, once the last of its bosses falls
		feed.push_front({"t": t, "team": ar.team, "who": TEAM_NAMES[ar.team], "boss": m.d["name"]})
	if m.d.has("split"):
		for i in int(m.d["split"]["n"]):
			ar.spawn_now.append([m.d["split"]["kind"], m.lane, m.sender, m.hpm, m.p + Vector2.from_angle(rng.randf() * TAU) * rng.randf_range(4, 16), m.wi, null])
	if m.elite == "volatile":
		ev("explode", ar, m.p)
		add_fx(ar, {"type": "ring", "p": m.p, "r": 115.0, "col": Color("#ff8a3a"), "t": 0.45, "dur": 0.45, "fill": true})
		for c in ar.champs:
			if not c.dead and c.p.distance_to(m.p) < 115.0 + c.r:
				hurt_champ(ar, c, 90.0 * mon_scale() * m.dmg_k, m)
	if m.elite != "" and m.last != null and m.last.get("pl") != null and m.last.pl.human:
		ev("elite_down", ar, m.p, {"affix": m.elite})
	if m.d.has("explode"):
		var ex: Dictionary = m.d["explode"]
		var rr := f(ex, "r")
		ev("explode", ar, m.p)
		add_fx(ar, {"type": "ring", "p": m.p, "r": rr, "col": Color("#ff7a2a"), "t": 0.45, "dur": 0.45, "fill": true})
		burst(ar, m.p, Color("#ffb040"), 18, 160)
		for c in ar.champs:
			if not c.dead and c.p.distance_to(m.p) < rr + c.r:
				hurt_champ(ar, c, f(ex, "dmg") * mon_scale(), m)
	var k = m.last
	if k == null:
		return
	var pl = k.pl
	var p: Dictionary = k.def["passive"]
	var pt: String = p["t"]
	var g: float = send_bounty(m)
	if m.gold_t > t:
		g *= 2
	if pt == "bounty" or pt == "predator":
		g += f(p, "gold")
	g += istat(k, "gpk")
	if not pl.human and m.sender == null:
		g *= DIFF_INCOME[pl.diff]
	if k.golden_t > 0:
		g *= 2.0
	if mode == "survival" and pl.team == 0:
		g *= surv_gold * SURV_KILL_GOLD
	if k.uniq.has("midas") and rng.randf() < f(k.uniq["midas"], "ch"):
		g += f(k.uniq["midas"], "gold")
		add_text(ar, m.p + Vector2(0, -m.r - 30), "MIDAS", Color("#ffe066"), 0.9, 12)
	give_gold(pl, g)
	if not pl.human and ai_econ_v2:
		ai_reserve(pl, g)
	if pl.human:
		add_text(ar, m.p + Vector2(0, -m.r - 14), "+%d" % roundi(g), Color("#ffd24a"), 1.0, 12)
		ev("coin", ar, m.p)
	pl.kills += 1
	k.kills += 1
	gain_xp(ar, k, m.xp)
	for o in ar.champs:
		if o != k and not o.dead:
			gain_xp(ar, o, m.xp * 0.35)
	if pt == "cdrKill":
		for i in 4:
			k.cds[i] = maxf(0.0, k.cds[i] - f(p, "s"))
	if pt == "predator" and k.kills % int(p["every"]) == 0:
		var pinc := roundi(float(p["inc"]) * INC_UNIT) if income_per_round else int(p["inc"])
		pl.income += pinc
		add_text(ar, k.p + Vector2(0, -30), "+%d income" % pinc, Color("#f0d48a"), 1.4, 12)
	if pt == "volatile":
		var rr := f(p, "r")
		add_fx(ar, {"type": "ring", "p": m.p, "r": rr, "col": Color("#ff9f1c"), "t": 0.35, "dur": 0.35})
		var dmg := f(p, "dmg") * lvl_mult(k)
		for o in mons_in(ar, m.p, rr):
			hurt(ar, o, dmg, k)


func nearest_mon(ar, pos: Vector2, reach: float, exclude = null, melee := false):
	var best = null
	var bd := INF
	for m in ar.mons:
		if m.dead:
			continue
		if melee and not m.fly and m.p.distance_to(pos) - m.r <= reach and wall_between(pos, m.p):
			continue   # 0.26: across a bridge wall, out of a sword's reach
		if exclude != null:
			if exclude is Dictionary:
				if exclude.has(m):
					continue
			elif exclude == m:
				continue
		var d: float = m.p.distance_to(pos) - m.r
		if d <= reach and d < bd:
			bd = d
			best = m
	return best


# Melee monsters turn to fight heroes that come near: they walk at the hero, hit it once a second
# for their damage rating, and go back to the road when the hero leaves or they stray too far.
# Returns true while the monster is busy with a hero (so it does not walk along its lane).
const MON_AGGRO_R := 95.0
const CHASE_STALL_T := 1.5    # 0.26: a chase without headway (a wall between) is given up after this long
const MON_LEASH := 190.0
const MON_HIT_EVERY := 1.0
const MON_HIT_K := 0.75



func mon_engage(ar, m, dt: float, rooted: bool) -> bool:
	if m.dps <= 0 or m.d.has("ranged"):
		return false
	var c = m.aggro
	if c != null and (c.dead or (c is Champ and c.ar != ar) or m.p.distance_to(m.aggro_from) > MON_LEASH or c.p.distance_to(m.p) > MON_AGGRO_R * 1.8 + m.r):
		m.aggro = null
		c = null
	if c == null:
		m.scan_t -= dt
		if m.aggro_cool > 0.0:
			m.aggro_cool -= dt
			return false
		if m.scan_t > 0:
			return false
		m.scan_t = 0.25
		var bd: float = MON_AGGRO_R + m.r
		for o in ar.champs:
			if o.dead:
				continue
			var od: float = o.p.distance_to(m.p)
			if od < bd:
				bd = od
				c = o
		# 0.24: Corvina's risen skeletons and bound monsters draw monsters the same way a hero does
		for o in ar.sums:
			if o.tag == "" or o.dead or m.d.get("camp", false):
				continue
			var od: float = o.p.distance_to(m.p)
			if od < bd:
				bd = od
				c = o
		if c == null:
			return false
		m.aggro = c
		m.aggro_from = m.p
		if c is Champ:
			c.attackers += 1
	var reach: float = m.r + c.r + 8.0
	var dv: Vector2 = c.p - m.p
	var d := dv.length()
	m.ang = lerp_angle(m.ang, dv.angle(), minf(1.0, dt * 10.0))
	if d > reach:
		if rooted:
			m.aggro = null
			return false
		var sp: float = m.spd * m.haste * ((1.0 - m.slow) if m.slow_t > 0 else 1.0)
		var mp0: Vector2 = m.p
		var want := minf(d - reach + 1.0, sp * dt)
		m.p += dv / maxf(d, 0.001) * want
		if not m.fly:
			m.p = bridge_push(m.p, m.r)
			# 0.26: a hero on the other side of a bridge wall: the chase gets nowhere, so after CHASE_STALL_T s
			# the monster lets it go and walks on (and does not turn on a hero again for a few seconds)
			if want > 0.01 and m.p.distance_to(mp0) < want * 0.3:
				m.chase_stall += dt
				if m.chase_stall >= CHASE_STALL_T:
					m.chase_stall = 0.0
					m.aggro = null
					m.aggro_cool = 4.0
					return false
			else:
				m.chase_stall = 0.0
		return true
	if m.hit_cd <= 0:
		m.hit_cd = MON_HIT_EVERY
		m.anim_t = 0.4
		var hd: float = m.dps * MON_HIT_EVERY * MON_HIT_K
		if c is Summon:
			sum_hurt(ar, c, hd)
		else:
			hurt_champ(ar, c, hd, m)
		if m.elite == "vampiric":
			m.hp = minf(m.max_hp, m.hp + hd * 2.0)
		if c is Champ and c.uniq.has("thorns") and not m.dead:
			hurt(ar, m, (hd * f(c.uniq["thorns"], "pct") + f(c.uniq["thorns"], "flat")) * lvl_mult(c), c, false, true)
		ev("mhit", ar, m.p, {"big": m.r >= 14})
		add_fx(ar, {"type": "slash", "p": m.p, "a": dv.angle(), "col": Color("#ff8a6a"), "t": 0.14, "dur": 0.14, "small": m.r < 11})
	return true


# Ranged monsters, flyers included, stop to trade shots with a hero in range instead of walking past:
# they hold for a few seconds, then press on toward the crystal for a moment before holding again.
const RANGED_HOLD := 5.0
const RANGED_PUSH := 2.5


func ranged_hold(ar, m, dt: float) -> bool:
	if m.d.get("camp", false) or m.d.get("boss", false) or m.spd <= 0.0:
		return false
	m.hold_t += dt
	if m.hold_t > RANGED_HOLD + RANGED_PUSH:
		m.hold_t = 0.0
	if m.hold_t > RANGED_HOLD:
		return false
	var reach: float = f(m.d["ranged"], "range") * 0.9
	for c in ar.champs:
		if not c.dead and c.p.distance_to(m.p) < reach:
			m.ang = lerp_angle(m.ang, (c.p - m.p).angle(), minf(1.0, dt * 8.0))
			return true
	for su in ar.sums:
		if su.tag != "" and not su.dead and su.p.distance_to(m.p) < reach:
			m.ang = lerp_angle(m.ang, (su.p - m.p).angle(), minf(1.0, dt * 8.0))
			return true
	m.hold_t = 0.0
	return false


func mons_in(ar, pos: Vector2, r: float) -> Array:
	var out: Array = []
	for m in ar.mons:
		if not m.dead and m.p.distance_squared_to(pos) < (r + m.r) * (r + m.r):
			out.append(m)
	return out


# Crystal damage per second from a monster at the crystal: grows with the round, so early leaks sting
# and late leaks are deadly.
func siege_dps(m) -> float:
	var k := 1.0
	if team_size < 4 and mode != "survival" and m.d.get("boss", false):
		k = 0.4 if team_size == 1 else 0.7   # a lone defender can't hold a boss off the crystal for long
	# past the endgame's first round the per-monster battering stops growing: the last waves are won
	# or lost on how many get through, and the crystal must last long enough for the final timer to count
	return siege_rate(m.lives, round_no) * k * siege_k


func mon_scale() -> float:
	return 1.0 + 0.05 * maxi(0, round_no - 1)


# 0.19: the pace factor for the leg to waypoint m.wi: the old walk took T steps of s px to cover a leg of L
# px (it hopped the last 4 px), so walking L / T px a step keeps the leg's time and makes every step equal.
func _mon_leg(m, s: float) -> void:
	m.seg_wi = m.wi
	m.seg_k = 1.0
	var l: float = mon_spot(m, m.wi).distance_to(m.p)
	if l < 0.01 or s <= 0.0:
		return
	var steps := 1.0 if l <= s + 4.0 else ceilf((l - s - 4.0) / s) + 1.0
	m.seg_k = maxf(0.05, l / (steps * s))


func upd_mon(ar, m, dt: float) -> void:
	m.hit_cd -= dt
	if m.silence > 0:
		m.silence -= dt
	if m.provoked > 0:
		m.provoked -= dt
	if m.anim_t > 0:
		m.anim_t -= dt
	if m.siege:
		# at the crystal: batter it until killed, but swing at any hero standing next to it
		if m.stun > 0:
			m.stun -= dt
		elif not mon_engage(ar, m, dt, true):
			core_hit(ar, siege_dps(m) * dt * float(core_siege[ar.team]), m)
			m.ang = lerp_angle(m.ang, (CORE - m.p).angle(), minf(1.0, dt * 6.0))
	elif m.stun > 0:
		m.stun -= dt
	elif m.d.get("camp", false):
		camp_act(ar, m, dt)
	elif mon_engage(ar, m, dt, false):
		pass
	elif m.d.has("ranged") and m.silence <= 0 and ranged_hold(ar, m, dt):
		pass
	else:
		var sp: float = m.spd * m.haste * ((1.0 - m.slow) if m.slow_t > 0 else 1.0)
		if m.frenzy > 0:
			sp *= 1.0 + m.frenzy * (1.0 - m.hp / m.max_hp)
		var stepd := sp * dt
		# 0.19: an even pace. Waypoints used to be "reached" 4 px early with a hop onto them (a 2-3x step every
		# 36 px: the walking stutter); now the step's leftover carries on to the next one. seg_k keeps each
		# leg's walking time what it was, so a wave still reaches the crystal when it used to.
		if m.seg_wi != m.wi and stepd > 0.0:
			_mon_leg(m, stepd)
		while stepd > 0.0:
			var tp: Vector2 = mon_spot(m, m.wi)
			var dv: Vector2 = tp - m.p
			var d := dv.length()
			var go: float = stepd * m.seg_k
			if d <= go + 0.001:
				m.wi += 1
				if m.wi >= m.path.size():
					m.wi = m.path.size() - 1
					m.siege = true
					ar.leaks += 1
					if m.sender != null:
						ev("send_reach", ar, m.p, {"owner": m.sender.id, "name": String(m.d.get("name", m.kind)), "kind": m.kind,
							"lives": m.lives, "team": ar.team})
					stepd = 0.0
					break
				stepd -= d / m.seg_k
				m.p = tp
				_mon_leg(m, sp * dt)
			else:
				m.p += dv / d * go
				m.ang = lerp_angle(m.ang, dv.angle(), minf(1.0, dt * 8.0))
				stepd = 0.0
		if not m.fly:
			m.p = bridge_push(m.p, m.r)   # slide along a bridge's parapets
	if m.slow_t > 0:
		m.slow_t -= dt
		if m.slow_t <= 0:
			m.slow = 0
	if m.hex > 0:
		m.hex -= dt
	if m.flash > 0:
		m.flash -= dt
	if m.burn_t > 0:
		m.burn_t -= dt
		_hit_ctx = "dot"
		hurt(ar, m, m.burn_dps * dt, m.burn_src)
		_hit_ctx = ""
		if m.dead:
			return
	if m.regen > 0 and m.hp < m.max_hp:
		m.hp = minf(m.max_hp, m.hp + m.max_hp * m.regen * dt)
	if m.heal_r > 0 and m.silence <= 0:
		m.heal_t -= dt
		if m.heal_t <= 0:
			m.heal_t = 0.5
			for o in mons_in(ar, m.p, m.heal_r):
				if o != m and not o.d.get("camp", false) and not o.d.get("boss", false):
					o.hp = minf(o.max_hp, o.hp + m.heal_hps * 0.5 * sqrt(o.max_hp / 300.0))
	if m.d.has("totems") and m.silence <= 0:
		var td: Dictionary = m.d["totems"]
		m.kids = m.kids.filter(func(k): return not k.dead)
		m.shielded = not m.kids.is_empty()
		# the totems circle the Warden as it walks, so heroes have to fight through to them
		m.tot_ang += dt * 0.5
		for ti in m.kids.size():
			var tk = m.kids[ti]
			tk.p = m.p + Vector2.from_angle(m.tot_ang + TAU * ti / maxf(1.0, m.kids.size())) * Vector2(f(td, "r"), f(td, "r") * 0.7)
		m.tot_t -= dt
		if m.tot_t <= 0 and m.kids.is_empty():
			m.tot_t = f(td, "every")
			var n := int(td["n"])
			for k in n:
				var tp: Vector2 = walk_clamp(m.p + Vector2.from_angle(TAU * k / n + rng.randf() * 0.5) * f(td, "r"))
				ar.spawn_now.append([td["kind"], m.lane, m.sender, m.hpm * 0.35, tp, m.wi, m])
			add_text(ar, m.p + Vector2(0, -m.r - 40), "WARDING TOTEMS", Color("#9dff8a"), 1.6, 14)
			ev("totems", ar, m.p)
	if m.d.has("dive") and m.silence <= 0:
		m.dv_t -= dt
		if m.dv_t <= 0:
			var dvd: Dictionary = m.d["dive"]
			var cands: Array = ar.champs.filter(func(c): return not c.dead and c.p.distance_to(m.p) < 650.0)
			if cands.is_empty():
				m.dv_t = 1.0
			else:
				m.dv_t = f(dvd, "every")
				var tgt = cands[rng.randi() % cands.size()]
				ar.mpend.append({"p": tgt.p, "r": f(dvd, "r"), "t": f(dvd, "delay"), "dur": f(dvd, "delay"), "dmg": f(dvd, "dmg") * mon_scale(), "stun": f(dvd, "stun"), "src": m})
				m.anim_t = 0.4
				ev("dive", ar, tgt.p)
	if m.d.has("spawner") and m.silence <= 0:
		m.sp_t -= dt
		if m.sp_t <= 0:
			var spd: Dictionary = m.d["spawner"]
			m.sp_t = f(spd, "every")
			m.kids = m.kids.filter(func(k): return not k.dead)
			if m.kids.size() < int(spd["max"]):
				ar.spawn_now.append([spd["kind"], m.lane, m.sender, m.hpm, m.p + Vector2.from_angle(rng.randf() * TAU) * 18.0, m.wi, m])
				add_fx(ar, {"type": "ring", "p": m.p, "r": 26.0, "col": Color("#8cff7a"), "t": 0.4, "dur": 0.4, "mk": spd["kind"], "mfx": "summon"})
	if m.d.has("blink") and m.stun <= 0 and m.silence <= 0:
		m.bl_t -= dt
		if m.bl_t <= 0:
			m.bl_t = f(m.d["blink"], "every")
			var from: Vector2 = m.p
			var left := f(m.d["blink"], "dist")
			while left > 0 and m.wi < m.path.size() - 1:
				var tp: Vector2 = mon_spot(m, m.wi)
				var dd: float = m.p.distance_to(tp)
				if dd <= left:
					m.p = tp
					left -= dd
					m.wi += 1
				else:
					m.p = m.p.move_toward(tp, left)
					left = 0
			add_fx(ar, {"type": "ring", "p": from, "r": 30.0, "col": Color("#9c7048"), "t": 0.5, "dur": 0.5, "fill": true, "mk": m.kind, "mfx": "blink"})
			add_fx(ar, {"type": "ring", "p": m.p, "r": 34.0, "col": Color("#9c7048"), "t": 0.5, "dur": 0.5, "fill": true, "mk": m.kind, "mfx": "blink"})
			burst(ar, m.p, Color("#7a5a3a"), 14, 110)
	if m.d.has("ranged"):
		m.atk_cd -= dt
		if m.atk_cd <= 0 and m.stun <= 0 and m.silence <= 0 and (m.provoked > 0 or not m.d.get("camp", false)):
			var rg: Dictionary = m.d["ranged"]
			var best = null
			var bd := f(rg, "range") + 14.0
			for c in ar.champs:
				if c.dead:
					continue
				var dd: float = c.p.distance_to(m.p)
				if dd < bd:
					bd = dd
					best = c
			for su in ar.sums:
				if su.tag == "" or su.dead or m.d.get("camp", false):
					continue
				var dd: float = su.p.distance_to(m.p)
				if dd < bd:
					bd = dd
					best = su
			if best != null:
				m.atk_cd = f(rg, "cd")
				m.anim_t = 0.4
				ev("mshoot", ar, m.p, {"kind": m.kind})
				var pr := MProj.new()
				pr.p = m.p + Vector2(0, -2)
				pr.tgt = best
				pr.dmg = f(rg, "dmg") * mon_scale() * m.dmg_k
				pr.col = Color(rg.get("col", "#ffffff"))
				pr.slow = f(rg, "slow")
				pr.splash = f(rg, "splash")
				pr.drain = f(rg, "drain")
				pr.spd = 380.0 if pr.splash > 0 else 460.0
				pr.kind = m.kind
				pr.src = m
				ar.mprojs.append(pr)
				m.ang = (best.p - m.p).angle()


# ---------------------------------------------------------------- attacks
func auto_hit(ar, c, m, mult := 1.0, second := false) -> void:
	if m.dead:
		return
	if m.evasion > 0 and rng.randf() < m.evasion:
		add_text(ar, m.p + Vector2(0, -m.r - 6), "miss", Color("#d8d8e0"), 0.7, 10)
		return
	var p: Dictionary = c.def["passive"]
	var pt: String = p["t"]
	var uq0: Dictionary = c.uniq
	var d := c_dmg(c) * mult * attuned_mult(c)
	var crit := false
	if not second:
		_hit_ctx = "auto"
		c.hits += 1
		if uq0.has("fervor"):
			fervor_stack(c, uq0["fervor"])
		if pt == "nth" and c.hits % int(p["n"]) == 0:
			d *= f(p, "mult")
			crit = f(p, "mult") > 1
			if p.has("chain"):
				chain_hit(ar, c, m, f(p["chain"], "dmg") * sm(c), int(p["chain"]["n"]), 140, {}, {m: true})
		if pt == "crit" and rng.randf() < f(p, "ch"):
			d *= f(p, "mult")
			crit = true
	d += istat(c, "onhit") * c.pow
	if not crit and istat(c, "crit") > 0 and rng.randf() < minf(0.75, istat(c, "crit")):
		d *= 3.0 if c.syn_fx.has("crit3") else 2.0
		crit = true
	if pt == "cull" and m.hp < m.max_hp * f(p, "th"):
		d *= 1.0 + f(p, "bonus")
	if pt == "grave":
		# 0.19 Corvina: bonus damage and the grave-mark (a slow); a marked lane monster that dies rises for her
		d += f(p, "dmg") * lvl_mult(c) * c.pow
		m.mark_t = t + f(p, "dur")
		m.mark_c = c
		apply_slow(m, f(p, "slow"), f(p, "dur"))
	if pt == "lowhp":
		d *= 1.0 + f(p, "max") * (1.0 - c.hp / c.max_hp)
		heal_champ(c, f(p, "heal"))
	if pt == "siphon":
		# the % of max health is capped per hit (and halved on bosses) so it doesn't melt endgame giants
		var sip := minf(m.max_hp * f(p, "pct"), SIPHON_CAP * lvl_mult(c))
		if m is Mon and m.d.get("boss", false):
			sip *= 0.5
		d += sip
		heal_champ(c, f(p, "heal"))
	if m is Mon and uq0.has("ambush") and m.hp >= m.max_hp * 0.999:
		d *= 1.0 + f(uq0["ambush"], "pct")
		if not second:
			add_text(ar, m.p + Vector2(0, -m.r - 20), "AMBUSH", Color("#c090ff"), 0.7, 11)
	var ls := bsum(c, "ls")
	if ls > 0:
		heal_champ(c, ls)
	var lsp: float = istat(c, "ls") + bsum(c, "lsp")
	if lsp > 0:
		heal_champ(c, d * lsp)
	if pt == "burn":
		m.burn_dps = f(p, "dps") * lvl_mult(c)
		m.burn_t = f(p, "dur")
		m.burn_src = c
	if pt == "chill":
		apply_slow(m, f(p, "slow"), f(p, "dur"))
	if pt == "hex":
		m.hex = maxf(m.hex, f(p, "dur"))
	if not c.syn_fx.is_empty():
		var sf: Dictionary = c.syn_fx
		if sf.has("slow"):
			apply_slow(m, float(sf["slow"]), 1.5)
		if sf.has("burn") and pt != "burn":
			m.burn_dps = maxf(m.burn_dps, 18.0 * lvl_mult(c) * c.pow)
			m.burn_t = maxf(m.burn_t, 2.5)
			m.burn_src = c
		if sf.has("chain4") and not second and c.hits % 4 == 0:
			chain_hit(ar, c, m, (40.0 * lvl_mult(c) + istat(c, "onhit") * 0.5) * c.pow, 3, 160, {}, {m: true})
	if pt == "knock":
		knock(m, f(p, "dist"))
	var mp: Vector2 = m.p
	var uq: Dictionary = c.uniq
	if uq.has("execute") and m is Mon and not m.d.get("boss", false) and m.hp - d < m.max_hp * f(uq["execute"], "th") and m.hp > 0:
		# a true kill: nothing the monster has (armor, wards, totem shields) softens it
		add_text(ar, mp + Vector2(0, -m.r - 20), "EXECUTE", Color("#ff6a5a"), 0.8, 12)
		hurt(ar, m, m.hp + 1.0, c, crit, false, true)
	else:
		hurt(ar, m, d, c, crit)
	if not second and uq.has("cleave"):
		var cr := f(uq["cleave"], "r")
		var hit_any := false
		for o in mons_in(ar, mp, cr):
			if o != m and not o.dead:
				hurt(ar, o, d * f(uq["cleave"], "pct"), c, false, true)
				hit_any = true
		if hit_any:
			add_fx(ar, {"type": "ring", "p": mp, "r": cr, "col": Color("#ffb070"), "t": 0.22, "dur": 0.22})
	if not second and uq.has("chain"):
		chain_hit(ar, c, m, (f(uq["chain"], "dmg") * lvl_mult(c) + istat(c, "onhit")) * c.pow, int(uq["chain"]["n"]), 170, {}, {m: true})
	if pt == "bounce" and not second:
		var o = nearest_mon(ar, mp, f(p, "range"), m)
		if o != null:
			add_fx(ar, {"type": "bolt", "p": mp, "p2": o.p, "col": c.col, "t": 0.18, "dur": 0.18, "w": 1.5})
			auto_hit(ar, c, o, f(p, "pct"), true)
	if uq.has("ricochet") and not second:
		# Windrider: the shot glances on to the next monster (Galeforce: and the one after)
		var rc: Dictionary = uq["ricochet"]
		var hit := {m: true}
		var from: Vector2 = mp
		for k in int(rc.get("n", 1)):
			var o = nearest_mon(ar, from, f(rc, "range"), hit)
			if o == null:
				break
			hit[o] = true
			add_fx(ar, {"type": "bolt", "p": from, "p2": o.p, "col": Color("#d8f0ff"), "t": 0.16, "dur": 0.16, "w": 1.5})
			from = o.p
			auto_hit(ar, c, o, f(rc, "pct"), true)
	if not second and bsum(c, "glaive") > 0:
		# 0.19 Ysolde's Glaive Dance: the glaive bounces on, each bounce weaker
		var gd := glaive_buff(c)
		var ghit := {m: true}
		var gfrom: Vector2 = mp
		var gk := 1.0
		for j in int(gd.get("glaive", 0)):
			var o = nearest_mon(ar, gfrom, f(gd, "hop", 170), ghit)
			if o == null:
				break
			ghit[o] = true
			gk *= f(gd, "fall", 0.7)
			add_fx(ar, {"type": "bolt", "p": gfrom, "p2": o.p, "col": Color("#e4ecff"), "t": 0.18, "dur": 0.18, "w": 2.0})
			gfrom = o.p
			auto_hit(ar, c, o, gk, true)
	if not second:
		_hit_ctx = ""


func glaive_buff(c) -> Dictionary:
	for b in c.buffs:
		if b.has("glaive"):
			return b
	return {}


const SIPHON_CAP := 60.0        # Siphon's %-of-max-health bonus can't exceed this (times the level multiplier)


# Warbringer's Fervor: every basic attack adds a stack of attack speed that fades a few seconds later.
func fervor_stack(c, fv: Dictionary) -> void:
	for b in c.buffs:
		if b.has("fervor"):
			b["fervor"] = mini(int(fv["max"]), int(b["fervor"]) + 1)
			b["as"] = 1.0 + f(fv, "as") * int(b["fervor"])
			b["t"] = f(fv, "dur")
			return
	c.buffs.append({"t": f(fv, "dur"), "fervor": 1, "as": 1.0 + f(fv, "as")})


# Lightning-style chain. With hit_set given, the chain starts beside `start` (start is skipped).
func chain_hit(ar, c, start, dmg: float, n: int, hop: float, fx: Dictionary, hit_set = null, vk := "") -> void:
	var cur = start
	var prev: Vector2 = c.p
	var hit: Dictionary = {} if hit_set == null else hit_set
	if hit_set != null:
		prev = start.p
		cur = nearest_mon(ar, prev, hop, hit)
	for k in n:
		if cur == null:
			break
		hit[cur] = true
		add_fx(ar, {"type": "bolt", "p": prev, "p2": cur.p, "col": Color("#bfe3ff"), "t": 0.25, "dur": 0.25, "w": 2.0, "vis": vk})
		prev = cur.p
		apply_fx(cur, fx, c)
		hurt(ar, cur, dmg, c)
		cur = nearest_mon(ar, prev, hop, hit)


# ---------------------------------------------------------------- casting
func aim_at(c, tp: Vector2, reach: float) -> Dictionary:
	var dv: Vector2 = tp - c.p
	var d := dv.length()
	var u: Vector2 = dv / d if d > 0.01 else Vector2.from_angle(c.face)
	if reach >= 0 and d > reach:
		d = reach
	var pt: Vector2 = c.p + u * d
	pt.x = clampf(pt.x, 10, W - 10)
	pt.y = clampf(pt.y, 10, H - 10)
	return {"u": u, "d": d, "pt": pt}


func cast(ar, c, i: int, tp: Vector2) -> bool:
	if c.dead or c.cds[i] > 0 or c.dash != null or c.ranks[i] <= 0 or c.stun > 0 or c.silence > 0:
		return false
	var sk: Dictionary = c.def["skills"][i]
	c.chan = null   # casting anything ends a channel (Soul Tether)
	recall_cancel(c)
	c.cds[i] = skill_cd(c, i)
	c.face = (tp - c.p).angle()
	c.cast_flash = 0.25
	c.anim_t = 0.45
	c.pl.casts += 1
	ev("cast", ar, c.p, {"t": String(sk["acts"][0]["t"]), "human": c.pl.id == local, "ult": i == 3, "col": c.col,
		"vis": "%s:%d" % [c.def.get("id", ""), i]})
	if i == 3:
		ev("ult", ar, c.p, {"pid": c.pl.id, "hero": String(c.def.get("id", "")), "name": String(sk.get("name", ""))})
	for a in sk["acts"]:
		do_act(ar, c, a, tp, i)
	if c.uniq.has("surge"):
		var su: Dictionary = c.uniq["surge"]
		c.surge_n += 1
		if c.surge_n >= int(su["every"]):
			c.surge_n = 0
			var sr := f(su, "r")
			var sd: float = f(su, "dmg") * lvl_mult(c) * c.pow * (1.0 + c_ap(c))
			add_fx(ar, {"type": "ring", "p": c.p, "r": sr, "col": Color("#8fd0ff"), "t": 0.45, "dur": 0.45, "fill": true})
			add_text(ar, c.p + Vector2(0, -48), "ARCANE SURGE", Color("#9fdcff"), 1.0, 12)
			for m in mons_in(ar, c.p, sr):
				hurt(ar, m, sd, c)
	if c.uniq.has("comet"):
		# Starcaller: every Nth cast calls a star down where the ability was aimed
		var cm: Dictionary = c.uniq["comet"]
		c.comet_n += 1
		if c.comet_n >= int(cm["every"]):
			c.comet_n = 0
			var b := Pend.new()
			b.p = aim_at(c, tp, f(cm, "range", 420))["pt"]
			b.r = f(cm, "r")
			b.dmg = f(cm, "dmg") * lvl_mult(c) * c.pow * (1.0 + c_ap(c))
			b.t = f(cm, "delay", 0.6)
			b.dur = b.t
			b.c = c
			b.col = Color("#ffe9a0")
			ar.pend.append(b)
			add_text(ar, c.p + Vector2(0, -48), "COMET", Color("#ffe9a0"), 1.0, 12)
			ev("comet", ar, b.p, {"human": c.pl.id == local})
	return true


func do_act(ar, c, a: Dictionary, tp: Vector2, si: int) -> void:
	var col: Color = c.col
	var lm: float = rank_mult(c, si) * c.pow
	var mul := lm * bm(c, "dmg") * attuned_mult(c)
	var fx: Dictionary = a.get("fx", {})
	var vk := "%s:%d" % [c.def.get("id", ""), si]
	match a["t"]:
		"shot":
			var base_ang: float = (tp - c.p).angle()
			var n := int(a.get("n", 1))
			for k in n:
				var ang := base_ang
				if n > 1:
					ang += -f(a, "spread") / 2.0 + f(a, "spread") * k / (n - 1)
				var pr := Proj.new()
				pr.p = c.p
				pr.spd = f(a, "spd", 560)
				pr.v = Vector2.from_angle(ang) * pr.spd
				pr.r = f(a, "r", 8)
				pr.dmg = f(a, "dmg") * mul
				pr.left = f(a, "range", 340)
				pr.pierce = bool(a.get("pierce", false))
				pr.explode = f(a, "explode")
				pr.fx = fx
				pr.c = c
				pr.col = col
				pr.vis = vk
				ar.projs.append(pr)
		"blast":
			var aim := aim_at(c, tp, f(a, "range", 300))
			var b := Pend.new()
			b.p = aim["pt"]
			b.r = f(a, "r")
			b.dmg = f(a, "dmg") * mul
			b.t = f(a, "delay", 0.35)
			b.dur = b.t
			b.fx = fx
			b.c = c
			b.col = col
			b.vis = vk
			ar.pend.append(b)
		"rain":
			var center: Vector2 = c.p if a.get("self", false) else aim_at(c, tp, f(a, "range", 320))["pt"]
			var n := int(a["n"])
			for k in n:
				var off := Vector2.from_angle(rng.randf() * TAU) * sqrt(rng.randf()) * f(a, "spread")
				var b := Pend.new()
				b.p = Vector2(clampf(center.x + off.x, 0, W), clampf(center.y + off.y, 0, H))
				b.r = f(a, "r")
				b.dmg = f(a, "dmg") * mul
				b.t = 0.25 + (float(k) / n) * f(a, "dur")
				b.dur = b.t
				b.fx = fx
				b.c = c
				b.col = col
				b.vis = vk
				b.small = true
				if a.get("self", false):
					b.follow = c
					b.fd = off
				ar.pend.append(b)
		"nova":
			var r := f(a, "r")
			add_fx(ar, {"type": "ring", "p": c.p, "r": r, "col": col, "t": 0.4, "dur": 0.4, "fill": true, "vis": vk})
			for m in mons_in(ar, c.p, r):
				if a.get("gold", false):
					m.gold_t = t + 3.0
				apply_fx(m, fx, c)
				hurt(ar, m, f(a, "dmg") * mul, c)
			if a.has("heal"):
				var amt := f(a, "heal") * lm
				for o in ar.champs:
					if not o.dead and o.pl.team == c.pl.team and o.p.distance_to(c.p) < r:
						heal_champ(o, amt)
						add_text(ar, o.p + Vector2(0, -20), "+%d" % roundi(amt), Color("#9be59b"))
		"cone":
			var base_ang: float = (tp - c.p).angle()
			var reach := f(a, "range")
			add_fx(ar, {"type": "cone", "p": c.p, "a": base_ang, "s": f(a, "ang"), "r": reach, "col": col, "t": 0.35, "dur": 0.35, "vis": vk})
			for m in ar.mons:
				if m.dead:
					continue
				var dd: float = m.p.distance_to(c.p)
				if dd - m.r > reach:
					continue
				var da := angle_difference(base_ang, (m.p - c.p).angle())
				var pad: float = atan(m.r / dd) if dd > 0 else 3.0
				if absf(da) <= f(a, "ang") / 2.0 + pad:
					apply_fx(m, fx, c)
					hurt(ar, m, f(a, "dmg") * mul, c)
		"beam":
			var aim := aim_at(c, tp, -1)
			var e: Vector2 = c.p + aim["u"] * f(a, "len")
			var w := f(a, "w")
			add_fx(ar, {"type": "beam", "p": c.p, "p2": e, "w": w, "col": col, "t": 0.35, "dur": 0.35, "vis": vk})
			for m in ar.mons:
				if not m.dead and seg_dist(m.p, c.p, e) < w / 2.0 + m.r:
					apply_fx(m, fx, c)
					hurt(ar, m, f(a, "dmg") * mul, c)
		"dash":
			var aim := aim_at(c, tp, f(a, "dist"))
			var e: Vector2 = bridge_stop(c.p, walk_clamp(aim["pt"], c.r), c.r)
			var w := f(a, "w", 30)
			if a.has("dmg"):
				for m in ar.mons:
					if not m.dead and seg_dist(m.p, c.p, e) < w / 2.0 + m.r:
						apply_fx(m, fx, c)
						hurt(ar, m, f(a, "dmg") * mul, c)
			add_fx(ar, {"type": "beam", "p": c.p, "p2": e, "w": f(a, "w", 16), "col": col, "t": 0.25, "dur": 0.25, "vis": vk})
			c.dash = {"s": c.p, "e": e, "t": 0.0, "dur": 0.16}
			c.moving = false
			c.route = []
		"blink":
			var aim := aim_at(c, tp, f(a, "range"))
			var dest: Vector2 = aim["pt"]
			var bt = null
			if a.get("tgt", false):
				# 0.19 Crescent Pounce: leap onto the monster nearest the aim and strike it
				bt = nearest_mon(ar, tp, 120)
				if bt == null or bt.p.distance_to(c.p) > f(a, "range") + bt.r:
					bt = nearest_mon(ar, c.p, f(a, "range"))
				if bt != null:
					var bd: Vector2 = bt.p - c.p
					dest = bt.p - (bd.normalized() if bd.length() > 0.01 else Vector2.RIGHT) * (bt.r + 16.0)
					c.face = bd.angle()
			burst(ar, c.p, col, 10, 80)
			c.p = walk_clamp(dest)
			if bt != null and a.has("dmg"):
				add_fx(ar, {"type": "ring", "p": bt.p, "r": 30.0, "col": col, "t": 0.3, "dur": 0.3, "vis": vk})
				apply_fx(bt, fx, c)
				hurt(ar, bt, f(a, "dmg") * mul, c)
			c.moving = false
			c.dash = null
			burst(ar, c.p, col, 10, 80)
			add_fx(ar, {"type": "blink", "p": c.p, "col": col, "t": 0.5, "dur": 0.5, "vis": vk})
		"buff":
			var b: Dictionary = a.duplicate()
			b["t"] = f(a, "dur")
			c.buffs.append(b)
			if a.has("shield"):
				c.shield += f(a, "shield") * lm
				c.shield_t = maxf(c.shield_t, f(a, "dur"))
			add_fx(ar, {"type": "ring", "p": c.p, "r": 30.0, "col": col, "t": 0.3, "dur": 0.3, "follow": c, "vis": vk})
		"team":
			for o in ar.champs:
				if o.dead or o.pl.team != c.pl.team:
					continue
				var b := {"t": f(a, "dur")}
				for k in ["as", "ms", "dmg"]:
					if a.has(k):
						b[k] = a[k]
				o.buffs.append(b)
				if a.has("shield"):
					o.shield += f(a, "shield") * lm
					o.shield_t = maxf(o.shield_t, f(a, "dur"))
				if a.has("heal"):
					var amt := f(a, "heal") * lm
					heal_champ(o, amt)
					add_text(ar, o.p + Vector2(0, -20), "+%d" % roundi(amt), Color("#9be59b"))
				add_fx(ar, {"type": "ring", "p": o.p, "r": 34.0, "col": col, "t": 0.5, "dur": 0.5, "follow": o, "vis": vk})
		"heal":
			var r := f(a, "r")
			var amt := f(a, "amt") * lm
			add_fx(ar, {"type": "ring", "p": c.p, "r": r, "col": Color("#9be59b"), "t": 0.5, "dur": 0.5, "fill": true, "vis": vk})
			for o in ar.champs:
				if not o.dead and o.pl.team == c.pl.team and o.p.distance_to(c.p) < r:
					heal_champ(o, amt)
					add_text(ar, o.p + Vector2(0, -20), "+%d" % roundi(amt), Color("#9be59b"))
		"zone":
			var z := Zone.new()
			z.p = c.p if a.get("self", false) else aim_at(c, tp, f(a, "range", 300))["pt"]
			z.r = f(a, "r")
			z.dps = f(a, "dps") * mul
			z.slow = f(a, "slow")
			z.pull = f(a, "pull")
			z.t = f(a, "dur")
			z.dur = z.t
			z.c = c
			z.col = col
			z.vis = vk
			z.follow = c if a.get("follow", false) else null
			z.spin = rng.randf() * 6.0
			z.sil = bool(a.get("sil", false))
			ar.zones.append(z)
		"chain":
			var aim := aim_at(c, tp, f(a, "range"))
			var start = nearest_mon(ar, aim["pt"], 120)
			if start == null:
				start = nearest_mon(ar, c.p, f(a, "range"))
			if start != null:
				chain_hit(ar, c, start, f(a, "dmg") * mul, int(a["n"]), f(a, "hop"), fx, null, vk)
		"summon":
			for k in int(a.get("n", 1)):
				var aim := aim_at(c, tp, 40)
				var s := Summon.new()
				var sp: Vector2 = aim["pt"] + Vector2(rng.randf_range(-14, 14), rng.randf_range(-14, 14))
				s.p = bridge_push(Vector2(clampf(sp.x, 10, W - 10), clampf(sp.y, 10, H - 10)), 10.0)
				s.c = c
				s.dmg = f(a, "dmg") * mul * float(c.syn_fx.get("summon_dmg", 1.0))
				s.atk_speed = f(a, "as", 1)
				s.reach = f(a, "range")
				s.t = f(a, "dur") * float(c.syn_fx.get("summon_dur", 1.0))
				s.dur = s.t
				s.mobile = bool(a.get("mobile", false))
				s.splash = f(a, "splash")
				s.fx = fx
				s.size = f(a, "size", 9)
				s.name = a.get("name", "")
				s.col = col
				ar.sums.append(s)
		"storm":
			# the neutral camp is not part of the wave: a storm never reaches (or provokes) it
			var list: Array = ar.mons.filter(func(m): return not m.dead and not m.d.get("camp", false))
			list.sort_custom(func(x, y): return progress(x) > progress(y))
			if a.has("n"):
				list = list.slice(0, int(a["n"]))
			for m in list:
				add_fx(ar, {"type": "bolt", "p": m.p + Vector2(randf_range(-30, 30), -160), "p2": m.p, "col": col, "t": 0.35, "dur": 0.35, "w": 2.5, "vis": vk})
				apply_fx(m, fx, c)
				hurt(ar, m, f(a, "dmg") * mul, c)
			add_fx(ar, {"type": "flash", "col": col, "t": 0.3, "dur": 0.3, "vis": vk})
		"exec":
			var reach := f(a, "range")
			var m = nearest_mon(ar, tp, 90)
			if m == null or m.p.distance_to(c.p) > reach + m.r:
				m = nearest_mon(ar, c.p, reach)
			if m == null:
				c.cds[si] = 1.0
				return
			add_fx(ar, {"type": "beam", "p": c.p, "p2": m.p, "w": 6.0, "col": col, "t": 0.3, "dur": 0.3, "vis": vk})
			add_fx(ar, {"type": "ring", "p": m.p, "r": 28.0, "col": col, "t": 0.4, "dur": 0.4, "vis": vk})
			hurt(ar, m, f(a, "dmg") * mul + f(a, "pct") * (m.max_hp - m.hp), c, true)
			if m.dead and f(a, "refund") > 0:
				c.cds[si] *= 1.0 - f(a, "refund")
				add_text(ar, c.p + Vector2(0, -24), "RESET", col, 1.0, 12)
		"drain":
			# 0.19 Corvina's Soul Tether: a channel (see chan_step)
			var reach := f(a, "range")
			var m = nearest_mon(ar, tp, 90)
			if m == null or m.p.distance_to(c.p) > reach + m.r:
				m = nearest_mon(ar, c.p, reach)
			if m == null:
				c.cds[si] = 1.0
				return
			c.chan = {"tgt": m, "t": f(a, "dur"), "dps": f(a, "dps") * mul * (f(a, "hero_k", 1.0) if m is Champ else 1.0), "heal": f(a, "heal", 1.0), "leash": f(a, "leash", reach + 80.0), "ar": ar, "vis": vk}
			c.moving = false
			c.route = []
			c.face = (m.p - c.p).angle()
			add_fx(ar, {"type": "beam", "p": c.p, "p2": m.p, "w": 5.0, "col": col, "t": 0.3, "dur": 0.3, "vis": vk})
		"charm":
			# 0.19 Corvina's Grave Covenant: a lane monster (never a boss, the camp or a hero) changes sides for good
			var m = charm_pick(ar, c, tp, f(a, "range"), charm_cap(c, si, a))
			if m == null:
				c.cds[si] = 1.0
				add_text(ar, c.p + Vector2(0, -30), "NO TARGET", col, 0.9, 11)
				return
			charm_mon(ar, c, m, a, si)
		"volley":
			# 0.19 Ysolde's Crescent Volley: one glaive at each of the nearest monsters in range
			var reach := f(a, "range")
			var vl: Array = []
			for m in ar.mons:
				if not m.dead and not m.d.get("camp", false) and m.p.distance_to(c.p) - m.r <= reach:
					vl.append([m.p.distance_squared_to(c.p), vl.size(), m])
			vl.sort_custom(func(x, y): return x[0] < y[0] or (x[0] == y[0] and x[1] < y[1]))
			if vl.is_empty():
				c.cds[si] = 1.0
				return
			add_fx(ar, {"type": "ring", "p": c.p, "r": 40.0, "col": col, "t": 0.35, "dur": 0.35, "follow": c, "vis": vk})
			for k in int(a.get("n", 10)):
				var pr := Proj.new()
				pr.homing = true
				pr.p = c.p
				pr.tgt = vl[k % vl.size()][2]
				pr.spd = f(a, "spd", 720) * (1.0 - 0.04 * (k / vl.size()))
				pr.c = c
				pr.col = col
				pr.dmg = f(a, "dmg") * mul * (1.0 if k < vl.size() else f(a, "wrap", 0.4))
				pr.fx = fx
				pr.vis = vk
				ar.projs.append(pr)
		"pull":
			var aim := aim_at(c, tp, f(a, "range"))
			var pt: Vector2 = aim["pt"]
			add_fx(ar, {"type": "implode", "p": pt, "r": f(a, "r"), "col": col, "t": 0.45, "dur": 0.45, "vis": vk})
			for m in mons_in(ar, pt, f(a, "r")):
				if not m.cci:
					var dv: Vector2 = pt - m.p
					var dd := dv.length()
					if dd > 1:
						m.p += dv / dd * minf(dd - 4, f(a, "str") * m.ten)
						if not m.fly:
							m.p = bridge_push(m.p, m.r)
					if m is Mon:
						unsiege(m)
				hurt(ar, m, f(a, "dmg") * mul, c)


# ---------------------------------------------------------------- 0.19: Corvina and Ysolde
const GRAVE_TIERS := [
	{"name": "Barrow Skeleton", "kind": "minion", "lvl": 1, "dmg": 8.0, "hp": 170.0, "size": 7.0},
	{"name": "Barrow Warrior", "kind": "skeleton", "lvl": 10, "dmg": 20.0, "hp": 320.0, "size": 8.5},
	{"name": "Barrow Knight", "kind": "skeleton", "lvl": 20, "dmg": 30.0, "hp": 520.0, "size": 10.5},
]
const GRAVE_LIFE := 30.0        # a risen skeleton crumbles after this long
const GRAVE_SPD := 150.0
const GRAVE_MARCH := 450.0      # a skeleton marches at most this far up the road from where it rose
const CHARM_SPD := 150.0
const CHARM_DMG_K := 1.5        # a charmed monster hits monsters this much harder than it hit heroes
const SUM_CLASH_K := 0.6        # share of a monster's damage rating it deals to a risen or charmed unit it touches


func grave_tier(c) -> Dictionary:
	var tr: Dictionary = GRAVE_TIERS[0]
	for g in GRAVE_TIERS:
		if c.lvl >= int(g["lvl"]):
			tr = g
	return tr


func tagged_count(ar, c, tag: String) -> int:
	var n := 0
	for su in ar.sums:
		if su.c == c and su.tag == tag and su.t > 0:
			n += 1
	for su in ar.sums_new:
		if su.c == c and su.tag == tag:
			n += 1
	return n


# Gravebound: a marked lane monster died; it rises as a skeleton that marches up the road for Corvina.
func grave_rise(ar, c, m) -> void:
	var p: Dictionary = c.def["passive"]
	if tagged_count(ar, c, "grave") >= int(p.get("max", 4)):
		return
	var tr := grave_tier(c)
	var s := Summon.new()
	s.tag = "grave"
	s.kind = String(tr["kind"])
	s.name = String(tr["name"])
	s.p = m.p if m.fly else bridge_push(m.p, 8.0)
	s.c = c
	var k: float = lvl_mult(c) * c.pow
	s.dmg = f(tr, "dmg") * k * float(c.syn_fx.get("summon_dmg", 1.0))
	s.max_hp = f(tr, "hp") * k * mon_scale()
	s.hp = s.max_hp
	s.atk_speed = 1.1
	s.reach = 24.0
	s.t = GRAVE_LIFE * float(c.syn_fx.get("summon_dur", 1.0))
	s.dur = s.t
	s.mobile = true
	s.size = f(tr, "size")
	s.r = s.size
	s.col = c.col
	s.face = m.ang + PI
	s.path = m.path
	s.wi = m.wi
	s.home = s.p
	ar.sums_new.append(s)
	add_fx(ar, {"type": "ring", "p": s.p, "r": 22.0, "col": Color("#9dffc8"), "t": 0.5, "dur": 0.5, "fill": true})
	add_text(ar, s.p + Vector2(0, -24), "RISEN", Color("#9dffc8"), 0.8, 10)


# Grave Covenant: the health a monster may have to be charmed at this rank (0 = any non-boss).
func charm_cap(c, si: int, a: Dictionary) -> float:
	var caps: Array = a.get("cap", [0])
	return float(caps[clampi(c.ranks[si] - 1, 0, caps.size() - 1)])


func charmable(m, cap_hp: float) -> bool:
	return m is Mon and not m.dead and not m.d.get("boss", false) and not m.d.get("camp", false) and m.spd > 0.0 \
		and m.kind != "totem" and (cap_hp <= 0.0 or m.max_hp <= cap_hp)


# The monster a cast at tp charms: the charmable one nearest the aim, else the toughest charmable one in reach.
func charm_pick(ar, c, tp: Vector2, reach: float, cap_hp: float):
	var best = null
	var bd := 120.0
	for m in ar.mons:
		if charmable(m, cap_hp) and m.p.distance_to(c.p) <= reach + m.r:
			var d: float = m.p.distance_to(tp) - m.r
			if d < bd:
				bd = d
				best = m
	if best != null:
		return best
	var bh := -1.0
	for m in ar.mons:
		if charmable(m, cap_hp) and m.p.distance_to(c.p) <= reach + m.r and m.max_hp > bh:
			bh = m.max_hp
			best = m
	return best


func charm_mon(ar, c, m, a: Dictionary, si: int) -> void:
	# it leaves the wave quietly: no bounty, no experience (charming is not a way to farm gold)
	m.dead = true
	var s := Summon.new()
	s.tag = "charm"
	s.kind = m.kind
	s.name = String(m.d.get("name", m.kind))
	s.p = m.p
	s.home = m.p if m.fly else bridge_push(m.p, m.r)
	s.c = c
	s.max_hp = m.max_hp
	s.hp = m.max_hp
	var rk: float = 1.0 + 0.35 * maxi(0, c.ranks[si] - 1)
	if m.d.has("ranged"):
		var rg: Dictionary = m.d["ranged"]
		s.reach = f(rg, "range") * 0.9
		s.atk_speed = 1.0 / maxf(0.3, f(rg, "cd", 1.5))
		s.dmg = f(rg, "dmg") * mon_scale() * m.dmg_k * CHARM_DMG_K * rk
		s.splash = f(rg, "splash")
	else:
		s.reach = m.r + 16.0
		s.atk_speed = 1.0
		s.dmg = m.dps * CHARM_DMG_K * rk
	s.dmg = maxf(s.dmg, 20.0 * lvl_mult(c)) * c.pow
	s.mobile = true
	s.size = m.r
	s.r = m.r
	s.col = c.col
	s.face = m.ang
	s.t = 1.0e9
	s.dur = s.t
	# a covenant has room for so many: the oldest is released (crumbles) when a new one is bound
	var cap_n: Array = a.get("max", [1])
	var keep := int(cap_n[clampi(c.ranks[si] - 1, 0, cap_n.size() - 1)])
	var mine: Array = ar.sums.filter(func(x): return x.c == c and x.tag == "charm" and x.t > 0)
	while mine.size() >= keep and not mine.is_empty():
		var old = mine.pop_front()
		old.t = 0.0
		burst(ar, old.p, Color("#9dffc8"), 10, 90)
	ar.sums.append(s)
	add_fx(ar, {"type": "ring", "p": s.p, "r": m.r + 26.0, "col": Color("#9dffc8"), "t": 0.6, "dur": 0.6, "fill": true, "vis": "%s:%d" % [c.def.get("id", ""), si]})
	add_fx(ar, {"type": "beam", "p": c.p, "p2": s.p, "w": 6.0, "col": Color("#9dffc8"), "t": 0.35, "dur": 0.35})
	add_text(ar, s.p + Vector2(0, -m.r - 26), "BOUND", Color("#9dffc8"), 1.2, 13)


# Soul Tether: drains the target while Corvina stands still. Returns false once the channel has ended.
func chan_step(ar, c, dt: float) -> bool:
	var ch: Dictionary = c.chan
	var m = ch["tgt"]
	if ch["ar"] != ar or m == null or m.dead or not ar.mons.has(m) or m.p.distance_to(c.p) > f(ch, "leash") + m.r:
		c.chan = null
		return false
	ch["t"] = f(ch, "t") - dt
	c.face = (m.p - c.p).angle()
	var hp0: float = m.hp
	_hit_ctx = "dot"
	hurt(ar, m, f(ch, "dps") * dt, c, false, true)
	_hit_ctx = ""
	var got: float = maxf(0.0, hp0 - maxf(m.hp, 0.0))
	if got > 0:
		heal_champ(c, got * f(ch, "heal", 1.0))
	if f(ch, "t") <= 0 or m.dead:
		c.chan = null
		return false
	return true


# Silver Oath: the attack damage share Ysolde's aura gives her (allies get "ally" of it).
func oath_pct(c) -> float:
	var p: Dictionary = c.def["passive"]
	return minf(f(p, "cap", 0.4), f(p, "base") + f(p, "per") * attr_gain(c, "cun"))


# The nearest wave monster a risen or charmed unit will fight (never the neutral camp).
func sum_target(ar, pos: Vector2, reach: float):
	var best = null
	var bd := INF
	for m in ar.mons:
		if m.dead or m.d.get("camp", false):
			continue
		var d: float = m.p.distance_to(pos) - m.r
		if d <= reach and d < bd:
			bd = d
			best = m
	return best


# 0.24: damage from a lane monster's blow or shot to a risen skeleton / bound monster (no armour); it crumbles at 0.
func sum_hurt(ar, s, dmg: float) -> void:
	if s.dead:
		return
	s.hp -= dmg
	if s.hp <= 0.0:
		s.hp = 0.0
		s.t = 0.0
		burst(ar, s.p, Color("#d8e8d0"), 10, 90)


# Risen skeletons and charmed monsters: lane monsters fight them like heroes; they hunt monsters near them,
# otherwise skeletons march up the road toward the rifts and charmed monsters return to the spot they guard.
func tagged_move(ar, s, dt: float) -> void:
	# 0.24: no more contact wear (SUM_CLASH_K): lane monsters now turn on these units and hit or shoot them
	# like a hero (mon_engage, the ranged shots), and sum_hurt takes them down
	if s.hp <= 0.0:
		s.t = 0.0
		burst(ar, s.p, Color("#d8e8d0"), 10, 90)
		return
	var spd: float = GRAVE_SPD if s.tag == "grave" else CHARM_SPD
	var m = sum_target(ar, s.p, 420.0)
	var to: Vector2 = s.p
	if m != null:
		var dv: Vector2 = m.p - s.p
		if dv.length() > s.reach * 0.7 + m.r:
			to = m.p
		s.face = dv.angle()
	elif s.tag == "grave" and s.path != null and s.wi > 0 and s.path[s.wi - 1].distance_to(s.home) < GRAVE_MARCH:
		to = s.path[s.wi - 1]
		if s.p.distance_to(to) < 12.0:
			s.wi -= 1
	elif s.tag == "charm" and s.p.distance_to(s.home) > 24.0:
		to = s.home
	var dv2: Vector2 = to - s.p
	var dd := dv2.length()
	if dd > 1.0:
		s.p = walk_clamp(s.p + dv2 / dd * minf(dd, spd * dt))
		if m == null:
			s.face = dv2.angle()


static func seg_dist(pt: Vector2, a: Vector2, b: Vector2) -> float:
	return pt.distance_to(Geometry2D.get_closest_point_to_segment(pt, a, b))


# ---------------------------------------------------------------- champion update
func upd_champ(ar, c, dt: float) -> void:
	if c.guard_cd > 0:
		c.guard_cd -= dt
	if c.rebirth_cd > 0:
		c.rebirth_cd -= dt
	if c.inv_t > 0:
		c.inv_t -= dt
	if c.golden_t > 0:
		c.golden_t -= dt
	for aid in c.act_cd:
		if c.act_cd[aid] > 0:
			c.act_cd[aid] -= dt
	# ability and item cooldowns both keep ticking while the hero waits to respawn
	for i in 4:
		if c.cds[i] > 0:
			c.cds[i] -= dt
	if c.silence > 0:
		c.silence -= dt
	if c.dead:
		c.chan = null
		c.recall = 0.0
		c.respawn -= dt
		if c.respawn <= 0:
			c.dead = false
			c.hp = c.max_hp
			c.p = CORE + Vector2(-120, rng.randf_range(-60, 60))
			c.moving = false
			c.order = "idle"
			c.cur_tgt = null
			c.anchor = c.p
		return
	if c.uniq.has("immolate") or c.uniq.has("rally"):
		c.aura_t -= dt
		if c.aura_t <= 0:
			c.aura_t = 0.5
			if c.uniq.has("immolate"):
				var im: Dictionary = c.uniq["immolate"]
				for m in mons_in(ar, c.p, f(im, "r")):
					hurt(ar, m, f(im, "dps") * 0.5 * lvl_mult(c) * c.pow, c, false, true)
			if c.uniq.has("rally"):
				# Warlord's Mantle: allied heroes near the bearer (and the bearer) fight with extra armor
				var ra: Dictionary = c.uniq["rally"]
				for o in ar.champs:
					if o.dead or o.pl.team != c.pl.team or o.p.distance_to(c.p) > f(ra, "r"):
						continue
					o.buffs = o.buffs.filter(func(b): return not (b.has("rally") and b["rally"] == c.pl.id))
					o.buffs.append({"t": 0.75, "rally": c.pl.id, "armor_add": f(ra, "armor")})
	for b in c.buffs:
		b["t"] -= dt
	c.buffs = c.buffs.filter(func(b): return b["t"] > 0)
	if c.shield_t > 0:
		c.shield_t -= dt
		if c.shield_t <= 0:
			c.shield = 0
	if c.cast_flash > 0:
		c.cast_flash -= dt
	if c.anim_t > 0:
		c.anim_t -= dt
	c.spd = c_ms(c)
	c.ang = c.face
	if c.slow_t > 0:
		c.slow_t -= dt
		if c.slow_t <= 0:
			c.slow = 0.0
	if c.hex > 0:
		c.hex -= dt
	if c.burn_t > 0:
		c.burn_t -= dt
		_hit_ctx = "dot"
		hurt_champ(ar, c, c.burn_dps * dt, c.burn_src)
		_hit_ctx = ""
	heal_champ(c, c_regen(c) * dt)
	if c.pot_t > 0:
		c.pot_t -= dt
		heal_champ(c, c.pot_rate * dt)
	if c.p.distance_to(CORE) < FOUNTAIN_R:
		heal_champ(c, c.max_hp * (0.05 + f(c.uniq.get("homeward", {}), "pct")) * dt)   # 0.26 Waystone: Homeward heals faster here
	var p: Dictionary = c.def["passive"]
	var pt: String = p["t"]
	if pt == "thorns":
		c.thorn_t -= dt
		if c.thorn_t <= 0:
			c.thorn_t = 0.25
			for m in mons_in(ar, c.p, f(p, "r")):
				hurt(ar, m, f(p, "dps") * 0.25 * lvl_mult(c), c)
	elif pt == "auraheal":
		for o in ar.champs:
			if not o.dead and o.pl.team == c.pl.team and o.p.distance_to(c.p) < f(p, "r"):
				heal_champ(o, f(p, "hps") * lvl_mult(c) * dt)
	elif pt == "oath":
		# 0.19 Silver Oath: Ysolde and the allied heroes near her hit harder
		c.oath_t -= dt
		if c.oath_t <= 0:
			c.oath_t = 0.5
			var op := oath_pct(c)
			for o in ar.champs:
				if o.dead or o.pl.team != c.pl.team or (o != c and o.p.distance_to(c.p) > f(p, "r")):
					continue
				o.buffs = o.buffs.filter(func(b): return not b.has("oath"))
				o.buffs.append({"t": 0.75, "oath": op if o == c else op * f(p, "ally")})
	elif pt == "runic":
		c.pass_t += dt
		if c.pass_t >= f(p, "every"):
			c.pass_t = 0
			c.shield = maxf(c.shield, f(p, "shield") * lvl_mult(c))
			c.shield_t = maxf(c.shield_t, 6.0)
	if c.dash != null:
		recall_cancel(c)
		c.dash["t"] += dt
		var k := minf(1.0, c.dash["t"] / c.dash["dur"])
		c.p = c.dash["s"].lerp(c.dash["e"], k)
		if k >= 1:
			c.dash = null
		return
	if c.chan != null and (c.stun > 0 or c.silence > 0):
		c.chan = null   # a stun or a silence breaks a channel
	if c.recall > 0 and c.stun > 0:
		recall_cancel(c)   # a stun or a knock breaks a Recall (damage alone does not)
	if c.stun > 0:
		c.stun -= dt
		return
	if c.recall > 0 and duel_on:
		recall_cancel(c)   # a duel starting moves everyone to the ring: nobody blinks home out of it
	if c.recall > 0:
		c.recall -= dt
		c.moving = false
		if c.recall <= 0:
			recall_done(ar, c)
		return   # channelling Recall: stand still, no attacks
	if c.chan != null and chan_step(ar, c, dt):
		c.moving = false
		return
	if c.pl.human:
		human_orders(ar, c, dt)
	var p0: Vector2 = c.p
	var step0 := 0.0
	if c.moving:
		var stepd := c_ms(c) * dt
		step0 = stepd
		while stepd > 0 and not c.route.is_empty():
			var tgt: Vector2 = c.route[0]
			var dv: Vector2 = tgt - c.p
			var d := dv.length()
			if d <= stepd:
				c.p = tgt
				stepd -= d
				c.route.pop_front()
			else:
				c.p += dv / d * stepd
				c.face = dv.angle()
				stepd = 0
		if c.route.is_empty():
			c.moving = false
	c.p = walk_clamp(Vector2(clampf(c.p.x, 12, W - 12), clampf(c.p.y, 12, H - 12)))
	# 0.26: a walk that the walls cancel (pushed straight back every step) is not left to press on for ever
	if step0 > 0.01 and c.moving:
		if c.p.distance_to(p0) < step0 * 0.3:
			c.stall += dt
			if c.stall >= STALL_T:
				unstick(c)
		else:
			c.stall = 0.0
	else:
		c.stall = 0.0
	c.atk_cd -= dt
	if c.atk_cd <= 0:
		var reach := c_range(c)
		var melee := reach <= 60
		var tgt = null
		if c.pl.human:
			# a plain move order walks past monsters; everything else fights what is in reach
			if c.order != "move":
				if c.cur_tgt != null and _hittable(ar, c.cur_tgt, melee) and c.cur_tgt.p.distance_to(c.p) - c.cur_tgt.r <= reach \
						and not (melee and not c.cur_tgt.fly and wall_between(c.p, c.cur_tgt.p)):
					tgt = c.cur_tgt
				elif c.auto_acq or c.order != "idle":
					tgt = nearest_mon(ar, c.p, reach, null, melee)
		elif c.ai_tgt != null and not c.ai_tgt.dead and c.ai_tgt.p.distance_to(c.p) - c.ai_tgt.r <= reach \
				and not (melee and not c.ai_tgt.fly and wall_between(c.p, c.ai_tgt.p)):
			tgt = c.ai_tgt
		else:
			tgt = nearest_mon(ar, c.p, reach, null, melee)
		if tgt != null:
			c.atk_cd = 1.0 / c_as(c)
			c.face = (tgt.p - c.p).angle()
			c.anim_t = minf(0.35, c.atk_cd * 0.8)
			ev("swing" if melee else "shoot", ar, c.p, {"human": c.pl.id == local, "hero": String(c.def.get("id", ""))})
			var tg: Array = [tgt]
			if pt == "multi":
				var o = nearest_mon(ar, c.p, reach, tgt)
				if o != null:
					tg.append(o)
			for m in tg:
				if melee:
					add_fx(ar, {"type": "slash", "p": c.p, "a": (m.p - c.p).angle(), "col": c.col, "t": 0.15, "dur": 0.15})
					auto_hit(ar, c, m)
				else:
					var pr := Proj.new()
					pr.homing = true
					pr.p = c.p
					pr.tgt = m
					pr.spd = 640
					pr.c = c
					pr.col = c.col
					pr.auto = true
					pr.vis = "%s:auto" % c.def.get("id", "")
					ar.projs.append(pr)


# 0.26: last resort for a walk the bridge walls have stopped (STALL_T s without headway, see upd_champ): the
# hero turns for the road point it can walk straight to that costs the smallest detour to its goal (the one
# past the end of the wall), and takes the road from there. Bots and players alike: a player's move order is
# only rerouted when it is blocked the same way, never while it is making headway. With no such point at all
# the walk ends; a bot picks something else at its next think.
const STALL_T := 1.0


func unstick(c) -> void:
	c.stall = 0.0
	var goal: Vector2 = c.move_to
	var best := -1
	var bc := INF
	for k in reach_nodes(c.p, 6):
		var q: Vector2 = _g_nodes[k]
		if q.distance_to(c.p) < 24.0:
			continue
		var cst: float = c.p.distance_to(q) + q.distance_to(goal)
		if cst < bc:
			bc = cst
			best = k
	if best < 0:
		c.moving = false
		c.route = []
		return
	var via: Vector2 = _g_nodes[best]
	c.route = [via] + plan_route(via, goal)


# ---------------------------------------------------------------- AI
func ai_champ(ar, c, dt: float) -> void:
	if c.dead:
		return
	c.ai_t -= dt
	if c.ai_t > 0:
		return
	var thr: Array = DIFF_THINK[c.pl.diff]
	c.ai_t = rng.randf_range(thr[0], thr[1])
	var home: Vector2 = ai_home(ar, c)
	var commanded: bool = home != HOMES[c.home]
	# drink a potion when hurt; walk back to the crystal's fountain when badly hurt
	if c.hp < c.max_hp * 0.45 and c.potions > 0 and c.pot_t <= 0 and c.pl.diff >= 1:
		use_potion(c)
	if c.hp < c.max_hp * (0.2 if c.pl.diff >= 1 else 0.12) and c.pot_t <= 0:
		c.retreat = true
	if c.chan != null:
		if c.retreat or c.hp < c.max_hp * 0.25:
			c.chan = null
		else:
			return   # channelling Soul Tether: stand and drain
	if c.recall > 0:
		c.ai_tgt = null
		return   # channelling Recall: stand still (damage doesn't break it)
	if c.retreat:
		if c.hp >= c.max_hp * 0.85:
			c.retreat = false
		else:
			# 0.26 Waystone: a long walk home with nothing in melee reach is what Recall is for
			var rs := recall_slot(c)
			if rs >= 0 and c.p.distance_to(CORE) > 900.0 and c.dash == null and not duel_on and count_near(ar.mons.filter(func(m): return not m.dead), c.p, 160) == 0:
				use_item(c, rs, c.p)
				return
			if c.p.distance_to(CORE) > FOUNTAIN_R * 0.6 and c.dash == null:
				order_move(c, CORE + Vector2(-90, 0))
			c.ai_tgt = null
			return
	if c.want_shop and c.dash == null and not commanded:
		if near_shop(c):
			c.moving = false
			c.route = []
			c.ai_tgt = null
			return
		var threats := 0
		for m in ar.mons:
			if not m.dead and m.p.distance_to(home) < 700.0:
				threats += 1
		if threats < 3 or c.p.distance_to(SHOP) < 900.0:
			# 0.26 Waystone: a shopping trip from far down the road goes home by Recall
			var rs2 := recall_slot(c)
			if rs2 >= 0 and c.p.distance_to(CORE) > 1400.0 and not duel_on and count_near(ar.mons.filter(func(m): return not m.dead), c.p, 200) == 0:
				use_item(c, rs2, c.p)
				return
			if not c.moving or c.move_to.distance_to(SHOP) > 120.0:
				order_move(c, SHOP + Vector2(-50, 30))
			c.ai_tgt = null
			return
	var live: Array = ar.mons.filter(func(m): return not m.dead)
	var best = null
	var bs := -INF
	for m in live:
		if m == c.ai_skip and t < c.ai_skip_t:
			continue   # 0.26: could not get at it a moment ago
		var dh: float = m.p.distance_to(home)
		var s: float = progress(m) - maxf(0.0, dh - 520.0) * 8.0 + (300.0 if m.max_hp > 900 else 0.0) + (150.0 if m.d.has("ranged") else 0.0) + (4000.0 if m.kind == "totem" else 0.0)
		if s > bs:
			bs = s
			best = m
	c.ai_tgt = best
	if best != null and ai_unreachable(c, best):
		best = null
		c.ai_tgt = null
	if c.dash == null:
		if best != null:
			var d: float = best.p.distance_to(c.p)
			var reach := c_range(c)
			var want := reach * 0.78 if reach > 60 else 18.0
			var dir: Vector2 = (best.p - c.p) / maxf(d, 0.001)
			if d > want:
				# 0.26: a route still under way to (near) the same spot is kept: a fresh plan every think threw
				# away the detour round a bridge wall (and an unstick) before a step of it was walked
				var to: Vector2 = best.p - dir * want
				if not c.moving or c.route.is_empty() or c.move_to.distance_to(to) > 40.0:
					order_move(c, to)
			elif reach > 60 and d < 50 and c.hp < c.max_hp * 0.5:
				order_move(c, c.p - dir * 60 + Vector2(0, 20))
			else:
				c.moving = false
				c.route = []
		elif home.distance_to(c.p) > 40:
			order_move(c, home)
	if c.pl.diff == 0 and rng.randf() < 0.5:
		return
	ai_skills(ar, c, best, live)
	ai_items(ar, c, best, live)


# 0.26: a bot that has not got any closer to its target for AI_GIVEUP_T s while out of reach (a monster on a
# bridge deck seen from the lava below the parapet, the 0.25 Ashfall report) gives it up for AI_SKIP_T s and
# picks another at its next think, instead of pressing on at it for ever. In reach means hittable: a melee
# hero with a wall between is not in reach.
const AI_GIVEUP_T := 4.0
const AI_SKIP_T := 6.0


func ai_unreachable(c, m) -> bool:
	var reach := c_range(c)
	var d: float = m.p.distance_to(c.p)
	var hit: bool = d - m.r <= reach and not (reach <= 60 and not m.fly and wall_between(c.p, m.p))
	if m != c.ai_prog or hit or d < c.ai_prog_d - 8.0 or c.stun > 0.0 or c.dash != null:
		c.ai_prog = m
		c.ai_prog_d = d
		c.ai_prog_t = t
		return false
	if t - c.ai_prog_t < AI_GIVEUP_T:
		return false
	c.ai_skip = m
	c.ai_skip_t = t + AI_SKIP_T
	c.ai_prog = null
	c.ai_t = 0.0
	return true


func count_near(live: Array, pos: Vector2, r: float) -> int:
	var n := 0
	for m in live:
		if m.p.distance_squared_to(pos) < r * r:
			n += 1
	return n


func ai_skills(ar, c, best, live: Array) -> void:
	var big: bool = best != null and best.max_hp > 900
	var db: float = best.p.distance_to(c.p) if best != null else INF
	var has := best != null
	for i in [3, 2, 1, 0]:
		if c.cds[i] > 0 or c.ranks[i] <= 0 or c.def["skills"][i]["acts"].is_empty():
			continue
		var a: Dictionary = c.def["skills"][i]["acts"][0]
		var ult: bool = i == 3
		var ok := false
		match a["t"]:
			"buff":
				ok = has and db < c_range(c) + 80 and (not ult or count_near(live, c.p, 220) >= 3 or big)
			"team":
				ok = live.size() >= (7 if ult else 4)
				for o in ar.champs:
					if not o.dead and o.hp < o.max_hp * 0.45:
						ok = true
			"heal":
				for o in ar.champs:
					if not o.dead and o.hp < o.max_hp * 0.6 and o.p.distance_to(c.p) < f(a, "r"):
						ok = true
			"storm":
				ok = live.size() >= 8 or (big and live.size() >= 3)
			"summon":
				ok = has and db < 280
			"blink", "dash":
				var reach := f(a, "range", f(a, "dist"))
				ok = has and db < reach + 40 and (db > c_range(c) + 30 or count_near(live, best.p, 90) >= 2 or a.get("tgt", false))
			"nova":
				ok = count_near(live, c.p, f(a, "r")) >= (4 if ult else 2) or (big and db < f(a, "r"))
			"cone":
				ok = has and db < f(a, "range") and count_near(live, c.p, f(a, "range")) >= (3 if ult else 1)
			"exec":
				ok = has and db < f(a, "range")
			"drain":
				ok = has and db < f(a, "range") and (best.max_hp > 350 or c.hp < c.max_hp * 0.7)
			"volley":
				ok = count_near(live, c.p, f(a, "range")) >= 5 or (big and db < f(a, "range"))
			"charm":
				var cm = charm_pick(ar, c, c.p, f(a, "range"), charm_cap(c, i, a))
				ok = cm != null and (cm.max_hp > 900 or cm.d.has("ranged") or cm.d.has("heal") or live.size() >= 8)
				if ok:
					cast(ar, c, i, cm.p)
					break
				continue
			"zone":
				if a.get("self", false):
					ok = count_near(live, c.p, f(a, "r") + 20) >= 2
				else:
					ok = has and db < f(a, "range", 300) + 30 and (count_near(live, best.p, f(a, "r") + 40) >= (4 if ult else 2) or big \
						or (a.get("sil", false) and (best.d.has("ranged") or best.d.has("heal") or best.d.has("spawner") or best.d.has("haste") or best.d.has("ward"))))
			"rain":
				if a.get("self", false):
					ok = count_near(live, c.p, f(a, "spread")) >= 4
				else:
					ok = has and db < f(a, "range", 320) and (count_near(live, best.p, 150) >= 4 or big)
			_:
				var reach := f(a, "range", f(a, "len", 320))
				ok = has and db < reach and (not ult or count_near(live, best.p, 140) >= 4 or big)
		if ar.duel and has:
			ok = duel_skill_ok(c, a, db)
		if not ok:
			continue
		var tp: Vector2 = best.p if has else c.p + Vector2.from_angle(c.face) * 50
		if has and a["t"] in ["blast", "rain", "zone"] and best.stun <= 0:
			var lead: float = best.spd * (1.0 - best.slow) * minf(1.2, f(a, "delay", 0.5))
			tp += Vector2.from_angle(best.ang) * lead
		cast(ar, c, i, tp)
		break


# In the duel ring there is one enemy, not a pack: use an ability whenever it would reach the foe
# (self-centred ones when the foe is close), heal when hurt, and save nothing for later.
func duel_skill_ok(c, a: Dictionary, db: float) -> bool:
	match String(a["t"]):
		"heal", "team":
			return c.hp < c.max_hp * 0.7 or c.shield <= 0.0
		"buff":
			return db < c_range(c) + 120
		"summon", "storm":
			return db < 420
		"blink", "dash":
			return db < f(a, "range", f(a, "dist")) + 40 and (db > c_range(c) * 0.6 or a.get("tgt", false))
		"nova":
			return db < f(a, "r") + 10
		"zone", "rain":
			if a.get("self", false):
				return db < f(a, "r", f(a, "spread", 120)) + 10
			return db < f(a, "range", 320) + 20
		"cone", "exec", "drain", "volley":
			return db < f(a, "range")
		"charm":
			return false   # Grave Covenant never takes a hero
	return db < f(a, "range", f(a, "len", 320))


const AI_BUILD_ROUND := [0, 4, 8, 12, 18, 25]


func ai_send(pl, dt: float) -> void:
	pl.send_t -= dt
	if income_per_round:
		# 0.17 review: income lands in one lump, but the bot's sending money is released over the round at the
		# rate the 10 s ticks used to pay it. With the whole round's money at once the pick-by-sqrt(cost) rule
		# bought the priciest sends it could reach and the bots' income compounded ~1 %/round faster than in
		# 0.15 (+16 % gold a match, matches decided by send pile-ups); paced, the send mix is the 0.15 one.
		# 0.25: paced at what the payout really is for this tier (DIFF_INCOME); bounty gold is released as it
		# comes (ai_reserve), so a paced bot no longer banks every kill's gold as idle free gold
		pl.ai_allow += float(pl.income) * (DIFF_INCOME[pl.diff] if ai_econ_v2 else 1.0) * dt / maxf(1.0, round_len)
	if pl.send_t > 0:
		return
	pl.send_t = rng.randf_range(1.2, 3.0) * [1.6, 1.0, 0.85, 0.7, 0.6, 0.5][pl.diff]
	if not ai_econ_v2:
		ai_send_legacy(pl, dt)
		return
	# Every gold the AI earns is split four ways (see ai_reserve): income sends, the next monster
	# building, hero items, and the bank, which earns interest. Crystal upgrades come out of the bank.
	var ar = arenas[pl.team]
	var hc = pl.champ
	ai_fit_reserves(pl)
	ai_call_vote(pl)
	var core_frac: float = ar.core_hp / ar.core_max
	var cap := ai_bank_cap(pl)
	if round_no >= 2:
		var k := 0 if core_frac < 0.5 and ar.core_lv[0] <= ar.core_lv[1] + 2 else _cheapest_core(ar)
		if k >= 0 and ar.core_lv[k] < GameData.CORE_MAX_LV:
			var cc := core_cost(ar, k)
			# the crystal purse pays for upgrades; a hurt crystal is mended from the bank and the sending money
			# as well, but never from the item purse: a hero that falls behind the wave curve loses the crystal anyway
			var pool: float = pl.res_core + (pl.res_bank if core_frac < 0.5 else maxf(0.0, pl.res_bank - cap))
			if core_frac < 0.35:
				pool = maxf(pool, pl.gold - pl.res_items - pl.res_tech)
			if pool >= cc:
				if buy_core(pl, k) == "ok":
					var from_core := minf(pl.res_core, float(cc))
					pl.res_core -= from_core
					pl.res_bank = maxf(0.0, pl.res_bank - (cc - from_core))
					return
	if pl.res_bank > cap:
		pl.res_bank = cap   # more than the interest cap earns nothing: the rest goes on sends
	# buildings: bought as soon as their share of the gold covers the price, or, once their round has come
	# (0.25: AI_TECH_ROUND for this tier, the Warren in the setup minute), as soon as the gold is there at all:
	# half the item purse aside, every purse pays, and until then sends are throttled (see below)
	var tech_cap := mini(NB, int(max_tech[pl.team]))
	var overdue := ai_tech_overdue(pl)
	if pl.tech < tech_cap and (round_no >= 1 or overdue):
		var bcost := building_cost(pl.tech)
		var can: bool = pl.res_tech >= bcost or (overdue and pl.gold - 0.5 * pl.res_items >= bcost)
		if can and pl.gold >= bcost and buy_building(pl, pl.tech) == "ok":
			var rest: float = bcost - minf(pl.res_tech, float(bcost))
			pl.res_tech = maxf(0.0, pl.res_tech - bcost)
			var from_bank := minf(pl.res_bank, rest)
			pl.res_bank -= from_bank
			rest -= from_bank
			var from_core := minf(pl.res_core, rest)
			pl.res_core -= from_core
			rest -= from_core
			pl.res_items = maxf(0.0, pl.res_items - rest)
			return
	# AI heroes shop like players: they walk to the Armory (or shop while dead or at the fountain)
	var at_shop: bool = near_shop(hc)
	var wants := false
	# potions come out of the sending money, so they don't eat the item savings
	if pl.diff >= 1 and hc.potions < 2 and pl.gold - pl.res_items - pl.res_tech - pl.res_bank - pl.res_core >= POTION_COST * 2 and round_no >= 2:
		if at_shop:
			buy_potion(pl)
		else:
			wants = true
	var shop_res := ai_shop(pl)
	if shop_res == "bought":
		return
	if shop_res == "walk":
		wants = true
	# with the build done, the item share goes on scrolls; while saving up, whatever the purse holds
	# beyond the next piece does (bought wherever items can be: at the Armory, the fountain or while dead)
	if round_no >= 4 and shop_res != "walk":
		var prefs: Array = AI_SCROLLS.get(hc.def["role"], ["s_hp", "s_dmg"])
		var sid: String = prefs[rng.randi() % prefs.size()]
		var sc := scroll_cost(hc, sid)
		var spare: float = pl.res_items - (0.0 if shop_res == "none" else float(ai_next_price(pl)))
		if spare >= sc and pl.gold >= sc:
			if at_shop:
				if buy_scroll(pl, sid) == "ok":
					pl.res_items -= sc
					return
			else:
				wants = true
	hc.want_shop = wants and not (duel_on and hc.ar == duel_ar)
	var spend: float = pl.gold - pl.res_items - pl.res_tech - pl.res_bank - pl.res_core
	if overdue:
		spend *= AI_OVERDUE_SEND   # a building is due: most of the free gold waits for it, a little keeps income growing
	# Hard and Brutal AI send in one burst just before the wave
	var batch := false
	if pl.diff >= 2 and round_no >= 3:
		if round_t < round_len - 7.0:
			return
		batch = true
	if income_per_round and not batch and not (final_round > 0 and round_no > final_round - AI_BANK_RUNDOWN):
		pl.ai_allow = minf(pl.ai_allow, maxf(0.0, spend))
		spend = minf(spend, pl.ai_allow)
	if pl.tech == 0:
		return
	# 0.18 (no send income cap, sends tiered by rate): pick from the two newest buildings. A quiet road favours
	# the pricier sends, which earn the better rate (weight cost^0.75); a pressured road (many monsters on it, or
	# a hurt crystal) favours the cheap ones, which carry more pressure per gold and don't lock the money up
	# (weight 1/sqrt(cost)). The released sending money is small per tick, so the bot picks a target it could
	# afford with about half a round of income and waits until the money covers it; power sends join the pick
	# only after round AI_POWER_FREE_FROM or once two sends have gone out this round (ai_send_ok rolls the rest).
	var horizon: float = spend if batch else maxf(spend, AI_SEND_HORIZON * float(pl.income))
	var power_ok: bool = round_no >= AI_POWER_FREE_FROM or pl.round_sends >= 2 or ai_finishing(pl)
	var pressured := road_pressured(pl.team)
	if pl.ai_target >= 0 and (batch or not send_unlocked(pl, pl.ai_target) or send_cost(pl.ai_target, pl.team) > horizon or not send_income_ok(pl, pl.ai_target)):
		pl.ai_target = -1
	var cands: Array = []
	for k in GameData.SENDS.size():
		var b := int(GameData.SENDS[k]["b"])
		if b < pl.tech and b >= pl.tech - 2 and send_cost(k, pl.team) <= horizon and send_income_ok(pl, k) and (send_inc(k) >= 0 or (power_ok and ai_send_ok(pl, k))):
			cands.append(k)
	if cands.is_empty():
		for k in GameData.SENDS.size():
			if send_unlocked(pl, k) and send_cost(k, pl.team) <= horizon and send_income_ok(pl, k) and (send_inc(k) >= 0 or (power_ok and ai_send_ok(pl, k))):
				cands.append(k)
	if cands.is_empty():
		return
	var weights: Array = []
	var total := 0.0
	for k in cands:
		var c := float(send_cost(k, pl.team))
		var w := (1.0 / sqrt(c) if pressured else pow(c, 0.75)) * (counter_weight(pl, k) if pl.diff >= 1 else 1.0)
		weights.append(w)
		total += w
	var picks := 10 if batch else 1
	while picks > 0 and spend > 0:
		picks -= 1
		var pick: int = pl.ai_target
		if pick < 0:
			var roll := rng.randf() * total
			pick = cands[cands.size() - 1]
			for i in cands.size():
				roll -= weights[i]
				if roll <= 0:
					pick = cands[i]
					break
		var cost := send_cost(pick, pl.team)
		if cost > spend:
			if not batch:
				pl.ai_target = pick   # save up for it
			break
		pl.ai_target = -1
		if not do_send(pl, pick, pick_lane(pl)):
			break
		spend -= cost
		pl.ai_allow = maxf(0.0, pl.ai_allow - float(cost))
	if batch:
		pl.send_t = 0.8


# Bot sending (0.18): the share of a round's income a bot will save its released sending money up to for one send.
const AI_SEND_HORIZON := 0.5
# A team's road counts as pressured for the bots' send pick when this many monsters (camps aside) are on it, or
# its crystal is under half.
const AI_PRESSURE_MONS := 12


# 0.25 (80 starting income): the round by which a bot of each skill tier wants its next building (index = buildings
# owned). Before it the building purse saves at its usual share; from it the building is bought from any purse as
# soon as the gold is there, and only AI_OVERDUE_SEND of the free gold goes on sends meanwhile. Hard skirmish bots
# (tier 4) hold five buildings by round 20; the campaign's legacy economy (ai_send_legacy) doesn't read this.
const AI_TECH_ROUND := [
	[0, 8, 15, 24, 34, 48], [0, 6, 12, 19, 28, 40], [0, 5, 10, 16, 25, 36],
	[0, 4, 8, 12, 16, 24], [0, 3, 6, 9, 11, 18], [0, 2, 4, 6, 9, 14],
]
const AI_OVERDUE_SEND := 0.5
const AI_ITEM_TIER_K := [1.3, 1.3, 1.3, 1.15, 1.0, 1.0]   # item share multiplier per tier: Easy (tier 2) and Normal (3) send more gently


func ai_tech_overdue(pl) -> bool:
	if pl.tech >= mini(NB, int(max_tech[pl.team])):
		return false
	return round_no >= int(AI_TECH_ROUND[clampi(pl.diff, 0, AI_TECH_ROUND.size() - 1)][pl.tech])


# 0.25: a bot treats the Void Rift's income-costing sends as finishers: freely when the enemy crystal is low or
# the last waves are near (ai_send_ok lets them take a bigger bite of its income then), otherwise only late.
func ai_finishing(pl) -> bool:
	if not ai_econ_v2:
		return false
	var foe = arenas[1 - pl.team]
	return foe.core_hp < 0.4 * foe.core_max or (final_round > 0 and round_no >= final_round - 6)


func road_pressured(team: int) -> bool:
	var ar = arenas[team]
	if ar.core_hp < 0.5 * ar.core_max:
		return true
	var n := 0
	for m in ar.mons:
		if not m.dead and not m.d.get("camp", false):
			n += 1
			if n >= AI_PRESSURE_MONS:
				return true
	return false


# The campaign's AI economy, which its chapters are balanced around: items and crystal shares, the rest on sends.
func ai_send_legacy(pl, dt: float) -> void:
	# part of every income tick is set aside for hero items and crystal upgrades (see step)
	var ar = arenas[pl.team]
	# never hold back more than the next item piece and the next crystal upgrade cost
	var np := ai_next_price(pl)
	pl.res_items = minf(pl.res_items, minf(pl.gold, float(np if np > 0 else 450)))
	pl.res_core = minf(pl.res_core, minf(pl.gold - pl.res_items, float(core_cost(ar, maxi(0, _cheapest_core(ar))))))
	var core_frac: float = ar.core_hp / ar.core_max
	if round_no >= 2:
		var k := 0 if core_frac < 0.5 and ar.core_lv[0] <= ar.core_lv[1] + 2 else _cheapest_core(ar)
		if k >= 0 and ar.core_lv[k] < GameData.CORE_MAX_LV:
			var cc := core_cost(ar, k)
			if pl.res_core >= cc or (core_frac < 0.35 and pl.gold >= cc):
				if buy_core(pl, k) == "ok":
					pl.res_core = maxf(0.0, pl.res_core - cc)
					return
	# AI heroes shop like players: they walk to the Armory (or shop while dead or at the fountain)
	var hc = pl.champ
	var at_shop: bool = near_shop(hc)
	var wants := false
	if pl.diff >= 1 and hc.potions < 2 and pl.gold - pl.res_items >= POTION_COST * 2 and round_no >= 2:
		if at_shop:
			buy_potion(pl)
		else:
			wants = true
	var shop_res := ai_shop(pl)
	if shop_res == "bought":
		return
	if shop_res == "walk":
		wants = true
	# with the build done (or saving up), spare item money goes on scrolls now and then
	if round_no >= 4 and (shop_res == "none" or (pl.gold > 1500 and rng.randf() < 0.2)):
		var prefs: Array = AI_SCROLLS.get(hc.def["role"], ["s_hp", "s_dmg"])
		var sid: String = prefs[rng.randi() % prefs.size()]
		var sc := scroll_cost(hc, sid)
		if pl.res_items >= sc or pl.gold > 1500:
			if at_shop:
				if buy_scroll(pl, sid) == "ok":
					pl.res_items -= sc
					return
			else:
				wants = true
	hc.want_shop = wants and not (duel_on and hc.ar == duel_ar)
	var spend: float = pl.gold - pl.res_items - pl.res_core
	# Hard and Brutal AI bank gold for interest and send in one burst just before the wave
	var batch := false
	if pl.diff >= 2 and round_no >= 3:
		spend -= ai_bank(pl)
		if round_t < round_len - 7.0:
			if pl.tech >= mini(NB, int(max_tech[pl.team])) or round_no < AI_BUILD_ROUND[mini(pl.tech, NB - 1)]:
				return
		else:
			batch = true
	if pl.tech < mini(NB, int(max_tech[pl.team])) and round_no >= AI_BUILD_ROUND[pl.tech] and (pl.tech < 5 or pl.diff >= 1):
		# buildings come first: they may use the item and crystal savings too
		if pl.gold >= building_cost(pl.tech):
			buy_building(pl, pl.tech)
			pl.res_items = minf(pl.res_items, pl.gold)
			pl.res_core = minf(pl.res_core, pl.gold - pl.res_items)
			return
		# save up for the building, but keep sending small packs so income still grows
		if rng.randf() < 0.6:
			return
		spend = minf(spend, pl.gold * 0.2)
	if pl.tech == 0:
		return
	# pick from the two newest buildings, favouring pricier sends when there is gold to spare
	var cands: Array = []
	for k in GameData.SENDS.size():
		var b := int(GameData.SENDS[k]["b"])
		if b < pl.tech and b >= pl.tech - 2 and send_cost(k, pl.team) <= spend and ai_send_ok(pl, k) and send_income_ok(pl, k):
			cands.append(k)
	if cands.is_empty():
		for k in GameData.SENDS.size():
			if send_unlocked(pl, k) and send_cost(k, pl.team) <= spend and ai_send_ok(pl, k) and send_income_ok(pl, k):
				cands.append(k)
	if cands.is_empty():
		return
	var weights: Array = []
	var total := 0.0
	for k in cands:
		var w := sqrt(float(send_cost(k, pl.team))) * (counter_weight(pl, k) if pl.diff >= 1 else 1.0)
		weights.append(w)
		total += w
	var picks := 10 if batch else 1
	while picks > 0 and spend > 0:
		picks -= 1
		var roll := rng.randf() * total
		var pick: int = cands[cands.size() - 1]
		for i in cands.size():
			roll -= weights[i]
			if roll <= 0:
				pick = cands[i]
				break
		var cost := send_cost(pick, pl.team)
		if cost > spend or not do_send(pl, pick, pick_lane(pl)):
			break
		spend -= cost
		pl.ai_allow = maxf(0.0, pl.ai_allow - float(cost))
	if batch:
		pl.send_t = 0.8


# How well a send suits the enemy heroes: armour and evasion against attackers, tough or
# self-healing monsters against spellcasters, crowd-control immunity against stunners.
func counter_weight(pl, k: int) -> float:
	var mon: Dictionary = GameData.MON[GameData.SENDS[k]["k"]]
	var physical := 0
	var casters := 0
	for o in players:
		if o.team == pl.team or o.absent:
			continue
		var role: String = o.champ.def["role"]
		if role in ["Marksman", "Assassin", "Fighter"]:
			physical += 1
		elif role in ["Mage", "Support", "Engineer"]:
			casters += 1
	var w := 1.0
	if float(mon.get("armor", 0.0)) >= 0.2:
		w *= 1.0 + 0.2 * physical
	if float(mon.get("evasion", 0.0)) > 0.0:
		w *= 1.0 + 0.25 * physical
	if mon.has("heal") or float(mon.get("regen", 0.0)) > 0.0 or mon.has("ward"):
		w *= 1.0 + 0.2 * casters
	if mon.get("cci", false) or float(mon.get("ten", 1.0)) < 1.0:
		w *= 1.0 + 0.15 * casters
	return w


# Send into the lane whose defence is weaker (dead, or lower level), with some randomness. Homes 0 and 1
# guard the north and south roads; homes 2 and 3 (the confluence and the crystal) cover both, so in
# 1v1 and 2v2, where every hero stands on the shared road, the lanes tie and the pick is random.
func pick_lane(pl) -> int:
	if pl.diff == 0 or rng.randf() < 0.4:
		return rng.randi() % 2
	var foe_ar = arenas[1 - pl.team]
	var score := [0.0, 0.0]
	for c in foe_ar.champs:
		var s: float = 0.0 if c.dead else float(c.lvl) * c.hp / maxf(1.0, c.max_hp)
		if c.home <= 1:
			score[c.home] += s
		else:
			score[0] += s * 0.5
			score[1] += s * 0.5
	if absf(score[0] - score[1]) < 0.01:
		return rng.randi() % 2
	return 0 if score[0] < score[1] else 1


# How the AI splits what it earns: sends (whatever is left), buildings, items and the bank.
const AI_SHARE := 0.25         # the next building's share (0.25: 0.30 -> 0.25, the schedule AI_TECH_ROUND does the timing; Tune "ai_share_build")
const AI_ITEM_K := 0.33        # hero items (and scrolls once the build is done): the hero must out-grow the wave curve (0.25: 0.38 -> 0.33)
const AI_BANK_K := 0.05        # the bank, until it holds the interest cap (0.25: 0.08 -> 0.05; the rest is sending money)
const AI_ITEM_SHARE := 0.3     # legacy (campaign) economy
const AI_CORE_SHARE := 0.12    # legacy (campaign) economy
const AI_CORE_K := 0.08        # classic: the crystal purse's share once the bank is full


func ai_reserve(pl, g: float, payout := false) -> void:
	var tech_open: bool = pl.tech < mini(NB, int(max_tech[pl.team]))
	# the hero's items keep it ahead of the wave curve, so they take the biggest share; the bank is a cushion
	var items_k := tv("ai_item_k") if tech_open else tv("ai_item_k") * 1.3
	var bank_k := tv("ai_bank_k") if tech_open else tv("ai_bank_k") * 1.5
	var build_k := tv("ai_share_build")
	items_k *= AI_ITEM_TIER_K[clampi(pl.diff, 0, AI_ITEM_TIER_K.size() - 1)]   # 0.25: Easy and Normal keep more for the hero
	if tech_open and ai_tech_overdue(pl):
		# 0.25: a building is due: it takes the bank's share and a third of the items' until it stands
		build_k += bank_k + items_k * 0.33
		items_k *= 0.67
		bank_k = 0.0
	pl.res_items += g * items_k
	if not payout and income_per_round:
		pl.ai_allow += g * maxf(0.0, 1.0 - items_k - bank_k - build_k)   # 0.25: a kill's sending share is spendable at once
	# the bank only holds what earns interest; once it is full, a slice of that share keeps the crystal
	# growing and the rest is sending money (sends out-earn the bank by a wide margin)
	if pl.res_bank < ai_bank_cap(pl):
		pl.res_bank += g * bank_k
	elif round_no >= AI_CORE_FROM:
		pl.res_core += g * AI_CORE_K
	# the building purse saves for the next building, except late in a match that goes the distance, when
	# a building it is nowhere near affording would only end up as idle gold
	var late: bool = final_round > 0 and round_no > final_round - AI_BANK_RUNDOWN
	if tech_open and not (late and pl.res_tech < 0.6 * building_cost(pl.tech)):
		pl.res_tech += g * build_k
	else:
		pl.res_tech = 0.0


# How much the AI keeps in the bank: the interest cap, run down over the last rounds before the final wave
# so a match that goes the distance doesn't end with every bot sitting on a full bank.
const AI_CORE_FROM := 6
const AI_BANK_RUNDOWN := 8   # rounds before the final wave over which the bank is spent down


func ai_bank_cap(pl) -> float:
	var cap := interest_cap_for(pl)
	if final_round > 0 and round_no > final_round - AI_BANK_RUNDOWN:
		# 0.25: empty by the round before the last wave (sends bought during the last round never spawn)
		cap *= float(maxi(0, final_round - 1 - round_no)) / float(AI_BANK_RUNDOWN - 1)
	return cap


# Reserves can never add up to more gold than the AI has (sends, buys and buy-backs spend from the pot),
# and the item purse never holds more than the next piece plus a few scrolls (or, once the build is done,
# the next scroll), so sends aren't starved.
const AI_ITEM_SLACK := 400.0


func ai_fit_reserves(pl) -> void:
	var np := ai_next_price(pl)
	var slack := AI_ITEM_SLACK
	if np <= 0:
		var hc = pl.champ
		for sid in AI_SCROLLS.get(hc.def["role"], ["s_hp", "s_dmg"]):
			slack = maxf(slack, 1.25 * float(scroll_cost(hc, sid)))
	# 0.25: in the last two rounds before the final wave the item purse holds only what it can still buy and the
	# crystal purse nothing a healthy crystal doesn't need: the rest goes on the sends that decide the match
	var last_rounds: bool = final_round > 0 and round_no >= final_round - 2
	pl.res_items = minf(pl.res_items, float(np) + (0.0 if last_rounds else slack))
	var ck := _cheapest_core(arenas[pl.team])
	pl.res_core = minf(pl.res_core, float(core_cost(arenas[pl.team], ck)) if ck >= 0 else 0.0)
	if last_rounds and arenas[pl.team].core_hp >= 0.5 * arenas[pl.team].core_max:
		pl.res_core = 0.0
	var tot: float = pl.res_items + pl.res_tech + pl.res_bank + pl.res_core
	if tot > pl.gold and tot > 0.0:
		var k: float = maxf(0.0, pl.gold) / tot
		pl.res_items *= k
		pl.res_tech *= k
		pl.res_bank *= k
		pl.res_core *= k
const NB := 6   # monster buildings


# AI players only buy power sends (which cost income) when they can afford the loss, and not every time:
# never more than AI_POWER_CUT of their income in one go, and more readily once the game is past its middle.
const AI_POWER_CUT := 0.2
const AI_POWER_FREE_FROM := 30


func ai_send_ok(pl, k: int) -> bool:
	var inc := send_inc(k)
	if inc >= 0:
		return true
	var finishing := ai_finishing(pl)   # 0.25: finishers may cost up to half the income, and go out most of the time
	if pl.income + inc < (30.0 * INC_UNIT if income_per_round else 30.0) or -inc > pl.income * AI_POWER_CUT * (2.5 if finishing else 1.0):
		return false
	# income first: before round AI_POWER_FREE_FROM a bot spends income on power only once it has spent
	# this round's sending money on income sends (0.18: no cap; ai_send only offers power sends then)
	return rng.randf() < (0.75 if finishing else (0.5 if round_no >= 25 else 0.2))


func _cheapest_core(ar) -> int:
	var best := -1
	for k in GameData.CORE_UPS.size():
		if ar.core_lv[k] < GameData.CORE_MAX_LV and (best < 0 or core_cost(ar, k) < core_cost(ar, best)):
			best = k
	return best


static func building_cost(k: int) -> int:
	return int(GameData.BUILDINGS[k]["cost"])


static func send_unlocked(pl, k: int) -> bool:
	return int(GameData.SENDS[k]["b"]) < pl.tech


# Buildings must be bought in order; each one unlocks the next tier of sends.
func buy_building(pl, k: int) -> String:
	if over:
		return "over"
	if k < pl.tech:
		return "owned"
	if k > pl.tech:
		return "locked"
	if k >= int(max_tech[pl.team]):
		return "sealed"
	if pl.gold < building_cost(k):
		return "gold"
	pl.gold -= building_cost(k)
	pl.tech += 1
	if pl.human:
		add_text(arenas[pl.team], pl.champ.p + Vector2(0, -40), "%s built" % GameData.BUILDINGS[k]["name"], Color("#ffd24a"), 1.6, 13)
	feed.push_front({"t": t, "team": pl.team, "who": pl.name, "built": GameData.BUILDINGS[k]["name"]})
	if feed.size() > 12:
		feed.resize(12)
	return "ok"


# The income a send gives (or costs) if bought now, in this mode's unit (the table is per round; the 10 s
# modes divide by INC_UNIT, which gives back the 0.15 values): Void Rift power sends cost more the later they come.
func send_inc(k: int) -> int:
	var s: Dictionary = GameData.SENDS[k]
	tune_bind()
	var inc := Tune.send_inc(k, Tune.active)   # the table, or the tuned curve
	if not income_per_round:
		# 0.18: the per-round table is small at the cheap end (+1 a round); the 10 s modes still get at least +1 a tick
		inc = maxi(1, roundi(float(inc) / INC_UNIT)) if inc > 0 else roundi(float(inc) / INC_UNIT)
	if inc < 0 and int(s["b"]) == NB - 1 and round_no > VOID_POWER_INC_FROM:
		inc = -roundi(float(-inc) * (1.0 + VOID_POWER_INC_ROUND * (round_no - VOID_POWER_INC_FROM)))
	return inc


# Power sends lower income: they can't take it below min_income() (GameData.MIN_INCOME a round).
func send_income_ok(pl, k: int) -> bool:
	var inc := send_inc(k)
	return inc >= 0 or pl.income + inc >= min_income()


# The send's income as a share of its price per round (0.18: 3 % for the cheapest send, 6 % for the dearest;
# power sends return a negative share).
func send_rate(k: int, team := 0) -> float:
	return float(send_inc(k)) / maxf(1.0, float(send_cost(k, team)))


# Income of one team per round (the sum of its players'), for the scoreboard graph.
func team_income(team: int) -> int:
	var inc := 0
	for pl in players:
		if pl.team == team:
			inc += pl.income
	return inc


# Why a send can't be bought right now, in the player's words ("" when it can; gold is checked separately).
func send_refusal(pl, k: int) -> String:
	if not send_unlocked(pl, k):
		return "Build the %s first." % GameData.BUILDINGS[int(GameData.SENDS[k]["b"])]["name"]
	var inc := send_inc(k)
	if inc < 0 and pl.income + inc < min_income():
		if pl.income <= min_income():
			return "Your income is at the minimum (%d): send income sends first, power sends cost income." % min_income()
		return "Your income is too low: this power send costs %d income and it can't go below %d." % [-inc, min_income()]
	return ""


# Sends are paid for (and raise income) immediately, but the monsters wait for the next wave.
func do_send(pl, k: int, lane: int) -> bool:
	var s: Dictionary = GameData.SENDS[k]
	var cost := send_cost(k, pl.team)
	if pl.gold < cost or over or not send_unlocked(pl, k) or mode == "survival" or not send_income_ok(pl, k):
		return false
	var inc := send_inc(k)
	pl.gold -= cost
	pl.income += inc
	pl.sent += cost
	pl.gold_sent += cost
	pl.round_gold_sent += cost
	pl.sends += 1
	pl.round_sends += 1
	pl.send_n[s["k"]] = int(pl.send_n.get(s["k"], 0)) + int(s["n"])
	var ar = arenas[1 - pl.team]
	send_no += 1
	for i in int(s["n"]):
		# [kind, lane, sender, send index, cost, batch id, income given] (the last four let "unsend" take it back)
		ar.queued.append([s["k"], lane, pl, k, cost, send_no, inc])
	if int(s["cost"]) >= 120 or pl.human:
		feed.push_front({"t": t, "team": pl.team, "who": pl.name, "what": s["name"], "lane": lane})
		if feed.size() > 12:
			feed.resize(12)
	return true


var send_no := 0   # numbers every send, so "unsend" can find the whole batch of one purchase


# Takes back the player's most recent send into `lane` this round: the monsters leave the queue, the
# gold comes back and the income it gave is undone. Returns false when nothing of theirs is queued there.
func unsend(pl, lane: int) -> bool:
	if over or mode == "survival":
		return false
	var ar = arenas[1 - pl.team]
	var last: Array = []
	for q in ar.queued:
		if q[2] == pl and int(q[1]) == lane and q.size() >= 6 and (last.is_empty() or int(q[5]) > int(last[5])):
			last = q
	if last.is_empty():
		return false
	var k := int(last[3])
	var cost := int(last[4])
	var s: Dictionary = GameData.SENDS[k]
	var batch := int(last[5])
	var inc: int = int(last[6]) if last.size() > 6 else send_inc(k)
	# taking back an income send can't drop income below the floor (power sends bought since relied on it)
	if inc > 0 and pl.income - inc < min_income():
		return false
	ar.queued = ar.queued.filter(func(q): return not (q.size() >= 6 and int(q[5]) == batch))
	pl.gold += cost
	pl.income -= inc
	pl.sent -= cost
	pl.gold_sent -= cost
	pl.round_gold_sent -= cost
	pl.sends -= 1
	pl.round_sends -= 1
	pl.send_n[s["k"]] = maxi(0, int(pl.send_n.get(s["k"], 0)) - int(s["n"]))
	ev("unsend", arenas[pl.team], Vector2.ZERO, {"send": k, "lane": lane, "gold": cost, "human": pl.id == local})
	return true


# Count of monsters queued into an arena, optionally only those from one player.
func queued_count(arena_i: int, from = null) -> int:
	var n := 0
	for q in arenas[arena_i].queued:
		if from == null or q[2] == from:
			n += 1
	return n


static func wave_list(r: int) -> Array:
	var out: Array = []
	var slingers := 0 if r < 3 else 1 + (r - 3) / 3
	for i in 6 + int(r * 1.0) - slingers:
		out.append("kobold")
	for i in slingers:
		out.append("slinger")
	if r >= 7 and r % 2 == 1:
		for i in 1 + (r - 7) / 6:
			out.append("archer")
	if r >= 2:
		for i in (r + 1) / 3:
			out.append("wolf")
	if r >= 4:
		for i in (r - 1) / 4:
			out.append("ogre")
	if r >= 6 and r % 3 == 0:
		for i in 2 + r / 6:
			out.append("bat")
	if r >= 8 and r % 2 == 0:
		out.append("shaman")
	if r >= 9:
		for i in (r - 6) / 4:
			out.append("skeleton")
	if r >= 12 and r % 3 == 1:
		out.append("gargoyle")
	if r % 10 == 0:
		out.append("golem")
	return out


var last_wave_sent := [0, 0]


# A new wave: the round's monsters plus everything the other team queued, released in a column per rift.
const BOSSES := ["boss_brood", "boss_warden", "boss_magmaw", "boss_wyrm", "boss_lich"]
# Survival past round 25 also draws on the campaign's bosses. Each one's tricks (spawners, auras,
# splits, blinks, totems, dives, ranged volleys) are plain monster traits, so they work on any road.
# Their health is scaled to the classic bosses' range so a rotation slot stays a comparable fight.
const LATE_BOSSES := ["boss_ashmaw", "boss_choirmaster", "echo_warden", "boss_herald", "echo_brood", "boss_rime_colossus",
	"echo_wyrm", "boss_cinder_colossus", "echo_magmaw", "devourer_boss", "boss_hollow_king"]
const LATE_BOSS_FROM := 25
# Boss rounds send the boss down both rifts at once. Each of the pair's share of a single boss's health
# and crystal damage, by team size (index 1..4), and in Survival, where one hero holds both roads.
const PAIR_BOSS_K := [0.0, 0.55, 0.65, 0.7, 0.75]
const PAIR_BOSS_SURV := 0.55
const LATE_BOSS_HP := 16000.0   # late bosses are scaled as if they had this much base health
const ENDGAME_HP_K := 0.09      # wave health grows by this much per endgame round (was x1.22 compounding)
const ENDGAME_BOSS_K := 0.1     # boss health likewise


# Interest on banked gold, paid at the start of every wave. In classic matches it is a cushion, not an
# engine: 4 % on gold up to one round of the player's own income (0.15: was 6 % on 400 + 80 x round,
# which out-earned sends below the cap and held 3-4k per player idle at the end). Survival keeps the old terms.
# 0.17: unchanged in effect. It was already paid once a round (with the wave), and "one round of income" is
# now simply the income number; it is paid before the round's income lands, on what the player held.
const INTEREST_RATE := 0.04
const INTEREST_RATE_SURV := 0.06
const INTEREST_CAP_MIN := 300.0
const INTEREST_CAP_ROUNDS := 1.0   # the cap, in rounds of income
static func interest_cap(r: int) -> float:
	return 400.0 + 80.0 * r


func interest_rate() -> float:
	return INTEREST_RATE_SURV if mode == "survival" else tv("interest_rate") / 100.0


# How much of this player's gold earns interest.
func interest_cap_for(pl) -> float:
	if mode == "survival":
		return interest_cap(round_no + 1)
	return maxf(tv("interest_cap_min"), tv("interest_cap_rounds") * float(pl.income) * (1.0 if income_per_round else round_len / income_every))


func interest_for(pl) -> int:
	return floori(minf(pl.gold, interest_cap_for(pl)) * interest_rate())


func pay_interest() -> void:
	for pl in players:
		if pl.absent:
			continue
		var g := floori(minf(pl.gold, interest_cap_for(pl)) * interest_rate())
		if g <= 0:
			continue
		give_gold(pl, g)
		pl.interest += g
		if pl.human and pl.champ.ar != null:
			add_text(pl.champ.ar, pl.champ.p + Vector2(0, -52), "+%d interest" % g, Color("#ffe066"), 1.4, 13)
			ev("interest", pl.champ.ar, pl.champ.p, {"gold": g})


# Which boss (if any) the wave of round `r` brings: {name, kind, lanes} or {} (mirrors spawn_wave's choice,
# without side effects, for the "boss_warn" cue).
func boss_preview(r: int) -> Dictionary:
	if not auto_bosses:
		return {}
	var boss_every := 5 if mode == "survival" else 10
	var endgame_boss := final_round > 0 and r >= ENDGAME_FROM
	if not ((r >= boss_every and r % boss_every == 0) or endgame_boss):
		return {}
	var bn := maxi(1, r / boss_every) if not endgame_boss else r - ENDGAME_FROM + 1
	var pool: Array = BOSSES + LATE_BOSSES if mode == "survival" and r > LATE_BOSS_FROM else BOSSES
	var kinds: Array = [pool[(bn - 1) % pool.size()]]
	var pair := false
	if final_round > 0 and r >= final_round:
		kinds = BOSSES.duplicate()
	elif mode == "survival" and r >= 50 and r % 10 == 0:
		var extra: String = LATE_BOSSES[(bn / 2) % LATE_BOSSES.size()]
		if extra == kinds[0]:
			extra = LATE_BOSSES[(bn / 2 + 1) % LATE_BOSSES.size()]
		kinds.append(extra)
	else:
		kinds.append(kinds[0])
		pair = true
	return {"name": GameData.MON[kinds[0]]["name"] if kinds.size() == 1 or pair else "Every boss at once", "kind": kinds[0], "lanes": 2 if pair else 1}


func spawn_wave() -> void:
	pay_interest()
	var list := wave_list(round_no)
	if wave_fn.is_valid():
		list = wave_fn.call(round_no)
	var hm := hp_mult(round_no) * wave_scale
	if wave_keep < 0.999 or wave_keep > 1.001:
		# campaign: thin the wave (below 1) or, since 0.23, thicken it (above 1: every so often a monster comes twice)
		var kept: Array = []
		var acc := 0.0
		for k in list:
			acc += wave_keep
			var first := true
			while acc >= 1.0:
				acc -= 1.0
				if first or not String(k).begins_with("boss"):
					kept.append(k)
				first = false
		list = kept
	var boss_every := 10
	var boss_hm := hm
	if final_round > 0 and round_no >= ENDGAME_FROM and not list.is_empty():
		# the endgame: every round tougher and bigger than the last (a steep line, not a runaway power),
		# and the last wave is the wall: twice as tough again, half as big again, and every boss at once
		var e := round_no - ENDGAME_FROM + 1
		boss_hm = hm * (1.0 + ENDGAME_BOSS_K * e)
		hm *= 1.0 + ENDGAME_HP_K * e
		var base := list.duplicate()
		for i in int(base.size() * 0.06 * e):
			list.append(base[i % base.size()])
		if round_no >= final_round:
			hm *= 2.0
			boss_hm *= 1.5
			list += list.slice(0, list.size() / 2)
			final_t = FINAL_SAFETY
			ev("final_wave", null, Vector2.ZERO, {})
		elif round_no == ENDGAME_FROM:
			ev("endgame", null, Vector2.ZERO, {})
	if mode == "survival":
		# one hero holds both rifts: smaller waves that keep getting tougher, and a boss every 5th round
		var half: Array = []
		for i in list.size():
			if i % 2 == 0 or round_no > 8:
				half.append(list[i])
		list = half
		if omens.has("swarm"):
			for i in range(0, half.size(), 4):
				list.append(half[i])
		if omens.has("sky"):
			for i in 2 + round_no / 5:
				list.append("bat")
			if round_no >= 8:
				list.append("gargoyle")
		if omens.has("archers"):
			for i in 2 + round_no / 6:
				list.append("slinger")
			for i in 1 + round_no / 8:
				list.append("archer")
		var r := float(round_no - 1)
		hm = 0.6 * (1.0 + 0.13 * r + 0.011 * r * r) * [0.9, 1.15, 1.4, 1.7][difficulty]
		if omens.has("iron"):
			hm *= 1.2
		boss_every = 5
		if round_no >= SurvivalData.OMEN_EVERY and round_no % SurvivalData.OMEN_EVERY == 0:
			add_omen()
		if round_no >= 2:
			queue_cards("")
	elif team_size < 4:
		# fewer defenders: thinner, softer waves (1v1 keeps a quarter, 2v2 half: the same load per hero as 4v4)
		var kept: Array = []
		for i in list.size():
			if (team_size == 1 and i % 4 == 0) or (team_size == 2 and i % 2 == 0):
				kept.append(list[i])
		list = kept
		hm *= 0.75 if team_size == 1 else 0.85
	ev("wave", null, Vector2.ZERO, {"round": round_no})
	var endgame_boss := final_round > 0 and round_no >= ENDGAME_FROM
	if auto_bosses and ((round_no >= boss_every and round_no % boss_every == 0) or endgame_boss):
		var bn := maxi(1, round_no / boss_every) if not endgame_boss else round_no - ENDGAME_FROM + 1
		# survival past round 25 rotates through the campaign's bosses as well (see LATE_BOSSES)
		var pool: Array = BOSSES + LATE_BOSSES if mode == "survival" and round_no > LATE_BOSS_FROM else BOSSES
		var kinds: Array = [pool[(bn - 1) % pool.size()]]
		var pair := false   # one boss marches down each rift
		if final_round > 0 and round_no >= final_round:
			kinds = BOSSES.duplicate()   # the last wave brings every boss at once
		elif mode == "survival" and round_no >= 50 and round_no % 10 == 0:
			# survival's round 50 (and every tenth after): a second, campaign boss walks the other road
			var extra: String = LATE_BOSSES[(bn / 2) % LATE_BOSSES.size()]
			if extra == kinds[0]:
				extra = LATE_BOSSES[(bn / 2 + 1) % LATE_BOSSES.size()]
			kinds.append(extra)
		else:
			# every boss round: the same boss comes down both rifts at once, one in each lane
			kinds.append(kinds[0])
			pair = true
		var cycle := (bn - 1) / BOSSES.size()
		var bhp: float = maxf(boss_hm * 0.7, 1.0 + 0.04 * round_no) * (1.0 + 0.3 * cycle) * (0.85 if mode == "survival" else [0.0, 0.55, 0.75, 0.9, 1.0][team_size])
		# two bosses at once: a full team splits two per rift and meets each at full strength, but a lone
		# survivor (or a thin team) has to hold both roads, so there each one brings a share of the health
		# and crystal damage (lives) of a single boss
		var pk: float = (PAIR_BOSS_SURV if mode == "survival" else PAIR_BOSS_K[team_size]) if pair else 1.0
		for ar in arenas:
			for ki in kinds.size():
				var lane := ki % 2 if pair else (bn + ki) % 2
				ar.spawn_q.append([t + 1.5 + (0.0 if pair else 2.0 * ki), kinds[ki], lane, null, bhp * pk, "", pk])
		ev("boss", null, Vector2.ZERO, {"name": GameData.MON[kinds[0]]["name"] if kinds.size() == 1 or pair else "Every boss at once", "kind": kinds[0], "lanes": 2 if pair else 1})
	for ai in arenas.size():
		var ar = arenas[ai]
		if ai == 1 and not enemy_present:
			continue
		var alist := list
		if ai == 1 and thin_enemy:
			# fewer enemy heroes on the field: fewer wave monsters on their road, so their stone holds as long as ours
			var present := 0
			for pl in players:
				if pl.team == 1 and not pl.absent:
					present += 1
			var keep := clampf(0.15 + 0.85 * float(present) / float(maxi(1, team_size)), 0.4, 1.0)
			if keep < 0.999:
				alist = []
				var acc2 := 0.0
				for k in list:
					acc2 += keep
					if acc2 >= 1.0:
						acc2 -= 1.0
						alist.append(k)
		var lane_t := [0.0, 0.0]
		var ech := SurvivalData.elite_chance(round_no, omens.has("champions")) if mode == "survival" else 0.0
		for i in alist.size():
			var lane := i % 2
			var affix := ""
			# elites come from the card generator, so a daily run's are the same for everyone
			if ech > 0.0 and card_rng.randf() < ech:
				var afs: Array = SurvivalData.AFFIXES.keys()
				affix = afs[card_rng.randi() % afs.size()]
			ar.spawn_q.append([t + lane_t[lane], alist[i], lane, null, hm, affix])
			lane_t[lane] += SPAWN_GAP
		var shm := hm * send_hp_k(round_no)   # sends are tougher than the wave (see SEND_HP_BASE)
		for q in ar.queued:
			ar.spawn_q.append([t + lane_t[q[1]], q[0], q[1], q[2], shm])
			lane_t[q[1]] += SPAWN_GAP * 0.8
		last_wave_sent[ai] = ar.queued.size()
		ar.queued = []


# ---------------------------------------------------------------- survival run
func make_elite(ar, m, affix: String) -> void:
	m.elite = affix
	m.hp *= SurvivalData.ELITE_HP
	m.max_hp = m.hp
	m.dps *= SurvivalData.ELITE_DMG
	m.dmg_k *= SurvivalData.ELITE_DMG
	m.r *= 1.25
	m.bounty *= SurvivalData.ELITE_GOLD
	m.xp *= 3.0
	m.lives += 1
	match affix:
		"swift":
			m.spd *= 1.35
		"armored":
			m.armor = minf(0.7, m.armor + 0.3)
		"regen":
			m.regen += 0.02


func add_omen() -> void:
	var left: Array = SurvivalData.OMENS.keys().filter(func(o): return not omens.has(o))
	if left.is_empty():
		return
	var o: String = left[card_rng.randi() % left.size()]
	omens.append(o)
	ev("omen", arenas[0], Vector2.ZERO, {"id": o})


func queue_boons(boss: bool) -> void:
	if boon_offer.is_empty():
		offer_boons(boss)
	else:
		boon_queue += 1


func offer_boons(boss: bool) -> void:
	var commons: Array = []
	var rares: Array = []
	for id in SurvivalData.BOONS:
		var b: Dictionary = SurvivalData.BOONS[id]
		if int(boons.get(id, 0)) >= int(b["max"]):
			continue
		if b["rarity"] == "rare":
			rares.append(id)
		else:
			commons.append(id)
	var out: Array = []
	for i in boon_choices:
		# drawn from the card generator: a daily run offers everyone the same boons for the same picks
		var want_rare := boss or card_rng.randf() < rare_chance
		var pool: Array = (rares if want_rare else commons).filter(func(x): return not out.has(x))
		if pool.is_empty():
			pool = (commons + rares).filter(func(x): return not out.has(x))
		if pool.is_empty():
			break
		out.append(pool[card_rng.randi() % pool.size()])
	boon_offer = out
	boon_boss = boss
	if not out.is_empty():
		ev("boon_offer", arenas[0], Vector2.ZERO, {"boss": boss})


func pick_boon(i: int) -> bool:
	if mode != "survival" or i < 0 or i >= boon_offer.size():
		return false
	var id: String = boon_offer[i]
	boon_offer = []
	apply_boon(players[0], id)
	if boon_queue > 0:
		boon_queue -= 1
		offer_boons(true)
	return true


# Survival talents (see TalentData): the effects of every talent the player has taken for this hero.
func apply_talents(pl, list: Array) -> void:
	talents = list.duplicate(true)
	var c = pl.champ
	var ar = arenas[pl.team]
	for fx in talents:
		for k in fx:
			var v = fx[k]
			match k:
				"pow":
					c.pow *= float(v)
				"hp":
					c.hp_base *= float(v)
				"as", "ms", "ls", "cdr", "armor", "crit", "regen", "onhit":
					_add_extra(c, k, float(v))
				"skill_dmg":
					for i in 4:
						c.skill_k[i] = float(c.skill_k[i]) * float(v[i])
				"skill_cd":
					for i in 4:
						c.cd_k[i] = float(c.cd_k[i]) * float(v[i])
				"gold":
					pl.gold += float(v)
					pl.earned += float(v)
					pl.gold_earned += float(v)
				"income":
					pl.income += int(v)
				"lives":
					surv_lives += int(v)
				"core":
					ar.core_max *= float(v)
					ar.core_hp = ar.core_max
				"core_regen":
					ar.regen_bonus += float(v)
				"potions":
					c.potions += int(v)
				"surv_gold":
					surv_gold += float(v)
				"surv_xp":
					surv_xp += float(v)
				"boon_choices":
					boon_choices = mini(SurvivalData.OFFER_SIZE + 1, boon_choices + int(v))
				"rare":
					rare_chance += float(v)
	c.max_hp = c.hp_base
	recalc_items(c)
	c.hp = c.max_hp


func _add_extra(c, k: String, v: float) -> void:
	c.extra[k] = float(c.extra.get(k, 0.0)) + v


func apply_boon(pl, id: String) -> void:
	boons[id] = int(boons.get(id, 0)) + 1
	var c = pl.champ
	var ar = arenas[pl.team]
	match id:
		"edge":
			c.pow *= 1.12
		"vigor":
			c.hp_base *= 1.18
		"haste":
			_add_extra(c, "as", 0.12)
		"stride":
			_add_extra(c, "ms", 0.08)
		"leech":
			_add_extra(c, "ls", 0.06)
		"focus":
			_add_extra(c, "cdr", 0.1)
		"plate":
			_add_extra(c, "armor", 0.08)
		"greed":
			surv_gold += 0.3
		"mason":
			ar.core_max *= 1.25
			ar.core_hp = ar.core_max
		"scholar":
			surv_xp += 0.35
		"fury":
			c.pow *= 1.3
			c.hp_base *= 0.85
		"heart":
			c.hp_base *= 1.25
			_add_extra(c, "regen", 12.0)
		"storm":
			_add_extra(c, "onhit", 25.0)
		"crit":
			_add_extra(c, "crit", 0.12)
		"giant":
			c.hp_base *= 1.4
			c.pow *= 1.1
		"renew":
			_add_extra(c, "regen", 14.0)
		"bounty":
			pl.income += 6
			give_gold(pl, 250.0)
	recalc_items(c)
	if not c.dead:
		add_text(ar, c.p + Vector2(0, -56), String(SurvivalData.BOONS[id]["name"]).to_upper(), Color("#ffd86a"), 1.6, 14)
	ev("boon", ar, c.p, {"id": id})


# ---- survival cards: abilities, passives and items are drafted, not owned from the start
const EMPTY_SKILL := {"name": "Empty", "cd": 1, "empty": true, "acts": [], "desc": "No ability yet. Ability cards at the end of a round fill this slot."}
const NO_PASSIVE := {"name": "No passive", "t": "none", "desc": "No passive yet. A passive card at the end of a round fills it."}
const SLOT_KEYS := ["Q", "W", "E", "R"]


func surv_strip(c) -> void:
	var d: Dictionary = c.def.duplicate(true)
	var hm := float(d["passive"].get("hpMult", 1.0))
	d["skills"] = []
	for i in 4:
		var e: Dictionary = EMPTY_SKILL.duplicate(true)
		e["name"] = "Empty %s slot" % SLOT_KEYS[i]
		d["skills"].append(e)
	d["passive"] = NO_PASSIVE.duplicate(true)
	c.def = d
	c.ranks = [0, 0, 0, 0]
	c.hp_base /= hm
	c.max_hp = c.hp_base
	recalc_items(c)
	c.hp = c.max_hp


func queue_cards(kind: String) -> void:
	if card_offer.is_empty():
		offer_cards(kind)
	else:
		card_queue.append(kind)


func _ability_cards(c) -> Array:
	var pool: Array = []
	for i in 4:
		if not c.def["skills"][i].get("empty", false):
			continue
		if i == 3 and c.lvl < rank_req(3, 1):
			continue
		for d in GameData.CHAMPS:
			if not banished.has("a:%s:%d" % [d["id"], i]):
				pool.append({"kind": "ability", "hero": d["id"], "slot": i})
	if c.def["passive"]["t"] == "none":
		for d in GameData.CHAMPS:
			if d["passive"].has("hpMult") and float(d["passive"]["hpMult"]) < 1.0:
				continue
			if banished.has("p:" + String(d["id"])):
				continue
			pool.append({"kind": "passive", "hero": d["id"]})
	return pool


func _rank_cards(c) -> Array:
	var out: Array = []
	for i in 4:
		if c.def["skills"][i].get("empty", false) or c.ranks[i] >= MAX_RANK or c.lvl < rank_req(i, c.ranks[i] + 1):
			continue
		out.append({"kind": "rank", "slot": i})
	return out


func _item_tier() -> int:
	var w: Array = [80, 20, 0, 0] if round_no <= 4 else ([40, 55, 5, 0] if round_no <= 9 else ([10, 55, 33, 2] if round_no <= 15 else ([0, 30, 55, 15] if round_no <= 22 else [0, 10, 55, 35])))
	var roll := card_rng.randf() * 100.0
	for t in 4:
		roll -= float(w[t])
		if roll <= 0.0:
			return t + 1
	return 4


func _item_cards(c) -> Array:
	var full: bool = c.items.size() >= GameData.INV_SLOTS
	var out: Array = []
	var tries := 0
	while out.size() < SurvivalData.OFFER_SIZE and tries < 80:
		tries += 1
		var id := ""
		if full or (not c.items.is_empty() and card_rng.randf() < 0.25):
			var up: Array = c.items.filter(func(x): return int(c.item_lv.get(x, 1)) < ITEM_MAX_LV)
			if up.is_empty():
				if full:
					break
				continue
			id = up[card_rng.randi() % up.size()]
		else:
			var t := _item_tier()
			var pool: Array = GameData.ITEMS.filter(func(it): return int(it["tier"]) == t and not banished.has("i:" + String(it["id"])))
			if pool.is_empty():
				continue
			id = pool[card_rng.randi() % pool.size()]["id"]
			if c.items.has(id) and int(c.item_lv.get(id, 1)) >= ITEM_MAX_LV:
				continue
		if out.any(func(o): return o["id"] == id):
			continue
		out.append({"kind": "item", "id": id})
	return out


func offer_cards(kind: String) -> void:
	var c = players[0].champ
	var ab := _ability_cards(c)
	if kind == "first":
		# the run's first card is always an ability, so the hero never starts a wave with nothing to cast
		ab = ab.filter(func(o): return o["kind"] == "ability")
		kind = "ability"
	if ab.is_empty():
		ab = _rank_cards(c)
	if kind == "":
		# the kind of the draft is a coin flip, leaning to abilities while slots are still empty
		var empties := 0
		for i in 4:
			if c.def["skills"][i].get("empty", false):
				empties += 1
		kind = "ability" if card_rng.randf() < 0.35 + 0.1 * empties else "item"
	var out: Array = []
	if kind == "ability" and not ab.is_empty():
		var tries := 0
		while out.size() < SurvivalData.OFFER_SIZE and out.size() < ab.size() and tries < 60:
			tries += 1
			var o: Dictionary = ab[card_rng.randi() % ab.size()]
			if out.has(o) or (o["kind"] != "rank" and out.any(func(x): return x.get("hero", "") == o.get("hero", "") and x["kind"] == o["kind"] and x.get("slot", -1) == o.get("slot", -1))):
				continue
			out.append(o)
	else:
		kind = "item"
		out = _item_cards(c)
		if out.is_empty() and not ab.is_empty():
			kind = "ability"
			out = ab.slice(0, SurvivalData.OFFER_SIZE)
	card_offer = out
	card_kind = kind
	rerolls = 0
	if not out.is_empty():
		ev("card_offer", arenas[0], Vector2.ZERO, {"kind": kind})


# Survival autopilot: pick the card that best feeds the tags it already collects; reroll a weak
# draft when gold allows.
func card_score(o: Dictionary) -> float:
	var c = players[0].champ
	var sc := 1.0
	match String(o["kind"]):
		"item":
			sc = 2.0 + float(GameData.item(o["id"])["tier"]) * 1.5 if not c.items.has(o["id"]) else 2.5
		"rank":
			sc = 2.0
		"ability":
			sc = 3.0 + (1.0 if int(o["slot"]) == 3 else 0.0)
		"passive":
			sc = 2.5
	for t in card_tags(o):
		var n := int(syn_counts.get(t, 0))
		sc += 0.6 + 0.4 * n + (1.2 if (n + 1) in SurvivalData.SYN_TIERS else 0.0)
	return sc


func ai_pick_card() -> void:
	var best := 0
	var bs := -1.0
	for i in card_offer.size():
		var sc := card_score(card_offer[i])
		if sc > bs:
			bs = sc
			best = i
	var g: float = players[0].gold
	if (bs < 4.5 and rerolls < 2 and g > reroll_cost() * 3) or (bs < 6.5 and rerolls < 3 and g > reroll_cost() * 8):
		reroll_cards()
		return
	pick_card(best)


# Survival: pay gold for a fresh draft of the same kind.
func reroll_cost() -> int:
	return SurvivalData.reroll_cost(round_no, rerolls)


func banish_cost() -> int:
	return SurvivalData.banish_cost(round_no, banishes)


func reroll_cards() -> bool:
	if mode != "survival" or card_offer.is_empty():
		return false
	var pl = players[0]
	var cost := reroll_cost()
	if pl.gold < cost:
		return false
	pl.gold -= cost
	gold_spent_cards += cost
	var n := rerolls + 1
	offer_cards(card_kind)
	rerolls = n
	ev("reroll", arenas[0], Vector2.ZERO, {"cost": cost})
	return true


# Survival: pay gold to remove one card from the offer for the rest of the run; another takes its place.
func banish_card(i: int) -> bool:
	if mode != "survival" or i < 0 or i >= card_offer.size():
		return false
	var o: Dictionary = card_offer[i]
	var key := SurvivalData.card_key(o)
	if key == "" or (o["kind"] == "item" and players[0].champ.items.has(o["id"])):
		return false   # rank cards and upgrades of items you own can't be banished
	var pl = players[0]
	var cost := banish_cost()
	if pl.gold < cost:
		return false
	pl.gold -= cost
	gold_spent_cards += cost
	banishes += 1
	banished[key] = true
	var c = pl.champ
	var pool: Array = []
	if o["kind"] == "item":
		pool = _item_cards(c)
	else:
		pool = _ability_cards(c)
	pool = pool.filter(func(x): return not card_offer.any(func(y): return SurvivalData.card_key(y) == SurvivalData.card_key(x) and SurvivalData.card_key(x) != ""))
	if pool.is_empty():
		card_offer.remove_at(i)
	else:
		card_offer[i] = pool[card_rng.randi() % pool.size()]
	if card_offer.is_empty():
		offer_cards(card_kind)
	ev("banish", arenas[0], Vector2.ZERO, {"key": key, "cost": cost})
	return true


func pick_card(i: int) -> bool:
	if mode != "survival" or i < 0 or i >= card_offer.size():
		return false
	var o: Dictionary = card_offer[i]
	card_offer = []
	var pl = players[0]
	var c = pl.champ
	var ar = arenas[pl.team]
	var label := ""
	match String(o["kind"]):
		"ability":
			var slot := int(o["slot"])
			var sk: Dictionary = TalentData.champ(o["hero"])["skills"][slot].duplicate(true)
			sk["from"] = o["hero"]
			c.def["skills"][slot] = sk
			c.ranks[slot] = maxi(1, c.ranks[slot])
			c.cds[slot] = 0.0
			label = sk["name"]
		"passive":
			var ps: Dictionary = TalentData.champ(o["hero"])["passive"].duplicate(true)
			ps["from"] = o["hero"]
			c.def["passive"] = ps
			if ps.has("hpMult"):
				c.hp_base *= float(ps["hpMult"])
			label = ps["name"]
		"rank":
			var rs := int(o["slot"])
			c.ranks[rs] = mini(MAX_RANK, c.ranks[rs] + 1)
			label = "%s rank %d" % [c.def["skills"][rs]["name"], c.ranks[rs]]
		"item":
			var id: String = o["id"]
			if c.items.has(id):
				c.item_lv[id] = mini(ITEM_MAX_LV, int(c.item_lv.get(id, 1)) + 1)
				label = "%s level %d" % [GameData.item(id)["name"], c.item_lv[id]]
			elif c.items.size() < GameData.INV_SLOTS:
				c.items.append(id)
				c.item_lv[id] = 1
				label = GameData.item(id)["name"]
	recalc_items(c)
	if not c.dead and label != "":
		add_text(ar, c.p + Vector2(0, -56), label.to_upper(), Color("#9fe0ff"), 1.6, 14)
	ev("card", ar, c.p, {"label": label})
	if not card_queue.is_empty():
		offer_cards(card_queue.pop_front())
	return true


# Survival: close the open card draft without taking anything (free), then open the next queued one.
func skip_cards() -> bool:
	if mode != "survival" or card_offer.is_empty():
		return false
	card_offer = []
	rerolls = 0
	ev("card_skip", arenas[0], Vector2.ZERO, {"kind": card_kind})
	if not card_queue.is_empty():
		offer_cards(card_queue.pop_front())
	return true


# ---------------------------------------------------------------- main step
func all_arenas() -> Array:
	return arenas if duel_ar == null or arenas.has(duel_ar) else arenas + [duel_ar]


func step(dt: float) -> void:
	tune_bind()
	if over:
		return
	# remember where everything stood, so the view can draw smoothly between steps (never read by the sim)
	for ar in all_arenas():
		for m in ar.mons:
			m.pp = m.p
		for c in ar.champs:
			c.pp = c.p
		for su in ar.sums:
			su.pp = su.p
		for pr in ar.projs:
			pr.pp = pr.p
		for mp in ar.mprojs:
			mp.pp = mp.p
	tick += 1
	t += dt
	for ar in all_arenas():
		ar.hit_n = 0
	if waves_on and not duel_on:
		round_t += dt
	# fixed-point warnings before the next wave (presentation only; state flags make each fire once a round)
	if waves_on and not duel_on and not (final_round > 0 and round_no >= final_round):
		if not boss_warned and round_t >= round_len - 10.0:
			boss_warned = true
			var bp := boss_preview(round_no + 1)
			if not bp.is_empty():
				ev("boss_warn", null, Vector2.ZERO, {"name": bp["name"], "kind": bp["kind"], "in": 10.0, "lanes": bp["lanes"]})
		if not wave_warned and round_t >= round_len - 5.0:
			wave_warned = true
			ev("wave_in", null, Vector2.ZERO, {"round": round_no + 1, "secs": 5.0})
	if final_round > 0 and round_no >= final_round:
		# the last wave has no timer: it goes on until a crystal falls, or until every wave and sent monster
		# is dead (neutral camp monsters don't count), and then the healthier crystal wins. A very long
		# safety limit stops a monster that can never reach anything from holding the match forever.
		final_t -= dt
		round_t = 0.0
		var spent := final_t < FINAL_SAFETY - 20.0
		final_left = 0
		for ar in arenas:
			if not ar.spawn_q.is_empty():
				spent = false
				final_left += ar.spawn_q.size()
			for m in ar.mons:
				if not m.dead and not m.d.get("camp", false):
					spent = false
					final_left += 1
		if (final_t <= 0.0 or spent) and not over:
			var f0: float = arenas[0].core_hp / arenas[0].core_max
			var f1: float = arenas[1].core_hp / arenas[1].core_max
			over = true
			over_t = t
			decided = "crystal"
			winner = 0 if f0 > f1 else (1 if f1 > f0 else (0 if players[0].kills + players[1].kills + players[2].kills + players[3].kills >= players[4].kills + players[5].kills + players[6].kills + players[7].kills else 1))
	elif round_t >= round_len:
		round_t = 0
		for tm in 2:
			if vote_on[tm]:
				_vote_end(tm, false)   # the round ended on its own: the open vote is moot
		team_ready = [false, false]
		if income_per_round and round_no == 0:
			ev("setup_end", null, Vector2.ZERO, {})
		var tsum: Array = []
		for ti in 2:
			var inc := 0
			var gs := 0
			var sn := 0
			for pl in players:
				if pl.team == ti:
					inc += pl.income
					gs += pl.round_gold_sent
					sn += pl.round_sends
			tsum.append({"inc": inc, "core": arenas[ti].core_hp / maxf(1.0, arenas[ti].core_max), "gold_sent": gs, "sends": sn})
		ev("round_end", null, Vector2.ZERO, {"round": round_no, "teams": tsum})
		round_no += 1
		boss_warned = false
		wave_warned = false
		for pl in players:
			pl.round_gold_sent = 0
			pl.round_sends = 0
		if duels_on and not duel_on and round_no >= duel_first and (round_no - duel_first) % duel_every == 0:
			start_duel()
		if duel_on:
			duel_wave = true   # the wave marches once the duel is decided
		else:
			spawn_wave()
		if mode == "survival":
			players[0].income += 3
		if income_per_round:
			pay_income()   # the round's income, after the interest (paid with the wave) on what was held
		if duels_on and not duel_on:
			_duel_notice()
	if income_per_round:
		income_t = round_len - round_t   # the HUD's "income in": it comes with the next wave
	if (vote_on[0] or vote_on[1]) and not duel_on:
		upd_vote(dt)
	if duel_on:
		# the world waits: only the ring moves
		upd_duel(dt)
		for ar in arenas:
			upd_cosmetic(ar, dt)
		return
	upd_commands(dt)
	if mode == "survival" and not players[0].human:
		if not card_offer.is_empty():
			ai_pick_card()
		elif not boon_offer.is_empty():
			pick_boon(0)
	hist_t -= dt
	if hist_t <= 0:
		hist_t = 10.0
		sample_hist()
	for pl in players:
		if pl.bb_cd > 0:
			pl.bb_cd -= dt
	if not income_per_round:
		income_t -= dt
		if income_t <= 0:
			income_t += income_every
			pay_income()
	for pl in players:
		if not pl.human and not pl.absent and (enemy_sends or pl.team == 0) and mode != "survival":
			ai_send(pl, dt)
		if not pl.human and not pl.absent and pl.champ.dead:
			ai_buyback(pl)
	for ar in arenas:
		if (mode == "survival" or not enemy_present) and ar.team == 1:
			continue
		upd_arena(ar, dt)
	if duel_on:
		upd_duel(dt)


# One income payment to everyone: every income_every seconds in the 10 s modes, once per round (at the
# round increment) in classic and quick.
func pay_income() -> void:
	for pl in players:
		if pl.absent:
			continue
		var ig: float = pl.income * (DIFF_INCOME[pl.diff] if not pl.human else 1.0) * float(inc_mult[pl.team])
		give_gold(pl, ig)
		pl.income_gold += ig
		if not pl.human:
			if ai_econ_v2:
				ai_reserve(pl, ig, true)
			else:
				pl.res_items += pl.income * AI_ITEM_SHARE
				pl.res_core += pl.income * AI_CORE_SHARE
		if pl.human:
			add_text(pl.champ.ar, pl.champ.p + Vector2(0, -34), "+%dg" % pl.income, Color("#f0d48a"), 1.2, 12)


# ---------------------------------------------------------------- "start next round" vote (0.17)
func vote_len() -> float:
	return tv("vote_len")   # VOTE_LEN unless tuned


# True while the setup minute runs (classic/quick, before the first wave).
func in_setup() -> bool:
	return income_per_round and round_no == 0 and waves_on


func vote_seats(tm: int) -> int:
	var n := 0
	for pl in players:
		if not pl.absent and pl.team == tm:
			n += 1
	return n


# Yes votes a team needs: more than half of its seats (3 of 4).
func vote_need(tm: int) -> int:
	return vote_seats(tm) / 2 + 1


func vote_count(tm: int, yes: bool) -> int:
	var n := 0
	for pid in votes[tm]:
		if bool(votes[tm][pid]) == yes:
			n += 1
	return n


# Why this team can't call a vote right now ("" when it can). The HUD shows this on the disabled button.
func vote_refusal(tm: int) -> String:
	if not income_per_round:
		return "Only in Classic and Quick matches."
	if over:
		return "The match is over."
	if vote_on[tm]:
		return "A vote is already open."
	if team_ready[tm]:
		return "Your team is ready: waiting for %s." % TEAM_NAMES[1 - tm]
	if duel_on:
		return "Not during a duel."
	if final_round > 0 and round_no >= final_round:
		return "The last wave has no next round."
	if vote_round[tm] == round_no:
		return "One vote per round: your team's vote is spent."
	if round_t < VOTE_GRACE and not in_setup():
		return "Not in the first %d seconds after a wave." % int(VOTE_GRACE)
	if round_len - round_t <= vote_len() * 0.5:
		return "The next wave is almost here anyway."
	return ""


# The "vote" command: a[0] = 1 yes / 0 no. Opens the player's team's vote when none is open this round
# (the caller votes yes); otherwise records or changes this player's vote. Returns true when something happened.
func vote_cmd(pl, yes: bool) -> bool:
	if pl.absent:
		return false
	var tm: int = pl.team
	if not vote_on[tm]:
		if not yes or vote_refusal(tm) != "":
			return false
		vote_on[tm] = true
		vote_t[tm] = vote_len()
		vote_round[tm] = round_no
		vote_by[tm] = pl.id
		votes[tm] = {}
		for o in players:
			if o.team == tm and not o.human and not o.absent and o != pl:
				vote_ai_t[o.id] = rng.randf_range(1.0, 3.0)
		ev("vote_start", null, Vector2.ZERO, {"pid": pl.id, "team": tm, "round": round_no + 1, "human": pl.id == local})
		votes[tm][pl.id] = true
		ev("vote_cast", null, Vector2.ZERO, {"pid": pl.id, "team": tm, "yes": true, "human": pl.id == local})
		_vote_check(tm)
		return true
	if votes[tm].has(pl.id) and bool(votes[tm][pl.id]) == yes:
		return false
	votes[tm][pl.id] = yes
	vote_ai_t.erase(pl.id)
	ev("vote_cast", null, Vector2.ZERO, {"pid": pl.id, "team": tm, "yes": yes, "human": pl.id == local})
	_vote_check(tm)
	return true


# Does the team's open vote end now? Pass: yes is more than half of its seats. Fail: no is at least half (a
# pass is impossible). Otherwise it goes on until the timer runs out.
func _vote_check(tm: int) -> void:
	if not vote_on[tm]:
		return
	var seats := vote_seats(tm)
	if vote_count(tm, true) * 2 > seats:
		_vote_end(tm, true)
	elif vote_count(tm, false) * 2 >= seats:
		_vote_end(tm, false)


# A passed vote makes the team ready; the round ends at once when both teams are ready (vote_result
# carries "start": true then), otherwise the ready state is shown to everyone until the round ends.
func _vote_end(tm: int, passed: bool) -> void:
	var y := vote_count(tm, true)
	var n := vote_count(tm, false)
	var saved := 0.0
	var start := false
	vote_on[tm] = false
	for pl in players:
		if pl.team == tm:
			vote_ai_t.erase(pl.id)
	if passed:
		team_ready[tm] = true
		ev("team_ready", null, Vector2.ZERO, {"team": tm, "round": round_no + 1})
		if team_ready[0] and team_ready[1]:
			start = true
			saved = maxf(0.0, round_len - round_t)
			round_t = round_len   # the next step rolls the round over: wave, income, interest
			income_t = 0.0
			boss_warned = true    # no "in 10 s" / "in 5 s" cards for a wave that is already here
			wave_warned = true
	vote_log.append({"round": round_no, "team": tm, "by": vote_by[tm], "passed": passed, "yes": y, "no": n, "saved": saved})
	ev("vote_result", null, Vector2.ZERO, {"team": tm, "passed": passed, "start": start, "yes": y, "no": n, "round": round_no + 1})


func upd_vote(dt: float) -> void:
	for tm in 2:
		if vote_on[tm]:
			vote_t[tm] -= dt
	# bots make up their minds 1-3 s in (sim timer, sim RNG: the same on every computer)
	for pl in players:
		if not vote_ai_t.has(pl.id):
			continue
		vote_ai_t[pl.id] = float(vote_ai_t[pl.id]) - dt
		if float(vote_ai_t[pl.id]) <= 0.0:
			vote_ai_t.erase(pl.id)
			if pl.human or pl.absent or not vote_on[pl.team]:
				continue
			vote_cmd(pl, ai_vote_yes(pl))
	for tm in 2:
		if vote_on[tm] and vote_t[tm] <= 0.0:
			_vote_end(tm, false)


# A bot says yes when its lane is quiet (at most 3 non-camp monsters alive on its team's road), its hero is
# alive, and it has little left to spend (under 40 % of a round of income beyond its purses) or nothing
# it wants to buy; on Brutal also whenever its team's crystal is the healthier one. Once the other team is
# ready it says yes whenever its road holds at most 6 monsters (a ready human team gets its round within a
# few seconds unless the bots are actually under pressure). Otherwise no.
func ai_vote_yes(pl) -> bool:
	var ar = arenas[pl.team]
	var alive := 0
	for m in ar.mons:
		if not m.dead and not m.d.get("camp", false):
			alive += 1
	if pl.champ.dead:
		return false
	if enemy_present and team_ready[1 - pl.team] and alive <= VOTE_AI_QUIET_READY:
		return true
	if alive > VOTE_AI_QUIET:
		return false
	var brutal: bool = pl.diff >= (DIFF_HERO.size() - 1 if ai_tiers else 3)
	if brutal and enemy_present and ar.core_hp / maxf(1.0, ar.core_max) > arenas[1 - pl.team].core_hp / maxf(1.0, arenas[1 - pl.team].core_max):
		return true
	var spendable: float = pl.gold - pl.res_items - pl.res_tech - pl.res_bank - pl.res_core
	var nothing_to_buy: bool = ai_next_price(pl) <= 0 and pl.tech >= mini(NB, int(max_tech[pl.team]))
	return spendable < 0.4 * float(pl.income) or nothing_to_buy


# Bots call a vote now and then (from their send tick) when they would vote yes themselves and enough of
# the round is left for the vote to save anything; at once when the other team is already ready.
func ai_call_vote(pl) -> void:
	var tm: int = pl.team
	if not income_per_round or vote_on[tm] or vote_round[tm] == round_no or round_no < 1 or in_setup():
		return
	if mode == "tutorial" and not enemy_sends:
		return   # 0.19: bots wait with their votes until the tutorial lets the match run
	var other_ready: bool = enemy_present and team_ready[1 - tm]
	if (round_len - round_t < vote_len() and not other_ready) or vote_refusal(tm) != "":
		return
	if not other_ready and rng.randf() > 0.3:
		return
	if ai_vote_yes(pl):
		vote_cmd(pl, true)


# ---------------------------------------------------------------- hero duels
# Every few rounds one hero from each team is pulled into the ring at the confluence to fight while
# the whole match waits and watches. The pair is named two rounds ahead. The winner earns gold and
# experience; the loser dies and waits out a revive like any other death.
func next_duel_round() -> int:
	if not duels_on:
		return 0
	var r := duel_first
	while r <= round_no:
		r += duel_every
	return r


# Who fights next: a random hero from each team, drawn from a bag per team so that everyone duels once
# before anyone duels twice (and any hero can meet any enemy hero). Returns [slot a, slot b] or [].
var duel_bag := [[], []]


func _duel_able(t: int, j: int, allow_dead: bool) -> bool:
	var pl = players[4 * t + j]
	if pl.absent:
		return false
	if not allow_dead and pl.champ.dead:
		return false
	return pl.champ.ar == arenas[t]


func _duel_pick(allow_dead := false) -> Array:
	var out := []
	# 0.21 campaign: a chapter can name its duellists (cfg "duel_pair": [our slot, their slot], e.g. you
	# against Seraphine); the ring revives a fallen one, so only absent or already-ringed heroes are skipped
	var dp: Array = cfg.get("duel_pair", [])
	if dp.size() == 2 and _duel_able(0, int(dp[0]), true) and _duel_able(1, int(dp[1]), true):
		return [int(dp[0]), int(dp[1])]
	# 0.23 campaign: cfg "duel_ours": our slot that fights every duel (you), against a rotating enemy, so a
	# "win a duel" bonus is not a draw from the bag
	var ours := int(cfg.get("duel_ours", -1))
	for t in 2:
		if t == 0 and ours >= 0 and _duel_able(0, ours, true):
			out.append(ours)
			continue
		var cands: Array = duel_bag[t].filter(func(j): return _duel_able(t, j, allow_dead))
		if cands.is_empty():
			# everyone in the bag has had a turn (or can't fight now): start a new bag
			var fresh: Array = []
			for j in team_size:
				if not duel_bag[t].has(j):
					fresh.append(j)
			duel_bag[t] = duel_bag[t] + fresh if not duel_bag[t].is_empty() else range(team_size)
			cands = duel_bag[t].filter(func(j): return _duel_able(t, j, allow_dead))
			if cands.is_empty():
				return []
		out.append(cands[rng.randi() % cands.size()])
	for t in 2:
		duel_bag[t].erase(out[t])
	return out


# Two rounds before a duel, name the pair so everyone can prepare.
func _duel_notice() -> void:
	var r := next_duel_round()
	if r == 0 or r - round_no != DUEL_NOTICE or duel_next_round == r:
		return
	var pk := _duel_pick(true)
	if pk.is_empty():
		return
	duel_next = [players[pk[0]].champ, players[4 + pk[1]].champ]
	duel_next_round = r
	ev("duel_soon", arenas[0], JUNCTION_POS, {"round": r, "pa": duel_next[0].pl.name, "pb": duel_next[1].pl.name,
		"ha": duel_next[0].def["name"], "hb": duel_next[1].def["name"], "human": duel_next[0].pl.id == local or duel_next[1].pl.id == local})


# Where the roads cross the ring's edge: one spot per team, on the road centre line, with the road's
# direction (pointing away from the ring) and its sideways normal.
func _duel_spectator_roads() -> Array:
	var found: Array = []
	for lane in 2:
		var pts := lane_points(lane)
		for i in range(1, pts.size()):
			var a: Vector2 = pts[i - 1]
			var b: Vector2 = pts[i]
			var da := a.distance_to(JUNCTION_POS)
			var db := b.distance_to(JUNCTION_POS)
			if (da - DUEL_SPECT_R) * (db - DUEL_SPECT_R) <= 0.0 and da != db:
				var u := (DUEL_SPECT_R - da) / (db - da)
				var p := a.lerp(b, u)
				if found.any(func(f): return f["p"].distance_to(p) < 80.0):
					continue
				var d := (p - JUNCTION_POS).normalized()
				found.append({"p": p, "d": d, "n": Vector2(-d.y, d.x), "in": da > db})
	# the two roads that lead in (one per lane) are the natural stands; fall back to any road, then to
	# opposite points on the ring
	var ins: Array = found.filter(func(f): return f["in"])
	var outs: Array = found.filter(func(f): return not f["in"])
	var pick: Array = ins + outs
	while pick.size() < 2:
		var ang := -PI * 0.75 if pick.is_empty() else PI * 0.25
		var d := Vector2.from_angle(ang)
		pick.append({"p": JUNCTION_POS + d * DUEL_SPECT_R, "d": d, "n": Vector2(-d.y, d.x), "in": false})
	return [pick[0], pick[1]]


func start_duel() -> void:
	var pk := []
	# the pair named in advance fights if both are still standing; otherwise a fresh random pair
	if duel_next.size() == 2 and duel_next_round == round_no:
		var pa = duel_next[0].pl
		var pb = duel_next[1].pl
		if not pa.absent and not pb.absent and not pa.champ.dead and not pb.champ.dead and pa.champ.ar == arenas[0] and pb.champ.ar == arenas[1]:
			pk = [pa.id % 4, pb.id % 4]
		else:
			# the named pair can't fight: they keep their turn for a later duel
			for t in 2:
				var j: int = duel_next[t].pl.id % 4
				if not duel_bag[t].has(j):
					duel_bag[t].append(j)
	duel_next = []
	if pk.is_empty():
		pk = _duel_pick()
	if pk.is_empty():
		duel_no += 1
		return
	duel_no += 1
	var a = players[pk[0]].champ
	var b = players[4 + pk[1]].champ
	duel_pair = [a, b]
	duel_back = {}
	duel_pow = {}
	duel_from = {}
	for i in 2:
		var c = duel_pair[i]
		duel_back[c] = c.ar
		if not c.dead:
			duel_from[c] = {"p": c.p, "face": c.face, "anchor": c.anchor}
		c.ar.champs.erase(c)
		c.ar = duel_ar
		duel_ar.champs.append(c)
		c.dead = false
		c.respawn = 0.0
		c.hp = c.max_hp
		# against a human, an AI hero fights at a human's strength, a little below: its difficulty bonus
		# (health and damage) is set aside for the duel and it hits a bit softer
		var foe = duel_pair[1 - i]
		if not c.pl.human and foe.pl.human:
			duel_pow[c] = c.pow
			c.hp = c.max_hp * minf(1.0, 1.0 / maxf(0.01, c.pow)) * tv("duel_ai_hp")
			c.pow = minf(c.pow, 1.0) * tv("duel_ai_dmg")
		c.shield = 0.0
		c.buffs = []
		c.chan = null
		c.silence = 0.0
		c.stun = 0.0
		c.slow_t = 0.0
		c.burn_t = 0.0
		c.dash = null
		c.route = []
		c.moving = false
		c.retreat = false
		c.want_shop = false
		c.order = "idle"
		c.cur_tgt = null
		c.order_tgt = null
		c.ai_tgt = null
		for s_ in 4:
			c.cds[s_] = 0.0
		c.p = JUNCTION_POS + Vector2(-190 if i == 0 else 190, 0)
		c.face = 0.0 if i == 0 else PI
		c.anchor = c.p
	# everyone else comes to the edge of the ring to watch, standing on the roads that lead into it
	# (never in the trees): each team takes one of the roads, spread across its width
	duel_spect = {}
	var side_n := [0, 0]
	for pl in players:
		if pl.absent or pl.champ.dead or duel_pair.has(pl.champ):
			continue
		side_n[pl.team] += 1
	var side_i := [0, 0]
	var spots := _duel_spectator_roads()
	for pl in players:
		var c = pl.champ
		if pl.absent or c.dead or duel_pair.has(c):
			continue
		duel_spect[c] = {"ar": c.ar, "p": c.p, "face": c.face, "order": c.order, "order_pt": c.order_pt, "anchor": c.anchor}
		c.ar.champs.erase(c)
		c.ar = duel_ar
		duel_ar.champs.append(c)
		var n: int = side_n[pl.team]
		var i2: int = side_i[pl.team]
		side_i[pl.team] += 1
		var road: Dictionary = spots[pl.team]
		# across the road: -70, 0, +70 for three; a fourth stands a step further out
		var across: float = (float(i2 % 3) - float(mini(n, 3) - 1) * 0.5) * 70.0
		var back: float = 0.0 if i2 < 3 else 60.0
		c.p = road["p"] + road["n"] * across + road["d"] * back
		c.face = (JUNCTION_POS - c.p).angle()
		c.anchor = c.p
		c.order = "hold"
		c.order_pt = c.p
		c.route = []
		c.moving = false
		c.dash = null
		c.cur_tgt = null
		c.order_tgt = null
	duel_t = DUEL_TIME
	duel_count = DUEL_COUNTDOWN
	duel_on = true
	duel_round = round_no
	ev("duel_start", duel_ar, JUNCTION_POS, {"pa": a.pl.name, "pb": b.pl.name, "ha": a.def["name"], "hb": b.def["name"], "human": a.pl.id == local or b.pl.id == local,
		"apid": a.pl.id, "bpid": b.pl.id, "in": DUEL_COUNTDOWN})




func upd_duel(dt: float) -> void:
	var a = duel_pair[0]
	var b = duel_pair[1]
	if duel_count > 0.0:
		# 5 4 3 2 1: the fighters stand ready
		var before := ceili(duel_count)
		duel_count -= dt
		var now := ceili(duel_count)
		if now < before:
			ev("duel_count", duel_ar, JUNCTION_POS, {"n": maxi(now, 0)})
		if duel_count <= 0.0:
			ev("duel_fight", duel_ar, JUNCTION_POS, {"apid": a.pl.id, "bpid": b.pl.id})
		for side in [a, b]:
			side.cds = [0.0, 0.0, 0.0, 0.0]
			side.atk_cd = 0.2
			side.moving = false
			side.route = []
		upd_cosmetic(duel_ar, dt)
		return
	duel_t -= dt
	for side in [a, b]:
		if not duel_on:
			return
		var foe = b if side == a else a
		duel_ar.mons = [foe]
		if not side.pl.human:
			ai_duel(duel_ar, side, foe, dt)
		upd_champ(duel_ar, side, dt)
		if side.p.distance_to(JUNCTION_POS) > DUEL_RING:
			side.p = JUNCTION_POS + (side.p - JUNCTION_POS).normalized() * DUEL_RING
		upd_effects(duel_ar, dt, side)
	duel_ar.mons = []
	upd_cosmetic(duel_ar, dt)
	if duel_on and duel_t <= 0:
		end_duel(a if a.hp / a.max_hp >= b.hp / b.max_hp else b)


const DUEL_AI_HP := 0.9          # an AI hero's health in a duel with a human (share of a human-strength hero)
const DUEL_AI_DMG := 0.8         # ... and its damage
var duel_pow := {}


func end_duel(victor) -> void:
	if duel_on and duel_pair.size() == 2:
		var lo = duel_pair[1] if duel_pair[0] == victor else duel_pair[0]
		duel_hist.append({"round": duel_round, "w": victor.pl.name, "l": lo.pl.name, "wh": victor.def["name"], "lh": lo.def["name"], "wt": victor.pl.team, "time": DUEL_TIME - duel_t, "gold": 150 + 15 * round_no})
	if not duel_on:
		return
	duel_on = false
	duel_ar.mons = []
	var loser = duel_pair[1] if duel_pair[0] == victor else duel_pair[0]
	var reward := 150 + 15 * round_no
	give_gold(victor.pl, reward)
	victor.pl.duel_w += 1
	loser.pl.duel_l += 1
	victor.pl.duel_wins += 1
	loser.pl.duel_losses += 1
	victor.kills += 1
	gain_xp(duel_ar, victor, 60.0 + 12.0 * round_no)
	duel_log.push_front([victor.pl.name, loser.pl.name, round_no])
	feed.push_front({"t": t, "team": victor.pl.team, "who": victor.pl.name, "duel": loser.pl.name, "gold": reward})
	ev("duel_end", duel_ar, victor.p, {"winner": victor.pl.name, "loser": loser.pl.name, "team": victor.pl.team, "gold": reward,
		"human_won": victor.pl.id == local, "human_lost": loser.pl.id == local, "hp": victor.hp / victor.max_hp,
		"wpid": victor.pl.id, "lpid": loser.pl.id, "draw": duel_t <= 0.0 and victor.hp / victor.max_hp == loser.hp / loser.max_hp})
	for c in duel_pair:
		if duel_pow.has(c):
			c.pow = duel_pow[c]
			c.hp = minf(c.hp * c.pow, c.max_hp)
		var home = duel_back[c]
		duel_ar.champs.erase(c)
		c.ar = home
		if not c.pl.absent and not home.champs.has(c):
			home.champs.append(c)   # a slot that left the match mid-duel (campaign) stays out of the arena
		c.stun = 0.0
		c.slow_t = 0.0
		c.burn_t = 0.0
		c.buffs = []
		c.dash = null
		c.route = []
		c.moving = false
		c.order = "idle"
		c.cur_tgt = null
		c.order_tgt = null
		# 0.26: both duelists go back to where they stood when the duel began (a hero pulled in while dead: the base)
		var fr = duel_from.get(c)
		if fr != null and c != loser:
			c.p = fr["p"]
			c.face = fr["face"]
			c.anchor = fr["anchor"]
		else:
			c.p = CORE + Vector2(-140, rng.randf_range(-60, 60)) if c.pl.human else HOMES[c.home]
			c.anchor = c.p
		if c == loser:
			# the loser really dies: a revive timer like any other death (no Survival life is lost here)
			c.hp = 0.0
			c.dead = true
			c.respawn = 5.0 + c.lvl * 0.4
			c.pl.deaths += 1
			c.shield = 0.0
			ev("hdie", home, c.p, {"team": c.pl.team, "who": c.pl.name, "human": c.pl.id == local, "duel": true})
		else:
			c.hp = c.max_hp
	# the spectators walk back to exactly where they stood
	for c in duel_spect:
		var sp: Dictionary = duel_spect[c]
		duel_ar.champs.erase(c)
		c.ar = sp["ar"]
		if not c.pl.absent and not c.ar.champs.has(c):
			c.ar.champs.append(c)
		c.p = sp["p"]
		c.face = sp["face"]
		c.anchor = sp["anchor"]
		c.order = sp["order"]
		c.order_pt = sp["order_pt"]
		c.route = []
		c.moving = false
		c.cur_tgt = null
	duel_spect = {}
	duel_ar.projs.clear()
	duel_ar.zones.clear()
	duel_ar.pend.clear()
	duel_ar.sums.clear()
	duel_pair = []
	if duel_wave:
		duel_wave = false
		spawn_wave()


func ai_duel(ar, c, foe, dt: float) -> void:
	c.ai_t -= dt
	if c.ai_t > 0:
		return
	var thr: Array = DIFF_THINK[c.pl.diff]
	c.ai_t = rng.randf_range(thr[0], thr[1])
	if c.hp < c.max_hp * 0.45 and c.potions > 0 and c.pot_t <= 0:
		use_potion(c)
	if c.chan != null:
		return   # channelling Soul Tether
	c.ai_tgt = foe
	if c.dash == null:
		var d: float = foe.p.distance_to(c.p)
		var reach := c_range(c)
		var want := reach * 0.8 if reach > 60 else 20.0
		var dir: Vector2 = (foe.p - c.p) / maxf(d, 0.001)
		if d > want:
			order_move(c, foe.p - dir * want)
		else:
			c.moving = false
			c.route = []
	if c.pl.diff == 0 and rng.randf() < 0.5:
		return
	ai_skills(ar, c, foe, [foe])
	ai_items(ar, c, foe, [foe])


func upd_arena(ar, dt: float) -> void:
	if ar.leak_flash > 0:
		ar.leak_flash -= dt
	upd_core(ar, dt)
	upd_defense(ar, dt)
	if not ar.spawn_q.is_empty():
		var keep: Array = []
		for q in ar.spawn_q:
			if q[0] <= t:
				var sm_ := spawn_mon(ar, q[1], q[2], q[3], q[4])
				if q.size() > 5 and String(q[5]) != "":
					make_elite(ar, sm_, String(q[5]))
				if q.size() > 6:
					sm_.lives = maxi(1, ceili(sm_.lives * float(q[6])))   # a paired boss's share of crystal damage
			else:
				keep.append(q)
		ar.spawn_q = keep
	if not ar.spawn_now.is_empty():
		var batch: Array = ar.spawn_now
		ar.spawn_now = []
		for q in batch:
			var m := spawn_mon(ar, q[0], q[1], q[2], q[3])
			m.wi = mini(q[5], m.path.size() - 1)
			if m.fly:
				m.wi = 1
			m.p = q[4] if m.fly else bridge_push(q[4], m.r)
			if q[6] != null:
				q[6].kids.append(m)
	# auras: haste and armor wards
	var auras: Array = []
	for m in ar.mons:
		if not m.dead and m.silence <= 0 and (m.d.has("haste") or m.d.has("ward")):
			auras.append(m)
	if ar.surge_t > 0.0:
		ar.surge_t -= dt
	var base_haste: float = ar.surge if ar.surge_t > 0.0 else 1.0
	for m in ar.mons:
		m.haste = base_haste
		m.ward = 0.0
	for a in auras:
		if a.d.has("haste"):
			var hr := f(a.d["haste"], "r")
			var hm := f(a.d["haste"], "mult")
			for o in mons_in(ar, a.p, hr):
				o.haste = maxf(o.haste, hm)
		if a.d.has("ward"):
			var wr := f(a.d["ward"], "r")
			var wa := f(a.d["ward"], "add")
			for o in mons_in(ar, a.p, wr):
				o.ward = maxf(o.ward, wa)
	for c in ar.champs:
		c.attackers = 0
	for m in ar.mons:
		if m.aggro != null and not m.dead and m.aggro is Champ:
			m.aggro.attackers += 1
	for c in ar.champs:
		if not c.pl.human:
			ai_champ(ar, c, dt)
		upd_champ(ar, c, dt)
	for m in ar.mons:
		if not m.dead:
			upd_mon(ar, m, dt)
	upd_effects(ar, dt, null)
	upd_mpend(ar, dt)
	upd_camp(ar, dt)
	upd_cosmetic(ar, dt)
	ar.mons = ar.mons.filter(func(x): return not x.dead)


# Projectiles, monster projectiles, delayed blasts, zones and summons. With `owner` set (duels),
# only that hero's effects run, against whatever is in ar.mons at the time.
func upd_mpend(ar, dt: float) -> void:
	if ar.mpend.is_empty():
		return
	for b in ar.mpend:
		b["t"] -= dt
		if b["t"] <= 0:
			add_fx(ar, {"type": "ring", "p": b["p"], "r": b["r"], "col": Color("#a0e0ff"), "t": 0.45, "dur": 0.45, "fill": true})
			burst(ar, b["p"], Color("#c0f0ff"), 24, 180)
			ev("boom", ar, b["p"])
			for c in ar.champs:
				if not c.dead and c.p.distance_to(b["p"]) < b["r"] + c.r:
					hurt_champ(ar, c, b["dmg"], b.get("src"))
					c.stun = maxf(c.stun, b["stun"])
	ar.mpend = ar.mpend.filter(func(b): return b["t"] > 0)


func upd_effects(ar, dt: float, owner) -> void:
	for pr in ar.projs:
		if owner != null and pr.c != owner:
			continue
		if pr.homing:
			var m = pr.tgt
			if m.dead:
				pr.done = true
				continue
			var dv: Vector2 = m.p - pr.p
			var d := dv.length()
			var s: float = pr.spd * dt
			if d <= s + m.r:
				pr.done = true
				if pr.auto:
					auto_hit(ar, pr.c, m)
				elif pr.splash > 0:
					add_fx(ar, {"type": "ring", "p": m.p, "r": pr.splash, "col": pr.col, "t": 0.3, "dur": 0.3})
					for o in mons_in(ar, m.p, pr.splash):
						apply_fx(o, pr.fx, pr.c)
						hurt(ar, o, pr.dmg, pr.c)
				else:
					apply_fx(m, pr.fx, pr.c)
					hurt(ar, m, pr.dmg, pr.c)
			else:
				pr.p += dv / d * s
		else:
			pr.p += pr.v * dt
			pr.left -= pr.spd * dt
			for m in ar.mons:
				if m.dead or pr.hit.has(m):
					continue
				if pr.p.distance_squared_to(m.p) < (pr.r + m.r) * (pr.r + m.r):
					if pr.explode > 0:
						add_fx(ar, {"type": "ring", "p": m.p, "r": pr.explode, "col": pr.col, "t": 0.35, "dur": 0.35, "fill": true, "vis": pr.vis, "hit": true})
						ev_view("abhit", ar, m.p, {"vis": pr.vis, "human": pr.c != null and pr.c.pl.id == local})
						for o in mons_in(ar, m.p, pr.explode):
							apply_fx(o, pr.fx, pr.c)
							hurt(ar, o, pr.dmg, pr.c)
						pr.done = true
						break
					apply_fx(m, pr.fx, pr.c)
					hurt(ar, m, pr.dmg, pr.c)
					pr.hit[m] = true
					if not pr.pierce:
						pr.done = true
						break
			if pr.left <= 0 or pr.p.x < -20 or pr.p.x > W + 20 or pr.p.y < -20 or pr.p.y > H + 20:
				pr.done = true
	ar.projs = ar.projs.filter(func(x): return not x.done)
	# monster projectiles
	for pr in ar.mprojs:
		var c = pr.tgt
		if c == null or c.dead or (c is Champ and c.ar != ar):
			pr.done = true
			continue
		var dv: Vector2 = c.p - pr.p
		var d := dv.length()
		var stp: float = pr.spd * dt
		if d <= stp + c.r and c is Summon:
			# 0.24: a shot at a risen / bound unit
			pr.done = true
			ev_view("mphit", ar, c.p, {"kind": pr.kind, "human": false})
			sum_hurt(ar, c, pr.dmg)
			if pr.splash > 0:
				add_fx(ar, {"type": "ring", "p": c.p, "r": pr.splash, "col": pr.col, "t": 0.35, "dur": 0.35, "fill": true})
				for o in ar.champs:
					if not o.dead and o.p.distance_to(c.p) < pr.splash + o.r:
						hurt_champ(ar, o, pr.dmg * 0.6, pr.src)
		elif d <= stp + c.r:
			pr.done = true
			ev_view("mphit", ar, c.p, {"kind": pr.kind, "human": c.pl.id == local})
			hurt_champ(ar, c, pr.dmg, pr.src)
			if pr.slow > 0 and bsum(c, "veil") <= 0:   # the Wisp Veil blessing shrugs slows off
				c.buffs.append({"t": 2.0, "ms": 1.0 - pr.slow, "slowed": true})
			if pr.drain > 0 and pr.src != null and not pr.src.dead:
				pr.src.hp = minf(pr.src.max_hp, pr.src.hp + pr.dmg * pr.drain)
			if pr.splash > 0:
				add_fx(ar, {"type": "ring", "p": c.p, "r": pr.splash, "col": pr.col, "t": 0.35, "dur": 0.35, "fill": true})
				for o in ar.champs:
					if o != c and not o.dead and o.p.distance_to(c.p) < pr.splash + o.r:
						hurt_champ(ar, o, pr.dmg * 0.6, pr.src)
		else:
			pr.p += dv / d * stp
	ar.mprojs = ar.mprojs.filter(func(x): return not x.done)
	# delayed blasts
	for b in ar.pend:
		if owner != null and b.c != owner:
			continue
		if b.follow != null:
			b.p = b.follow.p + b.fd
		b.t -= dt
		if b.t <= 0:
			b.done = true
			if not b.small:
				ev("boom", ar, b.p, {"vis": b.vis, "human": b.c != null and b.c.pl.id == local})
			elif b.vis != "":
				ev_view("abhit", ar, b.p, {"vis": b.vis, "small": true, "human": b.c != null and b.c.pl.id == local})
			add_fx(ar, {"type": "ring", "p": b.p, "r": b.r, "col": b.col, "t": 0.35, "dur": 0.35, "fill": true, "vis": b.vis, "hit": true})
			burst(ar, b.p, b.col, 4 if b.small else 12, 110)
			for m in mons_in(ar, b.p, b.r):
				apply_fx(m, b.fx, b.c)
				hurt(ar, m, b.dmg, b.c)
	ar.pend = ar.pend.filter(func(x): return not x.done)
	# zones
	for z in ar.zones:
		if owner != null and z.c != owner:
			continue
		if z.follow != null:
			if z.follow.dead:
				z.t = 0
			z.p = z.follow.p
		z.t -= dt
		z.spin += dt * 1.5
		for m in mons_in(ar, z.p, z.r):
			if z.sil and not m.d.get("boss", false):
				m.silence = maxf(m.silence, 0.4)   # bosses shrug off silence
			if z.slow > 0:
				apply_slow(m, z.slow, 0.3)
			if z.pull > 0 and not m.cci:
				var dv: Vector2 = z.p - m.p
				var dd := dv.length()
				if dd > 6:
					m.p += dv / dd * z.pull * dt * m.ten
					if m is Mon:
						unsiege(m)
			_hit_ctx = "dot"
			hurt(ar, m, z.dps * dt, z.c)
			_hit_ctx = ""
	ar.zones = ar.zones.filter(func(x): return x.t > 0)
	# summons
	for s in ar.sums:
		if owner != null and s.c != owner:
			continue
		s.t -= dt
		s.cd -= dt
		if s.tag != "":
			tagged_move(ar, s, dt)
			if s.t <= 0:
				continue
		elif s.mobile:
			var m = nearest_mon(ar, s.p, 500)
			if m != null:
				var dv: Vector2 = m.p - s.p
				var d := dv.length()
				if d > s.reach * 0.7 + m.r:
					s.p = walk_clamp(s.p + dv / d * 290.0 * dt)
				s.face = dv.angle()
		if s.cd <= 0:
			var m = nearest_mon(ar, s.p, s.reach) if s.tag == "" else sum_target(ar, s.p, s.reach)
			if m != null:
				s.cd = 1.0 / s.atk_speed
				s.face = (m.p - s.p).angle()
				if s.reach < 60:
					add_fx(ar, {"type": "slash", "p": s.p, "a": s.face, "col": s.col, "t": 0.12, "dur": 0.12, "small": true})
					apply_fx(m, s.fx, s.c)
					_hit_ctx = "summon"
					hurt(ar, m, s.dmg, s.c)
					_hit_ctx = ""
				else:
					var pr := Proj.new()
					pr.homing = true
					pr.p = s.p
					pr.tgt = m
					pr.spd = 560
					pr.c = s.c
					pr.col = s.col
					pr.dmg = s.dmg
					pr.fx = s.fx
					pr.splash = s.splash
					ar.projs.append(pr)
	ar.sums = ar.sums.filter(func(x): return x.t > 0)
	if not ar.sums_new.is_empty():
		ar.sums.append_array(ar.sums_new)
		ar.sums_new = []


func upd_cosmetic(ar, dt: float) -> void:
	for fxd in ar.fx:
		fxd["t"] -= dt
		if fxd.get("follow") != null:
			fxd["p"] = fxd["follow"].p
	ar.fx = ar.fx.filter(func(x): return x["t"] > 0)
	for pa in ar.parts:
		pa["t"] -= dt
		pa["p"] += pa["v"] * dt
		pa["v"] *= 0.92
	ar.parts = ar.parts.filter(func(x): return x["t"] > 0)
	for tx in ar.texts:
		tx["t"] -= dt
		if tx.has("v"):
			tx["p"] = tx["p"] + tx["v"] * dt
			tx["v"] = tx["v"] * (1.0 - 1.5 * dt) + Vector2(0, 340.0 * dt)
		else:
			tx["p"] = tx["p"] + Vector2(0, -22 * dt)
	ar.texts = ar.texts.filter(func(x): return x["t"] > 0)


# ---------------------------------------------------------------- stats, buy-back
func sample_hist() -> void:
	var dm: Array = []
	var gd: Array = []
	var ic: Array = []
	for pl in players:
		dm.append(pl.champ.dmg_done)
		gd.append(pl.earned)
		ic.append(pl.income)
	# "inc": each player's income per round at the sample; "round": the round it was taken in (0.18, scoreboard graph)
	hist.append({"t": t, "round": round_no, "dmg": dm, "gold": gd, "inc": ic, "core": [arenas[0].core_hp / arenas[0].core_max, arenas[1].core_hp / arenas[1].core_max]})


func buyback_cost(pl) -> int:
	return 100 + 25 * pl.champ.lvl + 6 * round_no


# Brings a dead hero back at its crystal right away for gold. Returns "" or why it can't.
func buyback(pl) -> String:
	var c = pl.champ
	if not c.dead:
		return "Your hero is alive."
	if pl.bb_cd > 0:
		return "Buy-back is on cooldown for %ds." % ceili(pl.bb_cd)
	var cost := buyback_cost(pl)
	if pl.gold < cost:
		return "Buy-back costs %d gold." % cost
	pl.gold -= cost
	pl.bb_cd = BUYBACK_CD
	pl.buybacks += 1
	c.respawn = 0.0
	c.dead = false
	c.hp = c.max_hp
	c.p = CORE + Vector2(-120, rng.randf_range(-60, 60))
	c.moving = false
	c.order = "idle"
	c.cur_tgt = null
	c.anchor = c.p
	add_text(c.ar, c.p + Vector2(0, -40), "BOUGHT BACK", Color("#ffd24a"), 1.4, 14)
	burst(c.ar, c.p, Color("#ffd24a"), 24, 160)
	ev("buyback", c.ar, c.p, {"human": pl.id == local, "team": pl.team, "who": pl.name})
	return ""


# Harder AIs buy back when their crystal is in danger.
func ai_buyback(pl) -> void:
	if pl.diff < 2 or pl.bb_cd > 0 or pl.champ.respawn < 6.0:
		return
	var ar = arenas[pl.team]
	if ar.core_hp / ar.core_max < 0.55 and pl.gold > buyback_cost(pl) + 150:
		buyback(pl)
	elif ai_econ_v2 and pl.diff >= 3 and road_pressured(pl.team) and pl.gold - 0.5 * pl.res_items > buyback_cost(pl) + 100:
		buyback(pl)   # 0.25 (classic/quick, Normal skirmish and up): a wave on the road is worth the gold too


# ---------------------------------------------------------------- orders to AI allies
# k: "help" (the two nearest allies come to p and fight there), "boss" (everyone fights the boss),
# "crystal" (everyone falls back to guard the crystal) or "lanes" (back to normal).
func command(team: int, k: String, p: Vector2) -> Array:
	var allies: Array = []
	for pl in players:
		if pl.team == team and not pl.human and not pl.absent and pl.champ.ar == arenas[team]:
			allies.append(pl.champ)
	if k == "lanes" or allies.is_empty():
		team_cmd[team] = {}
		return []
	var tb = boss_near(arenas[team], p) if k == "boss" else null   # with a boss in each rift: the one nearest p
	if k == "boss" and tb == null:
		return []
	var who: Array = allies
	if k == "help":
		allies.sort_custom(func(a, b): return a.p.distance_to(p) < b.p.distance_to(p))
		who = allies.slice(0, 2)
	team_cmd[team] = {"k": k, "p": p, "t": CMD_TIME, "who": who}
	if tb != null:
		team_cmd[team]["b"] = tb
	for c in who:
		c.ai_t = 0.0
		c.want_shop = false
	return who


func ai_home(ar, c) -> Vector2:
	var cmd: Dictionary = team_cmd[c.pl.team]
	if cmd.is_empty() or not cmd["who"].has(c) or c.ar != arenas[c.pl.team]:
		if c.ar == arenas[c.pl.team] and arenas[c.pl.team].def_who.has(c):
			return CORE + Vector2(-200, (c.home - 1.5) * 60.0)   # 0.23: pulled back to clear a leak (upd_defense)
		# the defender nearest a neutral camp clears it when its road is quiet and it's healthy. 0.26: with three
		# camps a bot picks the best one of its own: standing, nearest, and whose blessing the team isn't still under
		if c.pl.diff >= 1 and c.ar == arenas[c.pl.team]:
			var ar0 = arenas[c.pl.team]
			var best := -1
			var bd := INF
			for ci in mini(CAMPS.size(), ar0.camps_up.size()):
				if not ar0.camps_up[ci] or int(CAMPS[ci]["home"]) != c.home:
					continue
				if float(ar0.bless.get(String(CAMPS[ci]["kind"]), 0.0)) > 25.0:
					continue
				var dd: float = c.p.distance_to(camp_pos(ci))
				if dd < bd:
					bd = dd
					best = ci
			if best >= 0:
				var cp := camp_pos(best)
				var at_camp: bool = c.p.distance_to(cp) < 450.0
				if c.hp > c.max_hp * (0.35 if at_camp else 0.6):
					var threats := 0
					for m in c.ar.mons:
						if not m.dead and not m.d.get("camp", false) and m.p.distance_to(HOMES[c.home]) < 800.0:
							threats += 1
					if threats < (5 if at_camp else 3):
						return cp
		return HOMES[c.home]
	match cmd["k"]:
		"help":
			return walk_clamp(cmd["p"])
		"boss":
			var b = cmd.get("b", arenas[c.pl.team].boss)
			if b != null and not b.dead:
				return walk_clamp(b.p)
		"crystal":
			return CORE + Vector2(-260, (c.home - 1.5) * 70.0)
	return HOMES[c.home]


# 0.23: crystal defence for AI heroes, every mode. Twice a second each team looks at the monsters that got past its
# roads (at the crystal, or within DEF_R of it) and at how fast the crystal is losing health, decides how many
# heroes the leak needs, counts who is already there (the post beside the crystal and the human player count; a
# hero healing at the fountain does not), and pulls back the nearest AI heroes to make up the difference. They stay
# until the crystal has been clear for DEF_CALM seconds (no back-and-forth while a leak trickles in), then walk
# back to their posts. A lone kobold is left to the crystal's own bolts and the post by it; at least one hero
# stays on the roads unless the crystal is nearly gone. The player's own orders (F1-F3, mission rallies) win.
const DEF_R := 850.0          # monsters this close to the crystal count as a leak
const DEF_COVER_R := 650.0    # heroes this close to the crystal already guard it
const DEF_EVERY := 0.5
const DEF_CALM := 3.0
const DEF_SHED := 5.0         # seconds over strength before one pulled-back hero returns to its post


func def_pullable(ar, c) -> bool:
	if c.pl.human or c.pl.absent or c.dead or c.retreat or c.ar != ar or c.pl.team != ar.team:
		return false
	var cmd: Dictionary = team_cmd[ar.team]
	return cmd.is_empty() or not cmd["who"].has(c)


func upd_defense(ar, dt: float) -> void:
	ar.def_t -= dt
	if ar.def_t > 0.0:
		return
	ar.def_t = DEF_EVERY
	var dd: float = ar.core_dmg_taken - ar.def_dmg0
	ar.def_dmg0 = ar.core_dmg_taken
	ar.def_rate = ar.def_rate * 0.75 + dd / DEF_EVERY * 0.25
	ar.def_who = ar.def_who.filter(func(c): return def_pullable(ar, c))
	var leak_hp := 0.0
	for m in ar.mons:
		if m.dead or m.d.get("camp", false) or (m.spd <= 0.0 and not m.siege):
			continue
		if m.siege or m.p.distance_squared_to(CORE) < DEF_R * DEF_R:
			leak_hp += m.hp
	if leak_hp <= 0.0:
		ar.def_calm += DEF_EVERY
		ar.def_over = 0.0
		if ar.def_calm >= DEF_CALM:
			ar.def_who = []
		return
	ar.def_calm = 0.0
	var mine: Array = []
	var hp_ref := 0.0
	for c in ar.champs:
		if c.pl.team == ar.team and not c.pl.absent:
			mine.append(c)
			hp_ref += c.max_hp
	if mine.is_empty():
		return
	hp_ref /= mine.size()
	var frac: float = ar.core_hp / maxf(1.0, ar.core_max)
	var rate: float = ar.def_rate / maxf(1.0, ar.core_max)   # share of the crystal lost per second
	var want := 1
	if leak_hp < hp_ref * 0.3 and rate < 0.001:
		want = 0   # a straggler: the crystal's bolts and the post beside it deal with it
	if leak_hp > hp_ref * 1.2 or rate > 0.003:
		want = 2
	if leak_hp > hp_ref * 3.5 or (frac < 0.4 and rate > 0.002):
		want = 3
	var alive := 0
	var cover := 0
	for c in mine:
		if c.dead or c.ar != ar:
			continue
		alive += 1
		if not ar.def_who.has(c) and not c.retreat and c.p.distance_squared_to(CORE) < DEF_COVER_R * DEF_COVER_R:
			cover += 1
	if frac < 0.2 and rate > 0.0:
		want = alive   # the crystal is about to fall: everyone
	else:
		want = mini(want, maxi(1, alive - 1))   # someone stays on the roads
	var need := maxi(0, want - cover)
	if ar.def_who.size() > need:
		ar.def_over += DEF_EVERY
		if ar.def_over >= DEF_SHED:
			ar.def_over = 0.0
			# the one furthest from the crystal goes back first
			var far = ar.def_who[0]
			for c in ar.def_who:
				if c.p.distance_squared_to(CORE) > far.p.distance_squared_to(CORE):
					far = c
			ar.def_who.erase(far)
	else:
		ar.def_over = 0.0
	while ar.def_who.size() < need:
		var best = null
		var bd := INF
		for c in mine:
			if ar.def_who.has(c) or not def_pullable(ar, c) or c.hp < c.max_hp * 0.35:
				continue
			if c.p.distance_squared_to(CORE) < DEF_COVER_R * DEF_COVER_R:
				continue   # already there (counted as cover)
			if alive <= 1 and leak_hp > c.hp * 2.5 and frac > 0.35:
				continue   # alone, the pile would kill it (a Survival hero has one life); the bolts hold for now
			var d: float = c.p.distance_squared_to(CORE)
			if d < bd:
				bd = d
				best = c
		if best == null:
			break
		ar.def_who.append(best)
		best.ai_t = 0.0
		best.want_shop = false


func upd_commands(dt: float) -> void:
	for tm in 2:
		var cmd: Dictionary = team_cmd[tm]
		if cmd.is_empty():
			continue
		cmd["t"] -= dt
		var b = cmd.get("b", arenas[tm].boss)
		if cmd["k"] == "boss" and (b == null or b.dead):
			# that boss fell: carry on against the one still marching down the other rift, if any
			b = boss_near(arenas[tm], b.p if b != null else cmd["p"])
			cmd["b"] = b
		if cmd["t"] <= 0 or (cmd["k"] == "boss" and b == null):
			team_cmd[tm] = {}


# ---------------------------------------------------------------- AI economy
# How much gold a Hard (diff 2) or Brutal (3) AI keeps in the bank to earn interest.
func ai_bank(pl) -> float:
	# 0.21: the bank is a share of what actually earns interest (interest_cap_for: one round of income, at least
	# 300 since 0.15). It still read the old 400 + 80 x round cap, so a Hard campaign bot (legacy economy, the only
	# caller) sat on ~800 gold of dead money from wave 10 on and stopped sending: Ash on the Wind on Legend ran 48 waves.
	var cap := interest_cap(round_no + 1) if mode == "survival" else interest_cap_for(pl)
	return cap * (0.55 if pl.diff == 2 else 0.85)


# ---------------------------------------------------------------- item actives
func act_ready(c, id: String) -> bool:
	return float(c.act_cd.get(id, 0.0)) <= 0.0


# Uses the active of the item in an inventory slot, aimed at tp. Returns "" or why not.
func use_item(c, slot: int, tp: Vector2) -> String:
	if c.dead:
		return "Your hero is dead."
	if slot >= c.items.size():
		return "That slot is empty."
	var id: String = c.items[slot]
	var it := GameData.item(id)
	if not it.has("act"):
		return "%s has no active ability." % it["name"]
	if not act_ready(c, id):
		return "%s is recharging (%ds)." % [it["act"]["name"], ceili(c.act_cd[id])]
	if c.stun > 0:
		return "You are stunned."
	var a: Dictionary = it["act"]
	var ar = c.ar
	if a["k"] == "recall":
		if duel_on and duel_pair.has(c):
			return "No recalling out of the duel ring."
		if c.recall > 0:
			return "Already recalling."
	c.act_cd[id] = f(a, "cd")
	var pw: float = lvl_mult(c) * c.pow * (1.0 + c_ap(c))
	match a["k"]:
		"rampage":
			c.buffs.append({"t": f(a, "dur"), "as": f(a, "as"), "lsp": f(a, "lsp")})
			add_fx(ar, {"type": "ring", "p": c.p, "r": 50.0, "col": Color("#ff5040"), "t": 0.5, "dur": 0.5, "follow": c})
		"teamshield":
			var amt: float = c.max_hp * f(a, "pct")
			for o in ar.champs:
				if not o.dead and o.pl.team == c.pl.team and o.p.distance_to(c.p) <= f(a, "r"):
					o.shield += amt
					o.shield_t = maxf(o.shield_t, 6.0)
					add_fx(ar, {"type": "ring", "p": o.p, "r": 40.0, "col": Color("#9fd8ff"), "t": 0.6, "dur": 0.6, "follow": o})
		"burst":
			var bp: Vector2 = aim_at(c, tp, f(a, "range"))["pt"]
			add_fx(ar, {"type": "ring", "p": bp, "r": f(a, "r"), "col": Color("#8fd0ff"), "t": 0.5, "dur": 0.5, "fill": true})
			burst(ar, bp, Color("#9fdcff"), 26, 200)
			for m in mons_in(ar, bp, f(a, "r")):
				hurt(ar, m, f(a, "dmg") * pw, c)
		"flight", "shadowstep":
			var from: Vector2 = c.p
			c.p = walk_clamp(aim_at(c, tp, f(a, "range"))["pt"])
			c.moving = false
			c.route = []
			add_fx(ar, {"type": "beam", "p": from, "p2": c.p, "w": 10.0, "col": Color("#ffb040") if a["k"] == "flight" else Color("#b080ff"), "t": 0.3, "dur": 0.3})
			burst(ar, c.p, Color("#ffb040") if a["k"] == "flight" else Color("#b080ff"), 18, 150)
			if a["k"] == "flight":
				heal_champ(c, c.max_hp * f(a, "heal"))
			else:
				var tgt = nearest_mon(ar, c.p, 160.0)
				if tgt != null:
					hurt(ar, tgt, c_dmg(c) * f(a, "mult"), c, true)
		"firestorm":
			add_fx(ar, {"type": "ring", "p": c.p, "r": f(a, "r"), "col": Color("#ff7a2a"), "t": 0.5, "dur": 0.5, "fill": true})
			burst(ar, c.p, Color("#ffb040"), 30, 220)
			for m in mons_in(ar, c.p, f(a, "r")):
				hurt(ar, m, f(a, "dmg") * lvl_mult(c) * c.pow, c)
				if not m.dead:
					m.burn_dps = f(a, "burn") * lvl_mult(c)
					m.burn_t = f(a, "dur")
					m.burn_src = c
		"thunder":
			var start = nearest_mon(ar, aim_at(c, tp, f(a, "range"))["pt"], 200.0)
			if start == null:
				start = nearest_mon(ar, c.p, f(a, "range"))
			if start != null:
				chain_hit(ar, c, start, f(a, "dmg") * pw, int(a["n"]), 200.0, {})
				add_fx(ar, {"type": "flash", "col": Color("#bfe3ff"), "t": 0.25, "dur": 0.25})
		"invuln":
			c.inv_t = f(a, "dur")
			add_fx(ar, {"type": "ring", "p": c.p, "r": 36.0, "col": Color("#ffe08a"), "t": f(a, "dur"), "dur": f(a, "dur"), "follow": c})
		"golden":
			c.golden_t = f(a, "dur")
			add_fx(ar, {"type": "ring", "p": c.p, "r": 44.0, "col": Color("#ffd24a"), "t": 0.6, "dur": 0.6, "follow": c})
		"recall":
			# 0.26 Waystone: stand still for the channel, then recall_done teleports the hero to the plaza
			c.recall = f(a, "channel", 3.0)
			c.recall_id = id
			c.moving = false
			c.route = []
			c.order = "idle"
			c.cur_tgt = null
			c.chasing = false
			c.chan = null
			add_fx(ar, {"type": "ring", "p": c.p, "r": 46.0, "col": Color("#8af0dc"), "t": c.recall, "dur": c.recall, "follow": c})
	add_text(ar, c.p + Vector2(0, -56), String(a["name"]).to_upper(), Color("#ffe08a"), 1.1, 13)
	c.anim_t = 0.45
	ev("item", ar, c.p, {"act": a["k"], "human": c.pl.id == local})
	return ""


# 0.26 Waystone of the Ward: where Recall lands (on the open plaza between the Armory and the crystal, inside
# the fountain's reach and the Armory's ring, clear of the Armory's roof).
static func recall_spot(c) -> Vector2:
	return walk_clamp(CORE + Vector2(-150.0 + (c.home - 1.5) * 36.0, -75.0))


# A Recall channel ends early (order, cast, stun, knock): the item's cooldown is given back.
func recall_cancel(c) -> void:
	if c.recall <= 0:
		return
	c.recall = 0.0
	if c.recall_id != "":
		c.act_cd[c.recall_id] = 0.0
	if c.ar != null:
		add_text(c.ar, c.p + Vector2(0, -56), "RECALL BROKEN", Color("#ffb080"), 1.0, 12)


# The channel finished: flash out, land on the plaza by the crystal.
func recall_done(ar, c) -> void:
	c.recall = 0.0
	var from: Vector2 = c.p
	add_fx(ar, {"type": "ring", "p": from, "r": 70.0, "col": Color("#8af0dc"), "t": 0.5, "dur": 0.5})
	burst(ar, from, Color("#bffff2"), 16, 150)
	c.p = recall_spot(c)
	c.moving = false
	c.route = []
	c.order = "idle"
	c.cur_tgt = null
	c.ai_tgt = null
	c.anchor = c.p
	c.face = (CORE - c.p).angle()
	add_fx(ar, {"type": "ring", "p": c.p, "r": 70.0, "col": Color("#8af0dc"), "t": 0.6, "dur": 0.6, "fill": true})
	burst(ar, c.p, Color("#bffff2"), 22, 170)
	add_text(ar, c.p + Vector2(0, -56), "HOME", Color("#8af0dc"), 1.1, 13)
	ev("item", ar, c.p, {"act": "recall_done", "human": c.pl.id == local})


# The inventory slot holding a ready Recall item, or -1.
func recall_slot(c) -> int:
	for slot in c.items.size():
		var it := GameData.item(c.items[slot])
		if it.has("act") and it["act"]["k"] == "recall" and act_ready(c, c.items[slot]):
			return slot
	return -1


# When AI heroes use their item actives.
func ai_items(ar, c, best, live: Array) -> void:
	if c.pl.diff == 0 or c.dead:
		return
	for slot in c.items.size():
		var id: String = c.items[slot]
		var it := GameData.item(id)
		if not it.has("act") or not act_ready(c, id):
			continue
		var a: Dictionary = it["act"]
		var big: bool = best != null and (best.max_hp > 2000 or best is Champ)
		var ok := false
		var tp: Vector2 = best.p if best != null else c.p
		match a["k"]:
			"rampage":
				ok = best != null and best.p.distance_to(c.p) < c_range(c) + 60 and (big or count_near(live, c.p, 250) >= 4)
			"teamshield":
				for o in ar.champs:
					if not o.dead and o.pl.team == c.pl.team and o.hp < o.max_hp * 0.45 and o.p.distance_to(c.p) < f(a, "r"):
						ok = true
			"burst", "thunder":
				ok = best != null and best.p.distance_to(c.p) < f(a, "range") and (big or count_near(live, best.p, f(a, "r", 200)) >= 4)
			"firestorm":
				ok = count_near(live, c.p, f(a, "r")) >= 4 or (big and best.p.distance_to(c.p) < f(a, "r"))
			"flight":
				if c.hp < c.max_hp * 0.35:
					ok = true
					tp = c.p + (CORE - c.p).normalized() * f(a, "range")
			"shadowstep":
				ok = best != null and big and best.p.distance_to(c.p) < f(a, "range")
			"invuln":
				ok = c.hp < c.max_hp * 0.3 and (c.attackers > 0 or best is Champ or not ar.mpend.is_empty())
			"golden":
				ok = live.size() >= 10
			"recall":
				# called home to the crystal from far down the road, with nothing in melee reach
				var cmd: Dictionary = team_cmd[c.pl.team]
				var home_call: bool = ar.def_who.has(c) or (not cmd.is_empty() and cmd["k"] == "crystal" and cmd["who"].has(c))
				ok = home_call and c.p.distance_to(CORE) > 1400.0 and count_near(live, c.p, 160) == 0 and not duel_on
		if ok:
			use_item(c, slot, tp)
			return


# ---------------------------------------------------------------- the neutral camps
# 0.26: three camps stand off each team's road (Sim.CAMPS, from MAPS[i]["camps"]): the Ancient Golem between the
# roads, a wolf pack in the forward half and a wisp grove near the confluence. Each has its own pacing (first
# round, respawn), its own fighting style and its own blessing for the team that clears it.
const CAMP_FIRST := 5          # the Ancient camp first appears at this round (CAMP_KINDS["ancient"]["first"])
const CAMP_RESPAWN := 120.0
const BLESS_TIME := 75.0
const CAMP_KINDS := {
	"ancient": {"name": "Ancient Camp", "leader": "ancient", "guard": "ancient_guard", "guards": 2, "first": 5, "respawn": 120.0,
		"bless": "Ancient's Blessing", "col": "#ffd24a", "buff": {"dmg": 1.2, "as": 1.2}, "short": "+20% damage and attack speed", "knob": ""},
	"beast": {"name": "Packlord's Den", "leader": "packlord", "guard": "pack_wolf", "guards": 3, "first": 3, "respawn": 100.0,
		"bless": "Packlord's Hunt", "col": "#ff9a5a", "buff": {"ms": 1.15, "lsp": 0.08, "regen_add": 6.0}, "short": "+15% move speed, 8% life steal and regeneration", "knob": "camp_k:beast"},
	"spirit": {"name": "Wisp Grove", "leader": "wisp_mother", "guard": "grave_wisp", "guards": 2, "first": 7, "respawn": 140.0,
		"bless": "Wisp Veil", "col": "#a6e0ff", "buff": {"cdr_add": 0.15, "veil": 1.0}, "short": "15% cooldown reduction and immunity to slows", "knob": "camp_k:spirit"},
}
const CAMP_CHASE := 520.0      # a pack charges heroes this far from its clearing...
const CAMP_LEASH := 640.0      # ...and gives up and trots home past this


# The camp kinds this match uses: every kind in skirmish and Survival; the campaign keeps only the Ancient
# unless a chapter's cfg names its "camps"; the tutorial shows the Ancient alone.
func camp_kinds_on() -> Array:
	if not camp_on:
		return []
	if cfg.has("camps"):
		return cfg["camps"]
	if not cfg.is_empty() or mode == "tutorial":
		return ["ancient"]
	return ["ancient", "beast", "spirit"]


func camp_index(kind: String) -> int:
	for ci in CAMPS.size():
		if String(CAMPS[ci]["kind"]) == kind:
			return ci
	return -1


func camp_pos(ci: int) -> Vector2:
	return CAMPS[ci]["pos"]


func camp_def(ci: int) -> Dictionary:
	return CAMP_KINDS[String(CAMPS[ci]["kind"])]


func _camp_arrays(ar) -> void:
	while ar.camps_t.size() < CAMPS.size():
		ar.camps_t.append(-1.0)
		ar.camps_up.append(false)


func spawn_camp(ar, ci := 0) -> void:
	_camp_arrays(ar)
	var kd := camp_def(ci)
	var cp := camp_pos(ci)
	var hm := hp_mult(round_no)
	var boss := spawn_mon(ar, kd["leader"], 0, null, hm)
	boss.p = cp
	boss.wi = 0
	boss.camp_i = ci
	boss.camp_home = cp
	var n: int = kd["guards"]
	for k in n:
		var g := spawn_mon(ar, kd["guard"], 0, null, hm)
		g.p = cp + Vector2.from_angle(TAU * k / n + 0.6) * Vector2(84.0, 52.0)
		g.wi = 0
		g.camp_i = ci
		g.camp_home = g.p
	ar.camps_up[ci] = true
	ar.camps_t[ci] = -1.0
	ev("camp_up", ar, cp, {"team": ar.team, "kind": String(CAMPS[ci]["kind"]), "ci": ci})


func camp_reward(ci: int) -> int:
	var kd := camp_def(ci)
	var k := 1.0 if String(kd["knob"]) == "" else tv(String(kd["knob"]))
	if mode == "survival":
		return roundi((40 + 4 * round_no) * k)
	return roundi((tv("camp_base") + tv("camp_round") * round_no) * k)


func camp_cleared(ar, ci := 0) -> void:
	_camp_arrays(ar)
	var kd := camp_def(ci)
	var kind := String(CAMPS[ci]["kind"])
	var cp := camp_pos(ci)
	ar.camps_up[ci] = false
	ar.camps_t[ci] = float(kd["respawn"])
	ar.bless[kind] = BLESS_TIME
	var reward := camp_reward(ci)
	var col := Color(String(kd["col"]))
	for c in ar.champs:
		if c.pl.team != ar.team:
			continue
		c.buffs = c.buffs.filter(func(b): return String(b.get("bless", "")) != kind)
		var b: Dictionary = (kd["buff"] as Dictionary).duplicate()
		b["t"] = BLESS_TIME
		b["bless"] = kind
		c.buffs.append(b)
		give_gold(c.pl, reward)
		if not c.dead:
			add_fx(ar, {"type": "ring", "p": c.p, "r": 44.0, "col": col, "t": 0.8, "dur": 0.8, "follow": c})
	add_text(ar, cp + Vector2(0, -70), String(kd["bless"]).to_upper(), col, 2.0, 15)
	feed.push_front({"t": t, "team": ar.team, "who": TEAM_NAMES[ar.team], "camp": reward, "kind": kind})
	ev("camp_cleared", ar, cp, {"team": ar.team, "gold": reward, "kind": kind, "ci": ci})


func upd_camp(ar, dt: float) -> void:
	for k in ar.bless.keys():
		if ar.bless[k] > 0:
			ar.bless[k] -= dt
	if mode == "tutorial" and not waves_on:
		return
	if not camp_on:
		return
	_camp_arrays(ar)
	var on := camp_kinds_on()
	for ci in CAMPS.size():
		if not on.has(String(CAMPS[ci]["kind"])):
			continue
		if not ar.camps_up[ci] and ar.camps_t[ci] < 0 and round_no >= int(camp_def(ci)["first"]):
			ar.camps_t[ci] = 0.0
		if ar.camps_t[ci] >= 0 and not ar.camps_up[ci]:
			ar.camps_t[ci] -= dt
			if ar.camps_t[ci] <= 0:
				spawn_camp(ar, ci)


# Whether any camp of this team is standing (HUD, bots, tutorial).
func any_camp_up(ar) -> bool:
	for u in ar.camps_up:
		if u:
			return true
	return false


# A camp monster's turn: the ranged kinds (golems, the wisp mother) stand and shoot while provoked (see the
# ranged block of upd_mon); the melee kinds (the pack, the wisps) charge the hero that struck them, hit like a
# lane monster and trot back to their spot in the clearing when the fight is over or strays too far.
func camp_act(ar, m, dt: float) -> void:
	if m.spd <= 0.0 or m.dps <= 0 or m.d.has("ranged"):
		return
	var c = m.aggro
	if c != null and (c.dead or (c is Champ and c.ar != ar) or m.provoked <= 0 or c.p.distance_to(m.camp_home) > CAMP_LEASH):
		m.aggro = null
		c = null
		if m.provoked > 0:
			m.provoked = 0.0   # the chase is over: the pack goes home and settles
	if c == null and m.provoked > 0:
		var bd := CAMP_CHASE
		if m.last != null and m.last is Champ and not m.last.dead and m.last.ar == ar and m.last.p.distance_to(m.camp_home) < bd:
			c = m.last
		else:
			for o in ar.champs:
				if o.dead:
					continue
				var od: float = o.p.distance_to(m.camp_home)
				if od < bd:
					bd = od
					c = o
		if c != null:
			m.aggro = c
			m.aggro_from = m.camp_home
	var sp: float = m.spd * m.haste * ((1.0 - m.slow) if m.slow_t > 0 else 1.0)
	if m.frenzy > 0:
		sp *= 1.0 + m.frenzy * (1.0 - m.hp / m.max_hp)
	if c == null:
		var hv: Vector2 = m.camp_home - m.p
		var hd := hv.length()
		if hd > 3.0:
			m.p += hv / hd * minf(hd, sp * dt)
			m.ang = lerp_angle(m.ang, hv.angle(), minf(1.0, dt * 8.0))
			if not m.fly:
				m.p = bridge_push(m.p, m.r)
		return
	var reach: float = m.r + c.r + 8.0
	var dv: Vector2 = c.p - m.p
	var d := dv.length()
	m.ang = lerp_angle(m.ang, dv.angle(), minf(1.0, dt * 10.0))
	if d > reach:
		m.p += dv / maxf(d, 0.001) * minf(d - reach + 1.0, sp * dt)
		if not m.fly:
			m.p = bridge_push(m.p, m.r)
		return
	if m.hit_cd <= 0:
		m.hit_cd = MON_HIT_EVERY
		m.anim_t = 0.4
		var hd: float = m.dps * MON_HIT_EVERY * MON_HIT_K
		hurt_champ(ar, c, hd, m)
		if m.d.has("drain"):
			m.hp = minf(m.max_hp, m.hp + hd * f(m.d, "drain"))
		if c.uniq.has("thorns") and not m.dead:
			hurt(ar, m, (hd * f(c.uniq["thorns"], "pct") + f(c.uniq["thorns"], "flat")) * lvl_mult(c), c, false, true)
		ev("mhit", ar, m.p, {"big": m.r >= 14})
		add_fx(ar, {"type": "slash", "p": m.p, "a": dv.angle(), "col": Color("#ff8a6a"), "t": 0.14, "dur": 0.14, "small": m.r < 11})


# ---------------------------------------------------------------- player commands
# Everything a human player does to the match goes through here, so in multiplayer every computer
# applies the same commands on the same tick. Targets travel as ["m", uid] or ["c", player id].
func ref_of(o) -> Array:
	if o is Mon:
		return ["m", o.uid]
	if o is Champ:
		return ["c", o.pl.id]
	return []


func resolve(r):
	if not (r is Array) or r.size() < 2 or not _is_int(r[1]):
		return null
	if r[0] == "c":
		var i := int(r[1])
		return players[i].champ if i >= 0 and i < players.size() else null
	var uid := int(r[1])
	for ar in arenas + [duel_ar]:
		for m in ar.mons:
			if m.uid == uid:
				return m
	return null


func apply_cmd(pid: int, k: String, a: Array):
	if pid < 0 or pid >= players.size():
		return "none"
	var pl = players[pid]
	var c = pl.champ
	tune_bind()
	if not _cmd_ok(k, a):
		return "none"
	if k == "tune":
		# 0.18.1 live balance: [name, value]; allowed at any time (a duel included), it is a referee's command
		return tune_cmd(String(a[0]), float(a[1]))
	# while a duel is on, only the two in the ring may act; everyone else watches
	if duel_on and not duel_pair.has(c) and not k in ["surrender", "drop", "rejoin", "auto"]:
		return "duel"
	if duel_on and duel_pair.has(c) and not k in ["order", "cast", "item", "potion", "surrender", "drop", "rejoin", "auto"]:
		return "duel"   # the duelists fight with what they brought: no shopping or sends mid-duel
	if duel_on and duel_pair.has(c) and duel_count > 0.0 and k in ["order", "cast", "item", "potion"]:
		return "countdown"   # hands off until the count reaches zero
	match k:
		"order":
			var tgt = resolve(a[2]) if a.size() > 2 else null
			if a.size() > 2 and not a[2].is_empty() and tgt == null:
				return false
			hero_order(c, String(a[0]), a[1] if a.size() > 1 else Vector2.ZERO, tgt)
			return true
		"cast":
			return _in_duel_view(c, func(): return cast(c.ar, c, int(a[0]), a[1]))
		"send":
			return do_send(pl, int(a[0]), int(a[1]))
		"unsend":
			return unsend(pl, int(a[0]))
		"swap":
			return swap_items(c, int(a[0]), int(a[1]))
		"skip":
			return skip_cards()
		"build":
			return buy_building(pl, int(a[0]))
		"learn":
			return learn(c, int(a[0]))
		"sell":
			return sell_item(pl, int(a[0]))
		"potion":
			return use_potion(c)
		"buypot":
			return buy_potion(pl)
		"scroll":
			return buy_scroll(pl, String(a[0]))
		"buy":
			return buy_item(pl, String(a[0]))
		"core":
			return buy_core(pl, int(a[0]))
		"buyback":
			return buyback(pl)
		"vote":
			return vote_cmd(pl, int(a[0]) != 0)
		"command":
			return command(pl.team, String(a[0]), a[1])
		"item":
			var res = _in_duel_view(c, func(): return use_item(c, int(a[0]), a[1]))
			return res
		"auto":
			c.auto_acq = bool(a[0])
			return true
		"boon":
			return pick_boon(int(a[0]))
		"card":
			return pick_card(int(a[0]))
		"reroll":
			return reroll_cards()
		"banish":
			return banish_card(int(a[0]))
		"surrender":
			if not over:
				arenas[pl.team].core_hp = 0
				over = true
				winner = 1 - pl.team
				surrender = true
			return true
		"drop":
			# a player left a multiplayer match: an AI takes over their hero
			pl.human = false
			pl.name += " (AI)"
			c.pow = DIFF_HERO[1]
			return true
		"rejoin":
			# 0.25: the player came back; the hero is theirs again
			pl.human = true
			pl.name = pl.name.trim_suffix(" (AI)")
			c.pow = 1.0
			return true
	return "none"


# A hero's own instant abilities and item actives look for targets in its arena's monster list. In the
# duel ring that list is only filled while the ring updates, so a command from a player (which arrives
# between updates) runs with the foe in view, exactly as the AI's casts do.
func _in_duel_view(c, fn: Callable):
	if duel_on and c.ar == duel_ar and duel_pair.size() == 2 and duel_ar.mons.is_empty():
		duel_ar.mons = [duel_pair[1] if duel_pair[0] == c else duel_pair[0]]
		var r = fn.call()
		duel_ar.mons = []
		return r
	return fn.call()


# Swaps two inventory slots (item levels are keyed by id, so nothing else changes). Returns true/false.
func swap_items(c, a: int, b: int) -> bool:
	if a < 0 or b < 0 or a >= GameData.INV_SLOTS or b >= GameData.INV_SLOTS or a == b:
		return false
	if a >= c.items.size() or b >= c.items.size():
		return false
	var tmp = c.items[a]
	c.items[a] = c.items[b]
	c.items[b] = tmp
	return true


# Commands can arrive over the network: check their shape before touching the match.
static func _is_int(v) -> bool:
	return v is int or v is float or v is bool


static func _idx_ok(v, n: int) -> bool:
	return _is_int(v) and int(v) >= 0 and int(v) < n


func _cmd_ok(k: String, a: Array) -> bool:
	var need := {"banish": 1, "order": 1, "cast": 2, "send": 2, "build": 1, "learn": 1, "sell": 1, "scroll": 1, "buy": 1, "core": 1, "command": 2, "item": 2, "auto": 1,
		"boon": 1, "card": 1, "unsend": 1, "swap": 2, "skip": 0, "potion": 0, "buypot": 0, "buyback": 0, "reroll": 0, "surrender": 0, "drop": 0, "rejoin": 0, "vote": 1, "tune": 2}
	if a.size() < int(need.get(k, 0)):
		return false
	match k:
		"tune":
			return a[0] is String and Tune.DEFS.has(String(a[0])) and (a[1] is float or a[1] is int)
		"cast", "learn":
			return _idx_ok(a[0], 4) and (k == "learn" or a[1] is Vector2)
		"send":
			return _idx_ok(a[0], GameData.SENDS.size()) and _idx_ok(a[1], 2)
		"unsend":
			return _idx_ok(a[0], 2)
		"build":
			return _idx_ok(a[0], GameData.BUILDINGS.size())
		"core":
			return _idx_ok(a[0], GameData.CORE_UPS.size())
		"sell", "item":
			return _idx_ok(a[0], GameData.INV_SLOTS) and (k == "sell" or a[1] is Vector2)
		"swap":
			return _idx_ok(a[0], GameData.INV_SLOTS) and _idx_ok(a[1], GameData.INV_SLOTS)
		"order":
			return a[0] is String and String(a[0]) in ["move", "amove", "attack", "stop", "hold"] and (a.size() < 2 or a[1] is Vector2) and (a.size() < 3 or a[2] is Array)
		"command":
			return a[0] is String and String(a[0]) in ["help", "boss", "crystal", "lanes"] and a[1] is Vector2
		"boon", "card", "banish":
			return _idx_ok(a[0], SurvivalData.OFFER_SIZE + 1)
		"buy":
			return a[0] is String and not GameData.item(String(a[0])).is_empty()
		"scroll":
			return a[0] is String and not GameData.scroll(String(a[0])).is_empty()
		"auto", "vote":
			return a[0] is bool or _is_int(a[0])
	return true


# A fingerprint of the match state; multiplayer peers compare it to catch desyncs.
func checksum() -> int:
	var h := 0.0
	h += float(round_no) * 7.0 + float(next_uid) * 13.0 + float(Tune.hash_of(tune) % 100000) * 0.37
	for pl in players:
		h += pl.gold * 1.3 + float(pl.income) * 3.1 + float(pl.tech) * 5.7
		var c = pl.champ
		h += c.hp * 0.7 + c.p.x * 0.11 + c.p.y * 0.13 + float(c.lvl) * 2.0
	for ar in arenas:
		h += ar.core_hp * 0.9 + float(ar.mons.size()) * 17.0 + float(ar.sums.size()) * 11.0
		for su in ar.sums:
			h += su.hp * 0.01 + su.p.x * 0.002
		for m in ar.mons:
			h += m.hp * 0.01 + m.p.x * 0.003 + m.p.y * 0.005
	return int(h * 1000.0) ^ int(rng.state & 0xffffffff)
␀␀␀␀␀␀␀␀␀␀␀␀␀␀# Loads the pre-rendered sprite sheets and works out frames and scales.
# Unit sheets: one column per facing direction (16), one row per pose. Prop sheets: a single frame.
class_name Sprites
extends RefCounted

const HERO_UNIT := 30.0            # world units per model unit for heroes
const MON_K := 1.6                 # monster scale: world units per model unit = r * MON_K / foot_r
const WALK := [1, 0, 2, 0]         # walk cycle over the three poses
const FLAP := [0, 1, 2, 1]         # wing-flap cycle
const PROP_UNITS := {"castle_ward": 56.0, "castle_ember": 56.0, "crystal_ward": 40.0, "crystal_ember": 40.0,
	"shop": 46.0, "bld_warren": 34.0, "bld_lodge": 34.0, "bld_quarry": 34.0, "bld_gate": 34.0, "bld_spire": 34.0, "bld_void": 34.0}

static var _cache := {}


static func meta(name: String) -> Dictionary:
	return SpriteMeta.SHEETS.get(name, {})


static func tex(name: String) -> Texture2D:
	if _cache.has(name):
		return _cache[name]
	var t: Texture2D = null
	var m := meta(name)
	if not m.is_empty():
		var path := "res://art/%s/%s.png" % ["units" if int(m["dirs"]) > 1 else "props", name]
		if ResourceLoader.exists(path):
			t = load(path)
	_cache[name] = t
	return t


static func dir_index(ang: float, dirs := 16) -> int:
	return int(round(wrapf(ang, 0.0, TAU) / (TAU / dirs))) % dirs


# anim: seconds left of an attack / cast animation (wind-up for the first part, then the strike)
static func pose_at(name: String, t: float, phase: float, moving: bool, anim := 0.0, anim_len := 0.4) -> int:
	var m := meta(name)
	if m.is_empty() or int(m["poses"]) < 3:
		return 0
	if anim > 0.0 and int(m["poses"]) >= 5:
		return 3 if anim > anim_len * 0.45 else 4
	if m["anim"] == "fly":
		return FLAP[int(t * 8.0 + phase) % 4]
	if not moving:
		return 0
	return WALK[int(t * 7.0 + phase) % 4]


static func region(name: String, ang: float, pose: int) -> Rect2:
	var m := meta(name)
	var fr := float(m["frame"])
	var d := dir_index(ang, int(m["dirs"])) if int(m["dirs"]) > 1 else 0
	return Rect2(d * fr, mini(pose, int(m["poses"]) - 1) * fr, fr, fr)


# Sets up a Sprite2D so that its position is the model's ground point and one model unit = `unit` world units.
static func setup(sp: Sprite2D, name: String, unit: float) -> bool:
	var t := tex(name)
	if t == null:
		return false
	var m := meta(name)
	var fr := float(m["frame"])
	sp.texture = t
	sp.centered = false
	sp.region_enabled = int(m["dirs"]) > 1 or int(m["poses"]) > 1
	if sp.region_enabled:
		sp.region_rect = Rect2(0, 0, fr, fr)
	sp.offset = Vector2(-fr / 2.0, -fr * float(m["foot"]))
	var k := float(m["span"]) * unit / fr
	sp.scale = Vector2(k, k)
	return true


static func mon_sheet(kind: String) -> String:
	var d: Dictionary = GameData.MON.get(kind, {})
	if d.has("sheet"):
		return d["sheet"]
	return kind if kind.begins_with("boss_") else "mon_" + kind


# Display size rules, on the model's real bounding box in world units (a hero is ~75 tall, ~55 wide). Hitboxes (r) are untouched, this is only the model scale.
const BOSS_K := 1.2               # bosses draw 20% larger than the r rule ...
const BOSS_MIN := 200.0           # ... and their largest dimension is at least this (above every non-boss) ...
const BOSS_MAX := 300.0           # ... and at most this
const MON_MAX := 170.0            # tier-6 monsters stay well below the bosses
