static func tier_frame(ci: CanvasItem, r: Rect2, tier: int, t := 0.0) -> void:
	var col: Color = TIER_COL[clampi(tier, 0, 4)]
	if tier >= 4:
		var pulse := 0.75 + 0.25 * sin(t * 3.0)
		for i in 4:
			ci.draw_rect(r.grow(1.0 + i * 1.5), Color(col, (0.32 - i * 0.07) * pulse), false, 1.5)
	ci.draw_rect(r.grow(1.5), Color(0, 0, 0, 0.9), false, 1.5)
	ci.draw_rect(r, col, false, 2.0 if tier < 3 else 2.5)
	ci.draw_rect(r.grow(-2), col.darkened(0.55), false, 1.0)
	if tier >= 3:
		# corner studs mark the top tiers at a glance
		for p in [r.position, Vector2(r.end.x, r.position.y), Vector2(r.position.x, r.end.y), r.end]:
			ci.draw_rect(Rect2(p - Vector2(2.5, 2.5), Vector2(5, 5)), col.lightened(0.35))


