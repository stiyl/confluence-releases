static func cost(t: Dictionary) -> int:
	return int(t.get("cost", 1))


static func points_for(xp: int) -> int:
	var n := 0
	for need in POINT_AT:
		if xp >= need:
			n += 1
	return mini(n, MAX_POINTS)


# Talent experience needed for the next point, or -1 at the cap.
static func next_point_at(xp: int) -> int:
	for need in POINT_AT:
		if xp < need:
			return need
	return -1


static func find(hero: String, id: String) -> Dictionary:
	for t in tree(hero):
		if t["id"] == id:
			return t
	return {}


static func spent(hero: String, taken: Array) -> int:
	var s := 0
	for id in taken:
		var t := find(hero, id)
		if not t.is_empty():
			s += cost(t)
	return s


# "" if the talent can be taken now, otherwise why not.
static func why_not(hero: String, taken: Array, id: String, points: int) -> String:
	var t := find(hero, id)
	if t.is_empty():
		return "Unknown talent."
	if taken.has(id):
		return "Already taken."
	for r in t.get("req", []):
		if not taken.has(r):
			return "Needs %s first." % find(hero, r)["name"]
	var any: Array = t.get("req_any", [])
	if not any.is_empty() and not any.any(func(r): return taken.has(r)):
		return "Needs %s or %s first." % [find(hero, any[0])["name"], find(hero, any[1])["name"]]
	if spent(hero, taken) + cost(t) > points:
		return "Not enough talent points (%d needed)." % cost(t)
	return ""


# Removing a talent also removes everything that depended on it.
static func without(hero: String, taken: Array, id: String) -> Array:
	var out: Array = taken.filter(func(x): return x != id)
	var changed := true
	while changed:
		changed = false
		for x in out.duplicate():
			var t := find(hero, x)
			var ok := true
			for r in t.get("req", []):
				if not out.has(r):
					ok = false
			var any: Array = t.get("req_any", [])
			if not any.is_empty() and not any.any(func(r): return out.has(r)):
				ok = false
			if not ok:
				out.erase(x)
				changed = true
	return out


# The effect dictionaries of a set of talents, for the simulation.
static func effects(hero: String, taken: Array) -> Array:
	var out: Array = []
	for id in taken:
		var t := find(hero, id)
		if not t.is_empty():
			out.append(t["fx"])
	return out
␀␀␀␀␀␀␀# Loads the map layout (art/layout.json) and the minimap image produced by tools/terrain/build_terrain.py.
class_name Terrain
extends RefCounted

static var layout := {}
static var dressing := {}             # dressing.json (tools/terrain): what the 3D view places: [x, y, model, scale, yaw]
static var minimap: Texture2D = null
static var plots: Array = []          # 16 Vector2: team slot * 4 + building index
static var braziers: Array = []
static var lamps: Array = []
static var castle := Vector2(5020, 1024)
static var map_id := 0


static func dir() -> String:
	return String(Sim.MAPS[map_id]["dir"])


static func path(file: String) -> String:
	if dir() == "":
		return "res://art/" + ("layout.json" if file == "layout.json" else "terrain/" + file)
	return dir() + file


# A ground texture: the map's own version if it has one, otherwise the shared one.
static func tex_path(file: String) -> String:
	if dir() != "" and ResourceLoader.exists(dir() + file):
		return dir() + file
	return "res://art/terrain/" + file


static func set_map(i: int) -> void:
	if i == map_id and not layout.is_empty():
		return
	map_id = i
	layout = {}
	dressing = {}
	braziers = []
	lamps = []
	plots = []
	minimap = null
	ensure()


static func ensure() -> void:
	if not layout.is_empty():
		return
	var txt := FileAccess.get_file_as_string(path("layout.json"))
	if txt == "":
		layout = {"props": [], "plots": []}
	else:
		layout = JSON.parse_string(txt)
	plots = []
	for p in layout.get("plots", []):
		plots.append(Vector2(p[0], p[1]))
	if layout.has("castle"):
		castle = Vector2(layout["castle"][0], layout["castle"][1])
	var dtxt := FileAccess.get_file_as_string(path("dressing.json")) if FileAccess.file_exists(path("dressing.json")) else ""
	dressing = JSON.parse_string(dtxt) if dtxt != "" else {}
	if dressing == null:
		dressing = {}
	for it in props():
		if it[2] == "brazier":
			braziers.append(Vector2(it[0], it[1]))
		elif it[2] == "lamp":
			lamps.append(Vector2(it[0], it[1]))
	if ResourceLoader.exists(path("minimap.png")):
		minimap = load(path("minimap.png"))


# The props the 3D view draws: the dressing when the terrain tools wrote one (border forest, authored yaws,
# monument, bridges, camp ruins, yard fences), else the layout's own list. Visual only: gameplay never reads it.
static func props() -> Array:
	if dressing.has("props"):
		return dressing["props"]
	return layout.get("props", [])


static func plot(slot: int, k: int) -> Vector2:
	ensure()
	var i := slot * 4 + k
	return plots[i] if i < plots.size() else Sim.CORE
