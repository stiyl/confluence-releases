const NONE := {}                       # the empty set (defaults), shared so binding it allocates nothing
static var DEFS: Dictionary = {}       # every knob: BASE_DEFS + the per-send price / income knobs (see _static_init)
static var LEGACY: Dictionary = {}     # every knob at its 0.23 shipped value: bound when the knobs don't apply (Survival, tutorial, campaign)
static var BAKED: Dictionary = {}      # per-send knobs the built-in file sets explicitly: they win over the curve / cost knobs like an override


static func _static_init() -> void:
	DEFS = BASE_DEFS.duplicate(true)
	for sd in GameData.SENDS:
		var kind := String(sd["k"])
		var nm := String(sd["name"])
		var bname := String(GameData.BUILDINGS[int(sd["b"])]["name"])
		DEFS["send_cost:" + kind] = {"def": float(sd["cost"]), "min": 5.0, "max": 20000.0, "step": 1.0, "group": "Monsters", "label": nm + " price", "fmt": "int",
			"kind": kind, "b": int(sd["b"]), "what": "cost", "help": "Gold price of a %s send (%s). An explicit price wins over the Send cost Ã— knob." % [nm, bname]}
		DEFS["send_inc:" + kind] = {"def": float(sd["inc"]), "min": -2000.0, "max": 2000.0, "step": 1.0, "group": "Monsters", "label": nm + " income", "fmt": "int",
			"kind": kind, "b": int(sd["b"]), "what": "inc", "help": "Income per round a %s send gives (negative: a power send that costs income). An explicit value wins over the send curve and the building multiplier." % nm}
	_bake_defaults(DEFAULTS_2026_10_31)


# Lays a balance file's values over the 0.23 defaults (see DEFAULTS_2026_10_31). Per-send values are worked out
# with the 0.23 rules first (curve, cost knob), so the result matches loading the file.
static func _bake_defaults(file: Dictionary) -> void:
	LEGACY = {}
	for n in DEFS:
		LEGACY[n] = float(DEFS[n]["def"])
	var vals := clean(file)
	var eff := {}
	for k in GameData.SENDS.size():
		var kind := String(GameData.SENDS[k]["k"])
		eff["send_inc:" + kind] = float(send_inc(k, vals))
		eff["send_cost:" + kind] = float(send_cost(k, vals))
	for n in vals:
		if not String(n).begins_with("send_inc:") and not String(n).begins_with("send_cost:"):
			DEFS[n]["def"] = float(vals[n])
	for n in eff:
		if vals.has(n):
			BAKED[n] = true
		DEFS[n]["def"] = eff[n]
static var active: Dictionary = {}     # the running sim's set (bound by the sim; {} = defaults)
static var draft: Dictionary = {}      # the panel's set outside a match: the next single-player match / hosted match starts with it
static var _draft_loaded := false


# The value the running sim uses.
static func v(name: String) -> float:
	var ov = active.get(name)
	return float(ov) if ov != null else float(DEFS[name]["def"])


static func def_of(name: String) -> float:
	return float(DEFS[name]["def"])


static func names_in(group: String) -> Array:
	var out: Array = []
	for n in DEFS:
		if DEFS[n]["group"] == group:
			out.append(n)
	return out


# Snaps a value to the knob's step inside its range; the same arithmetic everywhere (it travels in the command anyway).
static func clamp_val(name: String, value: float) -> float:
	var d: Dictionary = DEFS[name]
	var st := float(d["step"])
	var x := clampf(value, float(d["min"]), float(d["max"]))
	x = snappedf(x, st)
	return snappedf(x, 0.000001)


static func is_default(name: String, value: float) -> bool:
	return absf(value - float(DEFS[name]["def"])) < 1e-6


# Non-default entries only, values snapped, unknown names dropped.
static func clean(vals: Dictionary) -> Dictionary:
	var out := {}
	for n in vals:
		if not DEFS.has(String(n)):
			continue
		var x := clamp_val(String(n), float(vals[n]))
		if not is_default(String(n), x):
			out[String(n)] = x
	return out


static func is_custom(vals: Dictionary) -> bool:
	return not clean(vals).is_empty()


static func set_knob(vals: Dictionary, name: String, value: float) -> void:
	var x := clamp_val(name, value)
	if is_default(name, x):
		vals.erase(name)
	else:
		vals[name] = x


static func value_in(vals: Dictionary, name: String) -> float:
	var ov = vals.get(name)
	return float(ov) if ov != null else float(DEFS[name]["def"])


# Checksum contribution: every client must hold the same set.
static func hash_of(vals: Dictionary) -> int:
	var h := 0
	var keys := vals.keys()
	keys.sort()
	for k in keys:
		h = (h * 31 + String(k).hash()) & 0x7fffffff
		h = (h * 31 + int(roundf(float(vals[k]) * 10000.0))) & 0x7fffffff
	return h


static func fmt(name: String, x: float) -> String:
	match String(DEFS[name].get("fmt", "x")):
		"int":
			return str(int(roundf(x)))
		"pct":
			return ("%.2f" % x).rstrip("0").rstrip(".") + "%"
		"s":
			return "%d s" % int(roundf(x))
		"bool":
			return "on" if x >= 0.5 else "off"
		"x3":
			return "%.3f" % x
		_:
			return "%.2f" % x


# ---------------------------------------------------------------- the send table through the curve
# Income of GameData.SENDS[k] (per round) under this set: the table value while the curve knobs are default
# (exact), otherwise recomputed from the curve lo% at 30 g .. hi% at 2600 g (log-position of the price) and the
# building multiplier. Power sends (negative income) keep the table.
static func send_inc(k: int, vals: Dictionary) -> int:
	var s: Dictionary = GameData.SENDS[k]
	var kn := "send_inc:" + String(s["k"])
	var ov = vals.get(kn)   # 0.18.5: a per-monster income override wins
	if ov != null:
		return roundi(float(ov))
	if BAKED.has(kn):
		return roundi(def_of(kn))   # 0.24: set by the built-in defaults file, which works like an override
	var inc := int(s["inc"])
	if inc < 0:
		return roundi(def_of(kn))
	var b := int(s["b"])
	var lo := value_in(vals, "send_rate_lo")
	var hi := value_in(vals, "send_rate_hi")
	var bm := value_in(vals, "send_inc_b%d" % b)
	if is_default("send_rate_lo", lo) and is_default("send_rate_hi", hi) and is_default("send_inc_b%d" % b, bm):
		return roundi(def_of(kn))   # the table (0.24: or the built-in file's curve value)
	var c := float(s["cost"])
	var u := log(c / 30.0) / log(2600.0 / 30.0)
	var rate := lo * pow(hi / maxf(0.0001, lo), u)
	return maxi(1, roundi(c * rate / 100.0 * bm))


# Table price of GameData.SENDS[k] under this set: the per-monster override, else the table x the Send cost knob.
static func send_cost(k: int, vals: Dictionary) -> int:
	var s: Dictionary = GameData.SENDS[k]
	var kn := "send_cost:" + String(s["k"])
	var ov = vals.get(kn)
	if ov != null:
		return roundi(float(ov))
	if BAKED.has(kn):
		return roundi(def_of(kn))   # 0.24: set by the built-in defaults file
	return roundi(float(s["cost"]) * value_in(vals, "send_cost_k"))


# The price the gift share is read from (the override when there is one).
static func send_price(kind: String, table: int) -> int:
	var ov = active.get("send_cost:" + kind)
	if ov == null and BAKED.has("send_cost:" + kind):
		ov = def_of("send_cost:" + kind)   # 0.24: the built-in file's price
	return roundi(float(ov)) if ov != null else table


# ---------------------------------------------------------------- JSON presets
static func to_json(vals: Dictionary) -> String:
	var d := {"confluence_balance": 1, "values": {}}
	var cl := clean(vals)
	var keys := cl.keys()
	keys.sort()
	for k in keys:
		d["values"][k] = cl[k]
	return JSON.stringify(d, "  ")


static func from_json(txt: String) -> Dictionary:
	var j = JSON.parse_string(txt)
	if not (j is Dictionary):
		return {}
	var vals = j.get("values", j)
	if not (vals is Dictionary):
		return {}
	return clean(vals)


static func exe_balance_dir() -> String:
	var d := OS.get_executable_path().get_base_dir()
	if d == "" or OS.has_feature("editor"):
		return ""
	return d.path_join("balance")


static func safe_name(name: String) -> String:
	var out := ""
	for ch in name.strip_edges():
		if ch.is_valid_identifier() or ch in "-_ ." or ch.is_valid_int():
			out += ch
	return out.strip_edges()


# Writes <name>.json under user://balance/ and beside the executable when that is writable. Returns the paths written.
static func save_preset(name: String, vals: Dictionary) -> Array:
	var nm := safe_name(name)
	if nm == "":
		return []
	var out: Array = []
	var txt := to_json(vals)
	for dir in [DIR, exe_balance_dir()]:
		if dir == "":
			continue
		DirAccess.make_dir_recursive_absolute(dir)
		var path: String = dir.path_join(nm + ".json") if not dir.ends_with("/") else dir + nm + ".json"
		var f := FileAccess.open(path, FileAccess.WRITE)
		if f == null:
			continue
		f.store_string(txt)
		f.close()
		out.append(ProjectSettings.globalize_path(path) if path.begins_with("user://") else path)
	return out


static func preset_path(name: String) -> String:
	return DIR + safe_name(name) + ".json"


static func load_preset(name: String) -> Dictionary:
	var p := preset_path(name)
	if not FileAccess.file_exists(p):
		var ed := exe_balance_dir()
		if ed != "" and FileAccess.file_exists(ed.path_join(safe_name(name) + ".json")):
			p = ed.path_join(safe_name(name) + ".json")
		else:
			return {}
	return from_json(FileAccess.get_file_as_string(p))


static func load_file(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	return from_json(FileAccess.get_file_as_string(path))


static func delete_preset(name: String) -> void:
	var nm := safe_name(name)
	for dir in [DIR, exe_balance_dir()]:
		if dir == "":
			continue
		var p: String = dir.path_join(nm + ".json") if not dir.ends_with("/") else dir + nm + ".json"
		if FileAccess.file_exists(p):
			DirAccess.remove_absolute(p)


# Preset names (without .json), the autosaved current set left out; user:// and the exe folder merged.
static func list_presets() -> Array:
	var names := {}
	for dir in [DIR, exe_balance_dir()]:
		if dir == "":
			continue
		var da := DirAccess.open(dir)
		if da == null:
			continue
		for fn in da.get_files():
			if fn.ends_with(".json") and not fn.begins_with("_"):
				names[fn.get_basename()] = true
	var out := names.keys()
	out.sort()
	return out


# The panel's set outside a match survives a restart (user://balance/_current.json).
static func load_draft() -> Dictionary:
	if not _draft_loaded:
		_draft_loaded = true
		draft = load_file(DIR + CURRENT + ".json")
	return draft


static func save_draft() -> void:
	DirAccess.make_dir_recursive_absolute(DIR)
	var f := FileAccess.open(DIR + CURRENT + ".json", FileAccess.WRITE)
	if f != null:
		f.store_string(to_json(draft))
		f.close()
