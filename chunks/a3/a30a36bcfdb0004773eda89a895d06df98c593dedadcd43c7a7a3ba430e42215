		refresh()
		return
	main.tune_change(name, v)
	refresh()


# Pulls every row's widgets from the live set; called on open, on every change and 4x a second while open.
func refresh() -> void:
	_busy = true
	var vals := live_set()
	var ro := read_only()
	for n in rows:
		var r: Dictionary = rows[n]
		var v := Tune.value_in(vals, n)
		var sl: HSlider = r["slider"]
		if absf(sl.value - v) > 1e-6:
			sl.set_value_no_signal(v)
		sl.editable = not ro
		var field: LineEdit = r["field"]
		if not field.has_focus():
			field.text = _num(n, v)
		field.editable = not ro
		var isd := Tune.is_default(n, v)
		var dl: Label = r["dflt"]
		dl.text = "" if isd else "default " + Tune.fmt(n, Tune.def_of(n))
		dl.add_theme_color_override("font_color", main.MUTED)
		(r["reset"] as Button).visible = not isd and not ro
		(r["mark"] as DefaultMark).lit = not isd
		(r["mark"] as DefaultMark).queue_redraw()
	for kind in mrows:
		var r: Dictionary = mrows[kind]
		var cn: String = "send_cost:" + String(kind)
		var inn: String = "send_inc:" + String(kind)
		var cv := Tune.value_in(vals, cn)
		var iv := Tune.value_in(vals, inn)
		var cf: LineEdit = r["cost"]
		var inf: LineEdit = r["inc"]
		if not cf.has_focus():
			cf.text = str(int(roundf(cv)))
		if not inf.has_focus():
			inf.text = str(int(roundf(iv)))
		cf.editable = not ro
		inf.editable = not ro
		var pos := iv >= 0.0
		inf.add_theme_color_override("font_color", Color("#7dff7a") if pos else Color("#ff5c4d"))
		var rl: Label = r["rate"]
		rl.text = ("+%d  Â·  %.2f%% /round" % [int(roundf(iv)), 100.0 * iv / maxf(1.0, cv)]) if pos else ("loses %d  Â·  âˆ’%.1f%%" % [int(roundf(-iv)), 100.0 * -iv / maxf(1.0, cv)])
		rl.add_theme_color_override("font_color", Color("#7dff7a", 0.85) if pos else Color("#ff5c4d", 0.9))
		var cd := Tune.is_default(cn, cv)
		var idf := Tune.is_default(inn, iv)
		var dl: Label = r["dflt"]
		dl.text = "" if cd and idf else "default %d g / %+d" % [int(Tune.def_of(cn)), int(Tune.def_of(inn))]
		(r["reset"] as Button).visible = not (cd and idf) and not ro
	# the Changed badge and its list
	var ch := Tune.clean(vals)
	if ch.is_empty():
		changed_lbl.text = "Default values"
		changed_lbl.add_theme_color_override("font_color", main.MUTED)
		changed_lbl.tooltip_text = "Every knob is at its shipped value"
		changed_list.text = ""
	else:
		changed_lbl.text = "Changed: %d" % ch.size()
		changed_lbl.add_theme_color_override("font_color", main.GOLD_HOT)
		var parts: Array = []
		var keys := ch.keys()
		keys.sort()
		for k in keys:
			parts.append("%s %s (default %s)" % [Tune.DEFS[k]["label"], Tune.fmt(k, ch[k]), Tune.fmt(k, Tune.def_of(k))])
		changed_lbl.tooltip_text = "\n".join(parts)
		# 0.18.7: one line only â€” the first few, then "â€¦ and N more"; the full list stays in the tooltip
		var short: Array = parts.map(func(x: String): return x.get_slice(" (default", 0))
		var shown: Array = short.slice(0, 5)
		changed_list.text = "  Â·  ".join(shown) + ("   â€¦ and %d more (hover for the list)" % (short.size() - shown.size()) if short.size() > shown.size() else "")
		changed_list.tooltip_text = _wrap("\n".join(parts), 200)
	# where the changes go
	if main.replay_mode:
		status_lbl.text = "Replay: the recorded match's values"
	elif main.mp() and not main.net.is_host:
		status_lbl.text = "Online: the host sets the balance (read-only)"
	elif main.mp():
		status_lbl.text = "Online host: every change is sent to all players at the same tick"
	elif main.sim != null:
		status_lbl.text = "Changes apply to this match at once (F8 closes)"
	elif main.net != null and main.net.in_lobby and not main.net.is_host:
		status_lbl.text = "Lobby: the host's balance for the coming match (read-only)"
	elif main.net != null and main.net.in_lobby:
		status_lbl.text = "Lobby: the coming match starts with these values"
	else:
		status_lbl.text = "The next match starts with these values"
	del_btn.disabled = preset_opt.item_count == 0
	_busy = false


func _num(name: String, v: float) -> String:
	match String(Tune.DEFS[name].get("fmt", "x")):
		"int", "s", "bool":
			return str(int(roundf(v)))
		"x3":
			return ("%.3f" % v).rstrip("0").rstrip(".")
		_:
			return ("%.2f" % v).rstrip("0").rstrip(".")


func _process(dt: float) -> void:
	if not visible:
		return
	_poll += dt
	if _poll >= 0.25:
		_poll = 0.0
		refresh()


# ---------------------------------------------------------------- presets
func _fill_presets() -> void:
	var cur := preset_opt.get_item_text(preset_opt.selected) if preset_opt.selected >= 0 else ""
	preset_opt.clear()
	var names := Tune.list_presets()
	for n in names:
		preset_opt.add_item(n)
	if names.is_empty():
		preset_opt.add_item("(no presets yet)")
		preset_opt.set_item_disabled(0, true)
		preset_opt.select(-1)
		preset_opt.text = "(no presets)"
	else:
		var i := names.find(cur)
		preset_opt.select(maxi(0, i))
	del_btn.disabled = names.is_empty()


func _selected_preset() -> String:
	if preset_opt.selected < 0 or preset_opt.is_item_disabled(preset_opt.selected):
		return ""
	return preset_opt.get_item_text(preset_opt.selected)


func _load_preset() -> void:
	var nm := _selected_preset()
	if nm == "":
		_say("No preset selected.")
		return
	if read_only():
		_say("Only the host can load a preset.")
		return
	apply_set(Tune.load_preset(nm))
	_say("Loaded preset \"%s\": %d value(s) differ from the defaults." % [nm, Tune.clean(live_set()).size()])


# Moves every knob to the given set (knobs the set leaves out go back to default), one command each.
func apply_set(target: Dictionary) -> void:
	var tgt := Tune.clean(target)
	for n in Tune.DEFS:
		var want := Tune.value_in(tgt, n)
		if absf(want - _value(n)) > 1e-6:
			main.tune_change(n, want)
	refresh()


func _save_preset() -> void:
	var nm := Tune.safe_name(save_edit.text)
	if nm == "":
		_say("Give the preset a name.")
		return
	var paths := Tune.save_preset(nm, live_set())
	save_box.visible = false
	_fill_presets()
	var i := Tune.list_presets().find(nm)
	if i >= 0:
		preset_opt.select(i)
	_say(("Saved: " + "  and  ".join(paths)) if not paths.is_empty() else "Could not write the preset.")
	refresh()


func _delete_preset() -> void:
	var nm := _selected_preset()
	if nm == "":
		return
	Tune.delete_preset(nm)
	_fill_presets()
	_say("Deleted preset \"%s\"." % nm)
	refresh()


func _say(t: String) -> void:
	msg_lbl.text = t


func _input(event: InputEvent) -> void:
	if not visible or not (event is InputEventKey) or not event.pressed or event.echo:
		return
	if event.keycode == KEY_ESCAPE:
		if save_box.visible:
			save_box.visible = false
		else:
			close()
		get_viewport().set_input_as_handled()


