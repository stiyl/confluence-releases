# Small HUD glyphs for the top bar (drawn, so they stay crisp at any scale).
static func bar_glyph(ci: CanvasItem, kind: String, r: Rect2, col: Color) -> void:
	var c := r.get_center()
	var u := minf(r.size.x, r.size.y) / 2.0
	var dk := Color(0, 0, 0, 0.6)
	match kind:
		"pause":
			for x in [-0.42, 0.14]:
				ci.draw_rect(Rect2(c + Vector2(x * u, -0.6 * u), Vector2(0.3 * u, 1.2 * u)), col)
		"play":
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(-0.45, -0.62) * u, c + Vector2(0.62, 0) * u, c + Vector2(-0.45, 0.62) * u]), col)
		"lane_own", "lane_enemy":
			var fl := Color("#6cc3b5") if kind == "lane_own" else Color("#e0714a")
			var b := Rect2(c + Vector2(-0.7, -0.15) * u, Vector2(1.4, 0.85) * u)
			ci.draw_rect(b, col)
			for i in 3:
				ci.draw_rect(Rect2(b.position + Vector2(i * 0.55 * u, -0.25 * u), Vector2(0.3 * u, 0.25 * u)), col)
			ci.draw_rect(Rect2(c + Vector2(-0.15, 0.25) * u, Vector2(0.3, 0.45) * u), dk)
			ci.draw_line(c + Vector2(0.05, -0.4) * u, c + Vector2(0.05, -1.0) * u, col, 1.2)
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0.05, -1.0) * u, c + Vector2(0.65, -0.85) * u, c + Vector2(0.05, -0.68) * u]), fl)
		"duel":
			for s in [-1.0, 1.0]:
				ci.draw_line(c + Vector2(-0.65 * s, 0.65) * u, c + Vector2(0.6 * s, -0.6) * u, col, maxf(1.6, u * 0.2))
				ci.draw_line(c + Vector2(-0.6 * s, 0.25) * u, c + Vector2(-0.25 * s, 0.6) * u, col, maxf(1.4, u * 0.16))
		"amove":
			ci.draw_line(c + Vector2(-0.7, 0.7) * u, c + Vector2(0.45, -0.45) * u, col, maxf(1.6, u * 0.2))
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0.72, -0.72) * u, c + Vector2(0.2, -0.55) * u, c + Vector2(0.55, -0.2) * u]), col)
			ci.draw_line(c + Vector2(-0.55, 0.15) * u, c + Vector2(-0.15, 0.55) * u, col, maxf(1.4, u * 0.16))
		"stop":
			ci.draw_rect(Rect2(c - Vector2(0.52, 0.52) * u, Vector2(1.04, 1.04) * u), col)
		"hold":
			var pts := PackedVector2Array([c + Vector2(-0.62, -0.62) * u, c + Vector2(0.62, -0.62) * u, c + Vector2(0.58, 0.05) * u, c + Vector2(0, 0.75) * u, c + Vector2(-0.58, 0.05) * u])
			ci.draw_colored_polygon(pts, col)
			ci.draw_line(c + Vector2(0, -0.45) * u, c + Vector2(0, 0.45) * u, dk, maxf(1.2, u * 0.14))
		"auto":
			ci.draw_arc(c, u * 0.68, -PI * 0.15, PI * 1.45, 20, col, maxf(1.4, u * 0.16), true)
			var tip := c + Vector2.from_angle(-PI * 0.15) * u * 0.68
			ci.draw_colored_polygon(PackedVector2Array([tip + Vector2(-0.3, -0.25) * u, tip + Vector2(0.28, -0.05) * u, tip + Vector2(-0.05, 0.35) * u]), col)
			ci.draw_circle(c, u * 0.22, col)
		_:
			ci.draw_circle(c, u * 0.4, col)


# A top-bar command: drawn glyph, optional short label, keycap badge. Tooltip carries the full text.
class BarButton extends Button:
	var glyph := ""
	var key := ""
	var label := ""
	var _last := -1
	var _hov := 0.0

	func _init() -> void:
		focus_mode = Control.FOCUS_NONE
		flat = true
		for st in ["normal", "hover", "pressed", "disabled", "focus", "hover_pressed"]:
			add_theme_stylebox_override(st, StyleBoxEmpty.new())

	func fit() -> void:
		var w := 10.0 + 18.0
		if label != "":
			w += 6.0 + UIParts.font("ui_semi").get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x
		if key != "":
			w += 6.0 + maxf(15.0, UIParts.font("ui_semi").get_string_size(key, HORIZONTAL_ALIGNMENT_LEFT, -1, 11).x + 7.0)
		custom_minimum_size = Vector2(w + 6.0, 26)

	func _process(delta: float) -> void:
		var st := (1 if is_hovered() else 0) + (2 if button_pressed else 0) + (4 if disabled else 0)
		var h0 := _hov
		_hov = UIParts.hover_tick(self, _hov, delta, is_hovered() and not disabled)
		if st != _last or h0 != _hov:
			_last = st
			queue_redraw()

	func _draw() -> void:
		var r := Rect2(Vector2.ZERO, size)
		var on := button_pressed
		var hov := is_hovered() and not disabled
		draw_rect(r, Color("#3a3020") if on else (UIParts.STONE_2 if hov else UIParts.STONE_1))
		draw_rect(Rect2(1, 1, size.x - 2, 1), Color(1, 1, 1, 0.07))
		draw_rect(r, UIParts.BRONZE_LITE if on else (UIParts.BRONZE if hov else UIParts.BRONZE_DARK.lightened(0.2)), false, 1.0)
		var col := UIParts.GOLD_TEXT if on else (UIParts.TEXT if hov else Color(UIParts.TEXT, 0.82))
		var gr := Rect2(8, (size.y - 16) / 2.0, 16, 16)
		UIParts.bar_glyph(self, glyph, gr, col)
		var x := gr.end.x + 6.0
		if label != "":
			var f := UIParts.font("ui_semi")
			draw_string(f, Vector2(x, size.y / 2.0 + 4.5), label, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, col)
			x += f.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x + 6.0
		if key != "":
			UIParts.keycap(self, Vector2(x, (size.y - 16) / 2.0), key, 11, 15.0)
		UIParts.hover_draw(self, r, _hov, UIParts.hover_held(self))


