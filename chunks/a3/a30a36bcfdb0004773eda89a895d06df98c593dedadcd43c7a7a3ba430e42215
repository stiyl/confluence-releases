# 0.18.3: tooltips wrap at ~64 characters so long help lines don't run off the screen.
static func _wrap(t: String, width := 64) -> String:
	var out := ""
	for para in t.split("\n"):
		var line := ""
		for w in para.split(" "):
			if line.length() + w.length() + 1 > width and line != "":
				out += line + "\n"
				line = w
			else:
				line = w if line == "" else line + " " + w
		out += line + "\n"
	return out.strip_edges()


