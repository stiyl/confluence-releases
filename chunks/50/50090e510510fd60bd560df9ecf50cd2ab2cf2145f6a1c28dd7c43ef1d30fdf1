	if not running:
		return
	if id != "" and id != "resume":
		_exit(id)
		Profile.tutorial_ch = ch
	reset()
	Profile.tutorial_done = true
	Profile.save()
	main.back_to_draft()


func _complete() -> void:
	reset()
	running = true            # the finish screen belongs to the tutorial until a button is pressed
	id = ""
	Profile.tutorial_done = true
	Profile.tutorial_ch = 0
	Profile.save()
	main.award("tutorial")
	if main.audio != null:
		main.audio.play("learn", -2.0)
	if main.sim != null:
		main.sim.waves_on = false
