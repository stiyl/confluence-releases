# A soft elliptical darkening behind free-standing text (no rectangle, no border): a fan of triangles,
# dark at the centre and clear at the rim.
static func soft_shade(ci: CanvasItem, c: Vector2, rx: float, ry: float, a := 0.35, segs := 28) -> void:
	if a <= 0.0:
		return
	var dark := Color(0.03, 0.025, 0.02, a)
	var clear := Color(0.03, 0.025, 0.02, 0.0)
	for i in segs:
		var a0 := TAU * i / segs
		var a1 := TAU * (i + 1) / segs
		ci.draw_primitive(PackedVector2Array([c, c + Vector2(cos(a0) * rx, sin(a0) * ry), c + Vector2(cos(a1) * rx, sin(a1) * ry)]),
			PackedColorArray([dark, clear, clear]), PackedVector2Array())
␀# 0.24: self-update. Friends unzip the game once; after that each launch looks for a newer build on the public
# releases repo (tools/release/publish.py writes it) and downloads only the parts of the .pck that changed.
#
#   <base>/latest.json                 {"updater":1, "version", "manifest", "pck_size", "pck_sha256",
#                                       "platforms": {"windows"|"linux_x86_64"|"linux_arm64"|"macos": {"version",
#                                                     "manifest", "pck_size", "pck_sha256"}}}
#   <base>/manifests/<version>.json    (windows; others manifests/<platform>/<version>.json)
#                                      {"version", "pck_size", "pck_sha256", "chunks":[{"h","off","len"}], "notes"}
#   <base>/chunks/<h[:2]>/<h>          raw bytes, h = sha256 (one store for every platform)
#
# 0.28: each build reads its own entry of "platforms" (platform_key()); the top-level keys stay the Windows build
# for 0.24-0.27 games. On macOS the running pack is inside the app (Contents/Resources/Confluence.pck); new packs
# go to user://pck/ like everywhere else, so the signed .app is never modified.
#
# Chunks the running .pck already holds (looked up in the running version's manifest) are copied from it and
# re-verified; the rest are downloaded (one at a time, only while no match is live, cached so a quit resumes).
# The new pack is assembled at user://pck/Confluence-<ver>.pck.part, its sha256 checked, then renamed. "Restart"
# (or the next launch) starts the same exe again with  --main-pack <that file>; the engine and exe never change.
#
# Off in dev runs (editor binary, --headless tests) unless forced:  -- --updater-force --update-url=http://...
# Other user args: --no-update, --updater-exit (tests: print the result and quit).
class_name Updater
extends Node

signal changed

const BASE_URL := "https://raw.githubusercontent.com/stiyl/confluence-releases/main/"
const DIR := "user://pck/"
const FORMAT := 1
const START_DELAY := 1.5

enum { IDLE, CHECKING, DOWNLOADING, READY, FAILED }
var state := IDLE
var latest_ver := ""
var progress := 0.0
var bytes_downloaded := 0
var bytes_copied := 0
var busy_fn := Callable()        # true while a match is live: downloading waits for the menus
var _http: HTTPRequest
var _man := {}
var _old := {}                   # h -> offset in the running pck
var _src: FileAccess
var _out: FileAccess
var _hash: HashingContext
var _i := 0
var _waiting := false
var _tries := 0
var _done_bytes := 0


# ---------------------------------------------------------------- static helpers (boot runs before any node)

static func version() -> String:
	return String(ProjectSettings.get_setting("application/config/version", "0.0.0"))


# Versions: three numbers, then an optional suffix. A suffixed build of the same numbers counts as NEWER
# (0.24.0 < 0.24.0-test2 < 0.24.1); always bump the version before publishing.
static func cmp(a: String, b: String) -> int:
	var pa := _split(a)
	var pb := _split(b)
	for i in 3:
		if pa[0][i] != pb[0][i]:
			return -1 if pa[0][i] < pb[0][i] else 1
	if pa[1] == pb[1]:
		return 0
	if pa[1] == "" or pb[1] == "":
		return -1 if pa[1] == "" else 1
	return pa[1].naturalnocasecmp_to(pb[1])


static func _split(v: String) -> Array:
	var cut := v.find("-")
	var head := v if cut < 0 else v.substr(0, cut)
	var nums := [0, 0, 0]
	var parts := head.split(".")
	for i in mini(3, parts.size()):
		nums[i] = int(parts[i])
	return [nums, "" if cut < 0 else v.substr(cut + 1)]


static func arg(name: String, def := "") -> String:
	for a in OS.get_cmdline_user_args():
		if a == "--" + name:
			return "1"
		if a.begins_with("--" + name + "="):
			return a.substr(name.length() + 3)
	return def


static func forced() -> bool:
	return arg("updater-force") != "" or OS.get_environment("CONFLUENCE_UPDATER") == "force"


static func enabled() -> bool:
	if arg("no-update") != "" or platform_key() == "":
		return false
	if forced():
		return true
	if OS.has_feature("editor") or DisplayServer.get_name() == "headless":
		return false
	Settings.ensure()
	return Settings.check_updates


static func base_url() -> String:
	var u := arg("update-url", OS.get_environment("CONFLUENCE_UPDATE_URL"))
	if u == "":
		u = BASE_URL
	return u if u.ends_with("/") else u + "/"


# Which build this is: "windows", "linux_x86_64", "linux_arm64", "macos" ("" = not one we publish).
static func platform_key() -> String:
	var forced_key := arg("updater-platform")
	if forced_key != "":
		return forced_key
	match OS.get_name():
		"Windows":
			return "windows"
		"macOS":
			return "macos"
		"Linux", "FreeBSD", "NetBSD", "OpenBSD", "BSD":
			var a := Engine.get_architecture_name()
			if a == "x86_64" or a == "arm64":
				return "linux_" + a
	return ""


# This platform's entry of latest.json. A latest.json from before 0.28 (no "platforms") is the Windows build.
static func platform_entry(latest: Dictionary) -> Dictionary:
	var key := platform_key()
	var plats = latest.get("platforms")
	if plats is Dictionary:
		var e = plats.get(key)
		return e if e is Dictionary and e.has("version") else {}
	return latest if key == "windows" else {}


static func manifest_path(ver: String) -> String:
	var key := platform_key()
	return ("manifests/%s.json" % ver) if key == "windows" else ("manifests/%s/%s.json" % [key, ver])


# The .pck this process runs from: the one we relaunched into, the one beside the exe, or on macOS the one in
# the app's Contents/Resources ("" if embedded).
static func running_pck() -> String:
	var p := arg("cf-pack")
	if p != "" and FileAccess.file_exists(p):
		return p
	var exe := OS.get_executable_path()
	var side := exe.get_basename() + ".pck"
	if FileAccess.file_exists(side):
		return side
	if OS.get_name() == "macOS":
		var res_dir := exe.get_base_dir().get_base_dir().path_join("Resources")
		for n in [exe.get_file().get_basename() + ".pck", String(ProjectSettings.get_setting("application/config/name", "Confluence")) + ".pck"]:
			if FileAccess.file_exists(res_dir.path_join(n)):
				return res_dir.path_join(n)
	return ""


static func _state() -> Dictionary:
	var f := FileAccess.open(DIR + "state.json", FileAccess.READ)
	if f == null:
		return {}
	var d = JSON.parse_string(f.get_as_text())
	return d if d is Dictionary else {}


static func _save_state(d: Dictionary) -> void:
	DirAccess.make_dir_recursive_absolute(DIR)
	var f := FileAccess.open(DIR + "state.json", FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(d, " "))


# Arguments for starting the same exe on another pack: the player's own extra arguments pass through.
static func relaunch_args(pck: String) -> PackedStringArray:
	var out := PackedStringArray()
	if DisplayServer.get_name() == "headless":
		out.append("--headless")
	out.append_array(["--main-pack", pck])
	var skip := false
	for a in OS.get_cmdline_args():
		if skip:
			skip = false
			continue
		if a == "--main-pack":
			skip = true
			continue
		if a == "--headless":
			continue
		out.append(a)
	out.append("--")
	for a in OS.get_cmdline_user_args():
		if not a.begins_with("--cf-pack="):
			out.append(a)
	out.append("--cf-pack=" + pck)
	return out


static func relaunch(pck: String) -> bool:
	var args := relaunch_args(pck)
	print("UPDATER relaunch: ", OS.get_executable_path(), " ", " ".join(args))
	return OS.create_process(OS.get_executable_path(), args) > 0


# Called first thing at boot. True = a newer downloaded pack exists and a new process was started on it:
# the caller quits at once. A pack that failed to reach the menu twice is not tried again.
static func boot_relaunch() -> bool:
	if not enabled():
		return false
	if arg("cf-pack") != "":
		print("UPDATER running %s from %s" % [version(), arg("cf-pack")])
		return false
	var st := _state()
	var v := String(st.get("version", ""))
	if v == "" or cmp(v, version()) <= 0:
		return false
	var path := ProjectSettings.globalize_path(DIR + String(st.get("file", "")))
	if not FileAccess.file_exists(path):
		return false
	if not bool(st.get("good", false)) and int(st.get("tries", 0)) >= 2:
		push_warning("updater: %s failed to start twice, staying on %s" % [v, version()])
		return false
	st["tries"] = int(st.get("tries", 0)) + 1
	_save_state(st)
	return relaunch(path)


# The main menu is up: the pack we run on works. Old packs (all but this one and the one before) go.
static func boot_ok() -> void:
	if not enabled():
		return
	var st := _state()
	if arg("cf-pack") != "" and String(st.get("version", "")) == version() and not bool(st.get("good", false)):
		st["good"] = true
		st["tries"] = 0
		_save_state(st)
	var keep := [String(st.get("file", "")), String(st.get("prev", "")), arg("cf-pack").get_file()]
	var d := DirAccess.open(DIR)
	if d == null:
		return
	for f in d.get_files():
		if f.ends_with(".pck") and not keep.has(f):
			d.remove(f)


# ---------------------------------------------------------------- the download

# 0.25.4: checked again every time the main menu or a lobby comes up (the user's request), at most once a minute,
# and only while nothing is in flight; a finished download (READY) stays.
const RECHECK_EVERY := 60.0
var _last_check_ms := -1000000


func recheck() -> void:
	if not enabled() or state == CHECKING or state == DOWNLOADING or state == READY:
		return
	if Time.get_ticks_msec() - _last_check_ms < RECHECK_EVERY * 1000.0:
		return
	start()


func start() -> void:
	if not enabled():
		return
	if state == CHECKING or state == DOWNLOADING or state == READY:
		return
	_last_check_ms = Time.get_ticks_msec()
	await get_tree().create_timer(START_DELAY).timeout
	if _http != null:
		_http.queue_free()
	_http = HTTPRequest.new()
	_http.use_threads = true
	_http.timeout = 10.0
	add_child(_http)
	_set_state(CHECKING)
	var top = await _get_json("latest.json")
	if not (top is Dictionary) or int(top.get("updater", 0)) > FORMAT:
		_finish(IDLE)
		return
	var latest := platform_entry(top)
	if not latest.has("version"):
		_finish(IDLE)      # nothing published for this platform (yet)
		return
	latest_ver = String(latest["version"])
	if cmp(latest_ver, version()) <= 0:
		_finish(IDLE)
		return
	var st := _state()
	var have := ProjectSettings.globalize_path(DIR + "Confluence-%s.pck" % latest_ver)
	if String(st.get("version", "")) == latest_ver and String(st.get("sha", "")) == String(latest.get("pck_sha256", "")) and FileAccess.file_exists(have):
		progress = 1.0
		_finish(READY)
		return
	var man = await _get_json(String(latest.get("manifest", manifest_path(latest_ver))))
	if not (man is Dictionary) or not (man.get("chunks") is Array) or String(man.get("pck_sha256", "")) != String(latest.get("pck_sha256", "")):
		_finish(FAILED)
		return
	_man = man
	var src := running_pck()
	if src != "":
		var om = await _get_json(manifest_path(version()))
		# every copied chunk is re-hashed, so a pack that differs from its manifest just downloads more
		if om is Dictionary and om.get("chunks") is Array:
			for c in om["chunks"]:
				_old[String(c["h"])] = int(c["off"])
			_src = FileAccess.open(src, FileAccess.READ)
	DirAccess.make_dir_recursive_absolute(DIR + "cache")
	_out = FileAccess.open(DIR + "Confluence-%s.pck.part" % latest_ver, FileAccess.WRITE)
	if _out == null:
		_finish(FAILED)
		return
	_hash = HashingContext.new()
	_hash.start(HashingContext.HASH_SHA256)
	_i = 0
	_http.timeout = 60.0
	_set_state(DOWNLOADING)


func _process(_dt: float) -> void:
	if state != DOWNLOADING or _waiting or _out == null:
		return
	if busy_fn.is_valid() and busy_fn.call():
		return
	if _i >= _man["chunks"].size():
		_complete()
		return
	var c: Dictionary = _man["chunks"][_i]
	var h := String(c["h"])
	var n := int(c["len"])
	# 1) already in the pack we run on
	if _src != null and _old.has(h):
		_src.seek(int(_old[h]))
		var b := _src.get_buffer(n)
		if b.size() == n and _sha(b) == h:
			bytes_copied += n
			_put(b)
			return
	# 2) downloaded in an earlier session
	var cp := DIR + "cache/" + h
	if FileAccess.file_exists(cp):
		var b2 := FileAccess.get_file_as_bytes(cp)
		if b2.size() == n and _sha(b2) == h:
			_put(b2)
			return
	# 3) fetch it
	_waiting = true
	var b3 = await _get_bytes("chunks/%s/%s" % [h.substr(0, 2), h])
	_waiting = false
	if state != DOWNLOADING:
		return
	if b3 is PackedByteArray and b3.size() == n and _sha(b3) == h:
		_tries = 0
		bytes_downloaded += n
		var f := FileAccess.open(cp, FileAccess.WRITE)
		if f != null:
			f.store_buffer(b3)
			f.close()
		_put(b3)
	else:
		_tries += 1
		if _tries >= 4:
			_finish(FAILED)


func _put(b: PackedByteArray) -> void:
	_out.store_buffer(b)
	_hash.update(b)
	_done_bytes += b.size()
	_i += 1
	progress = float(_done_bytes) / maxf(1.0, float(_man.get("pck_size", 1)))
	changed.emit()


func _complete() -> void:
	_out.close()
	_out = null
	_src = null
	var sha := _hash.finish().hex_encode()
	var part := DIR + "Confluence-%s.pck.part" % latest_ver
	if sha != String(_man["pck_sha256"]) or _done_bytes != int(_man["pck_size"]):
		DirAccess.remove_absolute(part)
		_finish(FAILED)
		return
	var fname := "Confluence-%s.pck" % latest_ver
	DirAccess.remove_absolute(DIR + fname)
	if DirAccess.rename_absolute(part, DIR + fname) != OK:
		_finish(FAILED)
		return
	var st := _state()
	var prev := String(st.get("file", ""))
	if arg("cf-pack") != "":
		prev = arg("cf-pack").get_file()
	_save_state({"version": latest_ver, "file": fname, "sha": sha, "prev": prev, "tries": 0, "good": false})
	var d := DirAccess.open(DIR + "cache")
	if d != null:
		for f in d.get_files():
			d.remove(f)
	progress = 1.0
	_finish(READY)


# "Restart" on the menu plaque.
func restart() -> void:
	if state != READY:
		return
	var st := _state()
	st["tries"] = 1
	_save_state(st)
	if relaunch(ProjectSettings.globalize_path(DIR + String(st.get("file", "")))):
		get_tree().quit()


func _set_state(s: int) -> void:
	state = s
	changed.emit()


func _finish(s: int) -> void:
	_set_state(s)
	if arg("updater-exit") != "":
		print("UPDATER RESULT state=%s platform=%s running=%s latest=%s downloaded=%d copied=%d pck=%d" % [
			["idle", "checking", "downloading", "ready", "failed"][s], platform_key(), version(), latest_ver,
			bytes_downloaded, bytes_copied, int(_man.get("pck_size", 0))])
		get_tree().quit()


func _sha(b: PackedByteArray) -> String:
	var hc := HashingContext.new()
	hc.start(HashingContext.HASH_SHA256)
	hc.update(b)
	return hc.finish().hex_encode()


func _get_bytes(rel: String):
	if _http.request(base_url() + rel) != OK:
		return null
	var r: Array = await _http.request_completed
	if int(r[0]) != HTTPRequest.RESULT_SUCCESS or int(r[1]) != 200:
		return null
	return r[3]


func _get_json(rel: String):
	var b = await _get_bytes(rel)
	if not (b is PackedByteArray):
		return null
	return JSON.parse_string(b.get_string_from_utf8())


# ---------------------------------------------------------------- 0.35.2: Steam's native files for an old game folder
# A folder unzipped before 0.33 has no Steam libraries, and a pck alone can't bring them. When this pck ships Steam
# but the engine found no Steam (Net.steam_libs_expected), fetch them from <base>/libs/<platform>/steam.json
#   {"files": [{"name", "sha256", "size", "path"}]}
# into the folder of the exe (where an exported game looks for GDExtension libraries) and ask for a restart.
# Windows only for now (macOS libraries live inside the signed app; Linux testers all came with 0.33+).
signal steam_libs_done(ok: bool, msg: String)


static var libs_dir_override := ""     # tests: where the files go / which platform's list to read
static var libs_plat_override := ""


static func steam_libs_platform() -> String:
	if libs_plat_override != "":
		return libs_plat_override
	return "windows" if OS.get_name() == "Windows" else ""


func fetch_steam_libs() -> void:
	var plat := steam_libs_platform()
	if plat == "":
		steam_libs_done.emit(false, "")
		return
	var http := HTTPRequest.new()
	http.use_threads = true
	http.timeout = 60.0
	add_child(http)
	var dir := libs_dir_override if libs_dir_override != "" else OS.get_executable_path().get_base_dir()
	var idx = await _fetch(http, "libs/%s/steam.json" % plat)
	var spec = JSON.parse_string(idx.get_string_from_utf8()) if idx is PackedByteArray else null
	if not (spec is Dictionary) or not (spec.get("files") is Array):
		http.queue_free()
		steam_libs_done.emit(false, "Couldn't download Steam's files right now.")
		return
	for f in spec["files"]:
		var name := String(f.get("name", "")).get_file()
		if name == "":
			continue
		var b = await _fetch(http, String(f.get("path", "")))
		if not (b is PackedByteArray) or b.size() != int(f.get("size", -1)) or _sha(b) != String(f.get("sha256", "")):
			http.queue_free()
			steam_libs_done.emit(false, "Couldn't download Steam's files right now.")
			return
		var dst := dir.path_join(name)
		var tmp := dst + ".part"
		var out := FileAccess.open(tmp, FileAccess.WRITE)
		if out == null:
			http.queue_free()
			steam_libs_done.emit(false, "Couldn't write Steam's files into the game folder (%s)." % dir)
			return
		out.store_buffer(b)
		out.close()
		DirAccess.remove_absolute(dst)
		if DirAccess.rename_absolute(tmp, dst) != OK:
			DirAccess.remove_absolute(tmp)
			http.queue_free()
			steam_libs_done.emit(false, "Couldn't write Steam's files into the game folder (%s)." % dir)
			return
		print("UPDATER steam lib: ", dst)
	http.queue_free()
	steam_libs_done.emit(true, "")


func _fetch(http: HTTPRequest, rel: String):
	if http.request(base_url() + rel) != OK:
		return null
	var r: Array = await http.request_completed
	if int(r[0]) != HTTPRequest.RESULT_SUCCESS or int(r[1]) != 200:
		return null
	return r[3]


# Start this same game again (same pack) - Steam's files load at engine start.
static func relaunch_same() -> bool:
	var pck := arg("cf-pack")
	if pck != "":
		return relaunch(pck)
	var args := PackedStringArray(OS.get_cmdline_args())
	var ua := OS.get_cmdline_user_args()
	if not ua.is_empty():
		args.append("--")
		args.append_array(ua)
	return OS.create_process(OS.get_executable_path(), args) > 0
