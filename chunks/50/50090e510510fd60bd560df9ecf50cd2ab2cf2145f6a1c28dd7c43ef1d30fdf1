	var mark := ""            # short coloured tag along the bottom-left (send buttons: HEAL, HASTE, FLY...)
	var mark_col := Color(1, 1, 1)
	var danger := false       # 0.34: a red warning tint and frame (the Cultist's ultimate while Undying Will rests)
	var _t := 0.0
	var _hov := 0.0           # 0.17 hover ease (UIParts.hover_tick)

	const STRIP_H := 15.0

	func _init() -> void:
		focus_mode = Control.FOCUS_NONE
		flat = true
		for st in ["normal", "hover", "pressed", "disabled", "focus", "hover_pressed"]:
			add_theme_stylebox_override(st, StyleBoxEmpty.new())

	func _process(delta: float) -> void:
		_t += delta
		if flash > 0:
			flash -= delta
		_hov = UIParts.hover_tick(self, _hov, delta, is_hovered() and not disabled)
		queue_redraw()

	func _draw() -> void:
		var strip := price_strip and corner != ""
		var sz := Vector2(size.x, size.y - (STRIP_H if price_strip else 0.0))
		var r := Rect2(Vector2.ZERO, sz)
		var tier := UIParts.item_tier(icon_kind)
		ci_fill(r)
		if warn:
			var wc := Vector2(11, 11)
			draw_colored_polygon(PackedVector2Array([wc + Vector2(0, -8), wc + Vector2(8, 0), wc + Vector2(0, 8), wc + Vector2(-8, 0)]), Color(0, 0, 0, 0.85))
			draw_colored_polygon(PackedVector2Array([wc + Vector2(0, -6), wc + Vector2(6, 0), wc + Vector2(0, 6), wc + Vector2(-6, 0)]), Color(1.0, 0.72, 0.25))
			draw_rect(Rect2(wc + Vector2(-1, -4), Vector2(2, 5)), Color(0.15, 0.1, 0.05))
			draw_rect(Rect2(wc + Vector2(-1, 2), Vector2(2, 2)), Color(0.15, 0.1, 0.05))
		var inner := r.grow(-4)
		var is_ab := icon_kind.begins_with("ab:")
		var unlearned := is_ab and rank == 0
		if is_ab:
			var at := UIParts.ability_tex(icon_kind.substr(3), unlearned)
			if at != null:
				draw_texture_rect(at, inner, false, Color(1, 1, 1, 1) if not unlearned else Color(0.92, 0.92, 0.92))
			else:
				UIParts.draw_glyph(self, "passive", inner.grow(-3), tint)
		elif icon_kind.begins_with("mon:"):
			var kind := icon_kind.substr(4)
			if not UIParts.draw_tight(self, Sprites.mon_sheet(kind), inner.grow(-3), 3):
				draw_circle(inner.get_center(), inner.size.x * 0.3, Color(GameData.MON[kind]["col"]))
		elif icon_kind.begins_with("bld:"):
			if not Sprites.draw_fit(self, "bld_" + icon_kind.substr(4), inner.grow(2), 0, 0, 1.15):
				UIParts.draw_glyph(self, "summon", inner.grow(-3), tint)
		elif icon_kind.begins_with("item:"):
			if not Sprites.draw_fit(self, "item_" + icon_kind.substr(5), inner, 0, 0, 1.0):
				UIParts.draw_glyph(self, "passive", inner.grow(-3), tint)
		elif icon_kind.begins_with("prop:"):
			if not Sprites.draw_fit(self, icon_kind.substr(5), inner.grow(2), 0, 0, 1.1):
				UIParts.draw_glyph(self, "passive", inner.grow(-3), tint)
		elif icon_kind == "empty":
			pass
		else:
			UIParts.draw_glyph(self, icon_kind, inner.grow(-3), tint)
		UIParts.bevel(self, inner, Color(1, 1, 1, 0.16), Color(0, 0, 0, 0.45), 2.0)
		if cd_frac > 0.005:
			# clock-sweep cooldown, drawn as a fan of triangles clipped to the square
			var ctr := inner.get_center()
			var start := -PI / 2 + TAU * (1.0 - cd_frac)
			var steps := maxi(2, int(32 * cd_frac))
			var prev := Vector2.ZERO
			for i in steps + 1:
				var d := Vector2.from_angle(start + (TAU * cd_frac) * i / steps)
				var k := minf(inner.size.x / 2.0 / maxf(absf(d.x), 0.001), inner.size.y / 2.0 / maxf(absf(d.y), 0.001))
				var q := ctr + d * k
				if i > 0 and absf((prev - ctr).cross(q - ctr)) > 0.01:
					draw_colored_polygon(PackedVector2Array([ctr, prev, q]), Color(0, 0, 0, 0.62))
				prev = q
		if rank == 0 and not is_ab:
			draw_rect(inner, Color(0.02, 0.02, 0.03, 0.6))
		elif unlearned:
			draw_rect(inner, Color(0.02, 0.02, 0.03, 0.22))
		var mon := icon_kind.begins_with("mon:") or icon_kind.begins_with("bld:")
		if disabled or unusable or locked:
			draw_rect(inner, Color(0.05, 0.03, 0.02, (0.3 if mon else 0.62) if locked else (0.25 if mon else 0.55)))
		if locked:
			if mon:
				# a small corner lock, so the monster stays readable behind it
				UIParts.lock_glyph(self, Vector2(inner.end.x - 9, inner.end.y - 9), 0.75)
			else:
				UIParts.lock_glyph(self, inner.get_center() + Vector2(0, 2), 1.0)
		elif unlearned and not learnable:
			UIParts.lock_glyph(self, Vector2(inner.end.x - 8, inner.position.y + 9), 0.62)
		if is_hovered() and not disabled:
			draw_rect(inner, Color(1, 1, 0.97, 0.1))
		if flash > 0:
			draw_rect(inner, Color(1, 1, 0.97, flash * 1.5))
		if tier > 0:
			if selected:
				# 0.32.2: a selected tiered tile glows in its own tier colour (no gold box fighting the tier frame)
				var tc: Color = UIParts.TIER_COL[clampi(tier, 0, 4)]
				draw_rect(inner, Color(tc, 0.16))
				var pulse := 0.8 + 0.2 * sin(_t * 4.0)
				for i in 3:
					draw_rect(r.grow(2.0 + i * 1.5), Color(tc.lightened(0.3), (0.5 - i * 0.15) * pulse), false, 1.5)
			UIParts.tier_frame(self, r.grow(-1), tier, _t)
			if selected:
				draw_rect(r.grow(-1), UIParts.TIER_COL[clampi(tier, 0, 4)].lightened(0.45), false, 2.0)
			elif is_hovered() and not disabled:
				draw_rect(r.grow(-1), Color(1, 1, 1, 0.35), false, 1.0)
		else:
			UIParts.framed(self, r.grow(-1), gold_frame or selected or (is_hovered() and not disabled))
		if danger:
			var da := 0.7 + 0.3 * sin(_t * 5.0)
			draw_rect(inner, Color(0.85, 0.05, 0.1, 0.28 * da))
			draw_rect(r.grow(-1), Color(1.0, 0.25, 0.25, da), false, 2.5)
		if learnable:
			var a := 0.55 + 0.45 * sin(_t * 6.0)
			draw_rect(r.grow(-1), Color(0.55, 1.0, 0.5, a), false, 2.5)
		if selected and tier <= 0:
			draw_rect(r.grow(-2), Color(UIParts.GOLD_TEXT, 0.95), false, 2.0)
		if rank >= 0:
			var pw := 7.0
			var gap := 3.0
			var x0 := (sz.x - (4 * pw + 3 * gap)) / 2.0
			for k in 4:
				var pr := Rect2(x0 + k * (pw + gap), sz.y - 10, pw, 5)
				draw_rect(pr.grow(1), Color(0, 0, 0, 0.85))
				draw_rect(pr, UIParts.GOLD_TEXT if k < rank else Color(0.36, 0.33, 0.28))
		var f := UIParts.font("num_semi")
		if hotkey != "":
			UIParts.keycap(self, Vector2(3, 3), hotkey, 11 if sz.x >= 44 else 10, 14.0)
		if cd_text != "":
			draw_string_outline(f, Vector2(0, sz.y * 0.62), cd_text, HORIZONTAL_ALIGNMENT_CENTER, sz.x, 17, 4, Color.BLACK)
			draw_string(f, Vector2(0, sz.y * 0.62), cd_text, HORIZONTAL_ALIGNMENT_CENTER, sz.x, 17, Color.WHITE)
		if badge != "":
			var bw := f.get_string_size(badge, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x + 8.0
			draw_rect(Rect2(sz.x - bw - 4, 4, bw, 16), Color(0.1, 0.35, 0.12, 0.92))
			draw_string(f, Vector2(sz.x - bw - 4, 16.5), badge, HORIZONTAL_ALIGNMENT_CENTER, bw, 12, Color(0.75, 1.0, 0.75))
		if strip:
			var sr := Rect2(1, sz.y + 1, size.x - 2, STRIP_H - 2)
			draw_rect(sr, Color(0.04, 0.035, 0.03, 0.95))
			draw_rect(sr, Color(UIParts.TIER_COL[tier] if tier > 0 else UIParts.BRONZE_DARK, 0.6), false, 1.0)
			var pc := Color(1.0, 0.45, 0.35) if unusable else UIParts.COIN_LITE
			draw_string(f, Vector2(0, sz.y + STRIP_H - 3.5), corner, HORIZONTAL_ALIGNMENT_CENTER, size.x, 11, pc)
		elif corner != "":
			draw_string_outline(f, Vector2(0, sz.y - 6), corner, HORIZONTAL_ALIGNMENT_RIGHT, sz.x - 6, 11, 3, Color.BLACK)
			draw_string(f, Vector2(0, sz.y - 6), corner, HORIZONTAL_ALIGNMENT_RIGHT, sz.x - 6, 11, UIParts.COIN_LITE)
		if mark != "" and badge == "":
			var mw := f.get_string_size(mark, HORIZONTAL_ALIGNMENT_LEFT, -1, 9).x + 6.0
			var mr := Rect2(sz.x - mw - 3, 3, mw, 13)
			draw_rect(mr, Color(mark_col.darkened(0.6), 0.95))
			draw_rect(mr, mark_col, false, 1.0)
			draw_string(f, Vector2(mr.position.x, 13), mark, HORIZONTAL_ALIGNMENT_CENTER, mw, 9, mark_col.lightened(0.5))
		UIParts.hover_draw(self, Rect2(Vector2.ZERO, size).grow(-1), _hov, UIParts.hover_held(self))

	func ci_fill(r: Rect2) -> void:
		var inner := r.grow(-4)
		if icon_kind.begins_with("item:") or icon_kind.begins_with("prop:") or icon_kind == "empty":
			UIParts.gradient_fill(self, inner, Color(0.22, 0.19, 0.15), Color(0.07, 0.06, 0.05))
			var tr := UIParts.item_tier(icon_kind)
			if tr >= 2:
				draw_circle(inner.get_center(), inner.size.x * 0.42, Color(UIParts.TIER_COL[tr], 0.1))
		elif icon_kind.begins_with("mon:"):
			# a light stone backing so dark monsters read against it
			UIParts.gradient_fill(self, inner, Color(0.6, 0.6, 0.52), Color(0.33, 0.34, 0.27))
			draw_circle(inner.get_center() + Vector2(0, -2), inner.size.x * 0.4, Color(1, 1, 0.92, 0.14))
		elif icon_kind.begins_with("bld:"):
			UIParts.gradient_fill(self, inner, Color(0.3, 0.38, 0.2), Color(0.1, 0.14, 0.07))
		else:
			UIParts.gradient_fill(self, inner, tint.darkened(0.15), tint.darkened(0.75))
			draw_circle(inner.get_center(), inner.size.x * 0.45, Color(tint.lightened(0.3), 0.18))


class Minimap extends Control:
	# 0.17: two arenas stacked in one box (your lane on top, the enemy's below) at the same scale, or the
	# viewed arena alone when Settings.minimap_both is off (or the match has only one arena).
	var view: ArenaView
	var sim: Sim
	var _t := 0.0
	var _dragging := false
	var _drag_half := -1
	var pings: Array = []     # {"p": world pos, "col": Color, "t": seconds left, "a": arena idx (-1 = any)}
	var on_alt_click: Callable          # alt+left-click in your half: called with the world position
	var on_ping: Callable               # 0.31: (world pos, arena idx) on a left press while the Ping key is held -> true when taken
	var ping_held: Callable             # 0.31: () -> bool, the Ping key (Alt by default) is down
	var on_switch: Callable             # click in the other half: called with that arena index (main.set_view_arena)
	var on_right_click: Callable        # 0.24 right-click: (world pos, arena idx) -> true when it issued a move order
	var hint := {}                      # {"p": world pos, "a": arena idx}: a send button is hovered, flash that entrance
	var TEAM_COLS: Array:           # 0.43: the Colour vision palette
		get: return [Palette.ward, Palette.ember]
	const DIVIDER := 3.0

	func ping(p: Vector2, col: Color, a := -1) -> void:
		for q in pings:
			if q["a"] == a and q["p"].distance_to(p) < 160.0 and q["t"] > 1.5 and not q.has("k"):
				return
		pings.append({"p": p, "col": col, "t": 3.0, "a": a})

	# 0.31: a team ping: the pulse plus the kind's icon, for PingUI.MARK_T seconds
	func team_ping(p: Vector2, k: String, a: int) -> void:
		pings.append({"p": p, "col": PingUI.col(k), "t": PingUI.MARK_T, "a": a, "k": k})
		if pings.size() > 24:
			pings.pop_front()

	# Send-button hover: mark the rift the send would go down (cleared with hint_clear).
	func hint_lane(lane: int, a: int) -> void:
		if lane < 0 or lane >= Sim.PATHS.size():
			return
		hint = {"p": Sim.PATHS[lane][0], "a": a, "t0": _t}

	func hint_clear() -> void:
		hint = {}

	func _ready() -> void:
		texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
		mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND

	func my_idx() -> int:
		if view == null:
			return 0
		if view.human_champ != null and view.human_champ.ar != null:
			return view.human_champ.ar.idx
		return view.arena_idx if view.arena_idx != 2 else 0

	# Whether two arenas are shown.
	func stacked() -> bool:
		return Settings.minimap_both and sim != null and sim.arenas.size() >= 2 and view != null

	# [[arena idx, Rect2], ...]: the halves top to bottom. In a duel the viewed duel arena takes the top half.
	func halves() -> Array:
		var inset := Rect2(Vector2(4, 4), size - Vector2(8, 8))
		if not stacked():
			var k0 := minf(inset.size.x / Sim.W, inset.size.y / Sim.H)
			var sz0 := Vector2(Sim.W, Sim.H) * k0
			return [[view.arena_idx if view != null else 0, Rect2(inset.position + (inset.size - sz0) / 2.0, sz0)]]
		var hh := (inset.size.y - DIVIDER) / 2.0
		var k := minf(inset.size.x / Sim.W, hh / Sim.H)
		var sz := Vector2(Sim.W, Sim.H) * k
		var x := inset.position.x + (inset.size.x - sz.x) / 2.0
		var mine := my_idx()
		var top := 2 if view.arena_idx == 2 else mine
		var bottom := 1 - mine if mine < 2 else 1
		return [[top, Rect2(Vector2(x, inset.position.y + (hh - sz.y) / 2.0), sz)],
			[bottom, Rect2(Vector2(x, inset.position.y + hh + DIVIDER + (hh - sz.y) / 2.0), sz)]]

	# The rect of the viewed arena (the old single-map rect).
	func map_rect() -> Rect2:
		var hs := halves()
		for h in hs:
			if view != null and h[0] == view.arena_idx:
				return h[1]
		return hs[0][1]

	func _half_at(local: Vector2) -> int:
		var hs := halves()
		if hs.size() == 1:
			return 0
		return 0 if local.y < (hs[0][1].end.y + hs[1][1].position.y) / 2.0 else 1

	var _redraw_acc := 0.0

	func _process(delta: float) -> void:
		_t += delta
		for q in pings:
			q["t"] -= delta
		pings = pings.filter(func(q): return q["t"] > 0)
		if is_visible_in_tree():
			# 0.44: the map is repainted every frame on High and Ultra, 30 times a second on Medium and
			# 15 on Low (a few hundred draws of every unit in both arenas each time)
			var hz := 0.0
			match Settings.gfx():
				Settings.GFX_LOW:
					hz = 15.0
				Settings.GFX_MEDIUM:
					hz = 30.0
			if hz <= 0.0:
				queue_redraw()
				return
			_redraw_acc += delta
			if _redraw_acc >= 1.0 / hz:
				_redraw_acc = fmod(_redraw_acc, 1.0 / hz)
				queue_redraw()

	func _gui_input(event: InputEvent) -> void:
		if view == null:
			return
		if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed and on_ping.is_valid() and ping_held.is_valid() and bool(ping_held.call()):
			var hs0 := halves()
			var hi0 := _half_at(event.position)
			var mr0: Rect2 = hs0[hi0][1]
			if bool(on_ping.call(((event.position - mr0.position) / mr0.size * Vector2(Sim.W, Sim.H)).clamp(Vector2.ZERO, Vector2(Sim.W, Sim.H)), int(hs0[hi0][0]))):
				accept_event()
				return
		if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed and event.alt_pressed and on_alt_click.is_valid():
			var hs := halves()
			var hi := _half_at(event.position)
			if hs[hi][0] == my_idx():
				var mr: Rect2 = hs[hi][1]
				on_alt_click.call(((event.position - mr.position) / mr.size * Vector2(Sim.W, Sim.H)).clamp(Vector2.ZERO, Vector2(Sim.W, Sim.H)))
			accept_event()
			return
		if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_RIGHT:
			# 0.24: right-click walks your hero to that point (the same order as right-clicking the ground); in a
			# half your hero isn't in it only moves the camera there, like a left-click
			if event.pressed:
				var hs := halves()
				var hi := _half_at(event.position)
				var mr: Rect2 = hs[hi][1]
				var wp: Vector2 = ((event.position - mr.position) / mr.size * Vector2(Sim.W, Sim.H)).clamp(Vector2.ZERO, Vector2(Sim.W, Sim.H))
				if not (on_right_click.is_valid() and bool(on_right_click.call(wp, int(hs[hi][0])))):
					_drag_half = hi
					_jump(event.position, true)
					_drag_half = -1
			accept_event()
			return
		if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
			_dragging = event.pressed
			if event.pressed:
				_drag_half = _half_at(event.position)
				_jump(event.position, true)
			accept_event()
		elif event is InputEventMouseMotion and _dragging:
			_jump(event.position, false)

	# 0.31: [world point, arena idx] under a local point of the minimap (the controller's ping)
	func world_at(local: Vector2) -> Array:
		var hs := halves()
		var hi := _half_at(local)
		var mr: Rect2 = hs[hi][1]
		return [((local - mr.position) / mr.size * Vector2(Sim.W, Sim.H)).clamp(Vector2.ZERO, Vector2(Sim.W, Sim.H)), int(hs[hi][0])]

	func _jump(local: Vector2, switch: bool) -> void:
		var hs := halves()
		var hi := _drag_half if _drag_half >= 0 and _drag_half < hs.size() else _half_at(local)
		var idx: int = hs[hi][0]
		if idx != view.arena_idx:
			if not switch or not on_switch.is_valid():
				return
			on_switch.call(idx)
			if view.arena_idx != idx:
				return   # refused (a duel holds the camera)
		var mr: Rect2 = hs[hi][1]
		view.look_at_world(((local - mr.position) / mr.size * Vector2(Sim.W, Sim.H)).clamp(Vector2.ZERO, Vector2(Sim.W, Sim.H)))

	static var draw_us := 0            # 0.44 perf bench: microseconds spent drawing the minimap

	func _draw() -> void:
		var t0 := Time.get_ticks_usec()
		_draw_map()
		draw_us += Time.get_ticks_usec() - t0

	func _draw_map() -> void:
		draw_rect(Rect2(Vector2.ZERO, size), Color(0, 0, 0))
		Terrain.ensure()
		if sim == null or view == null or sim.arenas.is_empty():
			if Terrain.minimap != null:
				var k0 := minf(size.x / Sim.W, size.y / Sim.H)
				var sz0 := Vector2(Sim.W, Sim.H) * k0
				draw_texture_rect(Terrain.minimap, Rect2((size - sz0) / 2.0, sz0), false)
			UIParts.framed(self, Rect2(Vector2.ZERO, size))
			return
		var hs := halves()
		var mine := my_idx()
		var mouse_half := -1
		if hs.size() > 1 and Rect2(Vector2.ZERO, size).has_point(get_local_mouse_position()):
			mouse_half = _half_at(get_local_mouse_position())
		for hi in hs.size():
			_draw_half(hs[hi][0], hs[hi][1], hs.size() > 1, mine, hi == mouse_half)
		if hs.size() > 1:
			var y0: float = hs[0][1].end.y
			var y1: float = hs[1][1].position.y
			var dy := (y0 + y1) / 2.0
			draw_line(Vector2(2, dy), Vector2(size.x - 2, dy), UIParts.BRONZE_DARK, DIVIDER)
			draw_line(Vector2(2, dy), Vector2(size.x - 2, dy), UIParts.BRONZE, 1.0)
		UIParts.framed(self, Rect2(Vector2.ZERO, size))

	func _draw_half(idx: int, mr: Rect2, labelled: bool, mine: int, hovered: bool) -> void:
		if Terrain.minimap != null:
			draw_texture_rect(Terrain.minimap, mr, false)
		var k := mr.size.x / Sim.W
		var ar = sim.view_arena(idx)
		var viewed: bool = idx == view.arena_idx
		if not viewed:
			draw_rect(mr, Color(0, 0, 0, 0.22))
		if ar.duel:
			draw_arc(mr.position + Sim.JUNCTION_POS * k, Sim.DUEL_RING * k, 0, TAU, 28, Color(UIParts.GOLD_TEXT, 0.9), 1.5)
		for m in ar.mons:
			var col := Palette.get_c("send") if m.sender != null else Color(0.85, 0.8, 0.9)
			if m.fly:
				col = Palette.get_c("send_fly") if m.sender != null else Color(0.95, 0.9, 0.6)
			var rr := maxf(1.4, m.r * k * 1.6)
			draw_rect(Rect2(mr.position + m.p * k - Vector2.ONE * rr, Vector2.ONE * rr * 2.0), col)
		for c in ar.champs:
			if c.dead:
				continue
			var pos: Vector2 = mr.position + c.p * k
			var is_me: bool = c == view.human_champ
			var mm_me := Palette.get_c("mm_me")
			var col := mm_me if is_me else (Palette.ward if ar.team == 0 else Palette.get_c("mm_ember"))
			if is_me:
				# your hero: a bigger blinking marker with a dark halo, visible in either half
				draw_circle(pos, 6.0, Color(0, 0, 0, 0.55))
				draw_arc(pos, 6.2, 0, TAU, 20, Color(mm_me, 0.75), 1.2)
			if Palette.shapes and not is_me and c.pl != null and c.pl.team != sim.players[sim.local].team:
				# 0.43: colour is not the only cue: enemy heroes are diamonds on the minimap
				draw_colored_polygon(PackedVector2Array([pos + Vector2(0, -5.2), pos + Vector2(5.2, 0), pos + Vector2(0, 5.2), pos + Vector2(-5.2, 0)]), Color.BLACK)
				draw_colored_polygon(PackedVector2Array([pos + Vector2(0, -3.9), pos + Vector2(3.9, 0), pos + Vector2(0, 3.9), pos + Vector2(-3.9, 0)]), col)
				continue
			draw_circle(pos, 4.2, Color.BLACK)
			draw_circle(pos, 3.2, col if not is_me or fmod(_t, 0.8) < 0.55 else Color.WHITE)
		if not ar.duel:
			# 0.26: one glyph per standing camp: the Ancient a gold diamond, the pack an orange fang, the grove a pale ring
			for ci in ar.camps_up.size():
				if not ar.camps_up[ci] or ci >= Sim.CAMPS.size():
					continue
				var cp: Vector2 = mr.position + Vector2(Sim.CAMPS[ci]["pos"]) * k
				var ck := String(Sim.CAMPS[ci]["kind"])
				if ck == "beast":
					var tri := PackedVector2Array([cp + Vector2(-6, -5), cp + Vector2(6, -5), cp + Vector2(0, 7)])
					draw_colored_polygon(tri, Color(1.0, 0.6, 0.35))
					draw_polyline(PackedVector2Array([tri[0], tri[1], tri[2], tri[0]]), Color(0, 0, 0, 0.8), 1.2)
				elif ck == "spirit":
					draw_circle(cp, 6.5, Color(0, 0, 0, 0.8))
					draw_circle(cp, 5.3, Color(0.65, 0.88, 1.0))
					draw_circle(cp, 2.0, Color(0.1, 0.2, 0.3))
				else:
					draw_colored_polygon(PackedVector2Array([cp + Vector2(0, -6), cp + Vector2(6, 0), cp + Vector2(0, 6), cp + Vector2(-6, 0)]), Color(1.0, 0.82, 0.3))
					draw_polyline(PackedVector2Array([cp + Vector2(0, -6), cp + Vector2(6, 0), cp + Vector2(0, 6), cp + Vector2(-6, 0), cp + Vector2(0, -6)]), Color(0, 0, 0, 0.8), 1.2)
		for q in pings:
			if q["a"] != -1 and q["a"] != idx:
				continue
			var pp: Vector2 = mr.position + q["p"] * k
			var ph: float = fmod(3.0 - q["t"], 1.0)
			var qc: Color = q["col"]
			draw_arc(pp, 4.0 + ph * 18.0, 0, TAU, 24, Color(qc.r, qc.g, qc.b, (1.0 - ph) * minf(1.0, q["t"])), 2.0)
			if q.has("k"):
				PingUI.draw_icon(self, String(q["k"]), pp, 6.5, minf(1.0, q["t"]))
			else:
				draw_circle(pp, 3.0, Color(qc.r, qc.g, qc.b, minf(1.0, q["t"])))
		if not hint.is_empty() and (int(hint["a"]) == idx or (int(hint["a"]) == -1 and viewed)):
			# the rift a hovered send would go down: a quick bright pulse
			var hp: Vector2 = mr.position + Vector2(hint["p"]) * k
			var ph := fmod((_t - float(hint["t0"])) * 1.6, 1.0)
			draw_arc(hp, 5.0 + ph * 14.0, 0, TAU, 24, Color(1.0, 0.95, 0.6, 1.0 - ph), 2.5)
			draw_circle(hp, 4.0, Color(1.0, 0.95, 0.6, 0.95))
			draw_circle(hp, 2.0, Color(0.3, 0.1, 0.0, 0.9))
		if viewed:
			var vr := view.world_view_rect()
			var r := Rect2(mr.position + vr.position * k, vr.size * k).intersection(mr)
			draw_rect(r, Color(1, 1, 1, 0.9), false, 1.2)
		if labelled:
			var tc: Color = TEAM_COLS[ar.team] if ar.team >= 0 and ar.team < 2 else UIParts.GOLD
			var txt := "Duel" if idx == 2 else ("You" if idx == mine else "Enemy")
			var f := UIParts.font("ui_semi")
			var tw := f.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 10).x
			# in the side margin when the stacked maps leave room, else tucked into the map's corner
			var lr := Rect2(mr.position + Vector2(2, 2), Vector2(tw + 8, 13))
			if mr.position.x - tw - 9 >= 1.0:
				lr = Rect2(Vector2(mr.position.x - tw - 9, mr.get_center().y - 6.5), Vector2(tw + 8, 13))
			draw_rect(lr, Color(0, 0, 0, 0.62))
			draw_rect(lr, Color(tc, 0.7), false, 1.0)
			draw_string(f, lr.position + Vector2(4, 10.5), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 10, tc)
			if hovered and not viewed:
				draw_rect(mr.grow(1), Color(1, 1, 1, 0.45), false, 1.0)


