static var _tight := {}


const TightRects := preload("res://scripts/tight_rects.gd")


static func draw_tight(ci: CanvasItem, name: String, r: Rect2, dir := 3, pose := 0) -> bool:
	var t := Sprites.tex(name)
	if t == null:
		return false
	var m := Sprites.meta(name)
	var fr := int(m["frame"])
	var d := dir if int(m["dirs"]) > 1 else 0
	var key := "%s|%d|%d" % [name, d, pose]
	if not _tight.has(key) and TightRects.RECTS.has(key):
		_tight[key] = TightRects.RECTS[key]   # precomputed: no GPU readback in the middle of a match
	if not _tight.has(key):
		var src := Rect2i(d * fr, mini(pose, int(m["poses"]) - 1) * fr, fr, fr)
		var img := t.get_image()
		var used := Rect2i(src)
		if img != null:
			if img.is_compressed():
				img = img.duplicate()
				img.decompress()
			var sub := img.get_region(src)
			var u := sub.get_used_rect()
			if u.size.x > 0 and u.size.y > 0:
				used = Rect2i(src.position + u.position, u.size)
		_tight[key] = Rect2(used)
	var s: Rect2 = _tight[key]
	var k := minf(r.size.x / s.size.x, r.size.y / s.size.y)
	var dsz := s.size * k
	ci.draw_texture_rect_region(t, Rect2(r.get_center() - dsz / 2.0, dsz), s)
	return true


static func gradient_fill(ci: CanvasItem, r: Rect2, top: Color, bottom: Color, steps := 12) -> void:
	var h := r.size.y / steps
	for i in steps:
		ci.draw_rect(Rect2(r.position + Vector2(0, i * h), Vector2(r.size.x, h + 0.5)), top.lerp(bottom, float(i) / (steps - 1)))


# ---- ability glyphs (white marks drawn over the champion's colour)
static func draw_glyph(ci: CanvasItem, kind: String, r: Rect2, col: Color) -> void:
	var c := r.get_center()
	var u := r.size.x / 2.0
	var w := Color(1, 0.97, 0.9)
	var w2 := Color(1, 0.97, 0.9, 0.55)
	var lw := maxf(1.5, u * 0.09)
	match kind:
		"shot":
			var a := c + Vector2(-u * 0.55, u * 0.55)
			var b := c + Vector2(u * 0.5, -u * 0.5)
			ci.draw_line(a, b, w, lw * 1.3)
			ci.draw_colored_polygon(PackedVector2Array([b + Vector2(u * 0.12, -u * 0.12), b + Vector2(-u * 0.35, -u * 0.05), b + Vector2(u * 0.05, u * 0.35)]), w)
			ci.draw_line(a, a + Vector2(-u * 0.15, -u * 0.2), w2, lw)
			ci.draw_line(a, a + Vector2(u * 0.2, u * 0.15), w2, lw)
		"blast":
			for i in 10:
				var d := Vector2.from_angle(TAU * i / 10.0)
				ci.draw_line(c + d * u * 0.3, c + d * u * (0.75 if i % 2 == 0 else 0.55), w, lw)
			ci.draw_circle(c, u * 0.24, w)
		"rain":
			for i in 5:
				var p := c + Vector2(-u * 0.55 + i * u * 0.28, -u * 0.5 + (i % 2) * u * 0.3)
				ci.draw_line(p, p + Vector2(u * 0.18, u * 0.5), w, lw)
				ci.draw_circle(p + Vector2(u * 0.2, u * 0.55), lw * 0.9, w)
		"nova":
			for i in 3:
				ci.draw_arc(c, u * (0.22 + i * 0.22), 0, TAU, 24, Color(w, 1.0 - i * 0.25), lw, true)
		"cone":
			var pts := PackedVector2Array([c + Vector2(-u * 0.6, u * 0.45)])
			for i in 9:
				pts.append(c + Vector2(-u * 0.6, u * 0.45) + Vector2.from_angle(-PI / 4 - 0.55 + 1.1 * i / 8.0) * u * 1.25)
			ci.draw_colored_polygon(pts, w2)
			ci.draw_polyline(pts + PackedVector2Array([pts[0]]), w, lw * 0.8, true)
		"beam":
			ci.draw_line(c + Vector2(-u * 0.7, u * 0.7), c + Vector2(u * 0.7, -u * 0.7), w2, lw * 4.0)
			ci.draw_line(c + Vector2(-u * 0.7, u * 0.7), c + Vector2(u * 0.7, -u * 0.7), w, lw * 1.5)
		"dash":
			for i in 2:
				var x := -u * 0.45 + i * u * 0.45
				ci.draw_polyline(PackedVector2Array([c + Vector2(x, -u * 0.45), c + Vector2(x + u * 0.38, 0), c + Vector2(x, u * 0.45)]), w, lw * 1.4, true)
		"blink":
			var pts := PackedVector2Array()
			for i in 30:
				var a := i * 0.42
				pts.append(c + Vector2.from_angle(a) * u * (0.08 + i * 0.022))
			ci.draw_polyline(pts, w, lw, true)
			for k in 3:
				ci.draw_circle(c + Vector2.from_angle(k * 2.1 + 0.6) * u * 0.78, lw * 0.9, w)
		"buff":
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0, -u * 0.7), c + Vector2(u * 0.5, -u * 0.1), c + Vector2(u * 0.2, -u * 0.1), c + Vector2(u * 0.2, u * 0.6), c + Vector2(-u * 0.2, u * 0.6), c + Vector2(-u * 0.2, -u * 0.1), c + Vector2(-u * 0.5, -u * 0.1)]), w)
		"team":
			for k in [-1, 0, 1]:
				var p := c + Vector2(k * u * 0.45, -u * 0.1 + absf(k) * u * 0.12)
				ci.draw_circle(p, u * 0.17, w)
				ci.draw_colored_polygon(ArenaView.ellipse_pts(p + Vector2(0, u * 0.38), u * 0.22, u * 0.16, 0, 10), w)
			ci.draw_arc(c, u * 0.78, PI * 1.15, PI * 1.85, 16, w2, lw, true)
		"heal":
			ci.draw_rect(Rect2(c - Vector2(u * 0.17, u * 0.6), Vector2(u * 0.34, u * 1.2)), w)
			ci.draw_rect(Rect2(c - Vector2(u * 0.6, u * 0.17), Vector2(u * 1.2, u * 0.34)), w)
		"zone":
			ci.draw_circle(c, u * 0.62, w2)
			for i in 8:
				var a := TAU * i / 8.0
				ci.draw_arc(c, u * 0.62, a, a + 0.45, 6, w, lw, true)
		"chain":
			ci.draw_polyline(PackedVector2Array([c + Vector2(-u * 0.7, -u * 0.4), c + Vector2(-u * 0.25, u * 0.25), c + Vector2(0, -u * 0.25), c + Vector2(u * 0.3, u * 0.35), c + Vector2(u * 0.7, -u * 0.3)]), w, lw * 1.4, true)
			for p in [Vector2(-0.7, -0.4), Vector2(0, -0.25), Vector2(0.7, -0.3)]:
				ci.draw_circle(c + p * u, lw * 1.3, w)
		"summon":
			var b := Rect2(c + Vector2(-u * 0.32, -u * 0.35), Vector2(u * 0.64, u * 0.95))
			ci.draw_rect(b, w)
			for i in 3:
				ci.draw_rect(Rect2(b.position + Vector2(i * u * 0.24, -u * 0.18), Vector2(u * 0.16, u * 0.18)), w)
			ci.draw_rect(Rect2(c + Vector2(-u * 0.08, u * 0.25), Vector2(u * 0.16, u * 0.35)), Color(col.darkened(0.5)))
		"storm":
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(u * 0.15, -u * 0.75), c + Vector2(-u * 0.4, u * 0.1), c + Vector2(-u * 0.02, u * 0.1), c + Vector2(-u * 0.2, u * 0.75), c + Vector2(u * 0.42, -u * 0.12), c + Vector2(u * 0.04, -u * 0.12)]), w)
		"exec":
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(u * 0.6, -u * 0.6), c + Vector2(u * 0.05, u * 0.2), c + Vector2(-u * 0.2, -u * 0.05)]), w)
			ci.draw_line(c + Vector2(-u * 0.3, u * 0.05), c + Vector2(u * 0.05, u * 0.4), w, lw * 1.3)
			ci.draw_line(c + Vector2(-u * 0.1, u * 0.2), c + Vector2(-u * 0.5, u * 0.6), w, lw * 1.8)
		"pull":
			for k in 4:
				var d := Vector2.from_angle(TAU * k / 4.0 + 0.4)
				var tip := c + d * u * 0.25
				ci.draw_line(c + d * u * 0.75, tip, w, lw)
				ci.draw_colored_polygon(PackedVector2Array([tip, tip + d.rotated(0.5) * u * 0.2, tip + d.rotated(-0.5) * u * 0.2]), w)
			ci.draw_circle(c, u * 0.12, w)
		"eye":
			var pts := PackedVector2Array()
			for i in 20:
				var a := TAU * i / 20.0
				pts.append(c + Vector2(cos(a) * u * 0.72, sin(a) * u * 0.38))
			ci.draw_colored_polygon(pts, w2)
			ci.draw_polyline(pts + PackedVector2Array([pts[0]]), w, lw, true)
			ci.draw_circle(c, u * 0.22, w)
			ci.draw_circle(c, u * 0.1, col.darkened(0.6))
		"follow":
			ci.draw_arc(c, u * 0.45, 0, TAU, 24, w, lw, true)
			for k in 4:
				var d := Vector2.from_angle(TAU * k / 4.0)
				ci.draw_line(c + d * u * 0.25, c + d * u * 0.75, w, lw)
			ci.draw_circle(c, lw, w)
		"passive":
			var pts := PackedVector2Array()
			for i in 10:
				pts.append(c + Vector2.from_angle(-PI / 2 + TAU * i / 10.0) * u * (0.62 if i % 2 == 0 else 0.27))
			ci.draw_colored_polygon(pts, w)
		_:
			ci.draw_circle(c, u * 0.4, w)


# A unit portrait: heroes show head and shoulders, monsters the whole creature.
class Portrait extends Control:
	var def: Dictionary = {}          # champion definition (heroes)
	var sheet := ""                   # or any sprite sheet name (monsters, summons)
	var bg_col := Color(0.35, 0.3, 0.25)
	var team_col := Color("#6cc3b5")
	var dim := false
	var bob := true
	var overlay := ""                 # big text over the picture (respawn timer)
	var skin := ""                    # hero skin id
	var _t := 0.0
	var _fig: Control
	var _over := false                # 0.17: hover outline (only when the portrait takes the mouse)
	var _hov := 0.0

	func _ready() -> void:
		clip_contents = true
		mouse_entered.connect(func(): _over = true)
		mouse_exited.connect(func(): _over = false)
		_fig = Control.new()
		_fig.set_anchors_preset(Control.PRESET_FULL_RECT)
		_fig.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_fig.draw.connect(_draw_fig)
		add_child(_fig)

	func _process(delta: float) -> void:
		if is_visible_in_tree():
			if bob:
				_t += delta
			_hov = UIParts.hover_tick(self, _hov, delta, _over and mouse_filter != Control.MOUSE_FILTER_IGNORE)
			queue_redraw()
			if _fig != null:
				_fig.material = Profile.skin_material(skin) if not def.is_empty() else null
				_fig.queue_redraw()

	func _name() -> String:
		return "hero_" + def["id"] if not def.is_empty() else sheet

	func _draw() -> void:
		var r := Rect2(Vector2.ZERO, size)
		var col := bg_col
		if not def.is_empty():
			col = Color(def["color"])
		if _name() == "":
			UIParts.gradient_fill(self, r, Color(0.12, 0.11, 0.09), Color(0.06, 0.05, 0.04))
			return
		if not def.is_empty():
			UIParts.portrait_bg(self, r, col)
			return
		UIParts.gradient_fill(self, r, col.darkened(0.35), col.darkened(0.82))
		for i in 6:
			draw_circle(size / 2.0, size.x * (0.55 - i * 0.07), Color(col, 0.05))

	func _draw_fig() -> void:
		var r := Rect2(Vector2.ZERO, size)
		var nm := _name()
		if nm == "":
			UIParts.framed(_fig, r)
			var f := UIParts.font("display")
			_fig.draw_string(f, Vector2(0, size.y * 0.66), "?", HORIZONTAL_ALIGNMENT_CENTER, size.x, int(size.y * 0.45), Color(0.6, 0.55, 0.45))
			return
		var turn: int = 3 if not bob else [2, 3, 4, 3][int(_t * 0.6) % 4]
		var ok := false
		if nm.begins_with("hero_"):
			ok = Sprites.draw_bust(_fig, nm, r, turn, 2.0 if size.x > 70 else 1.7)
		else:
			ok = Sprites.draw_fit(_fig, nm, r, turn, 0, 1.25)
		if not ok:
			_fig.draw_string(UIParts.font("ui_semi"), Vector2(0, size.y * 0.6), nm.substr(0, 2).to_upper(), HORIZONTAL_ALIGNMENT_CENTER, size.x, int(size.y * 0.3), Color.WHITE)
		if dim:
			_fig.draw_rect(r, Color(0.05, 0, 0, 0.62))
		if overlay != "":
			var f := UIParts.font("num_semi")
			var fs := int(size.y * 0.32)
			for o in [Vector2(2, 2), Vector2(-2, 2), Vector2(2, -2), Vector2(-2, -2)]:
				_fig.draw_string(f, Vector2(0, size.y * 0.62) + o, overlay, HORIZONTAL_ALIGNMENT_CENTER, size.x, fs, Color(0, 0, 0, 0.9))
			_fig.draw_string(f, Vector2(0, size.y * 0.62), overlay, HORIZONTAL_ALIGNMENT_CENTER, size.x, fs, Color(1.0, 0.55, 0.45))
		UIParts.framed(_fig, r)
		UIParts.bevel(_fig, r.grow(-3), Color(1, 1, 1, 0.12), Color(0, 0, 0, 0.3), 1.5)
		UIParts.hover_draw(_fig, r.grow(-1), _hov, false)


# A simple line chart: series = [{"name", "col", "ys": Array}], xs = times in seconds.
class LineChart extends Control:
	var xs: Array = []
	var series: Array = []
	var title := ""
	var y_fmt := "%d"
	var y_max_fixed := -1.0

	func _draw() -> void:
		var r := Rect2(Vector2.ZERO, size)
		draw_rect(r, Color(0.05, 0.045, 0.035, 0.9))
		UIParts.framed(self, r)
		var f := UIParts.font("ui")
		draw_string(UIParts.font("display"), Vector2(12, 24), title, HORIZONTAL_ALIGNMENT_LEFT, -1, 19, UIParts.GOLD)
		var plot := Rect2(54, 34, size.x - 70, size.y - 92)
		if xs.size() < 2:
			draw_string(f, plot.get_center() - Vector2(80, 0), "Not enough data yet", HORIZONTAL_ALIGNMENT_LEFT, -1, 14, Color(0.7, 0.65, 0.55))
			return
		var ymax := 1.0
		for se in series:
			for y in se["ys"]:
				ymax = maxf(ymax, float(y))
		if y_max_fixed > 0:
			ymax = y_max_fixed
		var xmax: float = maxf(1.0, float(xs[xs.size() - 1]))
		for k in 5:
			var yy := plot.position.y + plot.size.y * (1.0 - k / 4.0)
			draw_line(Vector2(plot.position.x, yy), Vector2(plot.end.x, yy), Color(1, 1, 1, 0.08), 1.0)
			var yv := ymax * k / 4.0
			var yt: String = ("%.0fk" % (yv / 1000.0) if yv >= 10000.0 else ("%.1fk" % (yv / 1000.0) if yv >= 1000.0 else y_fmt % yv))
			draw_string(f, Vector2(4, yy + 5), yt, HORIZONTAL_ALIGNMENT_LEFT, 46, 11, Color(0.7, 0.65, 0.55))
		for k in 5:
			var xx := plot.position.x + plot.size.x * k / 4.0
			var secs := int(xmax * k / 4.0)
			draw_string(f, Vector2(xx - 16, plot.end.y + 16), "%d:%02d" % [secs / 60, secs % 60], HORIZONTAL_ALIGNMENT_LEFT, -1, 11, Color(0.7, 0.65, 0.55))
		for se in series:
			var pts := PackedVector2Array()
			var ys: Array = se["ys"]
			for i in mini(ys.size(), xs.size()):
				pts.append(Vector2(plot.position.x + plot.size.x * float(xs[i]) / xmax, plot.position.y + plot.size.y * (1.0 - clampf(float(ys[i]) / ymax, 0.0, 1.0))))
			if pts.size() >= 2:
				if bool(se.get("dash", false)):
					# dashed: every other short segment along the polyline
					var on := true
					var carry := 0.0
					for i in pts.size() - 1:
						var a: Vector2 = pts[i]
						var b: Vector2 = pts[i + 1]
						var seg := a.distance_to(b)
						var d := 0.0
						while d < seg:
							var step := minf(seg - d, 6.0 - carry)
							if on:
								draw_line(a.lerp(b, d / seg), a.lerp(b, (d + step) / seg), se["col"], float(se.get("w", 2.0)), true)
							d += step
							carry += step
							if carry >= 6.0 - 0.001:
								carry = 0.0
								on = not on
				else:
					draw_polyline(pts, se["col"], float(se.get("w", 2.0)), true)
		# legend
		var lx := 12.0
		var ly := size.y - 22.0
		for se in series:
			var lf := UIParts.font("ui_semi") if bool(se.get("bold", false)) else f
			if bool(se.get("dash", false)):
				draw_rect(Rect2(lx, ly - 9, 5, 4), se["col"])
				draw_rect(Rect2(lx + 9, ly - 9, 5, 4), se["col"])
			else:
				draw_rect(Rect2(lx, ly - 9, 14, 4), se["col"])
			draw_string(lf, Vector2(lx + 18, ly - 2), se["name"], HORIZONTAL_ALIGNMENT_LEFT, -1, 12, Color(1.0, 0.95, 0.85) if bool(se.get("bold", false)) else Color(0.9, 0.86, 0.76))
			lx += 26.0 + lf.get_string_size(se["name"], HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x + 10.0
			if lx > size.x - 100:
				lx = 12.0
				ly += 0.0


# A pulsing frame drawn around another control (tutorial pointers).
class Highlight extends Control:
	var target: Control = null
	var spot := Vector2.INF        # 0.19: a world spot on screen (global position): a pulsing ring with an arrow
	var _t := 0.0

	func _ready() -> void:
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		set_anchors_preset(Control.PRESET_FULL_RECT)
		z_index = 50

	func _process(delta: float) -> void:
		_t += delta
		queue_redraw()

	func _draw() -> void:
		if spot.x != INF:
			var c := spot - get_global_rect().position
			var rr := 26.0 + 5.0 * sin(_t * 6.0)
			draw_arc(c, rr, 0.0, TAU, 40, Color(0, 0, 0, 0.6), 6.0)
			draw_arc(c, rr, 0.0, TAU, 40, Color(GOLD_TEXT, 0.95), 3.0)
			draw_arc(c, rr + 9.0, 0.0, TAU, 40, Color(GOLD_TEXT, 0.35), 2.0)
			var st := Vector2(c.x, c.y - rr - 8.0 - 6.0 * absf(sin(_t * 4.0)))
			draw_colored_polygon(PackedVector2Array([st + Vector2(0, 2), st + Vector2(-14, -20), st + Vector2(14, -20)]), Color(0, 0, 0, 0.6))
			draw_colored_polygon(PackedVector2Array([st, st + Vector2(-12, -18), st + Vector2(12, -18)]), GOLD_TEXT)
		if target == null or not is_instance_valid(target) or not target.is_visible_in_tree():
			return
		var gr := target.get_global_rect()
		var r := Rect2(gr.position - get_global_rect().position, gr.size).grow(4.0 + 3.0 * sin(_t * 6.0))
		draw_rect(r.grow(1), Color(0, 0, 0, 0.55), false, 5.0)
		draw_rect(r, Color(GOLD_TEXT, 0.95), false, 3.0)
		draw_rect(r.grow(4), Color(GOLD_TEXT, 0.35), false, 2.0)
		var bob := 8.0 + 6.0 * absf(sin(_t * 4.0))
		if r.position.y < 40.0:
			# 0.19: a target in the top bar gets its arrow from below
			var tb := Vector2(r.get_center().x, r.end.y + bob)
			draw_colored_polygon(PackedVector2Array([tb, tb + Vector2(-12, 18), tb + Vector2(12, 18)]), GOLD_TEXT)
		else:
			var tip := Vector2(r.get_center().x, r.position.y - bob)
			draw_colored_polygon(PackedVector2Array([tip, tip + Vector2(-12, -18), tip + Vector2(12, -18)]), GOLD_TEXT)


# 0.17: one hover state for every UIParts button. `hov` eases 0..1 in ~80 ms; the button lifts a touch
# (scale about its centre, so layouts don't move) and hover_draw paints a bright 2 px outline, a brighten
# wash and a darker, sunken pressed state. Off with Settings.hover_hl (the old flat look stays).
static func hover_tick(b: Control, hov: float, delta: float, hovered: bool) -> float:
	var target := 1.0 if hovered and Settings.hover_hl else 0.0
	hov = move_toward(hov, target, delta / 0.08)
	if hov > 0.001 or b.scale != Vector2.ONE:
		b.pivot_offset = b.size / 2.0
		var held := hovered and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
		b.scale = Vector2.ONE * (1.0 + (0.035 - (0.06 if held else 0.0)) * hov)
	return hov


static func hover_held(b: Control) -> bool:
	return b.scale.x < 0.999


static func hover_draw(ci: CanvasItem, r: Rect2, hov: float, held: bool) -> void:
	if hov <= 0.01:
		return
	if held:
		ci.draw_rect(r, Color(0, 0, 0, 0.22 * hov))
	else:
		ci.draw_rect(r, Color(1.0, 0.92, 0.7, 0.1 * hov))
	ci.draw_rect(r.grow(1), Color(1.0, 0.95, 0.78, 0.95 * hov), false, 2.0)
	ci.draw_rect(r.grow(3), Color(1.0, 0.9, 0.6, 0.25 * hov), false, 1.0)


