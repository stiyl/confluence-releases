func menu_offer() -> void:
	if entry != null and is_instance_valid(entry) and entry is UIParts.MenuEntry and entry.text_box != null and entry.text_box.get_child_count() > 1:
		(entry.text_box.get_child(1) as Label).text = menu_line()
