func _view_rect() -> Rect2:
	var vr: Rect2 = main.get_viewport().get_visible_rect()
	return Rect2(vr.position + Vector2(0, main.TOPBAR_H), vr.size - Vector2(0, main.TOPBAR_H + main.CONSOLE_H - 26.0))


func _point() -> void:
	var tg := target()
	var ctl = tg[0]
	var wp: Vector2 = tg[1]
	layer.target = Rect2()
	layer.spot = Vector2.INF
	layer.edge = Vector2.INF
	layer.dim = false
	if ctl is Control and is_instance_valid(ctl) and ctl.is_visible_in_tree():
		layer.target = ctl.get_global_rect()
	var av = main.arena_view
	var own: bool = main.sim != null and (av.arena_idx == main.myt() or (main.sim.duel_on and id == "duel"))
	if wp.x != INF and own:
		var sp: Vector2 = av.get_global_transform() * av.to_screen(wp)
		var vr := _view_rect().grow(-24.0)
		if vr.has_point(sp):
			layer.spot = sp
		else:
			var cen := vr.get_center()
			var d := sp - cen
			if d.length() > 1.0:
				d = d.normalized()
				var tx := INF
				var ty := INF
				if absf(d.x) > 0.001:
					tx = (vr.size.x * 0.5 - 20.0) / absf(d.x)
				if absf(d.y) > 0.001:
					ty = (vr.size.y * 0.5 - 20.0) / absf(d.y)
				layer.edge = cen + d * minf(tx, ty)
				layer.edge_dir = d
	# dim the rest of the screen for a HUD element (not while a panel is open: the panel is the lesson)
	layer.dim = layer.target.size != Vector2.ZERO and layer.spot.x == INF and not main.shop_panel.visible and not main.core_panel.visible and not main.board_open
	_layout()


# Where the plaque goes: the first spot down the left (then the right) edge that covers nothing it must not.
func _layout() -> void:
	var shop_open: bool = main.shop_panel.visible
	if shop_open and running and id != "resume":
		# the Armory covers the screen at 1280x720: the narrator's line moves into its hint line
		plaque.visible = false
		var line := TutorialData.NARRATOR.split(" ")[-1] + ":  " + _plain(do_lbl.text)
		if main.shop_status.text != line:
			main.shop_status.set_deferred("text", line)   # after this frame's refresh_shop
		return
	plaque.visible = running and not (done_ov != null and done_ov.visible)
	var vr: Rect2 = main.get_viewport().get_visible_rect()
	# must not cover: panels and cards, what is pointed at; should not cover: your hero, the message log
	var hard: Array = []
	var soft: Array = []
	for x in [main.duel_lbl, main.bless_lbl, main.boss_box, main.core_panel, main.board,
			main.vote_ui.card if main.vote_ui != null else null, main.vote_ui.banner if main.vote_ui != null else null]:
		if x == null or not is_instance_valid(x) or not x.is_visible_in_tree():
			continue
		if x is Label and String(x.text) == "":
			continue
		var r: Rect2 = x.get_global_rect()
		if r.size.x < 2.0 or r.size.y < 2.0:
			continue
		hard.append(r.grow(8.0))
	if layer.target.size != Vector2.ZERO:
		hard.append(layer.target.grow(40.0))
	if layer.spot.x != INF:
		hard.append(Rect2(layer.spot - Vector2(70, 110), Vector2(140, 170)))
	if layer.edge.x != INF:
		hard.append(Rect2(layer.edge - Vector2(40, 40), Vector2(80, 80)))
	var av = main.arena_view
	var c = hero() if main.sim != null else null
	if c != null and not c.dead and (av.arena_idx == c.ar.idx):
		var hp: Vector2 = av.get_global_transform() * av.to_screen(c.p)
		var hr := Rect2(hp - Vector2(60, 90), Vector2(120, 130))
		if main.sim.duel_on:
			hard.append(hr)   # the duel ring: your hero is the lesson
		else:
			soft.append(hr)
	for l in main.log_lbls:
		if l is Label and l.is_visible_in_tree() and String(l.text) != "" and l.modulate.a > 0.05:
			var r: Rect2 = l.get_global_rect()
			var tw: float = l.get_theme_font("font").get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, l.get_theme_font_size("font_size")).x
			soft.append(Rect2(r.position, Vector2(minf(r.size.x, tw + 6.0), r.size.y)))
	var top: float = vr.position.y + main.TOPBAR_H + 10.0
	var bottom: float = vr.end.y - main.CONSOLE_H - 8.0
	if _placed:
		plaque.size = Vector2(_w(), 0)
		if _fits(Rect2(plaque.global_position, Vector2(_w(), plaque.get_combined_minimum_size().y)), hard, top, bottom, vr):
			return   # stay put while the place still works (a plaque that hops about is hard to read and click)
	for pass_i in 3:
		# 0: the full plaque clear of everything; 1: clear of what it must not cover; 2: compact (title and
		# the one thing to do) beside a big panel on a small screen
		_set_compact(pass_i == 2)
		var w := _w()
		plaque.size = Vector2(w, 0)
		var h: float = plaque.get_combined_minimum_size().y
		var avoid: Array = hard + (soft if pass_i == 0 else [])
		for x in [vr.position.x + 16.0, vr.end.x - w - 16.0]:
			var y := top
			while y + h <= bottom:
				var r := Rect2(Vector2(x, y), Vector2(w, h))
				if _fits(r, avoid, top, bottom, vr):
					plaque.global_position = r.position
					_placed = true
					return
				y += 12.0
	# nowhere is clear: the compact plaque where it covers the least of what it must not cover
	var w2 := _w()
	var h2: float = plaque.get_combined_minimum_size().y
	var best := Vector2(vr.position.x + 16.0, top)
	var least := INF
	var x2 := vr.position.x + 16.0
	while x2 + w2 <= vr.end.x - 16.0:
		var y2 := top
		while y2 + h2 <= bottom:
			var r := Rect2(Vector2(x2, y2), Vector2(w2, h2))
			var area := 0.0
			for a in hard:
				var ix: Rect2 = r.intersection(a)
				area += ix.get_area()
			if area < least - 0.5:
				least = area
				best = r.position
			y2 += 12.0
		x2 += 24.0
	plaque.global_position = best
	_placed = true


func _fits(r: Rect2, avoid: Array, top: float, bottom: float, vr: Rect2) -> bool:
	if r.position.y < top - 0.5 or r.end.y > bottom + 0.5 or r.position.x < vr.position.x or r.end.x > vr.end.x:
		return false
	for a in avoid:
		if r.intersects(a):
			return false
	return true


var compact := false


func _w() -> float:
	return W_COMPACT if compact else W


func _set_compact(on: bool) -> void:
	if compact == on:
		return
	compact = on
	pips.visible = not on
	say_lbl.visible = not on
	btn_row.visible = not on
	crest.visible = not on
	do_lbl.custom_minimum_size = Vector2((W_COMPACT - 30.0) if on else (W - CREST_W - 40.0), 0)


static func _plain(bb: String) -> String:
	return bb.replace("[b]", "").replace("[/b]", "")


