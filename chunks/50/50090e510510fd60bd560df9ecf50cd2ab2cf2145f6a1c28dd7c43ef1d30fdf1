	ci.draw_rect(Rect2(r.position + Vector2(r.size.x - w, 0), Vector2(w, r.size.y)), dark)


static func framed(ci: CanvasItem, r: Rect2, gold := false) -> void:
	ci.draw_rect(r.grow(1.5), Color(0, 0, 0, 0.9), false, 1.5)
	ci.draw_rect(r, BRONZE_LITE if gold else BRONZE, false, 2.0)
