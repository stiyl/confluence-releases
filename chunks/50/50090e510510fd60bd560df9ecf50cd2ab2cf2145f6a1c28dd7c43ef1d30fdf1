# Boon / relic emblems keyed by the data's "icon" field.
static func draw_emblem(ci: CanvasItem, icon: String, r: Rect2, col: Color) -> void:
	var c := r.get_center()
	var u := r.size.x / 2.0
	var w := Color(1, 0.96, 0.88)
	var lw := maxf(2.0, u * 0.1)
	match icon:
		"dmg":
			ci.draw_line(c + Vector2(-0.55, 0.55) * u, c + Vector2(0.5, -0.5) * u, w, lw * 1.6)
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0.68, -0.68) * u, c + Vector2(0.3, -0.58) * u, c + Vector2(0.58, -0.3) * u]), w)
			ci.draw_line(c + Vector2(-0.5, 0.05) * u, c + Vector2(-0.05, 0.5) * u, w, lw * 1.4)
			ci.draw_circle(c + Vector2(-0.62, 0.62) * u, lw * 1.1, w)
		"hp", "life":
			var pts := PackedVector2Array()
			for i in 32:
				var t := TAU * i / 32.0
				pts.append(c + Vector2(16.0 * pow(sin(t), 3), -(13.0 * cos(t) - 5.0 * cos(2 * t) - 2.0 * cos(3 * t) - cos(4 * t))) * u * 0.036 + Vector2(0, -0.05 * u))
			ci.draw_colored_polygon(pts, w)
			if icon == "life":
				ci.draw_rect(Rect2(c + Vector2(-0.08, -0.3) * u, Vector2(0.16, 0.5) * u), col.darkened(0.4))
				ci.draw_rect(Rect2(c + Vector2(-0.25, -0.13) * u, Vector2(0.5, 0.16) * u), col.darkened(0.4))
		"as", "ms":
			for k in 2:
				var x := (-0.45 + k * 0.42) * u
				ci.draw_polyline(PackedVector2Array([c + Vector2(x, -0.45 * u), c + Vector2(x + 0.38 * u, 0), c + Vector2(x, 0.45 * u)]), w, lw * 1.4, true)
			if icon == "ms":
				ci.draw_line(c + Vector2(-0.7, 0.62) * u, c + Vector2(0.7, 0.62) * u, Color(w, 0.6), lw)
		"ls":
			var pts := PackedVector2Array([c + Vector2(0, -0.7) * u])
			for i in 17:
				var a := PI * 0.15 - PI * 1.3 * i / 16.0
				pts.append(c + Vector2(0, 0.15 * u) + Vector2(cos(a), -sin(a)) * u * 0.45)
			ci.draw_colored_polygon(pts, Color("#e05a4a"))
			ci.draw_polyline(pts + PackedVector2Array([pts[0]]), w, lw * 0.8, true)
		"cdr":
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(-0.45, -0.65) * u, c + Vector2(0.45, -0.65) * u, c + Vector2(0, 0) * u]), w)
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0, 0) * u, c + Vector2(0.45, 0.65) * u, c + Vector2(-0.45, 0.65) * u]), Color(w, 0.55))
			ci.draw_line(c + Vector2(-0.55, -0.68) * u, c + Vector2(0.55, -0.68) * u, w, lw)
			ci.draw_line(c + Vector2(-0.55, 0.68) * u, c + Vector2(0.55, 0.68) * u, w, lw)
		"armor":
			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(-0.6, -0.6) * u, c + Vector2(0, -0.75) * u, c + Vector2(0.6, -0.6) * u, c + Vector2(0.55, 0.05) * u, c + Vector2(0, 0.75) * u, c + Vector2(-0.55, 0.05) * u]), w)
			ci.draw_line(c + Vector2(0, -0.55) * u, c + Vector2(0, 0.5) * u, col.darkened(0.45), lw)
		"gold":
			for k in 3:
				var p := c + Vector2((k - 1) * 0.28, 0.35 - k * 0.25) * u
				ci.draw_circle(p, u * 0.36, COIN_DARK)
				ci.draw_circle(p, u * 0.3, COIN)
				ci.draw_arc(p, u * 0.2, 0, TAU, 16, COIN.darkened(0.25), lw * 0.6, true)
		"core":
			var pts := PackedVector2Array([c + Vector2(0, -0.78) * u, c + Vector2(0.42, -0.1) * u, c + Vector2(0, 0.78) * u, c + Vector2(-0.42, -0.1) * u])
			ci.draw_colored_polygon(pts, Color("#a8e6dc"))
			ci.draw_colored_polygon(PackedVector2Array([pts[0], pts[1], c + Vector2(0, 0.78) * u]), Color("#6cc3b5"))
			ci.draw_polyline(pts + PackedVector2Array([pts[0]]), w, lw * 0.7, true)
		"xp":
			var pts := PackedVector2Array()
			for i in 10:
				pts.append(c + Vector2.from_angle(-PI / 2 + TAU * i / 10.0) * u * (0.72 if i % 2 == 0 else 0.3))
			ci.draw_colored_polygon(pts, w)
		"onhit":
			UIParts.draw_glyph(ci, "storm", r, col)
		"crit":
			UIParts.draw_glyph(ci, "eye", r, col)
		"regen":
			UIParts.draw_glyph(ci, "heal", r.grow(-u * 0.1), col)
		_:
			UIParts.draw_glyph(ci, "passive", r, col)


# A collectible-looking boon card: rarity band and corner gem, an emblem medallion,
# a keycap number, display-face title, meta line and body. Hover lifts the card.
class BoonCard extends Button:
	var rarity_col := Color("#d9cfb8")
	var emblem := ""
	var card_icon := ""     # "item:<id>" the item's icon, "ab:<hero>:<i>" the ability icon, "hero:<id>" the hero's bust, else a glyph
	var hero := ""          # hero id: a small bust badge on the icon (abilities and passives from that hero)
	var key := ""
	var face: Control
	var fit_peers: Array = []   # cards in the same row: all take the height of the tallest content
	var min_h := 230.0
	var _h := 0.0

	func _init() -> void:
		focus_mode = Control.FOCUS_NONE
		flat = true
		for st in ["normal", "hover", "pressed", "disabled", "focus", "hover_pressed"]:
			add_theme_stylebox_override(st, StyleBoxEmpty.new())
		face = Control.new()
		face.mouse_filter = Control.MOUSE_FILTER_IGNORE
		face.draw.connect(_draw_face)
		add_child(face)

	func _process(delta: float) -> void:
		var tgt := 1.0 if is_hovered() else 0.0
		if absf(_h - tgt) > 0.001:
			_h = move_toward(_h, tgt, delta * 8.0)
			queue_redraw()
			face.queue_redraw()
		face.size = size
		face.position = Vector2(0, -8.0 * (1.0 - pow(1.0 - _h, 3.0)))
		if not fit_peers.is_empty():
			var need := min_h
			for p in fit_peers:
				if is_instance_valid(p):
					need = maxf(need, p.content_h())
			if absf(custom_minimum_size.y - need) > 1.0:
				custom_minimum_size.y = need

	# height the face's text column needs (it sits under the medallion)
	func content_h() -> float:
		for ch in face.get_children():
			if ch is Control:
				return ch.offset_top + ch.get_combined_minimum_size().y + 18.0
		return min_h

	func _draw() -> void:
		var r := Rect2(Vector2.ZERO, size)
		for i in 6:
			draw_rect(r.grow(2.0 + i * 2.0 + _h * 2.0), Color(0, 0, 0, 0.07))

	func _draw_face() -> void:
		var r := Rect2(Vector2.ZERO, size)
		UIParts.gradient_fill(face, r, Color("#221d17"), Color("#110f0c"), 10)
		# rarity band
		var band := Rect2(0, 0, size.x, 8)
		face.draw_rect(band, rarity_col.darkened(0.25))
		face.draw_rect(Rect2(0, 0, size.x, 3), rarity_col)
		UIParts.gradient_fill(face, Rect2(0, 8, size.x, 46), Color(rarity_col, 0.16), Color(rarity_col, 0.0), 8)
		# frame
		var stroke := rarity_col.lerp(Color("#ffffff"), 0.35 * _h) if rarity_col != Color("#d9cfb8") else UIParts.BRONZE.lerp(UIParts.BRONZE_LITE, _h)
		face.draw_rect(r.grow(1), Color(0, 0, 0, 0.9), false, 1.0)
		face.draw_rect(r, stroke, false, 2.0)
		face.draw_rect(r.grow(-4), Color(UIParts.BRONZE_DARK, 0.9), false, 1.0)
		# corner gem
		var g := Vector2(size.x - 20, 22)
		face.draw_colored_polygon(PackedVector2Array([g + Vector2(0, -9), g + Vector2(8, 0), g + Vector2(0, 9), g + Vector2(-8, 0)]), Color(0, 0, 0, 0.8))
		face.draw_colored_polygon(PackedVector2Array([g + Vector2(0, -7), g + Vector2(6, 0), g + Vector2(0, 7), g + Vector2(-6, 0)]), rarity_col)
		face.draw_colored_polygon(PackedVector2Array([g + Vector2(0, -7), g + Vector2(6, 0), g]), rarity_col.lightened(0.45))
		# emblem medallion
		var mc := Vector2(size.x / 2.0, 76)
		face.draw_circle(mc, 40, Color(0, 0, 0, 0.6))
		face.draw_circle(mc, 37, rarity_col.darkened(0.72))
		face.draw_circle(mc, 31, rarity_col.darkened(0.55))
		face.draw_arc(mc, 37, 0, TAU, 48, stroke, 2.0, true)
		face.draw_arc(mc, 31, 0, TAU, 48, Color(UIParts.BRONZE_DARK, 0.9), 1.0, true)
		if card_icon.begins_with("item:"):
			if not Sprites.draw_fit(face, "item_" + card_icon.substr(5), Rect2(mc - Vector2(30, 30), Vector2(60, 60)), 0, 0, 1.0):
				UIParts.draw_glyph(face, "passive", Rect2(mc - Vector2(20, 20), Vector2(40, 40)), rarity_col)
		elif card_icon.begins_with("ab:") and UIParts.ability_tex(card_icon.substr(3)) != null:
			# the ability's rendered icon as a framed tile over the medallion
			var tr := Rect2(mc - Vector2(36, 36), Vector2(72, 72))
			face.draw_rect(tr.grow(3), Color(0, 0, 0, 0.85))
			face.draw_texture_rect(UIParts.ability_tex(card_icon.substr(3)), tr, false)
			UIParts.bevel(face, tr, Color(1, 1, 1, 0.18), Color(0, 0, 0, 0.4), 2.0)
			face.draw_rect(tr.grow(1), stroke, false, 2.0)
		elif card_icon.begins_with("hero:"):
			var hd := TalentData.champ(card_icon.substr(5))
			var tr2 := Rect2(mc - Vector2(36, 36), Vector2(72, 72))
			face.draw_rect(tr2.grow(3), Color(0, 0, 0, 0.85))
			UIParts.portrait_bg(face, tr2, Color(hd["color"]))
			Sprites.draw_bust(face, "hero_" + hd["id"], tr2, 3)
			face.draw_rect(tr2.grow(1), stroke, false, 2.0)
			# passive mark: a small star chip
			var sc := tr2.position + Vector2(10, 10)
			face.draw_circle(sc, 10, Color(0, 0, 0, 0.85))
			face.draw_circle(sc, 8.5, rarity_col.darkened(0.45))
			UIParts.draw_emblem(face, "xp", Rect2(sc - Vector2(7, 7), Vector2(14, 14)), rarity_col)
		elif card_icon != "":
			UIParts.draw_glyph(face, card_icon, Rect2(mc - Vector2(22, 22), Vector2(44, 44)), rarity_col.lightened(0.3))
		else:
			UIParts.draw_emblem(face, emblem, Rect2(mc - Vector2(22, 22), Vector2(44, 44)), rarity_col)
		# hero badge: whose kit the card comes from
		if hero != "" and not card_icon.begins_with("hero:"):
			var hd2 := TalentData.champ(hero)
			var br := Rect2(mc + Vector2(18, 10), Vector2(34, 34))
			face.draw_rect(br.grow(2), Color(0, 0, 0, 0.9))
			UIParts.portrait_bg(face, br, Color(hd2["color"]))
			Sprites.draw_bust(face, "hero_" + hero, br, 3)
			face.draw_rect(br, Color(hd2["color"]).lightened(0.25), false, 1.5)
		# number keycap
		if key != "":
			UIParts.keycap(face, Vector2(12, 14), key, 13, 20.0)


# A small live 3D stage: heroes facing monsters on a cobbled dais, with looping ability-effect models
# (the main-menu backdrop; tools/bake_mode_thumbs.gd renders the mode-card thumbnails with it).
# layout: {"heroes": [hero ids], "mons": [model names], "fx": [[fx id, "fly"|"ground"|"aura"|"sky", index]],
#          "shift": horizontal camera shift in metres (negative moves the stage right), "dist", "fov", "sky": bool}
#          0.24 "v2": the main menu's dusk look (sky with a low sun behind the monsters, layered ridges in haze, trees
#          framing the sides, warm key + sunset rim light, idle breathing and attack loops through the 0.20 UnitAnim);
#          "clear_px": keep the figures right of this many pixels (the menu column); "hero_rot" / "mon_rot": facing.
class Diorama extends SubViewportContainer:
	const FxM := preload("res://scripts/fx_models.gd")
	const UA := preload("res://scripts/anim.gd")
	var layout := {}
	var anims: Array = []     # v2: [Node3D, UnitAnim.St, rig, attack period, phase, cast, ranged, last u]
	var _last_pose_t := 0.0
	var vp: SubViewport
	var cam: Camera3D
	var heroes: Array = []    # [Node3D, base pos]
	var mons: Array = []
	var fxs: Array = []       # [MeshInstance3D, mode, a, b, base scale, phase]
	var animate := true
	var _t := 0.0
	var _framed_for := Vector2.ZERO
	var _span := Vector2(-3, 3)     # x range the figures occupy
	var _sun: DirectionalLight3D
	var _gfx_seen := -1

	func _ready() -> void:
		stretch = true
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		vp = SubViewport.new()
		vp.own_world_3d = true
		vp.msaa_3d = Viewport.MSAA_2X
		vp.transparent_bg = false
		add_child(vp)
		build()

	func build() -> void:
		var v2 := bool(layout.get("v2", false))
		var env := Environment.new()
		var sky := Sky.new()
		var sm := ProceduralSkyMaterial.new()
		sm.sky_top_color = Color(0.1, 0.12, 0.2)
		sm.sky_horizon_color = Color(0.42, 0.34, 0.28)
		sm.ground_horizon_color = Color(0.42, 0.34, 0.28)
		sm.ground_bottom_color = Color(0.2, 0.18, 0.14)
		if v2:
			# dusk: deep blue overhead, a warm amber band at the horizon where the low sun sits
			sm.sky_top_color = Color(0.07, 0.11, 0.30)
			sm.sky_horizon_color = Color(1.0, 0.6, 0.34)
			sm.sky_curve = 0.12
			sm.sky_energy_multiplier = 1.0
			sm.ground_horizon_color = Color(0.62, 0.45, 0.36)
			sm.ground_bottom_color = Color(0.16, 0.13, 0.11)
			sm.sun_angle_max = 9.0
			sm.sun_curve = 0.12
		sky.sky_material = sm
		env.background_mode = Environment.BG_SKY
		env.sky = sky
		env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
		env.ambient_light_color = Color(0.62, 0.62, 0.72)
		env.ambient_light_energy = 0.5
		env.tonemap_mode = Environment.TONE_MAPPER_FILMIC
		env.tonemap_exposure = 1.05
		env.fog_enabled = true
		env.fog_light_color = Color(0.36, 0.3, 0.26)
		env.fog_density = float(layout.get("fog", 0.02))
		env.fog_sky_affect = 0.0
		if v2:
			env.ambient_light_color = Color(0.46, 0.52, 0.72)    # cool sky fill, so the warm key and rim read
			env.ambient_light_energy = 0.42
			env.tonemap_exposure = 0.95
			env.fog_light_color = Color(0.86, 0.6, 0.44)        # amber haze: distance fades toward the horizon
			env.fog_density = float(layout.get("fog", 0.0025))
			env.reflected_light_source = Environment.REFLECTION_SOURCE_DISABLED   # no bright-sky sheen on grazing ground
		var we := WorldEnvironment.new()
		we.environment = env
		vp.add_child(we)
		var sun := DirectionalLight3D.new()
		_sun = sun
		sun.light_energy = 1.2
		sun.light_color = Color(1.0, 0.88, 0.72)
		sun.shadow_enabled = true
		sun.directional_shadow_max_distance = 30.0
		vp.add_child(sun)
		sun.look_at_from_position(Vector3(-5, 8, 6), Vector3.ZERO)
		var rim := DirectionalLight3D.new()
		rim.light_energy = 0.9
		rim.light_color = Color(0.55, 0.7, 1.0)
		vp.add_child(rim)
		rim.look_at_from_position(Vector3(3, 4, -8), Vector3.ZERO)
		if v2:
			# warm key from the front left (soft shadows, one cascade: cheap); the setting sun behind the monsters is
			# the rim light (and the sun disc in the sky), so every figure gets a bright edge
			sun.light_energy = 1.15
			sun.light_color = Color(1.0, 0.86, 0.7)
			sun.sky_mode = DirectionalLight3D.SKY_MODE_LIGHT_ONLY
			sun.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL
			sun.directional_shadow_max_distance = 22.0
			sun.shadow_blur = 1.6
			sun.shadow_opacity = 0.85
			sun.look_at_from_position(Vector3(-6, 7.5, 8), Vector3.ZERO)
			rim.light_energy = 2.1
			rim.light_color = Color(1.0, 0.62, 0.36)
			rim.look_at_from_position(Vector3(5.5, 2.5, -16), Vector3(0, 0.6, 0))   # the sun sits low over the monsters
		# ground: grass field with a cobbled dais
		var gm := MeshInstance3D.new()
		var pm := PlaneMesh.new()
		pm.size = Vector2(240, 240)
		gm.mesh = pm
		gm.material_override = _tex_mat("res://art/terrain/grass.png", 60.0, Color(0.5, 0.56, 0.42))
		vp.add_child(gm)
		if v2:
			gm.material_override = _tex_mat("res://art/terrain/grass.png", 60.0, Color(0.36, 0.50, 0.25))
			if DisplayServer.get_name() != "headless":
				_ridges()
		var dm := MeshInstance3D.new()
		var cy := CylinderMesh.new()
		cy.top_radius = 6.2
		cy.bottom_radius = 6.4
		cy.height = 0.12
		cy.radial_segments = 48
		dm.mesh = cy
		dm.position = Vector3(0, 0.0, 0)
		dm.material_override = _tex_mat("res://art/terrain/cobble.png", 3.0, Color(0.72, 0.68, 0.64))
		vp.add_child(dm)
		if v2 and DisplayServer.get_name() != "headless":   # (the dummy renderer has no mesh storage for these)
			# a stone kerb round the dais: a clean edge instead of the cobbles stopping in the grass
			var kb := MeshInstance3D.new()
			var tm := TorusMesh.new()
			tm.inner_radius = 6.15
			tm.outer_radius = 6.55
			tm.rings = 64
			tm.ring_segments = 6
			kb.mesh = tm
			kb.scale = Vector3(1.0, 0.35, 1.0)
			kb.position = Vector3(0, 0.05, 0)
			kb.material_override = _tex_mat("res://art/terrain/cobble.png", 6.0, Color(0.58, 0.55, 0.52))
			vp.add_child(kb)
		if v2:
			_scenery_v2()
		else:
			_scenery()
		cam = Camera3D.new()
		cam.fov = float(layout.get("fov", 34.0))
		vp.add_child(cam)
		cam.current = true
		var hs: Array = layout.get("heroes", [])
		for i in hs.size():
			var inst := Models3D.instance("hero_" + String(hs[i]))
			var p := Vector3(-1.2 - i * float(layout.get("gap", 1.25)), 0.06, 1.6 - absf(i - (hs.size() - 1) / 2.0) * 0.9 - 0.6 * (i % 2))
			if hs.size() == 1:
				p = Vector3(-1.6, 0.06, 0.6)
			inst.position = p
			inst.rotation.y = float(layout.get("hero_rot", -0.55))
			vp.add_child(inst)
			heroes.append([inst, p, randf() * 3.0])
			if v2:
				_anim_add(inst, "hero_" + String(hs[i]), 2.6 + 0.35 * i, 0.7 * i, String(hs[i]) in ["sylra", "aurelia"], String(hs[i]) == "varric")
		var ms: Array = layout.get("mons", [])
		for i in ms.size():
			var nm := String(ms[i])
			var foe_hero := nm.begins_with("hero:")
			if foe_hero:
				nm = "hero_" + nm.substr(5)
			var inst := Models3D.instance(nm)
			var am := Models3D.merged(nm)
			var ab := am.get_aabb() if am != null else AABB(Vector3.ZERO, Vector3(1, 2, 1))
			var h := maxf(ab.size.y, maxf(ab.size.x, ab.size.z) * 0.6)
			var k := clampf(1.9 / maxf(0.2, h), 0.5, 2.4) * (1.35 if i == 0 and ms.size() > 2 else 1.0)
			if foe_hero:
				k = 1.0
			inst.scale = Vector3.ONE * k
			var p := Vector3(1.5 + i * float(layout.get("gap", 1.25)) * 1.05, 0.06, 1.2 - absf(i - (ms.size() - 1) / 2.0) * 0.9 - 0.7 * (i % 2))
			inst.position = p
			inst.rotation.y = float(layout.get("mon_rot", PI + 0.6))
			vp.add_child(inst)
			mons.append([inst, p, randf() * 3.0])
			if v2:
				_anim_add(inst, nm, 1.7 + 0.3 * i, 0.45 + 0.6 * i, false, false)
		for f in layout.get("fx", []):
			var m: ArrayMesh = FxM.mesh(String(f[0]))
			if m == null:
				continue
			var mi := MeshInstance3D.new()
			mi.mesh = m
			mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			var bb := m.get_aabb()
			var mode := String(f[1])
			var idx := int(f[2]) if f.size() > 2 else 0
			var want: float = {"fly": 1.7, "ground": 3.2, "aura": 2.4, "sky": 3.2}.get(mode, 1.5)
			var s := want / maxf(0.05, maxf(bb.size.x, maxf(bb.size.y, bb.size.z)))
			var a := Vector3.ZERO
			var b := Vector3.ZERO
			if mode == "fly" and not heroes.is_empty() and not mons.is_empty():
				a = heroes[idx % heroes.size()][1] + Vector3(0.5, 1.2, 0)
				b = mons[idx % mons.size()][1] + Vector3(-0.3, 1.0, 0)
			elif mode == "aura" and not heroes.is_empty():
				a = heroes[idx % heroes.size()][1]
			elif mode == "ground" and not mons.is_empty():
				a = mons[idx % mons.size()][1] + Vector3(0, 0.08, 0)
			elif mode == "sky" and not mons.is_empty():
				a = mons[idx % mons.size()][1] + Vector3(0, 0.1, 0)
			mi.position = a
			vp.add_child(mi)
			fxs.append([mi, mode, a, b, s, randf() * 2.0])
		var xs: Array = []
		for h in heroes + mons:
			xs.append(h[1].x)
		if not xs.is_empty():
			_span = Vector2(xs.min() - 0.9, xs.max() + 0.9)
			if v2:
				_span.y += 1.0     # the fire ring round the last monster stays in frame
		_pose(0.0)
		frame()

	# Fits the figures into the screen band layout["band"] = [left, right] (fractions of the width),
	# from a low camera (about 17 degrees down).
	func frame() -> void:
		var sz := size if size.x > 1 else Vector2(vp.size)
		if sz.x < 2 or sz.y < 2:
			return
		_framed_for = sz
		var band: Array = (layout.get("band", [0.06, 0.94]) as Array).duplicate()
		if layout.has("clear_px"):
			band[0] = maxf(float(band[0]), (float(layout["clear_px"]) + 36.0) / sz.x)   # never under the menu column
		var bw := float(band[1]) - float(band[0])
		var th := tan(deg_to_rad(cam.fov * 0.5)) * sz.x / sz.y
		var stage_w := _span.y - _span.x
		var d := maxf(stage_w / (bw * 2.0 * th), 6.0) * float(layout.get("zoom_out", 1.0))
		var cx := (_span.x + _span.y) * 0.5
		var full_w := 2.0 * d * th
		var off := ((float(band[0]) + float(band[1])) * 0.5 - 0.5) * full_w
		var el := float(layout.get("elev", 0.3))
		cam.look_at_from_position(Vector3(cx, 0.9 + d * el, d), Vector3(cx, float(layout.get("look_y", 0.95)), 0))
		cam.h_offset = -off

	# a wood behind the dais, rocks and bushes at its rim, two braziers (world models, fixed layout)
	func _scenery() -> void:
		var trees := ["tree_pine1", "tree_oak1", "tree_pine2", "tree_oak_autumn", "tree_pine3", "tree_maple", "tree_pine_dark", "tree_oak2", "tree_birch", "tree_pine4"]
		var rng := RandomNumberGenerator.new()
