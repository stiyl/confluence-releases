# A tip for this match / screen: ctx {"mode", "map", "hero", "twist"} (any may be missing). A tip tagged for the
# context weighs 8, an untagged tip 1, a tip tagged for something else 0.25; the last few shown are skipped.
static var _recent: Array = []


static func loading_tip(ctx: Dictionary, rng: RandomNumberGenerator = null) -> String:
	var want := {}
	for k in ["mode", "map", "hero", "twist"]:
		if String(ctx.get(k, "")) != "":
			want["%s:%s" % [k, ctx[k]]] = true
	var w: Array = []
	var total := 0.0
	for i in LOADING.size():
		var tags: Array = LOADING[i][1]
		var wt := 1.0
		if not tags.is_empty():
			wt = 0.25
			for t in tags:
				if want.has(t):
					wt = 8.0
					break
		if _recent.has(i):
			wt *= 0.05
		w.append(wt)
		total += wt
	var r := (rng.randf() if rng != null else randf()) * total
	var pick := 0
	for i in w.size():
		r -= float(w[i])
		if r <= 0.0:
			pick = i
			break
	_recent.append(pick)
	if _recent.size() > 6:
		_recent.pop_front()
	return String(LOADING[pick][0])


static func tip_matches(text: String, ctx: Dictionary) -> bool:
	for row in LOADING:
		if String(row[0]) == text:
			for t in row[1]:
				var p := String(t).split(":")
				if String(ctx.get(p[0], "")) == p[1]:
					return true
	return false
