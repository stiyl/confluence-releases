# campaign monsters, the neutral camps): "mon_spd:<kind>", "mon_hp:<kind>", "mon_dmg:<kind>". A knob is only made
# for a stat the monster has (no speed knob for a stationary camp golem or totem, no damage knob for a totem).
# MON_KINDS keeps them in panel order: [kind, section] with section "wave" / "boss" / "late" / "campaign" / "camp".
const WAVE_BOSSES := ["boss_brood", "boss_warden", "boss_magmaw", "boss_wyrm", "boss_lich"]   # = Sim.BOSSES (tune_test checks)
const MON_SECTIONS := {"wave": "Wave monsters", "boss": "Bosses", "late": "Campaign / Survival bosses", "campaign": "Campaign monsters", "camp": "Camps"}
static var MON_KINDS: Array = []


static func mon_section(kind: String) -> String:
	var d: Dictionary = GameData.MON[kind]
	if d.get("camp", false):
		return "camp"
	if d.get("boss", false):
		return "boss" if WAVE_BOSSES.has(kind) else "late"
	return "campaign" if d.has("sheet") else "wave"   # the campaign's kinds borrow another monster's sheet


static func mon_has_dmg(d: Dictionary) -> bool:
	return float(d.get("dps", 0)) > 0.0 or d.has("ranged") or d.has("explode") or d.has("dive")


static func _make_mon_knobs() -> void:
	var sent := {}
	for sd in GameData.SENDS:
		sent[String(sd["k"])] = true
	MON_KINDS = []
	for sec in MON_SECTIONS:
		for kind in GameData.MON:
			if sent.has(kind) or mon_section(kind) != sec:
				continue
			MON_KINDS.append([kind, sec])
			var d: Dictionary = GameData.MON[kind]
			var nm := String(d["name"])
			var base := {"def": 1.0, "min": 0.0, "max": 5.0, "step": 0.05, "group": "Waves", "fmt": "x", "kind": kind, "sec": sec}
			if float(d.get("spd", 0)) > 0.0:
				var k1 := base.duplicate()
				k1.merge({"label": nm + " speed Ã—", "what": "spd", "help": "Multiplies the %s's move speed (%d base). Applies to the next ones that spawn." % [nm, int(d["spd"])]})
				DEFS["mon_spd:" + kind] = k1
			var k2 := base.duplicate()
			k2.merge({"label": nm + " HP Ã—", "what": "hp", "help": "Multiplies the %s's health (%d base, before the round's growth). Applies to the next ones that spawn." % [nm, int(d["hp"])]})
			DEFS["mon_hp:" + kind] = k2
			if mon_has_dmg(d):
				var k3 := base.duplicate()
				k3.merge({"label": nm + " damage Ã—", "what": "dmg", "help": "Multiplies all the damage the %s deals: melee, ranged shots, explosions, dives and crystal battering. Applies to the next ones that spawn." % nm})
				DEFS["mon_dmg:" + kind] = k3


# A Waves-tab multiplier under a set; 1.0 for a stat the monster has no knob for.
static func mon_k(vals: Dictionary, what: String, kind: String) -> float:
	var n := "mon_" + what + ":" + kind
	return value_in(vals, n) if DEFS.has(n) else 1.0


