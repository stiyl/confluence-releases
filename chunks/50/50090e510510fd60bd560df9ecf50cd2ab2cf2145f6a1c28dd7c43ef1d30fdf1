# ---------------------------------------------------------------- the narrator's crest (the speaker portrait)
class TutCrest extends Control:
	var talk := 0.0               # 1 when a new line starts; the crystal glows while it fades

	func _init() -> void:
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		custom_minimum_size = Vector2(52, 60)

	func _process(delta: float) -> void:
		if talk > 0.0:
			talk = maxf(0.0, talk - delta * 0.8)
			queue_redraw()

	func _draw() -> void:
		var w := size.x
		var h := minf(size.y, 62.0)
		var pts := PackedVector2Array([Vector2(3, 3), Vector2(w - 3, 3), Vector2(w - 3, h * 0.52), Vector2(w * 0.5, h - 2), Vector2(3, h * 0.52)])
		draw_colored_polygon(pts, Color("#3a3834"))
		var inner := PackedVector2Array([Vector2(8, 8), Vector2(w - 8, 8), Vector2(w - 8, h * 0.5), Vector2(w * 0.5, h - 9), Vector2(8, h * 0.5)])
		draw_colored_polygon(inner, Color("#2a2826"))
		var ring := pts.duplicate()
		ring.append(pts[0])
		draw_polyline(ring, Color(0.02, 0.015, 0.01, 0.9), 4.0)
		draw_polyline(ring, UIParts.GOLD, 2.0)
		# the crystal: a faceted diamond that glows while the narrator speaks
		var c := Vector2(w * 0.5, h * 0.42)
		var g := 0.55 + 0.45 * talk
		var gem := PackedVector2Array([c + Vector2(0, -16), c + Vector2(10, -2), c + Vector2(0, 16), c + Vector2(-10, -2)])
		if talk > 0.0:
			draw_circle(c, 15.0 + 5.0 * talk, Color(0.75, 0.9, 0.95, 0.18 * talk))
		draw_colored_polygon(gem, Color(0.62 * g + 0.2, 0.78 * g + 0.15, 0.82 * g + 0.15))
		draw_colored_polygon(PackedVector2Array([c + Vector2(0, -16), c + Vector2(10, -2), c + Vector2(0, -2)]), Color(1, 1, 1, 0.35 + 0.3 * talk))
