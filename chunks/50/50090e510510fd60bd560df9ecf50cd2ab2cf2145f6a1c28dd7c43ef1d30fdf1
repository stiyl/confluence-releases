static func _hero_def(id: String) -> Dictionary:
	for d in GameData.CHAMPS:
		if String(d["id"]) == id:
			return d
	return {}


# A hero's level-1 numbers (a human's: no AI difficulty), the way Sim.make_champ builds them.
static func _hero_base(id: String) -> Dictionary:
	var d := _hero_def(id)
	var base: Dictionary = GameData.ROLE[d["role"]].duplicate()
	if d.has("over"):
		base.merge(d["over"], true)
	base["hp"] = float(base["hp"]) * float(d["passive"].get("hpMult", 1.0))
	return base


# Max health at level 30 with no items: the per-level growth (Sim.gain_xp) plus Might from levels.
static func _hero_hp30(id: String, hp1: float) -> float:
	var d := _hero_def(id)
	var hp := hp1
	for l in range(2, Sim.MAX_LVL + 1):
		hp *= 1.06 if l <= Sim.SKILL_LEVELS else 1.1
	var grow := GameData.ATTR_GROW_PRIMARY if GameData.primary_of(d) == "mig" else GameData.ATTR_GROW_OTHER
	return hp + GameData.ATTR_HP * grow * float(Sim.MAX_LVL - 1)


static func _kshort(x: float) -> String:
	if absf(x) >= 10000.0:
		return "%dk" % roundi(x / 1000.0)
	if absf(x) >= 1000.0:
		return ("%.1fk" % (x / 1000.0)).replace(".0k", "k")
	return str(int(roundf(x)))


# The "â†’" preview of one Heroes-tab stat at multiplier v, and its tooltip.
func _hero_res(id: String, what: String, v: float) -> Array:
	var b := _hero_base(id)
	var d := _hero_def(id)
	match what:
		"hp":
			var k := maxf(0.05, v)
			var h1 := float(b["hp"])
			var h30 := _hero_hp30(id, h1)
			return ["â†’ %s/%s" % [_kshort(h1 * k), _kshort(h30 * k)], "Max health at level 1 / level 30 (no items): %d / %d â†’ %d / %d" % [int(h1), int(h30), int(h1 * k), int(h30 * k)]]
		"dmg":
			return ["â†’ %d" % roundi(float(b["dmg"]) * v), "Attack Power at level 1: %d â†’ %d (items and the primary attribute add on top; all of it is multiplied)" % [int(b["dmg"]), roundi(float(b["dmg"]) * v)]]
		"as":
			return ["â†’ %.2f/s" % (float(b["as"]) * v), "Attacks a second at level 1: %.2f â†’ %.2f (the 4.0 cap still holds; past it half the excess becomes damage)" % [float(b["as"]), float(b["as"]) * v]]
		"ms":
			return ["â†’ %d" % roundi(float(b["ms"]) * v), "Move speed: %d â†’ %d" % [int(b["ms"]), roundi(float(b["ms"]) * v)]]
		"ab":
			return ["â†’ Ã—%s" % _num("hero_ab:" + id, v), "Every ability's damage, shields and heals Ã—%s (on top of ranks, Ability Power and talents)" % _num("hero_ab:" + id, v)]
	var ult: Dictionary = d["skills"][3]
	var cd := float(ult.get("cd", 0)) * v
	return ["â†’ R %s" % _cd_s(cd), "Cooldowns Ã—%s; %s (R) at rank 1: %s â†’ %s (ranks and cooldown reduction shorten it further)" % [_num("hero_cd:" + id, v), String(ult["name"]), _cd_s(float(ult.get("cd", 0))), _cd_s(cd)]]


static func _cd_s(x: float) -> String:
	return (("%.1f" % x).rstrip("0").rstrip(".") if x < 10.0 else str(roundi(x))) + "s"


func _hero_tip(id: String) -> String:
	var d := _hero_def(id)
	var b := _hero_base(id)
	var lines: Array = ["%s â€” %s, %s" % [String(d["name"]), String(d.get("title", "")), String(d["role"])]]
	lines.append("Base (level 1): %d HP Â· %d damage Â· %.2f attacks/s Â· speed %d Â· range %d" % [int(b["hp"]), int(b["dmg"]), float(b["as"]), int(b["ms"]), int(b["range"])])
	var cds: Array = []
	for i in 4:
		var sk: Dictionary = d["skills"][i]
		cds.append("%s %s %s" % [Sim.SLOT_KEYS[i], String(sk["name"]), _cd_s(float(sk.get("cd", 0)))])
	lines.append("Cooldowns: " + " Â· ".join(cds))
	lines.append("Passive: " + String(d["passive"].get("name", "")))
	return _wrap("\n".join(lines), 78)


