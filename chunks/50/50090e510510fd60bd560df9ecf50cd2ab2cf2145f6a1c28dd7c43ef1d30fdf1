# ISO week id: yyyyww (2026-W45 -> 202645), from a date dictionary (year, month, day).
static func week_of(d: Dictionary) -> int:
	var unix := Time.get_unix_time_from_datetime_dict({"year": int(d["year"]), "month": int(d["month"]), "day": int(d["day"]), "hour": 12, "minute": 0, "second": 0})
	var wd := int(Time.get_datetime_dict_from_unix_time(unix)["weekday"])   # 0 Sunday .. 6 Saturday
	var iso_wd := 7 if wd == 0 else wd                                     # 1 Monday .. 7 Sunday
	# the Thursday of this week decides the ISO year
	var thu := Time.get_datetime_dict_from_unix_time(unix + (4 - iso_wd) * 86400)
	var y := int(thu["year"])
	var jan1 := Time.get_unix_time_from_datetime_dict({"year": y, "month": 1, "day": 1, "hour": 12, "minute": 0, "second": 0})
	var thu_unix := unix + (4 - iso_wd) * 86400
	var week := int((thu_unix - jan1) / 86400) / 7 + 1
	return y * 100 + week


static func this_week() -> int:
	return week_of(Time.get_date_dict_from_system())


# Seconds until the next ISO week begins (local Monday 00:00).
static func seconds_left() -> int:
	var now := Time.get_datetime_dict_from_system()
	var unix := int(Time.get_unix_time_from_datetime_dict(now))
	var wd := int(now["weekday"])
	var iso_wd := 7 if wd == 0 else wd
	var days_left := 8 - iso_wd   # Monday: 7 days, Sunday: 1
	var today_start := unix - (int(now["hour"]) * 3600 + int(now["minute"]) * 60 + int(now["second"]))
	return maxi(0, today_start + days_left * 86400 - unix)


static func left_label(secs: int) -> String:
	var d := secs / 86400
	var h := (secs % 86400) / 3600
	var m := (secs % 3600) / 60
	if d > 0:
		return "%d day%s %d h" % [d, "" if d == 1 else "s", h]
	if h > 0:
		return "%d h %d min" % [h, m]
	return "%d min" % maxi(1, m)


static func seed_of(week: int) -> int:
	var h := 2166136261
	for ch in "W" + str(week):
		h = ((h ^ ch.unicode_at(0)) * 16777619) & 0x7fffffff
	return h


static func twist_of(week: int) -> Dictionary:
	# the seed scatters the weeks so two neighbouring weeks rarely share a twist, and every twist comes round
	return TWISTS[(seed_of(week) / 13) % TWISTS.size()]


static func map_of(week: int, maps: int) -> int:
	return (seed_of(week) / 7) % maxi(1, maps)


static func week_label(week: int) -> String:
	return "%d-W%02d" % [week / 100, week % 100]


# The Daily's idea: the result first, then speed, kills and the crystal's health.
# 0.44.1 (bot batches: a player kills 600-1800 monsters a match, so at x2 the kills swamped everything and a loss
# scored like a win): win 1000 (+ up to 400 for a fast win: full at 15 min, nothing past 40 min), kills / 4 up
# to 300, crystal health % x2 (200 at full); a loss keeps the kills and the crystal and 5 a round survived.
# A decent win lands at ~1500-1800, a loss at a few hundred ("Challenger" wants 1500).
static func score(won: bool, secs: int, kills: int, core_frac: float, round_no: int) -> int:
	var s := 0
	if won:
		s += 1000
		s += roundi(400.0 * clampf(1.0 - (float(secs) - 900.0) / 1500.0, 0.0, 1.0))
	else:
		s += 5 * maxi(0, round_no)
	s += mini(300, maxi(0, kills) / 4)
	s += roundi(200.0 * clampf(core_frac, 0.0, 1.0))
	return s
␀␀␀␀␀# 0.30: the whisper window (one friend at a time: recent history, a line to type in) and the player context menu
# (right-click a player's name on the end screen, the in-match scoreboard or a lobby slot: Add friend, Whisper,
