		if offer != null:
			offer.visible = false
		return
	# 0.41: one thing at a time on a first launch: the profile name first, then this offer (main.gd calls back here
	# when the name is chosen); never under the patch notes
	if (main.account != null and not main.account.has_name()) or main.notes_ov != null:
