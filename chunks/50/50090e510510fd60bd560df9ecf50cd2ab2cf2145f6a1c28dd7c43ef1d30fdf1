# ---------------------------------------------------------------- highlights
# A world spot gets a pulsing ring and a bobbing arrow; a UI element gets a pulsing frame, an arrow and (when
# asked) the rest of the screen dimmed around it; a spot off screen gets an arrow at the edge pointing to it.
class TutLayer extends Control:
	var target := Rect2()         # global rect of the UI element pointed at (size 0: none)
	var spot := Vector2.INF       # global screen point of a world spot
	var edge := Vector2.INF       # an off-screen spot: the arrow's position on the edge...
	var edge_dir := Vector2.ZERO  # ...and its direction
	var dim := false
	var _t := 0.0

	func _init() -> void:
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		set_anchors_preset(Control.PRESET_FULL_RECT)
		z_index = 60

	func _process(delta: float) -> void:
		_t += delta
		queue_redraw()

	func _arrow(tip: Vector2, dir: Vector2, s := 1.0) -> void:
		var n := Vector2(-dir.y, dir.x)
		var back := tip - dir * 20.0 * s
		var sh := PackedVector2Array([tip + Vector2(1, 2), back + n * 13.0 * s + Vector2(1, 2), back - n * 13.0 * s + Vector2(1, 2)])
		draw_colored_polygon(sh, Color(0.02, 0.015, 0.01, 0.7))
		draw_colored_polygon(PackedVector2Array([tip, back + n * 12.0 * s, back - n * 12.0 * s]), UIParts.GOLD_TEXT)
		draw_polyline(PackedVector2Array([tip, back + n * 12.0 * s, back - n * 12.0 * s, tip]), Color(0.1, 0.09, 0.08, 0.9), 1.2)

	func _draw() -> void:
		var o := get_global_rect().position
		var vr := Rect2(Vector2.ZERO, size)
		if target.size != Vector2.ZERO:
			var r := Rect2(target.position - o, target.size)
			if dim:
				var hole := r.grow(7.0)
				var col := Color(0.035, 0.03, 0.025, 0.42)
				draw_rect(Rect2(0, 0, vr.size.x, maxf(0.0, hole.position.y)), col)
				draw_rect(Rect2(0, hole.end.y, vr.size.x, maxf(0.0, vr.size.y - hole.end.y)), col)
				draw_rect(Rect2(0, hole.position.y, maxf(0.0, hole.position.x), hole.size.y), col)
				draw_rect(Rect2(hole.end.x, hole.position.y, maxf(0.0, vr.size.x - hole.end.x), hole.size.y), col)
			var g := r.grow(4.0 + 3.0 * sin(_t * 6.0))
			draw_rect(g.grow(1), Color(0.02, 0.015, 0.01, 0.6), false, 5.0)
			draw_rect(g, Color(UIParts.GOLD_TEXT, 0.95), false, 3.0)
			draw_rect(g.grow(5), Color(UIParts.GOLD_TEXT, 0.3), false, 2.0)
			var bob := 8.0 + 6.0 * absf(sin(_t * 4.0))
			if g.position.y < 70.0:
				_arrow(Vector2(g.get_center().x, g.end.y + bob), Vector2.UP)
			else:
				_arrow(Vector2(g.get_center().x, g.position.y - bob), Vector2.DOWN)
		if spot.x != INF:
			var c := spot - o
			var rr := 28.0 + 5.0 * sin(_t * 6.0)
			for k in 2:
				var ph := fmod(_t * 0.9 + k * 0.5, 1.0)
				draw_arc(c, 18.0 + ph * 46.0, 0.0, TAU, 48, Color(UIParts.GOLD_TEXT, 0.4 * (1.0 - ph)), 2.0)
			draw_arc(c, rr, 0.0, TAU, 48, Color(0.02, 0.015, 0.01, 0.6), 6.0)
			draw_arc(c, rr, 0.0, TAU, 48, Color(UIParts.GOLD_TEXT, 0.95), 3.0)
			_arrow(Vector2(c.x, c.y - rr - 8.0 - 6.0 * absf(sin(_t * 4.0))), Vector2.DOWN)
		if edge.x != INF:
			var e := edge - o
			var pulse := 1.0 + 0.12 * sin(_t * 6.0)
			draw_circle(e - edge_dir * 10.0, 20.0 * pulse, Color(0.02, 0.015, 0.01, 0.35))
			_arrow(e + edge_dir * 8.0 * pulse, edge_dir, 1.15)


