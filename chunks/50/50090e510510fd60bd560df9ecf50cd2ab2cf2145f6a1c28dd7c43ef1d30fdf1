# Main-menu entry: a stone strip whose hover slides a bronze accent bar in from the left
# and brightens the title. Child 0 is the text column (title, optional subtitle).
class MenuEntry extends Button:
	var title_lbl: Label
	var text_box: Control
	var _h := 0.0

	func _init() -> void:
		focus_mode = Control.FOCUS_NONE
		flat = true
		for st in ["normal", "hover", "pressed", "disabled", "focus", "hover_pressed"]:
			add_theme_stylebox_override(st, StyleBoxEmpty.new())

	func _process(delta: float) -> void:
		var tgt := 1.0 if is_hovered() and not disabled else 0.0
		if absf(_h - tgt) > 0.001:
			_h = move_toward(_h, tgt, delta * 7.0)
			queue_redraw()
			var e := 1.0 - pow(1.0 - _h, 3.0)
			if title_lbl != null:
				title_lbl.add_theme_color_override("font_color", UIParts.GOLD.lerp(Color("#ffffff"), e))
			if text_box != null:
				text_box.position.x = 22.0 + 8.0 * e

	func _draw() -> void:
		var r := Rect2(Vector2.ZERO, size)
		var e := 1.0 - pow(1.0 - _h, 3.0)
		var a0 := Color(UIParts.STONE_1, 0.92)
		var a1 := Color(UIParts.STONE_1, 0.55)
		var hl := Color(0.35, 0.24, 0.08, 0.55 * e)
		draw_polygon(PackedVector2Array([r.position, Vector2(r.end.x, 0), r.end, Vector2(0, r.end.y)]),
			PackedColorArray([a0.blend(hl), a1, a1, a0.blend(hl)]))
		draw_rect(Rect2(0, 0, size.x, 1), Color(UIParts.BRONZE, 0.35 + 0.4 * e))
		draw_rect(Rect2(0, size.y - 1, size.x, 1), Color(0, 0, 0, 0.6))
		draw_rect(Rect2(0, 0, 2, size.y), Color(UIParts.BRONZE_DARK, 0.9))
		if e > 0.01:
			var bw := 4.0
			var x := -bw + (bw + 2.0) * e
			draw_rect(Rect2(x, 6, bw, size.y - 12), Color(UIParts.BRONZE_LITE, e))
			var tip := Vector2(x + bw + 3.0, size.y / 2.0)
			draw_colored_polygon(PackedVector2Array([tip + Vector2(-3, -5), tip + Vector2(3, 0), tip + Vector2(-3, 5)]), Color(UIParts.BRONZE_LITE, e))


