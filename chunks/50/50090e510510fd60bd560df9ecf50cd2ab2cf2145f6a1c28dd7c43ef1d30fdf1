		ci.draw_polygon(PackedVector2Array([from + Vector2(-0.5, 0), c + Vector2(-0.5, -8), c + Vector2(0.5, -8), from + Vector2(0.5, 0)]), PackedColorArray([Color(col, 0.0), col, col, Color(col, 0.0)]))
