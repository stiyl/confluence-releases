	leave_btn = _small_btn("Leave tutorial", func(): pass)
	leave_btn.tooltip_text = "Back to the menu. Your place is saved: the tutorial picks up at this chapter."
	main.confirm_button(leave_btn, func(): leave(), "Leave? Click again")
	br.add_child(leave_btn)
	v.add_child(br)


# ---------------------------------------------------------------- the match
# Starts the tutorial's own practice match (the menu entry, the first-launch offer, hero select's lock-in).
func launch() -> void:
	if not main._solo_ok():
		return
	main.game_mode = "tutorial"
	main.game_map = TutorialData.MAP
	var opts := {"mode": "tutorial", "map": TutorialData.MAP, "team_size": 4, "ai_tiers": false, "seed": TutorialData.SEED,
		"tune": {"apply_surv": 1.0}}   # the Classic economy as it ships (+income per round, interest cap 400 + 80 a round)
	var s := Sim.new(TutorialData.HERO, false, 0, [], opts)
	s.players[0].champ.skin = Profile.skin_of(TutorialData.HERO)
	Replay.cancel()
	main.locking = false
	main.start_game(s)


func is_on() -> bool:
	return running


# Hides everything (a new match, the end screen, leaving).
func reset() -> void:
	running = false
	id = ""
	tour = []
	ally_yes = {}
	_placed = false
	if plaque != null:
		plaque.visible = false
	if layer != null:
		layer.visible = false
	if done_ov != null:
		done_ov.visible = false


func start() -> void:
	reset()
	flags = {}
	base = {}
	learned = []
	skipped = []
	running = true
	plaque.visible = true
	layer.visible = true
	var sim = main.sim
	if sim != null:
		sim.waves_on = false
		sim.enemy_sends = false
		sim.duels_on = false
	var rc := int(Profile.tutorial_ch)
	if rc > 0 and rc < TutorialData.count():
		_show_resume(rc)
		return
	main.announce("Tutorial", "%d short chapters  Â·  about ten minutes" % TutorialData.count(), 1, 2.5)
	go(0, 0)


func _show_resume(rc: int) -> void:
	id = "resume"
	ch = rc
	si = 0
	title_lbl.text = "Welcome back"
	count_lbl.text = ""
	pips.cur = rc
	pips.done = range(rc)
	pips.queue_redraw()
	_set_say("Good to see you again. Shall we pick up where we left off?")
	do_lbl.text = "Chapter %d: %s" % [rc + 1, TutorialData.CHAPTERS[rc]["name"]]
	next_btn.text = "Resume"
	next_btn.visible = true
	skip_btn.text = "Start over"
	skip_btn.visible = true
	_layout()


func _on_next() -> void:
	if not running:
		return
	if id == "resume":
		learned = range(ch)
		go(ch, 0)
		return
	advance()


func _on_skip() -> void:
	if not running:
		return
	if id == "resume":
		Profile.tutorial_ch = 0
		Profile.save()
		go(0, 0)
		return
	skip_chapter()


func advance() -> void:
	if running and id != "":
		go(ch, si + 1)


func skip_chapter() -> void:
	if running and id != "":
		if not skipped.has(ch):
			skipped.append(ch)
		go(ch, TutorialData.steps_of(ch).size())


func go(nch: int, nsi: int) -> void:
	if id != "" and id != "resume":
		_exit(id)
	if nsi >= TutorialData.steps_of(mini(nch, TutorialData.count() - 1)).size() and nch < TutorialData.count():
		_exit_chapter(nch)
		if not learned.has(nch) and not skipped.has(nch):
			learned.append(nch)
		nch += 1
		nsi = 0
	if nch >= TutorialData.count():
		_complete()
		return
	var new_ch := nch != ch or id == "" or id == "resume"
	ch = nch
	si = nsi
	var st := TutorialData.step(ch, si)
	id = String(st["id"])
	step_t = 0.0
	flags = {}
	if si == 0:
		Profile.tutorial_ch = ch
		Profile.save()
	_enter(id)
	title_lbl.text = "Chapter %d  Â·  %s" % [ch + 1, TutorialData.CHAPTERS[ch]["name"]]
	count_lbl.text = "%d/%d" % [si + 1, TutorialData.steps_of(ch).size()]
	pips.cur = ch
	pips.done = learned + skipped
	pips.queue_redraw()
	next_btn.text = "Continue"
	next_btn.visible = bool(st.get("info", false))
	skip_btn.text = "Skip chapter"
	skip_btn.visible = true
	_say_full = ""
	text_t = 0.0
	_placed = false          # a new step may take the preferred place again
	refresh()
	if main.audio != null and (ch > 0 or si > 0):
		main.audio.play("learn", -6.0 if not new_ch else -3.0)


# ---------------------------------------------------------------- helpers
func me():
	return main.sim.players[main.sim.local]


func hero():
	return main.sim.players[main.sim.local].champ


func my_ar():
	return main.sim.arenas[main.myt()]


# Tops gold up to n for a step that needs it (never stacks).
func gold(n: float) -> void:
	var p = me()
	p.gold = maxf(p.gold, n)


func skill() -> int:
	var c = hero()
	for i in 4:
		if c.ranks[i] > 0:
			return i
	return 0


func owns_tier(t: int) -> bool:
	for it in hero().items:
		if int(GameData.item(it)["tier"]) >= t:
			return true
	return false


func basic_with_recipe() -> String:
	for it in hero().items:
		if int(GameData.item(it)["tier"]) == 1:
			for x in GameData.ITEMS:
				if (x.get("from", []) as Array).has(it):
					return it
	return ""


func item_slot(item_id: String) -> int:
	return (hero().items as Array).find(item_id)


# The key (or controller button) that uses the item in this slot.
func item_key(slot: int) -> String:
	if slot < 0:
		return Settings.key_name("item1")
	if Settings.pad_on and main.pad != null:
		var an: int = main.pad.active_slots().find(slot)
		return Settings.pad_name("item%d" % (an + 1)) if an >= 0 and an < 2 else "â€”"
	return Settings.kb_name("item%d" % (slot + 1))


# A few monsters placed on the road `dist` west of the hero (lane 0 of the hero's arena); remembered under key.
func spawn_pack(kinds: Array, dist: float, key: String, hpm := 1.0) -> Array:
	var sim = main.sim
	var c = hero()
	var pts := Sim.lane_points(0)
	var cum := [0.0]
	for i in range(1, pts.size()):
		cum.append(float(cum[i - 1]) + pts[i - 1].distance_to(pts[i]))
	var want: Vector2 = c.p + Vector2(-dist, 0)
	var bi := 0
	for i in pts.size():
		if pts[i].distance_to(want) < pts[bi].distance_to(want):
			bi = i
	var frac: float = float(cum[bi]) / maxf(1.0, float(cum[cum.size() - 1]))
	var out: Array = []
	for i in kinds.size():
		out.append(sim.place_mon(my_ar(), String(kinds[i]), 0, frac - 0.004 * i, hpm))
	base[key] = out
	return out


func alive(key: String) -> Array:
	var out: Array = []
	for m in base.get(key, []):
		if m != null and not m.dead and my_ar().mons.has(m):
			out.append(m)
	return out


func _spirit() -> int:
	return maxi(0, main.sim.camp_index("spirit"))


func _camp_mons(ci: int) -> Array:
	var out: Array = []
	for m in my_ar().mons:
		if not m.dead and m.camp_i == ci:
			out.append(m)
	return out


# ---------------------------------------------------------------- staging
func _enter(sid: String) -> void:
	var sim = main.sim
	var p = me()
	var c = hero()
	var av = main.arena_view
	if c.dead:
		c.respawn = 0.0
	match sid:
		"move":
			base["p"] = c.p
		"camera":
			av.look_at_world(c.p + Vector2(-900, 380))
		"amove":
			if alive("pack").is_empty():
				spawn_pack(["kobold", "kobold", "kobold", "kobold"], 480.0, "pack", 0.8)
			flags.erase("amove")
		"finish":
			if alive("pack").is_empty():
				spawn_pack(["kobold", "kobold", "kobold"], 380.0, "pack", 0.8)
		"learn":
			if c.points <= 0 and c.ranks[0] + c.ranks[1] + c.ranks[2] + c.ranks[3] == 0:
				c.points = 1
		"cast":
			c.cds[skill()] = 0.0
			if alive("dummies").is_empty():
				spawn_pack(["kobold", "kobold", "kobold"], 320.0, "dummies", 0.8)
		"income":
			sim.waves_on = true
			sim.round_t = maxf(sim.round_t, sim.round_len - 6.0)
			base["r0"] = sim.round_no
		"interest":
			gold(sim.interest_cap_for(p))
			sim.waves_on = true
			sim.round_t = maxf(sim.round_t, sim.round_len - 8.0)
			base["i0"] = p.interest
		"build":
			gold(Sim.building_cost(0) + 40.0)
		"send":
			gold(Sim.building_cost(0) + 160.0 if p.tech < 1 else 160.0)
		"rift":
			base["lane"] = main.lane_mode
		"walk_shop":
			gold(700.0)
		"buy":
			gold(600.0)
			if main.shop_panel.visible:
				main.select_shop_item("sword")
		"recipe":
			gold(600.0)
			var b := basic_with_recipe()
			if b != "" and main.shop_panel.visible:
				main.select_shop_item(b)
		"potion":
			gold(float(Sim.POTION_COST) + 10.0)
			if main.shop_panel.visible:
				main.select_shop_item("potion")
		"active_buy":
			gold(float(sim.item_price(c, ACT_ITEM)) + 10.0)
			if main.shop_panel.visible:
				main.select_shop_item(ACT_ITEM)
		"active_use":
			c.act_cd[ACT_ITEM] = 0.0
		"crystal":
			main.set_view_arena(main.myt())
			av.look_at_world(Sim.CORE + Vector2(-260, 60))
		"crystal_up":
			gold(float(sim.core_cost(my_ar(), 0)) + 20.0)
		"wave":
			main.center_on_hero()
			main.announce("Round %d" % (sim.round_no + 1), "A wave marches on your crystal", 0, 2.5)
			spawn_pack(WAVE_KINDS, 760.0, "wave")
		"boss":
			main.center_on_hero()
			var bd: Dictionary = GameData.MON["boss_warden"]
			spawn_pack(["boss_warden"], 720.0, "boss", BOSS_HP / float(bd["hp"]))
			main.announce("Boss", "%s marches on your crystal" % bd["name"], 2, 3.0)
		"camps":
			var ar = my_ar()
			for ci in Sim.CAMPS.size():
				sim._camp_arrays(ar)
				if not ar.camps_up[ci]:
					sim.spawn_camp(ar, ci)
			for m in _camp_mons(_spirit()):
				m.max_hp *= 0.35
				m.hp = m.max_hp
			tour = []
			for ci in [0, maxi(0, sim.camp_index("beast")), _spirit()]:
				tour.append([Sim.CAMPS[ci]["pos"], 2.4])
			tour_t = 0.0
			av.look_at_world(tour[0][0])
		"camp_clear":
			var ar = my_ar()
			sim._camp_arrays(ar)
			if not ar.camps_up[_spirit()] and _camp_mons(_spirit()).is_empty():
				sim.spawn_camp(ar, _spirit())
				for m in _camp_mons(_spirit()):
					m.max_hp *= 0.35
					m.hp = m.max_hp
		"duel":
			flags.erase("duel_seen")
			flags.erase("duel_try")
		"ping":
			base["pings"] = main.pings_sent
		"command":
			base["orders"] = main.orders_given
		"vote":
			sim.waves_on = true
			if sim.vote_refusal(main.myt()) != "" and not sim.vote_on[main.myt()] and not sim.team_ready[main.myt()]:
				sim.round_t = clampf(sim.round_t, Sim.VOTE_GRACE + 1.0, sim.round_len - sim.vote_len() - 2.0)
		"board":
			if main.board_open:
				main.toggle_board()


func _exit(sid: String) -> void:
	var sim = main.sim
	if sim == null:
		return
	match sid:
		"income", "interest", "vote":
			sim.waves_on = false   # the round clock waits again while the next lessons teach
		"camera", "crystal", "camps":
			tour = []
			main.center_on_hero()


func _exit_chapter(c: int) -> void:
	var sim = main.sim
	if sim == null or c >= TutorialData.count():
		return
	match String(TutorialData.CHAPTERS[c]["name"]):
		"The Armory":
			if main.shop_panel.visible:
				main.toggle_shop()
		"The crystal":
			if main.core_panel.visible:
				main.toggle_core(main.core_view_team)
		"Teamwork":
			if main.board_open:
				main.toggle_board()
	sim.waves_on = false
	if not main.my_view():
		main.center_on_hero()


# Puts the player in a duel with the first standing enemy hero (start_duel takes the pair named in advance).
func _try_duel() -> void:
	var sim = main.sim
	var c = hero()
	if c.dead or sim.duel_on:
		return
	flags["duel_try"] = true
	var foe = null
	for i in range(4, 8):
		var o = sim.players[i]
		if not o.absent and not o.champ.dead and o.champ.ar == sim.arenas[1]:
			foe = o.champ
			break
	if foe == null or c.ar != sim.arenas[0]:
		return
	sim.duel_next = [c, foe]
	sim.duel_next_round = sim.round_no
	sim.start_duel()
	if sim.duel_on and sim.duel_pair.has(c):
		foe.hp *= DUEL_FOE_HP
		flags["duel_seen"] = true
		base["foe"] = foe


func _done(sid: String) -> bool:
	var sim = main.sim
	var p = me()
	var c = hero()
	match sid:
		"move":
			return c.p.distance_to(base.get("p", c.p)) > 150.0
		"camera":
			return main.arena_view.follow and main.my_view()
		"amove":
			if c.order == "amove" or c.order == "attack":
				flags["amove"] = true
			return flags.has("amove") or alive("pack").is_empty()
		"finish":
			return alive("pack").is_empty()
		"learn":
			return c.ranks[0] + c.ranks[1] + c.ranks[2] + c.ranks[3] >= 1
		"cast":
			for i in 4:
				if c.cds[i] > 0.0:
					return true
			return false
		"income":
			return sim.round_no > int(base.get("r0", 0))
		"interest":
			return p.interest > int(base.get("i0", 0))
		"build":
			return p.tech >= 1
		"send":
			return p.sent > 0.0
		"rift":
			return main.lane_mode != int(base.get("lane", main.lane_mode))
		"walk_shop":
			return c.p.distance_to(Sim.SHOP) < Sim.SHOP_R - 20.0 or main.shop_panel.visible
		"open_shop":
			return main.shop_panel.visible
		"buy":
			return c.items.size() > 0
		"recipe":
			return owns_tier(2) or basic_with_recipe() == ""
		"potion":
			return c.potions > 0 or c.pot_t > 0
		"active_buy":
			return c.items.has(ACT_ITEM)
		"active_use":
			return not c.items.has(ACT_ITEM) or float(c.act_cd.get(ACT_ITEM, 0.0)) > 0.0
		"crystal":
			return main.core_panel.visible
		"crystal_up":
			return my_ar().core_lv.reduce(func(x, y): return x + y, 0) > 0
		"wave":
			return alive("wave").is_empty()
		"boss":
			return alive("boss").is_empty()
		"camps":
			return tour.is_empty() and (c.p.distance_to(Sim.CAMPS[_spirit()]["pos"]) < 430.0 or _camp_mons(_spirit()).is_empty())
		"camp_clear":
			return _camp_mons(_spirit()).is_empty()
		"duel":
			if not flags.has("duel_try"):
				if step_t > 2.5:
					_try_duel()
				return false
			if sim.duel_on:
				return false
			return step_t > 0.5
		"ping":
			return main.pings_sent > int(base.get("pings", 0))
		"command":
			return main.orders_given > int(base.get("orders", 0))
		"vote":
			var tm: int = main.myt()
			return sim.vote_on[tm] or sim.team_ready[tm] or sim.vote_round[tm] == sim.round_no
		"board":
			return main.board_open
		"board_close":
			return not main.board_open
	return false


# ---------------------------------------------------------------- words
func _vars() -> Dictionary:
	var sim = main.sim
	var p = me()
	var c = hero()
	var v := {}
	v["skill_name"] = String(c.def["skills"][0]["name"])
	v["income"] = p.income
	v["rate"] = roundi(sim.interest_rate() * 100.0)
	v["cap"] = int(sim.interest_cap_for(p))
	v["cap_round"] = int(Tune.v("interest_cap_round")) if sim.tune_applies() else 80
	match id:
		"income", "interest":
			v["secs"] = maxi(0, ceili(sim.round_len - sim.round_t))
	var it := GameData.item(ACT_ITEM)
	v["item_name"] = String(it.get("name", ACT_ITEM))
	v["item_act"] = String(it.get("act", {}).get("name", ""))
	v["item"] = "[b]" + item_key(item_slot(ACT_ITEM)) + "[/b]"
	var foe = base.get("foe", null)
	v["foe"] = String(foe.def["name"]).split(" ")[0] if foe != null else "the enemy hero"
	v["count"] = maxi(1, ceili(sim.duel_count))
	return v


# Fills {placeholders}: Settings actions become their key / button (in bold), the rest come from _vars.
func fill(s: String, v: Dictionary) -> String:
	var out := ""
	var i := 0
	while i < s.length():
		var a := s.find("{", i)
		if a < 0:
			out += s.substr(i)
			break
		var b := s.find("}", a)
		if b < 0:
			out += s.substr(i)
			break
		out += s.substr(i, a - i)
		var key := s.substr(a + 1, b - a - 1)
		if key.begins_with("learn:"):
			out += "[b]" + Settings.learn_name(key.substr(6)) + "[/b]"
		elif v.has(key):
			out += str(v[key])
		elif Settings.ACTIONS.any(func(x): return x[0] == key) or Settings.PAD_ACTIONS.any(func(x): return x[0] == key):
			out += "[b]" + Settings.key_name(key) + "[/b]"
		else:
			out += "{" + key + "}"
		i = b + 1
	return out


# [say, do] for the current step, worded for the controller while one is in use.
func lines() -> Array:
	if id == "" or id == "resume":
		return [_say_full, do_lbl.text]
	var st := TutorialData.step(ch, si)
	var pad: bool = Settings.pad_on
	var say := String(st.get("pad_say", st["say"]) if pad else st["say"])
	var dl := String(st.get("pad_do", st["do"]) if pad else st["do"])
	var sim = main.sim
	match id:
		"cast":
			if not Settings.quick_cast:
				dl = "Walk to the monsters, hold {skill_q} and let go to cast {skill_name}." if not pad else "Hold {skill_q} and let go to cast {skill_name}."
		"duel":
			if flags.has("duel_seen") and sim.duel_on:
				if sim.duel_count > 0.0:
					say = "The ring is yours. Everyone else waits and watches."
					dl = "The fight starts in {count}."
				else:
					say = "Duels come every few rounds. Press {duel} to watch the ones you're not in."
					dl = "Defeat {foe}: attack and use your abilities." if not pad else "Press {attack_move} to attack {foe}, and use your abilities."
			elif flags.has("duel_seen"):
				dl = "Well fought."
	var v := _vars()
	return [fill(say, v), fill(dl, v)]


func _set_say(s: String) -> void:
	if s == _say_full:
		return
	_say_full = s
	say_lbl.text = s
	say_lbl.visible_ratio = 0.0
	crest.talk = 1.0


# ---------------------------------------------------------------- every frame
func update(delta: float) -> void:
	if not running or main.sim == null or id == "":
		return
	if done_ov != null and done_ov.visible:
		return
	step_t += delta
	if say_lbl.visible_ratio < 1.0:
		say_lbl.visible_ratio = minf(1.0, say_lbl.visible_ratio + delta * 90.0 / maxf(20.0, float(say_lbl.get_total_character_count())))
	if id == "resume":
		_layout()
		return
	var sim = main.sim
	var c = hero()
	# nothing should be lost to a death while learning: the hero is back at once (a duel plays out first)
	if c.dead and not sim.duel_on:
		c.respawn = minf(c.respawn, 0.0)
	_ally_votes(delta)
	if not tour.is_empty():
		tour_t += delta
		if tour_t >= float(tour[0][1]):
			tour_t = 0.0
			tour.pop_front()
			if tour.is_empty():
				main.center_on_hero()
			else:
				main.arena_view.look_at_world(tour[0][0])
	var st := TutorialData.step(ch, si)
	if not bool(st.get("info", false)) and _done(id):
		advance()
		return
	text_t -= delta
	if text_t <= 0.0:
		text_t = 0.2
		refresh()
	else:
		_point()


# 0.41: the vote lesson must never end in "Vote failed": the allies answer the vote called in it with yes, a second
# or so apart the way bots answer in a real match. Staged here (the sim's own vote for them is held off while they
# wait); bot voting in real matches is unchanged.
func _ally_votes(delta: float) -> void:
	var sim = main.sim
	var tm: int = main.myt()
	if id == "vote" and sim.vote_on[tm] and ally_yes.is_empty() and not flags.has("ally_yes"):
		flags["ally_yes"] = true
		var k := 0
		for pl in sim.players:
			if pl.team == tm and not pl.human and not pl.absent and not sim.votes[tm].has(pl.id):
				ally_yes[pl.id] = 1.0 + 0.8 * k
				k += 1
	if ally_yes.is_empty():
		return
	if not sim.vote_on[tm]:
		ally_yes = {}
		return
	for pid in ally_yes.keys():
		sim.vote_ai_t[pid] = 99.0
		ally_yes[pid] = float(ally_yes[pid]) - delta
		if float(ally_yes[pid]) <= 0.0:
			ally_yes.erase(pid)
			sim.vote_cmd(sim.players[pid], true)
			if not sim.vote_on[tm]:
				ally_yes = {}
				return


