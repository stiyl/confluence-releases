# A short slider for one Waves-tab multiplier, with the default marker on its rail.
func _mini_slider(n: String) -> HSlider:
	var d: Dictionary = Tune.DEFS[n]
	var sl := HSlider.new()
	sl.min_value = float(d["min"])
	sl.max_value = float(d["max"])
	sl.step = float(d["step"])
	sl.focus_mode = FOCUS_NONE
	sl.custom_minimum_size = Vector2(66, 22)
	sl.size_flags_vertical = SIZE_SHRINK_CENTER
	sl.tooltip_text = _wrap(String(d["help"]))
	var track: StyleBoxFlat = main.sb(Color(UIParts.STONE_2, 1.0), Color(UIParts.BRONZE_DARK, 0.9), 2, 1, 0)
	track.content_margin_top = 2
	track.content_margin_bottom = 2
	sl.add_theme_stylebox_override("slider", track)
	var mark := DefaultMark.new()
	mark.frac = (Tune.def_of(n) - float(d["min"])) / maxf(0.0001, float(d["max"]) - float(d["min"]))
	mark.set_anchors_preset(PRESET_FULL_RECT)
	mark.mouse_filter = MOUSE_FILTER_IGNORE
	sl.add_child(mark)
	sl.value_changed.connect(func(v: float):
		if _busy:
			return
		_change(n, v))
	return sl


# The base number a Waves-tab stat multiplies: move speed, health, and the monster's main damage figure
# (melee damage per second, else a ranged shot, else its explosion, else its dive).
static func _mon_base(kind: String, what: String) -> float:
	var d: Dictionary = GameData.MON[kind]
	match what:
		"spd":
			return float(d.get("spd", 0))
		"hp":
			return float(d.get("hp", 0))
	if float(d.get("dps", 0)) > 0.0:
		return float(d["dps"])
	for k in ["ranged", "explode", "dive"]:
		if d.has(k):
			return float(d[k].get("dmg", 0))
	return 0.0


static func _short(x: float) -> String:
	if absf(x) >= 10000.0:
		return ("%.1fk" % (x / 1000.0)).replace(".0k", "k")
	return str(int(roundf(x)))


func _mon_tip(kind: String, sec: String) -> String:
	var d: Dictionary = GameData.MON[kind]
	var lines: Array = ["%s â€” %s" % [String(d["name"]), String(Tune.MON_SECTIONS[sec])]]
	lines.append("Base: %d HP Â· speed %d Â· %d lives" % [int(d["hp"]), int(d.get("spd", 0)), int(d.get("lives", 0))])
	var dm: Array = []
	if float(d.get("dps", 0)) > 0.0:
		dm.append("melee %d/s" % int(d["dps"]))
	if d.has("ranged"):
		dm.append("ranged %d every %.1f s" % [int(d["ranged"]["dmg"]), float(d["ranged"].get("cd", 1.5))])
	if d.has("explode"):
		dm.append("explodes for %d" % int(d["explode"]["dmg"]))
	if d.has("dive"):
		dm.append("dives for %d" % int(d["dive"]["dmg"]))
	lines.append("Damage: " + (", ".join(dm) if not dm.is_empty() else "none"))
	var where := ""
	match sec:
		"boss":
			var i := Tune.WAVE_BOSSES.find(kind)
			where = "Classic / Quick boss: rounds %d, %d, %dâ€¦ (one down each rift; every boss at once in the last wave)." % [10 * (i + 1), 10 * (i + 6), 10 * (i + 11)]
		"late":
			where = "A campaign boss, and in Survival's rotation past round 25. Outside Classic / Quick the knob needs \"Apply to Survival / campaign\" (Rounds tab)."
		"campaign":
			where = "Campaign only: the knob needs \"Apply to Survival / campaign\" (Rounds tab)."
		"camp":
			for ck in Sim.CAMP_KINDS:
				var c: Dictionary = Sim.CAMP_KINDS[ck]
				if c["leader"] == kind or c["guard"] == kind:
					where = "Neutral camp: %s (%s)." % [String(c["name"]), "leader" if c["leader"] == kind else "guard"]
	var from: Array = []
	for k in GameData.MON:
		var o: Dictionary = GameData.MON[k]
		for key in ["split", "spawner", "totems"]:
			if o.has(key) and String(o[key].get("kind", "")) == kind and not from.has(String(o["name"])):
				from.append(String(o["name"]))
	if not from.is_empty():
		where = ("Spawned by " + ", ".join(from) + ". " + where).strip_edges()
	if where != "":
		lines.append(where)
	if d.has("desc"):
		lines.append(String(d["desc"]))
	return _wrap("\n".join(lines), 72)


