␀␀␀# Small hand-drawn interface pieces: command-card buttons with ability glyphs,
# hero portraits, the minimap, resource icons and the stone console frame.
class_name UIParts
extends RefCounted

# 0.18: the interface accent is a neutral silver-gray (was bronze/gold). The BRONZE_* names stay so the
# frame code reads the same; only the values changed. Money keeps a muted brass (COIN) so it still reads as money.
const BRONZE := Color("#a2a29c")         # frames, rules, studs (was #a88038)
const BRONZE_LITE := Color("#e4e4de")    # highlights on frames (was #e9c46a)
const BRONZE_DARK := Color("#46463f")    # dark frame lines / inner borders (was #4c3614)
const COIN := Color("#b8a070")           # currency amounts and the coin icon only
const COIN_DARK := Color("#5c4e34")
const COIN_LITE := Color("#d8c89e")      # currency text
const STONE := Color("#13110e")
const STONE_1 := Color("#1c1915")
const STONE_2 := Color("#2a251e")
const GOLD_TEXT := Color("#f2f2ee")      # interactive highlight, hotkeys (was #ffd24a)
const GOLD := Color("#d8d8d2")           # headings (was #e8c060)
const INK := Color("#0d0b09")
const TEXT := Color("#ede3c9")
const MUTED := Color("#a99d83")
const DISABLED := Color("#6b6252")
const DANGER := Color("#e0523f")
const GOOD := Color("#7bd88a")
const RARITY := {"common": Color("#d9cfb8"), "rare": Color("#b98cff"), "legendary": Color("#ff9f3a"), "mythic": Color("#ff6a8a")}

# ---- the type system (ART_BIBLE section 4): Crimson Pro for display and story, Inter for UI.
const FONT_PATHS := {
	"display": "res://art/fonts/CrimsonPro-Bold.ttf",
	"story": "res://art/fonts/CrimsonPro-Regular.ttf",
	"story_italic": "res://art/fonts/CrimsonPro-Italic.ttf",
	"ui": "res://art/fonts/Inter-Medium.otf",
	"ui_regular": "res://art/fonts/Inter-Regular.otf",
	"ui_semi": "res://art/fonts/Inter-SemiBold.otf",
	"ui_bold": "res://art/fonts/Inter-Bold.otf",
}
static var _fonts := {}


static func font(role: String) -> Font:
	if _fonts.has(role):
		return _fonts[role]
	var f: Font = null
	match role:
		"num", "num_semi", "display_num":
			# tabular figures so gold, timers and counters do not jitter
			var fv := FontVariation.new()
			fv.base_font = font({"num": "ui", "num_semi": "ui_semi", "display_num": "display"}[role])
			fv.opentype_features = {TextServerManager.get_primary_interface().name_to_tag("tnum"): 1}
			f = fv
		"caps":
			# section heads: Inter SemiBold, letter-spaced
			var fv := FontVariation.new()
			fv.base_font = font("ui_semi")
			fv.spacing_glyph = 2
			f = fv
		"display_spaced":
			var fv := FontVariation.new()
			fv.base_font = font("display")
			fv.spacing_glyph = 1
			f = fv
		_:
			var path: String = FONT_PATHS.get(role, FONT_PATHS["ui"])
			f = load(path) if ResourceLoader.exists(path) else ThemeDB.fallback_font
	_fonts[role] = f
	return f


# A keycap badge (hotkeys as badges, not text): stone_2 fill, bronze stroke, Inter SemiBold 11.
# 0.29: while a controller is in use, a controller name ("A", "LB", "Y+RT", "D-Up") draws as its button glyph.
static func keycap(ci: CanvasItem, pos: Vector2, key: String, fs := 11, min_w := 15.0) -> Rect2:
	if Settings.pad_on and is_pad_label(key):
		return pad_glyph(ci, pos, key, fs + 5)
	var f := font("ui_semi")
	var w := maxf(min_w, f.get_string_size(key, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x + 7.0)
	var r := Rect2(pos, Vector2(w, fs + 5))
	ci.draw_rect(r.grow(1), Color(0, 0, 0, 0.75))
	ci.draw_rect(r, STONE_2)
	ci.draw_rect(Rect2(r.position, Vector2(r.size.x, 1)), Color(1, 1, 1, 0.1))
	ci.draw_rect(r, BRONZE, false, 1.0)
	ci.draw_string(f, Vector2(r.position.x, r.position.y + fs + 1), key, HORIZONTAL_ALIGNMENT_CENTER, w, fs, BRONZE_LITE)
	return r


# Width keycap() will take for this key (glyphs included).
static func keycap_w(key: String, fs := 11, min_w := 15.0) -> float:
	if Settings.pad_on and is_pad_label(key):
		return pad_glyph_w(key, fs + 5)
	return maxf(min_w, font("ui_semi").get_string_size(key, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x + 7.0)


# ---- 0.29: controller button glyphs, drawn (no art files). Names come from Settings.button_label / pad_name.
const PAD_FACE := ["A", "B", "X", "Y"]
const PAD_PS := ["Cross", "Circle", "Square", "Triangle"]
const PAD_BUMP := ["LB", "RB", "L1", "R1", "L", "R"]
const PAD_TRIG := ["LT", "RT", "L2", "R2", "ZL", "ZR"]
const PAD_STICK := ["L3", "R3"]
const PAD_MENU := ["View", "Menu", "Create", "Options", "Minus", "Plus", "Home"]
const PAD_DPAD := ["D-Up", "D-Down", "D-Left", "D-Right"]
const PAD_XBOX_COL := {"A": Color("#5cb85c"), "B": Color("#d9534f"), "X": Color("#3f86d8"), "Y": Color("#e8b830")}
const PAD_PS_COL := {"Cross": Color("#8fb0f0"), "Circle": Color("#f07a7a"), "Square": Color("#e09ae0"), "Triangle": Color("#5fd6b0")}


static func _pad_part_ok(p: String) -> bool:
	return p in PAD_FACE or p in PAD_PS or p in PAD_BUMP or p in PAD_TRIG or p in PAD_STICK or p in PAD_MENU or p in PAD_DPAD or p.begins_with("P") and p.length() == 2 or p in ["L4", "R4", "L5", "R5"]


static func is_pad_label(key: String) -> bool:
	if key == "" or key == "â€”":
		return false
	for p in key.split("+"):
		if not _pad_part_ok(p):
			return false
	return true


static func _pad_part_w(p: String, h: float) -> float:
	if p in PAD_FACE or p in PAD_PS or p in PAD_STICK or p in PAD_DPAD:
		return h
	if p in PAD_MENU:
		return h + 4.0
	return maxf(h + 4.0, font("ui_bold").get_string_size(p, HORIZONTAL_ALIGNMENT_LEFT, -1, int(h * 0.62)).x + 9.0)


static func pad_glyph_w(key: String, h := 16.0) -> float:
	var w := 0.0
	var parts := key.split("+")
	for i in parts.size():
		w += _pad_part_w(parts[i], h) + (8.0 if i > 0 else 0.0)
	return w


# Draws a controller name as glyphs from pos (top-left), h pixels high; returns the rect used.
static func pad_glyph(ci: CanvasItem, pos: Vector2, key: String, h := 16.0) -> Rect2:
	var x := pos.x
	var parts := key.split("+")
	for i in parts.size():
		if i > 0:
			var pc := Vector2(x + 4.0, pos.y + h / 2.0)
			ci.draw_rect(Rect2(pc - Vector2(4, 1.5), Vector2(8, 3)), Color(0, 0, 0, 0.85))
			ci.draw_rect(Rect2(pc - Vector2(1.5, 4), Vector2(3, 8)), Color(0, 0, 0, 0.85))
			ci.draw_rect(Rect2(pc - Vector2(3, 0.75), Vector2(6, 1.5)), BRONZE_LITE)
			ci.draw_rect(Rect2(pc - Vector2(0.75, 3), Vector2(1.5, 6)), BRONZE_LITE)
			x += 8.0
		var w := _pad_part_w(parts[i], h)
		_pad_part(ci, Rect2(x, pos.y, w, h), parts[i])
		x += w
	return Rect2(pos, Vector2(x - pos.x, h))


static func _pad_part(ci: CanvasItem, r: Rect2, p: String) -> void:
	var c := r.get_center()
	var rad := r.size.y / 2.0
	var f := font("ui_bold")
	var fs := int(r.size.y * 0.62)
	var st := Settings.pad_style_now()
	if p in PAD_FACE or p in PAD_STICK:
		var col := Color("#3a3833")
		var txt := Color(0.96, 0.95, 0.92)
		if st == 1 and PAD_XBOX_COL.has(p):
			txt = PAD_XBOX_COL[p].lightened(0.25)
		ci.draw_circle(c, rad + 1.0, Color(0, 0, 0, 0.85))
		ci.draw_circle(c, rad, col)
		ci.draw_arc(c, rad - 0.5, PI * 1.05, PI * 1.95, 10, Color(1, 1, 1, 0.18), 1.0, true)
		if st == 1 and PAD_XBOX_COL.has(p):
			ci.draw_arc(c, rad - 1.0, 0, TAU, 20, Color(PAD_XBOX_COL[p], 0.9), 1.5, true)
		if p in PAD_STICK:
			ci.draw_arc(c, rad - 2.5, 0, TAU, 18, Color(1, 1, 1, 0.35), 1.0, true)
			fs = int(r.size.y * 0.5)
		ci.draw_string(f, Vector2(r.position.x, c.y + fs * 0.36), p, HORIZONTAL_ALIGNMENT_CENTER, r.size.x, fs, txt)
		return
	if p in PAD_PS:
		ci.draw_circle(c, rad + 1.0, Color(0, 0, 0, 0.85))
		ci.draw_circle(c, rad, Color("#2e2d2a"))
		var sc: Color = PAD_PS_COL[p]
		var u := rad * 0.5
		match p:
			"Cross":
				ci.draw_line(c + Vector2(-u, -u), c + Vector2(u, u), sc, 1.8, true)
				ci.draw_line(c + Vector2(-u, u), c + Vector2(u, -u), sc, 1.8, true)
			"Circle":
				ci.draw_arc(c, u * 1.05, 0, TAU, 16, sc, 1.6, true)
			"Square":
				ci.draw_rect(Rect2(c - Vector2(u, u) * 0.9, Vector2(u, u) * 1.8), sc, false, 1.6)
			"Triangle":
				var pts := PackedVector2Array([c + Vector2(0, -u * 1.1), c + Vector2(u * 1.05, u * 0.75), c + Vector2(-u * 1.05, u * 0.75), c + Vector2(0, -u * 1.1)])
				ci.draw_polyline(pts, sc, 1.6, true)
		return
	if p in PAD_DPAD:
		var a := r.size.y * 0.34
		var arms := {"D-Up": Vector2(0, -1), "D-Down": Vector2(0, 1), "D-Left": Vector2(-1, 0), "D-Right": Vector2(1, 0)}
		ci.draw_rect(Rect2(c - Vector2(a / 2.0 + 1, rad + 0.5), Vector2(a + 2, rad * 2 + 1)), Color(0, 0, 0, 0.85))
		ci.draw_rect(Rect2(c - Vector2(rad + 0.5, a / 2.0 + 1), Vector2(rad * 2 + 1, a + 2)), Color(0, 0, 0, 0.85))
		ci.draw_rect(Rect2(c - Vector2(a / 2.0, rad - 0.5), Vector2(a, rad * 2 - 1)), Color("#4a4740"))
		ci.draw_rect(Rect2(c - Vector2(rad - 0.5, a / 2.0), Vector2(rad * 2 - 1, a)), Color("#4a4740"))
		var d: Vector2 = arms[p]
		var arm := Rect2(c + d * (rad * 0.5) - Vector2(a, a) / 2.0 + d * 0.5, Vector2(a, a))
		arm = arm.merge(Rect2(c + d * (rad - a / 2.0 - 0.5) - Vector2(a, a) / 2.0, Vector2(a, a)))
		ci.draw_rect(arm, Color(0.96, 0.95, 0.9))
		return
	# shoulder / trigger tabs and the menu buttons: a rounded plate with the name or a small icon
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color("#3a3833")
	sb.border_color = Color(0, 0, 0, 0.85)
	sb.set_border_width_all(1)
	sb.anti_aliasing = true
	if p in PAD_TRIG:
		sb.corner_radius_top_left = int(rad)
		sb.corner_radius_top_right = int(rad)
		sb.corner_radius_bottom_left = 2
		sb.corner_radius_bottom_right = 2
	elif p in PAD_MENU:
		sb.set_corner_radius_all(int(rad))
	else:
		sb.corner_radius_top_left = int(rad * 0.9)
		sb.corner_radius_top_right = int(rad * 0.9)
		sb.corner_radius_bottom_left = 3
		sb.corner_radius_bottom_right = 3
	ci.draw_style_box(sb, r)
	ci.draw_rect(Rect2(r.position + Vector2(3, 1), Vector2(r.size.x - 6, 1)), Color(1, 1, 1, 0.16))
	var tc := Color(0.96, 0.95, 0.92)
	if p in PAD_MENU:
		var u := r.size.y * 0.22
		match p:
			"View", "Create":
				ci.draw_rect(Rect2(c + Vector2(-u * 1.2, -u * 0.9), Vector2(u * 1.5, u * 1.3)), tc, false, 1.2)
				ci.draw_rect(Rect2(c + Vector2(-u * 0.3, -u * 0.4), Vector2(u * 1.5, u * 1.3)), tc, false, 1.2)
			"Menu", "Options":
				for k in 3:
					ci.draw_rect(Rect2(c + Vector2(-u * 1.2, -u + k * u - 0.6), Vector2(u * 2.4, 1.3)), tc)
			"Plus":
				ci.draw_rect(Rect2(c - Vector2(u * 1.1, 0.7), Vector2(u * 2.2, 1.4)), tc)
				ci.draw_rect(Rect2(c - Vector2(0.7, u * 1.1), Vector2(1.4, u * 2.2)), tc)
			"Minus":
				ci.draw_rect(Rect2(c - Vector2(u * 1.1, 0.7), Vector2(u * 2.2, 1.4)), tc)
			"Home":
				ci.draw_circle(c, u, tc)
		return
	ci.draw_string(f, Vector2(r.position.x, c.y + fs * 0.36 + 1.0), p, HORIZONTAL_ALIGNMENT_CENTER, r.size.x, fs, tc)


static func bevel(ci: CanvasItem, r: Rect2, lite: Color, dark: Color, w := 2.0) -> void:
	ci.draw_rect(Rect2(r.position, Vector2(r.size.x, w)), lite)
	ci.draw_rect(Rect2(r.position, Vector2(w, r.size.y)), lite)
