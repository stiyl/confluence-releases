# ---- ability icons (art/ui/abilities/<hero>_<i>.png, baked by tools/bake_ability_icons.gd from the fx models).
# icon_kind "ab:<hero>:<i>". Unlearned icons use a desaturated copy that keeps its contrast.
const TIER_COL := [Color("#8a8070"), Color("#a9a39a"), Color("#4fc76a"), Color("#ff8a2a"), Color("#b46cff")]
static var _ab_tex := {}
static var _ab_by_name := {}


static func ability_key(skill_name: String) -> String:
	if _ab_by_name.is_empty():
		for c in GameData.CHAMPS:
			for i in c["skills"].size():
				if not _ab_by_name.has(String(c["skills"][i]["name"])):   # 0.34: the first hero keeps a shared name
					_ab_by_name[String(c["skills"][i]["name"])] = "%s:%d" % [c["id"], i]
	return _ab_by_name.get(skill_name, "")


# 0.34: an ability's icon key from its definition: its own "icon" key when it shares a name with another
# hero's ability (the Cultist's mark), else by name as before.
static func ability_key_of(s: Dictionary) -> String:
	return String(s["icon"]) if s.has("icon") else ability_key(String(s.get("name", "")))


static func ability_tex(key: String, grey := false) -> Texture2D:
	var ck := key + ("|g" if grey else "")
	if _ab_tex.has(ck):
		return _ab_tex[ck]
	var t: Texture2D = null
	var path := "res://art/ui/abilities/%s.png" % key.replace(":", "_")
	if ResourceLoader.exists(path):
		t = load(path)
		if grey and t != null:
			var img := t.get_image()
			if img != null:
				img = img.duplicate()
				if img.is_compressed():
					img.decompress()
				img.convert(Image.FORMAT_RGBA8)
				for y in img.get_height():
					for x in img.get_width():
						var c := img.get_pixel(x, y)
						var l := c.r * 0.3 + c.g * 0.55 + c.b * 0.15
						# desaturate, lift the darks a little and stretch the contrast so the shape still reads
						var v := clampf(0.16 + (l - 0.1) * 1.25, 0.0, 1.0)
						img.set_pixel(x, y, Color(v, v * 0.97, v * 0.92, c.a))
				t = ImageTexture.create_from_image(img)
	_ab_tex[ck] = t
	return t


static func item_tier(icon_kind: String) -> int:
	if not icon_kind.begins_with("item:"):
		return 0
	return int(GameData.item(icon_kind.substr(5)).get("tier", 0))


# A tier frame for items: grey basic, green advanced, orange legendary, violet mythic with a soft glow.
static func tier_frame(ci: CanvasItem, r: Rect2, tier: int, t := 0.0) -> void:
	var col: Color = TIER_COL[clampi(tier, 0, 4)]
	if tier >= 4:
		var pulse := 0.75 + 0.25 * sin(t * 3.0)
		for i in 4:
			ci.draw_rect(r.grow(1.0 + i * 1.5), Color(col, (0.32 - i * 0.07) * pulse), false, 1.5)
	ci.draw_rect(r.grow(1.5), Color(0, 0, 0, 0.9), false, 1.5)
	ci.draw_rect(r, col, false, 2.0 if tier < 3 else 2.5)
	ci.draw_rect(r.grow(-2), col.darkened(0.55), false, 1.0)
	if tier >= 3:
		# corner studs mark the top tiers at a glance
		for p in [r.position, Vector2(r.end.x, r.position.y), Vector2(r.position.x, r.end.y), r.end]:
			ci.draw_rect(Rect2(p - Vector2(2.5, 2.5), Vector2(5, 5)), col.lightened(0.35))


# Portrait backdrop: a dark, desaturated version of the hero's colour (so a red hero is not red on red),
# lighter behind the head, with a thin coloured glow along the bottom edge.
static func portrait_bg(ci: CanvasItem, r: Rect2, col: Color) -> void:
	var g := col.r * 0.3 + col.g * 0.55 + col.b * 0.15
	var ds := Color(g, g, g).lerp(col, 0.35)
	gradient_fill(ci, r, ds.darkened(0.62).lerp(Color(0.16, 0.15, 0.17), 0.3), Color(0.045, 0.04, 0.05), 10)
	var c := r.position + Vector2(r.size.x * 0.5, r.size.y * 0.38)
	for i in 5:
		ci.draw_circle(c, r.size.x * (0.46 - i * 0.07), Color(ds.lightened(0.2), 0.045))
	gradient_fill(ci, Rect2(r.position + Vector2(0, r.size.y * 0.78), Vector2(r.size.x, r.size.y * 0.22)), Color(col, 0.0), Color(col, 0.28), 5)


