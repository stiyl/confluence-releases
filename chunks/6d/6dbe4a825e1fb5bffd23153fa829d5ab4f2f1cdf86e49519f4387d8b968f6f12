		return
	if c.pl.human:
		human_orders(ar, c, dt)
	var p0: Vector2 = c.p
	var step0 := 0.0
	if c.moving:
		var stepd := c_ms(c) * dt
		step0 = stepd
		while stepd > 0 and not c.route.is_empty():
			var tgt: Vector2 = c.route[0]
			var dv: Vector2 = tgt - c.p
			var d := dv.length()
			if d <= stepd:
				c.p = tgt
				stepd -= d
				c.route.pop_front()
			else:
				c.p += dv / d * stepd
