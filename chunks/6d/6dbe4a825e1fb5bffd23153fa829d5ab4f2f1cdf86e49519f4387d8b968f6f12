# ---------------------------------------------------------------- scoring
static func stat(pl, key: String) -> float:
	match key:
		"send_core_dmg": return float(pl.send_core_dmg)
		"gold_sent": return float(pl.gold_sent)
		"hero_dmg": return float(pl.hero_dmg)
		"kills": return float(pl.kills)
		"gold_earned": return float(pl.gold_earned)
		"boss_dmg": return float(pl.boss_dmg)
		"duel_wins": return float(pl.duel_wins)
	return 0.0


static func mvp_scores(players: Array) -> Dictionary:
	var out := {}
	for pl in players:
		out[pl] = 0.0
	for key in MVP_WEIGHTS:
		var mx := 0.0
		for pl in players:
			mx = maxf(mx, stat(pl, key))
		if mx <= 0.0:
			continue
		for pl in players:
			out[pl] += float(MVP_WEIGHTS[key]) * stat(pl, key) / mx
	return out


static func mvp(players: Array):
	var sc := mvp_scores(players)
	var best = null
	for pl in players:
		if best == null or sc[pl] > sc[best] + 1e-6:
			best = pl
	return best


# Which player takes each award. A player who already holds one yields a card to a rival within 10%,
# so one strong player does not sweep the whole row. Returns [[title, player, value, glyph, unit], ...].
static func awards_for(players: Array) -> Array:
	var held := {}
	var out: Array = []
	for a in AWARDS:
		var key: String = a[1]
		var ranked := players.duplicate()
		ranked.sort_custom(func(x, y): return stat(x, key) > stat(y, key))
		var top = ranked[0]
		var tv := stat(top, key)
		if tv <= 0.0:
			continue
		var pick = top
		if int(held.get(top, 0)) > 0:
			for r in ranked.slice(1):
				if stat(r, key) >= tv * 0.9 and int(held.get(r, 0)) < int(held.get(top, 0)):
					pick = r
					break
		held[pick] = int(held.get(pick, 0)) + 1
		out.append([a[0], pick, stat(pick, key), a[2], a[3]])
		if out.size() >= MAX_AWARDS:
			break
	return out


