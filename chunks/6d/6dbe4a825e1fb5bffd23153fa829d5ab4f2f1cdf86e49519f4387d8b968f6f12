static var pad_on := false              # runtime: the last input came from a controller (glyphs instead of keycaps)
static var pad_auto_style := 1          # runtime: the style "Auto" resolved to (1..4)


static func ensure() -> void:
	if _loaded:
		return
	_loaded = true
	for a in ACTIONS:
		keys[a[0]] = a[2]
	for a in PAD_ACTIONS:
		pads[a[0]] = a[2]
	var cf := ConfigFile.new()
	if cf.load(PATH) != OK:
		gfx()
		return
	master_vol = float(cf.get_value("audio", "master", master_vol))
	music_vol = float(cf.get_value("audio", "music", music_vol))
	sfx_vol = float(cf.get_value("audio", "sfx", sfx_vol))
	edge_pan = bool(cf.get_value("camera", "edge_pan", edge_pan))
	confine_mouse = bool(cf.get_value("camera", "confine_mouse", confine_mouse))
	edge_speed = float(cf.get_value("camera", "edge_speed", edge_speed))
	game_speed = float(cf.get_value("game", "speed", game_speed))
	# 0.31: only a speed the Settings screen offers (a script that froze the clock at 0 once saved it, and a frozen
	# match then never moved or counted playtime)
	var best: float = SPEEDS[0]
	for sp in SPEEDS:
		if absf(float(sp) - game_speed) < absf(best - game_speed):
			best = float(sp)
	game_speed = best
	alerts = bool(cf.get_value("game", "alerts", alerts))
	shake = bool(cf.get_value("game", "shake", shake))
	shake_level = clampi(int(cf.get_value("game", "shake_level", 2 if shake else 0)), 0, 2)
	shake = shake_level > 0
	hit_stop = bool(cf.get_value("game", "hit_stop", hit_stop))
	dmg_numbers = clampi(int(cf.get_value("game", "dmg_numbers", dmg_numbers)), 0, 2)
	quick_cast = bool(cf.get_value("game", "quick_cast", quick_cast))
	hq = bool(cf.get_value("graphics", "hq", hq))
	graphics = int(cf.get_value("graphics", "preset", -1))
	if graphics < 0 and cf.has_section_key("graphics", "hq") and not hq:
		graphics = GFX_LOW   # turned "3D quality" off before the presets existed
	show_fps = bool(cf.get_value("graphics", "show_fps", show_fps))
	campaign_autoplay = bool(cf.get_value("game", "campaign_autoplay", campaign_autoplay))
	tips = bool(cf.get_value("game", "tips", tips))
	fullscreen = bool(cf.get_value("display", "fullscreen", fullscreen))
	vsync = bool(cf.get_value("display", "vsync", vsync))
	fps_cap = int(cf.get_value("display", "fps_cap", fps_cap))
	if not FPS_CAPS.has(fps_cap):
		fps_cap = 0
	smooth_motion = bool(cf.get_value("display", "smooth_motion", smooth_motion))
	chat_filter = bool(cf.get_value("display", "chat_filter", chat_filter))
	show_pings = bool(cf.get_value("game", "show_pings", show_pings))
	ui_scale = clampf(float(cf.get_value("display", "ui_scale", ui_scale)), 0.8, 1.4)
	minimap_both = bool(cf.get_value("display", "minimap_both", minimap_both))
	hover_hl = bool(cf.get_value("display", "hover_hl", hover_hl))
	cursor_size = clampi(int(cf.get_value("display", "cursor_size", cursor_size)), 0, 2)
	check_updates = bool(cf.get_value("updates", "check", check_updates))
	play_intro = bool(cf.get_value("display", "intro", play_intro))
	last_notes = String(cf.get_value("updates", "last_notes", last_notes))
	steam_zip_note = bool(cf.get_value("updates", "steam_zip_note", steam_zip_note))
	# 0.18: the default cursor is Small; a saved file from before that still holds the old default (Normal)
	# is moved once, an explicit choice of Normal made under 0.18 (cursor/_v 1) stays
	if int(cf.get_value("display", "cursor_v", 0)) < 1 and cursor_size == 1:
		cursor_size = 0
	for a in ACTIONS:
		keys[a[0]] = int(cf.get_value("keys", a[0], a[2]))
	# 0.14.3: Space became "camera to hero" and F "pick rift"; swap saved binds that still hold the old defaults
	if int(cf.get_value("keys", "_v", 0)) < 2 and int(keys.get("lane", 0)) == KEY_SPACE and int(keys.get("center", 0)) == KEY_F:
		keys["lane"] = KEY_F
		keys["center"] = KEY_SPACE
	# 0.17: V became "start next round" and the Demon Gate moved to "."; move a saved V bind off the Gate
	if int(cf.get_value("keys", "_v", 0)) < 3 and int(keys.get("build4", 0)) == KEY_V and int(keys.get("vote", 0)) == KEY_V:
		keys["build4"] = KEY_PERIOD if action_for(KEY_PERIOD) == "" else 0
	if int(cf.get_value("keys", "_v", 0)) < 3 and int(keys.get("vote", 0)) == KEY_V:
		# a player who had put something else on V keeps it: the new action starts unbound for them
		for a in keys:
			if a != "vote" and int(keys[a]) == KEY_V:
				keys["vote"] = 0
				break
	# 0.23: buildings on Z X C V and the vote on Enter (a tester's layout); online chat opens with "/" since Enter
	# votes now. Only binds that still hold the old defaults move; a custom bind stays where the player put it.
	if int(cf.get_value("keys", "_v", 0)) < 4:
		if int(keys.get("vote", 0)) == KEY_V and _free(KEY_ENTER, "vote"):
			keys["vote"] = KEY_ENTER
		if int(keys.get("build4", 0)) == KEY_PERIOD and _free(KEY_V, "build4"):
			keys["build4"] = KEY_V
		if not cf.has_section_key("keys", "chat") and not _free(KEY_SLASH, "chat"):
			keys["chat"] = 0   # "/" already belongs to another action: chat starts unbound (Enter opens it if free)
	# 0.25.2: the vote moved off Enter to F6 (Enter is free again, so it opens the online chat as before)
	if int(cf.get_value("keys", "_v", 0)) < 5:
		if int(keys.get("vote", 0)) == KEY_ENTER and _free(KEY_F6, "vote"):
			keys["vote"] = KEY_F6
	# 0.26: "Report a bug" on F10; a player who had already put something on F10 keeps it (the new action starts unbound)
	if int(cf.get_value("keys", "_v", 0)) < 6 and not cf.has_section_key("keys", "bugreport") and not _free(KEY_F10, "bugreport"):
		keys["bugreport"] = 0
	# 0.35.5: Ping moved from Alt to G (the user's call) and "Watch the duel" from G to "." - only binds still on the
	# old defaults move; a key the player chose stays theirs
	if int(cf.get_value("keys", "_v", 0)) < 7 and int(keys.get("ping", 0)) == KEY_ALT:
		if int(keys.get("duel", 0)) == KEY_G:
			keys["duel"] = KEY_PERIOD if _free(KEY_PERIOD, "duel") else 0
		if _free(KEY_G, "ping"):
			keys["ping"] = KEY_G
	# 0.29: controller settings and pad binds ([pad] _v 1; later layout changes migrate here like the keys)
	pad_enabled = bool(cf.get_value("pad", "enabled", pad_enabled))
	pad_southpaw = bool(cf.get_value("pad", "southpaw", pad_southpaw))
	pad_dead = clampf(float(cf.get_value("pad", "dead", pad_dead)), 0.05, 0.5)
	pad_cursor = clampf(float(cf.get_value("pad", "cursor", pad_cursor)), 0.3, 3.0)
	pad_cam = clampf(float(cf.get_value("pad", "cam", pad_cam)), 0.3, 3.0)
	pad_rumble = bool(cf.get_value("pad", "rumble", pad_rumble))
	pad_style = clampi(int(cf.get_value("pad", "style", pad_style)), 0, PAD_STYLES.size() - 1)
	if int(cf.get_value("pad", "_v", 0)) >= 1:
		for a in PAD_ACTIONS:
			pads[a[0]] = int(cf.get_value("pad", "b_" + a[0], a[2]))
	gfx()


# True when no action other than `except` holds key k.
static func _free(k: int, except: String) -> bool:
	for a in keys:
		if a != except and int(keys[a]) == k:
			return false
	return true


# The graphics preset in effect (picks the renderer's default the first time).
static func gfx() -> int:
	if graphics < 0 or graphics > GFX_ULTRA:
		var compat := RenderingServer.get_rendering_device() == null
		graphics = GFX_LOW if compat or weak_gpu() else GFX_MEDIUM
	hq = graphics >= GFX_HIGH
	return graphics


# 0.28: a software or virtual GPU (ChromeOS's Linux container uses virgl; no driver at all means llvmpipe).
# There the Low preset also renders the 3D view at a lower resolution (gfx_cfg "scale" 0.6 instead of 0.75).
const WEAK_GPUS := ["llvmpipe", "softpipe", "lavapipe", "swiftshader", "virgl", "virtio", "svga3d", "microsoft basic"]
static var _weak := -1
static func weak_gpu() -> bool:
	if _weak < 0:
		var n := (RenderingServer.get_video_adapter_name() + " " + RenderingServer.get_video_adapter_vendor()).to_lower()
		_weak = 0
		for w in WEAK_GPUS:
			if n.contains(w):
				_weak = 1
	return _weak == 1


static func set_gfx(level: int) -> void:
	graphics = clampi(level, GFX_LOW, GFX_ULTRA)
	hq = graphics >= GFX_HIGH
	save()


# What each preset sets (ArenaView.apply_quality, FxLayer, FxModels and the prop builder read these).
static func gfx_cfg() -> Dictionary:
	match gfx():
		GFX_LOW:
			return {"shadows": 0, "ssao": false, "glow": false, "fog": false, "msaa": Viewport.MSAA_DISABLED, "fxaa": true,
				"scale": 0.6 if weak_gpu() else 0.75, "particles": 0.4, "fx_cap": 40, "lod": 4.0, "lod_far": 8.0, "unit_full": false, "props": 0.45, "lights": false, "deco": 0.5}
		GFX_MEDIUM:
			return {"shadows": 1, "ssao": false, "glow": true, "fog": true, "msaa": Viewport.MSAA_2X, "fxaa": true,
				"scale": 0.85, "particles": 0.7, "fx_cap": 80, "lod": 1.5, "lod_far": 3.0, "unit_full": false, "props": 0.75, "lights": true, "deco": 0.75}
		GFX_ULTRA:
			return {"shadows": 3, "ssao": true, "glow": true, "fog": true, "msaa": Viewport.MSAA_4X, "fxaa": true,
				"scale": 1.0, "particles": 1.0, "fx_cap": 220, "lod": 0.0, "lod_far": 0.0, "unit_full": true, "props": 1.0, "lights": true, "deco": 1.0}
	# High: the old "3D quality on" look. Props use Godot's standard sub-pixel LOD (threshold 1 px);
	# units keep their full meshes at the normal camera and only simplify once zoomed out
	return {"shadows": 2, "ssao": true, "glow": true, "fog": true, "msaa": Viewport.MSAA_4X, "fxaa": true,
		"scale": 1.0, "particles": 1.0, "fx_cap": 160, "lod": 1.0, "lod_far": 1.0, "unit_full": true, "props": 1.0, "lights": true, "deco": 1.0}


