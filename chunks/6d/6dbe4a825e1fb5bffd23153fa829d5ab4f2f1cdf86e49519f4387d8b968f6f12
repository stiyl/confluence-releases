	ci.draw_rect(r, Color(BRONZE, a), false, 2.0)
	ci.draw_rect(r.grow(-2), Color(BRONZE_LITE, 0.22 * a), false, 1.0)
	ci.draw_rect(r.grow(-3), Color(BRONZE_DARK, 0.6 * a), false, 1.0)
