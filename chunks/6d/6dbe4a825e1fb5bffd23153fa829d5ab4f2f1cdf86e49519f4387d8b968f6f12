var main                    # the HUD (announce, audio, minimap)
var sim: Sim
var m: Dictionary
var hero := ""
var flags := {}             # campaign flags + the ones this mission sets
var objs: Array = []        # objective dicts with "state" (active/done/failed), "hidden", "count"
var evs: Array = []         # event dicts with "fired", "last"
var later: Array = []       # [sim time, actions]
var holding := false        # a scene is playing: the match is frozen
var started := false
var result := ""            # "", "win", "lose"
var lose_reason := ""
var kills := {}             # kind -> count (our lane)
var kills_all := 0
var duel_w := 0
var duel_l := 0
var duel_best_hp := 0.0
var camp_done := false
var pulse := {}             # edge-triggered conditions seen this frame
