var core_min := 1.0
var drain := 0.0             # fraction of the Heartstone lost per second (a chapter's corruption)
var boss_seen := {}         # boss kind -> lowest health fraction seen (for phase triggers)


func _init(p_ui, p_main, p_sim: Sim, mission: Dictionary, p_hero: String) -> void:
	ui = p_ui
	main = p_main
	sim = p_sim
	m = mission
	hero = p_hero
	flags = Campaign.flags.duplicate()
	for o in m.get("objectives", []):
		if not CampaignData.passes(o, flags):
			continue
		var d: Dictionary = o.duplicate(true)
		d["state"] = "active"
		d["hidden"] = bool(o.get("hidden", false))
		d["count"] = 0
		if String(o["kind"]) == "channel":
			d["prog"] = []
			d["lit"] = []
			for i in o["points"].size():
				d["prog"].append(0.0)
				d["lit"].append(false)
		objs.append(d)
	for e in m.get("events", []):
		if not CampaignData.passes(e, flags):
			continue
		var d: Dictionary = e.duplicate(true)
		d["fired"] = false
		d["last"] = -999.0
		evs.append(d)


# ---------------------------------------------------------------- frame
func begin() -> void:
	var intro: Array = m.get("intro", [])
	if intro.is_empty():
		_start()
	else:
		play(intro, _start)


func _start() -> void:
	started = true
	drain = float(m.get("drain", 0.0))
	_update_floor()


# The enemy Heartstone cannot break before the chapter's other main objectives are done
# (otherwise the story would be skipped), and never in chapters that are not about breaking it.
func _update_floor() -> void:
	var destroy := false
	var pending := false
	for o in objs:
		var k := String(o["kind"])
		if k == "destroy":
			destroy = true
		elif not o.get("bonus", false) and o["state"] == "active" and k not in ["core_floor", "deadline", "before", "protect"]:
			pending = true
	if sim.round_no < int(m.get("shield_until", 0)):
		pending = true
	sim.arenas[1 - me().team].core_floor = 0.1 if (not destroy or pending) else 0.0
	_fire_matching()


func play(steps: Array, done_cb := Callable()) -> void:
	var filtered: Array = []
	for s in steps:
		if CampaignData.passes(s, flags):
			filtered.append(s)
	holding = true
	ui.play_scene(filtered, func():
		holding = false
		if done_cb.is_valid():
			done_cb.call())


func me():
	return sim.players[sim.local]


func my_ar():
	return sim.arenas[me().team]


# Called with sim.events before the HUD consumes them.
func feed(events: Array) -> void:
	if not started or result != "":
		return
	var team: int = me().team
	for e in events:
		match String(e["k"]):
			"mdie":
				if int(e.get("team", -1)) == team:
					var k := String(e.get("kind", ""))
					kills[k] = int(kills.get(k, 0)) + 1
					kills_all += 1
			"boss_down":
				pulse["boss_down:" + String(e.get("kind", ""))] = true
				flags["boss_down:" + String(e.get("kind", ""))] = true
			"duel_end":
				if e.get("human_won", false):
					duel_w += 1
					duel_best_hp = maxf(duel_best_hp, float(e.get("hp", 0.0)))
					pulse["duel_won"] = true
				elif e.get("human_lost", false):
					duel_l += 1
					pulse["duel_lost"] = true
			"duel_start":
				if e.get("human", false):
					pulse["duel_start"] = true
			"totems":
				if int(e.get("a", -1)) == team:
					pulse["totems"] = true
			"camp_cleared":
				if int(e.get("team", -1)) == team and String(e.get("kind", "ancient")) == "ancient":
					camp_done = true


func update(delta: float) -> void:
	if not started or result != "":
		return
	# hero and ally deaths
	for i in 4:
		var pl = sim.players[i]
		var dead: bool = (not pl.absent) and pl.champ.dead
		if dead and not bool(dead_prev.get(i, false)):
			pulse["dead:%d" % i] = true
			flags["died:%d" % i] = true
		dead_prev[i] = dead
	var ar = my_ar()
	core_min = minf(core_min, ar.core_hp / ar.core_max)
	if drain > 0.0 and not sim.over:
		sim.core_hit(ar, ar.core_max * drain * delta)
	_update_channels(delta)
	for mo in sim.arenas[0].mons + sim.arenas[1].mons:
		if not mo.dead and mo.d.get("boss", false):
			boss_seen[mo.kind] = minf(float(boss_seen.get(mo.kind, 1.0)), mo.hp / mo.max_hp)
	# delayed actions
	if not later.is_empty():
		var keep: Array = []
		for l in later:
			if sim.t >= float(l[0]):
				run(l[1])
			else:
				keep.append(l)
		later = keep
	_eval_objectives()
	_update_floor()
	_fire_matching()
	pulse.clear()
	_check_end()


# Standing on a channel point fills it; when full it is lit. "order": true lights them one at a time.
func _update_channels(delta: float) -> void:
	var c = me().champ
	for o in objs:
		if String(o["kind"]) != "channel" or o["state"] != "active" or o["hidden"]:
			continue
		if c.dead or c.ar != my_ar():
			continue
		for i in o["points"].size():
			if o["lit"][i]:
				continue
			var p: Vector2 = point(o["points"][i])
			if c.p.distance_to(p) <= float(o.get("r", 120.0)):
				o["prog"][i] = float(o["prog"][i]) + delta
				if float(o["prog"][i]) >= float(o.get("secs", 6.0)):
					o["lit"][i] = true
					sim.burst(my_ar(), p, Color(1.0, 0.85, 0.4), 40, 220)
					main.audio.play("level", -2.0)
					pulse["lit:%s" % o["id"]] = true
					flags["lit:%s:%d" % [o["id"], i]] = true
			if o.get("order", false):
				break


func lit_count(o: Dictionary) -> int:
	var n := 0
	for l in o.get("lit", []):
		if l:
			n += 1
	return n


# A named place on the map ("junction", "core", "lane1:0.4", ...), as the camera knows it.
func point(w) -> Vector2:
	return ui._where(w)


func _fire_matching() -> void:
	for e in evs:
		if result != "":
			return
		var once := bool(e.get("once", true))
		if once and e["fired"]:
			continue
		if not once and sim.t - float(e["last"]) < float(e.get("cd", 0.0)):
			continue
		if not _cond(e["when"], once):
			continue
		e["fired"] = true
		e["last"] = sim.t
		if e.has("delay"):
			later.append([sim.t + float(e["delay"]), e["do"]])
		else:
			run(e["do"])


func _cond(w: Dictionary, once: bool) -> bool:
	for k in w:
		var v = w[k]
		match String(k):
			"start":
				if not started:
					return false
			"round":
				if sim.round_no < int(v):
					return false
			"time":
				if sim.t < float(v):
					return false
			"boss_down":
				if not (flags.has("boss_down:" + String(v)) if once else pulse.has("boss_down:" + String(v))):
					return false
			"obj":
				if obj_state(String(v)) != "done":
					return false
			"all_obj":
				for id in v:
					if obj_state(String(id)) != "done":
						return false
			"core_below":
				var ar = my_ar()
				if ar.core_hp / ar.core_max >= float(v):
					return false
			"enemy_core_below":
				var ea = sim.arenas[1 - me().team]
				if ea.core_hp / ea.core_max >= float(v):
					return false
			"hero_dead":
				if not (flags.has("died:0") if once else pulse.has("dead:0")):
					return false
			"ally_dead":
				var key := "died:%d" % int(v)
				if not (flags.has(key) if once else pulse.has("dead:%d" % int(v))):
					return false
			"duel_won":
				if not (duel_w >= int(v) if once else pulse.has("duel_won")):
					return false
			"duel_lost":
				if not (duel_l >= int(v) if once else pulse.has("duel_lost")):
					return false
			"duel_start":
				if not pulse.has("duel_start"):
					return false
			"totems":
				if not pulse.has("totems"):
					return false
			"built":
				if me().tech < int(v):
					return false
			"flag":
				if not flags.has(String(v)):
					return false
			"boss_hp":
				# [kind, fraction]: the boss has been worn below this much health
				if float(boss_seen.get(String(v[0]), 1.0)) >= float(v[1]):
					return false
			"lit":
				# [objective, n]: that many of its channel points are lit
				if lit_count(obj(String(v[0]))) < int(v[1]):
					return false
			"kills":
				if kills_all < int(v):
					return false
			"before":
				# only before wave n
				if sim.round_no >= int(v):
					return false
			"killed":
				# [kind, n]: that many of this kind slain on your road
				if int(kills.get(String(v[0]), 0)) < int(v[1]):
					return false
			"noflag":
				# true only while this flag is NOT set (lets a repeating event stop)
				if flags.has(String(v)):
					return false
	return true


# ---------------------------------------------------------------- actions
func run(actions: Array) -> void:
	for a in actions:
		if result != "":
			return
		if not CampaignData.passes(a, flags):
			continue
		for k in a:
			if k in ["if", "unless", "if2", "unless_any"]:
				continue
			_act(String(k), a[k])


func _act(k: String, v) -> void:
	match k:
		"say":
			ui.bark(String(v[0]), String(v[1]))
		"scene":
			play(v)
		"boss":
			var team := int(v.get("team", me().team))
			var hm: float = float(v.get("hpm", 1.0)) * (1.0 + 0.06 * sim.round_no) * float(Campaign.diff_def()["waves"])
			var ar = sim.arenas[team]
			# story bosses hit the Heartstone less hard than wave bosses: the fight should be with the heroes
			var bm = sim.place_mon(ar, String(v["kind"]), int(v.get("lane", 0)), 0.01, hm)
			bm.lives = maxi(3, int(round(bm.lives * float(v.get("siege", 0.45)) * minf(1.0, float(Campaign.diff_def()["waves"])))))
			if team == me().team:
				sim.ev("boss", null, Vector2.ZERO, {"name": GameData.MON[String(v["kind"])]["name"], "kind": String(v["kind"])})
		"spawn":
			var team := int(v.get("team", me().team))
			var ar = sim.arenas[team]
			var n := int(v.get("n", 1))
			var lanes: Array = [0, 1] if int(v.get("lane", 0)) < 0 else [int(v.get("lane", 0))]
			var hm: float = float(v.get("hpm", 1.0)) * Sim.hp_mult(maxi(1, sim.round_no)) * float(Campaign.diff_def()["waves"])
			for lane in lanes:
				for i in n:
					if v.has("frac_rand"):
						# somewhere along the road (meteors, ambushes)
						var fr: float = sim.rng.randf_range(float(v["frac_rand"][0]), float(v["frac_rand"][1]))
						var mo = sim.place_mon(ar, String(v["kind"]), lane, fr, hm)
						if v.get("fx", "") == "meteor":
							sim.burst(ar, mo.p, Color(0.75, 0.55, 1.0), 36, 260)
							sim.add_fx(ar, {"type": "ring", "p": mo.p, "r": 90.0, "col": Color(0.7, 0.5, 1.0), "t": 0.7, "dur": 0.7, "fill": true})
							if team == me().team:
								main.audio.play("boom", -8.0)
					elif v.has("frac"):
						sim.place_mon(ar, String(v["kind"]), lane, float(v["frac"]), hm)
					else:
						ar.spawn_q.append([sim.t + float(v.get("delay", 0.3)) + i * 0.6, String(v["kind"]), lane, null, hm])
		"join":
			var slot := int(v)
			var pl = sim.players[slot]
			sim.activate_slot(slot, Sim.HOMES[pl.champ.home])
			main.minimap.ping(Sim.HOMES[pl.champ.home], Color(0.5, 1.0, 0.6), me().team)
		"leave":
			var pl = sim.players[int(v)]
			if not pl.absent:
				pl.absent = true
				var c = pl.champ
				c.ar.champs.erase(c)
				sim.burst(c.ar, c.p, Color(1, 0.9, 0.6), 30, 160)
		"obj_show":
			var o := obj(String(v))
			if not o.is_empty() and o["hidden"]:
				o["hidden"] = false
				ui.objective_note("New objective", o["text"], false)
		"obj_done":
			_set_obj(String(v), "done")
		"obj_fail":
			_set_obj(String(v), "failed")
		"gold":
			me().gold += float(v)
		"flag":
			flags[String(v)] = true
		"win":
			finish("win")
		"lose":
			lose_reason = String(v)
			finish("lose")
		"core":
			var ar = my_ar()
			ar.core_hp = minf(ar.core_max, ar.core_hp + ar.core_max * float(v))
		"core_lv":
			var ar = my_ar()
			ar.core_lv[int(v[0])] = maxi(ar.core_lv[int(v[0])], int(v[1]))
		"music":
			ui.set_music(String(v))
		"announce":
			main.announce(String(v[0]), String(v[1]))
		"waves":
			sim.waves_on = bool(v)
		"duel":
			if not sim.duel_on:
				sim.duel_no = 0
				sim.start_duel()
		"ping":
			main.minimap.ping(point(v), Color(1, 0.85, 0.3), me().team)
		"drain":
			drain = float(v)
		"rally":
			# 0.21: the Ward's AI heroes answer a call ("crystal": back to the Heartstone, "boss", "help") for
			# Sim.CMD_TIME seconds, like the player's own F1-F3 orders
			sim.command(me().team, String(v), point("core") if String(v) == "crystal" else me().champ.p)
		"surge":
			# [multiplier, seconds]: every monster on your road moves faster for a while
			var ar = my_ar()
			ar.surge = float(v[0])
			ar.surge_t = float(v[1])
		"boss_heal":
			# [kind, fraction of its health]
			for ar in sim.arenas:
				for mo in ar.mons:
					if not mo.dead and mo.kind == String(v[0]):
						mo.hp = minf(mo.max_hp, mo.hp + mo.max_hp * float(v[1]))
						sim.burst(ar, mo.p, Color(0.6, 1.0, 0.7), 30, 180)
		"boss_enrage":
			# [kind, multiplier]: harder and faster
			for mo in sim.arenas[0].mons + sim.arenas[1].mons:
				if not mo.dead and mo.kind == String(v[0]):
					mo.dps *= float(v[1])
					mo.spd *= sqrt(float(v[1]))
		"weaken":
			# [slot, multiplier]: a hero grows weaker (or stronger, above 1) mid-chapter
			var wc = sim.players[int(v[0])].champ
			wc.pow *= float(v[1])
			wc.hp_base *= float(v[1])
			sim.recalc_items(wc)
			wc.hp = minf(wc.hp, wc.max_hp)
			sim.burst(wc.ar, wc.p, Color(1.0, 0.6, 0.3) if float(v[1]) < 1.0 else Color(0.6, 0.9, 1.0), 40, 220)
		"hero_heal":
			var c = me().champ
			if not c.dead:
				c.hp = minf(c.max_hp, c.hp + c.max_hp * float(v))


# ---------------------------------------------------------------- objectives
func obj(id: String) -> Dictionary:
	for o in objs:
		if o["id"] == id:
			return o
	return {}


func obj_state(id: String) -> String:
	var o := obj(id)
	return "" if o.is_empty() else String(o["state"])


func _set_obj(id: String, st: String) -> void:
	var o := obj(id)
	if o.is_empty() or o["state"] != "active":
		return
	o["state"] = st
	o["hidden"] = false
	if st == "done":
		ui.objective_note("Bonus complete" if o.get("bonus", false) else "Objective complete", o["text"], true)
	else:
		ui.objective_fail(o["text"], o.get("bonus", false))
		if not o.get("bonus", false):
			lose_reason = "Objective failed: " + String(o["text"])
			finish("lose")


func _lane_clear() -> bool:
	var ar = my_ar()
	if not ar.spawn_q.is_empty():
		return false
	for mo in ar.mons:
		if not mo.dead and not mo.d.get("camp", false) and mo.spd > 0.0:
			return false
	return true


func progress_text(o: Dictionary) -> String:
	match String(o["kind"]):
		"survive":
			return "wave %d/%d" % [mini(sim.round_no, int(o["n"])), int(o["n"])]
		"kill":
			return "%d/%d" % [mini(int(o["count"]), int(o["n"])), int(o["n"])]
		"send":
			return "%d/%d" % [mini(int(o["count"]), int(o["n"])), int(o["n"])]
		"duel_win":
			var t := "%d/%d" % [duel_w, int(o["n"])]
			if o.has("lose"):
				t += ", lost %d/%d" % [duel_l, int(o["lose"])]
			return t
		"core_floor":
			var ar = my_ar()
			return "now %d%%" % roundi(ar.core_hp / ar.core_max * 100.0)
		"deadline", "before":
			return "wave %d/%d" % [sim.round_no, int(o["n"])]
		"level":
			return "level %d/%d" % [me().champ.lvl, int(o["n"])]
		"items", "core_up":
			return "%d/%d" % [mini(int(o["count"]), int(o["n"])), int(o["n"])]
		"channel":
			var best := 0.0
			for i in o["points"].size():
				if not o["lit"][i]:
					best = maxf(best, float(o["prog"][i]) / float(o.get("secs", 6.0)))
			var need := int(o.get("n", o["points"].size()))
			return "%d/%d%s" % [lit_count(o), need, ("  Â·  %d%%" % roundi(best * 100.0)) if best > 0.0 else ""]
	return ""


func _eval_objectives() -> void:
	var p = me()
	var ar = my_ar()
	for o in objs:
		if o["state"] != "active":
			continue
		match String(o["kind"]):
			"survive":
				# done once wave n is beaten (its road is clear), or at the latest when the next wave begins
				if sim.round_no > int(o["n"]) or (sim.round_no >= int(o["n"]) and _lane_clear()):
					_set_obj(o["id"], "done")
			"boss":
				if flags.has("boss_down:" + String(o["target"])):
					_set_obj(o["id"], "done")
			"kill":
				var tg: Array = o.get("target", [])
				var n := 0
				if tg.is_empty():
					n = kills_all
				else:
					for k in tg:
						n += int(kills.get(k, 0))
				o["count"] = n
				if n >= int(o["n"]):
					_set_obj(o["id"], "done")
				elif o.has("by_round") and sim.round_no >= int(o["by_round"]):
					_set_obj(o["id"], "failed")
			"core_floor":
				if ar.core_hp / ar.core_max < float(o["n"]):
					_set_obj(o["id"], "failed")
			"build":
				if p.tech >= int(o["n"]):
					_set_obj(o["id"], "done")
			"send":
				var total := 0
				for k in p.send_n:
					total += int(p.send_n[k])
				o["count"] = total
				if total >= int(o["n"]):
					_set_obj(o["id"], "done")
			"level":
				if p.champ.lvl >= int(o["n"]):
					_set_obj(o["id"], "done")
			"channel":
				o["count"] = lit_count(o)
				if lit_count(o) >= int(o.get("n", o["points"].size())):
					_set_obj(o["id"], "done")
			"items":
				o["count"] = p.champ.items.size()
				if p.champ.items.size() >= int(o["n"]):
					_set_obj(o["id"], "done")
			"core_up":
				o["count"] = p.core_buys
				if p.core_buys >= int(o["n"]):
					_set_obj(o["id"], "done")
			"protect":
				if flags.has("died:%d" % int(o["n"])):
					_set_obj(o["id"], "failed")
			"duel_win":
				if duel_w >= int(o["n"]):
					_set_obj(o["id"], "done")
				elif o.has("lose") and duel_l >= int(o["lose"]):
					_set_obj(o["id"], "failed")
			"duel_hp":
				if duel_best_hp > float(o["n"]):
					_set_obj(o["id"], "done")
			"deadline":
				if sim.round_no >= int(o["n"]):
					_set_obj(o["id"], "failed")
			"before":
				if sim.round_no >= int(o["n"]):
					_set_obj(o["id"], "failed")
			"camp":
				if camp_done:
					_set_obj(o["id"], "done")
			"flag":
				if flags.has(String(o["target"])):
					_set_obj(o["id"], "done")


func _check_end() -> void:
	if result != "":
		return
	for o in objs:
		if not o.get("bonus", false) and o["state"] != "done" and String(o["kind"]) != "deadline":
			return
	finish("win")


# The sim ended by itself (a Heartstone broke).
func on_sim_over() -> void:
	if result != "":
		return
	if sim.winner == me().team:
		for o in objs:
			if String(o["kind"]) == "destroy":
				o["state"] = "done"
		finish("win")
	else:
		lose_reason = "The Heartstone has fallen."
		finish("lose")


func finish(r: String) -> void:
	if result != "":
		return
	result = r
	if r == "win":
		for o in objs:
			if o["state"] == "active":
				var k := String(o["kind"])
				if k in ["core_floor", "deadline", "before", "protect"]:
					o["state"] = "done"
				elif k == "destroy":
					o["state"] = "done"
				elif o.get("bonus", false):
					o["state"] = "failed"
	sim.over = true
	if sim.winner < 0:
		sim.winner = me().team if r == "win" else 1 - me().team


func stars() -> int:
	if result != "win":
		return 0
	var s := 1
	for o in objs:
		if o.get("bonus", false) and o["state"] == "done":
			s += 1
	return mini(3, s)


# Flags this mission adds to the campaign (only kept on a win).
func new_flags() -> Dictionary:
	var out := {}
	for f in flags:
		if not Campaign.flags.has(f) and not String(f).begins_with("died:") and not String(f).begins_with("boss_down:"):
			out[f] = true
	return out
␀␀␀␀␀␀␀␀␀# Loads the 3D models (art/models3d/<name>.glb, exported from Blender by tools/blender/export_glb.py)
# and builds what the 3D view needs: one merged mesh per animated node with the game's materials,
# and every pose (walk/flap 0-2, wind-up 3, strike 4) as node transforms from art_src/models.json.
class_name Models3D
extends RefCounted

const DIR := "res://art/models3d/"
# (noise scale, ramp low, ramp high, bump) per surface kind, matching the Blender renderer
const TEX := {
	"plain": [4.0, 0.92, 1.04, 0.02], "skin": [6.0, 0.86, 1.06, 0.06], "cloth": [18.0, 0.8, 1.08, 0.12],
	"leather": [9.0, 0.75, 1.1, 0.15], "metal": [5.0, 0.82, 1.12, 0.05], "gold": [5.0, 0.85, 1.12, 0.04],
	"stone": [5.0, 0.62, 1.18, 0.45], "wood": [3.0, 0.7, 1.12, 0.25], "bark": [7.0, 0.55, 1.15, 0.6],
	"leaf": [11.0, 0.62, 1.22, 0.55], "fur": [26.0, 0.68, 1.14, 0.35], "bone": [6.0, 0.82, 1.06, 0.12],
	"scale": [10.0, 0.68, 1.16, 0.4], "slime": [3.0, 0.8, 1.2, 0.08], "crystal": [2.0, 0.85, 1.25, 0.05],
	"ghost": [4.0, 0.75, 1.25, 0.0], "dirt": [8.0, 0.65, 1.15, 0.4], "moss": [16.0, 0.65, 1.2, 0.5],
	"roof": [4.0, 0.75, 1.12, 0.3], "thatch": [30.0, 0.65, 1.15, 0.5], "rune": [4.0, 0.9, 1.1, 0.0],
}

static var _data := {}             # model name -> models.json entry
static var _templates := {}        # model name -> template dict (or {} when missing)
static var _merged := {}           # model name -> ArrayMesh of the whole model in pose 0
static var _shader: Shader
static var _shader_alpha: Shader
static var _shader_packed: Shader   # the unit shader reading its material from vertex attributes (see _pack)
static var _packed_mat: ShaderMaterial
static var lods := true             # build simplified LOD meshes for models (the viewport picks them by size)
static var _mats := {}


static func _ensure_data() -> void:
	if not _data.is_empty():
		return
	var txt := FileAccess.get_file_as_string("res://art_src/models.json")
	if txt == "":
		return
	var d = JSON.parse_string(txt)
	for m in d["models"]:
		_data[m["name"]] = m
	_shader = Shader.new()
	_shader_packed = Shader.new()
	_shader_alpha = Shader.new()
	_packed_mat = ShaderMaterial.new()
	_packed_mat.shader = _shader_packed
	_build_shaders()


static var cheap := false   # Low preset: one octave of surface noise instead of three (cheaper pixels)


static func set_cheap(on: bool) -> void:
	if on == cheap:
		return
	cheap = on
	if _shader != null:
		_build_shaders()


static func _build_shaders() -> void:
	# read the source rather than load() it: loading would compile the Forward+ version on Compatibility
	var code := FileAccess.get_file_as_string("res://shaders/unit3d.gdshader")
	if compat():
		# the Compatibility renderer has no per-instance uniforms: tints, skins and (0.26) the hit flash become
		# cached material variants there (_set_variant)
		code = code.replace("instance uniform", "uniform")
		# and no glow: use the hue-safe emission knee that stays below 1.0
		code = code.replace("#define HDR_EMIT\n", "\n")
	if cheap:
		code = code.replace("\treturn 0.55 * vnoise(p) + 0.3 * vnoise(p * 2.03 + 7.1) + 0.15 * vnoise(p * 4.1 + 3.3);", "\treturn vnoise(p);")
	_shader.code = code
	# packed: every opaque material of a model node merged into one surface; the per-material values ride
	# in CUSTOM0 (albedo, noise scale), CUSTOM1 (lo, hi, bump, rough) and CUSTOM2 (metal, emit)
	var pk := code
	for u in ["uniform vec3 albedo : source_color = vec3(0.7);", "uniform float lo = 0.9;", "uniform float hi = 1.05;", "uniform float nscale = 4.0;",
			"uniform float bump = 0.0;", "uniform float rough = 0.7;", "uniform float metal = 0.0;", "uniform float emit = 0.0;"]:
		var parts: PackedStringArray = u.split(" ")
		pk = pk.replace(u, "varying flat %s %s;" % [parts[1], parts[2]])
	pk = pk.replace("void vertex() {\n\topos = VERTEX;", "void vertex() {\n\topos = VERTEX;\n\talbedo = CUSTOM0.rgb;\n\tnscale = CUSTOM0.a;\n\tlo = CUSTOM1.r;\n\thi = CUSTOM1.g;\n\tbump = CUSTOM1.b;\n\trough = CUSTOM1.a;\n\tmetal = CUSTOM2.r;\n\temit = CUSTOM2.g;")
	_shader_packed.code = pk
	_shader_alpha.code = code.replace("//ALPHA", "ALPHA = tint.a * alpha;").replace("uniform float rim = 0.25;", "uniform float rim = 0.25;\nuniform float alpha = 1.0;").replace("depth_draw_opaque", "depth_draw_never")


static func data(name: String) -> Dictionary:
	_ensure_data()
	return _data.get(name, {})


static func exists(name: String) -> bool:
	return ResourceLoader.exists(DIR + name + ".glb")


# Blender (x, y, z) with Z up -> Godot (x, z, -y) with Y up.
static func conv(a: Array) -> Transform3D:
	var bx := Vector3(a[0], a[4], a[8])
	var by := Vector3(a[1], a[5], a[9])
	var bz := Vector3(a[2], a[6], a[10])
	var t := Vector3(a[3], a[7], a[11])
	var cv := func(v: Vector3) -> Vector3: return Vector3(v.x, v.z, -v.y)
	# columns of the converted basis: C * M * C^-1 applied to the Godot axes
	var gx: Vector3 = cv.call(bx)
	var gy: Vector3 = cv.call(bz)
	var gz: Vector3 = -cv.call(by)
	return Transform3D(Basis(gx, gy, gz), cv.call(t))


static func material(model: String, key: String) -> Material:
	var md := data(model)
	var mats: Dictionary = md.get("mats", {})
	var p: Dictionary = mats.get(key, {})
	var ck := JSON.stringify(p)
	if _mats.has(ck):
		return _mats[ck]
	var alpha := float(p.get("alpha", 1.0))
	var m := ShaderMaterial.new()
	m.shader = _shader_alpha if alpha < 0.999 else _shader
	var col: Array = p.get("col", [0.7, 0.7, 0.7])
	var tx: Array = TEX.get(String(p.get("tex", "plain")), TEX["plain"])
	m.set_shader_parameter("albedo", Color(col[0], col[1], col[2]))
	m.set_shader_parameter("nscale", tx[0] * 0.5)
	m.set_shader_parameter("lo", tx[1])
	m.set_shader_parameter("hi", tx[2])
	m.set_shader_parameter("bump", tx[3])
	m.set_shader_parameter("rough", float(p.get("rough", 0.7)))
	m.set_shader_parameter("metal", float(p.get("metal", 0.0)))
	m.set_shader_parameter("emit", float(p.get("emit", 0.0)))
	if alpha < 0.999:
		m.set_shader_parameter("alpha", alpha)
	if String(p.get("tex", "")) == "ghost":
		m.set_shader_parameter("emit", 0.5)
	_mats[ck] = m
	return m


static func _mat_key(model: String, mat: Material, md: Dictionary) -> String:
	var nm := mat.resource_name if mat != null else ""
	var dot := nm.rfind(".")
	if dot > 0 and nm.substr(dot + 1).is_valid_int():
		nm = nm.substr(0, dot)
	if nm.begins_with(model + "_"):
		var k := nm.substr(model.length() + 1)
		if md["mats"].has(k):
			return k
	# names from another model (shared materials): match by the tail
	for k in md["mats"]:
		if nm.ends_with("_" + k):
			return k
	return md["mats"].keys()[0] if not md["mats"].is_empty() else ""


# {"nodes": {nid: ArrayMesh}, "rest": {nid: Transform3D}, "poses": [{nid: Transform3D}], "md": Dictionary}
static func template(name: String) -> Dictionary:
	if _templates.has(name):
		return _templates[name]
	var md := data(name)
	var out := {}
	if md.is_empty() or not exists(name):
		_templates[name] = out
		return out
	var ps: PackedScene = load(DIR + name + ".glb")
	var root := ps.instantiate()
	var nodes := {}
	var rest := {}
	_collect(root, name, md, nodes, rest)
	root.free()
	var poses: Array = []
	for pw in md["pose_world"]:
		var d := {}
		for nid in pw:
			d[nid] = conv(pw[nid])
		poses.append(d)
	out = {"nodes": nodes, "rest": rest, "poses": poses, "md": md}
	_templates[name] = out
	return out


static func _collect(n: Node, model: String, md: Dictionary, nodes: Dictionary, rest: Dictionary) -> void:
	if n.name.begins_with("n_") and n is Node3D:
		var nid := String(n.name).substr(2)
		var surfs: Array = []   # [arrays, material]
		for ch in n.get_children():
			if ch is MeshInstance3D and ch.mesh != null:
				var mi: MeshInstance3D = ch
				for si in mi.mesh.get_surface_count():
					var arrays := mi.mesh.surface_get_arrays(si)
					if mi.transform != Transform3D.IDENTITY:
						var vs: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
						var ns = arrays[Mesh.ARRAY_NORMAL]
						for i in vs.size():
							vs[i] = mi.transform * vs[i]
						arrays[Mesh.ARRAY_VERTEX] = vs
						if ns != null:
							var nn: PackedVector3Array = ns
							for i in nn.size():
								nn[i] = (mi.transform.basis * nn[i]).normalized()
							arrays[Mesh.ARRAY_NORMAL] = nn
					arrays[Mesh.ARRAY_TANGENT] = null
					surfs.append([arrays, material(model, _mat_key(model, mi.mesh.surface_get_material(si), md))])
		var am := _pack(surfs, packable(model))
		if am.get_surface_count() > 0:
			nodes[nid] = am
		rest[nid] = (n as Node3D).transform
	for ch in n.get_children():
		_collect(ch, model, md, nodes, rest)


# Models whose surfaces are looked up by material elsewhere keep one surface per material
# (MonFx tints the summoned wolf's fur by swapping its body materials).
static func packable(model: String) -> bool:
	return not model.begins_with("sum_")


# 32-bit floats: half-float custom attributes misread on the Compatibility renderer (tested)
const CUSTOM_FMT := (Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM0_SHIFT) | (Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM1_SHIFT) | (Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM2_SHIFT)


# `unit` repeated n times (by doubling: a handful of appends per surface, not one per vertex).
static func _repeat(unit: PackedFloat32Array, n: int) -> PackedFloat32Array:
	if n <= 0:
		return PackedFloat32Array()
	var out := unit.duplicate()
	while out.size() < unit.size() * n:
		out.append_array(out)
	out.resize(unit.size() * n)
	return out


# Builds a node's mesh from [arrays, material] surfaces. Packed: all opaque unit-shader surfaces become one
# surface (one draw call instead of one per material) drawn by the packed shader, which reads each
# triangle's material values from its vertices; translucent ones stay separate. Then LODs are added.
static func _pack(surfs: Array, pack: bool) -> ArrayMesh:
	var out: Array = []
	var opaque: Array = []
	for sf in surfs:
		var m: Material = sf[1]
		if pack and m is ShaderMaterial and (m as ShaderMaterial).shader == _shader:
			opaque.append(sf)
		else:
			out.append([sf[0], m, 0])
	if not opaque.is_empty():
		var vs := PackedVector3Array()
		var ns := PackedVector3Array()
		var idx := PackedInt32Array()
		var c0 := PackedFloat32Array()
		var c1 := PackedFloat32Array()
		var c2 := PackedFloat32Array()
		for sf in opaque:
			var a: Array = sf[0]
			var m: ShaderMaterial = sf[1]
			var base := vs.size()
			var sv: PackedVector3Array = a[Mesh.ARRAY_VERTEX]
			vs.append_array(sv)
			if a[Mesh.ARRAY_NORMAL] != null:
				ns.append_array(a[Mesh.ARRAY_NORMAL])
			else:
				for i in sv.size():
					ns.append(Vector3.UP)
			var si = a[Mesh.ARRAY_INDEX]
			if si != null and (si as PackedInt32Array).size() > 0:
				for i in si:
					idx.append(base + i)
			else:
				for i in sv.size():
					idx.append(base + i)
			# a source_color uniform is linearised by Forward+ and used as is by Compatibility: match each
			var alb: Color = Color(m.get_shader_parameter("albedo"))
			if not compat():
				alb = alb.srgb_to_linear()
			var v0 := [alb.r, alb.g, alb.b, float(m.get_shader_parameter("nscale"))]
			var v1 := [float(m.get_shader_parameter("lo")), float(m.get_shader_parameter("hi")), float(m.get_shader_parameter("bump")), float(m.get_shader_parameter("rough"))]
			var v2 := [float(m.get_shader_parameter("metal")), float(m.get_shader_parameter("emit")), 0.0, 0.0]
			c0.append_array(_repeat(PackedFloat32Array(v0), sv.size()))
			c1.append_array(_repeat(PackedFloat32Array(v1), sv.size()))
			c2.append_array(_repeat(PackedFloat32Array(v2), sv.size()))
		var arr := []
		arr.resize(Mesh.ARRAY_MAX)
		arr[Mesh.ARRAY_VERTEX] = vs
		arr[Mesh.ARRAY_NORMAL] = ns
		arr[Mesh.ARRAY_INDEX] = idx
		arr[Mesh.ARRAY_CUSTOM0] = c0
		arr[Mesh.ARRAY_CUSTOM1] = c1
		arr[Mesh.ARRAY_CUSTOM2] = c2
		out.push_front([arr, _packed_mat, CUSTOM_FMT])
	if out.is_empty():
		return ArrayMesh.new()
	return _finish(out)


# The surfaces as one ArrayMesh. With lods on, simplified LOD index arrays (meshoptimizer, via ImporterMesh)
# are built on a worker thread and swapped into the same mesh when ready (poll_lods): the full mesh is
# unchanged, the renderer picks a coarser index list once a model is small on screen, and a new model never
# stalls the frame it first appears in.
static func _finish(list: Array) -> ArrayMesh:
	var am := ArrayMesh.new()
	for sf in list:
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, sf[0], [], {}, sf[2])
		am.surface_set_material(am.get_surface_count() - 1, sf[1])
	if lods and DisplayServer.get_name() != "headless":
		var job := {"mesh": am, "data": [], "out": []}
		for sf in list:
			job["data"].append([sf[0], sf[2]])
		job["task"] = WorkerThreadPool.add_task(_lod_job.bind(job), false, "model LODs")
		_lod_jobs.append(job)
	return am


static var _lod_jobs: Array = []


# Worker thread: plain arrays in, plain arrays out (no resources touch the RenderingServer here).
static func _lod_job(job: Dictionary) -> void:
	var im := ImporterMesh.new()
	for d in job["data"]:
		im.add_surface(Mesh.PRIMITIVE_TRIANGLES, d[0], [], {}, null, "", d[1])
	im.generate_lods(25.0, 60.0, [])
	var out: Array = []
	for i in im.get_surface_count():
		var ld := {}
		for l in im.get_surface_lod_count(i):
			ld[im.get_surface_lod_size(i, l)] = im.get_surface_lod_indices(i, l)
		out.append([im.get_surface_arrays(i), ld])
	job["out"] = out


# Main thread, once a frame (ArenaView): swaps finished LOD sets into their meshes.
static func poll_lods(budget := 6) -> void:
	var i := 0
	while i < _lod_jobs.size() and budget > 0:
		var job: Dictionary = _lod_jobs[i]
		if not WorkerThreadPool.is_task_completed(job["task"]):
			i += 1
			continue
		WorkerThreadPool.wait_for_task_completion(job["task"])
		_lod_jobs.remove_at(i)
		budget -= 1
		var am: ArrayMesh = job["mesh"]
		var out: Array = job["out"]
		if out.size() != am.get_surface_count():
			continue
		var mats: Array = []
		for si in am.get_surface_count():
			mats.append(am.surface_get_material(si))
		am.clear_surfaces()
		for si in out.size():
			am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, out[si][0], [], out[si][1], job["data"][si][1])
			am.surface_set_material(si, mats[si])


# The whole model as one mesh in its rest pose (for props drawn with MultiMesh).
static func merged(name: String) -> ArrayMesh:
	if _merged.has(name):
		return _merged[name]
	if ProcProps.overrides(name) or (not exists(name) and ProcProps.has(name)):
		_merged[name] = ProcProps.build(name)
		return _merged[name]
	var tp := template(name)
	if tp.is_empty():
		_merged[name] = null
		return null
	var pose: Dictionary = tp["poses"][0] if not tp["poses"].is_empty() else tp["rest"]
	# one surface for every packed (opaque) part of the model, one per translucent material
	var packed: Array = []
	var others: Array = []
	for nid in tp["nodes"]:
		var src: ArrayMesh = tp["nodes"][nid]
		var tr: Transform3D = pose.get(nid, tp["rest"].get(nid, Transform3D.IDENTITY))
		for si in src.get_surface_count():
			var arrays := src.surface_get_arrays(si)
			var vs: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
			for i in vs.size():
				vs[i] = tr * vs[i]
			arrays[Mesh.ARRAY_VERTEX] = vs
			var ns = arrays[Mesh.ARRAY_NORMAL]
			if ns != null:
				var nn: PackedVector3Array = ns
				for i in nn.size():
					nn[i] = (tr.basis * nn[i]).normalized()
				arrays[Mesh.ARRAY_NORMAL] = nn
			var m := src.surface_get_material(si)
			if m == _packed_mat:
				packed.append(arrays)
			else:
				others.append([arrays, m, 0])
	var list: Array = []
	if not packed.is_empty():
		list.append([_concat(packed), _packed_mat, CUSTOM_FMT])
	list.append_array(others)
	var am: ArrayMesh = _finish(list) if not list.is_empty() else ArrayMesh.new()
	_merged[name] = am
	return am


# Joins packed surfaces (vertex, normal, index, CUSTOM0-2) into one.
static func _concat(list: Array) -> Array:
	var out := []
	out.resize(Mesh.ARRAY_MAX)
	var vs := PackedVector3Array()
	var ns := PackedVector3Array()
	var idx := PackedInt32Array()
	var cs := [PackedFloat32Array(), PackedFloat32Array(), PackedFloat32Array()]
	for a in list:
		var base := vs.size()
		vs.append_array(a[Mesh.ARRAY_VERTEX])
		ns.append_array(a[Mesh.ARRAY_NORMAL])
		var ia: PackedInt32Array = a[Mesh.ARRAY_INDEX]
		for i in ia:
			idx.append(base + i)
		for k in 3:
			cs[k].append_array(a[Mesh.ARRAY_CUSTOM0 + k])
	out[Mesh.ARRAY_VERTEX] = vs
	out[Mesh.ARRAY_NORMAL] = ns
	out[Mesh.ARRAY_INDEX] = idx
	out[Mesh.ARRAY_CUSTOM0] = cs[0]
	out[Mesh.ARRAY_CUSTOM1] = cs[1]
	out[Mesh.ARRAY_CUSTOM2] = cs[2]
	return out


# A posable instance: a Node3D with one MeshInstance3D per animated node.
static func instance(name: String) -> Node3D:
	var tp := template(name)
	var root := Node3D.new()
	if tp.is_empty():
		var mi := MeshInstance3D.new()
		var cap := CapsuleMesh.new()
		cap.radius = 0.35
		cap.height = 1.6
		mi.mesh = cap
		mi.position = Vector3(0, 0.8, 0)
		root.add_child(mi)
		root.set_meta("parts", {})
		return root
	var parts := {}
	for nid in tp["nodes"]:
		var mi := MeshInstance3D.new()
		mi.mesh = tp["nodes"][nid]
		mi.transform = tp["poses"][0].get(nid, tp["rest"].get(nid, Transform3D.IDENTITY)) if not tp["poses"].is_empty() else tp["rest"][nid]
		root.add_child(mi)
		parts[nid] = mi
	root.set_meta("parts", parts)
	root.set_meta("model", name)
	return root


# Poses an instance between two poses (f = 0..1).
static func pose(inst: Node3D, p0: int, p1: int, f: float) -> void:
	var tp := template(String(inst.get_meta("model", "")))
	if tp.is_empty() or tp["poses"].is_empty():
		return
	var poses: Array = tp["poses"]
	p0 = clampi(p0, 0, poses.size() - 1)
	p1 = clampi(p1, 0, poses.size() - 1)
	var a: Dictionary = poses[p0]
	var b: Dictionary = poses[p1]
	var parts: Dictionary = inst.get_meta("parts")
	for nid in parts:
		if a.has(nid):
			var ta: Transform3D = a[nid]
			parts[nid].transform = ta if p0 == p1 or not b.has(nid) else ta.interpolate_with(b[nid], f)


static func compat() -> bool:
	return RenderingServer.get_rendering_device() == null


static func set_param(inst: Node3D, pname: String, v) -> void:
	if compat():
		if pname == "flash":
			# 0.26: the hit flash reaches Compatibility too, in half steps (0, 0.5, 1, 1.5) so the cached variant
			# materials stay few; nothing is rebuilt per hit once a model has flashed once
			v = snappedf(clampf(float(v), 0.0, 1.5), 0.5)
			var cur: Dictionary = inst.get_meta("variant", {})
			if float(cur.get("flash", 0.0)) == float(v):
				return
		if pname in VARIANT_PARAMS:
			_set_variant(inst, pname, v)
		return
	for mi in inst.get_children():
		if mi is GeometryInstance3D:
			mi.set_instance_shader_parameter(pname, v)


# ---------------------------------------------------------------- colour variants in Compatibility
# Compatibility has no per-instance uniforms (tint/skin become plain material uniforms), so a variant
# (a tinted monster, a hero skin, the grey wave tint) gets its own cached duplicate of each material
# with those uniforms set, keyed by base material and variant values, applied as surface overrides.
const VARIANT_PARAMS := ["tint", "skin", "skin2", "flash"]
static var _variant_mats := {}


static func _set_variant(inst: Node3D, pname: String, v) -> void:
	var vs: Dictionary = inst.get_meta("variant", {}).duplicate()
	vs[pname] = v
	inst.set_meta("variant", vs)
	var vkey := ""
	for k in VARIANT_PARAMS:
		if vs.has(k):
			vkey += "%s=%s;" % [k, str(vs[k])]
	for mi in inst.get_children():
		if not (mi is MeshInstance3D) or mi.mesh == null:
			continue
		var mesh: Mesh = mi.mesh
		for si in mesh.get_surface_count():
			var base: Material = mesh.surface_get_material(si)
			if not (base is ShaderMaterial):
				continue
			mi.set_surface_override_material(si, _variant_mat(base, vs, vkey))


static func _variant_mat(base: ShaderMaterial, vs: Dictionary, vkey: String) -> ShaderMaterial:
	var ck := "%d|%s" % [base.get_instance_id(), vkey]
	if _variant_mats.has(ck):
		return _variant_mats[ck]
	var m: ShaderMaterial = base.duplicate()
	for k in vs:
		m.set_shader_parameter(k, vs[k])
	_variant_mats[ck] = m
	return m


# ---------------------------------------------------------------- boss mark
# Bosses built on a regular monster model (campaign bosses) get a glowing ground ring with outward tines in their
# colour, so they read as bosses like the dedicated boss models (which carry their own ring or crown).
# Kept in a plain Node3D so set_param / variant code (direct GeometryInstance3D children only) never touch it.
static func boss_mark(inst: Node3D, col: Color) -> void:
	var e := extent(String(inst.get_meta("model", "")))
	var r := maxf(0.9, maxf(e.x, e.z) * 0.55)
	var holder := Node3D.new()
	holder.name = "boss_mark"
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.albedo_color = col.lerp(Color.WHITE, 0.25)
	var ring := MeshInstance3D.new()
	var tm := TorusMesh.new()
	tm.inner_radius = r - 0.06
	tm.outer_radius = r + 0.06
	tm.rings = 48
	tm.ring_segments = 6
	ring.mesh = tm
	ring.material_override = mat
	ring.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	ring.scale = Vector3(1.0, 0.3, 1.0)
	ring.position.y = 0.04
	holder.add_child(ring)
	var pm := PrismMesh.new()
	pm.size = Vector3(0.22, 0.34, 0.05)
	for i in 8:
		var a := TAU * i / 8.0
		var t := MeshInstance3D.new()
		t.mesh = pm
		t.material_override = mat
		t.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		# lying flat, pointing outward from the ring
		t.transform = Transform3D(Basis(Vector3.UP, -(a + PI / 2)) * Basis(Vector3.RIGHT, -PI / 2), Vector3(cos(a) * (r + 0.2), 0.05, sin(a) * (r + 0.2)))
		holder.add_child(t)
	inst.add_child(holder)


# ---------------------------------------------------------------- footprint
static var _ext := {}


# Size (model units) of the model's bounding box in its level pose (pose 1: wings spread flat for flyers).
static func extent(name: String) -> Vector3:
	if _ext.has(name):
		return _ext[name]
	var tp := template(name)
	var out := Vector3.ZERO
	if not tp.is_empty():
		var poses: Array = tp["poses"]
		var pose: Dictionary = poses[mini(1, poses.size() - 1)] if not poses.is_empty() else tp["rest"]
		var box := AABB()
		var first := true
		for nid in tp["nodes"]:
			var tr: Transform3D = pose.get(nid, tp["rest"].get(nid, Transform3D.IDENTITY))
			var bb: AABB = tr * (tp["nodes"][nid] as ArrayMesh).get_aabb()
			box = bb if first else box.merge(bb)
			first = false
		out = box.size
	_ext[name] = out
	return out
␀␀␀␀# Monster effects in 3D (MONFX): a hand-built projectile model per monster family (art/fx3d/mfx_*.glb, specs in
# tools/handmade/specs/mfx_*.py, catalogue tools/handmade/mfx_catalog.py) with a particle trail, an impact burst
# on the hero, a splash crater, per-family summon and blink marks (grave, egg burst, void tear, burrow...) and a
# hovering chevron over boss dive warnings. Also tints hero summon wolves toward their hero's colour.
# The shared ground telegraph style (delayed blasts and monster warnings) is drawn by telegraph() into the
# ground decal layer (ArenaView.draw_under). View only: nothing here changes the game.
#
# Placement follows FxModels (scripts/fx_models.gd): models come from FxModels.mesh(), faded by scale.

extends Node3D

const K3 := 1.0 / 30.0
const FxM := preload("res://scripts/fx_models.gd")

# monster kind -> projectile model
const PROJ := {
	"archer": "mfx_bonearrow",
	"slinger": "mfx_stone", "gargoyle": "mfx_stone", "ancient_guard": "mfx_stone",
	"ancient": "mfx_boulder",
	"ice_el": "mfx_frostshard", "boss_lich": "mfx_frostshard", "boss_rime_colossus": "mfx_frostshard",
	"storm_el": "mfx_spark", "boss_wyrm": "mfx_spark", "echo_wyrm": "mfx_spark",
	"drake": "mfx_fireglob", "chimera": "mfx_fireglob", "elder": "mfx_fireglob",
	"wyvern": "mfx_venom", "basilisk": "mfx_venom",
	"necro": "mfx_hexbolt",
	"banshee": "mfx_wail",
	"void_priest": "mfx_voidorb", "star_eater": "mfx_voidorb", "dread_lord": "mfx_voidorb", "boss_herald": "mfx_voidorb",
	"boss_choirmaster": "mfx_holybolt", "boss_hollow_king": "mfx_holybolt",
}
# model -> [spin axis ("" none, x, y), trail particle size, trail colour (null: the projectile's colour)]
const PROJ_LOOK := {
	"mfx_bonearrow": ["", 0.8, Color("#e8f0d0")], "mfx_stone": ["x", 0.9, Color("#a89a84")],
	"mfx_boulder": ["y", 1.5, Color("#8a7a64")], "mfx_frostshard": ["x", 1.0, Color("#cdf2ff")],
	"mfx_spark": ["x", 1.0, Color("#bfe0ff")], "mfx_fireglob": ["", 1.5, Color("#ff8a30")],
	"mfx_venom": ["", 1.0, Color("#9cff3a")], "mfx_hexbolt": ["", 1.0, Color("#8cff7a")],
	"mfx_wail": ["", 1.0, Color("#c8f4ff")], "mfx_voidorb": ["x", 1.2, Color("#b080ff")],
	"mfx_holybolt": ["", 1.3, Color("#ffe8a0")],
}
# what a spawner's brood climbs out of
const SUMMON := {
	"minion": "mfx_grave", "skeleton": "mfx_grave",
	"spider": "mfx_eggburst",
	"voidling": "mfx_voidtear", "shade": "mfx_voidtear", "rift_spawn": "mfx_voidtear",
	"ashborn": "mfx_ashvent", "pale_acolyte": "mfx_ashvent", "cinder_hound": "mfx_ashvent",
	"ice_el": "mfx_icespire",
}
const SUMMON_COL := {"mfx_grave": Color("#8cff7a"), "mfx_eggburst": Color("#c8a0ff"), "mfx_voidtear": Color("#b080ff"),
	"mfx_ashvent": Color("#ff8a3a"), "mfx_icespire": Color("#cdf2ff")}
const PROJ_SCALE := 1.9        # models are ~1 m; the old orbs were 0.27 m (0.47 m with splash)

var fx3d: FxLayer = null        # for its pooled hit sparks and particle helpers
var _live := {}                 # MProj -> {"mi", "trail", "p", "h0", "d0", "spin", "model", "col", "tgt", "splash"}
var _warn := {}                 # mpend dict id -> MeshInstance3D (dive chevrons)
var _timed: Array = []          # [MeshInstance3D, t left, opts]
var _tint_mats := {}            # "col|key" -> ShaderMaterial (summon wolf tint)
var splashes: Array = []        # [world pos, radius, colour, t left] ground rings for the decal layer
static var _flat := {}          # colour html -> StandardMaterial3D (tinted impact models)


static func proj_model(pr) -> String:
	var id: String = PROJ.get(String(pr.kind), "")
	if id == "" and String(pr.kind) != "":
		id = "mfx_voidorb" if pr.col.b > pr.col.g else "mfx_stone"
	return id if FxM.exists(id) else ""


var _pool := {}                 # model id -> hidden MeshInstance3D ready for reuse
var _trail_pool: Array = []     # idle trail emitters
var _trail_wait: Array = []     # [CPUParticles3D, seconds until its last motes are gone]


func _inst(id: String, mat: Material = null) -> MeshInstance3D:
	var m := FxM.mesh(id)
	if m == null:
		return null
	var mi: MeshInstance3D = null
	var free: Array = _pool.get(id, [])
	if not free.is_empty():
		mi = free.pop_back()
		mi.remove_meta("pooled")
		mi.visible = true
	else:
		mi = MeshInstance3D.new()
		mi.mesh = m
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		mi.set_meta("id", id)
		add_child(mi)
	mi.material_override = mat
	return mi


func _release(mi) -> void:
	if not is_instance_valid(mi) or mi.has_meta("pooled"):
		return
	mi.visible = false
	mi.set_meta("pooled", true)
	var id := String(mi.get_meta("id", ""))
	if not _pool.has(id):
		_pool[id] = []
	_pool[id].append(mi)


static func flat(col: Color) -> StandardMaterial3D:
	var k := col.to_html()
	if _flat.has(k):
		return _flat[k]
	var m := StandardMaterial3D.new()
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.albedo_color = col.lerp(Color.WHITE, 0.25)
	_flat[k] = m
	return m


static func v3(p: Vector2, h := 0.0) -> Vector3:
	return Vector3(p.x * K3, (h + Sim.deck_h(p)) * K3, p.y * K3)   # heights from a bridge deck where there is one


# o: {"pos", "rot", "s": Vector3, "spin", "sink", "rise": metres risen over the life}
func _play(id: String, o: Dictionary, life: float, mat: Material = null) -> void:
	var mi := _inst(id, mat)
	if mi == null:
		return
	o["life"] = life
	_timed.append([mi, life, o])
	_pose(mi, life, o)


func _pose(mi: MeshInstance3D, t: float, o: Dictionary) -> void:
	var life: float = o["life"]
	var age := life - t
	var s: Vector3 = o.get("s", Vector3.ONE)
	var k_in := clampf(age / float(o.get("grow", 0.12)), 0.0, 1.0)
	var k_out := clampf(t / maxf(0.05, life * 0.35), 0.0, 1.0)
	var g := (0.3 + 0.7 * ease(k_in, 0.4)) * (0.2 + 0.8 * k_out)
	var pos: Vector3 = o["pos"]
	if o.get("sink", false):
		pos.y -= (1.0 - k_out) * s.y * 0.6
	pos.y += float(o.get("rise", 0.0)) * (age / life)
	var rot: float = o.get("rot", 0.0) + age * float(o.get("spin", 0.0))
	mi.transform = Transform3D(Basis(Vector3.UP, rot).scaled(s * g), pos)
	mi.visible = g > 0.001


# ---------------------------------------------------------------- per frame (call before FxLayer.sync)
func sync(ar, delta: float, view = null) -> void:
	delta = minf(delta, 0.05)
	_sync_projs(ar, delta)
	_sync_specials(ar)
	_sync_warn(ar)
	if view != null:
		_tint_summons(ar, view)
	var keep: Array = []
	for it in _timed:
		var mi: MeshInstance3D = it[0]
		if not is_instance_valid(mi):
			continue
		it[1] -= delta
		if it[1] <= 0:
			_release(mi)
			continue
		_pose(mi, it[1], it[2])
		keep.append(it)
	_timed = keep
	var sk: Array = []
	for r in splashes:
		r[3] -= delta
		if r[3] > 0:
			sk.append(r)
	splashes = sk
	var tw: Array = []
	for w in _trail_wait:
		w[1] -= delta
		if w[1] <= 0.0:
			_trail_pool.append(w[0])
		else:
			tw.append(w)
	_trail_wait = tw


func _sync_projs(ar, delta: float) -> void:
	var seen := {}
	for pr in ar.mprojs:
		var id := proj_model(pr)
		if id == "":
			continue
		seen[pr] = true
		var L: Dictionary = _live.get(pr, {})
		if L.is_empty():
			var mi := _inst(id)
			if mi == null:
				continue
			var look: Array = PROJ_LOOK.get(id, ["", 1.0, null])
			var md: Dictionary = GameData.MON.get(String(pr.kind), {})
			var big := clampf(0.85 + float(md.get("r", 10)) / 40.0, 1.0, 1.6)
			if pr.splash > 0:
				big = maxf(big, 1.3)
			var d0: float = maxf(1.0, pr.p.distance_to(pr.tgt.p)) if pr.tgt != null else 1.0
			L = {"mi": mi, "model": id, "spin": look[0], "big": big, "a": 0.0, "d0": d0,
				"h0": 66.0 if md.get("fly", false) else 40.0, "col": pr.col, "tgt": pr.tgt, "splash": pr.splash}
			if fx3d != null:
				var tc: Color = look[2] if look[2] != null else pr.col
				var tp: CPUParticles3D = null
				if not _trail_pool.is_empty():
					tp = _trail_pool.pop_back()
				else:
					tp = fx3d._sparks(self, tc, 22, 0.4, false, {"er": 0.06, "v0": 0.1, "v1": 0.5, "grav": Vector3(0, 0.5, 0), "s0": 0.14, "s1": 0.3})
					tp.speed_scale = 1.0
				tp.emitting = false
				fx3d.tint(tp, tc)
				var sz: float = float(look[1]) * big
				tp.scale_amount_min = 0.14 * sz
				tp.scale_amount_max = 0.32 * sz
				L["trail"] = tp
			_live[pr] = L
		var mi: MeshInstance3D = L["mi"]
		var dir := Vector2.RIGHT
		if pr.tgt != null:
			dir = pr.tgt.p - pr.p
		var d := dir.length()
		var ang := dir.angle() if d > 0.5 else 0.0
		# height: from the shooter's muzzle down to the hero's chest as it closes in
		var u := clampf(d / float(L["d0"]), 0.0, 1.0)
		var h: float = lerpf(30.0, float(L["h0"]), u)
		var b := Basis(Vector3.UP, -ang)
		var sp: String = L["spin"]
		if sp != "":
			L["a"] = float(L["a"]) + delta * 12.0
			b = b * Basis(Vector3.RIGHT if sp == "x" else Vector3.BACK, float(L["a"]))
		var pos := v3(pr.p, h)
		mi.transform = Transform3D(b.scaled(Vector3.ONE * PROJ_SCALE * float(L["big"])), pos)
		L["p"] = pr.p
		if L.has("trail"):
			var tp: CPUParticles3D = L["trail"]
			if not tp.emitting:
				tp.position = pos
				tp.restart()
			tp.position = pos
			tp.emitting = true
	for pr in _live.keys():
		if seen.has(pr):
			continue
		var L: Dictionary = _live[pr]
		_live.erase(pr)
		_release(L["mi"])
		if L.has("trail") and is_instance_valid(L["trail"]):
			var tp: CPUParticles3D = L["trail"]
			tp.emitting = false
			_trail_wait.append([tp, 0.6])
		# landed on its hero: a burst on the hero and, for splash shots, a crater ring on the ground
		var tg = L["tgt"]
		if tg == null or tg.dead or not L.has("p"):
			continue
		var at: Vector2 = tg.p
		if at.distance_to(L["p"]) > 80.0:
			continue
		var col: Color = L["col"]
		var big: float = L["big"]
		_play("mfx_impact", {"pos": v3(at, 30), "s": Vector3.ONE * 0.9 * big, "rot": randf() * TAU, "spin": 4.0, "grow": 0.06}, 0.32, flat(col))
		if fx3d != null:
			fx3d.hit(at, (at - Vector2(L["p"])).normalized() if at != L["p"] else Vector2.RIGHT, false, 30.0)
		var spl: float = L["splash"]
		if spl > 0:
			var s := spl * K3
			_play("mfx_splash", {"pos": v3(at, 1), "s": Vector3(s, clampf(s * 0.8, 0.8, 1.6), s), "rot": randf() * TAU, "sink": true, "grow": 0.1}, 0.7, flat(col))
			splashes.append([at, spl, col, 0.55])


func _sync_specials(ar) -> void:
	for e in ar.fx:
		if not e.has("mfx") or e.has("_v3"):
			continue
		# claim the dict so FxLayer doesn't draw its generic ring (it skips dicts it has "already shown")
		e["_v3"] = null
		var p: Vector2 = e["p"]
		var mk := String(e.get("mk", ""))
		match String(e["mfx"]):
			"summon":
				var id: String = SUMMON.get(mk, "mfx_grave")
				var tall := id == "mfx_voidtear"
				var s := 1.05 if tall else 1.2
				_play(id, {"pos": v3(p), "s": Vector3.ONE * s, "rot": randf() * TAU, "sink": not tall, "grow": 0.18}, 1.3)
				if fx3d != null:
					fx3d.hit(p, Vector2.UP, false, 8.0)
			"blink":
				var id := "mfx_burrow" if mk == "wurm" else "mfx_voidtear"
				var md: Dictionary = GameData.MON.get(mk, {})
				var s := clampf(float(md.get("r", 16)) / 16.0, 0.9, 1.6)
				if id == "mfx_voidtear":
					s *= 0.85
				_play(id, {"pos": v3(p), "s": Vector3.ONE * s, "rot": randf() * TAU, "sink": id == "mfx_burrow", "grow": 0.1}, 0.9)
				if fx3d != null:
					fx3d.hit(p, Vector2.UP, false, 6.0)


# boss dives: chevrons hovering over the circle, dropping and quickening as the strike nears
func _sync_warn(ar) -> void:
	var seen := {}
	for b in ar.mpend:
		# the warning dicts change as they count down, so tag each with a view-only id
		var key := int(b.get("_mfx_id", 0))
		if key == 0:
			key = randi() | 1
			b["_mfx_id"] = key
		seen[key] = true
		var mi = _warn.get(key)
		if mi == null or not is_instance_valid(mi):
			mi = _inst("mfx_divemark")
			if mi == null:
				continue
			_warn[key] = mi
		var dur: float = maxf(0.05, float(b["dur"]))
		var k := 1.0 - float(b["t"]) / dur
		var r: float = b["r"]
		var s := clampf(r / 80.0, 1.2, 2.2)
		var bob := sin(k * (10.0 + 30.0 * k)) * 0.12
		var h := lerpf(2.8, 0.5, k * k) + bob
		mi.transform = Transform3D(Basis(Vector3.UP, k * 6.0).scaled(Vector3.ONE * s * (0.6 + 0.4 * clampf(k * 4.0, 0.0, 1.0))), v3(b["p"]) + Vector3(0, h, 0))
	for key in _warn.keys():
		if not seen.has(key):
			_release(_warn[key])
			_warn.erase(key)


# hero summon wolves: the spirit's fur shifts toward the owner's colour (Compatibility has no per-instance
# uniforms, so the wolf gets its own surface materials per hero colour)
func _tint_summons(ar, view) -> void:
	for su in ar.sums:
		if su.name != "Wolf" or su.c == null:
			continue
		var inst = view.pool.get(su)
		if inst == null or inst.has_meta("mfx_tint"):
			continue
		inst.set_meta("mfx_tint", true)
		var hc := Color(String(su.c.def.get("color", "#79b8ff")))
		var src := {}
		for key in ["body", "belly", "dark"]:
			src[Models3D.material("sum_wolf", key)] = key
		for mi in inst.get_children():
			if not (mi is MeshInstance3D) or mi.mesh == null:
				continue
			for si in mi.mesh.get_surface_count():
				var m = mi.mesh.surface_get_material(si)
				if not src.has(m):
					continue
				var ck := "%s|%s" % [hc.to_html(), src[m]]
				if not _tint_mats.has(ck):
					var nm: ShaderMaterial = (m as ShaderMaterial).duplicate()
					var base: Color = nm.get_shader_parameter("albedo")
					nm.set_shader_parameter("albedo", base.lerp(hc, 0.38 if src[m] != "belly" else 0.2))
					_tint_mats[ck] = nm
				mi.set_surface_override_material(si, _tint_mats[ck])


func clear() -> void:
	for ch in get_children():
		ch.queue_free()
	_pool.clear()
	_trail_pool.clear()
	_trail_wait.clear()
	_live.clear()
	_warn.clear()
	_timed.clear()
	splashes.clear()


# ---------------------------------------------------------------- ground decals (ArenaView.draw_under)
# One telegraph style for hero delayed blasts and monster warnings: a dark ring under a bright ring, a disc
# filling from the centre and a wedge sweeping round as the countdown runs. k = 0 at the start, 1 at the blast.
static func telegraph(ci: CanvasItem, p: Vector2, r: float, k: float, col: Color, strong := true, tt := 0.0) -> void:
	k = clampf(k, 0.0, 1.0)
	var bright := col.lerp(Color.WHITE, 0.15)
	if not strong:
		# small blasts (one of many): a light version so a shower doesn't bury the ground
		ci.draw_circle(p, r * k, Color(col, 0.16))
		ci.draw_arc(p, r, 0, TAU, 40, Color(0.05, 0.02, 0.02, 0.45), 4.0, true)
		ci.draw_arc(p, r, 0, TAU, 40, Color(bright, 0.75), 2.0, true)
		return
	var a := 1.0
	var danger := col.r > 0.9 and col.g < 0.4
	if danger:
		bright = col
	else:
		ci.draw_circle(p, r, Color(0.02, 0.01, 0.01, 0.22 * a))
	if k > 0.01:
		var pts := PackedVector2Array([p])
		var n := maxi(3, int(48 * k))
		var a0 := -PI / 2
		for i in n + 1:
			pts.append(p + Vector2.from_angle(a0 + TAU * k * i / n) * r * 0.97)
		ci.draw_colored_polygon(pts, Color(col, 0.2 * a))
		ci.draw_circle(p, r * k, Color(col, 0.26 * a))
		ci.draw_arc(p, r * k, 0, TAU, 48, Color(bright, 0.9 * a), 2.5, true)
		ci.draw_line(p, p + Vector2.from_angle(a0 + TAU * k) * r, Color(bright, 0.85 * a), 2.5, true)
	# the final moment: the outer ring thickens and pulses
	var urgent := clampf((k - 0.7) / 0.3, 0.0, 1.0)
	var w := 4.0 + 2.5 * urgent * (0.5 + 0.5 * sin(tt * 30.0))
	ci.draw_arc(p, r, 0, TAU, 64, Color(0.06, 0.02, 0.02, 0.8 * a), w + 6.0, true)
	ci.draw_arc(p, r, 0, TAU, 64, Color(bright, a), w, true)
	for i in 4:
		var ang := TAU * i / 4.0 + PI / 4
		ci.draw_line(p + Vector2.from_angle(ang) * (r - 12.0), p + Vector2.from_angle(ang) * (r + 4.0), Color(bright, a), 3.0, true)


func draw_decals(ci: CanvasItem, ar) -> void:
	# splash shots in flight: where the blast will land
	for pr in ar.mprojs:
		if pr.splash > 0 and pr.tgt != null and not pr.tgt.dead:
