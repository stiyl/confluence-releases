	v.mouse_filter = MOUSE_FILTER_IGNORE
	var nm := lbl(String(t["name"]) + ("  Â·  %d pts" % TalentData.cost(t) if TalentData.cost(t) > 1 else ""), 15, GOLD if has else (TEXT if can else MUTED), true)
	nm.mouse_filter = MOUSE_FILTER_IGNORE
	v.add_child(nm)
	var ds := lbl(String(t["desc"]), 12, TEXT if has or can else MUTED, true)
	ds.mouse_filter = MOUSE_FILTER_IGNORE
	v.add_child(ds)
	if not has and not can and int(t["tier"]) != 2:
		var wl := lbl(why, 11, Color(1.0, 0.6, 0.45), true)
		wl.mouse_filter = MOUSE_FILTER_IGNORE
		v.add_child(wl)
	b.add_child(v)
	b.tooltip_text = String(t["desc"]) + ("\n(taken: click to refund)" if has else ("\n" + why if why != "" else "\nClick to take"))
	var id: String = t["id"]
