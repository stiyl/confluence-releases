func _build_keys() -> void:
	_page = T_KEYS
	var hint: Label = main.lbl("Click a key, then press the new one. Esc cancels.", 13, UIParts.MUTED)
	hint.custom_minimum_size = Vector2(0, 28)
	hint.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	pages[_page].add_child(hint)
	var placed := {}
	for gi in KEY_GROUPS.size():
		for a in KEY_GROUPS[gi][1]:
			placed[a] = gi
	var names := {}
	for a in Settings.ACTIONS:
		names[a[0]] = a[1]
		if not placed.has(a[0]):
			placed[a[0]] = KEY_GROUPS.size() - 1   # a new action lands in Menus until it gets a group
	for gi in KEY_GROUPS.size():
		_section(KEY_GROUPS[gi][0])
		var grid := GridContainer.new()
		grid.columns = 2
		grid.add_theme_constant_override("h_separation", 24)
		grid.add_theme_constant_override("v_separation", 0)
		grid.size_flags_horizontal = SIZE_EXPAND_FILL
		pages[_page].add_child(grid)
		for a in Settings.ACTIONS:
			if placed[a[0]] != gi:
				continue
			var act: String = a[0]
			var cap := KeyCap.new()
			cap.pressed.connect(func():
				pending = {}
				main.rebinding = act
				search.release_focus()
				refresh())
			key_caps[act] = cap
			var r := _bind_cell(grid, String(names[act]), cap, "key bind hotkey")
			key_rows[act] = r
		# the inline conflict prompt for this group
		var cb: HBoxContainer = main.hbox(10)
		cb.visible = false
		var mc := MarginContainer.new()
		mc.add_theme_constant_override("margin_left", 12)
		mc.add_theme_constant_override("margin_top", 6)
		mc.add_theme_constant_override("margin_bottom", 6)
		mc.add_child(cb)
		mc.visible = false
		pages[_page].add_child(mc)
		var cl: Label = main.lbl("", 14, Color(1.0, 0.62, 0.5))
		cl.size_flags_vertical = SIZE_SHRINK_CENTER
		cb.add_child(cl)
		var sw := Button.new()
		sw.text = "Swap"
		sw.focus_mode = FOCUS_NONE
		sw.custom_minimum_size = Vector2(96, 32)
		sw.pressed.connect(func(): resolve(true))
		cb.add_child(sw)
		var cn := Button.new()
		cn.text = "Cancel"
		cn.focus_mode = FOCUS_NONE
		cn.custom_minimum_size = Vector2(96, 32)
		cn.pressed.connect(func(): resolve(false))
		cb.add_child(cn)
		cb.visible = true
		conflict[gi] = {"box": mc, "lbl": cl}
	main.set_key_btns = key_caps


# A cell of a two-column binding grid: the action's name and its keycap.
func _bind_cell(grid: GridContainer, title: String, cap: KeyCap, words: String) -> Row:
	var r := Row.new()
	r.page = _page
	r.base_words = ("%s %s" % [title, words]).to_lower()
	r.words = r.base_words
	r.size_flags_horizontal = SIZE_EXPAND_FILL
