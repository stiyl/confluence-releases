# 0.38.1: when the match HUD cannot fit the window at this scale it is drawn smaller; the row says how big it gets.
func _ui_scale_note() -> void:
	if ui_scale_row == null or main == null or not main.has_method("_layout_hud"):
		return
	main._layout_hud()
	var eff: int = roundi(main.hud_effective_scale() * 100.0)
	var capped: bool = eff < roundi(Settings.ui_scale * 100.0) - 1
	ui_scale_row.desc_lbl.text = ("Size of the menus and the HUD  Â·  HUD max %d%% at this window size" % eff) if capped else "Size of the menus and the HUD"
	ui_scale_row.desc_lbl.tooltip_text = "The match HUD (minimap, hero panel, items, abilities) needs a wider view at this scale, so it is drawn at %d%%. The menus use the full scale." % eff if capped else ""


