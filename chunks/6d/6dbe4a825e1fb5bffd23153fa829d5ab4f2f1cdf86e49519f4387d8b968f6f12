static func _lobby_from_args(args) -> int:
	var i: int = Array(args).find("+connect_lobby")
	if i >= 0 and i + 1 < args.size() and String(args[i + 1]).is_valid_int():
		return int(args[i + 1])
	return 0


func steam_available() -> bool:
	return steam_ok


# 0.32: true when this pck ships GodotSteam for this platform (Windows, Linux x86_64, macOS) in an exported game
# but the Steam singleton didn't load: the game folder predates Steam (the updater only replaces the pck, it can't
# add the native libraries). The game runs normally; the menu shows a one-time "Download the new zip" note.
static func steam_libs_expected() -> bool:
	if not OS.has_feature("template") or Engine.has_singleton("Steam"):
		return false
	if not FileAccess.file_exists("res://addons/godotsteam/godotsteam.gdextension"):
		return false
	var plat := OS.get_name()
	return plat == "Windows" or plat == "macOS" or (plat == "Linux" and Engine.get_architecture_name() == "x86_64")


func host_steam() -> void:
	if not steam_ok:
		_fail("Steam isn't running, or the GodotSteam extension isn't installed.")
