# Your Steam friends (FRIEND_FLAG_IMMEDIATE): [{"id", "name", "state", "online", "in_game"}], online first.
# Empty when Steam isn't running or GodotSteam isn't installed.
const STEAM_STATES := ["Offline", "Online", "Busy", "Away", "Snooze", "Looking to trade", "Looking to play"]
func steam_friends() -> Array:
	var out: Array = []
	if not steam_ok or steam == null or not steam.has_method("getFriendCount"):
		return out
	var app_id := int(steam.getAppID()) if steam.has_method("getAppID") else 0
	var n := int(steam.getFriendCount(4))
	for i in mini(n, 500):
		var fid := int(steam.getFriendByIndex(i, 4))
		if fid == 0:
			continue
		var st := int(steam.getFriendPersonaState(fid))
		var in_game := false
		if steam.has_method("getFriendGamePlayed"):
			var gp = steam.getFriendGamePlayed(fid)
			in_game = gp is Dictionary and app_id != 0 and int(gp.get("id", 0)) == app_id
		out.append({"id": fid, "name": String(steam.getFriendPersonaName(fid)), "state": STEAM_STATES[clampi(st, 0, 6)],
			"online": st != 0, "in_game": in_game})
	out.sort_custom(func(a, b):
		if a["in_game"] != b["in_game"]:
			return a["in_game"]
		if a["online"] != b["online"]:
			return a["online"]
		return String(a["name"]).nocasecmp_to(String(b["name"])) < 0)
	return out


# Invites a Steam friend to the Steam lobby you are in. False if there is no lobby (host one first).
