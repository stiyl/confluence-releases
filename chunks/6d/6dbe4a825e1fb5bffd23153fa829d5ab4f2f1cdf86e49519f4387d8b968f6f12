# 0.30: party members play together: single player (campaign, tutorial, modes) waits until you leave the party.
func _solo_ok() -> bool:
	if party != null and party.blocks_solo():
		notify("You're in a party: leave it (party bar, top right) to play on your own.")
		return false
	return true


# 0.30: a short line where the player is looking: the match's green line, or the menus' news plaque.
func notify(text: String) -> void:
	if game != null and game.visible and sim != null:
		show_good(text)
	elif party_ui != null:
		party_ui.news(text)


# 0.30: a chat line from outside the lobby (party chat, whispers): the match chat or the lobby chat shows it.
# always: also when neither is up (whispers fall back to the news plaque there; party lines live on the party bar).
func chat_feed(text: String, always: bool) -> void:
	if game != null and game.visible and sim != null:
		mp_chat.append([chat.clean(text), Time.get_ticks_msec()])
		while mp_chat.size() > 12:
			mp_chat.pop_front()
	elif lobby_ov != null and lobby_ov.visible:
		_lobby_chat_line(text)
	elif always and party_ui != null:
		party_ui.news(chat.clean(text), 5.0)


# 0.30: a whisper came in (or went out): match / lobby chat, else a toast (unless its window is open).
func _on_whisper(code: String, e: Dictionary) -> void:
	var who: String = chat.friend_name(code)
	var line := ""
	if bool(e.get("sys", false)):
		line = String(e.get("text", ""))
	elif bool(e.get("mine", false)):
		line = "[To %s] %s" % [who, String(e.get("text", ""))]
	else:
		line = "[From %s] %s" % [String(e.get("name", who)), String(e.get("text", ""))]
	if whisper_ui != null and whisper_ui.ov.visible and whisper_ui.with_code == chat.norm(code):
		return
	if bool(e.get("mine", false)) and not (game.visible or lobby_ov.visible):
		return
	chat_feed(line, true)


# 0.30: every chat box goes through the same commands (/p party, /w name whisper, /r reply).
func chat_submit(t: String) -> void:
	var back: String = chat.submit(t, func(x: String):
		if mp():
			net.say(x)
		elif party != null and party.active() and party.members.size() > 1:
			party.say(x))
	if back != "":
		chat_feed(back, true)


# 0.30: right-click a player (end screen, scoreboard): Add friend / Whisper / Invite to party / Block.
func player_menu(pid: int) -> void:
	if sim == null or pid < 0 or pid >= sim.players.size():
		return
	var pl = sim.players[pid]
	var fc := ""
	if pid < last_lineup.size() and mp_or_ended():
		fc = String(last_lineup[pid].get("fc", ""))
	var extra: Array = []
	if pid != sim.local and pl.human and pl.team == myt() and not sim.over:
		# 0.31: an ally's pings can be muted for the rest of the match
		extra.append(["Unmute pings" if ping_muted.has(pid) else "Mute pings from %s" % pl.name, func():
			if ping_muted.has(pid):
				ping_muted.erase(pid)
				notify("Showing %s's pings again." % pl.name)
			else:
				ping_muted[pid] = true
				notify("%s's pings are muted for this match." % pl.name)])
	whisper_ui.open_player_menu(pl.name, fc, pl.human and pid != sim.local and mp_or_ended(), Vector2(-1, -1), extra)


func mp_or_ended() -> bool:
	return not last_lineup.is_empty() and sim != null and sim == _online_sim


