		ci.draw_rect(Rect2(r.position + Vector2(2, 4), Vector2(3, r.size.y - 8)), Color(accent, accent.a * a))
	if studs:
		for p in [r.position, Vector2(r.end.x, r.position.y), Vector2(r.position.x, r.end.y), r.end]:
