# 0.33: this pck ships Steam, but the game folder came from an older zip (no native Steam libraries).
# 0.35.2: on Windows the updater now fetches them into the game folder and offers a restart; elsewhere (or if that
# fails) say once that a fresh download brings Steam. The game itself runs normally without them.
func _steam_zip_note() -> void:
	if net == null or not net.steam_libs_missing:
		return
	if Updater.enabled() and Updater.steam_libs_platform() != "":
		var pl := _steam_note_plaque("Getting Steam's files for this game folder...")
		updater.steam_libs_done.connect(func(ok: bool, msg: String):
			if not is_instance_valid(pl):
				return
			pl.queue_free()
			if ok:
				var p2 := _steam_note_plaque("Steam is ready: restart the game to turn it on.", "Restart")
				p2.set_meta("act", func(): if Updater.relaunch_same(): get_tree().quit())
			elif not Settings.steam_zip_note:
				_steam_note_plaque(msg + "\nDownload the new zip once for Steam support.", "OK", true), CONNECT_ONE_SHOT)
		updater.fetch_steam_libs()
		return
	if Settings.steam_zip_note:
		return
	_steam_note_plaque("Steam support is here: download the new zip for\nyour computer once to use it (the in-game update\ncan't add Steam's files).", "OK", true)


