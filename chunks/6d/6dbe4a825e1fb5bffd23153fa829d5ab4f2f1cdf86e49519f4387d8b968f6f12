# A small coloured chip for a synergy tag: "Fire 3/4". Lit when a tier is active.
func tag_chip(tag: String, text: String, lit: bool, size_px := 12) -> PanelContainer:
	var td: Dictionary = SurvivalData.TAGS[tag]
	return chip(text, Color(td["col"]), lit, size_px)


func chip(text: String, col: Color, lit: bool, size_px := 12) -> PanelContainer:
	var pc := PanelContainer.new()
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(col.darkened(0.55), 0.92) if lit else Color(0.08, 0.08, 0.1, 0.85)
	sb.border_color = col if lit else Color(col, 0.45)
	sb.set_border_width_all(1)
	sb.set_corner_radius_all(4)
	sb.content_margin_left = 7
	sb.content_margin_right = 7
	sb.content_margin_top = 2
	sb.content_margin_bottom = 2
	pc.add_theme_stylebox_override("panel", sb)
	var l := lbl(text, size_px, col.lightened(0.35) if lit else Color(col, 0.75))
	pc.add_child(l)
	pc.mouse_filter = MOUSE_FILTER_IGNORE
	l.mouse_filter = MOUSE_FILTER_IGNORE
	return pc


# All three tiers of a tag, the active one marked, plus what the next tier needs.
func syn_tooltip(tag: String, n: int) -> String:
	var t := SurvivalData.syn_tier(n)
	var tt := ""
	for i in SurvivalData.SYN_TIERS.size():
		var state := "â–¶ " if i + 1 == t else ("âœ“ " if i + 1 < t else "   ")
		tt += "%s%d cards: %s\n" % [state, SurvivalData.SYN_TIERS[i], SurvivalData.TAGS[tag]["tiers"][i]]
	var nxt := ""
	if t < SurvivalData.SYN_TIERS.size():
		nxt = "\nNext tier: %d more card%s with this tag." % [SurvivalData.SYN_TIERS[t] - n, "" if SurvivalData.SYN_TIERS[t] - n == 1 else "s"]
	return "%s  Â·  %d owned\n%s%s" % [SurvivalData.TAGS[tag]["name"], n, tt.strip_edges(), nxt]


func syn_text(tag: String, n: int) -> String:
	var t := SurvivalData.syn_tier(n)
	var nxt: int = SurvivalData.SYN_TIERS[t] if t < SurvivalData.SYN_TIERS.size() else n
	return "%s %d/%d" % [SurvivalData.TAGS[tag]["name"], n, nxt] if t < SurvivalData.SYN_TIERS.size() else "%s %d  MAX" % [SurvivalData.TAGS[tag]["name"], n]


func _fill_syn(box: Control, counts: Dictionary, size_px := 12, tips := false) -> void:
	for ch in box.get_children():
		ch.queue_free()
	for tag in SurvivalData.TAG_ORDER:
		var n := int(counts.get(tag, 0))
		if n <= 0:
			continue
		var t := SurvivalData.syn_tier(n)
		var chip := tag_chip(tag, syn_text(tag, n), t > 0, size_px)
		if tips:
			chip.mouse_filter = MOUSE_FILTER_STOP
			chip.tooltip_text = syn_tooltip(tag, n)
		box.add_child(chip)


