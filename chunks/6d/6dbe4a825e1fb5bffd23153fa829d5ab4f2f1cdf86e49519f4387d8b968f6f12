	# soft shadow
	ci.draw_rect(Rect2(r.position + Vector2(0, 3), r.size).grow(3), Color(0, 0, 0, 0.22 * a))
	ci.draw_rect(Rect2(r.position + Vector2(0, 2), r.size).grow(1.5), Color(0, 0, 0, 0.3 * a))
