static var _loaded := false
static var _mats := {}


static func ensure() -> void:
	if _loaded:
		return
	_loaded = true
	var cf := ConfigFile.new()
	if cf.load(PATH) != OK:
		return
	heroes = cf.get_value("profile", "heroes", {})
	games = int(cf.get_value("profile", "games", 0))
	wins = int(cf.get_value("profile", "wins", 0))
	survival = cf.get_value("profile", "survival", [])
	tutorial_done = bool(cf.get_value("profile", "tutorial_done", false))
	tutorial_ch = int(cf.get_value("profile", "tutorial_ch", 0))
	achieved = cf.get_value("profile", "achieved", {})
	bosses_beaten = cf.get_value("profile", "bosses", [])
	talents = cf.get_value("profile", "talents", {})
	tips_seen = cf.get_value("profile", "tips_seen", {})
	daily = cf.get_value("profile", "daily", {})
	daily_friends = cf.get_value("profile", "daily_friends", {})
	stats = cf.get_value("profile", "stats", {})


static func save() -> void:
	var cf := ConfigFile.new()
	cf.set_value("profile", "heroes", heroes)
	cf.set_value("profile", "games", games)
	cf.set_value("profile", "wins", wins)
	cf.set_value("profile", "survival", survival)
	cf.set_value("profile", "tutorial_done", tutorial_done)
	cf.set_value("profile", "tutorial_ch", tutorial_ch)
	cf.set_value("profile", "achieved", achieved)
	cf.set_value("profile", "bosses", bosses_beaten)
	cf.set_value("profile", "talents", talents)
	cf.set_value("profile", "tips_seen", tips_seen)
	cf.set_value("profile", "daily", daily)
	cf.set_value("profile", "daily_friends", daily_friends)
	cf.set_value("profile", "stats", stats)
	cf.save(PATH)


static func stat(k: String) -> int:
	ensure()
	return int(stats.get(k, 0))


static func add_stat(k: String, n := 1) -> void:
	ensure()
	stats[k] = int(stats.get(k, 0)) + n
	save()


# Wipes everything: heroes, records, achievements, talents, daily runs and tips seen (not the settings).
static func reset_all() -> void:
	heroes = {}
	games = 0
	wins = 0
	survival = []
	tutorial_done = false
	tutorial_ch = 0
	achieved = {}
	bosses_beaten = []
	tips_seen = {}
	talents = {}
	daily = {}
	daily_friends = {}
	stats = {}
	save()


static func hero(id: String) -> Dictionary:
	ensure()
	if not heroes.has(id):
		heroes[id] = {"games": 0, "wins": 0, "xp": 0, "skin": "classic", "kills": 0}
	return heroes[id]


static func mastery(id: String) -> int:
	var xp := int(hero(id)["xp"])
	var lv := 0
	for need in MASTERY_XP:
		if xp >= need:
			lv += 1
	return lv


# 0..1 progress toward the next mastery level (1.0 at max)
static func mastery_frac(id: String) -> float:
	var lv := mastery(id)
	if lv >= MASTERY_XP.size():
		return 1.0
	var xp := float(hero(id)["xp"])
	return (xp - MASTERY_XP[lv - 1]) / float(MASTERY_XP[lv] - MASTERY_XP[lv - 1])


static func skin_def(sid: String) -> Dictionary:
	for s in SKINS:
		if s["id"] == sid:
			return s
	return SKINS[0]


static func skin_unlocked(id: String, sid: String) -> bool:
	var d := skin_def(sid)
	if d.has("ach"):
		return achieved.size() >= int(d["ach"])
	return mastery(id) >= int(d["need"])


static func skin_hint(sid: String) -> String:
	var d := skin_def(sid)
	if d.has("ach"):
		return "unlocks with %d achievements" % int(d["ach"])
	return "unlocks at mastery %d with this hero" % int(d["need"])


static func ach_def(aid: String) -> Dictionary:
	for a in ACHIEVEMENTS:
		if a["id"] == aid:
			return a
	return {}


# Unlocks an achievement. Returns true the first time.
static func unlock(aid: String) -> bool:
	ensure()
	if achieved.has(aid) or ach_def(aid).is_empty():
		return false
	var d := Time.get_date_dict_from_system()
	achieved[aid] = "%04d-%02d-%02d" % [d["year"], d["month"], d["day"]]
	save()
	return true


static func heroes_played() -> int:
	var n := 0
	for id in heroes:
		if int(heroes[id].get("xp", 0)) > 0:
			n += 1
	return n


static func skin_of(id: String) -> String:
	var sid := String(hero(id).get("skin", "classic"))
	return sid if skin_unlocked(id, sid) else "classic"


static func set_skin(id: String, sid: String) -> void:
	if skin_unlocked(id, sid):
		hero(id)["skin"] = sid
		save()


# A CanvasItem material that paints a skin, or null for the classic look.
static func skin_material(sid: String) -> Material:
	if sid == "" or sid == "classic":
		return null
	if _mats.has(sid):
		return _mats[sid]
	var d := skin_def(sid)
	var m := ShaderMaterial.new()
	m.shader = load("res://shaders/skin.gdshader")
	for k in ["hue", "min_sat", "sat_k", "bright", "sheen"]:
		m.set_shader_parameter(k, float(d[k]))
	m.set_shader_parameter("mix_amt", float(d["mix"]))
	_mats[sid] = m
	return m


# Records a finished match. Returns what changed for the end screen.
static func record_match(id: String, won: bool, kills: int, dmg: float, mode: String, round_no: int, secs := 0) -> Dictionary:
	var h := hero(id)
	stats["time"] = int(stats.get("time", 0)) + maxi(0, secs)
	stats["kills"] = int(stats.get("kills", 0)) + kills
	stats["games"] = int(stats.get("games", 0)) + 1
	stats["mode:" + mode] = int(stats.get("mode:" + mode, 0)) + 1
	var old_lv := mastery(id)
	var gain := 100 + (150 if won else 0) + mini(kills, 150) + mini(150, int(dmg / 250.0))
	if mode == "survival":
		gain = 60 + 30 * round_no + mini(kills, 150)
	elif mode == "quick":
		gain = int(gain * 0.7)
	elif mode == "tutorial":
		gain = 150
	h["xp"] = int(h["xp"]) + gain
	h["kills"] = int(h.get("kills", 0)) + kills
	if mode != "survival" and mode != "tutorial":
		h["games"] = int(h["games"]) + 1
		games += 1
		if won:
			h["wins"] = int(h["wins"]) + 1
			wins += 1
	var new_lv := mastery(id)
	var unlocked: Array = []
	for s in SKINS:
		if int(s["need"]) > old_lv and int(s["need"]) <= new_lv:
			unlocked.append(s["name"])
	save()
	return {"xp": gain, "old": old_lv, "new": new_lv, "unlocked": unlocked}


# Adds a survival run; returns its place on the board (1-based) or 0 if it didn't make the top 10.
static func add_survival(hero_name: String, round_no: int, kills: int) -> int:
	ensure()
	var d := Time.get_date_dict_from_system()
	var e := {"round": round_no, "hero": hero_name, "kills": kills, "date": "%04d-%02d-%02d" % [d["year"], d["month"], d["day"]]}
	survival.append(e)
	survival.sort_custom(func(a, b): return int(a["round"]) > int(b["round"]) or (int(a["round"]) == int(b["round"]) and int(a["kills"]) > int(b["kills"])))
	var place := survival.find(e) + 1
	if survival.size() > 10:
		survival.resize(10)
	save()
	return place if place <= 10 else 0


# ---------------------------------------------------------------- survival talents
static func talent_rec(id: String) -> Dictionary:
	ensure()
	if not talents.has(id):
		talents[id] = {"xp": 0, "taken": []}
	return talents[id]


static func talent_points(id: String) -> int:
	return TalentData.points_for(int(talent_rec(id)["xp"]))


static func talents_taken(id: String) -> Array:
	return talent_rec(id)["taken"]


# A finished run adds the round it reached to the hero's talent experience. Returns points gained.
static func add_talent_xp(id: String, rounds: int) -> int:
	var rec := talent_rec(id)
	var before := TalentData.points_for(int(rec["xp"]))
	rec["xp"] = int(rec["xp"]) + maxi(0, rounds)
	save()
	return TalentData.points_for(int(rec["xp"])) - before


static func set_talents(id: String, taken: Array) -> void:
	talent_rec(id)["taken"] = taken.duplicate()
	save()


# ---------------------------------------------------------------- daily run
static func _better(a: Dictionary, b: Dictionary) -> bool:
	return int(a["round"]) > int(b["round"]) or (int(a["round"]) == int(b["round"]) and int(a["kills"]) > int(b["kills"]))


# Records a daily run. Returns true if it is your best for that day.
static func add_daily(date: int, hero_name: String, round_no: int, kills: int) -> bool:
	ensure()
	var k := str(date)
	var e := {"round": round_no, "kills": kills, "hero": hero_name, "tries": 1}
	var best := false
	if daily.has(k):
		e["tries"] = int(daily[k].get("tries", 1)) + 1
		if _better(e, daily[k]):
			best = true
		else:
			daily[k]["tries"] = e["tries"]
			e = daily[k]
	else:
		best = true
	daily[k] = e
	save()
	return best


static func _date_add(date: int, days: int) -> int:
	var y := date / 10000
	var unix := Time.get_unix_time_from_datetime_dict({"year": y, "month": (date / 100) % 100, "day": date % 100, "hour": 12, "minute": 0, "second": 0})
	var d := Time.get_datetime_dict_from_unix_time(unix + days * 86400)
	return int(d["year"]) * 10000 + int(d["month"]) * 100 + int(d["day"])


# Days in a row (ending today, or yesterday if today isn't played yet) with a daily run.
static func daily_streak(today: int) -> int:
	ensure()
	var d := today if daily.has(str(today)) else _date_add(today, -1)
	var n := 0
	while daily.has(str(d)):
		n += 1
		d = _date_add(d, -1)
	return n


static func date_label(date: int) -> String:
	return "%04d-%02d-%02d" % [date / 10000, (date / 100) % 100, date % 100]


# Share codes: a friend pastes yours into their game to see you on their board for the day.
# The check digits catch typos (they are not meant to stop a determined cheat).
static func _code_sum(body: String) -> int:
	var h := 7
	for ch in body:
		h = (h * 131 + ch.unicode_at(0)) % 1679616
	return h


static func daily_code(date: int, name: String, e: Dictionary) -> String:
	var nm := name.strip_edges().replace("-", " ").substr(0, 16)
	var body := "%d-%d-%d-%s-%s" % [date, int(e["round"]), int(e["kills"]), String(e["hero"]).split(" ")[0], nm.replace(" ", "_")]
	return "CF-%s-%s" % [body, String.num_int64(_code_sum(body), 36).to_upper()]


static func parse_daily_code(code: String) -> Dictionary:
	var c := code.strip_edges()
	if not c.begins_with("CF-"):
		return {}
	var parts := c.substr(3).split("-")
	if parts.size() != 6:
		return {}
	var body := "-".join(parts.slice(0, 5))
	if String.num_int64(_code_sum(body), 36).to_upper() != parts[5].to_upper():
		return {}
	if not parts[0].is_valid_int() or not parts[1].is_valid_int() or not parts[2].is_valid_int():
		return {}
	return {"date": int(parts[0]), "round": int(parts[1]), "kills": int(parts[2]), "hero": parts[3], "name": parts[4].replace("_", " ")}


# Adds a friend's result from a share code. Returns an error message, or "" if it worked.
static func add_daily_friend(code: String) -> String:
	ensure()
	var e := parse_daily_code(code)
	if e.is_empty():
		return "That doesn't look like a daily share code."
	var k := str(e["date"])
	var list: Array = daily_friends.get(k, [])
	list = list.filter(func(x): return String(x["name"]) != String(e["name"]))
	list.append({"name": e["name"], "round": e["round"], "kills": e["kills"], "hero": e["hero"]})
	daily_friends[k] = list
	save()
	return ""


# The board for a day: you plus every friend whose code you pasted, best first.
static func daily_board(date: int, my_name: String) -> Array:
	ensure()
	var out: Array = []
	var k := str(date)
	if daily.has(k):
		out.append({"name": my_name + " (you)", "round": daily[k]["round"], "kills": daily[k]["kills"], "hero": String(daily[k]["hero"]).split(" ")[0], "me": true})
	for f in daily_friends.get(k, []):
		out.append(f)
	out.sort_custom(func(a, b): return _better(a, b))
	return out
␀␀␀␀# A MultiplayerPeer that talks to the other players through the Confluence relay (relay/worker.js) over a
# WebSocket, so nobody needs port forwarding. To the rest of the game it behaves like the ENet peer: the
# host is peer 1, joiners get ids from the relay, and RPCs work the same.
#   host:  RelayPeer.new().host(url)            -> emits room_ready(code)
#   join:  RelayPeer.new().join(url, code)
# 0.25 host migration: the host asks the relay for it ("caps"). When the host drops, the relay makes the
# longest-connected player peer 1 and relabels its packets, so the other games never see peer 1 leave. The
# promoted game's peer turns into the server here (my_id 1, the other players announced as new peers) and
# host_changed(true) fires; the rest get host_changed(false). An older relay ignores "caps" and closes the
# room when the host leaves, exactly as before.
# 0.26 reconnection: the relay hands the host a room secret ("room" / "promoted" carry it). A host whose socket
# died calls rehost(url, code, secret) -> /host?code=&secret= : the relay puts the new socket in as peer 1 (the
# room is re-created if the relay lost it) and room_ready(code) fires again; "taken" (another host by now) or an
# old relay (which answers with a different, random code) ends in rehost_refused(why). The other players get
# {"t":"rehost"} -> host_back, and peer 1 is re-announced so the RPC path cache starts over.
extends MultiplayerPeerExtension

signal room_ready(code: String)
signal relay_error(msg: String, fatal: bool)   # fatal: the room is gone (host left on an old relay, kicked, no such room, full)
signal host_changed(me: bool, was: int)   # was: the promoted player's old id
signal rehost_refused(why: String)        # 0.26: "taken" (the room has another host now) or "old" (the relay can't re-open rooms)
signal host_back                          # 0.26: a player: the host's game is back on a new socket; ask it for what we missed

var ws := WebSocketPeer.new()
var my_id := 0
var server := false
var code := ""
var status := MultiplayerPeer.CONNECTION_DISCONNECTED
var target := 0
var mode := MultiplayerPeer.TRANSFER_MODE_RELIABLE
var channel := 0
var refusing := false
var _in: Array = []          # [from, PackedByteArray]
var _peers := {}             # ids we told the game about
var _ws_state := WebSocketPeer.STATE_CLOSED
var _ping_t := 0.0
var _last_poll := 0
var room_secret := ""        # 0.26: proves to the relay that this game owns the room (host / promoted host)
var want_code := ""          # 0.26: the code we asked to re-claim
var close_code := 0          # the last close code / reason seen on the socket (logged for bug reports)
var close_reason := ""
var _send_fail_t := 0


func _setup(url: String) -> Error:
	ws = WebSocketPeer.new()
	ws.inbound_buffer_size = 1 << 20
	ws.outbound_buffer_size = 1 << 22    # 0.25: a rejoining player's catch-up log goes out in 96 KB chunks
	ws.max_queued_packets = 8192
	var err := ws.connect_to_url(url)
	if err != OK:
		return err
	status = MultiplayerPeer.CONNECTION_CONNECTING
	_last_poll = Time.get_ticks_msec()
	return OK


func host(base_url: String) -> Error:
	server = true
	return _setup(base_url.rstrip("/") + "/host")


func join(base_url: String, room: String) -> Error:
	server = false
	code = room.strip_edges().to_upper()
	return _setup(base_url.rstrip("/") + "/join/" + code.uri_encode())


# 0.26: re-claim (or re-create) our room after the socket died.
func rehost(base_url: String, room: String, secret: String) -> Error:
	server = true
	want_code = room.strip_edges().to_upper()
	room_secret = secret
	return _setup(base_url.rstrip("/") + "/host?code=" + want_code.uri_encode() + "&secret=" + secret.uri_encode())


# ---------------------------------------------------------------- MultiplayerPeerExtension
func _poll() -> void:
	ws.poll()
	var st := ws.get_ready_state()
	if st == WebSocketPeer.STATE_OPEN:
		while ws.get_available_packet_count() > 0:
			var pkt := ws.get_packet()
			if ws.was_string_packet():
				_control(pkt.get_string_from_utf8())
			elif pkt.size() >= 4:
				var from := pkt.decode_s32(0)
				_in.append([from, pkt.slice(4)])
		# keep idle connections alive through routers and the host
		var now := Time.get_ticks_msec()
		_ping_t += (now - _last_poll) / 1000.0
		_last_poll = now
		if _ping_t > 5.0:
			_ping_t = 0.0
			ws.send_text('{"t":"ping"}')
	elif st == WebSocketPeer.STATE_CLOSED and status == MultiplayerPeer.CONNECTION_CONNECTING:
		# 0.26: a refusal (e.g. 4010 taken on a re-claim) can open and close the socket within one poll: read the
		# relay's text and the close code before calling it unreachable
		while ws.get_available_packet_count() > 0:
			var pkt0 := ws.get_packet()
			if ws.was_string_packet():
				_control(pkt0.get_string_from_utf8())
			if status != MultiplayerPeer.CONNECTION_CONNECTING:
				_ws_state = st
				return
		var cc0 := ws.get_close_code()
		if cc0 == 4010:
			print("[relay] socket closed: code 4010 reason '%s' (%s, id %d, room %s)" % [ws.get_close_reason(), "host" if server else "player", my_id, code])
			close_code = cc0
			close_reason = ws.get_close_reason()
			status = MultiplayerPeer.CONNECTION_DISCONNECTED
			rehost_refused.emit("taken")
			_ws_state = st
			return
		_lost("Couldn't reach the relay server. Check your internet connection, or try again in a minute.")
	elif st == WebSocketPeer.STATE_CLOSED and _ws_state != WebSocketPeer.STATE_CLOSED:
		# read what arrived before the close (the relay sends the reason first)
		while ws.get_available_packet_count() > 0:
			var pkt2 := ws.get_packet()
			if ws.was_string_packet():
				_control(pkt2.get_string_from_utf8())
		var cc := ws.get_close_code()
		close_code = cc
		close_reason = ws.get_close_reason()
		print("[relay] socket closed: code %d reason '%s' (%s, id %d, room %s)" % [cc, close_reason, "host" if server else "player", my_id, code])
		if cc == 4010:
			# 0.26: our re-claim was refused: the room has another host by now (promoted while we were away)
			status = MultiplayerPeer.CONNECTION_DISCONNECTED
			rehost_refused.emit("taken")
			_ws_state = st
			return
		var why := {4000: "The host left the game.", 4001: "Removed by the host.", 4004: "No game with that room code.", 4009: "That room is full.",
			4002: "The relay cut the connection: your game stopped answering.", 4005: "Your game reconnected on another connection."}
		_lost(why.get(cc, "Lost the connection to the relay (code %d). Check your internet connection." % cc), cc in [4000, 4001, 4004, 4009])
	_ws_state = st


func _control(text: String) -> void:
	var m = JSON.parse_string(text)
	if not m is Dictionary:
		return
	match String(m.get("t", "")):
		"room":
			if want_code != "" and String(m["code"]) != want_code:
				# an old relay (pre-0.26) ignores ?code= and opened a random new room: useless to us
				print("[relay] asked to re-open room %s, got %s: the relay can't re-open rooms (needs the 0.26 deploy)" % [want_code, String(m["code"])])
				status = MultiplayerPeer.CONNECTION_DISCONNECTED
				ws.close()
				rehost_refused.emit("old")
				return
			my_id = 1
			code = String(m["code"])
			room_secret = String(m.get("secret", ""))
			status = MultiplayerPeer.CONNECTION_CONNECTED
			ws.send_text('{"t":"caps","migrate":true}')
			room_ready.emit(code)
			# 0.26: a re-claimed room still has players in it; announce them once the game has adopted this peer
			for id in m.get("peers", []):
				if not _peers.has(int(id)):
					_peers[int(id)] = true
					peer_connected.emit(int(id))
		"rehost":
			# 0.26: the host's game is back on a new socket; forget the RPC path cache for 1 (as "migrated" does)
			host_back.emit()
			peer_disconnected.emit(1)
			peer_connected.emit(1)
		"promoted":
			# the host left and the relay picked us: from now on we are peer 1 (the clock)
			server = true
			my_id = 1
			room_secret = String(m.get("secret", ""))
			_peers.erase(1)        # the old host is gone; the game is told through host_changed, not as "server left"
			for id in m.get("peers", []):
				if not _peers.has(int(id)):
					_peers[int(id)] = true
					peer_connected.emit(int(id))
			host_changed.emit(true, int(m.get("was", 0)))
		"migrated":
			# forget the old host's RPC path cache: the MultiplayerAPI confirms node paths per peer, and the new
			# peer 1 has never seen ours. The connection status stays CONNECTED, so this is not "the server left".
			peer_disconnected.emit(1)
			peer_connected.emit(1)
			host_changed.emit(false, int(m.get("was", 0)))
		"welcome":
			my_id = int(m["id"])
			status = MultiplayerPeer.CONNECTION_CONNECTED
			_peers[1] = true
			peer_connected.emit(1)
		"peer_in":
			var id := int(m["id"])
			if server and not refusing and not _peers.has(id):
				_peers[id] = true
				peer_connected.emit(id)
		"peer_out":
			var id := int(m["id"])
			if _peers.has(id):
				_peers.erase(id)
				peer_disconnected.emit(id)
		"error", "closed":
			# 0.26 relays say which close code follows; the text comes first, so decide here
			var cc := int(m.get("code", 0))
			print("[relay] relay says: %s (code %d, %s, id %d, room %s)" % [String(m.get("msg", "")), cc, "host" if server else "player", my_id, code])
			if cc == 4010:
				status = MultiplayerPeer.CONNECTION_DISCONNECTED
				ws.close()
				rehost_refused.emit("taken")
				return
			_lost(String(m.get("msg", "The relay closed the connection.")), cc == 0 or cc in [4000, 4001, 4004, 4009])


func _lost(msg: String, fatal := false) -> void:
	if status == MultiplayerPeer.CONNECTION_DISCONNECTED:
		return
	var was_connected := status == MultiplayerPeer.CONNECTION_CONNECTED
	status = MultiplayerPeer.CONNECTION_DISCONNECTED
	for id in _peers.keys():
		peer_disconnected.emit(id)
	_peers.clear()
	if ws.get_ready_state() != WebSocketPeer.STATE_CLOSED:
		ws.close()
	relay_error.emit(msg if was_connected or msg != "" else "Disconnected.", fatal)


# The peers this side knows about (the host: every player; a player: just the host).
func peer_ids() -> Array:
	return _peers.keys()


func _get_available_packet_count() -> int:
	return _in.size()


func _get_packet_script() -> PackedByteArray:
	if _in.is_empty():
		return PackedByteArray()
	return _in.pop_front()[1]


func _get_packet_peer() -> int:
	return 0 if _in.is_empty() else int(_in[0][0])


func _get_packet_mode() -> MultiplayerPeer.TransferMode:
	return MultiplayerPeer.TRANSFER_MODE_RELIABLE


func _get_packet_channel() -> int:
	return 0


func _put_packet_script(p_buffer: PackedByteArray) -> Error:
	if status != MultiplayerPeer.CONNECTION_CONNECTED or ws.get_ready_state() != WebSocketPeer.STATE_OPEN:
		return ERR_UNCONFIGURED
	var out := PackedByteArray()
	out.resize(4)
	out.encode_s32(0, target)
	out.append_array(p_buffer)
	var err := ws.send(out, WebSocketPeer.WRITE_MODE_BINARY)
	if err != OK:
		# the 4 MB outbound buffer is full (or the socket is going): the packet is lost, which lockstep can't survive;
		# say so in the log (once a second) so the report tells us. The relay socket itself stays open.
		var now := Time.get_ticks_msec()
		if now - _send_fail_t > 1000:
			_send_fail_t = now
			print("[relay] send failed (error %d): %d bytes to %d, outbound buffer full? (%d packets queued)" % [err, out.size(), target, ws.get_available_packet_count()])
	return err


func _get_max_packet_size() -> int:
	return 1 << 20


func _set_transfer_mode(p_mode: MultiplayerPeer.TransferMode) -> void:
	mode = p_mode


func _get_transfer_mode() -> MultiplayerPeer.TransferMode:
	return mode


func _set_transfer_channel(p_channel: int) -> void:
	channel = p_channel


func _get_transfer_channel() -> int:
	return channel


func _set_target_peer(p_peer: int) -> void:
	target = p_peer


func _is_server() -> bool:
	return server


func _is_server_relay_supported() -> bool:
	return false


func _get_unique_id() -> int:
	return my_id


func _get_connection_status() -> MultiplayerPeer.ConnectionStatus:
	return status


func _set_refuse_new_connections(p_enable: bool) -> void:
	refusing = p_enable


func _is_refusing_new_connections() -> bool:
	return refusing


func _disconnect_peer(p_peer: int, _p_force: bool) -> void:
	if server and ws.get_ready_state() == WebSocketPeer.STATE_OPEN:
		ws.send_text(JSON.stringify({"t": "kick", "id": p_peer}))
	if _peers.has(p_peer):
		_peers.erase(p_peer)
		peer_disconnected.emit(p_peer)


func _close() -> void:
	if ws.get_ready_state() == WebSocketPeer.STATE_OPEN and server:
		ws.send_text('{"t":"bye"}')   # 0.26: a leave on purpose: the relay migrates at once instead of waiting for us
		ws.poll()                      # (flush it: nobody polls this peer after close)
	if ws.get_ready_state() != WebSocketPeer.STATE_CLOSED:
		ws.close()
		ws.poll()
	status = MultiplayerPeer.CONNECTION_DISCONNECTED
	_peers.clear()
	_in.clear()
␀␀# Match replays. The simulation is deterministic: the same seed, the same match settings and the same
# player commands at the same simulation steps always play out the same match. So a replay is only the
# setup plus the list of commands, each stamped with the step it was applied before.
# Skirmish and Survival matches are recorded automatically (not the campaign, the tutorial or online
# matches); the newest KEEP replays are kept in user://replays/.
class_name Replay
extends RefCounted

const DIR := "user://replays/"
const KEEP := 20
const VERSION := 1

static var rec: Dictionary = {}
static var recording := false
static var last_path := ""


# setup: {"hero", "diff", "bans", "opts" (must include "seed"), "skin", "game_mode", "label"}; 0.26: a bug report's
# replay of an online match adds "local" (the reporter's slot) and stamps each command with its player's slot
# as a fourth element, [tick, k, a, pid].
static func begin(setup: Dictionary) -> void:
	var d := Time.get_datetime_dict_from_system()
	rec = {"v": VERSION, "setup": setup.duplicate(true), "cmds": [],
		"date": "%04d-%02d-%02d %02d:%02d" % [d["year"], d["month"], d["day"], d["hour"], d["minute"]],
		"stamp": "%04d%02d%02d_%02d%02d%02d" % [d["year"], d["month"], d["day"], d["hour"], d["minute"], d["second"]]}
	recording = true


static func record(tick: int, k: String, a: Array) -> void:
	if recording:
		rec["cmds"].append([tick, k, a.duplicate(true)])


static func cancel() -> void:
	recording = false
	rec = {}


# Saves the finished match; returns the file path ("" when nothing was being recorded).
static func finish(summary: Dictionary) -> String:
	if not recording:
		return ""
	recording = false
	rec["summary"] = summary
	DirAccess.make_dir_recursive_absolute(DIR)
	var path := DIR + "%s.replay" % rec["stamp"]
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		return ""
	f.store_string(var_to_str(rec))
	f.close()
	last_path = path
	_prune()
	return path


static func _files() -> Array:
	var out: Array = []
	var da := DirAccess.open(DIR)
	if da == null:
		return out
	for fn in da.get_files():
		if fn.ends_with(".replay"):
			out.append(DIR + fn)
	out.sort()
	out.reverse()
	return out


static func _prune() -> void:
	var files := _files()
	for i in range(KEEP, files.size()):
		DirAccess.remove_absolute(files[i])


# Deletes every saved replay. Returns how many were removed.
static func delete_all() -> int:
	var files := _files()
	for f in files:
		DirAccess.remove_absolute(f)
	last_path = ""
	return files.size()


static func load_file(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var txt := FileAccess.get_file_as_string(path)
	var v = str_to_var(txt)
	if not (v is Dictionary) or int(v.get("v", 0)) != VERSION:
		return {}
	return v


# Newest first: [{"path", "date", "summary"}].
static func list() -> Array:
	var out: Array = []
	for path in _files():
		var r := load_file(path)
		if r.is_empty():
			continue
		out.append({"path": path, "date": r.get("date", ""), "summary": r.get("summary", {}), "setup": r.get("setup", {})})
	return out


static func make_sim(r: Dictionary) -> Sim:
	var s: Dictionary = r["setup"]
	var sim := Sim.new(String(s["hero"]), false, int(s["diff"]), s["bans"].duplicate(), s["opts"].duplicate(true))
	sim.players[0].champ.skin = String(s.get("skin", ""))
	sim.local = clampi(int(s.get("local", 0)), 0, 7)
	return sim
