var _steam_creating := false


func _on_steam_lobby_created(result: int, lid: int) -> void:
	if not _steam_creating:
		return
	_steam_creating = false
	if result != 1:   # k_EResultOK
		_fail("Steam couldn't create the lobby (error %d)." % result)
		return
	lobby_id = lid
	steam.setLobbyData(lid, "name", "%s's Confluence lobby" % my_name)
	steam.setLobbyData(lid, "game", LOBBY_GAME)
	steam.setLobbyData(lid, "ver", game_version())   # a joiner with another build is told before it connects
	steam.setLobbyJoinable(lid, true)
	var peer = SteamPeerScript.new()
	var err: Error = peer.host(steam, steam_id, _steam_may_join)
	if err != OK:
		_fail("Steam networking failed to start (error %d)." % err)
		return
	multiplayer.multiplayer_peer = peer
	transport = "steam"
	_steam_presence(lid)
	_become_host()
	_log("Steam lobby %d open" % lid)
	for fid in _steam_invite_queue:
		steam_invite(int(fid))
	_steam_invite_queue.clear()


# Host: who may open a Steam session with us - members of our lobby, or our Steam friends (the lobby is
# friends-only; a friend's session request can arrive before Steam has told us they joined).
func _steam_may_join(sid: int) -> bool:
	if not steam_ok or lobby_id == 0:
		return false
	for i in int(steam.getNumLobbyMembers(lobby_id)):
		if int(steam.getLobbyMemberByIndex(lobby_id, i)) == sid:
			return true
	return int(steam.getFriendRelationship(sid)) == 3   # k_EFriendRelationshipFriend


# Someone entered or left our Steam lobby. chat_state: 1 entered, 2 left, 4 disconnected, 8 kicked, 16 banned.
func _on_steam_lobby_chat_update(lid: int, changed_id: int, _by: int, chat_state: int) -> void:
	if lid != lobby_id or transport != "steam":
		return
	var p = multiplayer.multiplayer_peer
	if is_host and (chat_state & (2 | 4 | 8 | 16)) != 0 and p != null and p.has_method("drop_steam_user"):
		p.drop_steam_user(changed_id)   # the game hears it at once instead of after PEER_DROP


