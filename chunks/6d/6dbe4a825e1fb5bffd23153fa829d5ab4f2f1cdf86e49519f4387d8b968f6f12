	if slot < 0:
		return Settings.key_name("item1")
	if Settings.pad_on and main.pad != null:
		var an: int = main.pad.active_slots().find(slot)
		return Settings.pad_name("item%d" % (an + 1)) if an >= 0 and an < 2 else "â€”"
	return Settings.kb_name("item%d" % (slot + 1))


# A few monsters placed on the road `dist` west of the hero (lane 0 of the hero's arena); remembered under key.
func spawn_pack(kinds: Array, dist: float, key: String, hpm := 1.0) -> Array:
	var sim = main.sim
	var c = hero()
	var pts := Sim.lane_points(0)
	var cum := [0.0]
	for i in range(1, pts.size()):
		cum.append(float(cum[i - 1]) + pts[i - 1].distance_to(pts[i]))
	var want: Vector2 = c.p + Vector2(-dist, 0)
	var bi := 0
	for i in pts.size():
		if pts[i].distance_to(want) < pts[bi].distance_to(want):
			bi = i
	var frac: float = float(cum[bi]) / maxf(1.0, float(cum[cum.size() - 1]))
	var out: Array = []
	for i in kinds.size():
		out.append(sim.place_mon(my_ar(), String(kinds[i]), 0, frac - 0.004 * i, hpm))
	base[key] = out
	return out


func alive(key: String) -> Array:
	var out: Array = []
	for m in base.get(key, []):
		if m != null and not m.dead and my_ar().mons.has(m):
			out.append(m)
	return out


func _spirit() -> int:
	return maxi(0, main.sim.camp_index("spirit"))


func _camp_mons(ci: int) -> Array:
	var out: Array = []
	for m in my_ar().mons:
		if not m.dead and m.camp_i == ci:
			out.append(m)
	return out


# ---------------------------------------------------------------- staging
func _enter(sid: String) -> void:
	var sim = main.sim
	var p = me()
	var c = hero()
	var av = main.arena_view
	if c.dead:
		c.respawn = 0.0
	match sid:
		"move":
			base["p"] = c.p
		"camera":
			av.look_at_world(c.p + Vector2(-900, 380))
		"amove":
			if alive("pack").is_empty():
				spawn_pack(["kobold", "kobold", "kobold", "kobold"], 480.0, "pack", 0.8)
			flags.erase("amove")
		"finish":
			if alive("pack").is_empty():
				spawn_pack(["kobold", "kobold", "kobold"], 380.0, "pack", 0.8)
		"learn":
			if c.points <= 0 and c.ranks[0] + c.ranks[1] + c.ranks[2] + c.ranks[3] == 0:
				c.points = 1
		"cast":
			c.cds[skill()] = 0.0
			if alive("dummies").is_empty():
				spawn_pack(["kobold", "kobold", "kobold"], 320.0, "dummies", 0.8)
		"income":
			sim.waves_on = true
			sim.round_t = maxf(sim.round_t, sim.round_len - 6.0)
			base["r0"] = sim.round_no
		"interest":
			gold(sim.interest_cap_for(p))
			sim.waves_on = true
			sim.round_t = maxf(sim.round_t, sim.round_len - 8.0)
			base["i0"] = p.interest
		"build":
			gold(Sim.building_cost(0) + 40.0)
		"send":
			gold(Sim.building_cost(0) + 160.0 if p.tech < 1 else 160.0)
		"rift":
			base["lane"] = main.lane_mode
		"walk_shop":
			gold(700.0)
		"buy":
			gold(600.0)
			if main.shop_panel.visible:
				main.select_shop_item("sword")
		"recipe":
			gold(600.0)
			var b := basic_with_recipe()
			if b != "" and main.shop_panel.visible:
				main.select_shop_item(b)
		"potion":
			gold(float(Sim.POTION_COST) + 10.0)
			if main.shop_panel.visible:
				main.select_shop_item("potion")
		"active_buy":
			gold(float(sim.item_price(c, ACT_ITEM)) + 10.0)
			if main.shop_panel.visible:
				main.select_shop_item(ACT_ITEM)
		"active_use":
			c.act_cd[ACT_ITEM] = 0.0
		"crystal":
			main.set_view_arena(main.myt())
			av.look_at_world(Sim.CORE + Vector2(-260, 60))
		"crystal_up":
			gold(float(sim.core_cost(my_ar(), 0)) + 20.0)
		"wave":
			main.center_on_hero()
			main.announce("Round %d" % (sim.round_no + 1), "A wave marches on your crystal", 0, 2.5)
			spawn_pack(WAVE_KINDS, 760.0, "wave")
		"boss":
			main.center_on_hero()
			var bd: Dictionary = GameData.MON["boss_warden"]
			spawn_pack(["boss_warden"], 720.0, "boss", BOSS_HP / float(bd["hp"]))
			main.announce("Boss", "%s marches on your crystal" % bd["name"], 2, 3.0)
		"camps":
			var ar = my_ar()
			for ci in Sim.CAMPS.size():
				sim._camp_arrays(ar)
				if not ar.camps_up[ci]:
					sim.spawn_camp(ar, ci)
			for m in _camp_mons(_spirit()):
				m.max_hp *= 0.35
				m.hp = m.max_hp
			tour = []
			for ci in [0, maxi(0, sim.camp_index("beast")), _spirit()]:
				tour.append([Sim.CAMPS[ci]["pos"], 2.4])
			tour_t = 0.0
			av.look_at_world(tour[0][0])
		"camp_clear":
			var ar = my_ar()
			sim._camp_arrays(ar)
			if not ar.camps_up[_spirit()] and _camp_mons(_spirit()).is_empty():
				sim.spawn_camp(ar, _spirit())
				for m in _camp_mons(_spirit()):
					m.max_hp *= 0.35
					m.hp = m.max_hp
		"duel":
			flags.erase("duel_seen")
			flags.erase("duel_try")
		"ping":
			base["pings"] = main.pings_sent
		"command":
			base["orders"] = main.orders_given
		"vote":
			sim.waves_on = true
			if sim.vote_refusal(main.myt()) != "" and not sim.vote_on[main.myt()] and not sim.team_ready[main.myt()]:
				sim.round_t = clampf(sim.round_t, Sim.VOTE_GRACE + 1.0, sim.round_len - sim.vote_len() - 2.0)
		"board":
			if main.board_open:
				main.toggle_board()


func _exit(sid: String) -> void:
	var sim = main.sim
	if sim == null:
		return
	match sid:
		"income", "interest", "vote":
			sim.waves_on = false   # the round clock waits again while the next lessons teach
		"camera", "crystal", "camps":
			tour = []
			main.center_on_hero()


func _exit_chapter(c: int) -> void:
	var sim = main.sim
	if sim == null or c >= TutorialData.count():
		return
	match String(TutorialData.CHAPTERS[c]["name"]):
		"The Armory":
			if main.shop_panel.visible:
				main.toggle_shop()
		"The crystal":
			if main.core_panel.visible:
				main.toggle_core(main.core_view_team)
		"Teamwork":
			if main.board_open:
				main.toggle_board()
	sim.waves_on = false
	if not main.my_view():
		main.center_on_hero()


# Puts the player in a duel with the first standing enemy hero (start_duel takes the pair named in advance).
func _try_duel() -> void:
	var sim = main.sim
	var c = hero()
	if c.dead or sim.duel_on:
		return
	flags["duel_try"] = true
	var foe = null
	for i in range(4, 8):
		var o = sim.players[i]
		if not o.absent and not o.champ.dead and o.champ.ar == sim.arenas[1]:
			foe = o.champ
			break
	if foe == null or c.ar != sim.arenas[0]:
		return
	sim.duel_next = [c, foe]
	sim.duel_next_round = sim.round_no
	sim.start_duel()
	if sim.duel_on and sim.duel_pair.has(c):
		foe.hp *= DUEL_FOE_HP
		flags["duel_seen"] = true
		base["foe"] = foe


func _done(sid: String) -> bool:
	var sim = main.sim
	var p = me()
	var c = hero()
	match sid:
		"move":
			return c.p.distance_to(base.get("p", c.p)) > 150.0
		"camera":
			return main.arena_view.follow and main.my_view()
		"amove":
			if c.order == "amove" or c.order == "attack":
				flags["amove"] = true
			return flags.has("amove") or alive("pack").is_empty()
		"finish":
			return alive("pack").is_empty()
		"learn":
			return c.ranks[0] + c.ranks[1] + c.ranks[2] + c.ranks[3] >= 1
		"cast":
			for i in 4:
				if c.cds[i] > 0.0:
					return true
			return false
		"income":
			return sim.round_no > int(base.get("r0", 0))
		"interest":
			return p.interest > int(base.get("i0", 0))
		"build":
			return p.tech >= 1
		"send":
			return p.sent > 0.0
		"rift":
			return main.lane_mode != int(base.get("lane", main.lane_mode))
		"walk_shop":
			return c.p.distance_to(Sim.SHOP) < Sim.SHOP_R - 20.0 or main.shop_panel.visible
		"open_shop":
			return main.shop_panel.visible
		"buy":
			return c.items.size() > 0
		"recipe":
			return owns_tier(2) or basic_with_recipe() == ""
		"potion":
			return c.potions > 0 or c.pot_t > 0
		"active_buy":
			return c.items.has(ACT_ITEM)
		"active_use":
			return not c.items.has(ACT_ITEM) or float(c.act_cd.get(ACT_ITEM, 0.0)) > 0.0
		"crystal":
			return main.core_panel.visible
		"crystal_up":
			return my_ar().core_lv.reduce(func(x, y): return x + y, 0) > 0
		"wave":
			return alive("wave").is_empty()
		"boss":
			return alive("boss").is_empty()
		"camps":
			return tour.is_empty() and (c.p.distance_to(Sim.CAMPS[_spirit()]["pos"]) < 430.0 or _camp_mons(_spirit()).is_empty())
		"camp_clear":
			return _camp_mons(_spirit()).is_empty()
		"duel":
			if not flags.has("duel_try"):
				if step_t > 2.5:
					_try_duel()
				return false
			if sim.duel_on:
				return false
			return step_t > 0.5
		"ping":
			return main.pings_sent > int(base.get("pings", 0))
		"command":
			return main.orders_given > int(base.get("orders", 0))
		"vote":
			var tm: int = main.myt()
			return sim.vote_on[tm] or sim.team_ready[tm] or sim.vote_round[tm] == sim.round_no
		"board":
			return main.board_open
		"board_close":
			return not main.board_open
	return false


# ---------------------------------------------------------------- words
func _vars() -> Dictionary:
	var sim = main.sim
	var p = me()
	var c = hero()
	var v := {}
	v["skill_name"] = String(c.def["skills"][0]["name"])
	v["income"] = p.income
	v["rate"] = roundi(sim.interest_rate() * 100.0)
	v["cap"] = int(sim.interest_cap_for(p))
	v["cap_round"] = int(Tune.v("interest_cap_round")) if sim.tune_applies() else 80
	match id:
		"income", "interest":
			v["secs"] = maxi(0, ceili(sim.round_len - sim.round_t))
	var it := GameData.item(ACT_ITEM)
	v["item_name"] = String(it.get("name", ACT_ITEM))
	v["item_act"] = String(it.get("act", {}).get("name", ""))
	v["item"] = "[b]" + item_key(item_slot(ACT_ITEM)) + "[/b]"
	var foe = base.get("foe", null)
	v["foe"] = String(foe.def["name"]).split(" ")[0] if foe != null else "the enemy hero"
	v["count"] = maxi(1, ceili(sim.duel_count))
	return v


# Fills {placeholders}: Settings actions become their key / button (in bold), the rest come from _vars.
func fill(s: String, v: Dictionary) -> String:
	var out := ""
	var i := 0
	while i < s.length():
		var a := s.find("{", i)
		if a < 0:
			out += s.substr(i)
			break
		var b := s.find("}", a)
		if b < 0:
			out += s.substr(i)
			break
		out += s.substr(i, a - i)
		var key := s.substr(a + 1, b - a - 1)
		if key.begins_with("learn:"):
			out += "[b]" + Settings.learn_name(key.substr(6)) + "[/b]"
		elif v.has(key):
			out += str(v[key])
		elif Settings.ACTIONS.any(func(x): return x[0] == key) or Settings.PAD_ACTIONS.any(func(x): return x[0] == key):
			out += "[b]" + Settings.key_name(key) + "[/b]"
		else:
			out += "{" + key + "}"
		i = b + 1
	return out


# [say, do] for the current step, worded for the controller while one is in use.
func lines() -> Array:
	if id == "" or id == "resume":
		return [_say_full, do_lbl.text]
	var st := TutorialData.step(ch, si)
	var pad: bool = Settings.pad_on
	var say := String(st.get("pad_say", st["say"]) if pad else st["say"])
	var dl := String(st.get("pad_do", st["do"]) if pad else st["do"])
	var sim = main.sim
	match id:
		"cast":
			if not Settings.quick_cast:
				dl = "Walk to the monsters, hold {skill_q} and let go to cast {skill_name}." if not pad else "Hold {skill_q} and let go to cast {skill_name}."
		"duel":
			if flags.has("duel_seen") and sim.duel_on:
				if sim.duel_count > 0.0:
					say = "The ring is yours. Everyone else waits and watches."
					dl = "The fight starts in {count}."
				else:
					say = "Duels come every few rounds. Press {duel} to watch the ones you're not in."
					dl = "Defeat {foe}: attack and use your abilities." if not pad else "Press {attack_move} to attack {foe}, and use your abilities."
			elif flags.has("duel_seen"):
				dl = "Well fought."
	var v := _vars()
	return [fill(say, v), fill(dl, v)]


func _set_say(s: String) -> void:
	if s == _say_full:
		return
	_say_full = s
	say_lbl.text = s
	say_lbl.visible_ratio = 0.0
	crest.talk = 1.0


# ---------------------------------------------------------------- every frame
func update(delta: float) -> void:
	if not running or main.sim == null or id == "":
		return
	if done_ov != null and done_ov.visible:
		return
	step_t += delta
	if say_lbl.visible_ratio < 1.0:
		say_lbl.visible_ratio = minf(1.0, say_lbl.visible_ratio + delta * 90.0 / maxf(20.0, float(say_lbl.get_total_character_count())))
	if id == "resume":
		_layout()
		return
	var sim = main.sim
	var c = hero()
	# nothing should be lost to a death while learning: the hero is back at once (a duel plays out first)
	if c.dead and not sim.duel_on:
		c.respawn = minf(c.respawn, 0.0)
	_ally_votes(delta)
	if not tour.is_empty():
		tour_t += delta
		if tour_t >= float(tour[0][1]):
			tour_t = 0.0
			tour.pop_front()
			if tour.is_empty():
				main.center_on_hero()
			else:
				main.arena_view.look_at_world(tour[0][0])
	var st := TutorialData.step(ch, si)
	if not bool(st.get("info", false)) and _done(id):
		advance()
		return
	text_t -= delta
	if text_t <= 0.0:
		text_t = 0.2
		refresh()
	else:
		_point()


# 0.41: the vote lesson must never end in "Vote failed": the allies answer the vote called in it with yes, a second
# or so apart the way bots answer in a real match. Staged here (the sim's own vote for them is held off while they
# wait); bot voting in real matches is unchanged.
func _ally_votes(delta: float) -> void:
	var sim = main.sim
	var tm: int = main.myt()
	if id == "vote" and sim.vote_on[tm] and ally_yes.is_empty() and not flags.has("ally_yes"):
		flags["ally_yes"] = true
		var k := 0
		for pl in sim.players:
			if pl.team == tm and not pl.human and not pl.absent and not sim.votes[tm].has(pl.id):
				ally_yes[pl.id] = 1.0 + 0.8 * k
				k += 1
	if ally_yes.is_empty():
		return
	if not sim.vote_on[tm]:
		ally_yes = {}
		return
	for pid in ally_yes.keys():
		sim.vote_ai_t[pid] = 99.0
		ally_yes[pid] = float(ally_yes[pid]) - delta
		if float(ally_yes[pid]) <= 0.0:
			ally_yes.erase(pid)
			sim.vote_cmd(sim.players[pid], true)
			if not sim.vote_on[tm]:
				ally_yes = {}
				return


func refresh() -> void:
	if not running or id == "" or id == "resume" or main.sim == null:
		return
	var l := lines()
	_set_say(String(l[0]))
	if do_lbl.text != String(l[1]):
		do_lbl.text = String(l[1])
	_point()


# ---------------------------------------------------------------- pointing and placement
func target() -> Array:
	var c = hero()
	match id:
		"move":
			return [null, Sim.walk_clamp(base.get("p", c.p) + Vector2(-280, 0))]
		"camera":
			return [main.follow_btn, Vector2.INF]
		"amove":
			var al := alive("pack")
			return [main.order_btns[0] if not main.amove_armed and main.order_btns.size() > 0 and not Settings.pad_on else null, al[0].p if not al.is_empty() else Vector2.INF]
		"finish":
			var al := alive("pack")
			return [null, al[0].p if not al.is_empty() else Vector2.INF]
		"learn":
			return [main.learn_btns[0], Vector2.INF]
		"cast":
			var al := alive("dummies")
			return [main.skill_btns[skill()], al[0].p if not al.is_empty() and al[0].p.distance_to(c.p) > 160.0 else Vector2.INF]
		"income":
			return [main.income_lbl, Vector2.INF]
		"interest":
			return [main.interest_lbl, Vector2.INF]
		"build":
			return [main.bld_btns[0], Vector2.INF]
		"send":
			return [main.send_btns[0], Vector2.INF]
		"rift":
			return [main.lane_btns[0].get_parent() if main.lane_btns.size() > 0 else null, Vector2.INF]
		"walk_shop":
			return [null, Sim.SHOP]
		"open_shop":
			return [main.shop_btn, Vector2.INF]
		"buy":
			return [main.shop_item_btns.get("sword") if main.shop_panel.visible else main.shop_btn, Vector2.INF]
		"recipe":
			if not main.shop_panel.visible:
				return [main.shop_btn, Vector2.INF]
			for x in main.shop_into.get_children():
				if x is BaseButton and x.visible and not x.is_queued_for_deletion():   # 0.39: the Armory's pooled recipe tiles
					return [x, Vector2.INF]
			return [null, Vector2.INF]
		"potion":
			return [main.shop_item_btns.get("potion") if main.shop_panel.visible else main.shop_btn, Vector2.INF]
		"active_buy":
			return [main.shop_item_btns.get(ACT_ITEM) if main.shop_panel.visible else main.shop_btn, Vector2.INF]
		"active_use":
			var sl := item_slot(ACT_ITEM)
			if main.shop_panel.visible or sl < 0:
				return [null, Vector2.INF]
			return [main.inv_btns[sl], Vector2.INF]
		"crystal":
			return [main.core_btn, Sim.CORE]
		"crystal_up":
			if main.core_panel.visible and main.core_rows.size() > 0:
				return [main.core_rows[0][2], Vector2.INF]
			return [main.core_btn, Vector2.INF]
		"wave":
			var al := alive("wave")
			return [null, al[0].p if not al.is_empty() else Vector2.INF]
		"boss":
			var al := alive("boss")
			return [null, al[0].p if not al.is_empty() else Vector2.INF]
		"camps":
			if not tour.is_empty():
				return [null, tour[0][0]]
			return [null, Sim.CAMPS[_spirit()]["pos"]]
		"camp_clear":
			var cm := _camp_mons(_spirit())
			return [null, cm[0].p if not cm.is_empty() else Vector2.INF]
		"duel":
			var foe = base.get("foe", null)
			if foe != null and main.sim.duel_on and main.sim.duel_count <= 0.0 and not foe.dead:
				return [null, foe.p]
		"command":
			return [main.cmd_btn, Vector2.INF]
		"vote":
			return [main.vote_ui.btn if main.vote_ui != null else null, Vector2.INF]
		"board", "board_close":
			return [main.board_title, Vector2.INF]
	return [null, Vector2.INF]


func _view_rect() -> Rect2:
	var vr: Rect2 = main.get_viewport().get_visible_rect()
	return Rect2(vr.position + Vector2(0, main.TOPBAR_H), vr.size - Vector2(0, main.TOPBAR_H + main.CONSOLE_H - 26.0))


func _point() -> void:
	var tg := target()
	var ctl = tg[0]
	var wp: Vector2 = tg[1]
	layer.target = Rect2()
	layer.spot = Vector2.INF
	layer.edge = Vector2.INF
	layer.dim = false
	if ctl is Control and is_instance_valid(ctl) and ctl.is_visible_in_tree():
		layer.target = ctl.get_global_rect()
	var av = main.arena_view
	var own: bool = main.sim != null and (av.arena_idx == main.myt() or (main.sim.duel_on and id == "duel"))
	if wp.x != INF and own:
		var sp: Vector2 = av.get_global_transform() * av.to_screen(wp)
		var vr := _view_rect().grow(-24.0)
		if vr.has_point(sp):
			layer.spot = sp
		else:
			var cen := vr.get_center()
			var d := sp - cen
			if d.length() > 1.0:
				d = d.normalized()
				var tx := INF
				var ty := INF
				if absf(d.x) > 0.001:
					tx = (vr.size.x * 0.5 - 20.0) / absf(d.x)
				if absf(d.y) > 0.001:
					ty = (vr.size.y * 0.5 - 20.0) / absf(d.y)
				layer.edge = cen + d * minf(tx, ty)
				layer.edge_dir = d
	# dim the rest of the screen for a HUD element (not while a panel is open: the panel is the lesson)
	layer.dim = layer.target.size != Vector2.ZERO and layer.spot.x == INF and not main.shop_panel.visible and not main.core_panel.visible and not main.board_open
	_layout()


# Where the plaque goes: the first spot down the left (then the right) edge that covers nothing it must not.
func _layout() -> void:
	var shop_open: bool = main.shop_panel.visible
	if shop_open and running and id != "resume":
		# the Armory covers the screen at 1280x720: the narrator's line moves into its hint line
		plaque.visible = false
		var line := TutorialData.NARRATOR.split(" ")[-1] + ":  " + _plain(do_lbl.text)
		if main.shop_status.text != line:
			main.shop_status.set_deferred("text", line)   # after this frame's refresh_shop
		return
	plaque.visible = running and not (done_ov != null and done_ov.visible)
	var vr: Rect2 = main.get_viewport().get_visible_rect()
	# must not cover: panels and cards, what is pointed at; should not cover: your hero, the message log
	var hard: Array = []
	var soft: Array = []
	for x in [main.duel_lbl, main.bless_lbl, main.boss_box, main.core_panel, main.board,
			main.vote_ui.card if main.vote_ui != null else null, main.vote_ui.banner if main.vote_ui != null else null]:
		if x == null or not is_instance_valid(x) or not x.is_visible_in_tree():
			continue
		if x is Label and String(x.text) == "":
			continue
		var r: Rect2 = x.get_global_rect()
		if r.size.x < 2.0 or r.size.y < 2.0:
			continue
		hard.append(r.grow(8.0))
	if layer.target.size != Vector2.ZERO:
		hard.append(layer.target.grow(40.0))
	if layer.spot.x != INF:
		hard.append(Rect2(layer.spot - Vector2(70, 110), Vector2(140, 170)))
	if layer.edge.x != INF:
		hard.append(Rect2(layer.edge - Vector2(40, 40), Vector2(80, 80)))
	var av = main.arena_view
	var c = hero() if main.sim != null else null
	if c != null and not c.dead and (av.arena_idx == c.ar.idx):
		var hp: Vector2 = av.get_global_transform() * av.to_screen(c.p)
		var hr := Rect2(hp - Vector2(60, 90), Vector2(120, 130))
		if main.sim.duel_on:
			hard.append(hr)   # the duel ring: your hero is the lesson
		else:
			soft.append(hr)
	for l in main.log_lbls:
		if l is Label and l.is_visible_in_tree() and String(l.text) != "" and l.modulate.a > 0.05:
			var r: Rect2 = l.get_global_rect()
			var tw: float = l.get_theme_font("font").get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, l.get_theme_font_size("font_size")).x
			soft.append(Rect2(r.position, Vector2(minf(r.size.x, tw + 6.0), r.size.y)))
	var top: float = vr.position.y + main.TOPBAR_H + 10.0
	var bottom: float = vr.end.y - main.CONSOLE_H - 8.0
	if _placed:
		plaque.size = Vector2(_w(), 0)
		if _fits(Rect2(plaque.global_position, Vector2(_w(), plaque.get_combined_minimum_size().y)), hard, top, bottom, vr):
			return   # stay put while the place still works (a plaque that hops about is hard to read and click)
	for pass_i in 3:
		# 0: the full plaque clear of everything; 1: clear of what it must not cover; 2: compact (title and
		# the one thing to do) beside a big panel on a small screen
		_set_compact(pass_i == 2)
		var w := _w()
		plaque.size = Vector2(w, 0)
		var h: float = plaque.get_combined_minimum_size().y
		var avoid: Array = hard + (soft if pass_i == 0 else [])
		for x in [vr.position.x + 16.0, vr.end.x - w - 16.0]:
			var y := top
			while y + h <= bottom:
				var r := Rect2(Vector2(x, y), Vector2(w, h))
				if _fits(r, avoid, top, bottom, vr):
					plaque.global_position = r.position
					_placed = true
					return
				y += 12.0
	# nowhere is clear: the compact plaque where it covers the least of what it must not cover
	var w2 := _w()
	var h2: float = plaque.get_combined_minimum_size().y
	var best := Vector2(vr.position.x + 16.0, top)
	var least := INF
	var x2 := vr.position.x + 16.0
	while x2 + w2 <= vr.end.x - 16.0:
		var y2 := top
		while y2 + h2 <= bottom:
			var r := Rect2(Vector2(x2, y2), Vector2(w2, h2))
			var area := 0.0
			for a in hard:
				var ix: Rect2 = r.intersection(a)
				area += ix.get_area()
			if area < least - 0.5:
				least = area
				best = r.position
			y2 += 12.0
		x2 += 24.0
	plaque.global_position = best
	_placed = true


func _fits(r: Rect2, avoid: Array, top: float, bottom: float, vr: Rect2) -> bool:
	if r.position.y < top - 0.5 or r.end.y > bottom + 0.5 or r.position.x < vr.position.x or r.end.x > vr.end.x:
		return false
	for a in avoid:
		if r.intersects(a):
			return false
	return true


var compact := false


func _w() -> float:
	return W_COMPACT if compact else W


func _set_compact(on: bool) -> void:
	if compact == on:
		return
	compact = on
	pips.visible = not on
	say_lbl.visible = not on
	btn_row.visible = not on
	crest.visible = not on
	do_lbl.custom_minimum_size = Vector2((W_COMPACT - 30.0) if on else (W - CREST_W - 40.0), 0)


static func _plain(bb: String) -> String:
	return bb.replace("[b]", "").replace("[/b]", "")


# ---------------------------------------------------------------- leaving and finishing
# Leave tutorial: back to the menu; the chapter is remembered (Profile.tutorial_ch) and the tutorial counts as
# played (Profile.tutorial_done, as the 0.19 "End" did), so the first-launch offer does not come back.
func leave() -> void:
	if not running:
		return
	if id != "" and id != "resume":
		_exit(id)
		Profile.tutorial_ch = ch
	reset()
	Profile.tutorial_done = true
	Profile.save()
	main.back_to_draft()


func _complete() -> void:
	reset()
	running = true            # the finish screen belongs to the tutorial until a button is pressed
	id = ""
	Profile.tutorial_done = true
	Profile.tutorial_ch = 0
	Profile.save()
	main.award("tutorial")
	if main.audio != null:
		main.audio.play("learn", -2.0)
	if main.sim != null:
		main.sim.waves_on = false
	_build_done()
	done_ov.visible = true
