func open_with(code: String, nm: String) -> void:
	with_code = chat.norm(code)
	with_name = nm
	title.text = "Whisper  Â·  %s" % nm
	for ch in face_box.get_children():
		ch.queue_free()
	var f: Control = Avatars.face(main.account.friend_avatar(code), "", nm, 44)
	f.set_anchors_preset(Control.PRESET_FULL_RECT)
	face_box.add_child(f)
