# Fits the plaque to the window: the body takes the height that is left (FitCenter scales what still overflows).
func fit(vp: Vector2) -> void:
	custom_minimum_size = Vector2(clampf(vp.x - 48.0, 820.0, 1040.0), 0)
	scroll.custom_minimum_size = Vector2(0, clampf(vp.y - 262.0, 260.0, 700.0))


func _section(title: String) -> void:
	_sec = SectionHead.new()
	_sec.text = title.to_upper()
	pages[_page].add_child(_sec)
	sections.append(_sec)


# A row: name and a short line on the left, the control on the right (W_CTRL wide, right-aligned).
func _row(title: String, desc: String, ctrl: Control, words := "") -> Row:
	var r := Row.new()
	r.page = _page
	r.words = ("%s %s %s" % [title, desc, words]).to_lower()
	r.custom_minimum_size = Vector2(0, 56)
	for m in [["margin_left", 12], ["margin_right", 12], ["margin_top", 8], ["margin_bottom", 8]]:
		r.add_theme_constant_override(m[0], m[1])
	var hb: HBoxContainer = main.hbox(16)
	r.add_child(hb)
	var tv: VBoxContainer = main.vbox(2)
	tv.size_flags_horizontal = SIZE_EXPAND_FILL
	tv.alignment = BoxContainer.ALIGNMENT_CENTER
	hb.add_child(tv)
	r.name_lbl = main.lbl(title, 15, UIParts.TEXT)
	tv.add_child(r.name_lbl)
	r.desc_lbl = main.lbl(desc, 12, UIParts.MUTED)
	r.desc_lbl.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	r.desc_lbl.visible = desc != ""
	tv.add_child(r.desc_lbl)
	var cb := HBoxContainer.new()
	cb.custom_minimum_size = Vector2(W_CTRL, 0)
	cb.alignment = BoxContainer.ALIGNMENT_END
	cb.size_flags_vertical = SIZE_SHRINK_CENTER
	cb.add_theme_constant_override("separation", 10)
	hb.add_child(cb)
	if ctrl != null:
		cb.add_child(ctrl)
	r.ctrl_box = cb
	pages[_page].add_child(r)
	_track(r)
	return r


func _track(r: Row) -> void:
	r.section = _sec
	if _sec != null:
		_sec.rows.append(r)
	rows.append(r)


func _toggle(title: String, desc: String, getv: Callable, setv: Callable, words := "") -> Row:
	var sw := Switch.new()
	sw.button_pressed = bool(getv.call())
	sw.toggled.connect(func(on):
		setv.call(on)
		Settings.save()
		main.audio.play("click", -10.0))
	refreshers.append(func(): sw.set_pressed_no_signal(bool(getv.call())))
	var r := _row(title, desc, sw, words)
	r.switch = sw
	return r


func _slider(title: String, desc: String, lo: float, hi: float, step: float, getv: Callable, fmt: Callable, setv: Callable, words := "") -> Row:
	var hb: HBoxContainer = main.hbox(10)
	var sl := SSlider.new()
	sl.min_value = lo
	sl.max_value = hi
	sl.step = step
	sl.value = float(getv.call())
	sl.custom_minimum_size = Vector2(W_CTRL - 62.0, 28)
	sl.size_flags_vertical = SIZE_SHRINK_CENTER
	var vl: Label = main.lbl(fmt.call(sl.value), 14, UIParts.TEXT)
	vl.add_theme_font_override("font", UIParts.font("num"))
	vl.custom_minimum_size = Vector2(52, 0)
	vl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	sl.value_changed.connect(func(v):
		vl.text = fmt.call(v)
		if not sl.has_meta("busy"):
			setv.call(v))
	sl.drag_ended.connect(func(_c): Settings.save())
	refreshers.append(func():
		sl.set_meta("busy", true)
		sl.value = float(getv.call())
		sl.remove_meta("busy")
		vl.text = fmt.call(sl.value))
	hb.add_child(sl)
	hb.add_child(vl)
	var r := _row(title, desc, hb, words)
	r.slider = sl
	return r


# Segmented buttons for a small choice. getv returns the selected index, setv(i) applies it.
func _seg(title: String, desc: String, opts: Array, getv: Callable, setv: Callable, words := "", w := W_CTRL) -> Row:
	var hb := HBoxContainer.new()
	hb.add_theme_constant_override("separation", 0)
	hb.custom_minimum_size = Vector2(w, 0)
	var btns: Array = []
	for i in opts.size():
		var b := Button.new()
		b.text = opts[i]
		b.toggle_mode = true
		b.focus_mode = FOCUS_NONE
		b.custom_minimum_size = Vector2(0, 32)
		b.size_flags_horizontal = SIZE_EXPAND_FILL
		b.add_theme_font_size_override("font_size", 13)
		_seg_style(b, i == 0, i == opts.size() - 1)
		var iv: int = i
		b.pressed.connect(func():
			setv.call(iv)
			Settings.save()
			for j in btns.size():
				btns[j].set_pressed_no_signal(j == int(getv.call()))
			refresh())
		hb.add_child(b)
		btns.append(b)
	var sync := func():
		for j in btns.size():
			btns[j].set_pressed_no_signal(j == int(getv.call()))
	sync.call()
	refreshers.append(sync)
	var r := _row(title, desc, hb, words)
	r.seg = btns
	return r


func _seg_style(b: Button, first: bool, last: bool) -> void:
	for st in [["normal", UIParts.STONE_1, UIParts.BRONZE_DARK.lightened(0.25)], ["hover", UIParts.STONE_2, UIParts.BRONZE],
			["pressed", Color("#b4b4ae"), UIParts.BRONZE_LITE], ["hover_pressed", Color("#c4c4be"), Color("#ffffff")],
			["disabled", Color(0.08, 0.07, 0.06), Color(0.22, 0.2, 0.17)]]:
		var s: StyleBoxFlat = main.sb(st[1], st[2], 0, 1, 6)
		s.content_margin_top = 4
		s.content_margin_bottom = 4
		if not first:
			s.border_width_left = 0
		if first:
			s.corner_radius_top_left = 4
			s.corner_radius_bottom_left = 4
		if last:
			s.corner_radius_top_right = 4
			s.corner_radius_bottom_right = 4
		b.add_theme_stylebox_override(st[0], s)
	b.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
	b.add_theme_color_override("font_color", UIParts.TEXT)
	b.add_theme_color_override("font_hover_color", UIParts.GOLD_TEXT)
	b.add_theme_color_override("font_pressed_color", UIParts.INK)
	b.add_theme_color_override("font_hover_pressed_color", UIParts.INK)


# A dropdown for a longer list.
func _drop(title: String, desc: String, opts: Array, getv: Callable, setv: Callable, words := "") -> Row:
	var ob := OptionButton.new()
	ob.focus_mode = FOCUS_NONE
	ob.custom_minimum_size = Vector2(200, 34)
	ob.add_theme_font_size_override("font_size", 14)
	for o in opts:
		ob.add_item(o)
	ob.select(int(getv.call()))
	ob.item_selected.connect(func(i):
		setv.call(i)
		Settings.save()
		refresh())
	var pp := ob.get_popup()
	pp.add_theme_stylebox_override("panel", main.stone_panel(6))
	pp.add_theme_stylebox_override("hover", main.sb(UIParts.STONE_2, UIParts.BRONZE, 2, 1, 4))
	pp.add_theme_color_override("font_color", UIParts.TEXT)
	pp.add_theme_color_override("font_hover_color", UIParts.GOLD_TEXT)
	pp.add_theme_font_size_override("font_size", 14)
	refreshers.append(func(): ob.select(int(getv.call())))
	var r := _row(title, desc, ob, words)
	r.drop = ob
	return r


