				alerts.append([u, 6.0])


func check_achievements() -> void:
	var me = sim.players[sim.local]
	var c = me.champ
	if me.gold >= 3000:
		award("rich")
	if me.interest >= 600:
		award("banker")
	if me.kills >= 400:
		award("kills_400")
	var legend := 0
	for id in c.items:
		var tier := int(GameData.item(id)["tier"])
		if tier == 4:
			award("mythic")
		if tier >= 3:
			legend += 1
	if legend >= GameData.INV_SLOTS:
		award("full_build")
	if sim.mode == "survival":
		if sim.round_no >= 20:
			award("surv_20")
		if sim.round_no >= 30:
			award("surv_30")
		if sim.round_no >= 40:
			award("surv_40")
		var four := 0
		for tg in sim.syn_counts:
			var n := int(sim.syn_counts[tg])
			if n >= 6:
				award("resonance")
			if n >= 4:
				four += 1
		if four >= 2:
			award("two_tiers")
		if sim.omens.size() >= 5:
			award("omens_5")
		if sim.gold_spent_cards >= 2000:
			award("high_roller")


# Act I/II/III of the campaign done (read-only look at Campaign's completed missions).
func check_campaign_achievements() -> void:
	Campaign.ensure()
	var done := [true, true, true]
	var seen := [false, false, false]
	for m in CampaignData.missions():
		var bk := clampi(int(m.get("book", 0)), 0, 2)
		seen[bk] = true
		if not Campaign.done(String(m["id"])):
			done[bk] = false
	for bk in 3:
		if seen[bk] and done[bk]:
			award(["act1", "act2", "act3"][bk])


func match_achievements(won: bool) -> void:
	var me = sim.players[sim.local]
	if sim.mode == "tutorial":
		award("tutorial")
	if won and not sim.surrender and sim.mode in ["classic", "quick"]:
		award("first_win")
		if me.deaths == 0:
			award("untouchable")
		if difficulty == 3:
			award("brutal")
		if Sim.map_id == 1:
			award("riverfork")
		if Sim.map_id == 2:
			award("ashfall")
		if Sim.map_id == 3:
			award("hollow")
	if sim.mode == "survival" and sim.daily > 0:
		award("daily_first")
		var streak := Profile.daily_streak(SurvivalData.today())
		if streak >= 3:
			award("streak_3")
		if streak >= 7:
			award("streak_7")
	check_campaign_achievements()
	for id in Profile.heroes:
		if Profile.mastery(id) >= 5:
			award("mastery_5")
	if Profile.heroes_played() >= 10:
		award("collector")
	check_achievements()



