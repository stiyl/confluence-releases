			lab.text = "FPS %d  Â·  %.1f ms  Â·  worst %.1f ms\n%s" % [roundi(_n / _acc), ms, _worst * 1000.0, Settings.GFX_NAMES[Settings.gfx()]]
			_acc = 0.0
			_n = 0
