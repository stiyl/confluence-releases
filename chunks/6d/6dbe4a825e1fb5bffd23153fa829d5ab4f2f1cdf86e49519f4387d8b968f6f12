		_build_ftip_box()
	ftip_cur = ftip_queue.pop_front()
	var d: Dictionary = TipsData.TIPS[ftip_cur]
	ftip_title.text = d["title"]
	ftip_text.text = CampaignUI.keys(String(d["text"]))
	ftip_box.visible = true
	ftip_t = 22.0
	audio.play("click", -6.0)


func _dismiss_tip() -> void:
	if ftip_cur != "":
		Profile.tips_seen[ftip_cur] = true
		Profile.save()
	ftip_cur = ""
	_next_tip()


func _tip_poll(delta: float) -> void:
	if ftip_cur != "":
		ftip_t -= delta
		if ftip_t <= 0.0 or not _tips_on() or sim.over:
			_dismiss_tip()
	if not _tips_on() or sim.over:
		return
	ftip_poll_t -= delta
	if ftip_poll_t > 0.0:
		return
	ftip_poll_t = 0.5
	var me = sim.players[sim.local]
	var c = me.champ
	if sim.mode == "survival":
		if sim.card_offer.is_empty() and sim.t > 1.0:
			tip("survival")
		if not sim.card_offer.is_empty():
			tip("cards")
		if not sim.card_offer.is_empty() and sim.round_no >= 2:
			tip("synergy")
		for m in sim.arenas[me.team].mons:
			if m.elite != "" and not m.dead:
				tip("elite")
				break
	elif sim.t > 2.0:
		tip("basics")
		if not Profile.tips_seen.has("basics") and ftip_cur != "basics":
			return   # a new player reads "Hold your road" before anything else
		if me.tech == 0 and me.gold >= 60 and sim.round_no >= 1:
			tip("sends")
		if sim.in_setup():
			tip("setup")   # 0.17: the setup minute
		if sim.vote_on[myt()] or sim.team_ready[1 - myt()] or (sim.round_no >= 3 and sim.vote_refusal(myt()) == ""):
			tip("vote")    # 0.17: "start next round"
		if me.gold >= 300 and sim.round_no >= 2:
			tip("interest")
		if me.gold >= 260 and c.items.is_empty() and sim.round_no >= 2:
			tip("armory")
	if sim.mode != "survival" and not Profile.tips_seen.has("basics"):
		return
	if c.points > 0:
		for i in 4:
			if sim.can_learn(c, i):
				tip("learn")
				break
	if not c.items.is_empty():
		tip("attributes")
	if sim.duel_on:
		tip("duel")
	if sim.any_camp_up(sim.arenas[me.team]):
		tip("camp")


