		draw_string_outline(fnt, Vector2(c.x - w / 2.0, y), t, HORIZONTAL_ALIGNMENT_CENTER, w, s, 4, Color(0, 0, 0, 0.9))
		draw_string(fnt, Vector2(c.x - w / 2.0, y), t, HORIZONTAL_ALIGNMENT_CENTER, w, s, col)


# ================================================================= on-screen keyboard
# Godot's own virtual keyboard does nothing on desktop Linux, so a text box focused while the pad is in use gets
# this small plaque: the cursor (or the d-pad) picks a key, A types it. B deletes, X is space, Y shift, Start done.
# (On a Steam Deck with Steam running, Steam's floating keyboard opens instead: scripts/net.gd on_gui_focus.)
class Osk extends Control:
	const ROWS := ["1234567890", "qwertyuiop", "asdfghjkl'", "zxcvbnm-_.", ""]
	var pad
	var target: LineEdit = null
	var shift := false
	var plate: UIParts.Plaque
	var grid: VBoxContainer
	var keys: Array = []      # rows of Buttons
	var hi := Vector2i(0, 1)

	func _init(p) -> void:
		pad = p
		visible = false
		set_anchors_preset(Control.PRESET_FULL_RECT)
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		plate = UIParts.Plaque.new(10.0)
		plate.mouse_filter = Control.MOUSE_FILTER_STOP
		add_child(plate)
		grid = VBoxContainer.new()
		grid.add_theme_constant_override("separation", 4)
		plate.add_child(grid)
		for ri in ROWS.size():
			var row := HBoxContainer.new()
			row.add_theme_constant_override("separation", 4)
			row.alignment = BoxContainer.ALIGNMENT_CENTER
			grid.add_child(row)
			var line: Array = []
			var labels: Array = []
			if ROWS[ri] == "":
				labels = ["Shift", "Space", "Delete", "Done"]
			else:
				for ch in ROWS[ri]:
					labels.append(ch)
			for t in labels:
				var b := Button.new()
				b.focus_mode = Control.FOCUS_NONE
				b.custom_minimum_size = Vector2(40, 36) if t.length() == 1 else Vector2(104 if t == "Space" else 84, 36)
				b.add_theme_font_size_override("font_size", 16)
				b.set_meta("k", t)
				var tt: String = t
				b.pressed.connect(func(): _press(tt))
				row.add_child(b)
				line.append(b)
			keys.append(line)
		relabel()

	func open(le: LineEdit) -> void:
		target = le
		visible = true
		relabel()
		await get_tree().process_frame
		_place()

	func close() -> void:
		visible = false
		target = null

	func _place() -> void:
		var ps := plate.get_combined_minimum_size()
		plate.size = ps
		# right under the box being typed into (above it when there is no room), never over it
		var y := size.y - ps.y - 24.0
		var x := (size.x - ps.x) / 2.0
		if target != null and is_instance_valid(target):
			var tr := target.get_global_rect()
			y = tr.end.y + 10.0
			if y + ps.y > size.y - 8.0:
				y = maxf(8.0, tr.position.y - ps.y - 10.0)
			x = clampf(tr.get_center().x - ps.x / 2.0, 8.0, size.x - ps.x - 8.0)
		plate.position = Vector2(x, y)

	func relabel() -> void:
		for line in keys:
			for b in line:
				var k: String = b.get_meta("k")
				b.text = k.to_upper() if shift and k.length() == 1 else k
				if k == "Shift":
					b.button_pressed = shift
		_hilite()

	func _hilite() -> void:
		for ri in keys.size():
			for ci in keys[ri].size():
				var b: Button = keys[ri][ci]
				b.modulate = Color(1.25, 1.25, 1.2) if Vector2i(ci, ri) == hi else Color.WHITE

	func nav(d: Vector2i) -> void:
		hi.y = clampi(hi.y + d.y, 0, keys.size() - 1)
		hi.x = clampi(hi.x + d.x, 0, keys[hi.y].size() - 1)
		_hilite()
		var b: Button = keys[hi.y][hi.x]
		pad.place_cursor(b.get_global_rect().get_center())

	func _press(k: String) -> void:
		match k:
			"Shift":
				shift = not shift
				relabel()
			"Space":
				type(" ")
			"Delete":
				backspace()
			"Done":
				done()
			_:
				type(k.to_upper() if shift else k)

	func _ok() -> bool:
		return target != null and is_instance_valid(target) and target.is_visible_in_tree()

	func type(s: String) -> void:
		if not _ok():
			return
		if target.max_length > 0 and target.text.length() >= target.max_length:
			return
		target.insert_text_at_caret(s)
		target.text_changed.emit(target.text)

	func backspace() -> void:
		if not _ok() or target.caret_column <= 0:
			return
		var c := target.caret_column
		target.text = target.text.substr(0, c - 1) + target.text.substr(c)
		target.caret_column = c - 1
		target.text_changed.emit(target.text)

	func caret(d: int) -> void:
		if _ok():
			target.caret_column = clampi(target.caret_column + d, 0, target.text.length())

	func done() -> void:
		if not _ok():
			close()
			return
		var t := target
		t.text_submitted.emit(t.text)
		if is_instance_valid(t) and t.has_focus():
			t.release_focus()
		close()
# 0.30: parties. Up to 8 friends grouped from the main menu before any lobby exists; the leader hosts an online
# lobby and every member's game follows it on its own (no room code), lands on the leader's team and keeps its hero.
#
# Transport: a party is a small relay room of its own ("party room", relay/worker.js: /host?party=1 and
# /join/<CODE>?party=1), on a socket separate from the match socket, so the party lives on through matches. The
# leader is relay peer 1 and keeps the roster; members send it tiny JSON packets (same binary framing as the game:
# int32 target / sender id, then UTF-8 JSON):
#   member -> leader  {"t":"hi", name, code, lvl, hero, ver}   {"t":"me", lvl, hero, ready}   {"t":"chat", text}
#                     {"t":"inv", code}  (a member invited a friend: the leader lets that friend in)
#   leader -> all     {"t":"roster", m:[{id,name,code,lvl,hero,ready}], room, mode, last, inv:[codes]}
#                     {"t":"go", room, mode}  (the leader opened a lobby: join it)   {"t":"chat", text}
#                     {"t":"no", msg}  (to one member, before it is removed)
# Leaving: the relay promotes the longest member (lowest id) to peer 1 = the new leader; "Promote" hands the lead
# over with the relay's {"t":"handover"}; "Kick" is the relay's kick. Keep-alive: {"t":"pp"} every 30 s, answered
# by Cloudflare without waking the room. Invites go through the Directory (scripts/account.gd invite_party).
# An older relay opens an ordinary room for /host?party=1 (no "party":true in its answer) and its Directory has no
# caps.party: the party bar then says the relay needs the update and nothing else changes.
extends Node

const Avatars := preload("res://scripts/avatars.gd")

signal changed                     # roster, state, note or lobby changed
signal notice(text: String)        # short news for a toast ("Birch joined the party.")
signal chat_line(text: String)     # a party chat line (main.gd also shows it in the lobby / match chat as "[Party] ...")

const MAX_MEMBERS := 8
const PING_EVERY := 30.0
const RECONNECT_FOR := 60.0        # a dropped party socket retries this long
const RECONNECT_EVERY := 3.0
const CONNECT_TIMEOUT := 12.0
const INVITE_AGE := 120000        # ms: party invites expire after 2 minutes (as on the server)
const OLD_RELAY_NOTE := "Parties need the relay update (relay/deploy.bat)."

var main
var acct
var net
var ws: WebSocketPeer = null
var state := ""                    # "": no party Â· "opening" Â· "joining" Â· "in" Â· "lost" (reconnecting)
var code := ""                     # the party room code
var secret := ""                   # leader: proves the room is ours (re-claim after a drop)
var my_id := 0
var members := {}                  # relay id -> {"name", "code", "lvl", "hero", "ready"} (the leader is id 1)
var invited := {}                  # friend code (ABCD1234) -> ms: invited into this party, allowed in
var allowed := {}                  # friend codes of everyone who has been a member: allowed back (a reconnect, a new leader)
var lobby_room := ""               # the leader's open online lobby ("" = none)
var lobby_mode := ""
var last_mode := ""                # the mode of the party's last lobby ("Play again")
var chat_lines: Array = []
var note := ""                     # a line for the party bar (old relay, errors)
var unsupported := false           # the relay has no party rooms
var my_ready := false              # member: my ready tick
var _inv_queue: Array = []         # [friend code, name] waiting for the party code
var _ping_t := 0.0
var _conn_t := 0.0
var _ws_state := WebSocketPeer.STATE_CLOSED
var _rc_left := 0.0
var _rc_wait := 0.0
var _closing := false
var _close_msg := ""
var _announced := "-"
var _pending_mode := ""
var _hero_seen := ""
var _lvl_seen := 0
var _av_seen := ""                 # 0.32.1: my profile picture as the others last heard it
var _joined_room := ""             # member: the lobby we followed last (not followed again after leaving it)
var _pick_due := false
var _join_code := ""               # member: the party we are joining / in
var _chat_rate := {}               # leader: member id -> [window start ms, n] (5 lines per 5 s)


func _init(m, a, n) -> void:
	main = m
	acct = a
	net = n
	name = "Party"


func _ready() -> void:
	acct.party_size = func() -> int: return members.size() if state != "" else 0
	acct.party_declined.connect(_on_declined)


# ---------------------------------------------------------------- queries
func active() -> bool:
	return state != ""


func is_leader() -> bool:
	return state == "in" and my_id == 1


func count() -> int:
	return maxi(1, members.size()) if state != "" else 1


# Party members can't start single player without leaving (the party would wait for nobody).
func blocks_solo() -> bool:
	return state != "" and members.size() > 1


func leader_name() -> String:
	return String(members.get(1, {}).get("name", ""))


static func norm(c: String) -> String:
	return c.replace("-", "").strip_edges().to_upper()


func has_member_code(c: String) -> bool:
	for id in members:
		if norm(String(members[id].get("code", ""))) == norm(c):
			return true
	return false


func ordered_ids() -> Array:
	var ids := members.keys()
	ids.sort()
	return ids


func relay_note() -> String:
	if unsupported or acct.party_caps == 0:
		return OLD_RELAY_NOTE
	return ""


func _base() -> String:
	return String(net.relay_url).rstrip("/")


# ---------------------------------------------------------------- actions
func create() -> void:
	if state != "":
		return
	if not net.relay_configured():
		note = "Parties need the online relay."
		changed.emit()
		return
	if acct.party_caps == 0:
		unsupported = true
		note = OLD_RELAY_NOTE
		changed.emit()
		return
	_connect(_base() + "/host?party=1")
	state = "opening"
	note = ""
	changed.emit()


func join(room: String) -> void:
	room = norm(room)
	if room == "" or (state != "" and room == code):
		return
	if state != "":
		leave(true)
	_join_code = room
	code = room
	members.clear()
	_connect(_base() + "/join/" + room.uri_encode() + "?party=1")
	state = "joining"
	note = ""
	acct.party_invites = acct.party_invites.filter(func(i): return String(i["room"]) != room)
	changed.emit()


func leave(quiet := false) -> void:
	if state == "":
		return
	if ws != null:
		_closing = true
		if ws.get_ready_state() == WebSocketPeer.STATE_OPEN:
			if my_id == 1:
				ws.send_text('{"t":"bye"}')   # a deliberate leave: the next leader takes over at once
			ws.close(1000, "left")
	_reset()
	if not quiet:
		notice.emit("You left the party.")
	changed.emit()


func _reset() -> void:
	state = ""
	code = ""
	secret = ""
	my_id = 0
	members.clear()
	invited.clear()
	allowed.clear()
	lobby_room = ""
	lobby_mode = ""
	chat_lines.clear()
	my_ready = false
	_inv_queue.clear()
	_announced = "-"
	_pending_mode = ""
	_joined_room = ""
	_rc_left = 0.0
	_join_code = ""
	net.party_code = ""


# Invites a friend (code ABCD-1234); makes the party first when there is none.
func invite(friend_code: String, fname: String, cb := Callable()) -> void:
	if relay_note() != "":
		note = relay_note()
		changed.emit()
		if cb.is_valid():
			cb.call({"ok": false, "msg": note})
		return
	if count() >= MAX_MEMBERS:
		if cb.is_valid():
			cb.call({"ok": false, "msg": "The party is full (%d)." % MAX_MEMBERS})
		return
	invited[norm(friend_code)] = Time.get_ticks_msec()
	if state != "in":
		_inv_queue.append([friend_code, fname, cb])
		if state == "":
			create()
		return
	_send_invite(friend_code, fname, cb)


func _send_invite(friend_code: String, fname: String, cb: Callable) -> void:
	if my_id != 1:
		_send(1, {"t": "inv", "code": norm(friend_code)})
	acct.invite_party(friend_code, code, func(res: Dictionary):
		if bool(res.get("ok", false)):
			note = "Invited %s. Waiting for an answerâ€¦" % fname
		else:
			invited.erase(norm(friend_code))
			note = String(res.get("msg", "Couldn't invite %s." % fname))
		changed.emit()
		if cb.is_valid():
			cb.call(res))


func _on_declined(fname: String, fcode: String) -> void:
	if state == "":
		return
	invited.erase(norm(fcode))
	note = "%s declined your party invite." % fname
	notice.emit(note)
	changed.emit()


func kick(id: int) -> void:
	if not is_leader() or id == 1 or not members.has(id):
		return
	_send(id, {"t": "no", "msg": "The leader removed you from the party."})
	ws.send_text(JSON.stringify({"t": "kick", "id": id}))


func promote(id: int) -> void:
	if not is_leader() or id == 1 or not members.has(id):
		return
	ws.send_text(JSON.stringify({"t": "handover", "id": id}))


func set_ready(v: bool) -> void:
	my_ready = v
	if is_leader():
		return
	if state == "in":
		_send(1, _me_msg())


func say(text: String) -> void:
	text = text.strip_edges().substr(0, 200)
	if text == "" or state != "in":
		return
	if is_leader():
		_chat_all("%s: %s" % [acct.profile_name, text])
	else:
		_send(1, {"t": "chat", "text": text})


# Leader: host the party's last mode again; the members follow.
func play_again() -> void:
	if not is_leader():
		return
	_pending_mode = last_mode if last_mode != "" else "classic"
	main.show_mp()
	net.my_name = acct.profile_name
	net.host_relay()


# Member: follow the leader's open lobby now (the party bar's button, or automatically).
func follow() -> void:
	if lobby_room == "" or my_id == 1:
		return
	_joined_room = lobby_room
	_pick_due = true
	main.party_follow(lobby_room)


# ---------------------------------------------------------------- socket
func _connect(url: String) -> void:
	if ws != null and ws.get_ready_state() != WebSocketPeer.STATE_CLOSED:
		_closing = true
		ws.close()
	ws = WebSocketPeer.new()
	ws.inbound_buffer_size = 1 << 18
	ws.outbound_buffer_size = 1 << 18
	_closing = false
	_close_msg = ""
	_conn_t = 0.0
	_ws_state = WebSocketPeer.STATE_CONNECTING
	var err := ws.connect_to_url(url)
	if err != OK:
		_ws_state = WebSocketPeer.STATE_CLOSED
		note = "Couldn't reach the relay for the party."


func _send(target: int, msg: Dictionary) -> void:
	if ws == null or ws.get_ready_state() != WebSocketPeer.STATE_OPEN:
		return
	var body := JSON.stringify(msg).to_utf8_buffer()
	var pkt := PackedByteArray()
	pkt.resize(4)
	pkt.encode_s32(0, target)
	pkt.append_array(body)
	ws.send(pkt)


func _me_msg() -> Dictionary:
	return {"t": "me", "lvl": acct.level(), "hero": String(main.sel_id), "ready": my_ready, "av": acct.avatar}


func _my_entry() -> Dictionary:
	return {"name": acct.profile_name, "code": acct.friend_code, "lvl": acct.level(), "hero": String(main.sel_id), "ready": my_ready, "av": acct.avatar}


func _process(dt: float) -> void:
	if ws != null:
		_poll(dt)
	if state == "lost":
		_rc_left -= dt
		_rc_wait -= dt
		if _rc_left <= 0.0:
			var was_code := code
			_reset()
			note = "Lost the party connection."
			notice.emit("Lost the connection to the party %s." % was_code)
			changed.emit()
		elif _rc_wait <= 0.0 and (ws == null or ws.get_ready_state() == WebSocketPeer.STATE_CLOSED):
			_rc_wait = RECONNECT_EVERY
			if my_id == 1 and secret != "":
				_connect(_base() + "/host?code=" + code.uri_encode() + "&secret=" + secret.uri_encode() + "&party=1")
			else:
				_connect(_base() + "/join/" + code.uri_encode() + "?party=1")
	if state != "in":
		return
	net.party_code = code
	# my hero / level changed: tell the others
	var hero := String(main.sel_id)
	if hero != _hero_seen or acct.level() != _lvl_seen or acct.avatar != _av_seen:
		_hero_seen = hero
		_lvl_seen = acct.level()
		_av_seen = acct.avatar
		if members.has(my_id):
			members[my_id]["hero"] = hero
			members[my_id]["lvl"] = _lvl_seen
			members[my_id]["av"] = _av_seen
		if is_leader():
			_push_roster()
		else:
			_send(1, _me_msg())
	if is_leader():
		_leader_watch()
	else:
		if lobby_room != "" and lobby_room != _joined_room and _free():
			follow()
		if _pick_due and net.in_lobby and not net.is_host and net.my_slot() >= 0:
			_pick_due = false
			if String(net.lobby.get("mode", "")) != "allrandom":
				net.pick(String(main.sel_id))   # keep my own hero


# A member's game may follow the leader into a lobby now: not in another lobby, not playing.
func _free() -> bool:
	if net.in_lobby or (net.transport != "" and not net.in_match):
		return false
	if net.in_match and main.sim != null and not main.sim.over:
		return false
	if main.game != null and main.game.visible and main.sim != null and not main.sim.over:
		return false
	if main.replay_mode or (main.campaign_ui != null and main.campaign_ui.in_mission()):
		return false
	return true


# Leader: announce the online lobby we host (members follow it), its mode, and the end of it.
func _leader_watch() -> void:
	var room := ""
	if net.in_lobby and net.is_host and net.transport == "relay" and String(net.room_code) != "":
		room = String(net.room_code)
		if _pending_mode != "" and not net.lobby.is_empty():
			net.set_option("mode", _pending_mode)
			_pending_mode = ""
	var mode := String(net.lobby.get("mode", "")) if room != "" else ""
	if room != _announced or (room != "" and mode != lobby_mode):
		var fresh := room != _announced and room != ""
		_announced = room
		lobby_room = room
		lobby_mode = mode
		if mode != "":
			last_mode = mode
		_push_roster()
		if fresh:
			_send(0, {"t": "go", "room": room, "mode": mode})


func _poll(dt: float) -> void:
	ws.poll()
	var st := ws.get_ready_state()
	if st == WebSocketPeer.STATE_OPEN or st == WebSocketPeer.STATE_CLOSING or (st == WebSocketPeer.STATE_CLOSED and _ws_state != WebSocketPeer.STATE_CLOSED):
		while ws.get_available_packet_count() > 0:
			var pkt := ws.get_packet()
			if ws.was_string_packet():
				_control(pkt.get_string_from_utf8())
			elif pkt.size() >= 4:
				var m = JSON.parse_string(pkt.slice(4).get_string_from_utf8())
				if m is Dictionary:
					_packet(pkt.decode_s32(0), m)
			if ws == null:
				return
	if st == WebSocketPeer.STATE_OPEN:
		_ping_t += dt
		if _ping_t > PING_EVERY:
			_ping_t = 0.0
			ws.send_text('{"t":"pp"}')
	elif st == WebSocketPeer.STATE_CONNECTING:
		_conn_t += dt
		if _conn_t > CONNECT_TIMEOUT:
			ws.close()
	if st == WebSocketPeer.STATE_CLOSED and _ws_state != WebSocketPeer.STATE_CLOSED:
		_ws_state = st
		_on_closed(ws.get_close_code(), ws.get_close_reason())
		return
	_ws_state = st


func _on_closed(cc: int, reason: String) -> void:
	print("[party] socket closed: code %d reason '%s' (state %s, id %d, party %s)" % [cc, reason, state, my_id, code])
	if _closing:
		_closing = false
		return
	var was := state
	if cc == 4010 and was == "lost":
		# our re-claim was refused: another member leads now; come back as a member
		my_id = 0
		_connect(_base() + "/join/" + code.uri_encode() + "?party=1")
		return
	var final := {4001: "You were removed from the party.", 4004: "That party is gone.", 4009: "That party is full.", 4000: "The party closed."}
	if final.has(cc) or was == "opening" or (was == "joining" and _rc_left <= 0.0):
		var msg := String(final.get(cc, ""))
		if _close_msg != "" and cc != 4004:
			msg = _close_msg
		if msg == "":
			msg = "Couldn't reach the relay for the party." if was == "opening" else "Couldn't join the party."
		_reset()
		note = msg
		notice.emit(msg)
		changed.emit()
		return
	if was == "in" or was == "lost" or was == "joining":
		if was != "lost":
			state = "lost"
			_rc_left = RECONNECT_FOR
			note = "Reconnecting to the partyâ€¦"
			changed.emit()
		_rc_wait = RECONNECT_EVERY if was == "lost" else 0.5


func _control(text: String) -> void:
	var m = JSON.parse_string(text)
	if not m is Dictionary:
		return
	match String(m.get("t", "")):
		"room":
			if not bool(m.get("party", false)):
				# an older relay: it opened an ordinary game room for us
				unsupported = true
				_closing = true
				ws.send_text('{"t":"bye"}')
				ws.close(1000, "no party rooms")
				var queued := _inv_queue.duplicate()
				_reset()
				note = OLD_RELAY_NOTE
				for q in queued:
					if q[2].is_valid():
						q[2].call({"ok": false, "msg": OLD_RELAY_NOTE})
				changed.emit()
				return
			var back := state == "lost"
			code = String(m["code"])
			secret = String(m.get("secret", ""))
			my_id = 1
			state = "in"
			note = ""
			if not back:
				members = {1: _my_entry()}
			else:
				_keep_only(m.get("peers", []), 1)
			_rc_left = 0.0
			net.party_code = code
			_push_roster()
			var queued2 := _inv_queue.duplicate()
			_inv_queue.clear()
			for q in queued2:
				_send_invite(String(q[0]), String(q[1]), q[2])
			changed.emit()
		"welcome":
			my_id = int(m["id"])
			state = "in"
			_rc_left = 0.0
			note = ""
			_send(1, {"t": "hi", "name": acct.profile_name, "code": acct.friend_code, "lvl": acct.level(), "hero": String(main.sel_id),
				"ready": my_ready, "ver": Net.game_version(), "av": acct.avatar})
			net.party_code = code
			var queued3 := _inv_queue.duplicate()
			_inv_queue.clear()
			for q in queued3:
				_send_invite(String(q[0]), String(q[1]), q[2])
			changed.emit()
		"peer_out":
			var id := int(m.get("id", 0))
			if is_leader() and members.has(id):
				var nm := String(members[id].get("name", ""))
				members.erase(id)
				_push_roster()
				_chat_all("%s left the party." % nm)
				changed.emit()
		"promoted":
			var was := int(m.get("was", 0))
			var peers: Array = m.get("peers", [])
			secret = String(m.get("secret", ""))
			var old_leader := String(members.get(1, {}).get("name", ""))
			var mine: Dictionary = members.get(was, _my_entry())
			if peers.has(float(was)) or peers.has(was):
				# a handover: the old leader is peer `was` now
				var ol: Dictionary = members.get(1, {})
				members.erase(1)
				members.erase(was)
				if not ol.is_empty():
					members[was] = ol
			else:
				members.erase(1)
				members.erase(was)
				_chat_all("%s left the party." % old_leader if old_leader != "" else "The leader left the party.")
			members[1] = mine
			members[1]["ready"] = true
			my_id = 1
			_keep_only(peers, 1)
			_announced = "-"
			lobby_room = ""
			_push_roster()
			notice.emit("You lead the party now.")
			changed.emit()
		"demoted":
			my_id = int(m.get("id", my_id))
			lobby_room = ""
			_announced = "-"
			changed.emit()
		"error", "closed":
			if _close_msg == "":
				_close_msg = String(m.get("msg", ""))


# Drops roster entries whose sockets the relay no longer has.
func _keep_only(peers: Array, me: int) -> void:
	var keep := {me: true}
	for p in peers:
		keep[int(p)] = true
	for id in members.keys():
		if not keep.has(int(id)):
			members.erase(id)


func _packet(from: int, m: Dictionary) -> void:
	var t := String(m.get("t", ""))
	if is_leader():
		match t:
			"hi":
				var fc := norm(String(m.get("code", "")))
				var why := ""
				if String(m.get("ver", "")) != Net.game_version():
					why = "Your game version (%s) differs from the leader's (%s)." % [String(m.get("ver", "?")), Net.game_version()]
				elif members.size() >= MAX_MEMBERS:
					why = "That party is full."
				elif not (invited.has(fc) or allowed.has(fc) or _is_friend(fc)):
					why = "You need an invite to join that party."
				if why != "":
					_send(from, {"t": "no", "msg": why})
					ws.send_text(JSON.stringify({"t": "kick", "id": from}))
					return
				invited.erase(fc)
				allowed[fc] = true
				for oid in members.keys():   # the same player back on a new socket before the relay noticed the old one
					if int(oid) != 1 and norm(String(members[oid].get("code", ""))) == fc:
						members.erase(oid)
				members[from] = {"name": String(m.get("name", "?")).substr(0, 20), "code": String(m.get("code", "")), "lvl": clampi(int(m.get("lvl", 1)), 1, 999),
					"hero": String(m.get("hero", "")), "ready": bool(m.get("ready", false)), "av": Avatars.clean(String(m.get("av", "")))}
				_push_roster()
				_chat_all("%s joined the party." % members[from]["name"])
				if lobby_room != "":
					_send(from, {"t": "go", "room": lobby_room, "mode": lobby_mode})
				note = ""
				changed.emit()
			"me":
				if members.has(from):
					members[from]["lvl"] = clampi(int(m.get("lvl", 1)), 1, 999)
					members[from]["hero"] = String(m.get("hero", ""))
					members[from]["ready"] = bool(m.get("ready", false))
					members[from]["av"] = Avatars.clean(String(m.get("av", "")))
					_push_roster()
					changed.emit()
			"chat":
				if members.has(from):
					var now := Time.get_ticks_msec()
					var r: Array = _chat_rate.get(from, [now, 0])
					if now - int(r[0]) > 5000:
						r = [now, 0]
					r[1] = int(r[1]) + 1
					_chat_rate[from] = r
					if int(r[1]) > 5:
						return   # more than 5 lines in 5 s: dropped
					_chat_all("%s: %s" % [String(members[from]["name"]), String(m.get("text", "")).strip_edges().substr(0, 200)])
			"inv":
				invited[norm(String(m.get("code", "")))] = Time.get_ticks_msec()
		return
	if from != 1:
		return
	match t:
		"roster":
			var nm := {}
			for e in m.get("m", []):
				nm[int(e.get("id", 0))] = {"name": String(e.get("name", "?")), "code": String(e.get("code", "")), "lvl": int(e.get("lvl", 1)),
					"hero": String(e.get("hero", "")), "ready": bool(e.get("ready", false)), "av": Avatars.clean(String(e.get("av", "")))}
			var had := members.size()
			members = nm
			if had == 0 and members.size() > 1:
				notice.emit("You joined %s's party." % leader_name())
			lobby_room = String(m.get("room", ""))
			lobby_mode = String(m.get("mode", ""))
			last_mode = String(m.get("last", last_mode))
			invited.clear()
			for c in m.get("inv", []):
				invited[String(c)] = Time.get_ticks_msec()
			for id in members:
				allowed[norm(String(members[id].get("code", "")))] = true
			if lobby_room == "":
				_joined_room = ""
			changed.emit()
		"go":
			lobby_room = String(m.get("room", ""))
			lobby_mode = String(m.get("mode", ""))
			changed.emit()
		"chat":
			_chat_line(String(m.get("text", "")))
		"no":
			var msg := String(m.get("msg", "The party refused you."))
			_close_msg = msg


func _is_friend(fc: String) -> bool:
	for f in acct.friends:
		if norm(String(f.get("code", ""))) == fc:
			return true
	return false


func _push_roster() -> void:
	if not is_leader():
		return
	if members.has(1):
		members[1]["ready"] = true
		members[1]["name"] = acct.profile_name
	var arr: Array = []
	for id in ordered_ids():
		var e: Dictionary = members[id].duplicate()
		e["id"] = id
		arr.append(e)
	var now := Time.get_ticks_msec()
	for c in invited.keys():
		if now - int(invited[c]) > INVITE_AGE:
			invited.erase(c)
	var inv: Array = invited.keys()
	for c in allowed:
		if not inv.has(c):
			inv.append(c)
	_send(0, {"t": "roster", "m": arr, "room": lobby_room, "mode": lobby_mode, "last": last_mode, "inv": inv})
	changed.emit()


func _chat_all(text: String) -> void:
	_send(0, {"t": "chat", "text": text})
	_chat_line(text)


func _chat_line(text: String) -> void:
	chat_lines.append(text)
	while chat_lines.size() > 40:   # 0.32.1: the party dropdown scrolls back (was 6)
		chat_lines.pop_front()
	chat_line.emit(text)
	changed.emit()
# 0.30: the party bar on the main menu (under the profile plate) and the small friend picker its "+" slot opens.
