# Called every frame by the HUD while a match runs; returns how many ticks were stepped.
func run(delta: float) -> int:
	if sim == null or is_dropped or rejoining:
		return 0
	if not _cu.is_empty():
		var t0 := tick
		_run_catchup()
		return tick - t0
	if _rc_hold:
		_run_hold(delta)
		return 0
	if migrating or _mig_fill_wait:
		if is_host and migrating:
			_run_migration(delta)
		elif Time.get_ticks_msec() - _last_bundle_ms > STALL_DROP * 1000.0:
			_fail("The new host didn't answer.")
		return 0
	var n := 0
	var now := Time.get_ticks_msec()
	if is_host:
		acc = minf(acc + delta, 0.25)
		while acc >= TICK:
			acc -= TICK
			var cmds: Array = []
			if tick % BUNDLE_EVERY == 0:
				cmds = pending
				pending = []
				if _peer_ok():
					_bundle.rpc(tick, cmds)
			_exec(cmds)
			n += 1
		# a player whose game stopped answering (crash, lost connection) is dropped so the match goes on
		for pid in _peer_seen.keys():
			if pid != 1 and peer_slot.has(pid) and now - int(_peer_seen[pid]) > PEER_DROP * 1000.0:
				_log("peer %d silent for %ds: dropping" % [pid, int(PEER_DROP)])
				_peer_seen.erase(pid)
				if multiplayer.multiplayer_peer != null:
					multiplayer.multiplayer_peer.disconnect_peer(pid)
				_on_peer_disconnected(pid)
		# 0.26: after a re-claim, players who didn't come back in time hand their heroes to the AI
		for slot in _rc_missing.keys():
			if now < int(_rc_missing[slot]):
				continue
			_rc_missing.erase(slot)
			if peer_slot.values().has(slot) or not sim.players[slot].human:
				continue
			pending.append([slot, "drop", []])
			_chat_all("%s didn't come back â€” slot held by AI." % String(match_cfg["lineup"][slot].get("name", "A player")))
	else:
		# Jitter buffer: play at a steady 60 ticks a second, BUFFER_TICKS behind the newest bundle, so bundles
		# that arrive in bursts don't turn into stutter. Catch up gently when far behind (after loading).
		var ahead := _newest - tick + 1          # bundles waiting to be played
		if _buffering:
			if ahead >= BUFFER_TICKS or (ahead > 0 and now - _last_bundle_ms > 300):
				_buffering = false
		if not _buffering:
			var speed := 1.0
			if ahead > BUFFER_TICKS * 6:
				speed = 4.0
			elif ahead > BUFFER_TICKS * 2:
				speed = 1.5
			elif ahead < BUFFER_TICKS / 2:
				speed = 0.85
			acc = minf(acc + delta * speed, TICK * 10)
			var budget := 24
			while acc >= TICK and budget > 0 and bundles.has(tick):
				acc -= TICK
				var cmds: Array = bundles[tick]
				bundles.erase(tick)
				_exec(cmds)
				budget -= 1
				n += 1
			if not bundles.has(tick):
				acc = minf(acc, TICK)         # don't bank time while starved
				if ahead <= 0:
					_buffering = true          # refill the buffer before playing on
		# watchdog: no word from the host
		var silent := (now - _last_bundle_ms) / 1000.0
		if silent > STALL_WARN and not _stalled:
			_stalled = true
			_log("no bundle from the host for %.1fs" % silent)
			stall_changed.emit(true, silent)
		elif _stalled and silent <= STALL_WARN:
			_stalled = false
			_log("host is back")
			stall_changed.emit(false, 0.0)
		elif _stalled:
			stall_changed.emit(true, silent)
		if silent > STALL_DROP:
			_fail("Lost the connection to the host: no word from them for %d seconds." % int(STALL_DROP))
	return n


@rpc("authority", "reliable")
func _bundle(t: int, cmds: Array) -> void:
	bundles[t] = cmds
	for k in range(1, BUNDLE_EVERY):
		bundles[t + k] = []           # the steps between bundles carry no commands
	_newest = maxi(_newest, t + BUNDLE_EVERY - 1)
	_last_bundle_ms = Time.get_ticks_msec()


func _exec(cmds: Array, log_it := true) -> void:
	if log_it and not cmds.is_empty():
		cmd_log.append([tick, cmds])
	for c in cmds:
		sim.apply_cmd(int(c[0]), String(c[1]), c[2])
	sim.step(TICK)
	tick += 1
	if tick % SUM_EVERY == 0:
		var h := sim.checksum()
		if tick % 600 == 0:
			sum_trace[tick] = h      # every 10 s, for the tests (and the log) to compare across games
		if is_host:
			sums[tick] = h
			if sums.size() > 20:
				sums.erase(sums.keys().min())
		elif _peer_ok() and _cu.is_empty():
			_sum.rpc_id(1, tick, h)


@rpc("any_peer", "reliable")
func _sum(t: int, h: int) -> void:
	_peer_seen[multiplayer.get_remote_sender_id()] = Time.get_ticks_msec()
	if not is_host or desynced or not sums.has(t):
		return
	if int(sums[t]) != h:
		desynced = true
		_log("DESYNC at tick %d" % t)
		var pid := multiplayer.get_remote_sender_id()
		var nm: String = lobby["slots"][peer_slot.get(pid, 0)]["name"] if peer_slot.has(pid) else "a player"
		_chat_all("Desync with %s at tick %d: their game no longer matches the host's." % [nm, t])
␀␀# 0.29: controller support (Xbox / PlayStation / Switch pads, the Steam Deck's built-in controls).
# Two layers on top of the existing mouse-and-keyboard game, switching on the last device used:
#  1. a virtual cursor everywhere: a stick moves the real mouse pointer (warped, plus a synthesized motion event so
#     headless tests and every Control see it), A clicks (press / release, drags work), B is Esc, triggers scroll menus;
#  2. direct match controls: left stick walks, shoulders / triggers cast (hold to aim, release to cast), X attacks,
#     Y opens the sends & buildings wheel (tap) or is the modifier (hold), d-pad potion / Armory / items, Start pauses.
# Every match action calls the same main.gd functions the keys do (main.run_action / human_* -> act()), so the
# lockstep sim never sees the difference. Settings: Settings.pad_* and the [pad] binds.
class_name Pad
extends Node

const SYNTH := 77                   # device id of the mouse / key events made here (the device switch ignores them)
const CURSOR_SPEED := 1150.0        # viewport pixels a second at full tilt (x Settings.pad_cursor)
const EDGE := 14.0                  # the cursor stops this far inside the window; pushing on pans the camera
const MOVE_EVERY := 0.15            # left-stick walking: at most one move order per 0.15 s ...
const MOVE_REFRESH := 0.5           # ... and one at least every 0.5 s while the stick is held
const MOVE_TURN := 0.3              # ... or sooner when the direction turns by more than ~17 degrees
const MOVE_AHEAD := 170.0           # world units ahead of the hero the move order points
const AIM_FRESH := 1.5              # seconds: a cursor moved this recently aims abilities and attacks itself
const TAP := 0.4                    # Y released within this (and nothing pressed with it) = tap: the wheel

