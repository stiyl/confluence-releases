# 0.32.1: sizes the lobby to the window (any resolution, any UI scale): the side columns narrow, the hero tiles
# shrink and then wrap, the slots get shorter, so nothing leaves the screen and nothing overlaps.
func _lobby_fit() -> void:
	if lobby_ov == null or not lobby_ov.is_visible_in_tree():
		return
	var vp: Vector2 = lobby_ov.size
	var w := vp.x - 80.0
	var teams_w := clampf(w * 0.27, 290.0, 430.0)
	var det_w := clampf(w * 0.22, 250.0, 340.0)
	var cols := 1
	for g in lobby_hero_grids:
		cols = maxi(cols, (g as GridContainer).get_child_count())
	var room := w - teams_w - det_w - 36.0 - 28.0 - 76.0
	var tile := 64.0
	if room < cols * 70.0:
		tile = 56.0
	if room < cols * 62.0:
		# still too narrow: give the columns a little more back before wrapping
		teams_w = maxf(260.0, teams_w - (cols * 62.0 - room))
		room = w - teams_w - det_w - 36.0 - 28.0 - 76.0
	var per := clampi(int(room / (tile + 6.0)), 3, cols)
	lobby_teams_scroll.custom_minimum_size.x = teams_w
	lobby_chat.custom_minimum_size.y = 92.0 if vp.y >= 800.0 else 56.0
	lobby_detail_panel.custom_minimum_size.x = det_w
	for g in lobby_hero_grids:
		(g as GridContainer).columns = per
	if tile != lobby_tile:
		lobby_tile = tile
		for id in lobby_hero_btns:
			var hb: Button = lobby_hero_btns[id]
			hb.custom_minimum_size = Vector2(tile, tile + 14.0)
			var pt: Control = hb.get_node_or_null("Pt")
			if pt != null:
				var ps := tile - 18.0
				pt.size = Vector2(ps, ps)
				pt.position = Vector2((tile - ps) / 2.0, 5)
	# slot height: what the window leaves for the body
	var ts := net.team_size() if not net.lobby.is_empty() else 4
	var fixed := lobby_col.get_combined_minimum_size().y - lobby_body.get_combined_minimum_size().y
	var body_room := vp.y - 52.0 - fixed
	var sh := clampf((body_room - 2.0 * 30.0 - 10.0 - 2.0 * ts * 6.0) / (2.0 * ts), 34.0, 54.0)
	for i in lobby_slot_btns.size():
		var b: Button = lobby_slot_btns[i]
		b.custom_minimum_size.y = sh
		var fh: Control = lobby_slot_faces[i]
		var fs := minf(sh - 10.0, 42.0)
		fh.offset_top = (sh - fs) / 2.0
		fh.offset_bottom = -(sh - fs) / 2.0
		fh.offset_right = fh.offset_left + fs
	lobby_btn_col.custom_minimum_size.x = clampf(w * 0.2, 260.0, 320.0)


func _lobby_chat_line(t: String) -> void:
	if chat != null:
		t = chat.clean(t)   # 0.30: Settings > Filter chat
	lobby_chat_lines.append(t)
	while lobby_chat_lines.size() > 5:
		lobby_chat_lines.pop_front()
	lobby_chat.text = "\n".join(lobby_chat_lines)
	if game.visible and sim != null:
		mp_chat.append([t, Time.get_ticks_msec()])
		while mp_chat.size() > 12:
			mp_chat.pop_front()


func refresh_lobby() -> void:
	if lobby_ov == null or net.lobby.is_empty():
		return
	var l: Dictionary = net.lobby
	var ts := net.team_size()
	var me_slot := net.my_slot()
	lobby_title.text = "Lobby" if not net.is_host else "Your lobby"
	lobby_info.text = "%s  Â·  %s" % [{"steam": "Steam", "relay": "online (relay)"}.get(net.transport, "direct connection"), "you are the host" if net.is_host else "the host sets the mode, map and AI"]
	_refresh_lobby_addr()
	for k in lobby_mode_btns.size():
		lobby_mode_btns[k].set_pressed_no_signal(MP_MODES[k][0] == l["mode"])
		lobby_mode_btns[k].disabled = not net.is_host
	for k in lobby_map_btns.size():
		lobby_map_btns[k].set_pressed_no_signal(k == int(l["map"]))
		lobby_map_btns[k].disabled = not net.is_host
	for k in lobby_diff_btns.size():
		lobby_diff_btns[k].set_pressed_no_signal(k == int(l["diff"]))
		lobby_diff_btns[k].disabled = not net.is_host
	var taken := {}
	for i in 8:
		var s: Dictionary = l["slots"][i]
		var b: Button = lobby_slot_btns[i]
		b.visible = (i % 4) < ts
		var hero := ""
		if String(s["champ"]) == "random":
			hero = "random hero"
		elif String(s["champ"]) != "":
			hero = String(find_champ(s["champ"])["name"])
			taken[s["champ"]] = int(s["peer"])
		_lobby_slot_face(i, s)
		if s["kind"] == "human":
			b.text = "%s%s%s  Â·  %s%s" % [String(s["name"]) + (("  (Steam: %s)" % String(s["sn"])) if String(s.get("sn", "")) not in ["", String(s["name"])] else ""), ("  Â·  Lv %d" % int(s["lvl"])) if int(s.get("lvl", 0)) > 0 else "", "  (you)" if i == me_slot else "", hero if hero != "" else "choosingâ€¦", "" if bool(s["ready"]) or int(s["peer"]) == 1 else "  Â·  not ready"]
			b.add_theme_color_override("font_color", Color(0.4, 1.0, 0.45) if i == me_slot else TEXT)
		else:
			b.text = "AI player  Â·  click to take this slot"
			b.add_theme_color_override("font_color", MUTED)
	var my_pick := String(l["slots"][me_slot]["champ"]) if me_slot >= 0 else ""
	if my_pick != "":
		_fill_lobby_detail(my_pick)
	for id in lobby_hero_btns:
		var hb: Button = lobby_hero_btns[id]
		hb.set_pressed_no_signal(id == my_pick)
		hb.disabled = taken.has(id) and id != my_pick or l["mode"] == "allrandom"
	lobby_note.text = "All-Random: everyone gets a random hero." if l["mode"] == "allrandom" else "Bans are single-player only for now."
	lobby_invite.visible = net.transport == "steam" and net.is_host
	if lobby_balance != null:
		lobby_balance.text = "Balance" + ("  Â·  custom" if Tune.is_custom(l.get("tune", {})) else "") + ("" if net.is_host else "  (host's)")
	if net.is_host:
		var why := net.can_start()
		lobby_go.text = "Start the match" if why == "" else "Start  Â·  " + why
	else:
		lobby_go.text = "Not ready" if lobby_ready else "Ready"
	lobby_go.tooltip_text = lobby_go.text
	_lobby_fit()


# 0.32.1: a player's picture on their slot (their avatar, else their current pick); AI slots stay empty.
func _lobby_slot_face(i: int, s: Dictionary) -> void:
	if i >= lobby_slot_faces.size():
		return
	var fh: Control = lobby_slot_faces[i]
	var human: bool = s["kind"] == "human"
	var champ := String(s.get("champ", ""))
	var av := String(s.get("av", "")) if human else ""
	var mine: bool = human and int(s.get("peer", 0)) == multiplayer.get_unique_id()
	if mine:
		av = account.avatar
	var k := "%s|%s|%s|%s" % [human, av, champ, String(s.get("name", ""))]
	if String(fh.get_meta("key", "")) == k:
		return
	fh.set_meta("key", k)
	for ch in fh.get_children():
		ch.queue_free()
	if human and not mine and String(s.get("fc", "")) != "":
		account.remember_avatar(String(s["fc"]), LobbyAvatars.clean(av))
	if not human:
		return
	var f: Control = LobbyAvatars.face(av, champ if champ != "random" else "", String(s.get("name", "?")), 40)
	f.set_anchors_preset(PRESET_FULL_RECT)
	f.mouse_filter = MOUSE_FILTER_IGNORE
	fh.add_child(f)


func _fill_lobby_detail(cid: String) -> void:
	if lobby_detail == null or cid == _lobby_detail_id:
		return
	var c: Dictionary = {}
	for x in GameData.CHAMPS:
		if x["id"] == cid:
			c = x
	if c.is_empty():
		return
	_lobby_detail_id = cid
	for ch in lobby_detail.get_children():
		ch.queue_free()
	var top := hbox(10)
	var pt := portrait_for(c, 64)
	pt.custom_minimum_size = Vector2(64, 64)
	top.add_child(pt)
	var names := vbox(2)
	names.add_child(head_lbl(String(c["name"]), 20, GOLD, 3))
	names.add_child(lbl(String(c.get("title", "")), 13, TEXT))
	names.add_child(lbl(String(c["role"]).to_upper(), 12, Color(c["color"]).lightened(0.2)))
	top.add_child(names)
	lobby_detail.add_child(top)
	lobby_detail.add_child(HSeparator.new())
	lobby_detail.add_child(ability_row("passive", c["color"], "", c["passive"]["name"], "Passive", c["passive"]["desc"]))
	for i in 4:
		var sk: Dictionary = c["skills"][i]
		lobby_detail.add_child(ability_row(skill_kind(sk), c["color"], Settings.key_name(_skill_actions()[i]), sk["name"], "%ss cooldown" % str(sk["cd"]), sk["desc"], i == 3))


func _refresh_lobby_addr() -> void:
	if lobby_addr_box == null:
		return
	var hi: Dictionary = net.host_info
	if net.transport == "relay" and net.room_code != "":
		lobby_addr_box.visible = true
		lobby_addr_lbl.text = "Room code:  %s" % net.room_code
		lobby_addr_lbl.add_theme_font_size_override("font_size", 26)
		lobby_addr_note.text = "Give this code to your friends: they choose Multiplayer > Online and type it in. Everyone needs the same game version (%s)." % Net.game_version()
		return
