# Both crystals' health over the match (sim.hist "core"), round ticks on the x-axis, final values labelled,
# the end marked; optionally each team's gold earned as thin lines on a right-hand axis.
class CoreGraph extends Control:
	var main
	var sim
	var show_gold := true
	var _btn: Button
	var _tabs: Array = []
	# 0.18: mode "income" plots each team's income per round (the Tab scoreboard), the per-player lines
	# faint behind on the toggle. Reads sim.hist entries that carry "inc" and "round"; until they do, the
	# EventHud's per-round record (inc_rec: {"round", "team": [2], "pl": [n]}) stands in.
	var mode := "core"
	var inc_rec: Array = []
	var show_players := false
	var tabs := false           # 0.18.4 end screen: "Crystal" / "Income" tabs on one graph
	var players_main := false   # 0.18.2 end screen: every player's income as a main line with a name label, no team lines
	var plain := false          # no frame / backing (drawn inside a plaque)

	func _ready() -> void:
		mouse_filter = MOUSE_FILTER_PASS
		_btn = Button.new()
		_btn.text = "Gold" if mode == "core" else "Players"
		_btn.toggle_mode = true
		_btn.button_pressed = show_gold if mode == "core" else show_players
		_btn.focus_mode = FOCUS_NONE
		_btn.add_theme_font_size_override("font_size", 11)
		_btn.custom_minimum_size = Vector2(0, 20)
		_btn.tooltip_text = "Show each team's gold earned (right axis)" if mode == "core" else "Show every player's income as a thin line"
		_btn.toggled.connect(func(on: bool):
			if mode == "core":
				show_gold = on
			else:
				show_players = on
			queue_redraw())
		_btn.visible = not players_main or tabs
		add_child(_btn)
		if tabs:
			var grp := ButtonGroup.new()
			for t in [["Crystal", "core"], ["Income", "income"]]:
				var b := Button.new()
				b.text = t[0]
				b.toggle_mode = true
				b.button_group = grp
				b.button_pressed = mode == t[1]
				b.focus_mode = FOCUS_NONE
				b.add_theme_font_size_override("font_size", 11)
				b.custom_minimum_size = Vector2(0, 20)
				b.pressed.connect(func():
					mode = t[1]
					_btn.text = "Gold" if mode == "core" else "Players"
					_btn.visible = mode == "core"
					_btn.button_pressed = show_gold
					_place()
					queue_redraw())
				add_child(b)
				_tabs.append(b)
			_btn.visible = mode == "core"
		resized.connect(_place)
		_place()

	func _place() -> void:
		var x := size.x - 8.0
		if not _tabs.is_empty():
			for i in range(_tabs.size() - 1, -1, -1):
				var b: Button = _tabs[i]
				x -= 60.0
				b.position = Vector2(x, 4)
				b.size = Vector2(58, 20)
			x -= 10.0
		if _btn != null:
			var bw := 50.0 if mode == "core" else 62.0
			_btn.position = Vector2(x - bw, 4)
			_btn.size = Vector2(bw, 20)

	func _team_col(tm: int) -> Color:
		return main.WARD if tm == 0 else main.EMBER

	# 0.18.2: the end screen's chart â€” each player's income per round on one axis, name labels at the line ends,
	# your own line thickest, team-mates in the team colour tinted by the hero colour, the enemy team the same.
	func _draw_players(plot: Rect2, rounds: Array, pls: Array, f: Font, muted: Color) -> void:
		var n := rounds.size()
		if n < 2:
			draw_string(f, plot.position + Vector2(8, 20), "No rounds were played.", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, muted)
			return
		var ymax := 1.0
		for i in pls.size():
			if sim.players[i].absent:
				continue
			for v in pls[i]:
				ymax = maxf(ymax, float(v))
		var step := 50.0
		for st in [25.0, 50.0, 100.0, 200.0, 500.0, 1000.0, 2000.0, 5000.0, 10000.0]:
			step = st
			if ymax / st <= 5.0:
				break
		ymax = ceilf(ymax / step) * step
		var ymin := ymax
		for i in pls.size():
			if sim.players[i].absent:
				continue
			for v in pls[i]:
				ymin = minf(ymin, float(v))
		ymin = maxf(0.0, floorf(ymin / step) * step - step)
		if ymax - ymin < step * 2.0:
			ymin = maxf(0.0, ymax - step * 2.0)
		var xr := func(i: int) -> float: return plot.position.x + plot.size.x * float(i) / float(n - 1)
		var yv := func(v: float) -> float: return plot.position.y + plot.size.y * (1.0 - clampf((v - ymin) / (ymax - ymin), 0.0, 1.0))
		var gy := ymin
		while gy <= ymax + 0.01:
			var yy: float = yv.call(gy)
			draw_line(Vector2(plot.position.x, yy), Vector2(plot.end.x, yy), Color(1, 1, 1, 0.07), 1.0)
			draw_string(f, Vector2(4, yy + 4), ("%.1fk" % (gy / 1000.0)) if gy >= 1000.0 else str(int(gy)), HORIZONTAL_ALIGNMENT_RIGHT, 38, 10, muted)
			gy += step
		var every := 1
		while plot.size.x / float(n - 1) * every < 30.0:
			every += 1
		for i in n:
			var xx: float = xr.call(i)
			var major := int(rounds[i]) % every == 0 or i == n - 1
			draw_line(Vector2(xx, plot.end.y), Vector2(xx, plot.end.y + (5 if major else 3)), Color(1, 1, 1, 0.35 if major else 0.18), 1.0)
			if major:
				draw_line(Vector2(xx, plot.position.y), Vector2(xx, plot.end.y), Color(1, 1, 1, 0.04), 1.0)
				draw_string(f, Vector2(xx - 20, plot.end.y + 16), "R%d" % int(rounds[i]), HORIZONTAL_ALIGNMENT_CENTER, 40, 10, muted)
		# lines: enemies first, then team-mates, you last
		var order: Array = []
		for i in pls.size():
			if not sim.players[i].absent:
				order.append(i)
		var mine := int(sim.players[sim.local].team)
		var loc: int = sim.local
		order.sort_custom(func(a, b):
			if a == loc:
				return false
			if b == loc:
				return true
			return int(sim.players[a].team != mine) > int(sim.players[b].team != mine))
		var ends: Array = []
		for i0 in order:
			var i: int = int(i0)
			var pl = sim.players[i]
			var col: Color = _team_col(pl.team).lerp(Color(pl.champ.def["color"]), 0.55)
			var pts := PackedVector2Array()
			for k in n:
				pts.append(Vector2(xr.call(k), yv.call(float(pls[i][k]))))
			var me: bool = (i == loc)
			draw_polyline(pts, Color(0, 0, 0, 0.55), 4.0 if me else 3.0, true)
			draw_polyline(pts, Color(col, 1.0 if me or pl.team == mine else 0.85), 2.6 if me else 1.8, true)
			ends.append([i, pts[pts.size() - 1], float(pls[i][n - 1]), col])
		# name labels at the line ends, nudged apart
		ends.sort_custom(func(a, b): return a[1].y < b[1].y)
		var last_y := -100.0
		for e in ends:
			var y: float = maxf(float(e[1].y), last_y + 12.0)
			y = clampf(y, plot.position.y + 6, plot.end.y + 4)
			last_y = y
			var pl = sim.players[e[0]]
			var txt := "%s  +%d" % [pl.name, roundi(e[2])]
			var fnt: Font = UIParts.font("num_semi") if e[0] == loc else f
			draw_string_outline(fnt, Vector2(e[1].x + 6, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 11, 3, Color(0, 0, 0, 0.9))
			draw_string(fnt, Vector2(e[1].x + 6, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 11, Color(e[3]).lightened(0.25))

	# Income per round as [rounds: Array[int], team: [[..], [..]], players: [[..] x n]].
	func income_series() -> Array:
		var rounds: Array = []
		var team: Array = [[], []]
		var pls: Array = []
		var n: int = sim.players.size()
		for i in n:
			pls.append([])
		var hist: Array = sim.hist
		if not hist.is_empty() and hist[hist.size() - 1].has("inc") and hist[hist.size() - 1].has("round"):
			# the last sample of each round (round 0 is the setup, skipped)
			var by_round := {}
			for h in hist:
				var r := int(h["round"])
				if r >= 1:
					by_round[r] = h
			var keys := by_round.keys()
			keys.sort()
			for r in keys:
				var inc = by_round[r]["inc"]
				var ts := [0, 0]
				if inc is Array and inc.size() == n:
					for i in n:
						pls[i].append(int(inc[i]))
						if not sim.players[i].absent:
							ts[sim.players[i].team] += int(inc[i])
				elif inc is Array and inc.size() == 2:
					ts = [int(inc[0]), int(inc[1])]
					for i in n:
						pls[i].append(0)
				else:
					continue
				rounds.append(int(r))
				team[0].append(ts[0])
				team[1].append(ts[1])
		else:
			for rec in inc_rec:
				rounds.append(int(rec["round"]))
				team[0].append(int(rec["team"][0]))
				team[1].append(int(rec["team"][1]))
				var pl: Array = rec["pl"]
				for i in n:
					pls[i].append(int(pl[i]) if i < pl.size() else 0)
		return [rounds, team, pls]

	func _draw_income() -> void:
		var r := Rect2(Vector2.ZERO, size)
		if not plain:
			draw_rect(r, Color(0.05, 0.045, 0.035, 0.9))
			UIParts.framed(self, r)
		var f: Font = UIParts.font("num")
		var muted := Color(0.7, 0.65, 0.55)
		draw_string(UIParts.font("display"), Vector2(12, 22), "Income per round" if not players_main else "Income per round Â· every player", HORIZONTAL_ALIGNMENT_LEFT, -1, 17, UIParts.GOLD)
		if sim == null:
			return
		var ser := income_series()
		var rounds: Array = ser[0]
		var team: Array = ser[1]
		var pls: Array = ser[2]
		var plot := Rect2(46, 40, size.x - 46 - (118 if players_main else 64), size.y - 66)
		var mine := int(sim.players[sim.local].team)
		if plot.size.x < 40 or plot.size.y < 20:
			return
		if players_main:
			_draw_players(plot, rounds, pls, f, muted)
			return
		# 0.18.1: no placeholder sentence. Before two rounds are on record the graph shows the current income as a
		# flat line from the start (or the one recorded round) to "now", with the axes and the legend.
		var live := rounds.size() < 2
		if live:
			var np: int = sim.players.size()
			var ts := [0, 0]
			var cur: Array = []
			for i in np:
				cur.append(int(sim.players[i].income))
				if not sim.players[i].absent:
					ts[sim.players[i].team] += int(sim.players[i].income)
			if rounds.is_empty():
				rounds = [0]
				team = [[ts[0]], [ts[1]]]
				for i in np:
					pls[i] = [cur[i]]
			rounds.append(maxi(int(sim.round_no), int(rounds[0])))
			team[0].append(ts[0])
			team[1].append(ts[1])
			for i in np:
				pls[i].append(cur[i])
		var ymax := 1.0
		for tm in 2:
			for v in team[tm]:
				ymax = maxf(ymax, float(v))
		# a round axis top: 50 / 100 / 200 / 500 steps
		var step := 50.0
		for st in [50.0, 100.0, 200.0, 500.0, 1000.0, 2000.0, 5000.0, 10000.0, 20000.0]:
			step = st
			if ymax / st <= 5.0:
				break
		ymax = ceilf(ymax / step) * step
		# the axis starts a step under the lowest team value, so a slow climb still reads as a climb
		var ymin := ymax
		for tm in 2:
			for v in team[tm]:
				ymin = minf(ymin, float(v))
		ymin = maxf(0.0, floorf(ymin / step) * step - step)
		if ymax - ymin < step * 2.0:
			ymin = maxf(0.0, ymax - step * 2.0)
		var n := rounds.size()
		var xr := func(i: int) -> float: return plot.position.x + plot.size.x * float(i) / float(n - 1)
		var yv := func(v: float) -> float: return plot.position.y + plot.size.y * (1.0 - clampf((v - ymin) / (ymax - ymin), 0.0, 1.0))
		# grid + y labels
		var gy := ymin
		while gy <= ymax + 0.01:
			var yy: float = yv.call(gy)
			draw_line(Vector2(plot.position.x, yy), Vector2(plot.end.x, yy), Color(1, 1, 1, 0.07), 1.0)
			draw_string(f, Vector2(4, yy + 4), ("%.1fk" % (gy / 1000.0)) if gy >= 1000.0 else str(int(gy)), HORIZONTAL_ALIGNMENT_RIGHT, 38, 10, muted)
			gy += step
		# round ticks
		var every := 1
		while plot.size.x / float(n - 1) * every < 30.0:
			every += 1
		for i in n:
			var xx: float = xr.call(i)
			var major := int(rounds[i]) % every == 0 or i == n - 1
			draw_line(Vector2(xx, plot.end.y), Vector2(xx, plot.end.y + (5 if major else 3)), Color(1, 1, 1, 0.35 if major else 0.18), 1.0)
			if major:
				draw_line(Vector2(xx, plot.position.y), Vector2(xx, plot.end.y), Color(1, 1, 1, 0.04), 1.0)
				var lab := "R%d" % int(rounds[i])
				if live and i == n - 1:
					lab = "now"
				elif live and int(rounds[i]) == 0:
					lab = "start"
				draw_string(f, Vector2(xx - 20, plot.end.y + 16), lab, HORIZONTAL_ALIGNMENT_CENTER, 40, 10, muted)
		# per-player lines, thin, behind, on their own right-hand axis (a player earns a quarter of a team)
		if show_players:
			var pmax := 1.0
			for i in pls.size():
				for v in pls[i]:
					pmax = maxf(pmax, float(v))
			var pstep := 50.0
			for st in [25.0, 50.0, 100.0, 200.0, 500.0, 1000.0, 2000.0, 5000.0]:
				pstep = st
				if pmax / st <= 4.0:
					break
			# twice the round-up, so the players' lines run through the middle, clear of the team lines at the top
			pmax = ceilf(pmax / pstep) * pstep * 2.0
			for k in 3:
				var pv := pmax * k / 2.0
				var yy := plot.position.y + plot.size.y * (1.0 - k / 2.0)
				draw_string(f, Vector2(plot.end.x + 40, yy + 4), ("%.1fk" % (pv / 1000.0)) if pv >= 1000.0 else str(int(pv)), HORIZONTAL_ALIGNMENT_LEFT, 44, 10, Color(muted, 0.75))
			draw_string(f, Vector2(plot.end.x + 40, plot.end.y + 16), "each", HORIZONTAL_ALIGNMENT_LEFT, -1, 10, Color(muted, 0.75))
			for i in pls.size():
				var pl = sim.players[i]
				if pl.absent:
					continue
				var pts := PackedVector2Array()
				for k in n:
					pts.append(Vector2(xr.call(k), plot.position.y + plot.size.y * (1.0 - clampf(float(pls[i][k]) / pmax, 0.0, 1.0))))
				if pts.size() >= 2:
					draw_polyline(pts, Color(_team_col(pl.team).lerp(Color(pl.champ.def["color"]), 0.6), 0.55 if i != sim.local else 0.9), 1.2 if i != sim.local else 1.6, true)
		# team lines, local team on top
		var finals := []
		for tm in [1 - mine, mine]:
			var pts := PackedVector2Array()
			for k in n:
				pts.append(Vector2(xr.call(k), yv.call(float(team[tm][k]))))
			var col := _team_col(tm)
			var poly := PackedVector2Array(pts)
			poly.append(Vector2(pts[pts.size() - 1].x, plot.end.y))
			poly.append(Vector2(pts[0].x, plot.end.y))
			draw_colored_polygon(poly, Color(col, 0.06))
			draw_polyline(pts, Color(0, 0, 0, 0.6), 4.5 if tm == mine else 3.5, true)
			draw_polyline(pts, col, 3.0 if tm == mine else 2.0, true)
			finals.append([tm, pts[pts.size() - 1], float(team[tm][n - 1])])
		finals.sort_custom(func(a, b): return a[1].y < b[1].y)
		var last_y := -100.0
		for fv in finals:
			var y: float = maxf(float(fv[1].y), last_y + 13.0)
			y = clampf(y, plot.position.y + 6, plot.end.y)
			last_y = y
			var txt := "+%d" % roundi(fv[2])
			var col := _team_col(fv[0])
			draw_string_outline(UIParts.font("num_semi"), Vector2(fv[1].x + 5, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, 3, Color(0, 0, 0, 0.9))
			draw_string(UIParts.font("num_semi"), Vector2(fv[1].x + 5, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, col.lightened(0.2))
		# legend
		var lx := 160.0
		for tm in [mine, 1 - mine]:
			var nm: String = ("%s (you)" % Sim.TEAM_NAMES[tm]) if tm == mine else Sim.TEAM_NAMES[tm]
			draw_rect(Rect2(lx, 14, 14, 3), _team_col(tm))
			draw_string(f, Vector2(lx + 18, 20), nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 11, Color(0.9, 0.86, 0.76))
			lx += 26.0 + f.get_string_size(nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 11).x + 8.0

	func _draw() -> void:
		# 0.19: the end screen can redraw after the match's players were cleared (back to menu / next match)
		if sim == null or sim.local < 0 or sim.local >= sim.players.size():
			return
		if mode == "income":
			_draw_income()
			return
		var r := Rect2(Vector2.ZERO, size)
