		card.key = str(i + 1)
		var cv := vbox(5)
		cv.set_anchors_preset(PRESET_FULL_RECT)
		cv.offset_left = 18
		cv.offset_right = -18
		cv.offset_top = 128
		cv.offset_bottom = -14
		cv.mouse_filter = MOUSE_FILTER_IGNORE
		var nm := head_lbl(String(info["name"]), 24, GOLD if info["rar"] == "common" else rc.lightened(0.25), 4)
		nm.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		nm.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		cv.add_child(nm)
		var rl := section_lbl(String(info["meta"]), rc if info["rar"] != "common" else MUTED, 11)
		rl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		rl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		cv.add_child(rl)
		var tags: Array = sim.card_tags(o)
		var chips: Array = []
		var next_lines: Array = []
		if not tags.is_empty():
			var tr := HFlowContainer.new()
			tr.alignment = FlowContainer.ALIGNMENT_CENTER
			tr.add_theme_constant_override("h_separation", 4)
			var owned := _owns_card(o)
			for tg in tags:
				var n := int(sim.syn_counts.get(tg, 0))
				var after := n if owned else n + 1
				var hits := not owned and SurvivalData.syn_tier(after) > SurvivalData.syn_tier(n)
				var t_after := SurvivalData.syn_tier(after)
				var tname := String(SurvivalData.TAGS[tg]["name"])
				var tc := tag_chip(tg, ("%s  %dâ†’%d" % [tname, n, after]) if not owned else tname, hits or t_after > 0, 11)
				tc.tooltip_text = syn_tooltip(tg, after)
				chips.append(tc)
				tr.add_child(tc)
				# one plain line per tag: what this pick turns on, or how far away the next bonus is
				if hits:
					next_lines.append("%s bonus unlocks: %s" % [tname, SurvivalData.TAGS[tg]["tiers"][t_after - 1]])
				elif t_after < SurvivalData.SYN_TIERS.size():
					var need: int = SurvivalData.SYN_TIERS[t_after] - after
					next_lines.append("%s: %d more %s for the %s bonus" % [tname, need, "card" if need == 1 else "cards", ["first", "second", "third"][t_after]])
			cv.add_child(tr)
			if not next_lines.is_empty():
				var nxl := lbl("\n".join(next_lines), 11, Color(0.6, 1.0, 0.7) if next_lines.any(func(x): return x.contains("unlocks")) else MUTED, true)
				nxl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
				cv.add_child(nxl)
		var dl := lbl(String(info["desc"]), 12 if o["kind"] == "item" else 13, TEXT, true)
		dl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cv.add_child(dl)
		for ch in cv.get_children():
			ch.mouse_filter = MOUSE_FILTER_IGNORE
			for g in ch.get_children():
				if g is Control:
					g.mouse_filter = MOUSE_FILTER_IGNORE
		for tc in chips:
			# PASS: the chip shows its tooltip and the click still reaches the card
			tc.mouse_filter = MOUSE_FILTER_PASS
		card.face.add_child(cv)
		var bi := i
		card.pressed.connect(func(): choose_boon(bi))
		var col := vbox(8)
		col.add_child(card)
		var bb := Button.new()
		bb.focus_mode = FOCUS_NONE
		var can_ban: bool = SurvivalData.card_key(o) != "" and not (o["kind"] == "item" and me_c.items.has(o["id"]))
		bb.text = ("Banish  Â·  %d gold" % sim.banish_cost()) if can_ban else "Can't banish"
		bb.tooltip_text = "Remove this card for the rest of the run and draw another in its place."
		bb.disabled = not can_ban or me_pl.gold < sim.banish_cost()
		bb.custom_minimum_size = Vector2(0, 32)
		confirm_button(bb, func(): _banish(bi), "Banish it?")
		col.add_child(bb)
		boon_row.add_child(col)
	for cp in card_peers:
		cp.fit_peers = card_peers
	_fill_syn(boon_syn, sim.syn_counts, 13, true)
	if boon_syn.get_child_count() == 0:
		var hint := lbl("Synergies: collect 2, 4 or 6 cards that share a tag (Fire, Frost, Storm, Precision, Summoner, Tank, Arcane, Swift) for growing bonuses.", 13, MUTED)
		boon_syn.add_child(hint)
	for ch in boon_actions.get_children():
		ch.queue_free()
	var gl := lbl("%d gold" % floori(me_pl.gold), 16, GOLD)
	boon_actions.add_child(gl)
	var rb := Button.new()
	rb.focus_mode = FOCUS_NONE
	rb.text = "Reroll all  Â·  %d gold   (%s)" % [sim.reroll_cost(), Settings.key_name("skill_r")]
	rb.tooltip_text = "Draw three new cards of the same kind. Each reroll in the same draft costs more."
	rb.disabled = me_pl.gold < sim.reroll_cost()
	rb.custom_minimum_size = Vector2(240, 36)
	style_primary(rb)
	rb.pressed.connect(_reroll)
	boon_actions.add_child(rb)
	skip_btn = Button.new()
	skip_btn.focus_mode = FOCUS_NONE
	skip_btn.text = "Skip (no reward)"
	skip_btn.tooltip_text = "Take none of these cards. The waves go on; nothing comes back later."
	skip_btn.custom_minimum_size = Vector2(0, 36)
	skip_btn.pressed.connect(_skip_cards)
	boon_actions.add_child(skip_btn)
	if sim.daily > 0:
		boon_actions.add_child(lbl("Daily run  Â·  same cards for everyone today", 13, MUTED))
	boon_ov.visible = true
	audio.play("duel_win", -8.0)


func _owns_card(o: Dictionary) -> bool:
	var c = sim.players[sim.local].champ
	match String(o["kind"]):
		"item":
			return c.items.has(o["id"])
		"rank":
			return true
	return false


func _reroll() -> void:
	if not drafting() or sim.card_offer.is_empty() or paused:
		return
	if _res_ok(act("reroll", [])):
		audio.play("click", -4.0)
		for ch in boon_row.get_children():
			ch.queue_free()
		_open_cards()
		update_hud()


func _banish(i: int) -> void:
	if not drafting() or i >= sim.card_offer.size() or paused:
		return
	if _res_ok(act("banish", [i])):
		audio.play("click", -4.0)
		for ch in boon_row.get_children():
			ch.queue_free()
		_open_cards()
		update_hud()


# Sim command "skip": the draft closes with no card taken (nothing happens if the simulation lacks it).
func _skip_cards() -> void:
	if not drafting() or sim.card_offer.is_empty() or paused:
		return
	var res = act("skip", [])
	if not _res_ok(res):
		return
	audio.play("click", -4.0)
	boon_ov.visible = false
	update_hud()


func choose_boon(i: int) -> void:
	if paused:
		return
	if drafting() and not sim.card_offer.is_empty():
		if i >= sim.card_offer.size():
			return
		var info := _card_info(sim.card_offer[i])
		act("card", [i])
		announce(String(info["name"]), String(info["meta"]))
		boon_ov.visible = false
		update_hud()
		return
	if not drafting() or i >= sim.boon_offer.size():
		return
	var id: String = sim.boon_offer[i]
	act("boon", [i])
	announce(String(SurvivalData.BOONS[id]["name"]), String(SurvivalData.BOONS[id]["desc"]))
	boon_ov.visible = false
	update_hud()



