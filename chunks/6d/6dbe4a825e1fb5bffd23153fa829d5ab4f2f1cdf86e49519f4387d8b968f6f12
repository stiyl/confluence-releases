# Switches every map-dependent table (and drops the cached road geometry).
static func set_map(i: int) -> void:
	if i == map_id and not PATHS.is_empty():
		return
	map_id = i
	var m: Dictionary = MAPS[i]
	var shared: Array = m["shared"] + SHARED_CLASSIC
	PATHS = [m["north"] + shared, m["south"] + shared]
	JUNCTION_IDX = [m["north"].size(), m["south"].size()]
	HOMES = m["homes"]
	JUNCTION_POS = m["junction"]
	CAMP = m["camp"]
	CAMPS = []
	for cd in m["camps"]:
		var cp: Vector2 = cd["pos"]
		var bd := INF
		var bh := 0
		for hi in HOMES.size():
			if HOMES[hi].distance_to(cp) < bd:
				bd = HOMES[hi].distance_to(cp)
				bh = hi
		CAMPS.append({"pos": cp, "kind": String(cd["kind"]), "home": bh})
	CAMP_HOME = CAMPS[0]["home"]
	_lanes = []
	_air = []
	_g_nodes = []
	_g_edges = []
	_g_adj = []
	_field_w = 0


