# The stone console along the bottom: a raised centre section like a classic RTS command console.
class ConsoleFrame extends Control:
	var raise := 26.0
	var center_w := 0.46

	func _draw() -> void:
		var w := size.x
		var h := size.y
		if w < 200 or h < raise + 10:
			return
