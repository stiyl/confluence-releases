# ---- 0.27 caelum ----
# Caelum Voss's kit. Three marks live on the target (monster, or the foe hero in a duel):
#   Hollowed (A)  a damage-over-time that leaps to nearby unmarked enemies when its carrier dies
#   Entropy (C)   a second damage-over-time, laid only on enemies that are Hollowed
#   Unravelled (B) Hollowed: -X% Resolve / Might / Cunning (monsters: damage, armor, dodge);
#                 under Entropy: -Y% attack and move speed
# and the Singularity, a black-hole zone (Zone.hole) that holds and drags, then deals flat damage.
func gather_bonus(c) -> float:
	return f(c.def["passive"], "per") * float(c.lvl - 1)


# A monster Caelum's marks may land on without being aimed at: never a neutral camp that isn't already
# fighting (so a leap or a splash doesn't pull a camp).
func void_ok(m) -> bool:
	return not m.dead and (not (m is Mon) or not m.d.get("camp", false) or m.provoked > 0.0)


func void_pick(ar, c, tp: Vector2, reach: float):
	var m = nearest_mon(ar, tp, 90)
	if m == null or m.p.distance_to(c.p) > reach + m.r:
		m = nearest_mon(ar, c.p, reach)
	return m


func apply_hollow(ar, m, src, dps: float, a: Dictionary, gen: int) -> void:
	if m.dead:
		return
	m.hol_t = f(a, "dur", 4.0)
	m.hol_dps = dps
	m.hol_src = src
	m.hol_gen = gen
	m.hol_a = a


func void_act(ar, c, a: Dictionary, tp: Vector2, si: int, mul: float, vk: String) -> void:
	var col: Color = c.col
	match String(a["t"]):
		"hollow":
			var m = void_pick(ar, c, tp, f(a, "range"))
			if m == null:
				c.cds[si] = 1.0
				add_text(ar, c.p + Vector2(0, -30), "NO TARGET", col, 0.9, 11)
				return
			c.face = (m.p - c.p).angle()
			var dps := f(a, "dps") * mul
			add_fx(ar, {"type": "beam", "p": c.p, "p2": m.p, "w": 5.0, "col": col, "t": 0.25, "dur": 0.25, "vis": vk})
			add_fx(ar, {"type": "ring", "p": m.p, "r": f(a, "r"), "col": col, "t": 0.4, "dur": 0.4, "vis": vk, "hit": true})
			ev_view("abhit", ar, m.p, {"vis": vk, "human": c.pl.id == local})
			apply_hollow(ar, m, c, dps, a, 0)
			for o in mons_in(ar, m.p, f(a, "r")):
				if o != m and void_ok(o):
					apply_hollow(ar, o, c, dps, a, 0)
		"unravel":
			var m = void_pick(ar, c, tp, f(a, "range"))
			if m == null:
				c.cds[si] = 1.0
				add_text(ar, c.p + Vector2(0, -30), "NO TARGET", col, 0.9, 11)
				return
			c.face = (m.p - c.p).angle()
			var ctr: Vector2 = m.p
			add_fx(ar, {"type": "ring", "p": ctr, "r": f(a, "r"), "col": col, "t": 0.45, "dur": 0.45, "fill": true, "vis": vk, "hit": true})
			ev_view("abhit", ar, ctr, {"vis": vk, "human": c.pl.id == local})
			var lm: float = rank_mult(c, si) / (1.0 + c_ap(c))   # rank only: the debuff shares grow 10% a rank
			for o in mons_in(ar, ctr, f(a, "r")):
				if o != m and not void_ok(o):
					continue
				var ha: bool = o.hol_t > 0.0
				var he: bool = o.ent_t > 0.0
				if ha or he:
					o.unr_t = f(a, "dur")
					o.unr_attr = minf(0.5, f(a, "attr") * (0.75 + 0.25 * lm)) if ha else 0.0
					o.unr_slow = minf(0.6, f(a, "slow") * (0.75 + 0.25 * lm)) if he else 0.0
					if he:
						if o is Champ:
							o.buffs = o.buffs.filter(func(b): return not b.has("unravel"))
							o.buffs.append({"t": f(a, "dur"), "as": 1.0 - o.unr_slow, "ms": 1.0 - o.unr_slow, "unravel": true})
						else:
							apply_slow(o, o.unr_slow, f(a, "dur"))
				else:
					if o is Champ:
						o.buffs.append({"t": 2.0, "ms": 1.0 - f(a, "base_slow"), "slowed": true})
					else:
						apply_slow(o, f(a, "base_slow"), 2.0)
				hurt(ar, o, f(a, "dmg") * mul, c)
		"entropy":
			var reach := f(a, "range")
			var list: Array = []
			for o in ar.mons:
				if not o.dead and o.hol_t > 0.0 and o.p.distance_to(c.p) - o.r <= reach:
					list.append(o)
			if list.is_empty():
				c.cds[si] = 1.0
				add_text(ar, c.p + Vector2(0, -30), "NO HOLLOWED", col, 0.9, 11)
				return
			var dps := f(a, "dps") * mul
			add_fx(ar, {"type": "ring", "p": c.p, "r": 46.0, "col": col, "t": 0.35, "dur": 0.35, "follow": c, "vis": vk})
			for o in list:
				o.ent_t = f(a, "dur")
				o.ent_dps = dps
				o.ent_src = c
				add_fx(ar, {"type": "bolt", "p": c.p, "p2": o.p, "col": col, "t": 0.22, "dur": 0.22, "w": 1.8})
				add_fx(ar, {"type": "ring", "p": o.p, "r": o.r + 10.0, "col": col, "t": 0.35, "dur": 0.35, "vis": vk, "hit": true})
			ev_view("abhit", ar, list[0].p, {"vis": vk, "human": c.pl.id == local})
		"singularity":
			var z := Zone.new()
			z.p = aim_at(c, tp, f(a, "range", 300))["pt"]
			z.r = f(a, "r")
			z.t = f(a, "dur")
			z.dur = z.t
			z.c = c
			z.col = col
			z.vis = vk
			z.spin = rng.randf() * 6.0
			var fl: Array = a.get("flat", [300])
			var rk: int = clampi(int(c.ranks[si]), 1, fl.size())
			z.hole = {"flat": float(fl[rk - 1]) * c.pow * ab_k(c, si), "pull": f(a, "pull")}
			ar.zones.append(z)


# Ticks the three marks on a monster or a hero. Returns true if the carrier died.
func void_tick(ar, m, dt: float) -> bool:
	if m.unr_t > 0.0:
		m.unr_t -= dt
		if m.unr_t <= 0.0:
			m.unr_attr = 0.0
			m.unr_slow = 0.0
	if m.hol_t > 0.0:
		m.hol_t -= dt
		var src = m.hol_src
		_hit_ctx = "dot"
		hurt(ar, m, m.hol_dps * minf(dt, m.hol_t + dt), src)
		_hit_ctx = ""
		if m.dead:
			return true
		if m.hol_t <= 0.0:
			m.hol_t = 0.0
	if m.ent_t > 0.0:
		m.ent_t -= dt
		_hit_ctx = "dot"
		hurt(ar, m, m.ent_dps * minf(dt, m.ent_t + dt), m.ent_src)
		_hit_ctx = ""
		if m.dead:
			return true
		if m.ent_t <= 0.0:
			m.ent_t = 0.0
	return false


# A Hollowed monster died: the Hollowing leaps to every eligible enemy near it (fresh duration, a little weaker
# each leap, at most `gens` leaps from the first cast so a pack can't be wiped by one endless chain).
func hollow_spread(ar, m) -> void:
	var a: Dictionary = m.hol_a
	var gen: int = m.hol_gen + 1
	m.hol_t = 0.0
	if a.is_empty() or gen > int(a.get("gens", 4)) or m.hol_src == null:
		return
	var dps: float = m.hol_dps * f(a, "fall", 0.8)
	var n := 0
	for o in mons_in(ar, m.p, f(a, "hop", 140)):
		if o == m or o.hol_t > 0.0 or not void_ok(o) or o is Champ:
			continue
		apply_hollow(ar, o, m.hol_src, dps, a, gen)
		add_fx(ar, {"type": "bolt", "p": m.p, "p2": o.p, "col": m.hol_src.col, "t": 0.25, "dur": 0.25, "w": 2.0})
		n += 1
	if n > 0:
		add_fx(ar, {"type": "ring", "p": m.p, "r": f(a, "hop", 140), "col": m.hol_src.col, "t": 0.35, "dur": 0.35})
		ev_view("hollow_leap", ar, m.p, {"n": n, "human": m.hol_src.pl.id == local})


# The Singularity: holds (a short stun, refreshed) and drags everything inside toward its heart; bosses and
# unstoppable monsters only feel a quarter of the drag and a slow. When it collapses, whatever is still inside
# takes its flat damage.
const HOLE_HERO_HOLD := 1.0


func hole_step(ar, z, dt: float) -> void:
	var pull: float = f(z.hole, "pull")
	for m in mons_in(ar, z.p, z.r):
		if m is Mon and not void_ok(m):
			continue
		var big: bool = m.cci or (m is Mon and m.d.get("boss", false))
		if big:
			apply_slow(m, 0.5, 0.3)   # (an unstoppable monster ignores the slow, as ever)
		elif m is Champ and z.dur - z.t > HOLE_HERO_HOLD:
			apply_slow(m, 0.4, 0.3)   # a hero in a duel is held only for the first second, then dragged and slowed
		else:
			m.stun = maxf(m.stun, 0.12)
		var dv: Vector2 = z.p - m.p
		var dd := dv.length()
		if dd > 4.0:
			m.p += dv / dd * minf(dd - 3.0, pull * (0.25 if big else 1.0) * dt)
			if not m.fly:
				m.p = bridge_push(m.p, m.r)
			if m is Mon:
				unsiege(m)
	if z.t <= 0.0:
		ev("boom", ar, z.p, {"vis": z.vis, "human": z.c != null and z.c.pl.id == local})
		add_fx(ar, {"type": "ring", "p": z.p, "r": z.r, "col": z.col, "t": 0.45, "dur": 0.45, "fill": true, "vis": z.vis, "hit": true})
		burst(ar, z.p, z.col, 16, 150)
		for m in mons_in(ar, z.p, z.r):
			if m is Mon and not void_ok(m):
				continue
			hurt(ar, m, f(z.hole, "flat"), z.c, true)
