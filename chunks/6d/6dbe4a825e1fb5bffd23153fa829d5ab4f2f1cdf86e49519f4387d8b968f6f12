		# round ticks
		var rl: float = maxf(1.0, float(sim.round_len))
		var px_per_round := plot.size.x * rl / tmax
		var every := 1
		while px_per_round * every < 34.0:
			every += 1
		var rn := 1
		var tt := rl
		while tt < tmax + 0.01:
			var xx := plot.position.x + plot.size.x * tt / tmax
			var major := rn % every == 0
			draw_line(Vector2(xx, plot.end.y), Vector2(xx, plot.end.y + (5 if major else 3)), Color(1, 1, 1, 0.35 if major else 0.18), 1.0)
			if major:
				draw_line(Vector2(xx, plot.position.y), Vector2(xx, plot.end.y), Color(1, 1, 1, 0.04), 1.0)
				draw_string(f, Vector2(xx - 14, plot.end.y + 16), "R%d" % rn, HORIZONTAL_ALIGNMENT_CENTER, 28, 10, muted)
			rn += 1
			tt += rl
		draw_string(f, Vector2(plot.position.x, plot.end.y + 27), "0:00", HORIZONTAL_ALIGNMENT_LEFT, -1, 10, Color(muted, 0.8))
		var secs := int(tmax)
		draw_string(f, Vector2(plot.end.x - 40, plot.end.y + 27), "%d:%02d" % [secs / 60, secs % 60], HORIZONTAL_ALIGNMENT_RIGHT, 40, 10, Color(muted, 0.8))
		# gold (thin, behind the crystal lines)
		var mine := int(sim.players[sim.local].team)
		if show_gold:
			var gmax := 1.0
			var gs: Array = [[], []]
			for h in hist:
