static var _sub: Array = []
static var _tok: Array = []
static var _re_chars: RegEx
static var _re_code: RegEx
static var _re_camel: RegEx
static var _re_digits_edge: RegEx


static func _leet(s: String, one: String) -> String:
	var o := ""
	for ch in s:
		o += one if ch == "1" else String(LEET.get(ch, ch))
	return o


# "boob" -> "b+o{2,}b+": each letter may repeat, a doubled letter must stay doubled
static func pattern(e: String) -> String:
	var p := ""
	var i := 0
	while i < e.length():
		var j := i
		while j < e.length() and e[j] == e[i]:
			j += 1
		p += e[i] + ("+" if j - i == 1 else "{%d,}" % (j - i))
		i = j
	return p


static func _init_res() -> void:
	if not _sub.is_empty():
		return
	for e in SUBSTR:
		_sub.append(RegEx.create_from_string(pattern(e)))
	for e in TOKEN:
		_tok.append(RegEx.create_from_string("^" + pattern(e) + "$"))
	_re_chars = RegEx.create_from_string("^[A-Za-z0-9 _\\-]+$")
	_re_code = RegEx.create_from_string("^[A-Za-z0-9]{4}-[A-Za-z0-9]{4}$")
	_re_camel = RegEx.create_from_string("([a-z])([A-Z])")
	_re_digits_edge = RegEx.create_from_string("^[0-9]+|[0-9]+$")


static func _strip(s: String) -> String:
	for a in ALLOW:
		s = s.replace(a, "#")
	return s


static func _no_digits(s: String) -> String:
	var o := ""
	for ch in s:
		if not (ch >= "0" and ch <= "9"):
			o += ch
	return o


static func _variants(s: String) -> Array:
	var out: Array = []
	for v in [_leet(s, "i"), _leet(s, "l"), _no_digits(s)]:
		if not out.has(v):
			out.append(v)
	return out


static func _joined(s: String) -> String:
	return s.replace(" ", "").replace("_", "").replace("-", "")


# Words of a name: separators and camelCase ("BigAss" -> big, ass).
static func tokens(name: String) -> Array:
	_init_res()
	var s := _re_camel.sub(name, "$1 $2", true).to_lower().replace("_", " ").replace("-", " ")
	return Array(s.split(" ", false))


# What makes names unique: case and the kind of separator don't count ("Ash_Fox" = "ash fox").
static func key(name: String) -> String:
	var s := name.strip_edges().to_lower()
	var o := ""
	var sep := false
	for ch in s:
		if ch == " " or ch == "_" or ch == "-":
			if not sep:
				o += "_"
			sep = true
		else:
			o += ch
			sep = false
	return o


# "" if the name is fine, else a message for the player.
# 0.30 chat filter: true when one word (letters / digits) would be refused in a name (the same SUBSTR / TOKEN lists).
static func word_bad(w: String) -> bool:
	_init_res()
	var low := w.to_lower()
	if low.length() < 3 and not TOKEN.has(low):
		return false
	for v in _variants(low):
		var s := _strip(v)
		for re in _sub:
			if re.search(s) != null:
				return true
		for re in _tok:
			if re.search(s) != null:
				return true
	return false


# 0.30: masks the rude words of a chat line ("what the ****"), keeping spaces and punctuation.
static func mask(text: String) -> String:
	var out := ""
	var word := ""
	for ch in text + " ":
		var c := ch.to_lower()
		var is_w := (c >= "a" and c <= "z") or (c >= "0" and c <= "9") or LEET.has(c)
		if is_w:
			word += ch
			continue
		if word != "":
			out += "*".repeat(word.length()) if word_bad(word) else word
			word = ""
		out += ch
	return out.substr(0, out.length() - 1)


static func problem(name: String) -> String:
	_init_res()
	if name.length() < 3 or name.length() > 16:
		return "Names are 3 to 16 characters long."
	if _re_chars.search(name) == null:
		return "Use letters, numbers, spaces, _ and - only."
	if name != name.strip_edges():
		return "No spaces at the start or end."
	if name.contains("  "):
		return "Only one space in a row."
	var has_letter := false
	for ch in name.to_lower():
		if ch >= "a" and ch <= "z":
			has_letter = true
	if not has_letter:
		return "Use at least one letter."
	if _re_code.search(name) != null:
		return "That looks like a friend code. Pick something else."
