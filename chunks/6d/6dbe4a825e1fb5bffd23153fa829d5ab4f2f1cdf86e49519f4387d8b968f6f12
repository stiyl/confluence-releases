# ---- 0.34 cultist ----
# The Cultist, Herald of the Hollow (Resolve fighter). Undying Will (passive): a blow that would kill him leaves
# him at 1 health inside a short window (3 s, 1.5 s in a duel) where nothing can hurt him and nothing can heal him;
# then it rests for 180 s (at most once a duel). Hollow Mark (Q) marks the enemies in a wide circle to take more
# damage from everyone while the circle bleeds them; Devotion (W) heals a flat amount plus 70% of what he took in
# the last 2 s; Impending Doom (E) dooms the healthiest enemy near him to a heavy blow 10 s later; Inevitable
# Demise (R) strikes everything near him for his current health plus a flat sum, and costs him that health.
const CULT_LOG_WIN := 2.0       # Devotion looks back this many seconds
const CULT_CONFIRM := 1.5       # seconds a second Inevitable Demise press has to confirm (Undying Will down)


func is_cultist(c) -> bool:
	return c is Champ and String(c.def["passive"].get("t", "")) == "undying"


# True when Undying Will would save him from the next killing blow.
func cult_ready(c) -> bool:
	return c.uw_cd <= 0.0 and not (duel_on and c.ar == duel_ar and c.uw_duel)


# Called when the Cultist's health has just dropped: at 0 or below, Undying Will saves him if it can.
func cult_save(ar, c) -> bool:
	if c.hp > 0.0 or not is_cultist(c) or not cult_ready(c):
		return false
	var p: Dictionary = c.def["passive"]
	var duel: bool = duel_on and c.ar == duel_ar
	c.hp = 1.0
	c.uw_t = f(p, "duel_dur", 1.5) if duel else f(p, "dur", 3.0)
	c.uw_cd = f(p, "cd", 180.0)
	if duel:
		c.uw_duel = true
	add_fx(ar, {"type": "ring", "p": c.p, "r": 70.0, "col": Color("#c23a5e"), "t": 0.6, "dur": 0.6, "fill": true, "follow": c, "vis": "cultist:pd" if duel else "cultist:p"})
	burst(ar, c.p, Color("#5a1030"), 22, 160)
	add_text(ar, c.p + Vector2(0, -54), "UNDYING WILL", Color("#e8d8c0"), 1.6, 15)
	ev("undying", ar, c.p, {"pid": c.pl.id, "human": c.pl.id == local, "dur": c.uw_t})
	return true


# Ticks the Cultist's window and Devotion log (heroes) and the Hollow Mark / Doom marks (monsters, the duel foe).
# Returns true if the carrier died.
func cult_tick(ar, m, dt: float) -> bool:
	if m is Champ:
		if m.uw_t > 0.0:
			m.uw_t -= dt
			if m.uw_t <= 0.0:
				m.uw_t = 0.0
				ev("undying_end", ar, m.p, {"pid": m.pl.id, "human": m.pl.id == local})
		while not m.cult_log.is_empty() and t - float(m.cult_log[0][0]) > CULT_LOG_WIN:
			m.cult_log.pop_front()
	if m.dm_t > 0.0:
		m.dm_t -= dt
		if m.dm_t <= 0.0:
			m.dm_t = 0.0
			m.dm_amp = 0.0
	if m.doom_t > 0.0:
		m.doom_t -= dt
		if m.doom_t <= 0.0:
			m.doom_t = 0.0
			var src = m.doom_src
			m.doom_src = null
			if src != null:
				add_fx(ar, {"type": "ring", "p": m.p, "r": m.r + 30.0, "col": Color("#c23a5e"), "t": 0.45, "dur": 0.45, "fill": true, "vis": "cultist:2", "hit": true})
				burst(ar, m.p, Color("#5a1030"), 14, 140)
				ev("boom", ar, m.p, {"vis": "cultist:2", "human": src.pl.id == local})
				hurt(ar, m, m.doom_dmg, src, true)
				if m.dead:
					return true
	return false


# Damage the Cultist took in the last 2 s (his own Inevitable Demise isn't counted).
func cult_taken(c) -> float:
	var s := 0.0
	for e in c.cult_log:
		if t - float(e[0]) <= CULT_LOG_WIN:
			s += float(e[1])
	return s


# The enemy Impending Doom would fall on: a boss first, then the most current health, within reach and not
# already Doomed (never a camp that isn't already fighting).
func doom_pick(ar, c, reach: float):
	var pick = null
	var ps := -1.0
	for m in ar.mons:
		if m.dead or m.doom_t > 0.0 or not void_ok(m) or m.p.distance_to(c.p) - m.r > reach:
			continue
		var sc: float = m.hp + (1e7 if (m is Mon and m.d.get("boss", false)) else 0.0)
		if sc > ps:
			ps = sc
			pick = m
	return pick


func demise_flat(c, si: int, a: Dictionary) -> float:
	var fl: Array = a.get("flat", [200])
	var rk: int = clampi(int(c.ranks[si]), 1, fl.size())
	return float(fl[rk - 1]) * c.pow * ab_k(c, si) * (1.0 + c_ap(c))


