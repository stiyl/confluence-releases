	transport = "ip"
	_become_host()
	host_info = {"lan": lan_addresses(), "public": "", "upnp": "trying", "note": "Asking your router to open the portâ€¦"}
	host_info_changed.emit()
	_start_upnp(port)


# The machine's own private addresses (LAN, and Tailscale / Radmin style VPN ranges).
static func lan_addresses() -> Array:
	var out: Array = []
	for a in IP.get_local_addresses():
		if a.contains(":") or a.begins_with("127.") or a.begins_with("169.254."):
			continue
		out.append(a)
	out.sort_custom(func(x, y): return _addr_rank(x) < _addr_rank(y))
	return out


static func _addr_rank(a: String) -> int:
	if a.begins_with("192.168.") or a.begins_with("10."):
		return 0
	if a.begins_with("100.") or a.begins_with("26."):   # Tailscale (100.64/10), Radmin VPN (26.x)
		return 1
	return 2


static func _is_private(a: String) -> bool:
	var p := a.split(".")
	if p.size() != 4:
		return false
	var b0 := int(p[0])
	var b1 := int(p[1])
	return b0 == 10 or (b0 == 192 and b1 == 168) or (b0 == 172 and b1 >= 16 and b1 <= 31) or (b0 == 100 and b1 >= 64 and b1 <= 127)


# UPnP discovery blocks for a couple of seconds, so it runs on a thread and reports back.
func _start_upnp(port: int) -> void:
	_stop_upnp()
	_upnp_port = port
	_upnp_thread = Thread.new()
	_upnp_thread.start(_upnp_work.bind(port))


func _upnp_work(port: int) -> void:
	var u := UPNP.new()
	var res := {"upnp": "failed", "public": ""}
	var err := u.discover(2500, 2, "InternetGatewayDevice")
	if err == UPNP.UPNP_RESULT_SUCCESS and u.get_gateway() != null and u.get_gateway().is_valid_gateway():
		var ext := u.query_external_address()
		res["public"] = ext
		var e1 := u.add_port_mapping(port, port, "Confluence", "UDP", 0)
		if e1 == UPNP.UPNP_RESULT_SUCCESS:
			res["upnp"] = "cgnat" if (ext != "" and _is_private(ext)) else "ok"
			_upnp = u
	call_deferred("_upnp_done", res)


func _upnp_done(res: Dictionary) -> void:
	if _upnp_thread != null:
		_upnp_thread.wait_to_finish()
		_upnp_thread = null
	if not is_host or transport != "ip":
		_stop_upnp()
		return
	host_info["public"] = res["public"]
	host_info["upnp"] = res["upnp"]
	match String(res["upnp"]):
		"ok":
			host_info["note"] = "Your router opened UDP port %d automatically. Friends on the internet join with your public address." % PORT
		"cgnat":
			host_info["note"] = ("Your router reports a shared address (%s): your internet provider puts you behind carrier NAT, so " +
				"friends on the internet can't reach you directly. Let a friend host, or all join the same Tailscale / Radmin VPN network and use those addresses.") % res["public"]
		_:
			host_info["note"] = ("Your router didn't open the port automatically (UPnP is off or unsupported). For internet play, forward " +
				"UDP port %d on your router to this PC's LAN address, or use Tailscale / Radmin VPN. LAN players can join right away.") % PORT
	host_info_changed.emit()
	status.emit(host_info["note"])


func _stop_upnp() -> void:
	if _upnp != null and _upnp_port > 0:
		_upnp.delete_port_mapping(_upnp_port, "UDP")
	_upnp = null
	if _upnp_thread != null and not _upnp_thread.is_alive():
		_upnp_thread.wait_to_finish()
		_upnp_thread = null


# "1.2.3.4", "1.2.3.4:24680", "host.example.com", " 1.2.3.4 " -> [address, port]
static func parse_address(text: String) -> Array:
	var t := text.strip_edges().replace(" ", "")
	for pre in ["udp://", "http://", "https://"]:
		if t.begins_with(pre):
			t = t.substr(pre.length())
	var port := PORT
	if t.count(":") == 1:
		var parts := t.split(":")
		t = parts[0]
		if parts[1].is_valid_int():
			port = int(parts[1])
	return [t, port]


func join_ip(address: String, port := PORT) -> void:
	var pa := parse_address(address)
	var addr: String = pa[0]
	if port == PORT:
		port = int(pa[1])
	if addr == "":
		status.emit("Type the host's address first.")
		return
	var peer := ENetMultiplayerPeer.new()
	var err := peer.create_client(addr, port)
	if err != OK:
		_fail("Couldn't start connecting to %s (error %d). Check the address." % [addr, err])
		return
	multiplayer.multiplayer_peer = peer
	transport = "ip"
	is_host = false
	_join_addr = "%s:%d" % [addr, port]
	_join_t = JOIN_TIMEOUT
	status.emit("Connecting to %sâ€¦" % _join_addr)


func leave(reason := "", keep_rejoin := false) -> void:
	if steam_ok and lobby_id != 0:
		steam.leaveLobby(lobby_id)
		_steam_presence(0)
	lobby_id = 0
	_close_peer()
	if _relay_pending != null:
		_relay_pending.close()
		_relay_pending = null
	room_code = ""
	_stop_upnp()
	_join_t = -1.0
	host_info = {}
	in_lobby = false
	in_match = false
	is_host = false
	transport = ""
	sim = null
	peer_slot.clear()
	bundles.clear()
	pending.clear()
	# 0.25
	is_dropped = false
	rejoining = false
	migrating = false
	_cu = {}
	_cu_chunks.clear()
	_send_q.clear()
	cmd_log.clear()
	roster.clear()
	match_cfg = {}
	auto_rc = false
	_rc_hold = false
	_rc_hello_due = false
	_rc_missing.clear()
	_relay_pending = null
	room_secret = ""
	if not keep_rejoin:
		_clear_rejoin_file()
	if reason != "":
		left.emit(reason)


func _close_peer() -> void:
	if multiplayer.multiplayer_peer != null:
		multiplayer.multiplayer_peer.close()
	multiplayer.multiplayer_peer = null


# fatal: the room itself is gone (the host left on a relay without migration, kicked, no such room), so
# there is nothing to rejoin.
func _fail(msg: String, fatal := false) -> void:
	_log("fail: " + msg)
	_steam_invite_queue.clear()
	if is_dropped and not rejoining:
		return   # already frozen and waiting for the player's choice
	if rejoining:
		# a rejoin attempt failed: the frozen match stays (the player may try again or leave)
		rejoining = false
		_relay_pending = null
		if not is_dropped and in_match and sim != null and not sim.over and _can_rejoin():
			# 0.26: a rejoin over our live socket (the host came back or changed) got no answer: a drop, retried below
			_drop(msg)
			return
		_close_peer()
		if auto_rc and is_dropped:
			# 0.26: not the end unless the answer was final; otherwise the next attempt comes in RECONNECT_EVERY s
			if _rc_terminal(msg, fatal):
				_rc_give_up(msg)
			else:
				_rc_last = msg.trim_suffix(".")
				_rc_wait = RECONNECT_EVERY
				_log("reconnect attempt failed (%s), next in %ds, %ds left" % [msg, int(RECONNECT_EVERY), int(RECONNECT_FOR - _rc_elapsed)])
			return
		if fatal and msg.begins_with("No game with that room code"):
			msg = "That match has ended: the room is closed."
		if not is_dropped:
			leave()
			status.emit(msg)
		rejoin_failed.emit(msg)
		return
	if in_match and not is_dropped and not fatal and sim != null and not sim.over and _can_rejoin():
		_drop("Lost the connection to the host." if msg == "The host left." else msg)   # a dead socket, not a goodbye
		return
	var was := in_lobby or in_match
	leave()
	left.emit(msg)
	if not was:
		status.emit(msg)


# ---------------------------------------------------------------- 0.25 rejoin
func _can_rejoin() -> bool:
	# the relay keeps the room (and migrates the host); a direct-IP or Steam host that is gone can't be rejoined,
	# but a player whose own connection blinked can come back to a host that is still there
	return transport == "relay" or not is_host


# We lost the host mid-match: keep the match frozen and offer to rejoin.
func _drop(msg: String) -> void:
	if is_dropped:
		return
	_log("dropped: " + msg)
	is_dropped = true
	rejoining = false
	migrating = false
	_cu = {}
	_cu_chunks.clear()
	_send_q.clear()
	bundles.clear()
	pending.clear()
	_newest = tick - 1           # the bundles we held are gone; the log catch-up brings everything from `tick` on
	var p = multiplayer.multiplayer_peer
	if p != null and p.get("close_code") != null:
		_log("relay socket close code %d reason '%s'" % [int(p.close_code), String(p.close_reason)])
	if is_host and transport == "relay" and p != null and p.get("room_secret") != null and String(p.room_secret) != "":
		room_secret = String(p.room_secret)
	_close_peer()
	if _stalled:
		_stalled = false
		stall_changed.emit(false, 0.0)
	# 0.26: reconnect on our own; the host re-claims its room, a player rejoins
	auto_rc = true
	_rc_mode = "host" if is_host and transport == "relay" else "join"
	_rc_elapsed = 0.0
	_rc_wait = 0.0
	_rc_last = ""
	_rc_shown = -1
	_log("auto-reconnect (%s) every %ds for %ds, room %s" % [_rc_mode, int(RECONNECT_EVERY), int(RECONNECT_FOR), room_code])
	dropped.emit(msg)


static func _new_secret() -> String:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var s := ""
	for i in 4:
		s += "%08x" % rng.randi()
	return s


# Reconnect to the host we were playing with and ask for the match since the tick we stopped at.
func rejoin() -> void:
	if not is_dropped or rejoining:
		return
	if auto_rc:
		_rc_wait = 0.0   # "retry now"
		return
	_since = tick if sim != null else -1
	_reconnect()


# ---------------------------------------------------------------- 0.26 automatic reconnection
func _rc_attempt() -> void:
	_rc_wait = RECONNECT_EVERY
	if _rc_mode == "host":
		_rehost()
	else:
		_since = tick if sim != null else -1
		_reconnect()


# Answers that end the match for good (the room was closed on purpose, we were kicked, the match is over, the
# host moved on). Everything else (no room yet, no answer, the relay unreachable, the host changing) is retried.
func _rc_terminal(msg: String, fatal: bool) -> bool:
	if msg in ["That match has ended.", "That match has already started."] or msg.begins_with("Version mismatch"):
		return true
	if fatal and not (msg.begins_with("No game with that room code") or msg.begins_with("That room is full")):
		return true
	return false


func _rc_give_up(msg: String) -> void:
	_log("reconnection over: " + msg)
	auto_rc = false
	var was := in_lobby or in_match
	leave()
	left.emit(msg)
	if not was:
		status.emit(msg)


# The relay host: open the same room again (the relay keeps it for us, or we create it anew with the same code).
func _rehost() -> void:
	rejoining = true
	_rejoin_t = REJOIN_TIMEOUT
	is_host = true
	peer_slot = {1: sim.local} if sim != null else {}
	_peer_seen.clear()
	bundles.clear()
	pending.clear()
	var peer = RelayPeerScript.new()
	var err: Error = peer.rehost(relay_url, room_code, room_secret)
	if err != OK:
		_fail("Couldn't start connecting to the relay (error %d)." % err)
		return
	_relay_pending = peer
	peer.room_ready.connect(func(c: String):
		_relay_pending = null
		multiplayer.multiplayer_peer = peer
		call_deferred("_on_rehosted", peer))   # after the peer has announced the players still in the room
	peer.relay_error.connect(func(msg: String, fatal: bool):
		_relay_pending = null
		_fail(msg, fatal))
	peer.rehost_refused.connect(func(why: String):
		_relay_pending = null
		if why == "taken":
			# another player hosts the room now (promoted while we were away): we come back as a player
			_log("re-claim refused: the room has a new host; rejoining as a player")
			rejoining = false
			is_host = false
			_rc_mode = "join"
			_rc_wait = 0.0
		else:
			_fail("The relay closed the room and can't reopen it (the relay needs the 0.26 update).", true))
	peer.host_changed.connect(_on_host_changed)
	status.emit("Reopening room %sâ€¦" % room_code)


func _on_rehosted(peer) -> void:
	rejoining = false
	is_dropped = false
	auto_rc = false
	is_host = true
	room_secret = String(peer.room_secret)
	peer_slot = {1: sim.local}
	_peer_seen.clear()
	sums.clear()
	pending.clear()
	bundles.clear()
	_cu = {}
	acc = 0.0
	# the match waits for the first player to come back (PEER_DROP at most); the rest have until then too
	_rc_hold = true
	_rc_hold_t = 0.0
	_rc_shown = -1
	_rc_missing.clear()
	var deadline := Time.get_ticks_msec() + int(PEER_DROP * 1000.0)
	var line: Array = match_cfg.get("lineup", [])
	for i in line.size():
		if i != sim.local and i < sim.players.size() and sim.players[i].human:
			_rc_missing[i] = deadline
	var present: Array = peer.peer_ids() if peer.has_method("peer_ids") else []
	_log("room %s reopened at tick %d after %.0fs; %d players still connected, %d slots to come back" % [room_code, tick, _rc_elapsed, present.size(), _rc_missing.size()])
	_save_rejoin_file()
	reconnecting.emit("Reconnected", "Waiting for the othersâ€¦")


# Re-claimed host, every frame while the match is held: resume when the first player is back, or after PEER_DROP.
func _run_hold(dt: float) -> void:
	_rc_hold_t += dt
	if int(_rc_hold_t) != _rc_shown:
		_rc_shown = int(_rc_hold_t)
		reconnecting.emit("Reconnected", "Waiting for the othersâ€¦  %d s" % _rc_shown)
	if _rc_hold_t >= PEER_DROP:
		_log("nobody came back in %ds: the match goes on (AI takes the empty slots)" % int(PEER_DROP))
		_resume_held()


func _resume_held() -> void:
	_rc_hold = false
	acc = 0.0
	_last_bundle_ms = Time.get_ticks_msec()
	_log("resuming at tick %d with peers %s" % [tick, str(peer_slot)])
	rejoined.emit()


# A player: the host's game is back on a new socket (the relay said "rehost"); ask it for what we missed. The hello
# goes out next frame, after the relay peer has re-announced peer 1 (so the RPC path cache starts over).
func _on_host_back() -> void:
	if not in_match or is_dropped or sim == null:
		return
	_log("the host is back (relay rehost) at tick %d: asking to rejoin" % tick)
	rejoining = true
	_rejoin_t = REJOIN_TIMEOUT
	_since = tick
	bundles.clear()
	_cu = {}
	_cu_chunks.clear()
	migrating = false
	_mig_fill_wait = false
	_newest = tick - 1
	if _stalled:
		_stalled = false
		stall_changed.emit(false, 0.0)
	_rc_hello_due = true


func _send_rejoin_hello() -> void:
	status.emit("Connected. Asking to rejoinâ€¦")
	_hello.rpc_id(1, my_name, "%s|%d" % [game_version(), my_level], {"rejoin": my_secret, "since": _since, "mid": match_id})


# "Rejoin your last match" on the main menu: the game was closed (or crashed) during an online match less than
# REJOIN_MAX_AGE ago. Returns {} when there is nothing to offer.
func rejoin_offer() -> Dictionary:
	var f := FileAccess.open(REJOIN_FILE, FileAccess.READ)
	if f == null:
		return {}
	var d = JSON.parse_string(f.get_as_text())
	f.close()
	if not d is Dictionary or String(d.get("ver", "")) != game_version():
		return {}
	var age := Time.get_unix_time_from_system() - float(d.get("t", 0))
	if age < 0 or age > REJOIN_MAX_AGE:
		return {}
	d["age"] = age
	return d


func rejoin_from_file() -> void:
	var d := rejoin_offer()
	if d.is_empty() or in_match or in_lobby:
		return
	leave("", true)
	transport = String(d.get("transport", ""))
	room_code = String(d.get("room", ""))
	_join_addr = String(d.get("addr", ""))
	lobby_id = int(d.get("lobby", 0))
	my_secret = String(d.get("secret", ""))
	match_id = int(d.get("mid", 0))
	if String(d.get("name", "")) != "":
		my_name = String(d["name"])
	sim = null
	tick = 0
	_since = -1
	_reconnect()


func _reconnect() -> void:
	rejoining = true
	_rejoin_t = REJOIN_TIMEOUT
	is_host = false
	in_lobby = false
	peer_slot.clear()
	bundles.clear()
	pending.clear()
	_cu = {}
	_cu_chunks.clear()
	match transport:
		"relay":
			var peer = RelayPeerScript.new()
			var err: Error = peer.join(relay_url, room_code)
			if err != OK:
				_fail("Couldn't start connecting to the relay (error %d)." % err)
				return
			peer.relay_error.connect(func(msg: String, fatal: bool): _fail(msg, fatal))
			peer.host_changed.connect(_on_host_changed)
			peer.host_back.connect(_on_host_back)
			multiplayer.multiplayer_peer = peer
			status.emit("Reconnecting to room %sâ€¦" % room_code)
		"ip":
			var pa := parse_address(_join_addr)
			var peer := ENetMultiplayerPeer.new()
			var err := peer.create_client(String(pa[0]), int(pa[1]))
			if err != OK:
				_fail("Couldn't start connecting to %s (error %d)." % [_join_addr, err])
				return
			multiplayer.multiplayer_peer = peer
			status.emit("Reconnecting to %sâ€¦" % _join_addr)
		"steam":
			if not steam_ok or lobby_id == 0:
				_fail("Steam isn't available.")
				return
			_steam_connect(lobby_id)   # still in the Steam lobby: just a new session to its host
			status.emit("Reconnecting to the Steam lobbyâ€¦")
		_:
			_fail("Nothing to rejoin.")


func _save_rejoin_file() -> void:
	if transport == "ip" and is_host:
		return   # a direct-IP host that closes its game takes the match with it
	var d := {"t": Time.get_unix_time_from_system(), "ver": game_version(), "transport": transport, "room": room_code,
		"addr": _join_addr, "lobby": lobby_id, "secret": my_secret, "mid": match_id, "name": my_name, "mode": String(match_cfg.get("mode", ""))}
	var f := FileAccess.open(REJOIN_FILE, FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(d))
		f.close()


func _clear_rejoin_file() -> void:
	if FileAccess.file_exists(REJOIN_FILE):
		DirAccess.remove_absolute(REJOIN_FILE)


# ---------------------------------------------------------------- lobby
func _become_host() -> void:
	is_host = true
	in_lobby = true
	var slots: Array = []
	for i in 8:
		slots.append({"kind": "ai", "peer": 0, "name": "", "champ": "", "ready": false})
	my_secret = _new_secret()
	slots[0] = {"kind": "human", "peer": 1, "name": my_name, "champ": "", "ready": true, "lvl": my_level, "tok": my_secret.sha256_text(), "fc": my_fc, "av": my_av}
	if transport == "steam":
		slots[0]["sn"] = steam_name.substr(0, 32)   # 0.32: the Steam name, shown beside the profile name in Steam lobbies
	peer_slot = {1: 0}
	lobby = {"mode": "classic", "map": 0, "diff": 1, "slots": slots, "tune": Tune.clean(Tune.load_draft())}   # 0.18.1: the host's balance knobs
	_push_lobby()
	status.emit("Hosting. Waiting for playersâ€¦")


func team_size() -> int:
	match String(lobby.get("mode", "classic")):
		"duo":
			return 2
		"solo":
			return 1
	return 4


func my_slot() -> int:
	for i in lobby.get("slots", []).size():
		if int(lobby["slots"][i]["peer"]) == multiplayer.get_unique_id():
			return i
	return -1


func _on_connected() -> void:
	if in_match and not rejoining:
		return   # a host migration re-announces peer 1 (relay_peer.gd); there is nobody new to greet
	_join_t = -1.0
	_log("connected to the host (%s)" % transport)
	# the profile level rides after the version ("0.13.7|5"): an older host just reports a version mismatch
	if rejoining:
		_rc_hello_due = false
		_send_rejoin_hello()
		return
	status.emit("Connected. Joining the lobbyâ€¦")
	my_secret = _new_secret()
	var hx := {"tok": my_secret.sha256_text()}
	if party_code != "":
		hx["party"] = party_code   # 0.30 (older hosts ignore it)
	if my_fc != "":
		hx["fc"] = my_fc
	if my_av != "":
		hx["av"] = my_av   # 0.32.1
	_hello.rpc_id(1, my_name, "%s|%d" % [game_version(), my_level], hx)


static func game_version() -> String:
	return String(ProjectSettings.get_setting("application/config/version", "?"))


# x (0.25): {"tok": hash} on a normal join (the hash of the player's per-match secret, kept in the line-up), or
# {"rejoin": secret, "since": tick, "mid": match id} from a player coming back into the running match.
@rpc("any_peer", "reliable")
func _hello(pname: String, ver := "", x := {}) -> void:
	if not is_host:
		return
	var pid := multiplayer.get_remote_sender_id()
	var lvl := 0
	if ver.contains("|"):
		lvl = clampi(int(ver.get_slice("|", 1)), 0, 999)
		ver = ver.get_slice("|", 0)
	if ver != game_version():
		_kick.rpc_id(pid, "Version mismatch: the host runs Confluence %s, you run %s. You both need the same build." % [game_version(), ver if ver != "" else "an older version"])
		return
	if x.has("rejoin"):
		if not in_match:
			_kick.rpc_id(pid, "That match has ended.")
			return
		if migrating:
			_kick.rpc_id(pid, "The host is changing. Try again in a moment.")
			return
		_accept_rejoin(pid, String(x["rejoin"]), int(x.get("since", -1)), int(x.get("mid", 0)))
		return
	if in_match:
		_kick.rpc_id(pid, "That match has already started.")
		return
	var ts := team_size()
	# fill the first free slot, alternating teams
	var order := [0, 4, 1, 5, 2, 6, 3, 7]
	if party_code != "" and String(x.get("party", "")) == party_code:
		# 0.30: a member of the host's party: the host's team first (the other team once that one is full)
		var ht := int(peer_slot.get(1, 0)) / 4
		order = [ht * 4, ht * 4 + 1, ht * 4 + 2, ht * 4 + 3, (1 - ht) * 4, (1 - ht) * 4 + 1, (1 - ht) * 4 + 2, (1 - ht) * 4 + 3]
	for i in order:
		var s: Dictionary = lobby["slots"][i]
		if (i % 4) < ts and s["kind"] != "human":
			lobby["slots"][i] = {"kind": "human", "peer": pid, "name": pname.substr(0, 20), "champ": "", "ready": false, "lvl": lvl, "tok": String(x.get("tok", "")), "fc": String(x.get("fc", "")).substr(0, 9), "av": String(x.get("av", "")).substr(0, 32)}
			if transport == "steam":
				lobby["slots"][i]["sn"] = steam_name_of(pid).substr(0, 32)   # from Steam itself, not from the player
			peer_slot[pid] = i
			_push_lobby()
			_chat_all("%s joined." % pname)
			return
	_kick.rpc_id(pid, "The lobby is full.")


# Host: a player proves with their secret that a human slot of this match is theirs, and gets the log.
func _accept_rejoin(pid: int, secret: String, since: int, mid: int) -> void:
	var h := secret.sha256_text()
	var slot := -1
	var line: Array = match_cfg.get("lineup", [])
	for i in line.size():
		if bool(line[i].get("human", false)) and secret != "" and String(line[i].get("tok", "")) == h:
			slot = i
	if slot < 0:
		_kick.rpc_id(pid, "That match has already started.")
		return
	# a stale connection of the same player (the host hasn't noticed the drop yet) gives way
	for old in peer_slot.keys():
		if int(peer_slot[old]) == slot and old != pid:
			peer_slot.erase(old)
			_peer_seen.erase(old)
			if multiplayer.multiplayer_peer != null:
				multiplayer.multiplayer_peer.disconnect_peer(old)
	peer_slot[pid] = slot
	_peer_seen[pid] = Time.get_ticks_msec()
	_rc_missing.erase(slot)
	_roster.rpc(peer_slot)
	var upto := tick if tick % BUNDLE_EVERY == 0 else tick + 1       # the first live bundle this player will get
	# a player who ran past the tick this host took over at (the old host itself, typically) played bundles nobody
	# else got: their match is rebuilt from the log instead of continued
	var fresh := since < 0 or since > upto or mid != match_id or (host_since > 0 and since > host_since)   # (0.26: the original host, host_since 0, continues everyone)
	var entries: Array = []
	for e in cmd_log:
		if fresh or int(e[0]) >= since:
			entries.append(e)
	var d := {"cfg": match_cfg, "upto": upto, "slot": slot, "fresh": fresh, "log": entries, "roster": peer_slot, "mid": match_id}
	var bytes := var_to_bytes(d).compress(FileAccess.COMPRESSION_GZIP)
	var n := int(ceil(float(bytes.size()) / CHUNK))
	n = maxi(n, 1)
	for i in n:
		_send_q.append([pid, i, n, bytes.slice(i * CHUNK, mini((i + 1) * CHUNK, bytes.size()))])
	_log("rejoin: peer %d takes slot %d (since %d, fresh=%s, upto %d): %d log entries, %d bytes in %d pieces" % [pid, slot, since, fresh, upto, entries.size(), bytes.size(), n])


@rpc("authority", "reliable")
func _roster(r: Dictionary) -> void:
	roster = r


# A piece of the catch-up log (the host sends one per frame; the relay and ENet both keep them in order).
@rpc("authority", "reliable")
func _cu_chunk(idx: int, n: int, bytes: PackedByteArray) -> void:
	if not rejoining:
		return
	_rejoin_t = REJOIN_TIMEOUT
	_cu_chunks[idx] = bytes
	if _cu_chunks.size() < n:
		return
	var all := PackedByteArray()
	for i in n:
		all.append_array(_cu_chunks[i])
	_cu_chunks.clear()
	var d = bytes_to_var(all.decompress_dynamic(-1, FileAccess.COMPRESSION_GZIP))
	if not d is Dictionary:
		_fail("The host's answer couldn't be read.")
		return
	rejoining = false
	is_dropped = false
	in_match = true
	in_lobby = false
	match_cfg = d["cfg"]
	match_id = int(d.get("mid", 0))
	roster = d.get("roster", {})
	var fresh := bool(d["fresh"])
	if fresh:
		tick = 0
		cmd_log = d["log"].duplicate()
	else:
		cmd_log.append_array(d["log"])
	for t in bundles.keys():
		if int(t) < int(d["upto"]):
			bundles.erase(t)
	_cu = {"log": d["log"], "i": 0, "upto": int(d["upto"])}
	acc = 0.0
	_buffering = false
	_stalled = false
	_newest = maxi(_newest, int(d["upto"]) - 1)
	_last_bundle_ms = Time.get_ticks_msec()
	desynced = false
	_log("catch-up from tick %d to %d (%d log entries, fresh=%s)" % [tick, int(d["upto"]), _cu["log"].size(), fresh])
	_save_rejoin_file()
	rejoin_started.emit(match_cfg, int(d["slot"]), fresh)


func catching_up() -> bool:
	return not _cu.is_empty()


# Client: play the log, then the bundles that arrived meanwhile, as fast as the frame budget allows.
func _run_catchup() -> void:
	var t0 := Time.get_ticks_usec()
	var upto: int = _cu["upto"]
	var log: Array = _cu["log"]
	while Time.get_ticks_usec() - t0 < 30000 and not sim.over:
		if tick < upto:
			var cmds: Array = []
			var i: int = _cu["i"]
			while i < log.size() and int(log[i][0]) < tick:
				i += 1
			if i < log.size() and int(log[i][0]) == tick:
				cmds = log[i][1]
				i += 1
			_cu["i"] = i
			_exec(cmds, false)
		elif bundles.has(tick):
			var cmds2: Array = bundles[tick]
			bundles.erase(tick)
			_exec(cmds2)
		else:
			break
	sim.events.clear()      # nothing from the fast-forward reaches the HUD
	var goal := maxi(_newest + 1, upto)
	catchup.emit(clampf(float(tick) / float(maxi(goal, 1)), 0.0, 1.0))
	_last_bundle_ms = Time.get_ticks_msec()
	var ahead := _newest - tick + 1
	if sim.over or (tick >= upto and ahead < BUFFER_TICKS * 2):
		_cu = {}
		_buffering = ahead < BUFFER_TICKS
		_log("caught up at tick %d (%d bundles ahead)" % [tick, ahead])
		if _peer_ok():
			_rejoined.rpc_id(1)
		rejoined.emit()


@rpc("any_peer", "reliable")
func _rejoined() -> void:
	var pid := multiplayer.get_remote_sender_id()
	_peer_seen[pid] = Time.get_ticks_msec()
	if is_host and in_match and peer_slot.has(pid):
		var i: int = peer_slot[pid]
		pending.append([i, "rejoin", []])
		_chat_all("%s is back." % String(match_cfg["lineup"][i].get("name", "A player")))
		if _rc_hold:
			_resume_held()


# ---------------------------------------------------------------- 0.25 host migration (relay)
# The relay relabelled the longest-connected player as peer 1 (relay_peer.gd). Nobody steps until the new host
# has every bundle anyone received and says where the match goes on from.
func _on_host_changed(me: bool, was: int) -> void:
	if rejoining and is_dropped and in_match and sim != null:
		# 0.26: promoted (or the host changed) while we wait for the old host's answer, which will never come
		if me:
			_log("promoted while rejoining at tick %d: hosting from here" % tick)
			rejoining = false
			is_dropped = false
			auto_rc = false
			_rc_hello_due = false
		else:
			_rc_hello_due = true   # ask the new host instead
			return
	elif is_dropped or rejoining:
		return
	_log("host changed (me=%s) in_match=%s tick=%d newest=%d" % [me, in_match, tick, _newest])
	if not in_match:
		if me and in_lobby:
			_take_over_lobby(was)
		return
	migrating = true
	_mig_fill_wait = false
	_stalled = false
	stall_changed.emit(false, 0.0)
	_last_bundle_ms = Time.get_ticks_msec()
	if me:
		is_host = true
		if multiplayer.multiplayer_peer != null and multiplayer.multiplayer_peer.get("room_secret") != null:
			room_secret = String(multiplayer.multiplayer_peer.room_secret)
		_mig_reports = {}
		_mig_t = 0.0
		_mig_asked = false
		sums.clear()
		pending.clear()
		var present: Array = multiplayer.multiplayer_peer.peer_ids() if multiplayer.multiplayer_peer != null and multiplayer.multiplayer_peer.has_method("peer_ids") else []
		var now := Time.get_ticks_msec()
		if roster.is_empty():
			var line: Array = match_cfg.get("lineup", [])
			for i in line.size():
				if bool(line[i].get("human", false)):
					roster[int(line[i].get("peer", 0))] = i
		peer_slot = {1: sim.local}
		for pid in roster:
			var p := int(pid)
			var slot := int(roster[pid])
			if p == 1 or slot == sim.local:
				continue
			if present.has(p):
				peer_slot[p] = slot
				_peer_seen[p] = now
		# the old host, and anyone who vanished with it, hand their heroes to the AI
		for pid in roster:
			var slot := int(roster[pid])
			if int(pid) != 1 and present.has(int(pid)):
				continue
			if slot != sim.local and sim.players[slot].human:
				pending.append([slot, "drop", []])
		_roster.rpc(peer_slot)
		_chat_all("The host left. %s hosts now." % my_name)
	else:
		_mig_report.rpc_id(1, tick, _newest)
	host_migrated.emit(me)


# The lobby's host left: carry the lobby on with the same slots.
func _take_over_lobby(was: int) -> void:
	is_host = true
	peer_slot.clear()
	var present: Array = multiplayer.multiplayer_peer.peer_ids() if multiplayer.multiplayer_peer != null and multiplayer.multiplayer_peer.has_method("peer_ids") else []
	for i in 8:
		var s: Dictionary = lobby["slots"][i]
		if s["kind"] != "human":
			continue
		var p := int(s["peer"])
		if p == was:
			s["peer"] = 1
			s["ready"] = true
			s["tok"] = my_secret.sha256_text()
			peer_slot[1] = i
		elif p != 1 and present.has(p):
			peer_slot[p] = i
		else:
			lobby["slots"][i] = {"kind": "ai", "peer": 0, "name": "", "champ": "", "ready": false}
	_push_lobby()
	_chat_all("The host left. %s hosts now." % my_name)
	status.emit("You are the host now.")


@rpc("any_peer", "reliable")
func _mig_report(t: int, newest: int) -> void:
	var pid := multiplayer.get_remote_sender_id()
