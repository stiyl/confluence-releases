# Survival round cards: abilities and passives from every hero, or items (duplicates upgrade).
func _card_info(o: Dictionary) -> Dictionary:
	var c = sim.players[sim.local].champ
	match String(o["kind"]):
		"ability":
			var d := TalentData.champ(o["hero"])
			var sk: Dictionary = d["skills"][int(o["slot"])]
			return {"name": sk["name"], "meta": "%s ability  Â·  from %s" % [Sim.SLOT_KEYS[int(o["slot"])], String(d["name"]).split(" ")[0]],
				"desc": "%s\n%ss cooldown" % [sk["desc"], str(sk["cd"])], "icon": skill_kind(sk), "hero": String(o["hero"]), "rar": "legendary" if int(o["slot"]) == 3 else "rare"}
		"passive":
			var d2 := TalentData.champ(o["hero"])
			return {"name": d2["passive"]["name"], "meta": "Passive  Â·  from %s" % String(d2["name"]).split(" ")[0], "desc": d2["passive"]["desc"], "icon": "hero:" + String(o["hero"]), "hero": String(o["hero"]), "rar": "rare"}
		"rank":
			var sl := int(o["slot"])
			var sk2: Dictionary = c.def["skills"][sl]
			return {"name": sk2["name"], "meta": "%s ability  Â·  rank %d â†’ %d" % [Sim.SLOT_KEYS[sl], c.ranks[sl], c.ranks[sl] + 1], "desc": "Rank up: +35% damage and a shorter cooldown.\n" + String(sk2["desc"]), "icon": skill_kind(sk2), "hero": UIParts.ability_key_of(sk2).get_slice(":", 0), "rar": "common"}
	var it := GameData.item(o["id"])
	var lv := int(c.item_lv.get(o["id"], 0))
	var tier_names := ["", "Basic", "Advanced", "Legendary", "Mythic"]
	var lines: Array = GameData.item_lines(o["id"])
	# stats on one wrapped line, then the unique and the active in full
	var stats: Array = []
	var extra: Array = []
	for ln in lines:
		var l := String(ln)
		if l.begins_with("Unique") or l.begins_with("Active"):
			extra.append(l)
		else:
			stats.append(l.split(" (")[0])
	var desc := "  Â·  ".join(stats)
	for l in extra:
		desc += "\n" + l
	return {"name": it["name"], "meta": ("%s item  Â·  upgrade to level %d" % [tier_names[int(it["tier"])], lv + 1]) if lv > 0 else "%s item  Â·  new" % tier_names[int(it["tier"])],
		"desc": desc.strip_edges(), "icon": "item:" + String(o["id"]), "rar": ["common", "common", "rare", "legendary", "mythic"][int(it["tier"])]}


