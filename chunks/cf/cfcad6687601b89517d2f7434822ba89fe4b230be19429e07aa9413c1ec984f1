		mc.add_theme_constant_override("margin_left", 12)
		mc.add_theme_constant_override("margin_top", 6)
		mc.add_theme_constant_override("margin_bottom", 6)
		mc.add_child(cb)
		mc.visible = false
		pages[_page].add_child(mc)
		var cl: Label = main.lbl("", 14, Color(1.0, 0.62, 0.5))
		cl.size_flags_vertical = SIZE_SHRINK_CENTER
		cb.add_child(cl)
		var sw := Button.new()
		sw.text = "Swap"
		sw.focus_mode = FOCUS_NONE
		sw.custom_minimum_size = Vector2(96, 32)
		sw.pressed.connect(func(): resolve(true))
		cb.add_child(sw)
		var cn := Button.new()
		cn.text = "Cancel"
		cn.focus_mode = FOCUS_NONE
		cn.custom_minimum_size = Vector2(96, 32)
		cn.pressed.connect(func(): resolve(false))
		cb.add_child(cn)
		cb.visible = true
		conflict[gi] = {"box": mc, "lbl": cl}
	main.set_key_btns = key_caps


# A cell of a two-column binding grid: the action's name and its keycap.
func _bind_cell(grid: GridContainer, title: String, cap: KeyCap, words: String) -> Row:
	var r := Row.new()
	r.page = _page
	r.base_words = ("%s %s" % [title, words]).to_lower()
	r.words = r.base_words
	r.size_flags_horizontal = SIZE_EXPAND_FILL
	for m in [["margin_left", 12], ["margin_right", 8], ["margin_top", 4], ["margin_bottom", 4]]:
		r.add_theme_constant_override(m[0], m[1])
	var hb: HBoxContainer = main.hbox(12)
	r.add_child(hb)
	r.name_lbl = main.lbl(title, 14, UIParts.TEXT)
	r.name_lbl.size_flags_horizontal = SIZE_EXPAND_FILL
	r.name_lbl.size_flags_vertical = SIZE_SHRINK_CENTER
	r.name_lbl.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	hb.add_child(r.name_lbl)
	hb.add_child(cap)
	grid.add_child(r)
	_track(r)
	return r


