			who = pl.name
			break
	var how := "catching up…" if spec_status == "catching up" else ("live" if narrow else "live  ·  %d s behind" % roundi(Settings.spec_delay))
	spec_lbl.text = "WATCHING  ·  %s's match  ·  %s" % [who if who != "" else "online", how]
