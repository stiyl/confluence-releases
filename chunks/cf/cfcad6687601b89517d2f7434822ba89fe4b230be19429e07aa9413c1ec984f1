const DUEL_POW := {"brakk": 0.7, "briony": 0.7, "drogath": 0.8, "malric": 0.8, "caelum": 0.85, "sylra": 0.8, "ysolde": 0.8, "kiri": 0.8, "nyx": 0.9, "vasska": 0.9, "hargrim": 0.9, "grond": 0.9,
	"seraphine": 0.9, "mira": 0.85}


func duel_pow_of(src) -> float:
