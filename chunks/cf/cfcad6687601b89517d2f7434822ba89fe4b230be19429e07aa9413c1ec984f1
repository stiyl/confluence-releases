func _input(event: InputEvent) -> void:
	if _ping_input(event):
		get_viewport().set_input_as_handled()
		return
	if preview_i >= 0 and event is InputEventKey and not event.pressed and event.keycode == preview_key:
		release_preview()
		get_viewport().set_input_as_handled()
		return
	if not (event is InputEventKey) or not event.pressed or event.echo:
		return
	var key: int = event.keycode
	var focus := get_viewport().gui_get_focus_owner()
	# 0.26: "Report a bug" (F10) works anywhere: menus, hero select, match, replay, campaign, end screen, even while typing
	if key != 0 and Settings.action_for(key) == "bugreport" and rebinding == "":
		bug_report()
		get_viewport().set_input_as_handled()
		return
	# typing in a text box (glossary search, daily code, lobby chat) never fires hotkeys
	if (focus is LineEdit or focus is TextEdit) and rebinding == "":
		if key == KEY_ESCAPE and settings_ui != null and focus == settings_ui.search and focus.text != "":
			focus.text = ""   # 0.35: Esc in the Settings search clears it first
			settings_ui._apply_filter()
			get_viewport().set_input_as_handled()
			return
		if key == KEY_ESCAPE:
			focus.release_focus()
			if focus != chat_edit:
				_close_top_overlay()
			get_viewport().set_input_as_handled()
		return
	# F9 (F3 is the "guard the crystal" command): the frame-rate counter, unless F9 was bound to an action
	if key == KEY_F9 and Settings.action_for(KEY_F9) == "" and rebinding == "":
		Settings.show_fps = not Settings.show_fps
		Settings.save()
		refresh_settings()
		get_viewport().set_input_as_handled()
		return
	if key == KEY_F11 or (key == KEY_ENTER and event.alt_pressed):
		Settings.toggle_fullscreen(get_tree())
		refresh_settings()
		get_viewport().set_input_as_handled()
		return
	if key == KEY_F8 and Settings.action_for(KEY_F8) == "" and rebinding == "" and tune_ui != null:
		# 0.18.1: the live balance panel, anywhere (menu, lobby, match); 0.21: not inside a campaign chapter,
		# whose numbers are hand-tuned (the panel's "apply to Survival / campaign" knob still reads at chapter start)
		if campaign_ui != null and campaign_ui.in_mission() and not tune_ui.visible:
			show_error("The balance panel is closed during a campaign chapter.")
		else:
			tune_ui.toggle()
		get_viewport().set_input_as_handled()
		return
	if rebinding != "":
		var act := rebinding
		rebinding = ""
		if key != KEY_ESCAPE and key != 0:
			settings_ui.bind_key(act, key)   # 0.35: a key another action holds asks first (swap / cancel)
		refresh_settings()
		refresh_hotkeys()
		get_viewport().set_input_as_handled()
		return
	if _modal_open():
		# a full-screen overlay is up: Esc closes the topmost one, other keys do nothing underneath it
		if key == KEY_ESCAPE:
			_close_top_overlay()
			get_viewport().set_input_as_handled()
		return
	if campaign_ui != null and campaign_ui.scene_on:
		# in a scene: P pauses (and freezes the scene), Esc skips it, Space and Enter advance
		var pk := Settings.action_for(key) == "pause"
		if paused:
			if pk or key == KEY_ESCAPE:
				set_paused(false)
		elif pk:
			toggle_pause()
		else:
			campaign_ui.scene_key(event)
		get_viewport().set_input_as_handled()
		return
	if sim == null or not game.visible:
		return
	if end_ov.visible:
		return
	var draft_up: bool = boon_ov != null and boon_ov.visible
	if draft_up and not paused:
		var bi := [KEY_1, KEY_2, KEY_3, KEY_4].find(key)
		if bi >= 0:
			choose_boon(bi)
			get_viewport().set_input_as_handled()
			return
		if key == Settings.key("skill_r") and not sim.card_offer.is_empty():
			_reroll()
			get_viewport().set_input_as_handled()
			return
	if event.alt_pressed or event.meta_pressed:
		return
	# 0.23: the numpad Enter does what Enter does (the vote by default) unless it has a bind of its own
	if key == KEY_KP_ENTER and Settings.action_for(KEY_KP_ENTER) == "":
		key = KEY_ENTER
	# online chat: its own key ("/" by default, 0.23: Enter is the vote now); a free Enter still opens it too
	if chat_edit != null and ((mp() and (Settings.action_for(key) == "chat" or (key == KEY_ENTER and Settings.action_for(key) == ""))) or (not mp() and Settings.action_for(key) == "chat" and account.verified and chat.supported())):
		chat_edit.visible = true
		chat_edit.grab_focus()
		get_viewport().set_input_as_handled()
		return
	var skill_keys := [Settings.key("skill_q"), Settings.key("skill_w"), Settings.key("skill_e"), Settings.key("skill_r")]
	if event.ctrl_pressed:
		var li := skill_keys.find(key)
		if li >= 0 and not paused and not sim.over and not draft_up:
			human_learn(li)
			get_viewport().set_input_as_handled()
		return
	if key == KEY_ESCAPE and preview_i >= 0:
		cancel_preview()
		get_viewport().set_input_as_handled()
		return
	if key == KEY_ESCAPE and amove_armed:
		set_amove_armed(false)
		get_viewport().set_input_as_handled()
		return
	if key == KEY_ESCAPE and swap_from >= 0:
		swap_from = -1
		update_hud()
		get_viewport().set_input_as_handled()
		return
	if key == KEY_ESCAPE and not paused and _close_top_overlay():
		get_viewport().set_input_as_handled()
		return
	var act: String = Settings.action_for(key)
	if act == "pause" or key == KEY_ESCAPE:
		toggle_pause()
		get_viewport().set_input_as_handled()
		return
	if act == "board":
		toggle_board()
		get_viewport().set_input_as_handled()
		return
	if paused or sim.over or act == "":
		return
	if draft_up and act in _skill_actions():
		return   # no casting under a card or boon draft
	if run_action(act, key, event.shift_pressed):
		get_viewport().set_input_as_handled()


# 0.29: a controller button's match action, behind the same gates as the keys in _input (an overlay or a campaign
# scene takes it, nothing under the end screen, pause and the scoreboard work while paused, no casting under a draft).
func pad_action(a: String) -> bool:
	if _modal_open() or (campaign_ui != null and campaign_ui.scene_on):
		return false
	if sim == null or not game.visible or end_ov.visible:
		return false
	if a == "pause":
		toggle_pause()
		return true
	if a == "board":
		toggle_board()
		return true
	if paused or sim.over:
		return false
	if boon_ov != null and boon_ov.visible and a in _skill_actions():
		return false
	return run_action(a, -1, false)


# One match action, as its key does it (0.29: the controller calls this too, scripts/pad.gd). key is the key that
# fired it (hold-to-aim waits for its release; -1 = a controller button, which releases the aim itself).
func run_action(act: String, key := -1, shift := false) -> bool:
	if spectating:
		# 0.44: a spectator's keys: Tab / ` the scoreboard, Space follows the selected hero, the duel key; the rest is player-only
		match act:
			"view", "board":
				toggle_board()
			"center":
				_spec_follow_selected()
			"duel":
				watch_duel()
			"lane":
				toggle_enemy_view()
		return true
	match act:
		"skill_q", "skill_w", "skill_e", "skill_r":
			touch_mode = false
			var si: int = _skill_actions().find(act)
			if Settings.quick_cast or not mouse_in or not my_view():
				human_cast(si, false)
			else:
				begin_preview(si, key)
		"buyback":
			human_buyback()
		"item1", "item2", "item3", "item4", "item5", "item6":
			human_item(int(act.substr(4)) - 1)
		"cmd_help":
			human_command("help")
		"cmd_boss":
			human_command("boss")
		"cmd_crystal":
			human_command("crystal")
		"cmd_lanes":
			human_command("lanes")
		"send1", "send2", "send3", "send4", "send5", "send6", "send7", "send8":
			human_send_slot(int(act.substr(4)) - 1)
		"lane":
			set_lane(2 if lane_mode == 0 else (1 if lane_mode == 2 else 0))
		"view":
			jump_enemy_hero()   # 0.24: Tab = a random enemy hero (was: switch lanes)
		"duel":
			watch_duel()
		"center":
			center_on_hero()
		"vote":
			# 0.17: the vote key (0.25.2: F6) calls the "start next round" vote or votes yes; Shift + it votes no.
			# Campaign chapters and Survival have no vote: the key does nothing there instead of a refusal toast.
			if not sim.income_per_round:
				pass
			elif shift:
				vote_ui.press_no()
			else:
				vote_ui.press_yes()
		"attack_move":
			arm_amove()
		"stop":
			hero_cmd("stop")
		"hold":
			hero_cmd("hold")
		"auto_attack":
			toggle_auto_attack()
		"potion":
			human_potion()
		"shop":
			toggle_shop()
		"crystal":
			toggle_core(myt())
		"build1", "build2", "build3", "build4", "build5", "build6":
			human_build(int(act.substr(5)) - 1)
		_:
			return false
	return true


# 0.24 "Keep mouse in window": the cursor is confined to the window while a match is live and in focus, and freed
# on menus, the pause card, settings, the end screen, a replay and when the window loses focus. The custom cursor
# is a hardware cursor (CursorKit), so plain CONFINED; only VISIBLE <-> CONFINED are ever switched.
func _mouse_confine() -> void:
	if DisplayServer.get_name() == "headless":
		return
	var want: bool = Settings.confine_mouse and sim != null and game.visible and not sim.over and not paused and not replay_mode \
		and DisplayServer.window_is_focused() and not (menu != null and menu.is_visible_in_tree()) \
		and not (settings_ov != null and settings_ov.is_visible_in_tree()) and not (pause_ov != null and pause_ov.is_visible_in_tree()) \
		and not (end_ov != null and end_ov.is_visible_in_tree())
	var m := Input.MOUSE_MODE_CONFINED if want else Input.MOUSE_MODE_VISIBLE
	if Input.mouse_mode != m and Input.mouse_mode in [Input.MOUSE_MODE_VISIBLE, Input.MOUSE_MODE_CONFINED]:
		Input.mouse_mode = m


func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT and sim != null and game.visible and not sim.over and not paused and not mp() and not replay_mode:
		set_paused(true)


# ---------------------------------------------------------------- abilities
func human_learn(i: int) -> void:
	if sim == null or sim.over or replay_mode:
		return
	var c = sim.players[sim.local].champ
	if c.def["skills"][i].get("empty", false):
		show_error("That slot is empty: ability cards at the end of a round fill it.")
		return
	if c.points <= 0:
		show_error("No ability points. You get one each level up to level %d." % Sim.SKILL_LEVELS)
		return
	if c.ranks[i] >= Sim.MAX_RANK:
		show_error("%s is already at rank %d." % [c.def["skills"][i]["name"], Sim.MAX_RANK])
		return
	if not act("learn", [i]):
		show_error("%s rank %d needs hero level %d." % [c.def["skills"][i]["name"], c.ranks[i] + 1, Sim.rank_req(i, c.ranks[i] + 1)])
		return
	skill_btns[i].flash = 0.3
	update_hud()
	if tip_source == skill_btns[i]:
		show_skill_tip(i)


