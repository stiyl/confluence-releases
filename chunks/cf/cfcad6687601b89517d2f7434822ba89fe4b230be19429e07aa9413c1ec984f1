	return true


static func season_skin(season: int) -> String:
	for s in SKINS:
		if int(s.get("season", 0)) == season:
			return String(s["id"])
	return ""


static func season_title_id(season: int, tier: int) -> String:
	return "rk_s%d_%d" % [season, tier]


static func season_title_season(id: String) -> int:
	return int(id.trim_prefix("rk_s").get_slice("_", 0))


static func season_title_tier(id: String) -> int:
	return int(id.trim_prefix("rk_s").get_slice("_", 1))


# The season titles this profile owns (ids), newest season first.
static func season_titles() -> Array:
	ensure()
	var out: Array = []
	for k in ranked_rewards:
		if String(k).begins_with("title:"):
			out.append(season_title_id(int(String(k).get_slice(":", 1)), int(ranked_rewards[k])))
	out.sort()
	out.reverse()
	return out
␀␀␀␀␀␀␀␀␀␀# 0.43: achievement badges, drawn in code: a silver medallion (bright when unlocked, dark stone with a lock when
# not) around an emblem. The emblem is an item / monster / hero sprite ("i:", "m:", "h:"), an ability glyph ("a:")
# or one of the simple shapes below ("g:"). Used by the Profile's Achievements tab and the unlock toast.
