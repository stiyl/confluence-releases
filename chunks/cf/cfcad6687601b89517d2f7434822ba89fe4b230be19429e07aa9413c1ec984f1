	_fill_syn(boon_syn, sim.syn_counts, 13, true)
	if boon_syn.get_child_count() == 0:
		var hint := lbl("Synergies: collect 2, 4 or 6 cards that share a tag (Fire, Frost, Storm, Precision, Summoner, Tank, Arcane, Swift) for growing bonuses.", 13, MUTED)
		boon_syn.add_child(hint)
