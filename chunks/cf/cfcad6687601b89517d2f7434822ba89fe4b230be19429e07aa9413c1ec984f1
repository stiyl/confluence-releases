const GRAVE_TIERS := [
	{"name": "Barrow Skeleton", "kind": "minion", "lvl": 1, "dmg": 8.0, "hp": 170.0, "size": 7.0},
	{"name": "Barrow Warrior", "kind": "skeleton", "lvl": 10, "dmg": 20.0, "hp": 320.0, "size": 8.5},
	{"name": "Barrow Knight", "kind": "skeleton", "lvl": 20, "dmg": 30.0, "hp": 520.0, "size": 10.5},
]
const GRAVE_LIFE := 30.0        # a risen skeleton crumbles after this long
const GRAVE_SPD := 150.0
const GRAVE_MARCH := 450.0      # a skeleton marches at most this far up the road from where it rose
const CHARM_SPD := 150.0
const CHARM_DMG_K := 1.5        # a charmed monster hits monsters this much harder than it hit heroes
const SUM_CLASH_K := 0.6        # share of a monster's damage rating it deals to a risen or charmed unit it touches


func grave_tier(c) -> Dictionary:
	var tr: Dictionary = GRAVE_TIERS[0]
	for g in GRAVE_TIERS:
		if c.lvl >= int(g["lvl"]):
			tr = g
	return tr


func tagged_count(ar, c, tag: String) -> int:
	var n := 0
	for su in ar.sums:
		if su.c == c and su.tag == tag and su.t > 0:
			n += 1
	for su in ar.sums_new:
		if su.c == c and su.tag == tag:
			n += 1
	return n


# Gravebound: a marked lane monster died; it rises as a skeleton that marches up the road for Corvina.
func grave_rise(ar, c, m) -> void:
	var p: Dictionary = c.def["passive"]
	if tagged_count(ar, c, "grave") >= int(p.get("max", 4)):
		return
	var tr := grave_tier(c)
	var s := Summon.new()
	s.tag = "grave"
	s.kind = String(tr["kind"])
	s.name = String(tr["name"])
	s.p = m.p if m.fly else bridge_push(m.p, 8.0)
	s.c = c
	var k: float = lvl_mult(c) * c.pow
	s.dmg = f(tr, "dmg") * k * float(c.syn_fx.get("summon_dmg", 1.0))
	s.max_hp = f(tr, "hp") * k * mon_scale()
	s.hp = s.max_hp
	s.atk_speed = 1.1
	s.reach = 24.0
	s.t = GRAVE_LIFE * float(c.syn_fx.get("summon_dur", 1.0))
	s.dur = s.t
	s.mobile = true
	s.size = f(tr, "size")
	s.r = s.size
	s.col = c.col
	s.face = m.ang + PI
	s.path = m.path
	s.wi = m.wi
	s.home = s.p
	ar.sums_new.append(s)
	add_fx(ar, {"type": "ring", "p": s.p, "r": 22.0, "col": Color("#9dffc8"), "t": 0.5, "dur": 0.5, "fill": true})
	add_text(ar, s.p + Vector2(0, -24), "RISEN", Color("#9dffc8"), 0.8, 10)


# Grave Covenant: the health a monster may have to be charmed at this rank (0 = any non-boss).
func charm_cap(c, si: int, a: Dictionary) -> float:
	var caps: Array = a.get("cap", [0])
	return float(caps[clampi(c.ranks[si] - 1, 0, caps.size() - 1)])


func charmable(m, cap_hp: float) -> bool:
	return m is Mon and not m.dead and not m.d.get("boss", false) and not m.d.get("camp", false) and m.spd > 0.0 \
		and m.kind != "totem" and (cap_hp <= 0.0 or m.max_hp <= cap_hp)


# The monster a cast at tp charms: the charmable one nearest the aim, else the toughest charmable one in reach.
func charm_pick(ar, c, tp: Vector2, reach: float, cap_hp: float):
	var best = null
	var bd := 120.0
	for m in ar.mons:
		if charmable(m, cap_hp) and m.p.distance_to(c.p) <= reach + m.r:
			var d: float = m.p.distance_to(tp) - m.r
			if d < bd:
				bd = d
				best = m
	if best != null:
		return best
	var bh := -1.0
	for m in ar.mons:
		if charmable(m, cap_hp) and m.p.distance_to(c.p) <= reach + m.r and m.max_hp > bh:
			bh = m.max_hp
			best = m
	return best


func charm_mon(ar, c, m, a: Dictionary, si: int) -> void:
	# it leaves the wave quietly: no bounty, no experience (charming is not a way to farm gold)
	m.dead = true
	var s := Summon.new()
	s.tag = "charm"
	s.kind = m.kind
	s.name = String(m.d.get("name", m.kind))
	s.p = m.p
	s.home = m.p if m.fly else bridge_push(m.p, m.r)
	s.c = c
	s.max_hp = m.max_hp
	s.hp = m.max_hp
	var rk: float = 1.0 + 0.35 * maxi(0, c.ranks[si] - 1)
	if m.d.has("ranged"):
		var rg: Dictionary = m.d["ranged"]
		s.reach = f(rg, "range") * 0.9
		s.atk_speed = 1.0 / maxf(0.3, f(rg, "cd", 1.5))
		s.dmg = f(rg, "dmg") * mon_scale() * m.dmg_k * CHARM_DMG_K * rk
		s.splash = f(rg, "splash")
	else:
		s.reach = m.r + 16.0
		s.atk_speed = 1.0
		s.dmg = m.dps * CHARM_DMG_K * rk
	s.dmg = maxf(s.dmg, 20.0 * lvl_mult(c)) * c.pow
	s.mobile = true
	s.size = m.r
	s.r = m.r
	s.col = c.col
	s.face = m.ang
	s.t = 1.0e9
	s.dur = s.t
	# a covenant has room for so many: the oldest is released (crumbles) when a new one is bound
	var cap_n: Array = a.get("max", [1])
	var keep := int(cap_n[clampi(c.ranks[si] - 1, 0, cap_n.size() - 1)])
	var mine: Array = ar.sums.filter(func(x): return x.c == c and x.tag == "charm" and x.t > 0)
	while mine.size() >= keep and not mine.is_empty():
		var old = mine.pop_front()
		old.t = 0.0
		burst(ar, old.p, Color("#9dffc8"), 10, 90)
	ar.sums.append(s)
	add_fx(ar, {"type": "ring", "p": s.p, "r": m.r + 26.0, "col": Color("#9dffc8"), "t": 0.6, "dur": 0.6, "fill": true, "vis": "%s:%d" % [c.def.get("id", ""), si]})
	add_fx(ar, {"type": "beam", "p": c.p, "p2": s.p, "w": 6.0, "col": Color("#9dffc8"), "t": 0.35, "dur": 0.35})
	add_text(ar, s.p + Vector2(0, -m.r - 26), "BOUND", Color("#9dffc8"), 1.2, 13)


# Soul Tether: drains the target while Corvina stands still. Returns false once the channel has ended.
func chan_step(ar, c, dt: float) -> bool:
	var ch: Dictionary = c.chan
	var m = ch["tgt"]
	if ch["ar"] != ar or m == null or m.dead or not ar.mons.has(m) or m.p.distance_to(c.p) > f(ch, "leash") + m.r:
		c.chan = null
		return false
	ch["t"] = f(ch, "t") - dt
	c.face = (m.p - c.p).angle()
	var hp0: float = m.hp
	_hit_ctx = "dot"
	hurt(ar, m, f(ch, "dps") * dt, c, false, true)
	_hit_ctx = ""
	var got: float = maxf(0.0, hp0 - maxf(m.hp, 0.0))
	if got > 0:
		heal_champ(c, got * f(ch, "heal", 1.0))
	if f(ch, "t") <= 0 or m.dead:
		c.chan = null
		return false
	return true


# Silver Oath: the attack damage share Ysolde's aura gives her (allies get "ally" of it).
func oath_pct(c) -> float:
	var p: Dictionary = c.def["passive"]
	return minf(f(p, "cap", 0.4), f(p, "base") + f(p, "per") * attr_gain(c, "cun"))


# ---- 0.27 briony ----
# Briony Thornhallow, the Hedgewarden (Support). Quickening, her passive: allied heroes within its radius (and
# she) recover ability cooldowns faster, so every cooldown spent near her ends quicken_x seconds sooner (a
# cooldown never runs more than twice as fast). Her hymns (Briarsight, Barkskin) are timed auras refreshed on
# the allies near her every BRIONY_TICK; Heartwood Mantle shields; Wall of Thorns is a line of small zones.
const BRIONY_TICK := 0.25


func quicken_x(c) -> float:
	var p: Dictionary = c.def["passive"]
	var x := 0.0
	var at: Array = p.get("at", [])
	for k in at.size():
		if c.lvl >= int(at[k]):
			x = float(p["steps"][k])
	return x


# How much faster ability i's cooldown runs on this hero (1.0 outside every Quickening aura).
func quicken_rate(c, i: int) -> float:
	var q := 0.0
	for b in c.buffs:
		if b.has("quick"):
			q = maxf(q, float(b["quick"]))
	if q <= 0.0:
		return 1.0
	var full := skill_cd(c, i)
	if full <= 0.01:
		return 1.0
	return full / maxf(full - q, full * 0.5)


func briony_auras(ar, c, dt: float) -> void:
	c.hymn_t -= dt
	if c.hymn_t > 0:
		return
	c.hymn_t = BRIONY_TICK
	for k in c.hymns.keys():
		if t >= float(c.hymns[k]["end"]):
			c.hymns.erase(k)
	# 0.27.1: her own hymns are always on once learned, at the strength of their current rank (the user's call)
	var sks: Array = c.def["skills"]
	for si in sks.size():
		var sk: Dictionary = sks[si]
		if not sk.get("always", false) or int(c.ranks[si]) <= 0:
			continue
		for a in sk["acts"]:
			if String(a.get("t", "")) != "hymn":
				continue
			var rk: int = int(c.ranks[si]) - 1
			var h := {"end": t + 1e9, "melee": f(a, "melee"), "r": f(a, "r", 350)}
			for kk in ["rng", "adm", "armor"]:
				if a.has(kk):
					var arr: Array = a[kk]
					h[kk] = float(arr[mini(rk, arr.size() - 1)])
			c.hymns[String(a["key"])] = h
	var p: Dictionary = c.def["passive"]
	var id: int = c.pl.id
	var qx := quicken_x(c) if String(p.get("t", "")) == "quicken" else 0.0
	var qr := f(p, "r", 350) if qx > 0 else 0.0
	var hr := 0.0
	for k in c.hymns:
		hr = maxf(hr, f(c.hymns[k], "r", 350))
	for o in ar.champs:
		if o.dead or o.pl.team != c.pl.team:
			continue
		var od: float = 0.0 if o == c else o.p.distance_to(c.p)
		if od > maxf(qr, hr):
			continue
		o.buffs = o.buffs.filter(func(b): return not (b.has("hymn") and b["hymn"] == id))
		if od > hr:
			if qx > 0:
				o.buffs.append({"t": BRIONY_TICK + 0.15, "hymn": id, "quick": qx})
			continue
		if qx > 0 and od <= qr:
			o.buffs.append({"t": BRIONY_TICK + 0.15, "hymn": id, "quick": qx})
		if c.hymns.has("q"):
			# Briarsight: ranged heroes reach further and their basic attacks hit harder; melee heroes get part of the damage
			var hq: Dictionary = c.hymns["q"]
			var b := {"t": BRIONY_TICK + 0.15, "hymn": id, "hymn_q": true}
			if f(o.base, "range") > 60:
				b["rng"] = f(hq, "rng")
				b["adm"] = f(hq, "adm")
			else:
				b["adm"] = f(hq, "adm") * f(hq, "melee")
			o.buffs.append(b)
		if c.hymns.has("w"):
			o.buffs.append({"t": BRIONY_TICK + 0.15, "hymn": id, "hymn_w": true, "armor_add": f(c.hymns["w"], "armor")})


func briony_act(ar, c, a: Dictionary, tp: Vector2, si: int, vk: String) -> void:
	var rk: int = maxi(1, int(c.ranks[si])) - 1
	var col: Color = c.col
	var r := f(a, "r", 350)
	match String(a["t"]):
		"hymn":
			var h := {"end": t + f(a, "dur"), "melee": f(a, "melee"), "r": r}
			for k in ["rng", "adm", "armor"]:
				if a.has(k):
					var arr: Array = a[k]
					h[k] = float(arr[mini(rk, arr.size() - 1)])
			c.hymns[String(a["key"])] = h
			c.hymn_t = 0.0
			add_fx(ar, {"type": "ring", "p": c.p, "r": r, "col": col, "t": 0.5, "dur": 0.5})
			add_fx(ar, {"type": "ring", "p": c.p, "r": 30.0, "col": col, "t": 0.4, "dur": 0.4, "follow": c, "vis": vk})
			for o in ar.champs:
				if o != c and not o.dead and o.pl.team == c.pl.team and o.p.distance_to(c.p) <= r:
					add_fx(ar, {"type": "ring", "p": o.p, "r": 26.0, "col": col, "t": 0.4, "dur": 0.4, "follow": o})
		"mantle":
			# Heartwood Mantle: a shield of a share of each ally's own max health, for dur seconds
			var pct := (f(a, "pct") + f(a, "per") * rk) * (1.0 + c_ap(c)) * ab_k(c, si)
			add_fx(ar, {"type": "ring", "p": c.p, "r": r, "col": Color("#c8e6a0"), "t": 0.5, "dur": 0.5})
			for o in ar.champs:
				if o.dead or o.pl.team != c.pl.team or (o != c and o.p.distance_to(c.p) > r):
					continue
				var amt: float = o.max_hp * pct
				o.shield += amt * duel_sus(o)
				o.shield_t = maxf(o.shield_t, f(a, "dur"))
				add_text(ar, o.p + Vector2(0, -26), "+%d" % roundi(amt), Color("#bfe8ff"))
				add_fx(ar, {"type": "ring", "p": o.p, "r": 32.0, "col": col, "t": 0.5, "dur": 0.5, "follow": o, "vis": vk})
		"thornwall":
			# Wall of Thorns: a hedge from just in front of her toward the cursor. It does not block: whatever
			# walks through is slowed and bleeds (a burn) while inside and for `linger` seconds after.
			var aim := aim_at(c, tp, -1)
			var u: Vector2 = aim["u"]
			var s0: Vector2 = c.p + u * f(a, "gap", 40)
			var ln := f(a, "len")
			var w := f(a, "w")
			var n := maxi(2, ceili(ln / (w * 0.75)) + 1)
			var bl: float = f(a, "dps") * rank_mult(c, si) * c.pow   # 0.38: no attack buffs on an ability
			for k in n:
				var zp: Vector2 = s0 + u * (ln * k / (n - 1))
				if zp.x < 0 or zp.x > W or zp.y < 0 or zp.y > H:
					continue
				var z := Zone.new()
				z.p = zp
				z.r = w / 2.0
				z.slow = f(a, "slow")
				z.bleed = bl
				z.linger = f(a, "linger")
				z.wang = u.angle()
				z.t = f(a, "dur")
				z.dur = z.t
				z.c = c
				z.col = col
				z.vis = vk
				z.spin = rng.randf() * 6.0
				ar.zones.append(z)
			add_fx(ar, {"type": "beam", "p": s0, "p2": s0 + u * ln, "w": w, "col": col, "t": 0.35, "dur": 0.35})


# A thorn zone's bleed: a burn (so it keeps ticking `linger` s after the target leaves). It never weakens a
# stronger burn already on the target; overlapping wall segments only refresh it.
func thorn_bleed(m, z) -> void:
	if m.burn_t <= 0 or z.bleed >= m.burn_dps:
		m.burn_dps = z.bleed
		m.burn_src = z.c
	m.burn_t = maxf(m.burn_t, z.linger)


