	if not is_host or not peer_slot.has(pid):
		return
	var i: int = peer_slot[pid]
	peer_slot.erase(pid)
	if not _peer_ok():
		return   # it is our own connection that went (relay host): _drop handles it, nobody can be told
	var nm: String = lobby["slots"][i]["name"]
	if in_match:
		pending.append([i, "drop", []])
		_roster.rpc(peer_slot)
