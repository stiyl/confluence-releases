static func cost(t: Dictionary) -> int:
	return int(t.get("cost", 1))


static func points_for(xp: int) -> int:
	var n := 0
	for need in POINT_AT:
		if xp >= need:
			n += 1
	return mini(n, MAX_POINTS)


# Talent experience needed for the next point, or -1 at the cap.
static func next_point_at(xp: int) -> int:
	for need in POINT_AT:
		if xp < need:
			return need
	return -1


static func find(hero: String, id: String) -> Dictionary:
	for t in tree(hero):
		if t["id"] == id:
			return t
	return {}


static func spent(hero: String, taken: Array) -> int:
	var s := 0
	for id in taken:
		var t := find(hero, id)
		if not t.is_empty():
			s += cost(t)
	return s


# "" if the talent can be taken now, otherwise why not.
static func why_not(hero: String, taken: Array, id: String, points: int) -> String:
	var t := find(hero, id)
	if t.is_empty():
		return "Unknown talent."
	if taken.has(id):
		return "Already taken."
	for r in t.get("req", []):
		if not taken.has(r):
			return "Needs %s first." % find(hero, r)["name"]
	var any: Array = t.get("req_any", [])
	if not any.is_empty() and not any.any(func(r): return taken.has(r)):
		return "Needs %s or %s first." % [find(hero, any[0])["name"], find(hero, any[1])["name"]]
	if spent(hero, taken) + cost(t) > points:
		return "Not enough talent points (%d needed)." % cost(t)
	return ""


# Removing a talent also removes everything that depended on it.
static func without(hero: String, taken: Array, id: String) -> Array:
	var out: Array = taken.filter(func(x): return x != id)
	var changed := true
	while changed:
		changed = false
		for x in out.duplicate():
			var t := find(hero, x)
			var ok := true
			for r in t.get("req", []):
				if not out.has(r):
					ok = false
			var any: Array = t.get("req_any", [])
			if not any.is_empty() and not any.any(func(r): return out.has(r)):
				ok = false
			if not ok:
				out.erase(x)
				changed = true
	return out


# The effect dictionaries of a set of talents, for the simulation.
static func effects(hero: String, taken: Array) -> Array:
	var out: Array = []
	for id in taken:
		var t := find(hero, id)
		if not t.is_empty():
			out.append(t["fx"])
	return out
␀# 0.46: anonymous usage data and crash reports, so balance and bug fixes come from real games.
# Settings > Online > "Share usage & crash data" (Settings.share_data, on by default) turns all of it off; off also
# drops anything still waiting to be sent.
#
# What is sent, and to where (plain HTTPS from GDScript: no native library, so it reaches every player through the
# updater, which only replaces the pck):
# - PostHog (POST /batch/): app_started, match_started, match_finished (your hero, mode, map, length, result, kills,
#   deaths, damage, gold sent...), hero_result (one per hero in a decided match: hero, team, won; online only the
#   host sends these, so a match counts once). Keyed by a random id made on first launch (user://telemetry.cfg),
#   never the profile name, account key, friends or chat. No person profiles ($process_person_profile false).
# - Sentry (POST /api/<project>/envelope/): at launch, what went wrong in the previous session: a crash (the
#   session never closed: user://session_running.json was left behind; the last log lines go along, with chat
#   lines dropped and names / the OS user name blanked) and the SCRIPT ERROR / USER ERROR / ERROR lines of its log
#   (grouped, at most MAX_ERRORS different ones per session).
# Events wait in user://telemetry_queue.json while offline and go out later (at most QUEUE_MAX).
