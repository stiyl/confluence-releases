func set_difficulty(i: int) -> void:
	difficulty = i
	for k in diff_btns.size():
		diff_btns[k].set_pressed_no_signal(k == i)


func start_ban_phase() -> void:
	draft_phase = "ban"
	ban_votes = []
	bans = []
	ban_counts = {}
	var mates := team_size_of(game_mode) - 1
	draft_tag.text = "Ban vote: click up to two champions you want banned, then cast your votes. " + (("Your %s vote too, and each" % ("teammate" if mates == 1 else "%d teammates" % mates)) if mates > 0 else "The enemy votes too, and each") + " team's two most-voted champions are banned. Then you choose your hero."
	_refresh_ban_marks()
	select_champ(sel_id)


func _refresh_ban_marks() -> void:
	for id in tiles:
		var b: Button = tiles[id]
		var mark: UIParts.BanMark = ban_marks[id]
		if bans.has(id):
			mark.state = "banned"
			mark.count = int(ban_counts.get(id, 0))
			b.modulate = Color(0.78, 0.72, 0.7)
		elif ban_votes.has(id):
			mark.state = "vote"
			b.modulate = Color.WHITE
		else:
			mark.state = ""
			b.modulate = Color.WHITE
		mark.queue_redraw()


func select_champ(id: String) -> void:
	if game_mode == "daily":
		id = SurvivalData.daily_hero(SurvivalData.today())
	if locking:
		tiles[id].set_pressed_no_signal(id == sel_id)
		return
	if not tiles.has(id):
		id = GameData.CHAMPS[0]["id"]
	sel_id = id
	if draft_phase == "ban" and pb == null:
		if ban_votes.has(id):
			ban_votes.erase(id)
		else:
			ban_votes.append(id)
			if ban_votes.size() > 2:
				ban_votes.pop_front()
		_refresh_ban_marks()
	for k in tiles:
		tiles[k].set_pressed_no_signal(k == id)
	render_detail()
	render_slots({})


# Every player on a team votes for two champions; each team bans its two most-voted (ties go to your votes).
func cast_ban_votes() -> void:
	var team_votes := [{}, {}]
	for v in ban_votes:
		team_votes[0][v] = int(team_votes[0].get(v, 0)) + 1
	var all_ids: Array = []
	for c in GameData.CHAMPS:
		all_ids.append(c["id"])
	for tm in 2:
		var ts := team_size_of(game_mode)
		for voter in (ts - 1 if tm == 0 else ts):
			var pool := all_ids.duplicate()
			pool.shuffle()
			# AI voters often agree with the player on their team
			if tm == 0 and ban_votes.size() > 0 and randf() < 0.45:
				pool.push_front(ban_votes[randi() % ban_votes.size()])
			var picked: Array = []
			for id in pool:
				if picked.size() >= 2:
					break
				if not picked.has(id):
					picked.append(id)
			for id in picked:
				team_votes[tm][id] = int(team_votes[tm].get(id, 0)) + 1
	bans = []
	ban_counts = {}
	var summary: Array = []
	for tm in 2:
		var ids: Array = team_votes[tm].keys()
		ids.shuffle()
		ids.sort_custom(func(a, b):
			var ca: int = team_votes[tm][a]
			var cb: int = team_votes[tm][b]
			if ca != cb:
				return ca > cb
			return tm == 0 and ban_votes.has(a) and not ban_votes.has(b))
		var got: Array = []
		for id in ids:
			if got.size() >= 2:
				break
			if bans.has(id):
				continue
			got.append(id)
			bans.append(id)
			ban_counts[id] = team_votes[tm][id]
		var names: Array = []
		for id in got:
			names.append("%s (%d)" % [String(find_champ(id)["name"]).split(" ")[0], int(team_votes[tm][id])])
		summary.append(" and ".join(names))
	draft_phase = "pick"
	ban_votes = []
	_refresh_ban_marks()
	draft_tag.text = "Bans: your team voted out %s; the Cinder Host voted out %s. %s" % [summary[0], summary[1], "Now roll your random hero." if game_mode == "allrandom" else "Now choose your hero."]
	if bans.has(sel_id):
		for c in GameData.CHAMPS:
			if not bans.has(c["id"]):
				sel_id = c["id"]
				break
	select_champ(sel_id)


func find_champ(id: String) -> Dictionary:
	for c in GameData.CHAMPS:
		if c["id"] == id:
			return c
	return GameData.CHAMPS[0]


