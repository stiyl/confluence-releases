				if e.get("human", false):
					announce("You duel in %d rounds" % Sim.DUEL_NOTICE, vs + "  ·  round %d: buy items, learn abilities, be ready" % int(e["round"]), 3, 4.5)
					push_alert("duel_soon", "Your duel is in %d rounds (round %d)" % [Sim.DUEL_NOTICE, int(e["round"])], GOLD_HOT, 8.0, "")
				else:
					announce("Duel in %d rounds" % Sim.DUEL_NOTICE, vs + "  ·  round %d" % int(e["round"]), 2, 4.0)
			"duel_start":
				audio.play("duel_start", 0.0)
				minimap.ping(Sim.JUNCTION_POS, GOLD_HOT, 2)
				duel_cast = false
				clear_announcements()
				duel_prev_view = arena_view.arena_idx
				# the whole match stops to watch: everyone's view goes to the ring
				set_view_arena(2)
				arena_view.recenter()
				event_hud.on_event(e)   # 0.16: the duel card with the countdown (replaces the "Duel!" announcement)
				if e.get("human", false):
