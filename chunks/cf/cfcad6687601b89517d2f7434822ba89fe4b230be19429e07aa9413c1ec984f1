func human_send(k: int, slot := -1) -> void:
	if sim == null or sim.over or paused or replay_mode:
		return
	if sim.mode == "survival":
		show_error("There is no enemy team in Survival: spend your gold on items, scrolls and the crystal.")
		return
	var lane := lane_mode
	if lane == 2:
		lane = lane_alt
	if not Sim.send_unlocked(sim.players[sim.local], k):
		var need: Dictionary = GameData.BUILDINGS[int(GameData.SENDS[k]["b"])]
		show_error("Build the %s (%s) first." % [need["name"], Settings.key_name("build%d" % (int(GameData.SENDS[k]["b"]) + 1))])
		return
	var why := sim.send_refusal(sim.players[sim.local], k)
	if why != "":
		show_error(why)
		return
	var res = act("send", [k, lane])
	if _res_none(res):
		return
	if _res_ok(res):
		if lane_mode == 2:
			lane_alt = 1 - lane_alt
		if slot >= 0:
			send_btns[slot].flash = 0.25
		update_hud()
	else:
		show_error("Not enough gold.")


# Takes back the last monster queued for the enemy's next wave (sim command "unsend"; nothing happens
# if this build of the simulation lacks it).
func human_unsend() -> void:
	if sim == null or sim.over or paused or replay_mode:
		return
	var lane := lane_mode
	if lane == 2:
		lane = 1 - lane_alt
	var res = act("unsend", [lane])
	if not _res_ok(res):
		if res is bool:
			show_error("Nothing of yours is queued through that rift.")
		return
	if _res_ok(res):
		audio.play("coin", -6.0)
		show_good("Send cancelled: the gold is back in your purse.")
		update_hud()
	elif res is String:
		show_error(res)


func auto_aim(c) -> Vector2:
	if c.ar.duel and sim.duel_pair.size() == 2:
		var foe = sim.duel_pair[1] if sim.duel_pair[0] == c else sim.duel_pair[0]
		return foe.p
	var best = null
	var bs := -INF
	for m in c.ar.mons:
		if m.dead:
			continue
		var d: float = m.p.distance_to(c.p)
		if d > 380:
			continue
		var s := Sim.progress(m) * 0.2 - d
		if s > bs:
			bs = s
			best = m
	return best.p if best != null else c.p + Vector2.from_angle(c.face) * 80


func human_cast(i: int, auto: bool) -> void:
	if sim == null or sim.over or paused or replay_mode:
		return
	if boon_ov != null and boon_ov.visible:
		return
	var c = sim.players[sim.local].champ
	if c.dead:
		show_error("Your hero is dead.")
		return
	if c.def["skills"][i].get("empty", false):
		show_error("That slot is empty: ability cards at the end of a round fill it.")
		return
	if c.ranks[i] <= 0:
		show_error("You haven't learned %s yet. Spend an ability point on it (%s or the + button)." % [c.def["skills"][i]["name"], Settings.learn_name(_skill_actions()[i])])
		return
	if c.def["skills"][i].get("always", false):
		show_error("%s is always on: it needs no cast." % c.def["skills"][i]["name"])
		return
	if c.cds[i] > 0:
		show_error("That ability is not ready yet.")
		return
	var aim_with_mouse := not auto and mouse_in and my_view()
	var target: Vector2 = mouse_world if aim_with_mouse else auto_aim(c)
	if _res_ok(act("cast", [i, target])):
		skill_btns[i].flash = 0.25
		if c.ar.duel:
			duel_cast = true


func on_world_pressed(pos: Vector2, button: int, touch: bool) -> void:
	touch_mode = touch
	if spectating and sim != null and not sim.over and button == MOUSE_BUTTON_LEFT:
		# 0.44: click a hero to follow it, a monster to inspect it; the ground frees the camera
		var so = arena_view.pick(pos)
		if so is Sim.Champ:
			inspect_player(so.pl.id)
		elif so != null:
			arena_view.follow = false
			select_unit(so)
		else:
			arena_view.follow = false
		return
	if sim == null or sim.over or paused or replay_mode:
		return
	if button == MOUSE_BUTTON_LEFT and preview_i < 0 and ping_held() and ping_begin(pos, arena_view.arena_idx, get_viewport().get_mouse_position(), "mouse"):
		return   # 0.31: Ping key + click: a ping (hold and drag: the wheel), not a select
	mouse_world = pos
	if preview_i >= 0:
		if button == MOUSE_BUTTON_LEFT:
			release_preview()
		else:
			cancel_preview()
		return
	var o = arena_view.pick(pos)
	var armed := amove_armed
	if button == MOUSE_BUTTON_LEFT and o != null and not armed:
		select_unit(o)
		return
	if button == MOUSE_BUTTON_LEFT and o == null and not armed:
		if Rect2(Sim.SHOP + Vector2(-95, -150), Vector2(190, 175)).has_point(pos) and arena_view.arena_idx == myt():
			if not shop_panel.visible:
				toggle_shop()
			return
		if Rect2(Sim.CORE + Vector2(-70, -170), Vector2(140, 200)).has_point(pos):
			if not core_panel.visible or core_view_team != arena_view.arena_idx:
				toggle_core(arena_view.arena_idx)
			return
	set_amove_armed(false)
	if not my_view():
		if button == MOUSE_BUTTON_RIGHT or armed:
			show_error("Your hero isn't here. Press F to go back to it.")
		return
	var c = sim.players[sim.local].champ
	if c.dead:
		return
	if o is Sim.Champ and o != c and c.ar.duel and (armed or button == MOUSE_BUTTON_RIGHT):
		act("order", ["attack", pos, sim.ref_of(o)])
		arena_view.move_mark = {"p": o.p, "t": 0.5, "col": Color(1.0, 0.3, 0.25)}
		return
	if o is Sim.Mon and (armed or button == MOUSE_BUTTON_RIGHT):
		act("order", ["attack", pos, sim.ref_of(o)])
		arena_view.move_mark = {"p": o.p, "t": 0.5, "col": Color(1.0, 0.3, 0.25)}
		return
	if armed:
		act("order", ["amove", pos])
		arena_view.move_mark = {"p": c.move_to if not mp() else sim.walk_clamp(pos), "t": 0.5, "col": Color(1.0, 0.3, 0.25)}
	else:
		act("order", ["move", pos])
		arena_view.move_mark = {"p": c.move_to if not mp() else sim.walk_clamp(pos), "t": 0.5, "col": Color(0.3, 1.0, 0.35)}


