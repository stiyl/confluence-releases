# 0.32.1: sizes the lobby to the window (any resolution, any UI scale): the side columns narrow, the hero tiles
# shrink and then wrap, the slots get shorter, so nothing leaves the screen and nothing overlaps.
func _lobby_fit() -> void:
	if lobby_ov == null or not lobby_ov.is_visible_in_tree():
		return
	var vp: Vector2 = lobby_ov.size
	var w := vp.x - 80.0
	var teams_w := clampf(w * 0.27, 290.0, 430.0)
	var det_w := clampf(w * 0.22, 250.0, 340.0)
	var cols := 1
	for g in lobby_hero_grids:
		cols = maxi(cols, (g as GridContainer).get_child_count())
	var room := w - teams_w - det_w - 36.0 - 28.0 - 76.0
	var tile := 64.0
	if room < cols * 70.0:
		tile = 56.0
	if room < cols * 62.0:
		# still too narrow: give the columns a little more back before wrapping
		teams_w = maxf(260.0, teams_w - (cols * 62.0 - room))
		room = w - teams_w - det_w - 36.0 - 28.0 - 76.0
	var per := clampi(int(room / (tile + 6.0)), 3, cols)
	lobby_teams_scroll.custom_minimum_size.x = teams_w
	lobby_chat.custom_minimum_size.y = 92.0 if vp.y >= 800.0 else 56.0
	lobby_detail_panel.custom_minimum_size.x = det_w
	for g in lobby_hero_grids:
		(g as GridContainer).columns = per
	if tile != lobby_tile:
		lobby_tile = tile
		for id in lobby_hero_btns:
			var hb: Button = lobby_hero_btns[id]
			hb.custom_minimum_size = Vector2(tile, tile + 14.0)
			var pt: Control = hb.get_node_or_null("Pt")
			if pt != null:
				var ps := tile - 18.0
				pt.size = Vector2(ps, ps)
				pt.position = Vector2((tile - ps) / 2.0, 5)
	# slot height: what the window leaves for the body
	var ts := net.team_size() if not net.lobby.is_empty() else 4
	var fixed := lobby_col.get_combined_minimum_size().y - lobby_body.get_combined_minimum_size().y
	var body_room := vp.y - 52.0 - fixed
	var sh := clampf((body_room - 2.0 * 30.0 - 10.0 - 2.0 * ts * 6.0) / (2.0 * ts), 34.0, 54.0)
	for i in lobby_slot_btns.size():
		var b: Button = lobby_slot_btns[i]
		b.custom_minimum_size.y = sh
		var fh: Control = lobby_slot_faces[i]
		var fs := minf(sh - 10.0, 42.0)
		fh.offset_top = (sh - fs) / 2.0
		fh.offset_bottom = -(sh - fs) / 2.0
		fh.offset_right = fh.offset_left + fs
	lobby_btn_col.custom_minimum_size.x = clampf(w * 0.2, 260.0, 320.0)


func _lobby_chat_line(t: String) -> void:
	if chat != null:
		t = chat.clean(t)   # 0.30: Settings > Filter chat
	lobby_chat_lines.append(t)
	while lobby_chat_lines.size() > 5:
		lobby_chat_lines.pop_front()
	lobby_chat.text = "\n".join(lobby_chat_lines)
	if game.visible and sim != null:
		mp_chat.append([t, Time.get_ticks_msec()])
		while mp_chat.size() > 12:
			mp_chat.pop_front()


# 0.46.1: the first-time "How this mode works" card in the online lobby too, for everyone in it (host and guests):
# when the lobby's mode or map is one with a card that this player hasn't seen yet.
var _lobby_card_key := ""


func _lobby_mode_card(l: Dictionary) -> void:
	if mode_card == null or lobby_ov == null or not lobby_ov.visible or net.spectating:
		return
	var mi := clampi(int(l.get("map", 0)), 0, Sim.MAPS.size() - 1)
	var key := "%s|%d" % [String(l.get("mode", "")), mi]
	if key == _lobby_card_key:
		return
	_lobby_card_key = key
	var mk := MP_MODES.map(func(m): return m[0]).find(String(l.get("mode", "")))
	for pair in [[String(l.get("mode", "")), lobby_mode_btns[mk] if mk >= 0 and mk < lobby_mode_btns.size() else null],
			["map:" + String(Sim.MAPS[mi]["id"]), lobby_map_btns[mi] if mi < lobby_map_btns.size() else null]]:
		if ModeCardScript.should_show(pair[0]):
			if mode_card.is_open() and mode_card.cur != pair[0]:
				mode_card.dismiss(mode_card.shown_t >= mode_card.SEEN_AFTER)
			mode_card.open(pair[0], false, lobby_ov, lobby_btn_col, true)   # over the hero details, above Start
			return


func refresh_lobby() -> void:
	if lobby_ov == null or net.lobby.is_empty():
		return
	var l: Dictionary = net.lobby
	var ts := net.team_size()
	var me_slot := net.my_slot()
	lobby_title.text = "Lobby" if not net.is_host else "Your lobby"
	lobby_info.text = "%s  ·  %s" % [{"steam": "Steam", "relay": "online (relay)"}.get(net.transport, "direct connection"), "you are the host" if net.is_host else "the host sets the mode, map and AI"]
	_refresh_lobby_addr()
	for k in lobby_mode_btns.size():
		lobby_mode_btns[k].set_pressed_no_signal(MP_MODES[k][0] == l["mode"])
		lobby_mode_btns[k].disabled = not net.is_host
	for k in lobby_map_btns.size():
		lobby_map_btns[k].set_pressed_no_signal(k == int(l["map"]))
		lobby_map_btns[k].disabled = not net.is_host
	for k in lobby_diff_btns.size():
		lobby_diff_btns[k].set_pressed_no_signal(k == int(l["diff"]))
		lobby_diff_btns[k].disabled = not net.is_host
	for k in lobby_spec_btns.size():   # 0.44
		lobby_spec_btns[k].set_pressed_no_signal(SPEC_OPTS[k][0] == String(l.get("spec", "friends")))
		lobby_spec_btns[k].disabled = not net.is_host
	_lobby_mode_card(l)   # 0.46.1
	var taken := {}
	for i in 8:
		var s: Dictionary = l["slots"][i]
		var b: Button = lobby_slot_btns[i]
		b.visible = (i % 4) < ts
		var hero := ""
		if String(s["champ"]) == "random":
			hero = "random hero"
		elif String(s["champ"]) != "":
			hero = String(find_champ(s["champ"])["name"])
			taken[s["champ"]] = int(s["peer"])
		_lobby_slot_face(i, s)
		if s["kind"] == "human":
			var ttl := Cosmetics.title_of(s.get("cos", {}))   # ---- 0.44 rewards ---- the player's title after the name
			b.text = "%s%s%s%s  ·  %s%s" % [String(s["name"]) + (("  (Steam: %s)" % String(s["sn"])) if String(s.get("sn", "")) not in ["", String(s["name"])] else ""), ("  “%s”" % ttl) if ttl != "" else "", ("  ·  Lv %d" % int(s["lvl"])) if int(s.get("lvl", 0)) > 0 else "", "  (you)" if i == me_slot else "", hero if hero != "" else "choosing…", "" if bool(s["ready"]) or int(s["peer"]) == 1 else "  ·  not ready"]
			b.add_theme_color_override("font_color", Color(0.4, 1.0, 0.45) if i == me_slot else TEXT)
		else:
			b.text = "AI player  ·  click to take this slot"
			b.add_theme_color_override("font_color", MUTED)
	var my_pick := String(l["slots"][me_slot]["champ"]) if me_slot >= 0 else ""
	if my_pick != "":
		_fill_lobby_detail(my_pick)
	for id in lobby_hero_btns:
		var hb: Button = lobby_hero_btns[id]
		hb.set_pressed_no_signal(id == my_pick)
		hb.disabled = taken.has(id) and id != my_pick or l["mode"] == "allrandom"
	lobby_note.text = "All-Random: everyone gets a random hero." if l["mode"] == "allrandom" else ("Mayhem: double income, bigger and faster waves, cheap sends, short cooldowns." if l["mode"] == "mayhem" else ("Draft: Start opens the pick and ban phase." if l["mode"] == "draft" else "For bans, choose Draft."))   # 0.44
	var specs: Array = l.get("specs", [])   # 0.44
	if net.spectating:
		lobby_title.text = "Watching the lobby"
		lobby_info.text = "%s  ·  you watch this match; the host starts it" % {"steam": "Steam", "relay": "online (relay)"}.get(net.transport, "direct connection")
	if not specs.is_empty():
		lobby_note.text += "   ·   Watching: %s" % ", ".join(PackedStringArray(specs))
	lobby_invite.visible = net.transport == "steam" and net.is_host
	if lobby_balance != null:
		lobby_balance.text = "Balance" + ("  ·  custom" if Tune.is_custom(l.get("tune", {})) else "") + ("" if net.is_host else "  (host's)")
	lobby_why.visible = false
	if net.is_host:
		var why := net.can_start()
		lobby_go.text = "Start the match" if why == "" else "Start"
		lobby_why.text = why
		lobby_why.visible = why != ""
	elif net.spectating:
		lobby_go.text = "Watching  ·  waiting for the host"   # 0.44
	else:
		lobby_go.text = "Not ready" if lobby_ready else "Ready"
	# ---- 0.44 modes ----
	var ld: Dictionary = l.get("draft", {})
	if not ld.is_empty():
		var dr := Draft.from_dict(ld)
		lobby_draft_ms = Time.get_ticks_msec()
		var my_turn := net.draft_my_turn()
		for i in 8:
			var sl: Dictionary = l["slots"][i]
			var b: Button = lobby_slot_btns[i]
			var pk := String(dr.picks[i])
			var hero_t := String(find_champ(pk)["name"]) if pk != "" else ("picking now…" if i == dr.slot_now() else "—")
			if sl["kind"] == "human":
				b.text = "%s%s  ·  %s" % [String(sl["name"]), "  (you)" if i == me_slot else "", hero_t]
			else:
				b.text = "AI player  ·  %s" % hero_t
			b.disabled = true
		var ab := dr.all_bans()
		for id in lobby_hero_btns:
			var hb: Button = lobby_hero_btns[id]
			hb.set_pressed_no_signal(false)
			hb.disabled = dr.taken(id) or not my_turn or dr.done()
			hb.modulate = Color(0.75, 0.55, 0.5) if ab.has(id) else (Color(0.6, 0.6, 0.6) if dr.picks.has(id) else Color.WHITE)
			hb.tooltip_text = "%s  ·  %s%s" % [find_champ(id)["name"], find_champ(id)["role"], "  ·  BANNED" if ab.has(id) else ("  ·  picked" if dr.picks.has(id) else "")]
		if dr.done():
			lobby_note.text = "Draft complete: the match starts in a moment."
		else:
			lobby_note.text = dr.status_text(Sim.TEAM_NAMES) + ("  ·  YOUR %s" % ("BAN" if dr.phase == "ban" else "PICK") if my_turn else "")
		lobby_go.text = "Draft in progress…"
		lobby_go.disabled = true
		for k in lobby_mode_btns.size():
			lobby_mode_btns[k].disabled = true
		# the reveal: a new pick pops in on its slot
		while lobby_draft_shown < dr.log.size():
			var e: Dictionary = dr.log[lobby_draft_shown]
			lobby_draft_shown += 1
			if e["k"] != "pick":
				continue
			var sb2: Button = lobby_slot_btns[int(e["slot"])]
			sb2.pivot_offset = Vector2(40, sb2.size.y / 2.0)
			sb2.scale = Vector2(1.06, 1.06)
			sb2.modulate = Color(1.4, 1.3, 1.1)
			var tw := create_tween().set_parallel(true)
			tw.tween_property(sb2, "scale", Vector2.ONE, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
			tw.tween_property(sb2, "modulate", Color.WHITE, 0.45)
	else:
		lobby_draft_shown = 0
		lobby_go.disabled = false
		for i in 8:
			lobby_slot_btns[i].disabled = false
		for id in lobby_hero_btns:
			lobby_hero_btns[id].modulate = Color.WHITE
	# ---- end 0.44 modes ----
	if net.spectating:   # 0.44 spect
		lobby_go.disabled = true
		for id in lobby_hero_btns:
			(lobby_hero_btns[id] as Button).disabled = true
	_ranked_lobby_refresh(l, me_slot)   # ---- 0.45 ranked ----
	lobby_go.tooltip_text = lobby_go.text
	_lobby_fit()


