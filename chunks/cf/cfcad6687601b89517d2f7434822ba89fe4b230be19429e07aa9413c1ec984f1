func _tip_watch() -> void:
	if tooltip == null or not tooltip.visible or tip_source == null:
		return
	if not (tip_source is Control) or not is_instance_valid(tip_source) or not tip_source.is_visible_in_tree():
		hide_tip()
		return
	var r: Rect2 = (tip_source as Control).get_global_rect().grow(3)
	if not r.has_point(get_viewport().get_mouse_position()):
