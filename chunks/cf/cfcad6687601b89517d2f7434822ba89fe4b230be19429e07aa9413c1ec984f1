␀# 0.43 (access): Settings > Accessibility > Text size (90-150 %), separate from the UI scale. The interface is built
# in code with a font size per control (Main.lbl and friends), so the text size is applied to the controls themselves:
# every Label, Button, LineEdit, RichTextLabel... keeps its authored size as a base (meta) and gets base x scale as its
# override; nodes added later are scaled as they arrive (SceneTree.node_added, deferred so the builder's own size is
# set first). A control that changes its own size later becomes the new base the next time the scale is applied.
# Containers grow with their text; a node (and its subtree) with the meta "no_text_scale" keeps its size, and one
# with "text_scale_cap" (a float) is scaled at most by that much (the match console's fixed slots).
# Drawn text (custom _draw) reads Settings.text_scale where it matters (subtitles).
class_name TextScale
extends Node

const META := "_ts"
const RICH := ["normal_font_size", "bold_font_size", "italics_font_size", "bold_italics_font_size", "mono_font_size"]

static var inst: TextScale = null
var applied := 1.0


# Screens whose layout is fixed rows of buttons and slots: their text grows less (or not at all), so nothing leaves
# the window or overlaps at 150 % text x 125 % UI on 1280 x 720 (tests/uiscale_test.gd --text=1.5). The online
# lobby's three fixed columns, the match console and the top bar keep their size (the UI scale sizes those).
const CAPS := {"console": 1.0, "topbar": 1.0, "lobby_ov": 1.0, "draft": 1.15}


func _ready() -> void:
	inst = self
	get_tree().node_added.connect(_on_added)
	applied = Settings.text_scale
	_setup.call_deferred()


func _setup() -> void:
	var m := get_parent()
	if m != null and "hud_parts" in m:
		var hp: Dictionary = m.hud_parts
		if hp.has("console") and hp["console"] is Node:
			hp["console"].set_meta("text_scale_cap", CAPS["console"])
		for k in ["lobby_ov", "draft"]:
			var n = m.get(k)
			if n is Node:
				n.set_meta("text_scale_cap", CAPS[k])
		if "game" in m and m.game is Node:
			for ch in m.game.get_children():
				if ch is UIParts.TopBar:
					ch.set_meta("text_scale_cap", CAPS["topbar"])
	if not is_equal_approx(applied, 1.0):
		apply_all()


func _exit_tree() -> void:
	if inst == self:
		inst = null


# Settings changed the text size: rescale everything in the tree.
static func refresh() -> void:
	if inst != null:
		inst.apply_all()


func apply_all() -> void:
	applied = Settings.text_scale
	_walk(get_tree().root, 1.0e9)


func _walk(n: Node, cap: float) -> void:
	if n.has_meta("no_text_scale"):
		return
	if n.has_meta("text_scale_cap"):
		cap = minf(cap, float(n.get_meta("text_scale_cap")))
	if n is Control:
		_apply(n as Control, cap)
	for ch in n.get_children():
		_walk(ch, cap)


func _on_added(n: Node) -> void:
	if n is Control and (not is_equal_approx(applied, 1.0) or n.has_meta(META)):
		_late.call_deferred(n)


func _late(n: Node) -> void:
	if not is_instance_valid(n) or not n.is_inside_tree():
		return
	var cap := 1.0e9
	var p := n
	while p != null:
		if p.has_meta("no_text_scale"):
			return
		if p.has_meta("text_scale_cap"):
			cap = minf(cap, float(p.get_meta("text_scale_cap")))
		p = p.get_parent()
	_apply(n as Control, cap)


func _apply(c: Control, cap: float) -> void:
	var names: Array
	if c is RichTextLabel:
		names = RICH
	elif c is Label or c is Button or c is LineEdit or c is TextEdit or c is ItemList or c is TabBar or c is Tree:
		names = ["font_size"]
	else:
		return
	var k := minf(applied, maxf(1.0, cap))
	var memo: Dictionary = c.get_meta(META, {})
	for nm in names:
		var has := c.has_theme_font_size_override(nm)
		if not has and nm != "font_size" and nm != "normal_font_size":
			continue
		var cur := c.get_theme_font_size(nm)
		var base := cur
		if memo.has(nm) and int(memo[nm][1]) == cur:
			base = int(memo[nm][0])   # still the size we set: keep its base
		if not has and not memo.has(nm) and is_equal_approx(k, 1.0):
			continue
		var want := maxi(1, roundi(base * k))
		memo[nm] = [base, want]
		if want != cur or not has:
			c.add_theme_font_size_override(nm, want)
	c.set_meta(META, memo)
