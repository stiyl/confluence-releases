static var _num_re: RegEx = null


# Scales the amounts in an ability description ("40 damage", "22 damage per second", "120 health") by m.
static func scaled_desc(desc: String, m: float) -> String:
	if absf(m - 1.0) < 0.005:
		return desc
	if _num_re == null:
		_num_re = RegEx.create_from_string("\\b(\\d+)(?= (?:[a-z]+ )?(?:damage|health|shield|healing|heal))")
	var out := ""
	var last := 0
	for mt in _num_re.search_all(desc):
		out += desc.substr(last, mt.get_start() - last) + str(roundi(float(mt.get_string(1)) * m))
		last = mt.get_end()
	return out + desc.substr(last)


