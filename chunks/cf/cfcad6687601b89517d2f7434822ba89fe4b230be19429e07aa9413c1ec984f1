		return true
	if codex_ov != null and codex_ov.visible:
		codex_ov.visible = false
		return true
	if hex_ov != null and hex_ov.visible:
		hex_ov.visible = false   # 0.48
		return true
	if talent_ov != null and talent_ov.visible:
		talent_ov.visible = false
		if draft.visible:
			render_detail()
		return true
	if profile_ov != null and profile_ov.visible:
		profile_ov.visible = false
		return true
	if settings_ov != null and settings_ov.visible:
		if not settings_ui.cancel_pending():   # 0.35: Esc first drops a key-conflict prompt
			close_settings()
		return true
