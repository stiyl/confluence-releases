# Draft mode on hero select: a Draft (scripts/draft.gd) with you in slot 0 banning for the Ward and picking
# first; the bots take the other eleven steps after a short think, or at once when the 30 s run out.
func _pb_start() -> void:
	pb = Draft.new()
	pb_shown = 0
	draft_phase = "pick"
	ban_votes = []
	bans = []
	ban_counts = {}
	if pb_timer_lbl == null and draft_tag != null:
		pb_timer_lbl = lbl("", 15, GOLD, false, 2)
		draft_tag.get_parent().add_child(pb_timer_lbl)
		draft_tag.get_parent().move_child(pb_timer_lbl, draft_tag.get_index())
	pb_timer_lbl.visible = true
	_pb_refresh()


func _pb_my_turn() -> bool:
	if pb == null or pb.done():
		return false
	return (pb.phase == "ban" and pb.team_now() == 0) or (pb.phase == "pick" and pb.slot_now() == 0)


func _pb_act(id: String) -> void:
	if pb == null or not _pb_my_turn() or not pb.act(id):
		return
	_pb_refresh()


func _pb_tick(dt: float) -> void:
	if pb.done():
		return
	if pb.bot_tick(dt, [0], [0]):
		_pb_refresh()
	elif pb_timer_lbl != null:
		pb_timer_lbl.text = pb.status_text(Sim.TEAM_NAMES)


# The board after a step: banned tiles marked (the banning team's colour), picked tiles dimmed, the team
# portraits, the lock button, and the newest pick revealed with a short pop.
func _pb_refresh() -> void:
	if pb == null:
		return
	for id in tiles:
		var b: Button = tiles[id]
		var mark: UIParts.BanMark = ban_marks[id]
		if pb.bans[0].has(id) or pb.bans[1].has(id):
			mark.state = "banned"
			mark.count = 0
			b.modulate = Color(0.78, 0.72, 0.7)
		elif pb.picks.has(id):
			mark.state = ""
			b.modulate = Color(0.55, 0.55, 0.55)
		else:
			mark.state = ""
			b.modulate = Color.WHITE
		mark.queue_redraw()
	if pb.done():
		draft_tag.text = "Draft complete: %s against %s. Bans: %s." % [_pb_names(0), _pb_names(1), ", ".join((pb.bans[0] + pb.bans[1]).map(func(x): return String(find_champ(x)["name"]).split(" ")[0]))]
		if pb_timer_lbl != null:
			pb_timer_lbl.text = "Both teams are set"
	else:
		var who := "You ban" if pb.phase == "ban" else "You pick"
		var mine := _pb_my_turn()
		draft_tag.text = ("%s: choose a hero and confirm. " % who if mine else "The %s are %s. " % [Sim.TEAM_NAMES[pb.team_now()], "banning" if pb.phase == "ban" else "picking"]) + \
			("Each team bans two heroes, then the picks go Ward, Host, Host, Ward, Ward, Host, Host, Ward; 30 seconds a step. No hero twice." if pb.log.size() < 2 else "Bans so far: %s." % (", ".join(pb.all_bans().map(func(x): return String(find_champ(x)["name"]).split(" ")[0])) if not pb.all_bans().is_empty() else "none"))
		if pb_timer_lbl != null:
			pb_timer_lbl.text = pb.status_text(Sim.TEAM_NAMES)
	if pb.taken(sel_id) and not pb.done():
		for c in GameData.CHAMPS:
			if not pb.taken(c["id"]):
				sel_id = c["id"]
				break
	for k in tiles:
		tiles[k].set_pressed_no_signal(k == sel_id)
	render_detail()
	render_slots({})
	# the reveal: every pick made since the last refresh pops in
	while pb_shown < pb.log.size():
		var e: Dictionary = pb.log[pb_shown]
		pb_shown += 1
		if e["k"] != "pick":
			continue
		var box := slots_a if int(e["slot"]) < 4 else slots_b
		var pt: Control = box.get_node_or_null("Pick%d" % int(e["slot"]))
		if pt != null:
			pt.pivot_offset = Vector2(22, 22)
			pt.scale = Vector2(1.7, 1.7)
			pt.modulate = Color(1, 1, 1, 0)
			var tw := create_tween().set_parallel(true)
			tw.tween_property(pt, "scale", Vector2.ONE, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
			tw.tween_property(pt, "modulate", Color.WHITE, 0.25)
	if pb.done():
		audio.play("level", 0.0)
	_codex_pb_hint()   # ---- 0.45 codex ----


