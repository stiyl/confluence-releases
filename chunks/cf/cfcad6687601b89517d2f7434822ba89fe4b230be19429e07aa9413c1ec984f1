	func _draw() -> void:
		var s = board.sim()
		if s == null:
			return
		var mt := board.myt()
		var half := (size.x - 12.0) * 0.5
		var f := UIParts.font("caps")
		var fn := UIParts.font("num_semi")
		for i in 2:
