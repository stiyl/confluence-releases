func _ranked_mp_refresh() -> void:
	if mp_rk_lbl == null or ranked == null:
		return
	var em: Ranked.Emblem = mp_rk_lbl.get_meta("emblem")
	var b: Button = mp_rk_lbl.get_meta("btn")
	var why: String = ranked.available()
	var best := {}
	var parts: Array = []
	for md in Ranked.MODES:
		var vw: Dictionary = ranked.view(md["id"])
		if not vw.is_empty() and int(vw.get("games", 0)) > 0:
			parts.append("%s %s" % [String(md["id"]), Ranked.view_label(vw)])
		if bool(vw.get("placed", false)) and (best.is_empty() or int(vw["mmr"]) > int(best["mmr"])):
			best = vw
	if not best.is_empty():
		em.set_rank(int(best["tier"]), int(best["div"]))
		b.text = "Ranked  ·  " + Ranked.view_label(best)
	else:
		em.set_rank(1, 0, true)
		b.text = "Ranked"
	var se: Dictionary = ranked.season()
	b.tooltip_text = ("  ·  ".join(parts) + "\n" if not parts.is_empty() else "") + "Ranked matchmaking: 1v1 or 4v4, a visible rank from Bronze to Champion, and a reward skin each season." + (("\n%s, %s" % [String(se.get("name", "")), ranked.season_left_text()]) if not se.is_empty() else "")
	var st := String(ranked.q.get("state", "idle"))
	var msg := ""
	if ranked.caps == 0:
		msg = Ranked.OLD_RELAY
	elif st == "queued":
		msg = "Searching for a %s match…" % Ranked.mode_name(String(ranked.q.get("mode", "")))
	mp_rk_lbl.text = msg
	mp_rk_lbl.visible = msg != ""
	b.disabled = not net.relay_configured()
	if why != "":
		b.tooltip_text = why + "\n" + b.tooltip_text   # (no extra line on the card: the Ranked screen says it too)


