func _page_history() -> void:
	var hist := Profile.history
	if detail >= 0 and detail < hist.size():
		_history_detail(hist[detail])
		return
	detail = -1
	if hist.is_empty():
		_note("No matches yet. Every finished match is listed here: Classic, Quick, online, Survival, Daily, the campaign and the tutorial.")
		return
	_note("Your last %d matches (up to %d are kept). Click one for both teams, items and numbers." % [hist.size(), Profile.HIST_MAX])
	for i in mini(hist_shown, hist.size()):
		body.add_child(_hist_row(i, hist[i]))
	if hist.size() > hist_shown:
		var more := Button.new()
		more.text = "Show %d more" % mini(HIST_PAGE, hist.size() - hist_shown)
		more.focus_mode = FOCUS_NONE
		more.custom_minimum_size = Vector2(200, 34)
		more.size_flags_horizontal = SIZE_SHRINK_CENTER
		more.pressed.connect(func():
			hist_shown += HIST_PAGE
			var sv := scroll.scroll_vertical
			refresh()
			scroll.set_deferred("scroll_vertical", sv))
		body.add_child(more)


static func result_text(r: Dictionary) -> String:
	match String(r.get("r", "")):
		"win": return "Victory"
		"loss": return "Defeat"
		"left": return "Ended"
	if r.get("m") == "tutorial":
		return "Tutorial"
	return "Round %d" % int(r.get("rd", 0))


static func result_col(r: Dictionary) -> Color:
	match String(r.get("r", "")):
		"win": return WIN_COL
		"loss": return LOSS_COL
	return UIParts.GOLD


func _mode_line(r: Dictionary) -> String:
	var md := String(MODE_NAMES.get(String(r.get("m", "")), String(r.get("m", "")).capitalize()))
	if bool(r.get("on", false)):
		md += " online"
	var mi := int(r.get("map", 0))
	var parts := [md]
	if r.get("m") not in ["survival", "daily", "tutorial", "campaign"] and mi >= 0 and mi < Sim.MAPS.size():
		parts.append(String(Sim.MAPS[mi]["name"]))
	return "  ·  ".join(parts)


