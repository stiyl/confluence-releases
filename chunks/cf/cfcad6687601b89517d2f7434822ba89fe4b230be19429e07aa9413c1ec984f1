# Adds a finished match (MatchRecord.build) to the history and the hero totals. Tutorial runs are kept out of
# the hero totals; every match goes into the history.
static func add_history(rec: Dictionary) -> void:
	ensure()
	history.push_front(rec)
	if history.size() > HIST_MAX:
		history.resize(HIST_MAX)
	for i in range(HIST_DETAIL, history.size()):
		if history[i] is Dictionary and history[i].has("pl"):
			history[i].erase("pl")
	var hid := String(rec.get("h", ""))
	if hid != "" and String(rec.get("m", "")) != "tutorial":
		var h := hero(hid)
		h["hg"] = int(h.get("hg", 0)) + 1
		if rec.get("r") == "win":
			h["hw"] = int(h.get("hw", 0)) + 1
		h["dt"] = int(h.get("dt", 0)) + int(rec.get("dt", 0))
		h["dmg"] = float(h.get("dmg", 0.0)) + float(rec.get("dmg", 0))
		h["heal"] = float(h.get("heal", 0.0)) + float(rec.get("heal", 0))
		var it: Dictionary = h.get("it", {})
		for iid in rec.get("it", []):
			it[iid] = int(it.get(iid, 0)) + 1
		h["it"] = it
	# streaks for the achievements
	if rec.get("r") == "win":
		stats["win_run"] = int(stats.get("win_run", 0)) + 1
	elif rec.get("r") == "loss":
		stats["win_run"] = 0
	stats["win_run_best"] = maxi(int(stats.get("win_run_best", 0)), int(stats.get("win_run", 0)))
	for dw in rec.get("du", []):
		stats["duel_run"] = (int(stats.get("duel_run", 0)) + 1) if dw else 0
		stats["duel_run_best"] = maxi(int(stats.get("duel_run_best", 0)), int(stats.get("duel_run", 0)))
	if rec.get("r") == "win":
		var role := String(_champ(hid).get("role", ""))
		var rw: Array = stats.get("roles_won", [])
		if role != "" and not rw.has(role):
			rw.append(role)
		stats["roles_won"] = rw
	save()
	save_history()


