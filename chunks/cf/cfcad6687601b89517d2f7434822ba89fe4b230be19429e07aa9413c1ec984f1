			"duel_count":
				var n := int(e["n"])
				if n > 0:
					audio.play("click", 2.0)   # the number itself is drawn over the ring
				else:
					# 0.16: the FIGHT! flash is the event HUD's, from "duel_fight"
					audio.play("duel_start", 0.0)
					arena_view.add_shake(4.0)
			"duel_end":
				if duel_prev_view >= 0 and duel_prev_view != 2:
					set_view_arena(duel_prev_view)
					if duel_prev_view == me.team:
						arena_view.selected = hc
						arena_view.recenter()
				duel_prev_view = -1
				if e.get("human_won", false):
					audio.play("duel_win", 0.0)
					award("duel_win")
					if duel_cast:
						award("duel_caster")
					if float(e.get("hp", 1.0)) < 0.1:
