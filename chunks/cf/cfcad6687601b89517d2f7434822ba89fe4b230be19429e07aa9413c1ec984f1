	spec_gold_lbl.visible = not narrow
	spec_lbl.custom_minimum_size.x = 150.0 if narrow else 250.0
	var bw := clampf(room, 520.0, 846.0)
	if not is_equal_approx(spec_bar.custom_minimum_size.x, bw):
		spec_bar.custom_minimum_size.x = bw
		spec_bar.reset_size()
	# (the round title and its line start below the bar: event_hud.gd lays them out every frame, 0.46.1)
	var who := ""
	for pl in sim.players:
