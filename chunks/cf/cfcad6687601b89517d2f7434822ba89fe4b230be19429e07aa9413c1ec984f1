	# 0.35.5: Ping moved from Alt to G (the user's call) and "Watch the duel" from G to "." - only binds still on the
	# old defaults move; a key the player chose stays theirs
	if int(cf.get_value("keys", "_v", 0)) < 7 and int(keys.get("ping", 0)) == KEY_ALT:
		if int(keys.get("duel", 0)) == KEY_G:
			keys["duel"] = KEY_PERIOD if _free(KEY_PERIOD, "duel") else 0
		if _free(KEY_G, "ping"):
			keys["ping"] = KEY_G
	# 0.29: controller settings and pad binds ([pad] _v 1; later layout changes migrate here like the keys)
	pad_enabled = bool(cf.get_value("pad", "enabled", pad_enabled))
	pad_southpaw = bool(cf.get_value("pad", "southpaw", pad_southpaw))
	pad_dead = clampf(float(cf.get_value("pad", "dead", pad_dead)), 0.05, 0.5)
	pad_cursor = clampf(float(cf.get_value("pad", "cursor", pad_cursor)), 0.3, 3.0)
	pad_cam = clampf(float(cf.get_value("pad", "cam", pad_cam)), 0.3, 3.0)
	pad_rumble = bool(cf.get_value("pad", "rumble", pad_rumble))
	pad_style = clampi(int(cf.get_value("pad", "style", pad_style)), 0, PAD_STYLES.size() - 1)
	if int(cf.get_value("pad", "_v", 0)) >= 1:
		for a in PAD_ACTIONS:
			pads[a[0]] = int(cf.get_value("pad", "b_" + a[0], a[2]))
	gfx()


# True when no action other than `except` holds key k.
static func _free(k: int, except: String) -> bool:
	for a in keys:
		if a != except and int(keys[a]) == k:
			return false
	return true


# The graphics preset in effect (picks the renderer's default the first time).
static func gfx() -> int:
	if graphics < 0 or graphics > GFX_ULTRA:
		var compat := RenderingServer.get_rendering_device() == null
		graphics = GFX_LOW if compat or weak_gpu() or igpu() else GFX_MEDIUM
	hq = graphics >= GFX_HIGH
	return graphics


# 0.44: an integrated GPU (Intel HD / UHD / Iris, AMD's APU graphics, the Steam Deck's Van Gogh, phone-class
# Mali / Adreno) starts on Low; the player can still pick anything in Settings. Discrete cards and Apple
# silicon are not listed: they run Medium fine.
const IGPU_NAMES := ["intel(r) hd graphics", "intel(r) uhd graphics", "intel(r) iris", "intel hd graphics", "intel uhd graphics",
	"intel iris", "radeon(tm) graphics", "radeon vega", "radeon(tm) vega", "vangogh", "van gogh", "custom gpu 0405", "mali-", "adreno"]
static var _igpu := -1
static func igpu() -> bool:
	if _igpu < 0:
		var n := (RenderingServer.get_video_adapter_name() + " " + RenderingServer.get_video_adapter_vendor()).to_lower()
		_igpu = 0
		for w in IGPU_NAMES:
			if n.contains(w):
				_igpu = 1
	return _igpu == 1


# 0.28: a software or virtual GPU (ChromeOS's Linux container uses virgl; no driver at all means llvmpipe).
# There the Low preset also renders the 3D view at a lower resolution (gfx_cfg "scale" 0.6 instead of 0.75).
const WEAK_GPUS := ["llvmpipe", "softpipe", "lavapipe", "swiftshader", "virgl", "virtio", "svga3d", "microsoft basic"]
static var _weak := -1
static func weak_gpu() -> bool:
	if _weak < 0:
		var n := (RenderingServer.get_video_adapter_name() + " " + RenderingServer.get_video_adapter_vendor()).to_lower()
		_weak = 0
		for w in WEAK_GPUS:
			if n.contains(w):
				_weak = 1
	return _weak == 1


static func set_gfx(level: int) -> void:
	graphics = clampi(level, GFX_LOW, GFX_ULTRA)
	hq = graphics >= GFX_HIGH
	save()


# What each preset sets (ArenaView.apply_quality, FxLayer, FxModels and the prop builder read these).
static func gfx_cfg() -> Dictionary:
	match gfx():
		GFX_LOW:
			return {"shadows": 0, "ssao": false, "glow": false, "fog": false, "msaa": Viewport.MSAA_DISABLED, "fxaa": true,
				"scale": 0.6 if weak_gpu() else 0.75, "particles": 0.4, "fx_cap": 40, "lod": 4.0, "lod_far": 8.0, "unit_full": false, "props": 0.45, "lights": false, "deco": 0.5,
				"crowd": 20, "crowd_half": 8}
		GFX_MEDIUM:
			return {"shadows": 1, "ssao": false, "glow": true, "fog": true, "msaa": Viewport.MSAA_2X, "fxaa": true,
				"scale": 0.85, "particles": 0.7, "fx_cap": 80, "lod": 1.5, "lod_far": 3.0, "unit_full": false, "props": 0.75, "lights": true, "deco": 0.75,
				"crowd": 28, "crowd_half": 12}
		GFX_ULTRA:
			return {"shadows": 3, "ssao": true, "glow": true, "fog": true, "msaa": Viewport.MSAA_4X, "fxaa": true,
				"scale": 1.0, "particles": 1.0, "fx_cap": 220, "lod": 0.0, "lod_far": 0.0, "unit_full": true, "props": 1.0, "lights": true, "deco": 1.0}
	# High: the old "3D quality on" look. Props use Godot's standard sub-pixel LOD (threshold 1 px);
	# units keep their full meshes at the normal camera and only simplify once zoomed out
	return {"shadows": 2, "ssao": true, "glow": true, "fog": true, "msaa": Viewport.MSAA_4X, "fxaa": true,
		"scale": 1.0, "particles": 1.0, "fx_cap": 160, "lod": 1.0, "lod_far": 1.0, "unit_full": true, "props": 1.0, "lights": true, "deco": 1.0}


