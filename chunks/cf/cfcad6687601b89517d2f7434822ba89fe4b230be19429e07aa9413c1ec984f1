# Warns when several monsters have slipped past the confluence toward your crystal.
func check_leaks(delta: float) -> void:
	leak_check_t -= delta
	if leak_check_t > 0:
		return
	leak_check_t = 0.5
	var ar = sim.arenas[sim.players[sim.local].team]
	var n := 0
	var far = null
	for m in ar.mons:
		if not m.dead and m.p.x > Sim.CORE.x - 650:
			n += 1
			if far == null or m.p.x > far.p.x:
				far = m
	var lb = sim.lead_boss(ar)
	if n >= 4 or (lb != null and lb.p.x > Sim.CORE.x - 900):
		minimap.ping(far.p if far != null else lb.p, Color(1.0, 0.65, 0.15), ar.idx)
		push_alert("leak", "Leak! %d monsters are heading for your crystal" % maxi(n, 1), Color(1.0, 0.7, 0.3), 14.0)


func refresh_hotkeys() -> void:
	var sk := ["skill_q", "skill_w", "skill_e", "skill_r"]
	for i in skill_btns.size():
		skill_btns[i].hotkey = Settings.key_name(sk[i])
	# 0.29: on a controller the buildings and sends live in the wheel (one button), so their cards carry no glyph
	for k in bld_btns.size():
		bld_btns[k].hotkey = "" if Settings.pad_on else Settings.key_name("build%d" % (k + 1))
	for slot in send_btns.size():
		send_btns[slot].hotkey = "" if Settings.pad_on else Settings.key_name("send%d" % (slot + 1))
	potion_btn.hotkey = Settings.key_name("potion")
	view_btn.hotkey = Settings.key_name("view")
	if Settings.pad_on:
		view_btn.hotkey = ""   # 0.29: a modifier combo does not fit the small square (its tooltip names it)
	follow_btn.hotkey = Settings.key_name("center")
	if vote_ui != null:
		vote_ui.refresh_hotkeys()
	for b in [potion_btn, view_btn, follow_btn]:
		b.queue_redraw()
	if board_key != null:
		board_key.key = Settings.key_name("board")
		board_key.custom_minimum_size.x = UIParts.keycap_w(board_key.key, 11, 15.0) + 2.0
		board_key.offset_left = -board_key.custom_minimum_size.x - 2
		board_key.queue_redraw()
	for b in skill_btns + bld_btns + send_btns:
		b.queue_redraw()
	if cmd_btn != null:
		cmd_btn.hotkey = "" if Settings.pad_on else Settings.key_name("cmd_help")
		cmd_btn.queue_redraw()
	_set_badge_key(shop_badge, Settings.key_name("shop"))
	_set_badge_key(core_badge, Settings.key_name("crystal"))
	if core_badge != null:
		core_badge.visible = not Settings.pad_on   # 0.29: "Y+View" would cover the button's word
	if lane_col_box != null:
		for kb in lane_col_box.get_child(0).get_children():
			if kb is UIParts.KeyBadge:
				_set_badge_key(kb, Settings.key_name("lane"))
	# top-bar badges and their tooltips
	for b in [pause_btn] + view_btns + order_btns:
		if b == null or not b.has_meta("key_action"):
			continue
		var ka: String = b.get_meta("key_action")
		if b.key != "":
			b.key = Settings.key_name(ka)
			b.fit()
		if b.has_meta("tip_fmt"):
			b.tooltip_text = String(b.get_meta("tip_fmt")) % Settings.key_name(ka)
		b.queue_redraw()
	if pause_btn != null:
		pause_btn.tooltip_text = ("Resume the match (%s)" if paused else "Pause the match (%s)") % Settings.key_name("pause")
	for lb in learn_btns:
		var i: int = int(lb.get_meta("slot", 0))
		lb.tooltip_text = "Spend an ability point on %s (%s)" % [Settings.key_name(_skill_actions()[i]), Settings.learn_name(_skill_actions()[i])]
	if cmd_panel != null:
		for ch in cmd_panel.get_child(0).get_children():
			if ch is Button and ch.has_meta("cmd_action"):
				ch.text = "%s  (%s)" % [String(ch.get_meta("cmd_label")), Settings.key_name(String(ch.get_meta("cmd_action")))]
	if pause_help != null:
		pause_help.text = _pause_help_text()
	for fl in draft_foot_lbls:
		fl.text = String(fl.get_meta("key_fmt")) % fl.get_meta("key_acts").map(func(a): return Settings.key_name(a))
	if sim != null:
		update_hud()


