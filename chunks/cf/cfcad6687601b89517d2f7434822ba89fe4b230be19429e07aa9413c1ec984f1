# ---------------------------------------------------------------- loop & HUD
# Render interpolation: the sim steps 60 times a second, the screen may draw at 144 or more. Between sim
# work, units are moved to where they'd be part-way between the last two steps, and put back before the
# sim runs again (or takes a command), so the simulation itself never sees the drawn positions.
var _ip_saved: Array = []


func _interp_restore() -> void:
	for e in _ip_saved:
		e[0].p = e[1]
	_ip_saved.clear()


func _interp_apply() -> void:
	_interp_restore()
	if sim == null or not Settings.smooth_motion:
		return
	var alpha := 1.0
	if mp():
		alpha = clampf(net.acc / Net.TICK, 0.0, 1.0)
	elif not paused and not (replay_mode and replay_paused):
		alpha = clampf(step_acc / SIM_STEP, 0.0, 1.0)
	if alpha >= 0.999:
		return
	for ar in sim.all_arenas():
		for list in [ar.mons, ar.champs, ar.sums, ar.projs, ar.mprojs]:
			for u in list:
				var a: Vector2 = u.pp
				if a.x == INF:
					continue
				var b: Vector2 = u.p
				if a.distance_squared_to(b) > 14400.0:
					continue          # a blink or respawn: don't glide across the map
				_ip_saved.append([u, b])
				u.p = a.lerp(b, alpha)


var hud_us := 0   # ---- 0.44 perf ---- microseconds spent in update_hud (tests/perf_bench.gd)


func _process(delta: float) -> void:
	_interp_restore()
	_tip_watch()
	_mouse_confine()
	if menu != null:
		arena_view.covered = menu.is_visible_in_tree()
	# ---- 0.44 modes ----
	if pb != null and draft != null and draft.visible and game_mode == "draft" and not locking and sim == null:
		_pb_tick(delta)
	if lobby_ov != null and lobby_ov.visible and net != null and net.lobby.has("draft"):
		_lobby_draft_tick()
	# ---- end 0.44 modes ----
	if sim == null or not game.visible:
		return
	_codex_tip_tick(delta)   # ---- 0.45 codex ----
	if replay_mode:
		_replay_theatre_tick(delta)   # 0.48 Replay theatre
	_replay_lift_toasts()   # 0.48.1
	var camp := campaign_ui != null and campaign_ui.in_mission()
	if drafting():
		if not boon_ov.visible:
			open_draft()
	elif boon_ov != null and boon_ov.visible:
		boon_ov.visible = false
	if camp and campaign_ui.holding() and not sim.over:
		pass
	elif drafting():
		pass
	elif (mp() or not paused) and not sim.over:
		if mp():
			net.run(delta)
		elif replay_mode and replay_seek >= 0:
			_seek_step()   # 0.48 Replay theatre: fast-forward (no sounds, no effects) to the step picked on the timeline
		elif not (replay_mode and replay_paused):
			# fixed steps, so a replay of the same commands plays out the same match
			var dt := minf(delta, 0.1) * (replay_speed if replay_mode else Settings.game_speed)
			step_acc += dt
			var guard := 0
			while step_acc >= SIM_STEP and guard < 600:
				if replay_mode:
					_replay_feed()
				sim.step(SIM_STEP)
				step_acc -= SIM_STEP
				guard += 1
		# profile playtime: only while the match runs for you (not paused, not a replay, not waiting on the host)
		if not replay_mode and not paused and not (mp() and (net._stalled or net.is_dropped or net.migrating)) and (mp() or Settings.game_speed > 0.0):
			account.match_tick(delta)
		if mp() and net.catching_up():
			# 0.25: the fast-forward of a rejoin announces nothing; the HUD picks up where the live match is
			last_round = sim.round_no
			last_lvl = sim.players[sim.local].champ.lvl
		if camp:
			campaign_ui.dir.feed(sim.events)
		handle_events()
		_ping_tick(delta)
		_tip_poll(delta)
		if camp:
			campaign_ui.tick(delta)
		check_leaks(delta)
		update_death()
		if tut.running:
			tut.update(delta)
		ach_t -= delta
		if ach_t <= 0:
			ach_t = 1.0
			check_achievements()
		if sim.round_no != last_round:
			last_round = sim.round_no
			var incoming: int = sim.last_wave_sent[myt()]
			var outgoing: int = sim.last_wave_sent[1 - myt()]
			if camp:
				announce("Round %d" % sim.round_no, "The next wave marches on the Heartstone", 0)
			elif sim.mode == "survival":
				var boss_soon: bool = sim.round_no % SurvivalData.OMEN_EVERY == 0
				announce("Round %d" % sim.round_no, "%d wave monsters march on your crystal%s" % [Sim.wave_list(sim.round_no).size(), "  ·  a boss walks with this wave" if boss_soon else ""], 0)
			elif spectating:   # ---- 0.44.1 ---- a watcher has no crystal of their own: say what both teams face
				announce("Round %d" % sim.round_no, "%d wave monsters march on each crystal  ·  sends %d : %d" % [Sim.wave_list(sim.round_no).size(), sim.last_wave_sent[0], sim.last_wave_sent[1]], 0)
			elif not event_hud.takes_round_card():   # 0.16: the round card (EventHud, from "round_end") carries this line
				announce("Round %d" % sim.round_no, "%d wave monsters and %d sent by the enemy march on your crystal  ·  you sent %d" % [Sim.wave_list(sim.round_no).size(), incoming, outgoing], 0)
		var hc = sim.players[sim.local].champ
		if hc.lvl != last_lvl:
			last_lvl = hc.lvl
			var learnable := false
			for i in 4:
				if sim.can_learn(hc, i):
					learnable = true
			if spectating:
				pass   # 0.44: not our hero
			elif hc.points > 0 and learnable and not tut.running:
				show_error(("Level %d!  " % hc.lvl if hc.lvl > 1 else "") + "Choose an ability to learn: click + above it or press %s." % " / ".join(_skill_actions().map(func(a): return Settings.learn_name(a))))
				error_t = 4.0
			elif hc.lvl > Sim.SKILL_LEVELS:
				show_error("Level %d: all abilities are maxed, so your hero's stats grow instead." % hc.lvl)
		if sim.over:
			update_hud()
			if camp:
				if not recorded:
					recorded = true
					stats_record(sim.winner == myt())   # 0.43: campaign missions go into the match history too
				campaign_ui.on_over()
			else:
				show_end()
	announce_t -= delta
	if announce_t <= 0.0 and not announce_q.is_empty():
		_show_announce(announce_q.pop_front())
	var aa := clampf(announce_t, 0.0, 1.0)
	# the round-card draft covers the screen centre: its title must not ghost behind the draft header
	if (boon_ov != null and boon_ov.visible) or (shop_panel != null and shop_panel.visible):
		aa = 0.0
	arena_view.hide_float = boon_ov != null and boon_ov.visible
	announce_lbl.modulate.a = aa
	announce_sub.modulate.a = aa
	error_t -= delta
	error_lbl.modulate.a = clampf(error_t * 2.0, 0.0, 1.0)
	good_t -= delta
	good_lbl.modulate.a = clampf(good_t * 2.0, 0.0, 1.0)
	if ftip_box != null and ftip_box.visible and (sim == null or not game.visible):
		ftip_box.visible = false
	for k in alert_cd.keys():
		alert_cd[k] -= delta
	for a in alerts:
		a[1] -= delta
		a[0].modulate.a = clampf(a[1], 0.0, 1.0)
	for a in alerts.filter(func(x): return x[1] <= 0):
		a[0].queue_free()
		alerts.erase(a)
	hud_t -= delta
	if hud_t <= 0:
		hud_t = 0.08
		var t0 := Time.get_ticks_usec()   # 0.44 perf: the bench reads hud_us
		update_hud()
		hud_us += Time.get_ticks_usec() - t0
	_interp_apply()


func _stat_row_tip(src: Control, row: int) -> void:
	if sim == null or row >= stat_keys.size():
		return
	var o = selected()
	if o == null or not (o is Sim.Champ):
		return
	var key := String(stat_keys[row].text).replace(" ★", "")
	var pa: String = sim.primary_attr(o)
	var idx := ["Might", "Resolve", "Cunning"].find(key)
	if idx < 0:
		return
	var k: String = GameData.ATTRS[idx]
	var val := sim.attr(o, k)
	var gain := sim.attr_gain(o, k)
	var lines: Array = []
	if k == pa:
		lines.append(("Primary attribute of %s" % o.def["name"] if o.def.has("primary") else "Primary attribute of every %s" % String(o.def["role"]).to_lower()) + ": each point above the base adds %.1f Attack Power and %.1f Ability Power. From %d points gained: +%d Attack Power, +%d Ability Power." % [GameData.ATTR_DMG, GameData.ATTR_AP * 100.0, roundi(gain), roundi(GameData.ATTR_DMG * gain), roundi(GameData.ATTR_AP * gain * 100.0)])
	match k:
		"mig":
			lines.append("Might also gives every hero %d health a point: +%d health now." % [int(GameData.ATTR_HP), roundi(GameData.ATTR_HP * gain)])
		"cun":
			lines.append("Cunning also gives every hero %.1f%% attack speed a point: +%d%% now." % [GameData.ATTR_AS * 100.0, roundi(GameData.ATTR_AS * gain * 100.0)])
		"res":
			lines.append("Resolve also gives every hero %.1f%% cooldown reduction a point: +%d%% now." % [GameData.ATTR_CDR * 100.0, roundi(GameData.ATTR_CDR * gain * 100.0)])
	lines.append("Grows with level (%.2f a level for the primary, %.2f for the others) and comes from items." % [GameData.ATTR_GROW_PRIMARY, GameData.ATTR_GROW_OTHER])
	show_tip(src, "%s %d%s" % [key, roundi(val), "  ·  primary" if k == pa else ""], "Base %d for %s" % [int(GameData.attr_base_of(o.def)[k]), o.def["name"] if o.def.has("attr") else "a " + String(o.def["role"])], "\n".join(lines))


# Might / Resolve / Cunning, with the hero's primary attribute marked.
func _attr_pairs(c) -> Array:
	var pa: String = sim.primary_attr(c)
	var out: Array = []
	for k in GameData.ATTRS:
		out.append([GameData.ATTR_NAMES[k] + (" ★" if k == pa else ""), str(roundi(sim.attr(c, k)))])
	return out


func set_stats(pairs: Array) -> void:
	for i in stat_keys.size():
		stat_keys[i].text = pairs[i][0] if i < pairs.size() else ""
		stat_vals[i].text = pairs[i][1] if i < pairs.size() else ""


func team_name(t: int) -> String:
	return Sim.TEAM_NAMES[t]


# Every change the player makes to the match goes through here. In multiplayer the command goes to the
# host, which hands it to every computer for the same tick; alone, it is applied straight away.
func act(k: String, a: Array = []):
	if sim == null or replay_mode:
		return "none"
	if sim.duel_on and not k in ["surrender", "drop", "auto", "tune", "ping"]:
		var mine = sim.players[sim.local].champ
		if not sim.duel_pair.has(mine):
			show_error("The match waits for the duel: only the two in the ring can act.")
			return false
		if sim.duel_count > 0.0 and k in ["order", "cast", "item", "potion"]:
			show_error("Wait for the count.")
			return false
		if not k in ["order", "cast", "item", "potion"]:
			show_error("Not during your duel.")
			return false
	if mp():
		net.submit(k, a)
		return "sent"
	if Replay.recording:
		Replay.record(sim.tick, k, a)
	var had_ip := not _ip_saved.is_empty()
	_interp_restore()
	var res = sim.apply_cmd(sim.local, k, a)
	if had_ip:
		_interp_apply()
	if res is String and (res == "duel" or res == "countdown"):
		return false
	return res


# act() returns a bool or a status String depending on the command; these read either safely.
func _res_none(res) -> bool:
	return res == null or (res is String and res == "none")


func _res_ok(res) -> bool:
	if res is bool:
		return res
	return res is String and res in ["ok", "sent"]


# 0.18.1: one balance knob moves. In a match it is the "tune" sim command (lockstep: the host's command reaches
# every client at the same tick; single-player: applied at once and recorded with the replay); outside one it
# edits the draft the next match starts with (and the lobby's copy when hosting). Non-hosts are refused.
func tune_change(name: String, value: float) -> void:
	if not Tune.DEFS.has(name):
		return
	var v := Tune.clamp_val(name, value)
	if sim != null and not replay_mode:
		if mp() and not net.is_host:
			return
		act("tune", [name, v])
	elif net != null and net.in_lobby and not net.is_host:
		return
	Tune.load_draft()
	Tune.set_knob(Tune.draft, name, v)
	Tune.save_draft()
	if net != null and net.in_lobby and net.is_host and sim == null:
		net.set_option("tune", Tune.clean(Tune.draft))


func mp() -> bool:
	return net != null and net.in_match


# This computer's team, and the arena index for "your lane" (0) or "enemy lane" (1).
func myt() -> int:
	return sim.players[sim.local].team if sim != null else 0


func lane_idx(rel: int) -> int:
	return rel if rel == 2 else (myt() if rel == 0 else 1 - myt())


