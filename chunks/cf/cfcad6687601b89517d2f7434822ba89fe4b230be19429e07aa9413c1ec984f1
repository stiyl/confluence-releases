# x (0.25): {"tok": hash} on a normal join (the hash of the player's per-match secret, kept in the line-up), or
# {"rejoin": secret, "since": tick, "mid": match id} from a player coming back into the running match.
@rpc("any_peer", "reliable")
func _hello(pname: String, ver := "", x := {}) -> void:
	if not is_host:
		return
	var pid := multiplayer.get_remote_sender_id()
	var lvl := 0
	if ver.contains("|"):
		lvl = clampi(int(ver.get_slice("|", 1)), 0, 999)
		ver = ver.get_slice("|", 0)
	if ver != game_version():
		_kick.rpc_id(pid, "Version mismatch: the host runs Confluence %s, you run %s. You both need the same build." % [game_version(), ver if ver != "" else "an older version"])
		return
	if x.has("rejoin"):
		if not in_match:
			_kick.rpc_id(pid, "That match has ended.")
			return
		if migrating:
			_kick.rpc_id(pid, "The host is changing. Try again in a moment.")
			return
		_accept_rejoin(pid, String(x["rejoin"]), int(x.get("since", -1)), int(x.get("mid", 0)))
		return
	if x.has("spec"):
		if migrating:
			_kick.rpc_id(pid, "The host is changing. Try again in a moment.")
			return
		_accept_spectator(pid, pname.substr(0, 20), x)   # 0.44
		return
	if in_match:
		_kick.rpc_id(pid, "That match has already started.")
		return
	if lobby.has("ranked"):
		_rk_seat(pid, pname, lvl, x)   # ---- 0.45 ranked ---- only the matched players, on their team
		return
	var ts := team_size()
	# fill the first free slot, alternating teams
	var order := [0, 4, 1, 5, 2, 6, 3, 7]
	if party_code != "" and String(x.get("party", "")) == party_code:
		# 0.30: a member of the host's party: the host's team first (the other team once that one is full)
		var ht := int(peer_slot.get(1, 0)) / 4
		order = [ht * 4, ht * 4 + 1, ht * 4 + 2, ht * 4 + 3, (1 - ht) * 4, (1 - ht) * 4 + 1, (1 - ht) * 4 + 2, (1 - ht) * 4 + 3]
	for i in order:
		var s: Dictionary = lobby["slots"][i]
		if (i % 4) < ts and s["kind"] != "human":
			lobby["slots"][i] = {"kind": "human", "peer": pid, "name": pname.substr(0, 20), "champ": "", "ready": false, "lvl": lvl, "tok": String(x.get("tok", "")), "fc": String(x.get("fc", "")).substr(0, 9), "av": String(x.get("av", "")).substr(0, 32), "rt": clampi(int(x.get("rt", 0)), 0, 4000),
				"cos": Cosmetics.clean(x.get("cos", {})), "rk": String(x.get("rk", "")).substr(0, 24)}   # ---- 0.44 rewards ---- (0.45: "rk" rank)
			if transport == "steam":
				lobby["slots"][i]["sn"] = steam_name_of(pid).substr(0, 32)   # from Steam itself, not from the player
			peer_slot[pid] = i
			_push_lobby()
			_chat_all("%s joined." % pname)
			return
	_kick.rpc_id(pid, "The lobby is full.")


# Host: a player proves with their secret that a human slot of this match is theirs, and gets the log.
func _accept_rejoin(pid: int, secret: String, since: int, mid: int) -> void:
	var h := secret.sha256_text()
	var slot := -1
	var line: Array = match_cfg.get("lineup", [])
	for i in line.size():
		if bool(line[i].get("human", false)) and secret != "" and String(line[i].get("tok", "")) == h:
			slot = i
	if slot < 0:
		_kick.rpc_id(pid, "That match has already started.")
		return
	# a stale connection of the same player (the host hasn't noticed the drop yet) gives way
	for old in peer_slot.keys():
		if int(peer_slot[old]) == slot and old != pid:
			peer_slot.erase(old)
			_peer_seen.erase(old)
			if multiplayer.multiplayer_peer != null:
				multiplayer.multiplayer_peer.disconnect_peer(old)
	peer_slot[pid] = slot
	_peer_seen[pid] = Time.get_ticks_msec()
	_rc_missing.erase(slot)
	_roster.rpc(peer_slot)
	_send_catchup(pid, slot, since, mid)


# The match so far (config + command log) in pieces, to a rejoining player (slot) or a spectator (slot -1, 0.44).
func _send_catchup(pid: int, slot: int, since: int, mid: int) -> void:
	var upto := tick if tick % BUNDLE_EVERY == 0 else tick + 1       # the first live bundle this player will get
	# a player who ran past the tick this host took over at (the old host itself, typically) played bundles nobody
	# else got: their match is rebuilt from the log instead of continued
	var fresh := since < 0 or since > upto or mid != match_id or (host_since > 0 and since > host_since)   # (0.26: the original host, host_since 0, continues everyone)
	var entries: Array = []
	for e in cmd_log:
		if fresh or int(e[0]) >= since:
			entries.append(e)
	var d := {"cfg": match_cfg, "upto": upto, "slot": slot, "fresh": fresh, "log": entries, "roster": peer_slot, "mid": match_id}
	var bytes := var_to_bytes(d).compress(FileAccess.COMPRESSION_GZIP)
	var n := int(ceil(float(bytes.size()) / CHUNK))
	n = maxi(n, 1)
	for i in n:
		_send_q.append([pid, i, n, bytes.slice(i * CHUNK, mini((i + 1) * CHUNK, bytes.size()))])
	_log("%s: peer %d takes slot %d (since %d, fresh=%s, upto %d): %d log entries, %d bytes in %d pieces" % ["spectate" if slot < 0 else "rejoin", pid, slot, since, fresh, upto, entries.size(), bytes.size(), n])


