# A CanvasItem material that paints a skin, or null for the classic look.
static func skin_material(sid: String) -> Material:
	if sid == "" or sid == "classic":
		return null
	if _mats.has(sid):
		return _mats[sid]
	var d := skin_def(sid)
	var m := ShaderMaterial.new()
	m.shader = load("res://shaders/skin.gdshader")
	for k in ["hue", "min_sat", "sat_k", "bright", "sheen"]:
		m.set_shader_parameter(k, float(d[k]))
	m.set_shader_parameter("mix_amt", float(d["mix"]))
	# 0.44 reward skins
	m.set_shader_parameter("lift", float(d.get("lift", 0.0)))
	m.set_shader_parameter("rim_glow", float(d.get("rim", 0.0)))
	m.set_shader_parameter("sheen_hue", float(d.get("sheen_hue", 0.0)))
	m.set_shader_parameter("cap", float(d.get("cap", 1.0)))
	_mats[sid] = m
	return m


# Records a finished match. Returns what changed for the end screen.
static func record_match(id: String, won: bool, kills: int, dmg: float, mode: String, round_no: int, secs := 0) -> Dictionary:
	var h := hero(id)
	stats["time"] = int(stats.get("time", 0)) + maxi(0, secs)
	stats["kills"] = int(stats.get("kills", 0)) + kills
	stats["games"] = int(stats.get("games", 0)) + 1
	stats["mode:" + mode] = int(stats.get("mode:" + mode, 0)) + 1
	var old_lv := mastery(id)
	var gain := 100 + (150 if won else 0) + mini(kills, 150) + mini(150, int(dmg / 250.0))
	if mode == "survival":
		gain = 60 + 30 * round_no + mini(kills, 150)
	elif mode == "quick":
		gain = int(gain * 0.7)
	elif mode == "tutorial":
		gain = 150
	h["xp"] = int(h["xp"]) + gain
	h["kills"] = int(h.get("kills", 0)) + kills
	if mode != "survival" and mode != "tutorial":
		h["games"] = int(h["games"]) + 1
		games += 1
		if won:
			h["wins"] = int(h["wins"]) + 1
			wins += 1
	var new_lv := mastery(id)
	var unlocked: Array = []
	for s in SKINS:
		if int(s["need"]) > old_lv and int(s["need"]) <= new_lv:
			unlocked.append(s["name"])
	save()
	return {"xp": gain, "old": old_lv, "new": new_lv, "unlocked": unlocked}


# ---------------------------------------------------------------- 0.49 mastery challenges
# Three tiers of three challenges per hero, on top of mastery XP. Team matches only (not Survival, the tutorial or the
# campaign). Each finished tier pays a lump of mastery XP; finishing Gold also gives the hero's own title (its
# epithet, "Field Surgeon"), worn like any other title. Kill targets scale with the hero's role.
const CH_TIERS := ["Bronze", "Silver", "Gold"]
const CH_COLS := ["#c88a50", "#c8d0dc", "#ffd24a"]
const CH_XP := [400, 700, 1000]
# [key, target, label] per tier; "best" keys are a single match's best, the rest add up over matches
const CHALLENGES := [
	[["games", 3, "Play %d games"], ["wins", 1, "Win a game"], ["kills", 300, "Kill %d monsters in one game"]],
	[["wins", 4, "Win %d games"], ["contests", 2, "Win %d contests"], ["duels", 2, "Win %d duels"]],
	[["wins", 10, "Win %d games"], ["kills", 900, "Kill %d monsters in one game"], ["clean", 2, "Win with %d deaths or fewer"]],
]
const CH_BEST := ["kills"]
const CH_ROLE_K := {"Support": 0.45, "Tank": 0.6, "Engineer": 0.6, "Fighter": 0.85}


static func _ch_role_k(id: String) -> float:
	for c in GameData.CHAMPS:
		if c["id"] == id:
			return float(CH_ROLE_K.get(String(c["role"]), 1.0))
	return 1.0


static func ch_need(id: String, key: String, base: int) -> int:
	if key == "kills":
		return int(round(base * _ch_role_k(id) / 10.0)) * 10
	return base


static func ch_data(id: String) -> Dictionary:
	var h := hero(id)
	if not (h.get("mc", null) is Dictionary):
		h["mc"] = {}
	return h["mc"]


static func ch_have(id: String, key: String) -> int:
	var mc := ch_data(id)
	if key == "clean":
		return int(mc.get("clean", -1))
	return int(mc.get(key, 0))


static func ch_done(id: String, key: String, base: int) -> bool:
	var need := ch_need(id, key, base)
	if key == "clean":
		var c := ch_have(id, "clean")
		return c >= 0 and c <= need
	return ch_have(id, key) >= need


# The hero's challenges: [{"tier", "key", "text", "have", "need", "done"}], tier by tier.
static func challenges(id: String) -> Array:
	var out: Array = []
	for ti in CHALLENGES.size():
		for ch in CHALLENGES[ti]:
			var key: String = ch[0]
			var need := ch_need(id, key, int(ch[1]))
			var txt: String = String(ch[2]) % need if String(ch[2]).contains("%d") else String(ch[2])
			var have := ch_have(id, key)
			out.append({"tier": ti, "key": key, "text": txt, "have": have, "need": need, "done": ch_done(id, key, int(ch[1]))})
	return out


static func ch_tier_done(id: String, ti: int) -> bool:
	for ch in CHALLENGES[ti]:
		if not ch_done(id, String(ch[0]), int(ch[1])):
			return false
	return true


# Tiers finished, counted from Bronze up (a later tier only counts once the ones before it are done).
static func ch_tiers(id: String) -> int:
	var n := 0
	for ti in CHALLENGES.size():
		if not ch_tier_done(id, ti):
			break
		n += 1
	return n


# The hero's own title (Gold tier): its epithet without "The".
static func hero_title(id: String) -> String:
	for c in GameData.CHAMPS:
		if c["id"] == id:
			return String(c.get("title", c["name"])).trim_prefix("The ")
	return ""


# Records a finished team match for the hero's challenges. rec: the MatchRecord entry; contests: contests the
# team won. Returns {"done": [texts finished this match], "tiers": [tier names finished], "xp": bonus XP}.
static func record_challenges(rec: Dictionary, contests: int) -> Dictionary:
	var out := {"done": [], "tiers": [], "xp": 0}
	var md := String(rec.get("m", ""))
	if md in ["survival", "daily", "tutorial", "campaign"] or String(rec.get("r", "")) == "left":
		return out
	var id := String(rec.get("h", ""))
	if id == "":
		return out
	var before := challenges(id)
	var tiers0 := ch_tiers(id)
	var mc := ch_data(id)
	var won := String(rec.get("r", "")) == "win"
	mc["games"] = int(mc.get("games", 0)) + 1
	if won:
		mc["wins"] = int(mc.get("wins", 0)) + 1
		var dt := int(rec.get("dt", 99))
		if int(mc.get("clean", -1)) < 0 or dt < int(mc.get("clean", -1)):
			mc["clean"] = dt
	mc["kills"] = maxi(int(mc.get("kills", 0)), int(rec.get("k", 0)))
	mc["contests"] = int(mc.get("contests", 0)) + maxi(0, contests)
	var du: Array = rec.get("du", [])
	mc["duels"] = int(mc.get("duels", 0)) + du.filter(func(x): return x == true).size()
	var after := challenges(id)
	for i in after.size():
		if after[i]["done"] and not before[i]["done"]:
			out["done"].append("%s: %s" % [CH_TIERS[int(after[i]["tier"])], after[i]["text"]])
	var tiers1 := ch_tiers(id)
	var h := hero(id)
	var paid := int(h.get("mct", 0))
	for ti in range(paid, tiers1):
		out["tiers"].append(CH_TIERS[ti])
		out["xp"] = int(out["xp"]) + CH_XP[ti]
	if tiers1 > paid:
		h["xp"] = int(h["xp"]) + int(out["xp"])
		h["mct"] = tiers1
	save()
	return out


# Every hero title earned (Gold tier), as title ids "hm_<hero>".
static func hero_titles() -> Array:
	var out: Array = []
	for id in heroes:
		if int(heroes[id].get("mct", 0)) >= CHALLENGES.size():
			out.append("hm_" + String(id))
	out.sort()
	return out


# Adds a survival run; returns its place on the board (1-based) or 0 if it didn't make the top 10.
static func add_survival(hero_name: String, round_no: int, kills: int, heat := 0) -> int:
	ensure()
	var d := Time.get_date_dict_from_system()
	var e := {"round": round_no, "hero": hero_name, "kills": kills, "date": "%04d-%02d-%02d" % [d["year"], d["month"], d["day"]], "heat": heat}
	survival.append(e)
	survival.sort_custom(surv_better)
	var place := survival.find(e) + 1
	if survival.size() > 10:
		survival.resize(10)
	save()
	return place if place <= 10 else 0


# 0.48: board order: the round reached, then the heat it was played at, then kills
static func surv_better(a: Dictionary, b: Dictionary) -> bool:
	if int(a["round"]) != int(b["round"]):
