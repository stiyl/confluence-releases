# 0.42: the relay's https base for /feedback ("" when this build has no relay)
func _bug_relay_base() -> String:
	if account != null and account.has_method("api_base"):
		return String(account.api_base())
	if net == null or not net.relay_configured():
		return ""
	var u := String(net.relay_url)
	return (("https://" + u.substr(6)) if u.begins_with("wss://") else (("http://" + u.substr(5)) if u.begins_with("ws://") else u)).rstrip("/")


func _bug_probed(state: String) -> void:
	bug_relay = state
	if bug_plaque == null or not bug_plaque.visible or bug_sent or bug_sender.busy:
		return
	if not bug_sw_touched:
		bug_send_sw.set_pressed_no_signal(state == "ready")
	_bug_plaque_refresh()


# 0.42: the card's send state: the switch, the line saying what is sent, the status, the buttons.
func _bug_plaque_refresh() -> void:
	if bug_plaque == null:
		return
	var who := ""
	if account != null and String(account.profile_name) != "":
		who = String(account.profile_name)
	elif net != null:
		who = String(net.my_name)
	var sending := bug_sender != null and bug_sender.busy
	bug_send_row.visible = bug_relay != "none" and not bug_sent and not sending
	bug_send_info.visible = bug_send_row.visible
	if bug_send_sw.button_pressed:
		bug_send_info.text = "Sends your note, the screenshot, the log and match info with your name (%s).\nA copy stays on this PC." % (who if who != "" else "no name")
	else:
		bug_send_info.text = "Kept on this PC only."
	if not bug_sw_touched and bug_status.text == "":
		if bug_relay == "not_setup":
			bug_send_info.text = "The relay doesn't take reports yet: kept on this PC only."
		elif bug_relay == "offline":
			bug_send_info.text = "Can't reach the relay right now: kept on this PC only."
	bug_send_b.visible = bug_send_row.visible and bug_send_sw.button_pressed or sending
	bug_send_b.disabled = sending
	bug_send_b.text = "Sending…" if sending else ("Try again" if bug_status.text.begins_with("Couldn't") else "Send")
	bug_status.visible = bug_status.text != ""
	bug_status2.visible = bug_status2.text != ""
	_bug_plaque_fit()


# 0.42: size the card to its content and keep it centred (it changes as the send state changes)
func _bug_plaque_fit() -> void:
	bug_plaque.reset_size()
	var sz := bug_plaque.get_combined_minimum_size()
	bug_plaque.offset_left = -round(sz.x / 2.0)
	bug_plaque.offset_right = bug_plaque.offset_left + sz.x
	bug_plaque.offset_bottom = bug_plaque.offset_top + sz.y


# 0.42: Send pressed: save the note, then POST the folder to the relay (scripts/feedback_send.gd).
func _bug_send() -> void:
	if bug_sender == null or bug_sent or bug_sender.busy:
		return
	BugReport.set_note(bug_dir, _bug_note_text())
	var who := String(account.profile_name) if account != null and String(account.profile_name) != "" else (String(net.my_name) if net != null else "")
	var meta := {"name": who, "version": Net.game_version(), "platform": "%s %s" % [OS.get_name(), OS.get_version()],
		"kind": "feedback" if bug_feedback else "bug", "note": _bug_note_text().strip_edges().left(4000), "context": bug_ctx, "folder": bug_dir.get_file()}
	var why := bug_sender.send(bug_dir, meta)
	if why != "":
		_bug_send_done(false, why)
		return
	bug_status.text = ""
	bug_status2.text = ""
	_bug_plaque_refresh()


func _bug_send_done(ok: bool, msg: String) -> void:
	bug_sent = ok
	var shown := bug_plaque != null and bug_plaque.visible
	if ok:
		bug_status.text = "Sent — thank you!"
		bug_status2.text = "A copy stays in bugreports/" + bug_dir.get_file()
		if not shown:
			show_good("Feedback sent — thank you!")
	else:
		bug_status.text = "Couldn't send — saved to %s instead" % bug_dir
		bug_status2.text = msg
		if not shown:
			show_error("Couldn't send the report (%s). It is saved in bugreports." % msg.trim_suffix("."))
	bug_status.add_theme_color_override("font_color", Color("#9fe08a") if ok else Color("#f0c070"))
	if shown:
		_bug_plaque_refresh()


func _bug_note_text() -> String:
	return bug_text.text if bug_text != null and bug_text.visible else bug_note.text


func _bug_plaque_close() -> void:
	if bug_plaque == null or not bug_plaque.visible:
		return
	BugReport.set_note(bug_dir, _bug_note_text())
	bug_note.release_focus()
	bug_text.release_focus()
	bug_plaque.visible = false
	if bug_paused:
		bug_paused = false
		if paused and not pause_ov.visible:
			paused = false
	if bug_from_pause:
		bug_from_pause = false
		if paused and sim != null and game.visible and not sim.over:
			set_paused(true)


# The connection to the host is gone; the match waits (frozen) for Rejoin or Leave. Menus stay usable.
func _on_net_dropped(reason: String) -> void:
	if not game.visible or sim == null:
		return
	_net_plaque_show("Connection lost", reason, true, not net.auto_rc)
	if net_wait_lbl != null:
		net_wait_lbl.visible = false


# 0.26: the game reconnects on its own; the plaque counts the seconds ("Reconnecting…  12 s  ·  Leave").
func _on_net_reconnecting(title: String, sub: String) -> void:
	if not game.visible or sim == null:
		return
	_net_plaque_show(title, sub, true, false)
	if net_wait_lbl != null:
		net_wait_lbl.visible = false


func _on_rejoin_started(cfg: Dictionary, slot: int, fresh: bool) -> void:
	if slot < 0:
		# 0.44: a spectator joining mid-match (or re-synced after a host change): the catch-up fast-forwards silently
		if fresh or sim == null or not game.visible or not spectating:
			_build_spectator_sim(cfg)
			clear_announcements()
		spec_status = "catching up"
		_net_plaque_show("Catching up…", "0%", false)
		return
	if fresh or sim == null or not game.visible:
		# the game was closed meanwhile (or the match moved on past us): build it again and fast-forward
		_build_online_sim(cfg, slot)
		clear_announcements()   # the "setup" line of a fresh match means nothing mid-match
	_net_plaque_show("Catching up…", "0%", false)


func _on_net_catchup(frac: float) -> void:
	if net_plaque != null and net_plaque.visible:
		net_plaque_sub.text = "%d%%" % int(frac * 100.0)


func _on_net_rejoined() -> void:
	if spectating:   # 0.44: live now (spec_delay behind)
		_net_plaque_hide()
		spec_status = ""
		if sim != null and not sim.over:
			announce("Live", "Watching %d s behind the match" % roundi(Settings.spec_delay), 1, 2.5)
			update_hud()
		return
	BugReport.rejoins += 1
	_net_plaque_hide()
	if sim != null and not sim.over:
		announce("You're back", "Your hero is yours again", 1, 2.5)
		update_hud()


func _on_rejoin_failed(reason: String) -> void:
	if net.is_dropped and game.visible and sim != null:
		_net_plaque_show("Connection lost", reason, true, not net.auto_rc)
	elif mp_ov != null and (mp_ov.visible or menu.visible):
		show_mp()
		mp_status.text = reason
		_rejoin_offer_refresh()


func _on_host_migrated(me: bool) -> void:
	BugReport.migrations += 1
	if game.visible and sim != null:
		announce("Host changed", "You host the match now" if me else "The match goes on under a new host", 1, 3.0)


# Main menu: a crashed or closed game may pick its last online match up again (Net.REJOIN_MAX_AGE).
func _rejoin_offer_refresh() -> void:
	var d := net.rejoin_offer()
	if rejoin_plaque == null:
		if d.is_empty():
			return
		var pl := UIParts.Plaque.new(16.0, 10.0)
		set_anchor_rect(pl, 1, 0, 1, 0, -420, 96, -48, 96)
		pl.grow_horizontal = Control.GROW_DIRECTION_BEGIN
		menu.add_child(pl)
		var row := hbox(14)
		pl.add_child(row)
		rejoin_plaque_lbl = lbl("", 15, TEXT, false, 2)
		rejoin_plaque_lbl.size_flags_horizontal = SIZE_EXPAND_FILL
		rejoin_plaque_lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		row.add_child(rejoin_plaque_lbl)
		var b := Button.new()
		b.text = "Rejoin"
		b.focus_mode = FOCUS_NONE
		style_primary(b)
		b.pressed.connect(func():
			audio.play("click", -6.0)
			rejoin_plaque.visible = false
