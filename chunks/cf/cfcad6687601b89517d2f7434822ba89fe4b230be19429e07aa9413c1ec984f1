# ---------------------------------------------------------------- 0.44 achievement rewards (Cosmetics)
# Whether a cosmetic is yours: skins by skin_unlocked (any hero: ach / ach_id skins are for every hero), the rest
# by the achievement that grants it.
static func owns(k: String, id: String) -> bool:
	ensure()
	if id == "":
		return true   # the default look
	match k:
		"skin":
			var d := skin_def(id)
			if d.has("season"):
				return ranked_rewards.has("skin:%d" % int(d["season"]))   # ---- 0.45 ranked ----
			return d.has("ach") and achieved.size() >= int(d["ach"]) or d.has("ach_id") and achieved.has(String(d["ach_id"]))
		"title":
			if id.begins_with("hm_"):
				return int(hero(id.trim_prefix("hm_")).get("mct", 0)) >= CHALLENGES.size()   # 0.49 mastery
			if id.begins_with("rk_s"):
				return ranked_rewards.get("title:%d" % season_title_season(id), -1) == season_title_tier(id)   # ---- 0.45 ranked ----
			return Cosmetics.TITLES.has(id) and achieved.has(id)
	for aid in Cosmetics.REWARDS:
		if Cosmetics.REWARDS[aid]["k"] == k and Cosmetics.REWARDS[aid]["id"] == id:
			return achieved.has(aid)
	return false


const _COS_KEY := {"crystal": "cr", "title": "ti", "recall": "rc"}


# The equipped crystal colour / title / recall flash id ("" = default); a reward you no longer own reads as "".
static func equipped(k: String) -> String:
	ensure()
	var id := String(cosmetics.get(_COS_KEY.get(k, k), ""))
	return id if owns(k, id) else ""


# Equips a crystal colour, title or recall flash ("" for the default). Returns false when it isn't yours.
static func equip(k: String, id: String) -> bool:
	ensure()
	if not _COS_KEY.has(k) or not owns(k, id):
		return false
	if id == "":
		cosmetics.erase(_COS_KEY[k])
	else:
		cosmetics[_COS_KEY[k]] = id
	save()
	return true


