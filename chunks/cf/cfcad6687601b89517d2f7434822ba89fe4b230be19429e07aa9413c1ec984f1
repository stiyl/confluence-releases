func _draft_fit() -> void:
	if draft_head == null or draft_head_slots == null or draft.size.x < 100.0:
		return
	if draft_foot != null:
		draft_foot.visible = draft.size.y >= 700.0   # the Defend / Send / Win primer: not at 140% in a 720 window
	var brand: Control = draft_head.get_child(0)
	var need: float = brand.get_combined_minimum_size().x + 18.0 + draft_head_slots.get_combined_minimum_size().x
	var in_head: bool = draft_head_slots.get_parent() == draft_head
	var fits: bool = need <= draft.size.x - 80.0
	if fits == in_head:
		return
	draft_head_slots.get_parent().remove_child(draft_head_slots)
	if fits:
		draft_head.add_child(draft_head_slots)
		draft_head_slots.size_flags_horizontal = SIZE_FILL
		draft_head_slots.alignment = BoxContainer.ALIGNMENT_BEGIN
	else:
		draft_col.add_child(draft_head_slots)
		draft_col.move_child(draft_head_slots, 1)
		draft_head_slots.size_flags_horizontal = SIZE_SHRINK_END
		draft_head_slots.alignment = BoxContainer.ALIGNMENT_END


