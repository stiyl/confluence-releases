	if sim.duel_on and sim.duel_pair.size() == 2:
		duel_lbl.text = ""   # 0.18.1: no status line during the duel
	else:
		var nd := sim.duel_first
		while nd <= sim.round_no:
			nd += sim.duel_every
		duel_lbl.text = "Next duel: round %d" % nd if sim.duels_on else ""
		if sim.duel_next.size() == 2 and sim.duel_next_round == nd:
			duel_lbl.text += "  ·  %s (%s) vs %s (%s)" % [sim.duel_next[0].pl.name, sim.duel_next[0].def["name"].split(" ")[0], sim.duel_next[1].pl.name, sim.duel_next[1].def["name"].split(" ")[0]]
		duel_lbl.modulate.a = 0.75
		if sim.mode == "survival":
