static func hex(id: String) -> Dictionary:
	for h in HEXES:
		if h["id"] == id:
			return h
	return {}


# The hexes of a list of ids, in HEXES order, unknown ids dropped.
static func clean_hexes(ids: Array) -> Array:
	var out: Array = []
	for h in HEXES:
		if ids.has(h["id"]):
			out.append(h["id"])
	return out


static func heat_of(ids: Array) -> int:
	var n := 0
	for id in clean_hexes(ids):
		n += int(hex(id)["heat"])
	return n


# The Sim mods of a set of hexes (a key two hexes share is multiplied; start_omens / offer_less add).
static func hex_mods(ids: Array) -> Dictionary:
	var out := {}
	for id in clean_hexes(ids):
		for k in hex(id)["mods"]:
			var v := float(hex(id)["mods"][k])
			if k in ["start_omens", "offer_less"]:
				out[k] = float(out.get(k, 0.0)) + v
			else:
				out[k] = float(out.get(k, 1.0)) * v
	return out


