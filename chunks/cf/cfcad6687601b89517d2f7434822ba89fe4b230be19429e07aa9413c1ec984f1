func can_start() -> String:
	if not is_host:
		return "Only the host can start."
	var humans := 0
	for i in 8:
		var s: Dictionary = lobby["slots"][i]
		if s["kind"] == "human" and (i % 4) < team_size():
			humans += 1
			if not bool(s["ready"]) and int(s["peer"]) != 1:
				return "Waiting for %s to be ready." % s["name"]
	if humans < 2:
		return "Waiting for another player to join."
	return ""


# The host fixes everything that must be identical everywhere: seed, line-up, mode, map, difficulty.
func start() -> void:
	if can_start() != "":
		return
	# ---- 0.44 modes ----
	var mode0 := String(lobby.get("mode", "classic"))
	if mode0 == "draft" and draft == null:
		_draft_begin()   # the Start button opens the pick/ban phase; the match starts when it is complete
		return
	if draft != null and not draft.done():
		return
	# ---- end 0.44 modes ----
	var ts := team_size()
	if _rk_blind():
		for i in 8:   # ---- 0.45 ranked ---- the blind picks become the line-up (mirror picks allowed)
			if lobby["slots"][i]["kind"] == "human":
				lobby["slots"][i]["champ"] = String(_rk_picks.get(int(lobby["slots"][i]["peer"]), "random"))
	var taken := {}
	for s in lobby["slots"]:
		if String(s["champ"]) not in ["", "random"]:
			taken[s["champ"]] = true
	var pool: Array = []
	for c in GameData.CHAMPS:
		if not taken.has(c["id"]):
			pool.append(c["id"])
	pool.shuffle()
	var lineup: Array = []
	var ai_i := 0
	for i in 8:
		var s: Dictionary = lobby["slots"][i]
		var champ := String(s["champ"])
		if draft != null and draft.done():
			champ = String(draft.picks[i])   # 0.44 Draft: the picks are the line-up
		if champ in ["", "random"]:
			champ = pool.pop_back()
		var human: bool = s["kind"] == "human" and (i % 4) < ts
		var nm: String = s["name"] if human else Sim.AI_NAMES[i / 4][ai_i % 3]
		if not human:
			ai_i += 1
		lineup.append({"champ": champ, "human": human, "name": nm, "diff": int(lobby["diff"]), "peer": int(s["peer"]) if human else 0, "tok": String(s.get("tok", "")) if human else "",
			"fc": String(s.get("fc", "")) if human else "", "rt": int(s.get("rt", 0)) if human else 0, "rk": String(s.get("rk", "")) if human else "",   # 0.30: the verified friend code (right-click > Add friend); 0.43: rating
			"cos": Cosmetics.for_lineup(s.get("cos", {}), champ) if human else {}})   # ---- 0.44 rewards ---- skin for the hero got, crystal colour, title, recall flash
	var mode := String(lobby["mode"])
	var cfg := {"seed": randi(), "lineup": lineup, "mode": "classic" if mode in ["duo", "solo", "allrandom", "draft", "mayhem"] else mode,
		"team_size": ts, "map": int(lobby["map"]), "diff": int(lobby["diff"]), "tune": Tune.clean(lobby.get("tune", {})),   # 0.18.1 balance knobs
		"mid": randi()}   # 0.25: tells this match from the next one on a rejoin
	# ---- 0.44 modes ----
	if mode == "mayhem":
		cfg["variant"] = "mayhem"
		cfg["mods"] = Sim.MAYHEM_MODS.duplicate()
	elif mode == "draft" and draft != null:
		cfg["variant"] = "draft"
		cfg["bans"] = draft.all_bans()
		draft = null
		lobby.erase("draft")
	# ---- end 0.44 modes ----
	if lobby.has("ranked"):
		cfg["ranked"] = {"id": String(lobby["ranked"].get("id", "")), "mode": String(lobby["ranked"].get("mode", ""))}   # ---- 0.45 ranked ----
	_roster.rpc(peer_slot)
	_start.rpc(cfg)


