		line += "  ·  %s left" % WeeklyData.left_label(WeeklyData.seconds_left())
	box.add_child(lbl(line, 14, Color(0.6, 1.0, 0.7) if new_best else TEXT, true))
	box.add_child(lbl("Score: 1000 for the win plus up to 600 for speed (full at 10 minutes), 2 a kill, up to 500 for your crystal's health; a loss keeps the kills, the crystal and 10 a round.", 12, MUTED, true))
	var board := Profile.weekly_board(week, me_name)
	var k := 1
	for e in board.slice(0, 10):
		box.add_child(lbl("%d.  %s  ·  %d  ·  %s  ·  round %d  ·  %d kills  ·  %s" % [k, e["name"], int(e["score"]), "won" if bool(e.get("won", false)) else "lost", int(e.get("round", 0)), int(e.get("kills", 0)), String(e.get("hero", "")).split(" ")[0]], 14, GOLD if e.get("me", false) else TEXT))
		k += 1
	if board.size() <= 1:
		box.add_child(lbl("Everyone plays the same seed and twist this week. Send your code to friends and paste theirs here to compare.", 13, MUTED, true))
	if not mine.is_empty():
		var code := Profile.weekly_code(week, me_name, mine)
