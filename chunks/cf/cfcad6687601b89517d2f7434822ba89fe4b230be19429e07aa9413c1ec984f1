# Whose items the inventory slots show: the selected hero (ally or enemy), else your own.
func inv_hero():
	if sim == null:
		return null
	var mine = sim.players[sim.local].champ
	var o = selected()
	if o != null and o is Sim.Champ and o != mine:
		return o
	return mine


func inv_viewing_other() -> bool:
	return sim != null and inv_hero() != sim.players[sim.local].champ


func inv_clicked(slot: int) -> void:
	var c = sim.players[sim.local].champ if sim != null else null
	if c == null or inv_viewing_other():
		return
	if Input.is_key_pressed(KEY_SHIFT) or swap_from >= 0:
		# Shift+click two slots (or click a second slot after arming one) swaps them
		if swap_from < 0:
			if slot >= c.items.size():
				return
			swap_from = slot
			show_good("Swap: Shift+click the slot to move %s to." % GameData.item(c.items[slot])["name"])
			update_hud()
			return
		var a := swap_from
		swap_from = -1
		if a != slot:
			human_swap(a, slot)
		update_hud()
		return
	if slot < c.items.size():
		if not shop_panel.visible and GameData.item(c.items[slot]).has("act"):
			human_item(slot)
			return
		if not shop_panel.visible:
			toggle_shop()
		select_shop_item(c.items[slot], slot)
	elif not shop_panel.visible:
		toggle_shop()


func _inv_gui(ev: InputEvent, slot: int) -> void:
	if inv_viewing_other():
		return
	if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_RIGHT:
		human_sell(slot)


