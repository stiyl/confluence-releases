		round_lbl.text = "Tutorial   ·   waves start when you're ready"
	elif sim.mode == "survival":
		round_lbl.text = "Survival   ·   Round %d   ·   Next wave %ds   ·   Best: round %d" % [sim.round_no, ceili(sim.round_len - sim.round_t), int(Profile.survival[0]["round"]) if Profile.survival.size() > 0 else 0]
	elif sim.variant == "mayhem" and topbar_w >= 1750.0:
