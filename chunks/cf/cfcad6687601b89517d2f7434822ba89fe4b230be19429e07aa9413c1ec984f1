	line += ("Best: %d (%s, %s, %d kills)  ·  %d attempt%s" % [int(mine["score"]), "won" if bool(mine.get("won", false)) else "lost", String(mine.get("hero", "")).split(" ")[0], int(mine.get("kills", 0)), int(mine.get("tries", 1)), "" if int(mine.get("tries", 1)) == 1 else "s"]) if not mine.is_empty() else "Not played yet."
