extends RefCounted


static func draw_badge(ci: CanvasItem, r: Rect2, icon: String, got: bool, hidden: bool) -> void:
	var c := r.get_center()
	var rad := minf(r.size.x, r.size.y) * 0.5
	ci.draw_circle(c + Vector2(0, 2), rad, Color(0, 0, 0, 0.5))
	var rim := UIParts.BRONZE_LITE if got else UIParts.BRONZE_DARK.lightened(0.15)
	ci.draw_circle(c, rad, Color(rim.darkened(0.45), 1.0))
	ci.draw_circle(c, rad - 2.0, rim)
	var face_top := Color(0.30, 0.29, 0.26) if got else Color(0.13, 0.12, 0.10)
	var face_bot := Color(0.12, 0.11, 0.09) if got else Color(0.06, 0.05, 0.045)
	ci.draw_circle(c, rad - 4.0, face_bot)
	ci.draw_circle(c - Vector2(0, rad * 0.18), rad * 0.72, Color(face_top, 0.8))
	# little notches on the rim
	for i in 8:
		var d := Vector2.from_angle(TAU * i / 8.0 + PI / 8.0)
		ci.draw_circle(c + d * (rad - 2.0), 1.4, Color(rim.lightened(0.3), 0.9 if got else 0.4))
	var inner := Rect2(c - Vector2.ONE * rad * 0.62, Vector2.ONE * rad * 1.24)
	if hidden:
		var f := UIParts.font("display")
		var fs := int(rad * 0.9)
		ci.draw_string(f, Vector2(r.position.x, c.y + fs * 0.36), "?", HORIZONTAL_ALIGNMENT_CENTER, r.size.x, fs, Color(UIParts.MUTED, 0.7))
		return
	var tint := UIParts.GOLD_TEXT if got else Color(0.42, 0.40, 0.36)
	var mod := Color.WHITE if got else Color(0.38, 0.36, 0.34, 0.85)
	var kind := icon.substr(2)
	if icon.begins_with("i:"):
		if not Sprites.draw_fit(ci, "item_" + kind, inner, 0, 0, 1.0, mod):
			glyph(ci, "star", inner, tint)
	elif icon.begins_with("m:"):
		if not UIParts.draw_tight(ci, Sprites.mon_sheet(kind), inner.grow(rad * 0.08), 3):
			glyph(ci, "skull", inner, tint)
		elif not got:
			ci.draw_circle(c, rad - 4.0, Color(0.06, 0.05, 0.045, 0.6))
	elif icon.begins_with("h:"):
		var def := {}
		for ch in GameData.CHAMPS:
			if ch["id"] == kind:
				def = ch
		UIParts.portrait_disc(ci, c, rad * 0.66, def, "", 3, 1.0, Color(0, 0, 0, 0), not got)
	elif icon.begins_with("a:"):
		UIParts.draw_glyph(ci, kind, inner.grow(-rad * 0.08), tint)
	else:
		glyph(ci, kind, inner, tint)
	if not got:
		UIParts.lock_glyph(ci, c + Vector2(rad * 0.62, rad * 0.62), maxf(0.55, rad / 40.0))


