		var streak := Profile.daily_streak(SurvivalData.today())
		if streak >= 3:
			award("streak_3")
		if streak >= 7:
			award("streak_7")
	check_campaign_achievements()
	for id in Profile.heroes:
		if Profile.mastery(id) >= 5:
			award("mastery_5")
	if Profile.heroes_played() >= 10:
		award("collector")
	check_achievements()



func human_item(slot: int) -> void:
	if sim == null or sim.over or paused or replay_mode:
		return
	var c = sim.players[sim.local].champ
	var tp: Vector2 = mouse_world if (mouse_in and my_view()) else auto_aim(c)
	var why = act("item", [slot, tp])
	if why is String and why != "" and why != "sent" and why != "none" and why != "ok":
		show_error(why)
	elif slot < inv_btns.size():
		inv_btns[slot].flash = 0.25



