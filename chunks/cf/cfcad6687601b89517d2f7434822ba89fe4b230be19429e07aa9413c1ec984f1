func _short(x: float) -> String:
	return "%.1fk" % (x / 1000.0) if x >= 1000.0 else str(roundi(x))


# 12345 -> "12,345"
func _thousands(n: int) -> String:
	var t := str(absi(n))
	var out := ""
	while t.length() > 3:
		out = "," + t.substr(t.length() - 3) + out
		t = t.substr(0, t.length() - 3)
	return ("-" if n < 0 else "") + t + out


