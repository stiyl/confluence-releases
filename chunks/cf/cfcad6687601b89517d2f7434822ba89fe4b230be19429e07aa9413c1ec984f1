func _ready() -> void:
	name = "Telemetry"
	_instance = self
	_ph = HTTPRequest.new()
	_ph.timeout = 20.0
	add_child(_ph)
	_ph.request_completed.connect(_on_ph_done)
	_se = HTTPRequest.new()
