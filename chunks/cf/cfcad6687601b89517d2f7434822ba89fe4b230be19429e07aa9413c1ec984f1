# Sends a friend request to a party member (their verified friend code from the party roster).
func add_friend(code: String, nm: String) -> void:
	_req_sent[party.norm(code)] = true
	refresh()
	main.account.add_friend(code, func(res: Dictionary):
		if bool(res.get("ok", false)):
			news(("You and %s are now friends." if String(res.get("state", "")) == "friends" else "Friend request sent to %s.") % nm)
		else:
			_req_sent.erase(party.norm(code))
			news(String(res.get("msg", "Couldn't send the request.")))
		refresh())


# The 0.30 player menu on a member (right-click or "···"): Add friend / Whisper / Block, and for the leader
# Make leader / Kick.
func member_menu(id: int, e: Dictionary, at: Vector2) -> void:
	var extra: Array = []
	if party.is_leader() and id > 1:
		extra.append(["Make leader", func(): party.promote(id)])
		extra.append(["Kick from party", func(): party.kick(id)])
	var code := String(e.get("code", ""))
	main.whisper_ui.open_player_menu(String(e.get("name", "?")), code, true, at, extra)
	var pm: PopupMenu = main.whisper_ui.pm
	if pm.get_item_index(2) >= 0:
		pm.remove_item(pm.get_item_index(2))   # "Invite to party": already in it
	if pm.get_item_index(0) >= 0 and code != "":
		# Add friend goes through add_friend here (the row shows "Request sent")
		main.whisper_ui._pm_target["party_add"] = func(): add_friend(code, String(e.get("name", "")))
	pm.reset_size()


