	var title := ""
	var desc := ""
	var desc_col := UIParts.TEXT     # 0.44: the reward line in the highlight colour
	var cap := "ACHIEVEMENT UNLOCKED"
	var icon := ""
	var fade := true
	var gone := Callable()           # true when the toast should leave early (the match it was shown over ended)
	var hold := Callable()           # 0.46.1: true while it would cover something (the Armory): hidden, and its 6 s wait
	var _born := 0

	func _ready() -> void:
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		_born = Time.get_ticks_msec()

