func render_slots(shown: Dictionary) -> void:
	for box in [slots_a, slots_b]:
		for ch in box.get_children():
			ch.queue_free()
	var surv_like := game_mode in ["survival", "daily"]
	var ts := team_size_of(game_mode) if not surv_like else 1
	for i in 8:
		if i % 4 >= ts or (surv_like and i >= 4):
			continue
		var box := slots_a if i < 4 else slots_b
		var p: UIParts.Portrait
		if shown.has(i):
			p = portrait_for(find_champ(shown[i].champ_id), 44)
			p.team_col = WARD if i < 4 else EMBER
		elif pb != null and pb.picks[i] != "":
			p = portrait_for(find_champ(pb.picks[i]), 44)   # 0.44 Draft: a pick made
			p.team_col = WARD if i < 4 else EMBER
			p.name = "Pick%d" % i
		elif pb != null and i == pb.slot_now():
			p = portrait_for(find_champ(sel_id) if _pb_my_turn() else {}, 44)   # 0.44 Draft: the slot being picked
			p.dim = true
		elif pb != null:
			p = portrait_for({}, 44)
		elif i == 0:
			p = portrait_for(find_champ(sel_id), 44)
			p.dim = true
		else:
			p = portrait_for({}, 44)
		box.add_child(p)


# While the lock-in animation plays, nothing on hero select may change the setup.
func _set_draft_locked(v: bool) -> void:
	for b in draft_btns:
		b.disabled = v
	for k in tiles:
		tiles[k].disabled = v


func lock_in() -> void:
	if locking:
		return
	if game_mode == "tutorial":
		tut.launch()   # 0.37: the tutorial plays its own match (a fixed hero, map and seed)
		return
	locking = true
	_set_draft_locked(true)
	if game_mode == "allrandom":
		var pool: Array = []
		for ch in GameData.CHAMPS:
			if not bans.has(ch["id"]):
				pool.append(ch["id"])
		sel_id = pool[randi() % pool.size()]
		for k in tiles:
			tiles[k].set_pressed_no_signal(k == sel_id)
	render_detail()
	_codex_lock_tip()   # ---- 0.45 codex ---- a tip while the line-up reveals (the loading moment)
	var sim_mode := "classic" if game_mode in ["allrandom", "duo", "solo", "draft", "mayhem", "weekly"] else ("survival" if game_mode == "daily" else game_mode)
	var mopts := {"mode": sim_mode, "map": 0 if game_mode == "tutorial" else game_map, "team_size": team_size_of(game_mode), "ai_tiers": game_mode != "tutorial",
		"talents": TalentData.effects(sel_id, Profile.talents_taken(sel_id)) if game_mode == "survival" else [], "seed": randi(),
		"tune": Tune.clean(Tune.load_draft())}   # 0.18.1: the F8 balance panel's set (recorded with the replay)
	var mdiff := 0 if game_mode == "tutorial" else difficulty
	# ---- 0.44 modes ----
	var mbans := bans
	if game_mode == "draft" and pb != null and pb.done():
		sel_id = pb.picks[0]
		mbans = pb.all_bans()
		var line: Array = []
		for i in 8:
			line.append({"champ": pb.picks[i], "human": i == 0})
		mopts["lineup"] = line
		mopts["variant"] = "draft"
	elif game_mode == "mayhem":
		mopts["variant"] = "mayhem"
		mopts["mods"] = Sim.MAYHEM_MODS.duplicate()
	elif game_mode == "survival" and not Profile.surv_hexes.is_empty():
		# 0.48: the run's Hexes are plain mods (deterministic, carried by the replay)
		mopts["mods"] = SurvivalData.hex_mods(Profile.surv_hexes)
		mopts["hexes"] = Profile.surv_hexes.duplicate()
	elif game_mode == "weekly":
		var wk := WeeklyData.this_week()
		mopts["variant"] = "weekly"
		mopts["week"] = wk
		mopts["mods"] = Dictionary(WeeklyData.twist_of(wk)["mods"]).duplicate()
		mopts["seed"] = WeeklyData.seed_of(wk)
		mopts["map"] = WeeklyData.map_of(wk, Sim.MAPS.size())
		mdiff = WeeklyData.DIFF
	# ---- end 0.44 modes ----
	if game_mode == "daily":
		var td := SurvivalData.today()
		sel_id = SurvivalData.daily_hero(td)
		mopts["daily"] = td
		mopts["seed"] = SurvivalData.daily_seed(td)
		mopts["map"] = SurvivalData.daily_map(td, Sim.MAPS.size())
		mdiff = 1
	var match_sim := Sim.new(sel_id, false, mdiff, mbans, mopts.duplicate(true))
	match_sim.players[0].champ.skin = Profile.skin_of(sel_id)
	match_sim.players[0].cos = Profile.cos_for(sel_id)   # ---- 0.44 rewards ---- crystal colour, recall flash, title (view-only)
	if game_mode == "tutorial":
		Replay.cancel()
	else:
		Replay.begin({"hero": sel_id, "diff": mdiff, "bans": mbans.duplicate(), "opts": mopts, "skin": Profile.skin_of(sel_id), "cos": Profile.cos_for(sel_id), "game_mode": game_mode,
			"label": "%s  ·  %s" % [mode_info(game_mode)[1] + ((" " + Profile.date_label(int(mopts["daily"]))) if mopts.has("daily") else "") + ((" " + WeeklyData.week_label(int(mopts["week"]))) if mopts.has("week") else ""), Sim.MAPS[mopts["map"]]["name"]]})
	var shown := {}
	for k in [0, 4, 1, 5, 2, 6, 3, 7]:
		if match_sim.players[k].absent:
			continue
		shown[k] = match_sim.players[k]
		render_slots(shown)
		await get_tree().create_timer(0.17).timeout
		if not draft.visible or not locking:
			break
	await get_tree().create_timer(0.5).timeout
	_set_draft_locked(false)
	if not draft.visible or not locking:
		# the player left hero select (or an online match started) while the animation played
		locking = false
		Replay.cancel()
		match_sim.dispose()
		return
	start_game(match_sim)


