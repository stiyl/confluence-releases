	rb.tooltip_text = "Draw three new cards of the same kind. Each reroll in the same draft costs more."
	rb.disabled = me_pl.gold < sim.reroll_cost()
	rb.custom_minimum_size = Vector2(240, 36)
	style_primary(rb)
	rb.pressed.connect(_reroll)
	boon_actions.add_child(rb)
	skip_btn = Button.new()
	skip_btn.focus_mode = FOCUS_NONE
	skip_btn.text = "Skip (no reward)"
	skip_btn.tooltip_text = "Take none of these cards. The waves go on; nothing comes back later."
	skip_btn.custom_minimum_size = Vector2(0, 36)
	skip_btn.pressed.connect(_skip_cards)
	boon_actions.add_child(skip_btn)
	if sim.daily > 0:
		boon_actions.add_child(lbl("Daily run  ·  same cards for everyone today", 13, MUTED))
	boon_ov.visible = true
	audio.play("duel_win", -8.0)


func _owns_card(o: Dictionary) -> bool:
	var c = sim.players[sim.local].champ
	match String(o["kind"]):
		"item":
			return c.items.has(o["id"])
		"rank":
			return true
	return false


func _reroll() -> void:
	if not drafting() or sim.card_offer.is_empty() or paused:
		return
	if _res_ok(act("reroll", [])):
		audio.play("click", -4.0)
		for ch in boon_row.get_children():
			ch.queue_free()
		_open_cards()
		update_hud()


func _banish(i: int) -> void:
	if not drafting() or i >= sim.card_offer.size() or paused:
		return
	if _res_ok(act("banish", [i])):
		audio.play("click", -4.0)
		for ch in boon_row.get_children():
			ch.queue_free()
		_open_cards()
		update_hud()


# Sim command "skip": the draft closes with no card taken (nothing happens if the simulation lacks it).
func _skip_cards() -> void:
	if not drafting() or sim.card_offer.is_empty() or paused:
		return
	var res = act("skip", [])
	if not _res_ok(res):
		return
	audio.play("click", -4.0)
	boon_ov.visible = false
	update_hud()


func choose_boon(i: int) -> void:
	if paused:
		return
	if drafting() and not sim.card_offer.is_empty():
		if i >= sim.card_offer.size():
			return
		var info := _card_info(sim.card_offer[i])
		act("card", [i])
		announce(String(info["name"]), String(info["meta"]))
		boon_ov.visible = false
		update_hud()
		return
	if not drafting() or i >= sim.boon_offer.size():
		return
	var id: String = sim.boon_offer[i]
	act("boon", [i])
	announce(String(SurvivalData.BOONS[id]["name"]), String(SurvivalData.BOONS[id]["desc"]))
	boon_ov.visible = false
	update_hud()



