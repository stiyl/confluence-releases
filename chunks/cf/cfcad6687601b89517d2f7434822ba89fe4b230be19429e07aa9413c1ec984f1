# A flat outline (x, y pairs in the plane facing +x), extruded t along x: banners and pennants.
static func _slab_yz(pts: Array, t: float) -> Array:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.set_smooth_group(-1)
	var n: int = pts.size()
	var f: Array = []
	var b: Array = []
	for p in pts:
		f.append(Vector3(t * 0.5, p.y, -p.x))
		b.append(Vector3(-t * 0.5, p.y, -p.x))
	for i in range(1, n - 1):
		for v in [f[0], f[i], f[i + 1], b[0], b[i + 1], b[i]]:
			st.add_vertex(v)
	for i in n:
		var j := (i + 1) % n
		for v in [f[i], b[j], f[j], f[i], b[i], b[j]]:
			st.add_vertex(v)
	st.generate_normals()
	return st.commit_to_arrays()


