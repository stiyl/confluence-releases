# ---------------------------------------------------------------- behaviour
func select_tab(i: int, user := false) -> void:
	tab = clampi(i, 0, TABS.size() - 1)
	last_tab = tab
	if user and search.text != "":
		search.text = ""
	pending = {}
	scroll.scroll_vertical = 0
	_apply_filter()
	if user:
		main.audio.play("click", -10.0)


func cycle_tab(d: int) -> void:
	if search.text != "":
		search.text = ""
	select_tab(posmod(tab + d, TABS.size()), true)


func open() -> void:
	pending = {}
	search.text = ""
	select_tab(last_tab, false)
	refresh()


# Shows the current tab, or every row that matches the search across all tabs.
func _apply_filter() -> void:
	var q := search.text.strip_edges().to_lower()
	var total := 0
	for r in rows:
		r.visible = q == "" or r.words.contains(q)
	for s in sections:
		var any := false
		for r in s.rows:
			if r.visible:
				any = true
				break
		s.visible = any
	for i in pages.size():
		var n := 0
		if q != "":
			for r in rows:
				if r.page == i and r.visible:
					n += 1
		total += n
		pages[i].visible = (i == tab) if q == "" else n > 0
		page_heads[i].visible = q != ""
		# hints, notes and conflict prompts are part of a tab, not of a search
		for ch in pages[i].get_children():
			if not (ch is Row or ch is SectionHead or ch is GridContainer) and ch != page_heads[i]:
				ch.visible = q == "" and _extra_visible(ch)
	for i in tab_btns.size():
		tab_btns[i].set_pressed_no_signal(q == "" and i == tab)
	no_match.visible = q != "" and total == 0
	reset_btn.disabled = q != ""
	reset_btn.tooltip_text = _reset_tip()
	if hover_row != null and is_instance_valid(hover_row):
		hover_row.hot = false
		hover_row.queue_redraw()
	hover_row = null


func _extra_visible(ch: Node) -> bool:
	if ch == steam_pad_row:
		return _steam_on()
	for gi in conflict:
		if conflict[gi]["box"] == ch:
			return not pending.is_empty() and _group_of(String(pending["act"])) == gi
	return true


func _steam_on() -> bool:
	return main.net != null and bool(main.net.steam_ok)


func _group_of(act: String) -> int:
	for gi in KEY_GROUPS.size():
		if KEY_GROUPS[gi][1].has(act):
			return gi
	return KEY_GROUPS.size() - 1


func _reset_tip() -> String:
	match tab:
		T_KEYS:
			return "Every key back to its default"
		T_PAD:
			return "Controller settings and buttons back to their defaults"
	return "Every setting on %s back to its default" % TABS[tab]


func refresh() -> void:
	for f in refreshers:
		f.call()
	for a in key_caps:
		var c: KeyCap = key_caps[a]
		c.waiting = main.rebinding == a
		c.cap = Settings.kb_name(a)
		c.bad = not pending.is_empty() and (pending["act"] == a or pending["other"] == a)
		c.queue_redraw()
		var r: Row = key_rows[a]
		r.words = "%s %s" % [r.base_words, c.cap.to_lower()]
	for gi in conflict:
		var show: bool = not pending.is_empty() and _group_of(String(pending["act"])) == gi
		conflict[gi]["box"].visible = show and search.text == ""
		if show:
			var other: String = pending["other"]
			var on := ""
			for a in Settings.ACTIONS:
				if a[0] == other:
					on = a[1]
			conflict[gi]["lbl"].text = "%s is already used by %s." % [Settings.kb_name(other), on]
	if main.set_pad_name != null:
		var jn: String = main.pad.joy_name() if main.pad != null else ""
		main.set_pad_name.text = ("Connected: %s  ·  %s glyphs" % [jn, Settings.PAD_STYLES[Settings.pad_style_now()]]) if jn != "" else "No controller connected"
	for a in pad_caps:
		var c: KeyCap = pad_caps[a]
		c.waiting = main.pad != null and main.pad.rebinding == a
		c.cap = Settings.button_label(Settings.pad_button(a))
		c.queue_redraw()
	if pad_fixed != null:
		var mb := Settings.button_label(Settings.pad_button("pad_mod"))
		pad_fixed.text = "Fixed: left stick walks  ·  right stick moves the cursor  ·  hold %s + a shoulder or trigger: learn  ·  %s + d-pad: ally commands  ·  %s + %s: vote  ·  %s + %s: hold  ·  %s + %s: enemy hero  ·  %s + %s: crystal" % [mb, mb, mb, Settings.button_label(JOY_BUTTON_A), mb, Settings.button_label(JOY_BUTTON_X), mb, Settings.button_label(JOY_BUTTON_RIGHT_STICK), mb, Settings.button_label(JOY_BUTTON_BACK)]


# A key pressed while an action waits for one: bind it, or ask first when another action already holds it.
func bind_key(act: String, k: int) -> void:
	var other := Settings.action_for(k)
	if other != "" and other != act:
		pending = {"act": act, "key": k, "other": other}
		_apply_filter()
	else:
		pending = {}
		Settings.rebind(act, k)
	refresh()


func resolve(swap: bool) -> void:
	if swap and not pending.is_empty():
		Settings.rebind(String(pending["act"]), int(pending["key"]))
	pending = {}
	_apply_filter()
	refresh()
	main.refresh_hotkeys()


# Esc: drops an open key-conflict prompt first (true), else lets Settings close.
func cancel_pending() -> bool:
	if pending.is_empty():
		return false
	resolve(false)
	return true


