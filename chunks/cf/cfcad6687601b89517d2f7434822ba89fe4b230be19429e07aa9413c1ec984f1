		"role_all": return [Array(stats.get("roles_won", [])).size(), ROLES.size()]
		"heroes_all": return [heroes_played(), GameData.CHAMPS.size()]
		"collector": return [heroes_played(), 10]
		"all_bosses": return [bosses_beaten.size(), 5]
		"rating_1200": return [int(rating.get("peak", RATING_START)), 1200]
		"mastery_5":
			var best := 0
			for id in heroes:
				best = maxi(best, mastery(id))
			return [best, 5]
		"surv_20", "surv_30", "surv_40":
			return [int(survival[0]["round"]) if survival.size() > 0 else 0, int(aid.substr(5))]
	return []


static func mastery(id: String) -> int:
	var xp := int(hero(id)["xp"])
	var lv := 0
	for need in MASTERY_XP:
		if xp >= need:
			lv += 1
	return lv


# 0..1 progress toward the next mastery level (1.0 at max)
static func mastery_frac(id: String) -> float:
	var lv := mastery(id)
	if lv >= MASTERY_XP.size():
		return 1.0
	var xp := float(hero(id)["xp"])
	return (xp - MASTERY_XP[lv - 1]) / float(MASTERY_XP[lv] - MASTERY_XP[lv - 1])


static func skin_def(sid: String) -> Dictionary:
	for s in SKINS:
		if s["id"] == sid:
			return s
	return SKINS[0]


static func skin_unlocked(id: String, sid: String) -> bool:
	var d := skin_def(sid)
	if d.has("season"):
		return ranked_rewards.has("skin:%d" % int(d["season"]))   # ---- 0.45 ranked ---- a season reward
	if d.has("ach_id"):
		return achieved.has(String(d["ach_id"]))   # 0.44: the reward of one achievement
	if d.has("ach"):
		return achieved.size() >= int(d["ach"])
	return mastery(id) >= int(d["need"])


static func skin_hint(sid: String) -> String:
	var d := skin_def(sid)
	if d.has("season"):
		return "reward for %d ranked games in Season %d" % [10, int(d["season"])]   # ---- 0.45 ranked ----
	if d.has("ach_id"):
		return "unlocks with the achievement %s" % String(ach_def(String(d["ach_id"])).get("name", d["ach_id"]))
	if d.has("ach"):
		return "unlocks with %d achievements" % int(d["ach"])
	return "unlocks at mastery %d with this hero" % int(d["need"])


