		t.desc = Cosmetics.reward_line(r)
		t.desc_col = UIParts.GOLD_TEXT
	t.icon = String(ACH_ICON.get(aid, "g:star"))
	_place_toast(t)


func _place_toast(t: Toast) -> void:
	t.custom_minimum_size = Vector2(340, 72)
	var camp: bool = main.campaign_ui != null and main.campaign_ui.in_mission()
	var game_up: bool = main.game != null and main.game.visible and main.sim != null
	if game_up and main.sim.over and not camp and main.end_side != null:
		# the end screen: a line in its right column, under an "Achievements" head (no floating plaque over it)
		var hd = main.end_side.get_meta("ach_head") if main.end_side.has_meta("ach_head") else null   # 0.44: get_meta with a null default logs an error
		if hd == null or not is_instance_valid(hd) or hd.is_queued_for_deletion():
			hd = main.head_lbl("Achievements", 19, UIParts.GOLD, 3)
			main.end_side.add_child(hd)
			main.end_side.set_meta("ach_head", hd)
		t.fade = false
		t.custom_minimum_size = Vector2(0, 64)
		main.end_side.add_child(t)
		return
	if _toasts == null or not is_instance_valid(_toasts):
		_toasts = VBoxContainer.new()
		_toasts.add_theme_constant_override("separation", 8)
		_toasts.mouse_filter = MOUSE_FILTER_IGNORE
		_toasts.z_index = 125
		main.add_child(_toasts)
	if game_up and not main.sim.over:
		var shown_sim = main.sim
		t.gone = func() -> bool: return main.sim != shown_sim or shown_sim.over or not main.game.visible
		t.hold = func() -> bool: return (main.shop_panel != null and main.shop_panel.visible) or (main.core_panel != null and main.core_panel.visible)
		_toasts.set_anchors_preset(PRESET_TOP_LEFT)
		_toasts.alignment = BoxContainer.ALIGNMENT_BEGIN
		_toasts.offset_left = 16
		_toasts.offset_right = 356
		_toasts.offset_top = main.TOPBAR_H + 170
		_toasts.offset_bottom = main.TOPBAR_H + 420
	else:
		t.gone = func() -> bool: return main.game != null and main.game.visible and main.sim != null and not main.sim.over
		_toasts.set_anchors_preset(PRESET_BOTTOM_RIGHT)
		_toasts.alignment = BoxContainer.ALIGNMENT_END
		_toasts.offset_left = -356
		_toasts.offset_right = -16
		_toasts.offset_top = -330
		_toasts.offset_bottom = -90 if camp else -24
	_toasts.move_to_front()
	_toasts.add_child(t)
	while _toasts.get_child_count() > 3:
		var old := _toasts.get_child(0)
		_toasts.remove_child(old)
		old.queue_free()


