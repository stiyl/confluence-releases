# The camp kinds this match uses: every kind in skirmish and Survival; the campaign keeps only the Ancient
# unless a chapter's cfg names its "camps"; the tutorial shows the Ancient alone.
func camp_kinds_on() -> Array:
	if not camp_on:
		return []
	if cfg.has("camps"):
		return cfg["camps"]
	if not cfg.is_empty() or mode == "tutorial":
		return ["ancient"]
	return ["ancient", "beast", "spirit"]


func camp_index(kind: String) -> int:
	for ci in CAMPS.size():
		if String(CAMPS[ci]["kind"]) == kind:
			return ci
	return -1


func camp_pos(ci: int) -> Vector2:
	return CAMPS[ci]["pos"]


func camp_def(ci: int) -> Dictionary:
	return CAMP_KINDS[String(CAMPS[ci]["kind"])]


func _camp_arrays(ar) -> void:
	while ar.camps_t.size() < CAMPS.size():
		ar.camps_t.append(-1.0)
		ar.camps_up.append(false)


func spawn_camp(ar, ci := 0) -> void:
	_camp_arrays(ar)
	var kd := camp_def(ci)
	var cp := camp_pos(ci)
	var hm := hp_mult(round_no)
	var boss := spawn_mon(ar, kd["leader"], 0, null, hm)
	boss.p = cp
	boss.wi = 0
	boss.camp_i = ci
	boss.camp_home = cp
	var n: int = kd["guards"]
	for k in n:
		var g := spawn_mon(ar, kd["guard"], 0, null, hm)
		g.p = cp + Vector2.from_angle(TAU * k / n + 0.6) * Vector2(84.0, 52.0)
		g.wi = 0
		g.camp_i = ci
		g.camp_home = g.p
	ar.camps_up[ci] = true
	ar.camps_t[ci] = -1.0
	ev("camp_up", ar, cp, {"team": ar.team, "kind": String(CAMPS[ci]["kind"]), "ci": ci})


func camp_reward(ci: int) -> int:
	var kd := camp_def(ci)
	var k := 1.0 if String(kd["knob"]) == "" else tv(String(kd["knob"]))
	if mode == "survival":
		return roundi((40 + 4 * round_no) * k)
	return roundi((tv("camp_base") + tv("camp_round") * round_no) * k)


func camp_cleared(ar, ci := 0) -> void:
	_camp_arrays(ar)
	var kd := camp_def(ci)
	var kind := String(CAMPS[ci]["kind"])
	var cp := camp_pos(ci)
	ar.camps_up[ci] = false
	ar.camps_t[ci] = float(kd["respawn"])
	ar.bless[kind] = BLESS_TIME
	var reward := camp_reward(ci)
	var col := Color(String(kd["col"]))
	for c in ar.champs:
		if c.pl.team != ar.team:
			continue
		c.buffs = c.buffs.filter(func(b): return String(b.get("bless", "")) != kind)
		var b: Dictionary = (kd["buff"] as Dictionary).duplicate()
		b["t"] = BLESS_TIME
		b["bless"] = kind
		c.buffs.append(b)
		give_gold(c.pl, reward)
		if not c.dead:
			add_fx(ar, {"type": "ring", "p": c.p, "r": 44.0, "col": col, "t": 0.8, "dur": 0.8, "follow": c})
	add_text(ar, cp + Vector2(0, -70), String(kd["bless"]).to_upper(), col, 2.0, 15)
	feed.push_front({"t": t, "team": ar.team, "who": TEAM_NAMES[ar.team], "camp": reward, "kind": kind})
	ev("camp_cleared", ar, cp, {"team": ar.team, "gold": reward, "kind": kind, "ci": ci})


func upd_camp(ar, dt: float) -> void:
	for k in ar.bless.keys():
		if ar.bless[k] > 0:
			ar.bless[k] -= dt
	if mode == "tutorial" and not waves_on:
		return
	if not camp_on:
		return
	_camp_arrays(ar)
	var on := camp_kinds_on()
	for ci in CAMPS.size():
		if not on.has(String(CAMPS[ci]["kind"])):
			continue
		if not ar.camps_up[ci] and ar.camps_t[ci] < 0 and round_no >= int(camp_def(ci)["first"]):
			ar.camps_t[ci] = 0.0
		if ar.camps_t[ci] >= 0 and not ar.camps_up[ci]:
			ar.camps_t[ci] -= dt
			if ar.camps_t[ci] <= 0:
				spawn_camp(ar, ci)


# Whether any camp of this team is standing (HUD, bots, tutorial).
func any_camp_up(ar) -> bool:
	for u in ar.camps_up:
		if u:
			return true
	return false


# A camp monster's turn: the ranged kinds (golems, the wisp mother) stand and shoot while provoked (see the
# ranged block of upd_mon); the melee kinds (the pack, the wisps) charge the hero that struck them, hit like a
# lane monster and trot back to their spot in the clearing when the fight is over or strays too far.
func camp_act(ar, m, dt: float) -> void:
	if m.spd <= 0.0 or m.dps <= 0 or m.d.has("ranged"):
		return
	var c = m.aggro
	if c != null and (c.dead or (c is Champ and c.ar != ar) or m.provoked <= 0 or c.p.distance_to(m.camp_home) > CAMP_LEASH):
		m.aggro = null
		c = null
		if m.provoked > 0:
			m.provoked = 0.0   # the chase is over: the pack goes home and settles
	if c == null and m.provoked > 0:
		var bd := CAMP_CHASE
		if m.last != null and m.last is Champ and not m.last.dead and m.last.ar == ar and m.last.p.distance_to(m.camp_home) < bd:
			c = m.last
		else:
			for o in ar.champs:
				if o.dead:
					continue
				var od: float = o.p.distance_to(m.camp_home)
				if od < bd:
					bd = od
					c = o
		if c != null:
			m.aggro = c
			m.aggro_from = m.camp_home
	var sp: float = m.spd * m.haste * ((1.0 - m.slow) if m.slow_t > 0 else 1.0)
	if m.frenzy > 0:
		sp *= 1.0 + m.frenzy * (1.0 - m.hp / m.max_hp)
	if c == null:
		var hv: Vector2 = m.camp_home - m.p
		var hd := hv.length()
		if hd > 3.0:
			m.p += hv / hd * minf(hd, sp * dt)
			m.ang = lerp_angle(m.ang, hv.angle(), minf(1.0, dt * 8.0))
			if not m.fly:
				m.p = bridge_push(m.p, m.r)
		return
	var reach: float = m.r + c.r + 8.0
	var dv: Vector2 = c.p - m.p
	var d := dv.length()
	m.ang = lerp_angle(m.ang, dv.angle(), minf(1.0, dt * 10.0))
	if d > reach:
		m.p += dv / maxf(d, 0.001) * minf(d - reach + 1.0, sp * dt)
		if not m.fly:
			m.p = bridge_push(m.p, m.r)
		return
	if m.hit_cd <= 0:
		m.hit_cd = MON_HIT_EVERY / ((1.0 - m.unr_slow) if m.unr_t > 0.0 else 1.0)   # 0.27 Unravel slows its blows
		m.anim_t = 0.4
		var hd: float = m.dps * MON_HIT_EVERY * MON_HIT_K * wither_k(m)   # 0.36 Withering Curse
		hurt_champ(ar, c, hd, m)
		if m.d.has("drain"):
			m.hp = minf(m.max_hp, m.hp + hd * f(m.d, "drain"))
		if c.uniq.has("thorns") and not m.dead:
			hurt(ar, m, (hd * f(c.uniq["thorns"], "pct") + f(c.uniq["thorns"], "flat")) * lvl_mult(c), c, false, true)
		serp_hide(ar, c, m)   # 0.36 Stonescale Hide
		ev("mhit", ar, m.p, {"big": m.r >= 14})
		add_fx(ar, {"type": "slash", "p": m.p, "a": dv.angle(), "col": Color("#ff8a6a"), "t": 0.14, "dur": 0.14, "small": m.r < 11})


# ---------------------------------------------------------------- player commands
# Everything a human player does to the match goes through here, so in multiplayer every computer
# applies the same commands on the same tick. Targets travel as ["m", uid] or ["c", player id].
func ref_of(o) -> Array:
	if o is Mon:
		return ["m", o.uid]
	if o is Champ:
		return ["c", o.pl.id]
	return []


func resolve(r):
	if not (r is Array) or r.size() < 2 or not _is_int(r[1]):
		return null
	if r[0] == "c":
		var i := int(r[1])
		return players[i].champ if i >= 0 and i < players.size() else null
	var uid := int(r[1])
	for ar in arenas + [duel_ar]:
		for m in ar.mons:
			if m.uid == uid:
				return m
	return null


func apply_cmd(pid: int, k: String, a: Array):
	if pid < 0 or pid >= players.size():
		return "none"
	var pl = players[pid]
	var c = pl.champ
	tune_bind()
	if not _cmd_ok(k, a):
		return "none"
	if k == "tune":
		# 0.18.1 live balance: [name, value]; allowed at any time (a duel included), it is a referee's command
		return tune_cmd(String(a[0]), float(a[1]))
	# while a duel is on, only the two in the ring may act; everyone else watches
	if duel_on and not duel_pair.has(c) and not k in ["surrender", "drop", "rejoin", "auto", "ping"]:
		return "duel"
	if duel_on and duel_pair.has(c) and not k in ["order", "cast", "item", "potion", "surrender", "drop", "rejoin", "auto", "ping"]:
		return "duel"   # the duelists fight with what they brought: no shopping or sends mid-duel
	if duel_on and duel_pair.has(c) and duel_count > 0.0 and k in ["order", "cast", "item", "potion"]:
		return "countdown"   # hands off until the count reaches zero
	match k:
		"order":
			var tgt = resolve(a[2]) if a.size() > 2 else null
			if a.size() > 2 and not a[2].is_empty() and tgt == null:
				return false
			hero_order(c, String(a[0]), a[1] if a.size() > 1 else Vector2.ZERO, tgt)
			return true
		"cast":
			if not cult_confirm(c, int(a[0])):
				return false   # 0.34: Inevitable Demise with Undying Will down needs a second press
			return _in_duel_view(c, func(): return cast(c.ar, c, int(a[0]), a[1]))
		"send":
			return do_send(pl, int(a[0]), int(a[1]))
		"unsend":
			return unsend(pl, int(a[0]))
		"swap":
			return swap_items(c, int(a[0]), int(a[1]))
		"skip":
			return skip_cards()
		"build":
			return buy_building(pl, int(a[0]))
		"learn":
			return learn(c, int(a[0]))
		"sell":
			return sell_item(pl, int(a[0]))
		"potion":
			return use_potion(c)
		"buypot":
			return buy_potion(pl)
		"scroll":
			return buy_scroll(pl, String(a[0]))
		"buy":
			return buy_item(pl, String(a[0]))
		"core":
			return buy_core(pl, int(a[0]))
		"buyback":
			return buyback(pl)
		"vote":
			return vote_cmd(pl, int(a[0]) != 0)
		"command":
			return command(pl.team, String(a[0]), a[1])
		"ping":
			return ping_cmd(pl, String(a[0]), a[1], a[2] if a.size() > 2 and a[2] is Array else [], int(a[3]) if a.size() > 3 and _is_int(a[3]) else -1)
		"item":
			var res = _in_duel_view(c, func(): return use_item(c, int(a[0]), a[1]))
			return res
		"auto":
			c.auto_acq = bool(a[0])
			return true
		"boon":
			return pick_boon(int(a[0]))
		"card":
			return pick_card(int(a[0]))
		"reroll":
			return reroll_cards()
		"banish":
			return banish_card(int(a[0]))
		"surrender":
			if not over:
				arenas[pl.team].core_hp = 0
				over = true
				winner = 1 - pl.team
				surrender = true
			return true
		"drop":
			# a player left a multiplayer match: an AI takes over their hero
			pl.human = false
			pl.name += " (AI)"
			c.pow = DIFF_HERO[1]
			return true
		"rejoin":
			# 0.25: the player came back; the hero is theirs again
			pl.human = true
			pl.name = pl.name.trim_suffix(" (AI)")
			c.pow = 1.0
			return true
	return "none"


# A hero's own instant abilities and item actives look for targets in its arena's monster list. In the
# duel ring that list is only filled while the ring updates, so a command from a player (which arrives
# between updates) runs with the foe in view, exactly as the AI's casts do.
func _in_duel_view(c, fn: Callable):
	if duel_on and c.ar == duel_ar and duel_pair.size() == 2 and duel_ar.mons.is_empty():
		duel_ar.mons = [duel_pair[1] if duel_pair[0] == c else duel_pair[0]]
		var r = fn.call()
		duel_ar.mons = []
		return r
	return fn.call()


# Swaps two inventory slots (item levels are keyed by id, so nothing else changes). Returns true/false.
func swap_items(c, a: int, b: int) -> bool:
	if a < 0 or b < 0 or a >= GameData.INV_SLOTS or b >= GameData.INV_SLOTS or a == b:
		return false
	if a >= c.items.size() or b >= c.items.size():
		return false
	var tmp = c.items[a]
	c.items[a] = c.items[b]
	c.items[b] = tmp
	return true


# Commands can arrive over the network: check their shape before touching the match.
static func _is_int(v) -> bool:
	return v is int or v is float or v is bool


static func _idx_ok(v, n: int) -> bool:
	return _is_int(v) and int(v) >= 0 and int(v) < n


func _cmd_ok(k: String, a: Array) -> bool:
	var need := {"banish": 1, "order": 1, "cast": 2, "send": 2, "build": 1, "learn": 1, "sell": 1, "scroll": 1, "buy": 1, "core": 1, "command": 2, "ping": 2, "item": 2, "auto": 1,
		"boon": 1, "card": 1, "unsend": 1, "swap": 2, "skip": 0, "potion": 0, "buypot": 0, "buyback": 0, "reroll": 0, "surrender": 0, "drop": 0, "rejoin": 0, "vote": 1, "tune": 2}
	if a.size() < int(need.get(k, 0)):
		return false
	match k:
		"tune":
			return a[0] is String and Tune.DEFS.has(String(a[0])) and (a[1] is float or a[1] is int)
		"cast", "learn":
			return _idx_ok(a[0], 4) and (k == "learn" or a[1] is Vector2)
		"send":
			return _idx_ok(a[0], GameData.SENDS.size()) and _idx_ok(a[1], 2)
		"unsend":
			return _idx_ok(a[0], 2)
		"build":
			return _idx_ok(a[0], GameData.BUILDINGS.size())
		"core":
			return _idx_ok(a[0], GameData.CORE_UPS.size())
		"sell", "item":
			return _idx_ok(a[0], GameData.INV_SLOTS) and (k == "sell" or a[1] is Vector2)
		"swap":
			return _idx_ok(a[0], GameData.INV_SLOTS) and _idx_ok(a[1], GameData.INV_SLOTS)
		"order":
			return a[0] is String and String(a[0]) in ["move", "amove", "attack", "stop", "hold"] and (a.size() < 2 or a[1] is Vector2) and (a.size() < 3 or a[2] is Array)
		"command":
			return a[0] is String and String(a[0]) in ["help", "boss", "crystal", "lanes"] and a[1] is Vector2
		"ping":
			return a[0] is String and String(a[0]) in PING_KINDS and a[1] is Vector2 and (a.size() < 3 or (a[2] is Array and a[2].size() <= 2)) and (a.size() < 4 or _is_int(a[3]))
		"boon", "card", "banish":
			return _idx_ok(a[0], SurvivalData.OFFER_SIZE + 1)
		"buy":
			return a[0] is String and not GameData.item(String(a[0])).is_empty()
		"scroll":
			return a[0] is String and not GameData.scroll(String(a[0])).is_empty()
		"auto", "vote":
			return a[0] is bool or _is_int(a[0])
	return true


# A fingerprint of the match state; multiplayer peers compare it to catch desyncs.
func checksum() -> int:
	var h := 0.0
	h += float(round_no) * 7.0 + float(next_uid) * 13.0 + float(Tune.hash_of(tune) % 100000) * 0.37
	for pl in players:
		h += pl.gold * 1.3 + float(pl.income) * 3.1 + float(pl.tech) * 5.7
		var c = pl.champ
		h += c.hp * 0.7 + c.p.x * 0.11 + c.p.y * 0.13 + float(c.lvl) * 2.0
	for ar in arenas:
		h += ar.core_hp * 0.9 + float(ar.mons.size()) * 17.0 + float(ar.sums.size()) * 11.0
		for su in ar.sums:
			h += su.hp * 0.01 + su.p.x * 0.002
		for m in ar.mons:
			h += m.hp * 0.01 + m.p.x * 0.003 + m.p.y * 0.005
	return int(h * 1000.0) ^ int(rng.state & 0xffffffff)


# ---------------------------------------------------------------- 0.49 contests
# Every few rounds of a two-team match a contest comes up in both arenas at once, the same thing on both sides:
# a Titan to topple, two shrines to hold, gilded runners to catch, or three lanterns to light in the dark. The
# teams never meet, so it's a race: the first team to finish takes the contest's blessing and the big purse; the
# other team still gets half the purse if it finishes before the time runs out. Which contests come up, and in
# which order, is drawn from the match seed (every computer and every replay sees the same ones).
const CONTESTS := {
	"titan": {"name": "Titan's Wake", "col": "#f0c060", "bless": "Titan's Might", "buff": {"dmg": 1.15, "regen_add": 8.0},
		"short": "+15% damage and regeneration", "desc": "A pit titan wakes beside the road. Topple it before the other team topples theirs."},
	"shrines": {"name": "Shrines of the Confluence", "col": "#7ab8ff", "bless": "Shrine's Grace", "buff": {"cdr_add": 0.1, "ms": 1.08},
		"short": "10% cooldown reduction, 8% move speed, and the crystal heals 10%", "desc": "Two shrines rise beside the roads. Stand on each until it is yours (the more heroes, the faster)."},
	"runner": {"name": "The Gilded Runners", "col": "#ffd24a", "bless": "Runner's Luck", "buff": {"ms": 1.12, "as": 1.1},
		"short": "+12% move speed and attack speed +10%", "desc": "Kobolds with sacks of gold dash down both roads for the castle. Catch three of the four: each pays its own gold."},
	"lanterns": {"name": "Lantern Night", "col": "#ffb060", "bless": "Lanternlight", "buff": {"as": 1.15, "lsp": 0.06},
		"short": "+15% attack speed and 6% life steal", "desc": "Night falls on the roads. Light the three lanterns (stand by each; monsters near it slow the flame) before the other team lights theirs."},
}
const CONTEST_ORDER := ["titan", "shrines", "runner", "lanterns"]
const CONTEST_FIRST := 6        # the first contest's round
const CONTEST_EVERY := 7        # then every this many rounds, while before the endgame
const CONTEST_LEN := 75.0       # seconds to finish
const CONTEST_BLESS := 90.0
const CONTEST_PT_R := 120.0     # stand this close to a shrine or lantern
const SHRINE_SECS := 8.0        # one hero holding a shrine takes this long (more heroes go faster)
const LANTERN_SECS := 9.0     # 0.49.1: was 6 (bots lit all three in ~10 s)
const RUNNERS_PER_LANE := 2
var ai_smart := [true, true]    # 0.49 smarter bots per team (tests turn one side off to compare)
var highlights: Array = []      # 0.49 end-of-match highlights: {"tick", "k" (boss, duel, contest, low), "pid", "team", ...}
var core_low := [1.0, 1.0]      # 0.49: the lowest each crystal fell to (fraction)
var core_low_tick := [0, 0]
var contests_on := false
var contest_plan: Array = []    # contest kinds in the order they come up
var contest := {}               # the one under way: {"kind", "n", "t", "round", "first"}; {} when none
var contest_log: Array = []     # finished contests: {"kind", "round", "first", "done": [secs or -1, secs or -1]}
var _contest_init := false
var _contest_seen_round := -1


func contest_setup() -> void:
	_contest_init = true
	contests_on = mode in ["classic", "quick"] and cfg.is_empty() and enemy_present and mk("contests", 1.0) > 0.0
	if not contests_on:
		return
	var crng := RandomNumberGenerator.new()
	crng.seed = rng.seed ^ 0x3c6ef372
	var pool: Array = CONTEST_ORDER.duplicate()
	for i in range(pool.size() - 1, 0, -1):
		var j := crng.randi_range(0, i)
		var tmp = pool[i]
		pool[i] = pool[j]
		pool[j] = tmp
	contest_plan = []
	var r := CONTEST_FIRST
	var k := 0
	while r < endgame_from:
		contest_plan.append(pool[k % pool.size()])
		k += 1
		r += CONTEST_EVERY


# The round the n-th contest (0-based) starts at.
static func contest_round(n: int) -> int:
	return CONTEST_FIRST + n * CONTEST_EVERY


# The next contest still to come, as {"kind", "round"}, or {}.
func contest_next() -> Dictionary:
	if not contests_on:
		return {}
	for n in contest_plan.size():
		var r := contest_round(n)
		if r > round_no or (r == round_no and contest.is_empty() and not _contest_ran(n)):
			return {"kind": contest_plan[n], "round": r, "n": n}
	return {}


func _contest_ran(n: int) -> bool:
	for e in contest_log:
		if int(e.get("n", -1)) == n:
			return true
	return false


# A spot beside lane `lane`, `frac` of the way from the rift to the crystal: as far off the centre line as a hero
# can still stand, clear of the castle, the Armory and the camps. Same spot in both arenas.
static func contest_spot(lane: int, frac: float) -> Vector2:
	ensure_lanes()
	var geo: Dictionary = _lanes[lane]
	var pts: PackedVector2Array = geo["pts"]
	var cum: PackedFloat32Array = geo["cum"]
	var norms: PackedVector2Array = geo["norms"]
	var want: float = cum[cum.size() - 1] * frac
	var best := Vector2.ZERO
	for step_i in 12:
		# walk forward a little from the wanted spot until a clear one turns up
		var at := want + step_i * 60.0
		var i := 1
		while i < cum.size() - 1 and cum[i] < at:
			i += 1
		var base: Vector2 = pts[i]
		for lat in [120.0, 96.0, 72.0, 44.0]:
			for side in [1.0, -1.0]:
				var q: Vector2 = base + norms[i] * lat * side
				if not walkable(q) or q.distance_to(CORE) < CASTLE_R + 260.0 or q.distance_to(SHOP) < 380.0:
					continue
				var near_camp := false
				for cp in CAMPS:
					if q.distance_to(cp["pos"]) < 300.0:
						near_camp = true
				if near_camp:
					continue
				return q
		if best == Vector2.ZERO:
			best = base
	return best


# Where a contest puts its things (lane, fraction of the road).
const CONTEST_SPOTS := {
	"titan": [[0, 0.6]],
	"shrines": [[0, 0.42], [1, 0.42]],
	"lanterns": [[0, 0.24], [1, 0.46], [0, 0.72]],
}


static func contest_points(kind: String) -> Array:
	var out: Array = []
	for sp in CONTEST_SPOTS.get(kind, []):
		out.append(contest_spot(int(sp[0]), float(sp[1])))
	return out


func contest_gold() -> int:
	return roundi((120 + 12 * round_no) * mk("contest_gold_k"))


# Once a step (not during duels): starts the contest due this round, counts down the one under way.
func upd_contest(dt: float) -> void:
	if not _contest_init:
		contest_setup()
	if not contests_on:
		return
	if round_no != _contest_seen_round:
		_contest_seen_round = round_no
		for n in contest_plan.size():
			if contest_round(n) == round_no and contest.is_empty() and not _contest_ran(n):
				contest_start(n)
			elif contest_round(n) == round_no + 1:
				var kd: Dictionary = CONTESTS[contest_plan[n]]
				ev("contest_soon", null, Vector2.ZERO, {"kind": contest_plan[n], "name": kd["name"], "round": round_no + 1})
	if contest.is_empty():
		return
	contest["t"] = float(contest["t"]) - dt
	var finished: bool = arenas[0].cdone >= 0.0 and arenas[1].cdone >= 0.0
	if float(contest["t"]) <= 0.0 or finished:
		contest_end()


func contest_start(n: int) -> void:
	var kind: String = contest_plan[n]
	contest = {"kind": kind, "n": n, "t": CONTEST_LEN, "round": round_no, "first": -1}
	var pts := contest_points(kind)
	# health grows with the round, but gently past round 20 (the late curve is for waves, and the window is short)
	var hm := hp_mult(mini(round_no, 20)) * (1.0 + 0.04 * maxi(0, round_no - 20)) * (0.4 + 0.15 * team_size)
	for ar in arenas:
		ar.cpts = []
		ar.cdone = -1.0
		ar.crun = [0, 0, 0, 0]
		match kind:
			"titan":
				var m := spawn_mon(ar, "contest_titan", 0, null, hm)
				m.p = pts[0]
				m.wi = 0
				m.camp_home = pts[0]
				m.obj = "titan"
			"shrines", "lanterns":
				for q in pts:
					ar.cpts.append({"p": q, "prog": 0.0, "done": false})
			"runner":
				var k := 0
				for lane in 2:
					for i in RUNNERS_PER_LANE:
						_contest_runner(ar, lane, hm * 1.0, i)
						k += 1
				ar.crun[2] = k
				ar.crun[3] = maxi(1, k - 1)
	ev("contest_start", null, Vector2.ZERO, {"kind": kind, "name": CONTESTS[kind]["name"], "t": CONTEST_LEN, "round": round_no})


func _contest_runner(ar, lane: int, hm: float, k: int):
	var m := spawn_mon(ar, "contest_runner", lane, null, hm)
	m.obj = "runner"
	m.p += (m.path[0] - m.path[1]).normalized() * k * 34.0   # one behind the other at the rift
	return m


# A team finished its side of the contest.
func contest_team_done(ar) -> void:
	if contest.is_empty() or ar.cdone >= 0.0:
		return
	var kind: String = contest["kind"]
	var kd: Dictionary = CONTESTS[kind]
	ar.cdone = CONTEST_LEN - float(contest["t"])
	var first: bool = int(contest["first"]) < 0
	var g := contest_gold() if first else roundi(contest_gold() * 0.5)
	if first:
		contest["first"] = ar.team
		ar.bless["contest"] = CONTEST_BLESS
		if kind == "shrines":
			ar.core_hp = minf(ar.core_max, ar.core_hp + ar.core_max * 0.1)
	var col := Color(String(kd["col"]))
	for c in ar.champs:
		if c.pl.team != ar.team:
			continue
		give_gold(c.pl, g)
		if first:
			c.buffs = c.buffs.filter(func(b): return String(b.get("bless", "")) != "contest")
			var b: Dictionary = (kd["buff"] as Dictionary).duplicate()
			b["t"] = CONTEST_BLESS
			b["bless"] = "contest"
			c.buffs.append(b)
			if not c.dead:
				add_fx(ar, {"type": "ring", "p": c.p, "r": 48.0, "col": col, "t": 0.9, "dur": 0.9, "follow": c})
	feed.push_front({"t": t, "team": ar.team, "who": TEAM_NAMES[ar.team], "contest": kind, "first": first, "gold": g})
	if first:
		highlights.append({"tick": tick, "k": "contest", "pid": -1, "team": ar.team, "name": String(kd["name"]), "secs": ar.cdone, "round": round_no})
	ev("contest_done", ar, CORE, {"team": ar.team, "kind": kind, "first": first, "gold": g, "secs": ar.cdone})


func contest_end() -> void:
	var kind: String = contest["kind"]
	for ar in arenas:
		for m in ar.mons:
			if m.obj != "" and not m.dead:
				m.dead = true
				burst(ar, m.p, mon_color(m), 14, 120)
		ar.cpts = []
	contest_log.append({"kind": kind, "n": contest["n"], "round": contest["round"], "first": contest["first"], "done": [arenas[0].cdone, arenas[1].cdone],
		"caught": [arenas[0].crun[0], arenas[1].crun[0]]})
	ev("contest_end", null, Vector2.ZERO, {"kind": kind, "first": contest["first"]})
	contest = {}


# Shrines and lanterns fill while heroes stand by them; runners that reach the castle get away.
func upd_contest_arena(ar, dt: float) -> void:
	if contest.is_empty() or ar.duel:
		return
	var kind: String = contest["kind"]
	if kind == "shrines" or kind == "lanterns":
		var all_done: bool = not ar.cpts.is_empty()
		for pt in ar.cpts:
			if pt["done"]:
				continue
			var n := 0
			for c in ar.champs:
				if not c.dead and c.pl.team == ar.team and c.p.distance_to(pt["p"]) < CONTEST_PT_R:
					n += 1
			var secs := SHRINE_SECS if kind == "shrines" else LANTERN_SECS
			var rate := 1.0
			if n > 0 and kind == "lanterns":
				# 0.49.1: a lantern catches slowly while monsters crowd it: clear them and it lights three times faster
				for m in ar.mons:
					if not m.dead and m.obj == "" and not m.d.get("camp", false) and m.p.distance_to(pt["p"]) < CONTEST_PT_R + 20.0:
						rate = 0.3
						break
			if n > 0:
				pt["prog"] = minf(1.0, float(pt["prog"]) + dt / secs * (1.0 + 0.35 * (n - 1)) * rate)
			elif kind == "shrines":
				pt["prog"] = maxf(0.0, float(pt["prog"]) - dt / 30.0)
			if float(pt["prog"]) >= 1.0:
				pt["done"] = true
				ev("contest_point", ar, pt["p"], {"team": ar.team, "kind": kind})
				add_text(ar, pt["p"] + Vector2(0, -60), ("SHRINE TAKEN" if kind == "shrines" else "LIT"), Color(String(CONTESTS[kind]["col"])), 1.6, 14)
			else:
				all_done = false
		if all_done and ar.cdone < 0.0:
			contest_team_done(ar)
	elif kind == "runner":
		for m in ar.mons:
			if m.obj == "runner" and not m.dead and m.p.distance_to(CORE) < DEF_R + 80.0:
				m.dead = true   # got away: no bounty, no leak
				ar.crun[1] += 1
				ev("contest_escape", ar, m.p, {"team": ar.team})
				add_text(ar, m.p + Vector2(0, -40), "GOT AWAY", Color("#c8a040"), 1.2, 12)


func contest_kill(ar, m) -> void:
	if contest.is_empty():
		return
	match m.obj:
		"titan":
			contest_team_done(ar)
		"runner":
			ar.crun[0] += 1
			var g := roundi(contest_gold() * 0.15)
			var by = m.last.pl if m.last != null and m.last.get("pl") != null else null
			for c in ar.champs:
				if c.pl.team == ar.team:
					give_gold(c.pl, g if c.pl == by else roundi(g * 0.4))
			add_text(ar, m.p + Vector2(0, -40), "+%d" % g, Color("#ffd24a"), 1.2, 13)
			if ar.crun[0] >= ar.crun[3]:
				contest_team_done(ar)


# Contest view helpers (HUD, bots): this arena's progress as 0..1.
func contest_progress(ar) -> float:
	if contest.is_empty():
		return 0.0
	if ar.cdone >= 0.0:
		return 1.0
	match String(contest["kind"]):
		"titan":
			for m in ar.mons:
				if m.obj == "titan" and not m.dead:
					return 1.0 - m.hp / maxf(1.0, m.max_hp)
			return 0.0
		"runner":
			return float(ar.crun[0]) / maxf(1.0, float(ar.crun[3]))
		_:
			var s := 0.0
			for pt in ar.cpts:
				s += float(pt["prog"])
			return s / maxf(1.0, float(ar.cpts.size()))
	return 0.0



# 0.49: where a bot should be for the contest, or null. Titan: every healthy bot whose road is quiet enough.
# Shrines and lanterns: each unfinished one gets the nearest healthy bot of the team (worked out the same way by
# every bot, so they split up instead of all walking to the same shrine). Runners are chased as targets instead.
func ai_contest_spot(c):
	if contest.is_empty():
		return null
	var ar = arenas[c.pl.team]
	if ar.cdone >= 0.0 or c.hp < c.max_hp * 0.4 or c.retreat:
		return null
	var threats := 0
	for m in ar.mons:
		if not m.dead and m.obj == "" and not m.d.get("camp", false) and m.p.distance_to(HOMES[c.home]) < 800.0:
			threats += 1
	if threats >= 12:
		return null   # the road is being overrun: hold it
	var kind := String(contest["kind"])
	var free: Array = []
	for o in ar.champs:
		if o.pl.team == ar.team and not o.pl.human and not o.dead and not o.retreat and o.hp >= o.max_hp * 0.4 and o.pl.diff >= 1 and not ar.def_who.has(o):
			free.append(o)
	match kind:
		"titan":
			var tm = null
			for m in ar.mons:
				if m.obj == "titan" and not m.dead:
					tm = m
			if tm == null:
				return null
			# the three nearest bots go (a human on the team counts as one of them)
			var need := 3 if team_size >= 3 else team_size
			for o in ar.champs:
				if o.pl.human and o.pl.team == ar.team and not o.dead and o.p.distance_to(tm.p) < 700.0:
					need -= 1
			free.sort_custom(func(a, b): return a.p.distance_to(tm.p) < b.p.distance_to(tm.p) or (a.p.distance_to(tm.p) == b.p.distance_to(tm.p) and a.pl.id < b.pl.id))
			var k := free.find(c)
			if k >= 0 and k < need:
				return walk_clamp(tm.p)
		"shrines", "lanterns":
			var taken := {}
			for pt in ar.cpts:
				if pt["done"]:
					continue
				var best = null
				var bd := INF
				for o in free:
					if taken.has(o):
						continue
					var d: float = o.p.distance_to(pt["p"])
					if d < bd:
						bd = d
						best = o
				if best == null:
					break
				taken[best] = true
				if best == c:
					return pt["p"]
	return null



# 0.49: the monster position in reach of `from` with the most others within r of it: [position, count].
func ai_cluster(live: Array, from: Vector2, reach: float, r: float) -> Array:
	var best_p := from
	var best_n := 0
	var r2 := r * r
	var near: Array = []
	for m in live:
		if m.p.distance_squared_to(from) < reach * reach:
			near.append(m)
	for m in near:
		var n := 0
		var sum := Vector2.ZERO
		for o in near:
			if o.p.distance_squared_to(m.p) < r2:
				n += 1
				sum += o.p
		if n > best_n:
			best_n = n
			best_p = sum / float(n)
	return [best_p, best_n]


# 0.49: a boss on the team's own road draws the two nearest healthy bots (not those holding a contest spot), so it
# meets a fight instead of one defender at a time down the road.
func ai_boss_spot(c):
	var ar = arenas[c.pl.team]
	var b = ar.boss
	if b == null or b.dead or c.hp < c.max_hp * 0.5 or c.retreat or c.ar != ar:
		return null
	# only a boss that has got past this bot's own post: it chases it down toward the crystal (a post is not left
	# open for a boss that the posts further on will meet anyway)
	if progress(b) < _post_progress(c.home) + 200.0:
		return null
	var threats := 0
	for m in ar.mons:
		if not m.dead and m.obj == "" and not m.d.get("camp", false) and not m.d.get("boss", false) and m.p.distance_to(HOMES[c.home]) < 800.0:
			threats += 1
	if threats >= 4:
		return null
	var free: Array = []
	for o in ar.champs:
		if o.pl.team == ar.team and not o.pl.human and not o.dead and not o.retreat and o.hp >= o.max_hp * 0.5 and o.pl.diff >= 1 and not ar.def_who.has(o) and not o.ai_hold:
			free.append(o)
	free.sort_custom(func(x, y): return x.p.distance_to(b.p) < y.p.distance_to(b.p) or (x.p.distance_to(b.p) == y.p.distance_to(b.p) and x.pl.id < y.pl.id))
	var k := free.find(c)
	if k >= 0 and k < 2 and c.p.distance_to(b.p) < 1800.0:
		return walk_clamp(b.p)
	return null


# How far down the road (as progress) a defender post sits: the nearest point of either lane to it.
func _post_progress(home: int) -> float:
	ensure_lanes()
	var hp: Vector2 = HOMES[home]
	var best := INF
	var at := 0.0
	for lane in 2:
		var pts: PackedVector2Array = _lanes[lane]["pts"]
		var cum: PackedFloat32Array = _lanes[lane]["cum"]
		for i in range(0, pts.size(), 3):
			var d := pts[i].distance_to(hp)
			if d < best:
				best = d
				at = cum[i]
	return at


# 0.49 highlights: kill bursts per hero (most kills inside BURST_T seconds) and how low each crystal fell.
const BURST_T := 4.0


func _hl_kill(pl) -> void:
	pl.kt.append(t)
	while not pl.kt.is_empty() and t - float(pl.kt[0]) > BURST_T:
		pl.kt.pop_front()
	if pl.kt.size() > pl.burst_best:
		pl.burst_best = pl.kt.size()
		pl.burst_tick = tick


func _hl_core() -> void:
	for ti in 2:
		var fr: float = arenas[ti].core_hp / maxf(1.0, arenas[ti].core_max)
		if fr < core_low[ti]:
			core_low[ti] = fr
			core_low_tick[ti] = tick
␀␀␀# Loads the pre-rendered sprite sheets and works out frames and scales.
# Unit sheets: one column per facing direction (16), one row per pose. Prop sheets: a single frame.
class_name Sprites
extends RefCounted

const HERO_UNIT := 30.0            # world units per model unit for heroes
const MON_K := 1.6                 # monster scale: world units per model unit = r * MON_K / foot_r
const WALK := [1, 0, 2, 0]         # walk cycle over the three poses
const FLAP := [0, 1, 2, 1]         # wing-flap cycle
const PROP_UNITS := {"castle_ward": 56.0, "castle_ember": 56.0, "crystal_ward": 40.0, "crystal_ember": 40.0,
	"shop": 46.0, "bld_warren": 34.0, "bld_lodge": 34.0, "bld_quarry": 34.0, "bld_gate": 34.0, "bld_spire": 34.0, "bld_void": 34.0}

static var _cache := {}


static func meta(name: String) -> Dictionary:
	return SpriteMeta.SHEETS.get(name, {})


static func tex(name: String) -> Texture2D:
	if _cache.has(name):
		return _cache[name]
	var t: Texture2D = null
	var m := meta(name)
	if not m.is_empty():
		var path := "res://art/%s/%s.png" % ["units" if int(m["dirs"]) > 1 else "props", name]
		if ResourceLoader.exists(path):
			t = load(path)
	_cache[name] = t
	return t


static func dir_index(ang: float, dirs := 16) -> int:
	return int(round(wrapf(ang, 0.0, TAU) / (TAU / dirs))) % dirs


# anim: seconds left of an attack / cast animation (wind-up for the first part, then the strike)
static func pose_at(name: String, t: float, phase: float, moving: bool, anim := 0.0, anim_len := 0.4) -> int:
	var m := meta(name)
	if m.is_empty() or int(m["poses"]) < 3:
		return 0
	if anim > 0.0 and int(m["poses"]) >= 5:
		return 3 if anim > anim_len * 0.45 else 4
	if m["anim"] == "fly":
		return FLAP[int(t * 8.0 + phase) % 4]
	if not moving:
		return 0
	return WALK[int(t * 7.0 + phase) % 4]


static func region(name: String, ang: float, pose: int) -> Rect2:
	var m := meta(name)
	var fr := float(m["frame"])
	var d := dir_index(ang, int(m["dirs"])) if int(m["dirs"]) > 1 else 0
	return Rect2(d * fr, mini(pose, int(m["poses"]) - 1) * fr, fr, fr)


# Sets up a Sprite2D so that its position is the model's ground point and one model unit = `unit` world units.
static func setup(sp: Sprite2D, name: String, unit: float) -> bool:
	var t := tex(name)
	if t == null:
		return false
	var m := meta(name)
	var fr := float(m["frame"])
	sp.texture = t
	sp.centered = false
	sp.region_enabled = int(m["dirs"]) > 1 or int(m["poses"]) > 1
	if sp.region_enabled:
		sp.region_rect = Rect2(0, 0, fr, fr)
	sp.offset = Vector2(-fr / 2.0, -fr * float(m["foot"]))
	var k := float(m["span"]) * unit / fr
	sp.scale = Vector2(k, k)
	return true


static func mon_sheet(kind: String) -> String:
	var d: Dictionary = GameData.MON.get(kind, {})
	if d.has("sheet"):
		return d["sheet"]
	return kind if kind.begins_with("boss_") else "mon_" + kind


# Display size rules, on the model's real bounding box in world units (a hero is ~75 tall, ~55 wide). Hitboxes (r) are untouched, this is only the model scale.
const BOSS_K := 1.2               # bosses draw 20% larger than the r rule ...
const BOSS_MIN := 200.0           # ... and their largest dimension is at least this (above every non-boss) ...
const BOSS_MAX := 300.0           # ... and at most this
const MON_MAX := 170.0            # tier-6 monsters stay well below the bosses
const MON_MIN := 32.0             # spiderlings and slimelets stay readable
const FLY_CAP0 := 45.0            # a flyer's wingspan is capped at FLY_CAP0 + FLY_CAP_R * r
const FLY_CAP_R := 3.4
static var _unit_cache := {}


static func monster_unit(kind: String, r: float) -> float:
	var ck := "%s:%s" % [kind, r]
	if _unit_cache.has(ck):
		return _unit_cache[ck]
	var sh := mon_sheet(kind)
	var m := meta(sh)
	var u := r * MON_K / float(m.get("foot_r", 0.5))
	var d: Dictionary = GameData.MON.get(kind, {})
	var e := Models3D.extent(sh)
	var wide := maxf(e.x, e.z)
	var big := maxf(wide, e.y)
	if big > 0.0:
		if d.get("boss", false):
			u *= BOSS_K
			u *= clampf(big * u, BOSS_MIN, BOSS_MAX) / (big * u)
		else:
			var cap := FLY_CAP0 + FLY_CAP_R * r
			if d.get("fly", false) and wide * u > cap:
				u *= cap / (wide * u)
			if big * u > MON_MAX:
				u *= MON_MAX / (big * u)
			elif big * u < MON_MIN and float(d.get("spd", 0.0)) > 0.0:
				u *= MON_MIN / (big * u)
	_unit_cache[ck] = u
	return u


# Draws a frame scaled to fit a rectangle (for portraits and buttons).
static func draw_fit(ci: CanvasItem, name: String, r: Rect2, dir := 3, pose := 0, zoom := 1.0, modulate := Color.WHITE) -> bool:
	var t := tex(name)
	if t == null:
		return false
	var m := meta(name)
	var fr := float(m["frame"])
	var d := dir if int(m["dirs"]) > 1 else 0
	var sz := minf(r.size.x, r.size.y) * zoom
	var dst := Rect2(r.get_center() - Vector2(sz, sz) / 2.0, Vector2(sz, sz))
	ci.draw_texture_rect_region(t, dst, Rect2(d * fr, mini(pose, int(m["poses"]) - 1) * fr, fr, fr), modulate)
	return true


# Head-and-shoulders portrait strips (tools/rebake_sprites.gd --portraits): 5 frames for sheet directions 1..5.
# portrait_dir can point at a scratch folder (absolute path) to preview a new bake without installing it.
static var portrait_dir := "res://art/ui/portraits/"
const PORTRAIT_DIRS := 5


static func portrait_tex(name: String) -> Texture2D:
	var ck := "portrait|" + portrait_dir + name
	if _cache.has(ck):
		return _cache[ck]
	var t: Texture2D = null
	var path := portrait_dir + name + ".png"
	if path.begins_with("res://"):
		if ResourceLoader.exists(path):
			t = load(path)
	elif FileAccess.file_exists(path):
		var img := Image.load_from_file(path)
		if img != null:
			t = ImageTexture.create_from_image(img)
	_cache[ck] = t
	return t


# Draws a hero's head and shoulders filling a rectangle (portraits). head_h: head height in model units.
# Uses the dedicated portrait strip when there is one; otherwise crops the unit sheet (old top-down framing).
static func draw_bust(ci: CanvasItem, name: String, r: Rect2, dir := 3, zoom := 2.1, head_h := 1.55, modulate := Color.WHITE) -> bool:
	var pt := portrait_tex(name)
	if pt != null:
		var pf := float(pt.get_height())
		var col := clampi(dir - 1, 0, PORTRAIT_DIRS - 1)
		ci.draw_texture_rect_region(pt, r, Rect2(col * pf, 0, pf, pf), modulate)
		return true
	var t := tex(name)
	if t == null:
		return false
	var m := meta(name)
	var fr := float(m["frame"])
	var src_sz := fr / zoom
	var head_y := fr * float(m["foot"]) - head_h * cos(deg_to_rad(52.0)) / float(m["span"]) * fr
	var top := clampf(head_y - src_sz * 0.42, 0.0, fr - src_sz)
	var src := Rect2(dir * fr + fr / 2.0 - src_sz / 2.0, top, src_sz, src_sz)
	ci.draw_texture_rect_region(t, r, src, modulate)
	return true
