	income_lbl.text = "+%d" % me.income
	var nxt: int = sim.interest_for(me)
	interest_lbl.text = "interest +%d" % nxt if nxt > 0 else ""
	var ma = sim.arenas[myt()]
	var ea = sim.arenas[1 - myt()]
	lives_a_lbl.text = "%d%%" % ceili(ma.core_hp / ma.core_max * 100.0)
	lives_b_lbl.text = "%d%%" % ceili(ea.core_hp / ea.core_max * 100.0) if sim.mode != "survival" else "—"
	enemy_count_lbl.text = str(ea.mons.size())
