const SCROLL_STEP2 := 1      # ...plus this much times the rank squared (0.15: 12/8 -> 25/1, so the 10th rank costs ~450 instead of ~1000 and scrolls stay a late sink)
const SCROLL_STEP_SURV := 12   # Survival keeps its own curve
const SCROLL_STEP2_SURV := 8


static func scroll(id: String) -> Dictionary:
	for sc in SCROLLS:
		if sc["id"] == id:
			return sc
	return {}
␀␀␀␀␀␀␀␀␀# 0.17: hover helpers that need the HUD (main.gd) — kept here so main.gd only gains one-line hooks.
# Send buttons: while one is hovered, the "Sends go through" choice the send would use lights up and the
# matching rift entrance pulses on the enemy half of the minimap (UIParts.Minimap.hint_lane).
class_name HoverUI
extends RefCounted


static func send_enter(main) -> void:
	if main.sim == null or main.minimap == null or not Settings.hover_hl:
		return
	if main.sim.mode == "survival":
		return
	var lane: int = main.lane_mode
	if lane == 2:
		lane = main.lane_alt
	main.minimap.hint_lane(lane, 1 - main.myt())
	for b in main.lane_btns:
		_glow(b, int(b.get_meta("mode", -1)) == main.lane_mode)


static func send_exit(main) -> void:
	if main.minimap != null:
		main.minimap.hint_clear()
	for b in main.lane_btns:
		_glow(b, false)


static func _glow(b: Control, on: bool) -> void:
	if not is_instance_valid(b):
		return
	var want := Color(1.45, 1.4, 1.15) if on else Color.WHITE
	if b.modulate == want:
		return
	if Settings.reduce_motion:   # 0.43: Reduce motion: no fade
		b.modulate = want
		return
	var tw := b.create_tween()
	tw.tween_property(b, "modulate", want, 0.08)
# 0.40: the MANiC Entertainment studio intro (art/intro/manic_intro.ogv, made by the user's team) before the main menu.
# Any key, click or controller button skips it; Settings > Display > Studio intro turns it off. Not played in tests
# (main isn't the current scene there), headless runs, or with --no-intro.
class_name Intro
extends CanvasLayer

signal done

const VIDEO := "res://art/intro/manic_intro.ogv"
var player: VideoStreamPlayer
var shade: ColorRect
var _ending := false
var _age := 0.0


static func should_play(main: Node) -> bool:
	if not Settings.play_intro or DisplayServer.get_name() == "headless":
		return false
	if main.get_tree().current_scene != main or "--no-intro" in OS.get_cmdline_user_args():
		return false
	return ResourceLoader.exists(VIDEO)


func _ready() -> void:
	layer = 200
	process_mode = Node.PROCESS_MODE_ALWAYS
	shade = ColorRect.new()
	shade.color = Color.BLACK
	shade.set_anchors_preset(Control.PRESET_FULL_RECT)
	shade.mouse_filter = Control.MOUSE_FILTER_STOP
	add_child(shade)
	player = VideoStreamPlayer.new()
	player.stream = load(VIDEO)
	player.expand = true
	player.set_anchors_preset(Control.PRESET_FULL_RECT)
	player.mouse_filter = Control.MOUSE_FILTER_IGNORE
	player.bus = "Music" if AudioServer.get_bus_index("Music") >= 0 else "Master"
	shade.add_child(player)
	get_viewport().size_changed.connect(_fit)
	_fit()
	player.finished.connect(finish)
	player.play()


# keep 16:9 inside any window (letterbox on the black shade)
func _fit() -> void:
	var vp := get_viewport().get_visible_rect().size
	var w := minf(vp.x, vp.y * 16.0 / 9.0)
	var h := w * 9.0 / 16.0
	player.set_anchors_preset(Control.PRESET_TOP_LEFT)
	player.position = (vp - Vector2(w, h)) / 2.0
	player.size = Vector2(w, h)


func _process(delta: float) -> void:
	_age += delta
	if _age > 15.0:   # a broken decoder must never trap the player on a black screen
		finish()


func _input(ev: InputEvent) -> void:
	if _ending or _age < 0.3:
		return
	var skip: bool = (ev is InputEventKey and ev.pressed and not ev.echo) or (ev is InputEventMouseButton and ev.pressed) \
		or (ev is InputEventJoypadButton and ev.pressed)
	if skip:
		get_viewport().set_input_as_handled()
		finish()


func finish() -> void:
	if _ending:
		return
	_ending = true
	var tw := create_tween()
	tw.tween_property(player, "volume_db", -40.0, 0.35)
	tw.parallel().tween_property(shade, "modulate:a", 0.0, 0.45)
	tw.tween_callback(func():
		player.stop()
		done.emit()
		queue_free())
␀␀␀␀␀␀␀# Combat feel, all on the render side: hit-stop (a visual freeze of the units), camera shake on a trauma
# model, pooled floating damage numbers, death pops for units that leave the field, per-unit hit flashes.
# Owned by ArenaView; it reads the simulation and never writes it, so lockstep clients may differ freely
# in what they show here. Fed by Main's event dispatch ("hit", "mdie", "boss_down") and by ArenaView.
class_name Juice
extends RefCounted

const NUM_CAP := 40                 # live damage numbers at most
const MERGE_T := 0.08               # hits on one target this close together sum into one number
const NUM_DUR := 0.7
const ABIL_MIN_OTHER := 12.0        # other players' ability ticks below this get no number (crits always do)
const NUM_RISE := 40.0              # pixels risen over a number's life
const POP_CAP := 24                 # dying models kept for their pop at once
const POP_DUR := 0.95               # 0.26: a death takes a second (was the 0.25 s pop)
const POP_DUR_HERO := 1.4
const HS_MAX := 0.09                # longest visual freeze
const HS_RATE := 4.0                # freezes a second at most (token bucket)
const SHAKE_PX := 12.0              # world units of camera offset at full trauma
const K3 := 1.0 / 30.0
const SHAKE_DECAY := 2.5            # trauma lost a second (full to nothing in 0.4 s)
const C_MINE := Color("#fff4dc")
const C_OTHER := Color("#e8dcc4")
# 0.43 (access): crit / ability / taken / heal / crystal numbers follow the Colour vision palette
var C_CRIT: Color:
	get: return Palette.get_c("crit")
var C_ABIL: Color:
	get: return Palette.get_c("abil")
var C_TAKEN: Color:
	get: return Palette.get_c("taken")
var C_HEAL: Color:
	get: return Palette.heal
var C_CORE: Color:
	get: return Palette.get_c("core")

var view = null                     # the ArenaView (untyped: it preloads this script)
var hs_t := 0.0                     # seconds of visual freeze left
var _hs_tokens := HS_RATE
var trauma := 0.0
var hit_seen := false               # a "hit" event with damage arrived: the sim's own pop texts give way
var nums: Array = []                # pooled damage numbers (dictionaries reused in place)
var pops: Array = []                # dying models: [inst, age, dur, basis, hero]
var flashes := {}                   # unit -> [until (view time), strength]
var _burst: Array = []              # pooled debris emitters for death pops
var _burst_i := 0
var _burst_root: Node3D = null
var _sx := 0.0                      # smooth shake noise phase
var _n_local := -1


func _init(v) -> void:
	view = v
	for i in NUM_CAP:
		nums.append({"live": false, "s": "", "wp": Vector2.ZERO, "u": null, "h": 60.0, "age": 0.0, "sz": 14,
			"col": Color.WHITE, "a": 1.0, "crit": false, "dmg": 0.0, "key": null, "slot": 0, "side": 0.0, "dead": false, "ar": null})


# ---------------------------------------------------------------- per-frame
func tick(dt: float) -> void:
	_hs_tokens = minf(HS_RATE, _hs_tokens + dt * HS_RATE)
	if hs_t > 0.0:
		hs_t -= dt
		if hs_t <= 0.0:
			hs_units.clear()
	if trauma > 0.0:
		trauma = maxf(0.0, trauma - dt * SHAKE_DECAY)
	_sx += dt
	for n in nums:
		if n["live"]:
			n["age"] += dt
			if n["age"] >= NUM_DUR:
				n["live"] = false
				n["u"] = null
				n["ar"] = null
	var keep: Array = []
	for p in pops:
		var inst: Node3D = p["inst"]
		if not is_instance_valid(inst):
			continue
		p["age"] += dt
		var u: float = p["age"] / p["dur"]
		if u >= 1.0:
			inst.queue_free()
			continue
		if view.anim_classic:
			_pop_classic(p, inst, u)
		else:
			_death(p, inst, u)
		keep.append(p)
	pops = keep
	if not flashes.is_empty():
		for u in flashes.keys():
			if float(flashes[u][0]) <= view.time:
				flashes.erase(u)


# ---------------------------------------------------------------- hit-stop (visual only)
# A short hold of the pose of the units in the blow (your hero and its victim); the simulation never
# slows. 0.19: nothing stops moving any more: freezing every model's position made walking monsters
# visibly hitch (and then jump) several times a second in a lane fight. Rate-limited, and only for
# your own hero's big blows (and the main's few big moments, which hold your hero's pose).
var hs_units := {}                  # unit -> true: whose pose holds while hs_t > 0
var hs_count := 0                   # holds started (perf/test counter)


func hit_stop(sec: float, units: Array = []) -> void:
	if not Settings.hit_stop or Settings.reduce_fx or _hs_tokens < 1.0:   # 0.43: Reduce screen effects stops it too
		return
	_hs_tokens -= 1.0
	if hs_t <= 0.0:
		hs_units.clear()
	hs_count += 1
	hs_t = maxf(hs_t, minf(sec, HS_MAX))
	if units.is_empty() and view.human_champ != null:
		units = [view.human_champ]
	for u in units:
		if u != null:
			hs_units[u] = true


func frozen() -> bool:
	return hs_t > 0.0


# Whether this unit's pose is held this frame (its position always follows the game).
func holds(u) -> bool:
	return hs_t > 0.0 and hs_units.has(u)


# ---------------------------------------------------------------- camera trauma
func add_trauma(k: float) -> void:
	if Settings.shake_level <= 0 or Settings.reduce_fx:
		return
	trauma = minf(1.0, trauma + k)


# Offset in metres for the camera's h/v offset this frame: trauma squared, smooth noise, not a jitter.
func shake_offset() -> Vector2:
	if trauma <= 0.001 or Settings.shake_level <= 0 or Settings.reduce_fx:
		return Vector2.ZERO
	var amp := trauma * trauma * SHAKE_PX * K3 * (0.5 if Settings.shake_level == 1 else 1.0)
	var t := _sx
	var x := sin(t * 97.0) * 0.6 + sin(t * 151.0 + 1.7) * 0.4
	var y := sin(t * 113.0 + 0.9) * 0.6 + sin(t * 173.0 + 2.6) * 0.4
	return Vector2(x, y) * amp


# ---------------------------------------------------------------- damage numbers
# e: a "hit" event {dmg, crit, abil, src, to, pid, team, vic_pid, p}; local: the local player's id.
func on_hit(e: Dictionary, local: int, ar) -> void:
	hit_seen = true
	_n_local = local
	var dmg := float(e.get("dmg", 0.0))
	var crit := bool(e.get("crit", false))
	var pid := int(e.get("pid", -1))
	var vic_pid := int(e.get("vic_pid", -1))
	var to := String(e.get("to", "mon"))
	var mine := pid == local or vic_pid == local
	var p: Vector2 = e["p"]
	# the victim: a hero by player id, a monster by position
	var u = null
	if to == "hero":
		for c in ar.champs:
			if c.pl.id == vic_pid:
				u = c
				break
	elif to == "mon":
		var bd := 26.0 * 26.0
		for m in ar.mons:
			if m.dead:
				continue
			var d2: float = m.p.distance_squared_to(p)
			if d2 < bd:
				bd = d2
				u = m
	# hit-stop (your hero's big blows only: a pose hold on your hero and its victim) and a nudge of trauma
	if (crit or (bool(e.get("abil", false)) and dmg >= 80.0) or dmg >= 160.0) and pid == local:
		var sec := clampf(0.04 + dmg / 2500.0, 0.04, HS_MAX)
		if crit:
			sec = maxf(sec, 0.05)
		hit_stop(sec, [view.human_champ, u])
	if dmg >= 160.0 and mine:
		add_trauma(0.18)
	# hit flash: heroes flash white when struck (monsters already flash from the sim), crits flash harder
	if u != null:
		if to == "hero":
			flash(u, 1.0, 0.06)
		elif crit:
			flash(u, 1.5, 0.09)
		elif bool(e.get("abil", false)) and dmg >= 40.0:
			flash(u, 1.25, 0.07)         # 0.26: an ability landing flashes harder than an auto-attack
	if Settings.dmg_numbers <= 0 or (Settings.dmg_numbers == 1 and not mine):
		return
	# noise budget: other people's small ability ticks (multi-hit fragments under 12) stay off the screen;
	# yours and every crit still show (review 0.16: a 37-monster lane peaked at ~20 numbers alive without this)
	if dmg < ABIL_MIN_OTHER and bool(e.get("abil", false)) and not crit and not mine:
		return
	var key = u if u != null else Vector2i(int(p.x / 24.0), int(p.y / 24.0))
	# merge with a fresh number on the same target
	var slot := 0
	for n in nums:
		if not n["live"] or not is_same(n["key"], key):
			continue
		if n["age"] <= MERGE_T:
			n["dmg"] += dmg
			n["crit"] = n["crit"] or crit
			_style(n, e, mine)
			return
		slot += 1
	var free = null
	var oldest = null
	for n in nums:
		if not n["live"]:
			free = n
			break
		if oldest == null or n["age"] > oldest["age"]:
			oldest = n
	if free == null:
		free = oldest
	free["live"] = true
	free["age"] = 0.0
	free["dmg"] = dmg
	free["crit"] = crit
	free["key"] = key
	free["u"] = u
	free["wp"] = p
	free["h"] = view.unit_top(u) if u != null else 40.0
	free["slot"] = mini(slot, 3)
	free["side"] = 1.0 if (int(p.x) + int(p.y)) % 2 == 0 else -1.0
	free["dead"] = false
	free["ar"] = ar
	_style(free, e, mine)


func _style(n: Dictionary, e: Dictionary, mine: bool) -> void:
	var dmg: float = n["dmg"]
	var crit: bool = n["crit"]
	var to := String(e.get("to", "mon"))
	var heal := bool(e.get("heal", false))
	var sz := 14
	if dmg >= 300.0:
		sz = 22
	elif dmg >= 120.0:
		sz = 18
	elif dmg >= 40.0:
		sz = 16
	if crit:
		sz += 3
	var col := C_MINE if mine else C_OTHER
	if heal:
		col = C_HEAL
	elif to == "hero":
		col = C_TAKEN
	elif to == "core":
		col = C_CORE
	elif crit:
		col = C_CRIT
	elif bool(e.get("abil", false)):
		col = C_ABIL
	n["s"] = ("+" if heal else "") + str(roundi(dmg)) + ("!" if crit else "")
	n["sz"] = sz
	n["col"] = col
	n["a"] = 1.0 if mine else 0.7


# Draws the live numbers (screen space, over the 3D view). Called from ArenaView.draw_labels.
func draw_numbers(ci: CanvasItem, ar) -> void:
	var vr := Rect2(Vector2.ZERO, view.size).grow(40)
	for n in nums:
		if not n["live"] or (n["ar"] != null and n["ar"] != ar):
			continue
		var age: float = n["age"]
		var u = n["u"]
		if u != null and not n["dead"]:
			if view._is_dead(u) or not view._in_arena(u, ar):
				n["dead"] = true
			else:
				n["wp"] = u.p
		var k := age / NUM_DUR
		var rise := (1.0 - (1.0 - k) * (1.0 - k)) * NUM_RISE
		var sz: int = n["sz"]
		# the spawn punch in whole 2 px steps: every distinct size is a fresh glyph set in the font cache
		var punch := maxf(0.0, 1.0 - age / 0.12)
		if punch > 0.0:
			sz += 2 * ceili(punch * (3.0 if n["crit"] else 2.0))
		var col: Color = n["col"]
		var a := clampf((NUM_DUR - age) / (NUM_DUR * 0.35), 0.0, 1.0)
		col.a = a * a * (3.0 - 2.0 * a) * float(n["a"])
		var sp: Vector2 = view.P(n["wp"], float(n["h"]) + 14.0) + Vector2(float(n["side"]) * (14.0 + 5.0 * int(n["slot"])), -rise - 16.0 * int(n["slot"]))
		if vr.has_point(sp):
			_text(ci, sp, n["s"], sz, col, 8 if n["crit"] else 6)


# Two passes (outline, fill) rather than text_c's three: forty numbers a frame are shaped three times fewer.
func _text(ci: CanvasItem, sp: Vector2, s: String, sz: int, col: Color, ow: int) -> void:
	var f: Font = view.bold_font
	var pos := (sp + Vector2(-150.0, 0)).round()
	ci.draw_string_outline(f, pos, s, HORIZONTAL_ALIGNMENT_CENTER, 300.0, sz, ow, Color(0.03, 0.02, 0.015, col.a * 0.95))
	ci.draw_string(f, pos, s, HORIZONTAL_ALIGNMENT_CENTER, 300.0, sz, col)


# ---------------------------------------------------------------- death pops
# Takes over a unit's model as it leaves the pool: a scale punch, a white-out and a shrink to nothing, with
# a debris burst in its colour. Returns false when the caller should free the model itself.
func pop(inst: Node3D, o, ar) -> bool:
	if not (o is Sim.Mon or o is Sim.Champ) or not o.dead or pops.size() >= POP_CAP:
		return false
	if not view.world_view_rect().grow(60).has_point(o.p):
		return false
	var hero: bool = o is Sim.Champ
	var col: Color = o.col if hero else Sim.mon_color(o)
	if o is Sim.Mon and o.d.has("col"):
		col = Color(o.d["col"])
	var big: bool = hero or (o is Sim.Mon and (o.r >= 14.0 or o.d.get("boss", false)))
	var boss: bool = o is Sim.Mon and o.d.get("boss", false)
	# 0.26 a proper death (see _death): the body collapses through its rig's "die" pose, topples about its feet
	# toward where the last blow pushed it (flyers fall out of the air first), lands in a puff of dust, lies
	# for a moment and sinks away. Everything here reads the sim's dead flag only; the sim never waits for it.
	var st = inst.get_meta("an") if inst.has_meta("an") else null
	var die: Array = []
	var start: Array = []
	if st != null and not st.rg.is_empty() and not bool(inst.get_meta("lod_on", false)):
		die = st.rg.get("die", [])
		if die.size() > 0 and st.plist.size() == (die[0] as Array).size():
			for mi in st.plist:
				start.append((mi as Node3D).transform)
		else:
			die = []
	var dir := Vector3(-1, 0, 0)
	if st != null and st.hdir != Vector3.ZERO and (absf(st.ha) > 0.005 or absf(st.hv) > 0.05):
		dir = st.hdir
	var fly: bool = o is Sim.Mon and o.fly
	var dur := POP_DUR_HERO if hero else (POP_DUR_BIG if big else POP_DUR)
	if fly:
		dur += 0.25
	pops.append({"inst": inst, "age": 0.0, "dur": dur, "basis": inst.transform.basis, "hero": hero, "y0": inst.transform.origin.y,
		"die": die, "start": start, "st": st, "dir": dir, "fly": fly, "big": big, "boss": boss, "landed": false,
		"p": o.p, "h": view.unit_height(o), "bodyonly": st != null and not st.rg.is_empty() and bool(st.rg.get("bodyonly", false)),
		"col": col, "sc": inst.transform.basis.get_scale().y})
	# shadows off: a toppling, sinking shadow caster reads as a flicker
	for ch in inst.get_children():
		if ch is GeometryInstance3D:
			ch.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	if hero:
		add_trauma(0.3)
	elif big:
		add_trauma(0.22 if boss else 0.1)
	return true


const POP_DUR_BIG := 1.2
const DEATH_FALL := 0.5       # share of the death spent collapsing and toppling; the body lands at its end
const DEATH_SINK := 0.72      # ... and from here it sinks away


# The old 0.16 pop (anim_classic evidence captures only): a scale punch, a white-out and a shrink to nothing.
func _pop_classic(p: Dictionary, inst: Node3D, u: float) -> void:
	var hero: bool = p["hero"]
	var peak := 1.45 if hero else 1.28
	var k: float
	if u < 0.35:
		k = lerpf(1.0, peak, u / 0.35)
	else:
		var w := (u - 0.35) / 0.65
		k = peak * (1.0 - w) * (1.0 - w)
	var tr := inst.transform
	tr.basis = (p["basis"] as Basis).scaled(Vector3(k, maxf(k, 0.05), k))
	if hero:
		tr.origin.y = float(p["y0"]) + u * 0.25
	inst.transform = tr
	Models3D.set_param(inst, "flash", clampf(u * 4.0, 0.0, 1.0) * (0.45 if Settings.reduce_fx else 1.25))
	if not p["landed"]:
		p["landed"] = true
		_debris(p["p"], p["col"], p["big"], p["h"])


# 0.26 death choreography, u = 0..1 over the pop's duration:
#   0 .. DEATH_FALL  the parts ease from the pose they died in into the rig's collapsed pose (knees give, the
#                    head and arms drop, a quadruped folds its legs, a bug sprawls, a flyer folds its wings)
#                    while the whole body topples about its feet with a gravity curve; a flyer drops out of the
#                    air first and tumbles. At DEATH_FALL it lands: a dust puff, debris, a nudge of trauma for
#                    the big ones.
#   .. DEATH_SINK    it lies there.
#   .. 1             it sinks into the ground and shrinks a little (no alpha: the unit shader has none per instance).
func _death(p: Dictionary, inst: Node3D, u: float) -> void:
	var fly: bool = p["fly"]
	var hero: bool = p["hero"]
	var bodyonly: bool = p["bodyonly"]
	var fq := clampf(u / DEATH_FALL, 0.0, 1.0)
	# parts: into the die pose over the first 70 % of the fall, eased in and out
	var die: Array = p["die"]
	if not die.is_empty():
		var tq := clampf(fq / 0.7, 0.0, 1.0)
		tq = tq * tq * (3.0 - 2.0 * tq)
		var x := tq * (die.size() - 1)
		var k := mini(int(x), die.size() - 2)
		var f := x - k
		var A: Array = die[k]
		var B: Array = die[k + 1]
		var start: Array = p["start"]
		var pl: Array = p["st"].plist
		var bl := clampf(tq * 2.5, 0.0, 1.0)      # off the pose it died in
		for i in pl.size():
			var t: Transform3D = (A[i] as Transform3D).interpolate_with(B[i], f)
			if bl < 1.0:
				t = (start[i] as Transform3D).interpolate_with(t, bl)
			(pl[i] as Node3D).transform = t
	# the body: topple (or fall) with gravity, land, lie, sink
	var basis0: Basis = p["basis"]
	var tr := inst.transform
	var y0: float = p["y0"]
	var dir: Vector3 = p["dir"]
	var axis := Vector3.UP.cross(dir)
	if axis.length_squared() < 1e-6:
		axis = Vector3(0, 0, 1)
	axis = axis.normalized()
	var tilt_max := 0.0 if bodyonly else (1.25 if not fly else 1.6)
	if hero:
		tilt_max = 1.35
	var g := fq * fq                            # gravity: slow to start, fast to land
	var tilt := tilt_max * g
	var rot := Basis(axis, tilt)
	var y := y0
	if fly:
		# out of the air: height to the ground with the same curve, a roll on the way down
		y = y0 * (1.0 - g)
		rot = Basis(Vector3(1, 0, 0), 0.9 * g) * rot
	var sc := 1.0
	if u >= DEATH_SINK:
		var sq := (u - DEATH_SINK) / (1.0 - DEATH_SINK)
		sq = sq * sq
		y -= float(p["h"]) * K3 * 0.75 * sq * (0.6 if tilt_max > 0.0 else 1.0)   # a lying body is low already
		sc = 1.0 - 0.25 * sq
	tr.basis = (basis0 * rot).scaled(Vector3(sc, sc, sc))
	tr.origin.y = y
	inst.transform = tr
	if hero and u < 0.12:
		Models3D.set_param(inst, "flash", (1.0 - u / 0.12) * (0.45 if Settings.reduce_fx else 1.0))
	elif hero and u < 0.2:
		Models3D.set_param(inst, "flash", 0.0)
	if not p["landed"] and fq >= 1.0:
		p["landed"] = true
		var big: bool = p["big"]
		if view.fx3d != null:
			view.fx3d.puff(p["p"], (1.7 if hero or p["boss"] else (1.3 if big else 0.9)) * clampf(float(p["sc"]) * 30.0, 0.7, 1.6))
		_debris(p["p"], p["col"], big, 6.0)
		if big:
			add_trauma(0.12 if p["boss"] else 0.06)


func _debris(p: Vector2, col: Color, big: bool, h: float) -> void:
	if view.fx3d == null:
		return
	if _burst_root == null or not is_instance_valid(_burst_root):
		_burst_root = Node3D.new()
		view.units_root.add_child(_burst_root)
		_burst.clear()
		for i in 8:
			var sp: CPUParticles3D = view.fx3d._sparks(_burst_root, col, 14, 0.5, true,
				{"explode": 1.0, "er": 0.18, "spread": 180.0, "v0": 1.4, "v1": 3.8, "grav": Vector3(0, -9, 0), "damp": 2.0, "s0": 0.07, "s1": 0.2})
			sp.emitting = false
			_burst.append(sp)
	var sp: CPUParticles3D = _burst[_burst_i]
	_burst_i = (_burst_i + 1) % _burst.size()
	sp.position = FxLayer.v3(p, h)
	view.fx3d.tint(sp, col.lerp(Color.WHITE, 0.25))
	sp.scale_amount_min = 0.1 if big else 0.07
	sp.scale_amount_max = 0.26 if big else 0.18
	sp.restart()
	sp.emitting = true


# ---------------------------------------------------------------- hit flash
func flash(u, strength: float, dur: float) -> void:
	if Settings.reduce_fx:
		strength = minf(strength, 0.45)   # 0.43: Reduce screen effects: a soft tint, no white-out
	var cur = flashes.get(u)
	if cur != null and float(cur[1]) > strength and float(cur[0]) > view.time:
		return
	flashes[u] = [view.time + dur, strength]


func flash_of(u) -> float:
	if flashes.is_empty():
		return 0.0
	var f = flashes.get(u)
	return float(f[1]) if f != null and float(f[0]) > view.time else 0.0
