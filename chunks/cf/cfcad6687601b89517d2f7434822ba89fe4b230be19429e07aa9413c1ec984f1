# o: {"pos", "rot", "s": Vector3, "spin", "sink", "rise": metres risen over the life}
func _play(id: String, o: Dictionary, life: float, mat: Material = null) -> void:
	var mi := _inst(id, mat)
	if mi == null:
		return
	o["life"] = life
	_timed.append([mi, life, o])
	_pose(mi, life, o)


func _pose(mi: MeshInstance3D, t: float, o: Dictionary) -> void:
	var life: float = o["life"]
	var age := life - t
	var s: Vector3 = o.get("s", Vector3.ONE)
	var k_in := clampf(age / float(o.get("grow", 0.12)), 0.0, 1.0)
	var k_out := clampf(t / maxf(0.05, life * 0.35), 0.0, 1.0)
	var g := (0.3 + 0.7 * ease(k_in, 0.4)) * (0.2 + 0.8 * k_out)
	var pos: Vector3 = o["pos"]
	if o.get("sink", false):
		pos.y -= (1.0 - k_out) * s.y * 0.6
	pos.y += float(o.get("rise", 0.0)) * (age / life)
	var rot: float = o.get("rot", 0.0) + age * float(o.get("spin", 0.0))
	mi.transform = Transform3D(Basis(Vector3.UP, rot).scaled(s * g), pos)
	mi.visible = g > 0.001


# ---------------------------------------------------------------- per frame (call before FxLayer.sync)
func sync(ar, delta: float, view = null) -> void:
	delta = minf(delta, 0.05)
	_sync_projs(ar, delta)
	_sync_specials(ar)
	_sync_warn(ar)
	if view != null:
		_tint_summons(ar, view)
	var keep: Array = []
	for it in _timed:
		var mi: MeshInstance3D = it[0]
		if not is_instance_valid(mi):
			continue
		it[1] -= delta
		if it[1] <= 0:
			_release(mi)
			continue
		_pose(mi, it[1], it[2])
		keep.append(it)
	_timed = keep
	var sk: Array = []
	for r in splashes:
		r[3] -= delta
		if r[3] > 0:
			sk.append(r)
	splashes = sk
	var tw: Array = []
	for w in _trail_wait:
		w[1] -= delta
		if w[1] <= 0.0:
			_trail_pool.append(w[0])
		else:
			tw.append(w)
	_trail_wait = tw


func _sync_projs(ar, delta: float) -> void:
	var seen := {}
	for pr in ar.mprojs:
		var id := proj_model(pr)
		if id == "":
			continue
		seen[pr] = true
		var L: Dictionary = _live.get(pr, {})
		if L.is_empty():
			var mi := _inst(id)
			if mi == null:
				continue
			var look: Array = PROJ_LOOK.get(id, ["", 1.0, null])
			var md: Dictionary = GameData.MON.get(String(pr.kind), {})
			var big := clampf(0.85 + float(md.get("r", 10)) / 40.0, 1.0, 1.6)
			if pr.splash > 0:
				big = maxf(big, 1.3)
			var d0: float = maxf(1.0, pr.p.distance_to(pr.tgt.p)) if pr.tgt != null else 1.0
			L = {"mi": mi, "model": id, "spin": look[0], "big": big, "a": 0.0, "d0": d0,
				"h0": 66.0 if md.get("fly", false) else 40.0, "col": pr.col, "tgt": pr.tgt, "splash": pr.splash}
			if fx3d != null:
				var tc: Color = look[2] if look[2] != null else pr.col
				var tp: CPUParticles3D = null
				if not _trail_pool.is_empty():
					tp = _trail_pool.pop_back()
				else:
					tp = fx3d._sparks(self, tc, 22, 0.4, false, {"er": 0.06, "v0": 0.1, "v1": 0.5, "grav": Vector3(0, 0.5, 0), "s0": 0.14, "s1": 0.3})
					tp.speed_scale = 1.0
				tp.emitting = false
				fx3d.tint(tp, tc)
				var sz: float = float(look[1]) * big
				tp.scale_amount_min = 0.14 * sz
				tp.scale_amount_max = 0.32 * sz
				L["trail"] = tp
			_live[pr] = L
		var mi: MeshInstance3D = L["mi"]
		var dir := Vector2.RIGHT
		if pr.tgt != null:
			dir = pr.tgt.p - pr.p
		var d := dir.length()
		var ang := dir.angle() if d > 0.5 else 0.0
		# height: from the shooter's muzzle down to the hero's chest as it closes in
		var u := clampf(d / float(L["d0"]), 0.0, 1.0)
		var h: float = lerpf(30.0, float(L["h0"]), u)
		var b := Basis(Vector3.UP, -ang)
		var sp: String = L["spin"]
		if sp != "":
			L["a"] = float(L["a"]) + delta * 12.0
			b = b * Basis(Vector3.RIGHT if sp == "x" else Vector3.BACK, float(L["a"]))
		var pos := v3(pr.p, h)
		mi.transform = Transform3D(b.scaled(Vector3.ONE * PROJ_SCALE * float(L["big"])), pos)
		L["p"] = pr.p
		if L.has("trail"):
			var tp: CPUParticles3D = L["trail"]
			if not tp.emitting:
				tp.position = pos
				tp.restart()
			tp.position = pos
			tp.emitting = true
	for pr in _live.keys():
		if seen.has(pr):
			continue
		var L: Dictionary = _live[pr]
		_live.erase(pr)
		_release(L["mi"])
		if L.has("trail") and is_instance_valid(L["trail"]):
			var tp: CPUParticles3D = L["trail"]
			tp.emitting = false
			_trail_wait.append([tp, 0.6])
		# landed on its hero: a burst on the hero and, for splash shots, a crater ring on the ground
		var tg = L["tgt"]
		if tg == null or tg.dead or not L.has("p"):
			continue
		var at: Vector2 = tg.p
		if at.distance_to(L["p"]) > 80.0:
			continue
		var col: Color = L["col"]
		var big: float = L["big"]
		_play("mfx_impact", {"pos": v3(at, 30), "s": Vector3.ONE * 0.9 * big, "rot": randf() * TAU, "spin": 4.0, "grow": 0.06}, 0.32, flat(col))
		if fx3d != null:
			fx3d.hit(at, (at - Vector2(L["p"])).normalized() if at != L["p"] else Vector2.RIGHT, false, 30.0)
		var spl: float = L["splash"]
		if spl > 0:
			var s := spl * K3
			_play("mfx_splash", {"pos": v3(at, 1), "s": Vector3(s, clampf(s * 0.8, 0.8, 1.6), s), "rot": randf() * TAU, "sink": true, "grow": 0.1}, 0.7, flat(col))
			splashes.append([at, spl, col, 0.55])


func _sync_specials(ar) -> void:
	for e in ar.fx:
		if not e.has("mfx") or e.has("_v3"):
			continue
		# claim the dict so FxLayer doesn't draw its generic ring (it skips dicts it has "already shown")
		e["_v3"] = null
		var p: Vector2 = e["p"]
		var mk := String(e.get("mk", ""))
		match String(e["mfx"]):
			"summon":
				var id: String = SUMMON.get(mk, "mfx_grave")
				var tall := id == "mfx_voidtear"
				var s := 1.05 if tall else 1.2
				_play(id, {"pos": v3(p), "s": Vector3.ONE * s, "rot": randf() * TAU, "sink": not tall, "grow": 0.18}, 1.3)
				if fx3d != null:
					fx3d.hit(p, Vector2.UP, false, 8.0)
			"blink":
				var id := "mfx_burrow" if mk == "wurm" else "mfx_voidtear"
				var md: Dictionary = GameData.MON.get(mk, {})
				var s := clampf(float(md.get("r", 16)) / 16.0, 0.9, 1.6)
				if id == "mfx_voidtear":
					s *= 0.85
				_play(id, {"pos": v3(p), "s": Vector3.ONE * s, "rot": randf() * TAU, "sink": id == "mfx_burrow", "grow": 0.1}, 0.9)
				if fx3d != null:
					fx3d.hit(p, Vector2.UP, false, 6.0)


# boss dives: chevrons hovering over the circle, dropping and quickening as the strike nears
func _sync_warn(ar) -> void:
	var seen := {}
	for b in ar.mpend:
		# the warning dicts change as they count down, so tag each with a view-only id
		var key := int(b.get("_mfx_id", 0))
		if key == 0:
			key = randi() | 1
			b["_mfx_id"] = key
		seen[key] = true
		var mi = _warn.get(key)
		if mi == null or not is_instance_valid(mi):
			mi = _inst("mfx_divemark")
			if mi == null:
				continue
			_warn[key] = mi
		var dur: float = maxf(0.05, float(b["dur"]))
		var k := 1.0 - float(b["t"]) / dur
		var r: float = b["r"]
		var s := clampf(r / 80.0, 1.2, 2.2)
		var bob := sin(k * (10.0 + 30.0 * k)) * 0.12
		var h := lerpf(2.8, 0.5, k * k) + bob
		mi.transform = Transform3D(Basis(Vector3.UP, k * 6.0).scaled(Vector3.ONE * s * (0.6 + 0.4 * clampf(k * 4.0, 0.0, 1.0))), v3(b["p"]) + Vector3(0, h, 0))
	for key in _warn.keys():
		if not seen.has(key):
			_release(_warn[key])
			_warn.erase(key)


# hero summon wolves: the spirit's fur shifts toward the owner's colour (Compatibility has no per-instance
# uniforms, so the wolf gets its own surface materials per hero colour)
func _tint_summons(ar, view) -> void:
	for su in ar.sums:
		if su.name != "Wolf" or su.c == null:
			continue
		var inst = view.pool.get(su)
		if inst == null or inst.has_meta("mfx_tint"):
			continue
		inst.set_meta("mfx_tint", true)
		var hc := Color(String(su.c.def.get("color", "#79b8ff")))
		var src := {}
		for key in ["body", "belly", "dark"]:
			src[Models3D.material("sum_wolf", key)] = key
		for mi in inst.get_children():
			if not (mi is MeshInstance3D) or mi.mesh == null:
				continue
			for si in mi.mesh.get_surface_count():
				var m = mi.mesh.surface_get_material(si)
				if not src.has(m):
					continue
				var ck := "%s|%s" % [hc.to_html(), src[m]]
				if not _tint_mats.has(ck):
					var nm: ShaderMaterial = (m as ShaderMaterial).duplicate()
					var base: Color = nm.get_shader_parameter("albedo")
					nm.set_shader_parameter("albedo", base.lerp(hc, 0.38 if src[m] != "belly" else 0.2))
					_tint_mats[ck] = nm
				mi.set_surface_override_material(si, _tint_mats[ck])


func clear() -> void:
	for ch in get_children():
		ch.queue_free()
	_pool.clear()
	_trail_pool.clear()
	_trail_wait.clear()
	_live.clear()
	_warn.clear()
	_timed.clear()
	splashes.clear()


# ---------------------------------------------------------------- ground decals (ArenaView.draw_under)
# One telegraph style for hero delayed blasts and monster warnings: a dark ring under a bright ring, a disc
# filling from the centre and a wedge sweeping round as the countdown runs. k = 0 at the start, 1 at the blast.
static func telegraph(ci: CanvasItem, p: Vector2, r: float, k: float, col: Color, strong := true, tt := 0.0) -> void:
	k = clampf(k, 0.0, 1.0)
	var bright := col.lerp(Color.WHITE, 0.15)
	if not strong:
		# small blasts (one of many): a light version so a shower doesn't bury the ground
		ci.draw_circle(p, r * k, Color(col, 0.16))
		ci.draw_arc(p, r, 0, TAU, 40, Color(0.05, 0.02, 0.02, 0.45), 4.0, true)
		ci.draw_arc(p, r, 0, TAU, 40, Color(bright, 0.75), 2.0, true)
		return
	var a := 1.0
	var danger := col.r > 0.9 and col.g < 0.4
	if danger:
		bright = col
	else:
		ci.draw_circle(p, r, Color(0.02, 0.01, 0.01, 0.22 * a))
	if k > 0.01:
		var pts := PackedVector2Array([p])
		var n := maxi(3, int(48 * k))
		var a0 := -PI / 2
		for i in n + 1:
			pts.append(p + Vector2.from_angle(a0 + TAU * k * i / n) * r * 0.97)
		ci.draw_colored_polygon(pts, Color(col, 0.2 * a))
		ci.draw_circle(p, r * k, Color(col, 0.26 * a))
		ci.draw_arc(p, r * k, 0, TAU, 48, Color(bright, 0.9 * a), 2.5, true)
		ci.draw_line(p, p + Vector2.from_angle(a0 + TAU * k) * r, Color(bright, 0.85 * a), 2.5, true)
	# the final moment: the outer ring thickens and pulses
	var urgent := clampf((k - 0.7) / 0.3, 0.0, 1.0)
	var w := 4.0 + 2.5 * urgent * (0.5 + 0.5 * sin(tt * 30.0))
	ci.draw_arc(p, r, 0, TAU, 64, Color(0.06, 0.02, 0.02, 0.8 * a), w + 6.0, true)
	ci.draw_arc(p, r, 0, TAU, 64, Color(bright, a), w, true)
	for i in 4:
		var ang := TAU * i / 4.0 + PI / 4
		ci.draw_line(p + Vector2.from_angle(ang) * (r - 12.0), p + Vector2.from_angle(ang) * (r + 4.0), Color(bright, a), 3.0, true)


func draw_decals(ci: CanvasItem, ar) -> void:
	# splash shots in flight: where the blast will land
	for pr in ar.mprojs:
		if pr.splash > 0 and pr.tgt != null and not pr.tgt.dead:
			var d: float = pr.p.distance_to(pr.tgt.p)
			var k := clampf(1.0 - d / 260.0, 0.0, 1.0)
			ci.draw_circle(pr.tgt.p, pr.splash, Color(pr.col, 0.1 + 0.12 * k))
			ci.draw_arc(pr.tgt.p, pr.splash, 0, TAU, 40, Color(0.05, 0.02, 0.02, 0.5 * (0.4 + 0.6 * k)), 6.0, true)
			ci.draw_arc(pr.tgt.p, pr.splash, 0, TAU, 40, Color(pr.col.lerp(Color.WHITE, 0.2), 0.5 + 0.5 * k), 3.0, true)
	for r in splashes:
		var u: float = 1.0 - r[3] / 0.55
		var rr: float = r[1] * (0.6 + 0.5 * ease(u, 0.4))
		var c: Color = r[2]
		ci.draw_circle(r[0], rr, Color(c, 0.22 * (1.0 - u)))
		ci.draw_arc(r[0], rr, 0, TAU, 40, Color(c.lerp(Color.WHITE, 0.3), 1.0 - u), 4.0, true)
␀␀␀# Profile-name rules: length, characters, and a profanity / slur / sexual-term filter.
# The server runs the same rules (relay/worker.js, between NAME_FILTER_BEGIN and _END); the lists below must
# match it exactly (tests/friends_test.gd checks). Preload it: const NameFilter := preload("res://scripts/name_filter.gd")
#
# How a name is checked: lower case; separators (space _ -) removed; leetspeak mapped (0->o, 1->i or l, 3->e,
# 4->a, 5->s, 7->t, 8->b, @->a, $->s ...); then
#   SUBSTR entries are blocked anywhere, and each letter may repeat ("fuuuck"), but a doubled letter must stay
#     doubled so "boob" does not catch "Bob";
#   TOKEN entries are blocked only as a whole word (camelCase and separators split words): "ass" is blocked,
#     "Cassandra" and "Assassin" are not;
#   ALLOW words are cut out first, so names like Dickens, Hancock, Scunthorpe, Matsushita or Grape pass.
extends RefCounted

const SUBSTR := ["fuck", "fucc", "fcuk", "phuck", "fvck", "motherf", "shit", "bitch", "biatch", "biotch", "cunt",
