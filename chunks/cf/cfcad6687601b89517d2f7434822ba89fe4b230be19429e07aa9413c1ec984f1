func set_mode(m: String) -> void:
	game_mode = m
	for k in mode_btns.size():
		mode_btns[k].set_pressed_no_signal(MODES[k][0] == m)
	if draft_mode_lbl != null:
		draft_mode_lbl.text = "%s  ·  %s%s" % [mode_info(m)[1], Sim.MAPS[game_map]["name"] if m != "tutorial" else Sim.MAPS[0]["name"], ("  ·  AI: " + Sim.DIFF_NAMES[difficulty]) if m != "tutorial" else ""]
	pb = null   # 0.44: leaving Draft forgets its pick/ban board
	_codex_pb_hint()   # ---- 0.45 codex ---- (clears the Draft hints)
	if pb_timer_lbl != null:
		pb_timer_lbl.visible = m == "draft"
	if m == "draft":
		_pb_start()   # 0.44: the pick/ban phase against bots
	elif not BAN_MODES.has(m):
		draft_phase = "pick"
		ban_votes = []
		bans = []
		ban_counts = {}
		_refresh_ban_marks()
		var extra := ""
		match m:
			"survival":
				extra = "  Difficulty sets how fast the waves grow."
			"weekly":
				# 0.44: one seed, map and twist a week; the hero is yours to choose
				var wk := WeeklyData.this_week()
				var tw := WeeklyData.twist_of(wk)
				var wb: Dictionary = Profile.weekly.get(str(wk), {})
				extra = "  %s: %s  ·  %s  ·  %s left%s" % [WeeklyData.week_label(wk), String(tw["name"]), String(tw["desc"]), WeeklyData.left_label(WeeklyData.seconds_left()), ("  ·  your best: %d" % int(wb["score"])) if not wb.is_empty() else ""]
				if draft_mode_lbl != null:
					draft_mode_lbl.text = "Weekly Challenge %s  ·  %s  ·  %s  ·  Normal" % [WeeklyData.week_label(wk), String(tw["name"]), Sim.MAPS[WeeklyData.map_of(wk, Sim.MAPS.size())]["name"]]
			"daily":
				var td := SurvivalData.today()
				extra = "  %s: today's hero is %s, on %s at Normal difficulty. Your streak: %d day%s." % [Profile.date_label(td), String(find_champ(SurvivalData.daily_hero(td))["name"]).split(" ")[0], Sim.MAPS[SurvivalData.daily_map(td, Sim.MAPS.size())]["name"], Profile.daily_streak(td), "" if Profile.daily_streak(td) == 1 else "s"]
				sel_id = SurvivalData.daily_hero(td)
				if draft_mode_lbl != null:
					draft_mode_lbl.text = "Daily Run %s  ·  %s  ·  Normal" % [Profile.date_label(td), Sim.MAPS[SurvivalData.daily_map(td, Sim.MAPS.size())]["name"]]
			"tutorial":
				extra = "  Choose any hero to learn with."
			"allrandom":
				extra = "  Roll when you're ready."
			_:
				extra = "  Choose your hero."
		draft_tag.text = (mode_info(m)[2] + extra) if m != "daily" else "Today's Survival, the same for everyone." + extra
		if m == "weekly":
			draft_tag.text = "This week's challenge." + extra
