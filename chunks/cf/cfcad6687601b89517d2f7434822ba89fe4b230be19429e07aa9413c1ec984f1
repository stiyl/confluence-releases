					next_lines.append("%s bonus unlocks: %s" % [tname, SurvivalData.TAGS[tg]["tiers"][t_after - 1]])
				elif t_after < SurvivalData.SYN_TIERS.size():
					var need: int = SurvivalData.SYN_TIERS[t_after] - after
					next_lines.append("%s: %d more %s for the %s bonus" % [tname, need, "card" if need == 1 else "cards", ["first", "second", "third"][t_after]])
