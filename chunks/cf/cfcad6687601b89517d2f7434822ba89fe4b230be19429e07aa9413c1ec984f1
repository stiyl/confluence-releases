	{"id": "bronze", "name": "Bronze", "min": -1000000, "col": Color("#b07a4a"), "gem": Color("#d89a62")},
	{"id": "silver", "name": "Silver", "min": 900, "col": Color("#a6abb2"), "gem": Color("#dfe6ee")},
	{"id": "gold", "name": "Gold", "min": 1100, "col": Color("#c9a24a"), "gem": Color("#ffd866")},
	{"id": "platinum", "name": "Platinum", "min": 1300, "col": Color("#6fb5ac"), "gem": Color("#9ff0e0")},
	{"id": "diamond", "name": "Diamond", "min": 1500, "col": Color("#5f86d8"), "gem": Color("#a8d0ff")},
