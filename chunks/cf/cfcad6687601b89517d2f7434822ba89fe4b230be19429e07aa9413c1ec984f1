# Six inventory slots at 24 px, the same look as the Armory icons (gradient backing, sprite, tier frame).
class ItemStrip extends Control:
	var items: Array = []

	func _ready() -> void:
		mouse_filter = MOUSE_FILTER_PASS
		var tips: Array = []
		for id in items:
			tips.append(String(GameData.item(id).get("name", id)))
		tooltip_text = ", ".join(tips) if not tips.is_empty() else "No items"

	func _draw() -> void:
		var px := 24.0
		var gap := 2.0
		for i in GameData.INV_SLOTS:
			var r := Rect2(i * (px + gap), (size.y - px) / 2.0, px, px)
			var inner := r.grow(-2)
			if i < items.size():
				var id: String = items[i]
				var tier := UIParts.item_tier("item:" + id)
				UIParts.gradient_fill(self, inner, Color(0.22, 0.19, 0.15), Color(0.07, 0.06, 0.05), 6)
				if tier >= 2:
					draw_circle(inner.get_center(), inner.size.x * 0.42, Color(UIParts.TIER_COL[tier], 0.1))
				if not Sprites.draw_fit(self, "item_" + id, inner, 0, 0, 1.0):
					UIParts.draw_glyph(self, "passive", inner.grow(-3), Color(0.6, 0.55, 0.45))
				if tier > 0:
					UIParts.tier_frame(self, r.grow(-1), tier)
				else:
					UIParts.framed(self, r.grow(-1))
			else:
				draw_rect(inner, Color(0.04, 0.035, 0.03, 0.8))
				draw_rect(inner, Color(UIParts.BRONZE_DARK, 0.7), false, 1.0)


# Small emblem for an award card: a flat shape in the winner's team colour on a dark disc.
class AwardGlyph extends Control:
	var kind := ""
	var col := Color.WHITE

	func _draw() -> void:
		var c := size / 2.0
		var rad := minf(size.x, size.y) / 2.0
		draw_circle(c, rad, Color(0.05, 0.04, 0.03, 0.95))
		draw_arc(c, rad - 1.0, 0, TAU, 32, Color(col, 0.7), 1.5, true)
		var k := col.lightened(0.25)
		match kind:
			"siege":   # a crystal with a crack
				draw_colored_polygon(PackedVector2Array([c + Vector2(0, -9), c + Vector2(6, -2), c + Vector2(3, 8), c + Vector2(-3, 8), c + Vector2(-6, -2)]), k)
				draw_polyline(PackedVector2Array([c + Vector2(-1, -7), c + Vector2(2, -2), c + Vector2(-1, 2), c + Vector2(1, 7)]), Color(0.05, 0.04, 0.03), 1.5, true)
			"sword":
				draw_line(c + Vector2(-7, 7), c + Vector2(6, -6), k, 3.0, true)
				draw_line(c + Vector2(-3, -3), c + Vector2(2, 2), k, 1.5, true)
				draw_line(c + Vector2(-5, 2), c + Vector2(-1, 6), k, 2.0, true)
				draw_circle(c + Vector2(-7, 7), 2.0, k)
			"skull":
				draw_circle(c + Vector2(0, -2), 6.5, k)
				draw_rect(Rect2(c + Vector2(-4, 2), Vector2(8, 5)), k)
				draw_circle(c + Vector2(-2.5, -2.5), 1.8, Color(0.05, 0.04, 0.03))
				draw_circle(c + Vector2(2.5, -2.5), 1.8, Color(0.05, 0.04, 0.03))
				draw_rect(Rect2(c + Vector2(-0.8, 0), Vector2(1.6, 2.5)), Color(0.05, 0.04, 0.03))
			"duel":
				draw_line(c + Vector2(-8, 7), c + Vector2(6, -7), k, 2.5, true)
				draw_line(c + Vector2(8, 7), c + Vector2(-6, -7), k, 2.5, true)
				draw_circle(c + Vector2(-8, 7), 2.0, k)
				draw_circle(c + Vector2(8, 7), 2.0, k)
			"boss":   # a horned helm
				draw_colored_polygon(PackedVector2Array([c + Vector2(-6, 6), c + Vector2(-6, -3), c + Vector2(0, -7), c + Vector2(6, -3), c + Vector2(6, 6)]), k)
				draw_line(c + Vector2(-6, -3), c + Vector2(-10, -9), k, 2.0, true)
				draw_line(c + Vector2(6, -3), c + Vector2(10, -9), k, 2.0, true)
				draw_rect(Rect2(c + Vector2(-4, 0), Vector2(3, 2)), Color(0.05, 0.04, 0.03))
				draw_rect(Rect2(c + Vector2(1, 0), Vector2(3, 2)), Color(0.05, 0.04, 0.03))
			"coin":
				draw_circle(c, 8.0, k)
				draw_arc(c, 5.5, 0, TAU, 24, Color(0.05, 0.04, 0.03), 1.2, true)
				draw_rect(Rect2(c + Vector2(-1, -3.5), Vector2(2, 7)), Color(0.05, 0.04, 0.03))
			"send":   # a rift arrow
				draw_colored_polygon(PackedVector2Array([c + Vector2(-8, -3), c + Vector2(2, -3), c + Vector2(2, -7), c + Vector2(9, 0), c + Vector2(2, 7), c + Vector2(2, 3), c + Vector2(-8, 3)]), k)
			_:
				draw_circle(c, 6.0, k)


# Both crystals' health over the match (sim.hist "core"), round ticks on the x-axis, final values labelled,
# the end marked; optionally each team's gold earned as thin lines on a right-hand axis.
class CoreGraph extends Control:
	var main
	var sim
	var show_gold := true
	var _btn: Button
	var _tabs: Array = []
	# 0.18: mode "income" plots each team's income per round (the Tab scoreboard), the per-player lines
	# faint behind on the toggle. Reads sim.hist entries that carry "inc" and "round"; until they do, the
	# EventHud's per-round record (inc_rec: {"round", "team": [2], "pl": [n]}) stands in.
	var mode := "core"
	var inc_rec: Array = []
	var show_players := false
	var tabs := false           # 0.18.4 end screen: "Crystal" / "Income" tabs on one graph
	var players_main := false   # 0.18.2 end screen: every player's income as a main line with a name label, no team lines
	var plain := false          # no frame / backing (drawn inside a plaque)

	func _ready() -> void:
		mouse_filter = MOUSE_FILTER_PASS
		_btn = Button.new()
		_btn.text = "Gold" if mode == "core" else "Players"
		_btn.toggle_mode = true
		_btn.button_pressed = show_gold if mode == "core" else show_players
		_btn.focus_mode = FOCUS_NONE
		_btn.add_theme_font_size_override("font_size", 11)
		_btn.custom_minimum_size = Vector2(0, 20)
		_btn.tooltip_text = "Show each team's gold earned (right axis)" if mode == "core" else "Show every player's income as a thin line"
		_btn.toggled.connect(func(on: bool):
			if mode == "core":
				show_gold = on
			else:
				show_players = on
			queue_redraw())
		_btn.visible = not players_main or tabs
		add_child(_btn)
		if tabs:
			var grp := ButtonGroup.new()
			for t in [["Crystal", "core"], ["Income", "income"]]:
				var b := Button.new()
				b.text = t[0]
				b.toggle_mode = true
				b.button_group = grp
				b.button_pressed = mode == t[1]
				b.focus_mode = FOCUS_NONE
				b.add_theme_font_size_override("font_size", 11)
				b.custom_minimum_size = Vector2(0, 20)
				b.pressed.connect(func():
					mode = t[1]
					_btn.text = "Gold" if mode == "core" else "Players"
					_btn.visible = mode == "core"
					_btn.button_pressed = show_gold
					_place()
					queue_redraw())
				add_child(b)
				_tabs.append(b)
			_btn.visible = mode == "core"
		resized.connect(_place)
		_place()

	func _place() -> void:
		var x := size.x - 8.0
		if not _tabs.is_empty():
			for i in range(_tabs.size() - 1, -1, -1):
				var b: Button = _tabs[i]
				x -= 60.0
				b.position = Vector2(x, 4)
				b.size = Vector2(58, 20)
			x -= 10.0
		if _btn != null:
			var bw := 50.0 if mode == "core" else 62.0
			_btn.position = Vector2(x - bw, 4)
			_btn.size = Vector2(bw, 20)

	func _team_col(tm: int) -> Color:
		return main.WARD if tm == 0 else main.EMBER

	# 0.18.2: the end screen's chart — each player's income per round on one axis, name labels at the line ends,
	# your own line thickest, team-mates in the team colour tinted by the hero colour, the enemy team the same.
	func _draw_players(plot: Rect2, rounds: Array, pls: Array, f: Font, muted: Color) -> void:
		var n := rounds.size()
		if n < 2:
			draw_string(f, plot.position + Vector2(8, 20), "No rounds were played.", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, muted)
			return
		var ymax := 1.0
		for i in pls.size():
			if sim.players[i].absent:
				continue
			for v in pls[i]:
				ymax = maxf(ymax, float(v))
		var step := 50.0
		for st in [25.0, 50.0, 100.0, 200.0, 500.0, 1000.0, 2000.0, 5000.0, 10000.0]:
			step = st
			if ymax / st <= 5.0:
				break
		ymax = ceilf(ymax / step) * step
		var ymin := ymax
		for i in pls.size():
			if sim.players[i].absent:
				continue
			for v in pls[i]:
				ymin = minf(ymin, float(v))
		ymin = maxf(0.0, floorf(ymin / step) * step - step)
		if ymax - ymin < step * 2.0:
			ymin = maxf(0.0, ymax - step * 2.0)
		var xr := func(i: int) -> float: return plot.position.x + plot.size.x * float(i) / float(n - 1)
		var yv := func(v: float) -> float: return plot.position.y + plot.size.y * (1.0 - clampf((v - ymin) / (ymax - ymin), 0.0, 1.0))
		var gy := ymin
		while gy <= ymax + 0.01:
			var yy: float = yv.call(gy)
			draw_line(Vector2(plot.position.x, yy), Vector2(plot.end.x, yy), Color(1, 1, 1, 0.07), 1.0)
			draw_string(f, Vector2(4, yy + 4), ("%.1fk" % (gy / 1000.0)) if gy >= 1000.0 else str(int(gy)), HORIZONTAL_ALIGNMENT_RIGHT, 38, 10, muted)
			gy += step
		var every := 1
		while plot.size.x / float(n - 1) * every < 30.0:
			every += 1
		for i in n:
			var xx: float = xr.call(i)
			var major := int(rounds[i]) % every == 0 or i == n - 1
			draw_line(Vector2(xx, plot.end.y), Vector2(xx, plot.end.y + (5 if major else 3)), Color(1, 1, 1, 0.35 if major else 0.18), 1.0)
			if major:
				draw_line(Vector2(xx, plot.position.y), Vector2(xx, plot.end.y), Color(1, 1, 1, 0.04), 1.0)
				draw_string(f, Vector2(xx - 20, plot.end.y + 16), "R%d" % int(rounds[i]), HORIZONTAL_ALIGNMENT_CENTER, 40, 10, muted)
		# lines: enemies first, then team-mates, you last
		var order: Array = []
		for i in pls.size():
			if not sim.players[i].absent:
				order.append(i)
		var mine := int(sim.players[sim.local].team)
		var loc: int = sim.local
		order.sort_custom(func(a, b):
			if a == loc:
				return false
			if b == loc:
				return true
			return int(sim.players[a].team != mine) > int(sim.players[b].team != mine))
		var ends: Array = []
		for i0 in order:
			var i: int = int(i0)
			var pl = sim.players[i]
			var col: Color = _team_col(pl.team).lerp(Color(pl.champ.def["color"]), 0.55)
			var pts := PackedVector2Array()
			for k in n:
				pts.append(Vector2(xr.call(k), yv.call(float(pls[i][k]))))
			var me: bool = (i == loc)
			draw_polyline(pts, Color(0, 0, 0, 0.55), 4.0 if me else 3.0, true)
			draw_polyline(pts, Color(col, 1.0 if me or pl.team == mine else 0.85), 2.6 if me else 1.8, true)
			ends.append([i, pts[pts.size() - 1], float(pls[i][n - 1]), col])
		# name labels at the line ends, nudged apart
		ends.sort_custom(func(a, b): return a[1].y < b[1].y)
		var last_y := -100.0
		for e in ends:
			var y: float = maxf(float(e[1].y), last_y + 12.0)
			y = clampf(y, plot.position.y + 6, plot.end.y + 4)
			last_y = y
			var pl = sim.players[e[0]]
			var txt := "%s  +%d" % [pl.name, roundi(e[2])]
			var fnt: Font = UIParts.font("num_semi") if e[0] == loc else f
			draw_string_outline(fnt, Vector2(e[1].x + 6, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 11, 3, Color(0, 0, 0, 0.9))
			draw_string(fnt, Vector2(e[1].x + 6, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 11, Color(e[3]).lightened(0.25))

	# Income per round as [rounds: Array[int], team: [[..], [..]], players: [[..] x n]].
	func income_series() -> Array:
		var rounds: Array = []
		var team: Array = [[], []]
		var pls: Array = []
		var n: int = sim.players.size()
		for i in n:
			pls.append([])
		var hist: Array = sim.hist
		if not hist.is_empty() and hist[hist.size() - 1].has("inc") and hist[hist.size() - 1].has("round"):
			# the last sample of each round (round 0 is the setup, skipped)
			var by_round := {}
			for h in hist:
				var r := int(h["round"])
				if r >= 1:
					by_round[r] = h
			var keys := by_round.keys()
			keys.sort()
			for r in keys:
				var inc = by_round[r]["inc"]
				var ts := [0, 0]
				if inc is Array and inc.size() == n:
					for i in n:
						pls[i].append(int(inc[i]))
						if not sim.players[i].absent:
							ts[sim.players[i].team] += int(inc[i])
				elif inc is Array and inc.size() == 2:
					ts = [int(inc[0]), int(inc[1])]
					for i in n:
						pls[i].append(0)
				else:
					continue
				rounds.append(int(r))
				team[0].append(ts[0])
				team[1].append(ts[1])
		else:
			for rec in inc_rec:
				rounds.append(int(rec["round"]))
				team[0].append(int(rec["team"][0]))
				team[1].append(int(rec["team"][1]))
				var pl: Array = rec["pl"]
				for i in n:
					pls[i].append(int(pl[i]) if i < pl.size() else 0)
		return [rounds, team, pls]

	func _draw_income() -> void:
		var r := Rect2(Vector2.ZERO, size)
		if not plain:
			draw_rect(r, Color(0.05, 0.045, 0.035, 0.9))
			UIParts.framed(self, r)
		var f: Font = UIParts.font("num")
		var muted := Color(0.7, 0.65, 0.55)
		draw_string(UIParts.font("display"), Vector2(12, 22), "Income per round" if not players_main else "Income per round · every player", HORIZONTAL_ALIGNMENT_LEFT, -1, 17, UIParts.GOLD)
		if sim == null:
			return
		var ser := income_series()
		var rounds: Array = ser[0]
		var team: Array = ser[1]
		var pls: Array = ser[2]
		var plot := Rect2(46, 40, size.x - 46 - (118 if players_main else 64), size.y - 66)
		var mine := int(sim.players[sim.local].team)
		if plot.size.x < 40 or plot.size.y < 20:
			return
		if players_main:
			_draw_players(plot, rounds, pls, f, muted)
			return
		# 0.18.1: no placeholder sentence. Before two rounds are on record the graph shows the current income as a
		# flat line from the start (or the one recorded round) to "now", with the axes and the legend.
		var live := rounds.size() < 2
		if live:
			var np: int = sim.players.size()
			var ts := [0, 0]
			var cur: Array = []
			for i in np:
				cur.append(int(sim.players[i].income))
				if not sim.players[i].absent:
					ts[sim.players[i].team] += int(sim.players[i].income)
			if rounds.is_empty():
				rounds = [0]
				team = [[ts[0]], [ts[1]]]
				for i in np:
					pls[i] = [cur[i]]
			rounds.append(maxi(int(sim.round_no), int(rounds[0])))
			team[0].append(ts[0])
			team[1].append(ts[1])
			for i in np:
				pls[i].append(cur[i])
		var ymax := 1.0
		for tm in 2:
			for v in team[tm]:
				ymax = maxf(ymax, float(v))
		# a round axis top: 50 / 100 / 200 / 500 steps
		var step := 50.0
		for st in [50.0, 100.0, 200.0, 500.0, 1000.0, 2000.0, 5000.0, 10000.0, 20000.0]:
			step = st
			if ymax / st <= 5.0:
				break
		ymax = ceilf(ymax / step) * step
		# the axis starts a step under the lowest team value, so a slow climb still reads as a climb
		var ymin := ymax
		for tm in 2:
			for v in team[tm]:
				ymin = minf(ymin, float(v))
		ymin = maxf(0.0, floorf(ymin / step) * step - step)
		if ymax - ymin < step * 2.0:
			ymin = maxf(0.0, ymax - step * 2.0)
		var n := rounds.size()
		var xr := func(i: int) -> float: return plot.position.x + plot.size.x * float(i) / float(n - 1)
		var yv := func(v: float) -> float: return plot.position.y + plot.size.y * (1.0 - clampf((v - ymin) / (ymax - ymin), 0.0, 1.0))
		# grid + y labels
		var gy := ymin
		while gy <= ymax + 0.01:
			var yy: float = yv.call(gy)
			draw_line(Vector2(plot.position.x, yy), Vector2(plot.end.x, yy), Color(1, 1, 1, 0.07), 1.0)
			draw_string(f, Vector2(4, yy + 4), ("%.1fk" % (gy / 1000.0)) if gy >= 1000.0 else str(int(gy)), HORIZONTAL_ALIGNMENT_RIGHT, 38, 10, muted)
			gy += step
		# round ticks
		var every := 1
		while plot.size.x / float(n - 1) * every < 30.0:
			every += 1
		for i in n:
			var xx: float = xr.call(i)
			var major := int(rounds[i]) % every == 0 or i == n - 1
			draw_line(Vector2(xx, plot.end.y), Vector2(xx, plot.end.y + (5 if major else 3)), Color(1, 1, 1, 0.35 if major else 0.18), 1.0)
			if major:
				draw_line(Vector2(xx, plot.position.y), Vector2(xx, plot.end.y), Color(1, 1, 1, 0.04), 1.0)
				var lab := "R%d" % int(rounds[i])
				if live and i == n - 1:
					lab = "now"
				elif live and int(rounds[i]) == 0:
					lab = "start"
				draw_string(f, Vector2(xx - 20, plot.end.y + 16), lab, HORIZONTAL_ALIGNMENT_CENTER, 40, 10, muted)
		# per-player lines, thin, behind, on their own right-hand axis (a player earns a quarter of a team)
		if show_players:
			var pmax := 1.0
			for i in pls.size():
				for v in pls[i]:
					pmax = maxf(pmax, float(v))
			var pstep := 50.0
			for st in [25.0, 50.0, 100.0, 200.0, 500.0, 1000.0, 2000.0, 5000.0]:
				pstep = st
				if pmax / st <= 4.0:
					break
			# twice the round-up, so the players' lines run through the middle, clear of the team lines at the top
			pmax = ceilf(pmax / pstep) * pstep * 2.0
			for k in 3:
				var pv := pmax * k / 2.0
				var yy := plot.position.y + plot.size.y * (1.0 - k / 2.0)
				draw_string(f, Vector2(plot.end.x + 40, yy + 4), ("%.1fk" % (pv / 1000.0)) if pv >= 1000.0 else str(int(pv)), HORIZONTAL_ALIGNMENT_LEFT, 44, 10, Color(muted, 0.75))
			draw_string(f, Vector2(plot.end.x + 40, plot.end.y + 16), "each", HORIZONTAL_ALIGNMENT_LEFT, -1, 10, Color(muted, 0.75))
			for i in pls.size():
				var pl = sim.players[i]
				if pl.absent:
					continue
				var pts := PackedVector2Array()
				for k in n:
					pts.append(Vector2(xr.call(k), plot.position.y + plot.size.y * (1.0 - clampf(float(pls[i][k]) / pmax, 0.0, 1.0))))
				if pts.size() >= 2:
					draw_polyline(pts, Color(_team_col(pl.team).lerp(Color(pl.champ.def["color"]), 0.6), 0.55 if i != sim.local else 0.9), 1.2 if i != sim.local else 1.6, true)
		# team lines, local team on top
		var finals := []
		for tm in [1 - mine, mine]:
			var pts := PackedVector2Array()
			for k in n:
				pts.append(Vector2(xr.call(k), yv.call(float(team[tm][k]))))
			var col := _team_col(tm)
			var poly := PackedVector2Array(pts)
			poly.append(Vector2(pts[pts.size() - 1].x, plot.end.y))
			poly.append(Vector2(pts[0].x, plot.end.y))
			draw_colored_polygon(poly, Color(col, 0.06))
			draw_polyline(pts, Color(0, 0, 0, 0.6), 4.5 if tm == mine else 3.5, true)
			draw_polyline(pts, col, 3.0 if tm == mine else 2.0, true)
			finals.append([tm, pts[pts.size() - 1], float(team[tm][n - 1])])
		finals.sort_custom(func(a, b): return a[1].y < b[1].y)
		var last_y := -100.0
		for fv in finals:
			var y: float = maxf(float(fv[1].y), last_y + 13.0)
			y = clampf(y, plot.position.y + 6, plot.end.y)
			last_y = y
			var txt := "+%d" % roundi(fv[2])
			var col := _team_col(fv[0])
			draw_string_outline(UIParts.font("num_semi"), Vector2(fv[1].x + 5, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, 3, Color(0, 0, 0, 0.9))
			draw_string(UIParts.font("num_semi"), Vector2(fv[1].x + 5, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, col.lightened(0.2))
		# legend
		var lx := 160.0
		for tm in [mine, 1 - mine]:
			var nm: String = ("%s (you)" % Sim.TEAM_NAMES[tm]) if tm == mine else Sim.TEAM_NAMES[tm]
			draw_rect(Rect2(lx, 14, 14, 3), _team_col(tm))
			draw_string(f, Vector2(lx + 18, 20), nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 11, Color(0.9, 0.86, 0.76))
			lx += 26.0 + f.get_string_size(nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 11).x + 8.0

	func _draw() -> void:
		# 0.19: the end screen can redraw after the match's players were cleared (back to menu / next match)
		if sim == null or sim.local < 0 or sim.local >= sim.players.size():
			return
		if mode == "income":
			_draw_income()
			return
		var r := Rect2(Vector2.ZERO, size)
		draw_rect(r, Color(0.05, 0.045, 0.035, 0.9))
		UIParts.framed(self, r)
		var f: Font = UIParts.font("num")
		var muted := Color(0.7, 0.65, 0.55)
		draw_string(UIParts.font("display"), Vector2(12, 22), "Crystal health", HORIZONTAL_ALIGNMENT_LEFT, -1, 17, UIParts.GOLD)
		var hist: Array = sim.hist
		var right_pad := 92.0 if show_gold else 58.0
		var plot := Rect2(46, 40, size.x - 46 - right_pad, size.y - 68)
		if hist.size() < 2 or plot.size.x < 40 or plot.size.y < 20:
			draw_string(f, plot.get_center() - Vector2(70, 0), "Not enough data yet", HORIZONTAL_ALIGNMENT_LEFT, -1, 13, muted)
			return
		var tmax: float = maxf(float(hist[hist.size() - 1]["t"]), float(sim.t))
		tmax = maxf(tmax, 1.0)
		# grid + y labels
		for k in 5:
			var yy := plot.position.y + plot.size.y * (1.0 - k / 4.0)
			draw_line(Vector2(plot.position.x, yy), Vector2(plot.end.x, yy), Color(1, 1, 1, 0.07), 1.0)
			draw_string(f, Vector2(4, yy + 4), "%d%%" % (k * 25), HORIZONTAL_ALIGNMENT_RIGHT, 38, 10, muted)
		# round ticks
		var rl: float = maxf(1.0, float(sim.round_len))
		var px_per_round := plot.size.x * rl / tmax
		var every := 1
		while px_per_round * every < 34.0:
			every += 1
		var rn := 1
		var tt := rl
		while tt < tmax + 0.01:
			var xx := plot.position.x + plot.size.x * tt / tmax
			var major := rn % every == 0
			draw_line(Vector2(xx, plot.end.y), Vector2(xx, plot.end.y + (5 if major else 3)), Color(1, 1, 1, 0.35 if major else 0.18), 1.0)
			if major:
				draw_line(Vector2(xx, plot.position.y), Vector2(xx, plot.end.y), Color(1, 1, 1, 0.04), 1.0)
				draw_string(f, Vector2(xx - 14, plot.end.y + 16), "R%d" % rn, HORIZONTAL_ALIGNMENT_CENTER, 28, 10, muted)
			rn += 1
			tt += rl
		draw_string(f, Vector2(plot.position.x, plot.end.y + 27), "0:00", HORIZONTAL_ALIGNMENT_LEFT, -1, 10, Color(muted, 0.8))
		var secs := int(tmax)
		draw_string(f, Vector2(plot.end.x - 40, plot.end.y + 27), "%d:%02d" % [secs / 60, secs % 60], HORIZONTAL_ALIGNMENT_RIGHT, 40, 10, Color(muted, 0.8))
		# gold (thin, behind the crystal lines)
		var mine := int(sim.players[sim.local].team)
		if show_gold:
			var gmax := 1.0
			var gs: Array = [[], []]
			for h in hist:
				var sums := [0.0, 0.0]
				var g: Array = h["gold"]
				for i in mini(g.size(), sim.players.size()):
					if not sim.players[i].absent:
						sums[sim.players[i].team] += float(g[i])
				gs[0].append(sums[0])
				gs[1].append(sums[1])
				gmax = maxf(gmax, maxf(sums[0], sums[1]))
			for tm in 2:
				var pts := PackedVector2Array()
				for i in hist.size():
					pts.append(Vector2(plot.position.x + plot.size.x * float(hist[i]["t"]) / tmax, plot.position.y + plot.size.y * (1.0 - float(gs[tm][i]) / gmax)))
				if pts.size() >= 2:
					draw_polyline(pts, Color(_team_col(tm), 0.45), 1.5, true)
			for k in 3:
				var yy := plot.position.y + plot.size.y * (1.0 - k / 2.0)
				var gv := gmax * k / 2.0
				draw_string(f, Vector2(plot.end.x + 40, yy + 4), ("%.0fk" % (gv / 1000.0)) if gv >= 1000.0 else str(int(gv)), HORIZONTAL_ALIGNMENT_LEFT, 44, 10, Color(muted, 0.75))
			draw_string(f, Vector2(plot.end.x + 40, plot.end.y + 27), "gold", HORIZONTAL_ALIGNMENT_LEFT, -1, 10, Color(muted, 0.75))
		# crystal lines, local team on top
		var finals := []
		for tm in [1 - mine, mine]:
			var pts := PackedVector2Array()
			for h in hist:
				pts.append(Vector2(plot.position.x + plot.size.x * float(h["t"]) / tmax, plot.position.y + plot.size.y * (1.0 - clampf(float(h["core"][tm]), 0.0, 1.0))))
			var col := _team_col(tm)
			if pts.size() >= 2:
				# soft fill under the line
				var poly := PackedVector2Array(pts)
				poly.append(Vector2(pts[pts.size() - 1].x, plot.end.y))
				poly.append(Vector2(pts[0].x, plot.end.y))
				draw_colored_polygon(poly, Color(col, 0.06))
				draw_polyline(pts, Color(0, 0, 0, 0.6), 4.5 if tm == mine else 3.5, true)
				draw_polyline(pts, col, 3.0 if tm == mine else 2.0, true)
			finals.append([tm, pts[pts.size() - 1], float(hist[hist.size() - 1]["core"][tm])])
		# end marker
		var ex := plot.position.x + plot.size.x * minf(1.0, float(sim.t) / tmax)
		draw_line(Vector2(ex, plot.position.y), Vector2(ex, plot.end.y), Color(UIParts.GOLD_TEXT, 0.35), 1.0)
		draw_colored_polygon(PackedVector2Array([Vector2(ex, plot.position.y + 6), Vector2(ex - 4, plot.position.y - 1), Vector2(ex + 4, plot.position.y - 1)]), Color(UIParts.GOLD_TEXT, 0.8))
		# final values, nudged apart if both end close together
		finals.sort_custom(func(a, b): return a[1].y < b[1].y)
		var last_y := -100.0
		for fv in finals:
			var y: float = maxf(float(fv[1].y), last_y + 13.0)
			y = clampf(y, plot.position.y + 6, plot.end.y)
			last_y = y
			var txt := "%d%%" % roundi(fv[2] * 100.0)
			var col := _team_col(fv[0])
			draw_string_outline(UIParts.font("num_semi"), Vector2(fv[1].x + 5, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, 3, Color(0, 0, 0, 0.9))
			draw_string(UIParts.font("num_semi"), Vector2(fv[1].x + 5, y + 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, col.lightened(0.2))
		# legend
		var lx := 150.0
		for tm in [mine, 1 - mine]:
			var nm: String = ("%s (you)" % Sim.TEAM_NAMES[tm]) if tm == mine else Sim.TEAM_NAMES[tm]
			draw_rect(Rect2(lx, 14, 14, 3), _team_col(tm))
			draw_string(f, Vector2(lx + 18, 20), nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 11, Color(0.9, 0.86, 0.76))
			lx += 26.0 + f.get_string_size(nm, HORIZONTAL_ALIGNMENT_LEFT, -1, 11).x + 8.0
		if show_gold and lx < size.x - 200:
			draw_rect(Rect2(lx, 15, 14, 1.5), Color(0.9, 0.86, 0.76, 0.6))
			draw_string(f, Vector2(lx + 18, 20), "thin: gold earned per team", HORIZONTAL_ALIGNMENT_LEFT, -1, 11, Color(0.9, 0.86, 0.76, 0.7))
␀␀␀␀␀␀␀␀␀␀␀# Runs one campaign mission on top of a Sim: objectives, scripted events, the intro and outro scenes,
# allies arriving and leaving, bosses, and the mission's own victory and defeat rules.
# The HUD calls update() every frame and feed() with the sim's events before it handles them itself.
class_name MissionDirector
extends RefCounted

var ui                      # CampaignUI: bark(), play_scene(), objective toasts
var main                    # the HUD (announce, audio, minimap)
var sim: Sim
var m: Dictionary
var hero := ""
var flags := {}             # campaign flags + the ones this mission sets
var objs: Array = []        # objective dicts with "state" (active/done/failed), "hidden", "count"
var evs: Array = []         # event dicts with "fired", "last"
var later: Array = []       # [sim time, actions]
var holding := false        # a scene is playing: the match is frozen
var started := false
var result := ""            # "", "win", "lose"
var lose_reason := ""
var kills := {}             # kind -> count (our lane)
var kills_all := 0
var duel_w := 0
var duel_l := 0
var duel_best_hp := 0.0
var camp_done := false
var pulse := {}             # edge-triggered conditions seen this frame
var dead_prev := {}         # slot -> was dead
var core_min := 1.0
var drain := 0.0             # fraction of the Heartstone lost per second (a chapter's corruption)
var boss_seen := {}         # boss kind -> lowest health fraction seen (for phase triggers)


func _init(p_ui, p_main, p_sim: Sim, mission: Dictionary, p_hero: String) -> void:
	ui = p_ui
	main = p_main
	sim = p_sim
	m = mission
	hero = p_hero
	flags = Campaign.flags.duplicate()
	for o in m.get("objectives", []):
		if not CampaignData.passes(o, flags):
			continue
		var d: Dictionary = o.duplicate(true)
		d["state"] = "active"
		d["hidden"] = bool(o.get("hidden", false))
		d["count"] = 0
		if String(o["kind"]) == "channel":
			d["prog"] = []
			d["lit"] = []
			for i in o["points"].size():
				d["prog"].append(0.0)
				d["lit"].append(false)
		objs.append(d)
	for e in m.get("events", []):
		if not CampaignData.passes(e, flags):
			continue
		var d: Dictionary = e.duplicate(true)
		d["fired"] = false
		d["last"] = -999.0
		evs.append(d)


# ---------------------------------------------------------------- frame
func begin() -> void:
	var intro: Array = m.get("intro", [])
	if intro.is_empty():
		_start()
	else:
		play(intro, _start)


func _start() -> void:
	started = true
	drain = float(m.get("drain", 0.0))
	_update_floor()


# The enemy Heartstone cannot break before the chapter's other main objectives are done
# (otherwise the story would be skipped), and never in chapters that are not about breaking it.
func _update_floor() -> void:
	var destroy := false
	var pending := false
	for o in objs:
		var k := String(o["kind"])
		if k == "destroy":
			destroy = true
		elif not o.get("bonus", false) and o["state"] == "active" and k not in ["core_floor", "deadline", "before", "protect"]:
			pending = true
	if sim.round_no < int(m.get("shield_until", 0)):
		pending = true
	sim.arenas[1 - me().team].core_floor = 0.1 if (not destroy or pending) else 0.0
	_fire_matching()


func play(steps: Array, done_cb := Callable()) -> void:
	var filtered: Array = []
	for s in steps:
		if CampaignData.passes(s, flags):
			filtered.append(s)
	holding = true
	ui.play_scene(filtered, func():
		holding = false
		if done_cb.is_valid():
			done_cb.call())


func me():
	return sim.players[sim.local]


func my_ar():
	return sim.arenas[me().team]


# Called with sim.events before the HUD consumes them.
func feed(events: Array) -> void:
	if not started or result != "":
		return
	var team: int = me().team
	for e in events:
		match String(e["k"]):
			"mdie":
				if int(e.get("team", -1)) == team:
					var k := String(e.get("kind", ""))
					kills[k] = int(kills.get(k, 0)) + 1
					kills_all += 1
			"boss_down":
				pulse["boss_down:" + String(e.get("kind", ""))] = true
				flags["boss_down:" + String(e.get("kind", ""))] = true
			"duel_end":
				if e.get("human_won", false):
					duel_w += 1
					duel_best_hp = maxf(duel_best_hp, float(e.get("hp", 0.0)))
					pulse["duel_won"] = true
				elif e.get("human_lost", false):
					duel_l += 1
					pulse["duel_lost"] = true
			"duel_start":
				if e.get("human", false):
					pulse["duel_start"] = true
			"totems":
				if int(e.get("a", -1)) == team:
					pulse["totems"] = true
			"camp_cleared":
				if int(e.get("team", -1)) == team and String(e.get("kind", "ancient")) == "ancient":
					camp_done = true


func update(delta: float) -> void:
	if not started or result != "":
		return
	# hero and ally deaths
	for i in 4:
		var pl = sim.players[i]
		var dead: bool = (not pl.absent) and pl.champ.dead
		if dead and not bool(dead_prev.get(i, false)):
			pulse["dead:%d" % i] = true
			flags["died:%d" % i] = true
		dead_prev[i] = dead
	var ar = my_ar()
	core_min = minf(core_min, ar.core_hp / ar.core_max)
	if drain > 0.0 and not sim.over:
		sim.core_hit(ar, ar.core_max * drain * delta)
	_update_channels(delta)
	for mo in sim.arenas[0].mons + sim.arenas[1].mons:
		if not mo.dead and mo.d.get("boss", false):
			boss_seen[mo.kind] = minf(float(boss_seen.get(mo.kind, 1.0)), mo.hp / mo.max_hp)
	# delayed actions
	if not later.is_empty():
		var keep: Array = []
		for l in later:
			if sim.t >= float(l[0]):
				run(l[1])
			else:
				keep.append(l)
		later = keep
	_eval_objectives()
	_update_floor()
	_fire_matching()
	pulse.clear()
	_check_end()


# Standing on a channel point fills it; when full it is lit. "order": true lights them one at a time.
func _update_channels(delta: float) -> void:
	var c = me().champ
	for o in objs:
		if String(o["kind"]) != "channel" or o["state"] != "active" or o["hidden"]:
			continue
		if c.dead or c.ar != my_ar():
			continue
		for i in o["points"].size():
			if o["lit"][i]:
				continue
			var p: Vector2 = point(o["points"][i])
			if c.p.distance_to(p) <= float(o.get("r", 120.0)):
				o["prog"][i] = float(o["prog"][i]) + delta
				if float(o["prog"][i]) >= float(o.get("secs", 6.0)):
					o["lit"][i] = true
					sim.burst(my_ar(), p, Color(1.0, 0.85, 0.4), 40, 220)
					main.audio.play("level", -2.0)
					pulse["lit:%s" % o["id"]] = true
					flags["lit:%s:%d" % [o["id"], i]] = true
			if o.get("order", false):
				break


func lit_count(o: Dictionary) -> int:
	var n := 0
	for l in o.get("lit", []):
		if l:
			n += 1
	return n


# A named place on the map ("junction", "core", "lane1:0.4", ...), as the camera knows it.
func point(w) -> Vector2:
	return ui._where(w)


func _fire_matching() -> void:
	for e in evs:
		if result != "":
			return
		var once := bool(e.get("once", true))
		if once and e["fired"]:
			continue
		if not once and sim.t - float(e["last"]) < float(e.get("cd", 0.0)):
			continue
		if not _cond(e["when"], once):
			continue
		e["fired"] = true
		e["last"] = sim.t
		if e.has("delay"):
			later.append([sim.t + float(e["delay"]), e["do"]])
		else:
			run(e["do"])


func _cond(w: Dictionary, once: bool) -> bool:
	for k in w:
		var v = w[k]
		match String(k):
			"start":
				if not started:
					return false
			"round":
				if sim.round_no < int(v):
					return false
			"time":
				if sim.t < float(v):
					return false
			"boss_down":
				if not (flags.has("boss_down:" + String(v)) if once else pulse.has("boss_down:" + String(v))):
					return false
			"obj":
				if obj_state(String(v)) != "done":
					return false
			"all_obj":
				for id in v:
					if obj_state(String(id)) != "done":
						return false
			"core_below":
				var ar = my_ar()
				if ar.core_hp / ar.core_max >= float(v):
					return false
			"enemy_core_below":
				var ea = sim.arenas[1 - me().team]
				if ea.core_hp / ea.core_max >= float(v):
					return false
			"hero_dead":
				if not (flags.has("died:0") if once else pulse.has("dead:0")):
					return false
			"ally_dead":
				var key := "died:%d" % int(v)
				if not (flags.has(key) if once else pulse.has("dead:%d" % int(v))):
					return false
			"duel_won":
				if not (duel_w >= int(v) if once else pulse.has("duel_won")):
					return false
			"duel_lost":
				if not (duel_l >= int(v) if once else pulse.has("duel_lost")):
					return false
			"duel_start":
				if not pulse.has("duel_start"):
					return false
			"totems":
				if not pulse.has("totems"):
					return false
			"built":
				if me().tech < int(v):
					return false
			"flag":
				if not flags.has(String(v)):
					return false
			"boss_hp":
				# [kind, fraction]: the boss has been worn below this much health
				if float(boss_seen.get(String(v[0]), 1.0)) >= float(v[1]):
					return false
			"lit":
				# [objective, n]: that many of its channel points are lit
				if lit_count(obj(String(v[0]))) < int(v[1]):
					return false
			"kills":
				if kills_all < int(v):
					return false
			"before":
				# only before wave n
				if sim.round_no >= int(v):
					return false
			"killed":
				# [kind, n]: that many of this kind slain on your road
				if int(kills.get(String(v[0]), 0)) < int(v[1]):
					return false
			"noflag":
				# true only while this flag is NOT set (lets a repeating event stop)
				if flags.has(String(v)):
					return false
	return true


# ---------------------------------------------------------------- actions
func run(actions: Array) -> void:
	for a in actions:
		if result != "":
			return
		if not CampaignData.passes(a, flags):
			continue
		for k in a:
			if k in ["if", "unless", "if2", "unless_any"]:
				continue
			_act(String(k), a[k])


func _act(k: String, v) -> void:
	match k:
		"say":
			ui.bark(String(v[0]), String(v[1]))
		"scene":
			play(v)
		"boss":
			var team := int(v.get("team", me().team))
			var hm: float = float(v.get("hpm", 1.0)) * (1.0 + 0.06 * sim.round_no) * float(Campaign.diff_def()["waves"])
			var ar = sim.arenas[team]
			# story bosses hit the Heartstone less hard than wave bosses: the fight should be with the heroes
			var bm = sim.place_mon(ar, String(v["kind"]), int(v.get("lane", 0)), 0.01, hm)
			bm.lives = maxi(3, int(round(bm.lives * float(v.get("siege", 0.45)) * minf(1.0, float(Campaign.diff_def()["waves"])))))
			if team == me().team:
				sim.ev("boss", null, Vector2.ZERO, {"name": GameData.MON[String(v["kind"])]["name"], "kind": String(v["kind"])})
		"spawn":
			var team := int(v.get("team", me().team))
			var ar = sim.arenas[team]
			var n := int(v.get("n", 1))
			var lanes: Array = [0, 1] if int(v.get("lane", 0)) < 0 else [int(v.get("lane", 0))]
			var hm: float = float(v.get("hpm", 1.0)) * Sim.hp_mult(maxi(1, sim.round_no)) * float(Campaign.diff_def()["waves"])
			for lane in lanes:
				for i in n:
					if v.has("frac_rand"):
						# somewhere along the road (meteors, ambushes)
						var fr: float = sim.rng.randf_range(float(v["frac_rand"][0]), float(v["frac_rand"][1]))
						var mo = sim.place_mon(ar, String(v["kind"]), lane, fr, hm)
						if v.get("fx", "") == "meteor":
							sim.burst(ar, mo.p, Color(0.75, 0.55, 1.0), 36, 260)
							sim.add_fx(ar, {"type": "ring", "p": mo.p, "r": 90.0, "col": Color(0.7, 0.5, 1.0), "t": 0.7, "dur": 0.7, "fill": true})
							if team == me().team:
								main.audio.play("boom", -8.0)
					elif v.has("frac"):
						sim.place_mon(ar, String(v["kind"]), lane, float(v["frac"]), hm)
					else:
						ar.spawn_q.append([sim.t + float(v.get("delay", 0.3)) + i * 0.6, String(v["kind"]), lane, null, hm])
		"join":
			var slot := int(v)
			var pl = sim.players[slot]
			sim.activate_slot(slot, Sim.HOMES[pl.champ.home])
			main.minimap.ping(Sim.HOMES[pl.champ.home], Color(0.5, 1.0, 0.6), me().team)
		"leave":
			var pl = sim.players[int(v)]
			if not pl.absent:
				pl.absent = true
				var c = pl.champ
				c.ar.champs.erase(c)
				sim.burst(c.ar, c.p, Color(1, 0.9, 0.6), 30, 160)
		"obj_show":
			var o := obj(String(v))
			if not o.is_empty() and o["hidden"]:
				o["hidden"] = false
				ui.objective_note("New objective", o["text"], false)
		"obj_done":
			_set_obj(String(v), "done")
		"obj_fail":
			_set_obj(String(v), "failed")
		"gold":
			me().gold += float(v)
		"flag":
			flags[String(v)] = true
		"win":
			finish("win")
		"lose":
			lose_reason = String(v)
			finish("lose")
		"core":
			var ar = my_ar()
			ar.core_hp = minf(ar.core_max, ar.core_hp + ar.core_max * float(v))
		"core_lv":
			var ar = my_ar()
			ar.core_lv[int(v[0])] = maxi(ar.core_lv[int(v[0])], int(v[1]))
		"music":
			ui.set_music(String(v))
		"announce":
			main.announce(String(v[0]), String(v[1]))
		"waves":
			sim.waves_on = bool(v)
		"duel":
			if not sim.duel_on:
				sim.duel_no = 0
				sim.start_duel()
		"ping":
			main.minimap.ping(point(v), Color(1, 0.85, 0.3), me().team)
		"drain":
			drain = float(v)
		"rally":
			# 0.21: the Ward's AI heroes answer a call ("crystal": back to the Heartstone, "boss", "help") for
			# Sim.CMD_TIME seconds, like the player's own F1-F3 orders
			sim.command(me().team, String(v), point("core") if String(v) == "crystal" else me().champ.p)
		"surge":
			# [multiplier, seconds]: every monster on your road moves faster for a while
			var ar = my_ar()
			ar.surge = float(v[0])
			ar.surge_t = float(v[1])
		"boss_heal":
			# [kind, fraction of its health]
			for ar in sim.arenas:
				for mo in ar.mons:
					if not mo.dead and mo.kind == String(v[0]):
						mo.hp = minf(mo.max_hp, mo.hp + mo.max_hp * float(v[1]))
						sim.burst(ar, mo.p, Color(0.6, 1.0, 0.7), 30, 180)
		"boss_enrage":
			# [kind, multiplier]: harder and faster
			for mo in sim.arenas[0].mons + sim.arenas[1].mons:
				if not mo.dead and mo.kind == String(v[0]):
					mo.dps *= float(v[1])
					mo.spd *= sqrt(float(v[1]))
		"weaken":
			# [slot, multiplier]: a hero grows weaker (or stronger, above 1) mid-chapter
			var wc = sim.players[int(v[0])].champ
			wc.pow *= float(v[1])
			wc.hp_base *= float(v[1])
			sim.recalc_items(wc)
			wc.hp = minf(wc.hp, wc.max_hp)
			sim.burst(wc.ar, wc.p, Color(1.0, 0.6, 0.3) if float(v[1]) < 1.0 else Color(0.6, 0.9, 1.0), 40, 220)
		"hero_heal":
			var c = me().champ
			if not c.dead:
				c.hp = minf(c.max_hp, c.hp + c.max_hp * float(v))


# ---------------------------------------------------------------- objectives
func obj(id: String) -> Dictionary:
	for o in objs:
		if o["id"] == id:
			return o
	return {}


func obj_state(id: String) -> String:
	var o := obj(id)
	return "" if o.is_empty() else String(o["state"])


func _set_obj(id: String, st: String) -> void:
	var o := obj(id)
	if o.is_empty() or o["state"] != "active":
		return
	o["state"] = st
	o["hidden"] = false
	if st == "done":
		ui.objective_note("Bonus complete" if o.get("bonus", false) else "Objective complete", o["text"], true)
	else:
		ui.objective_fail(o["text"], o.get("bonus", false))
		if not o.get("bonus", false):
			lose_reason = "Objective failed: " + String(o["text"])
			finish("lose")


func _lane_clear() -> bool:
	var ar = my_ar()
	if not ar.spawn_q.is_empty():
		return false
	for mo in ar.mons:
		if not mo.dead and not mo.d.get("camp", false) and mo.spd > 0.0:
			return false
	return true


func progress_text(o: Dictionary) -> String:
	match String(o["kind"]):
		"survive":
			return "wave %d/%d" % [mini(sim.round_no, int(o["n"])), int(o["n"])]
		"kill":
			return "%d/%d" % [mini(int(o["count"]), int(o["n"])), int(o["n"])]
		"send":
			return "%d/%d" % [mini(int(o["count"]), int(o["n"])), int(o["n"])]
		"duel_win":
			var t := "%d/%d" % [duel_w, int(o["n"])]
			if o.has("lose"):
				t += ", lost %d/%d" % [duel_l, int(o["lose"])]
			return t
		"core_floor":
			var ar = my_ar()
			return "now %d%%" % roundi(ar.core_hp / ar.core_max * 100.0)
		"deadline", "before":
			return "wave %d/%d" % [sim.round_no, int(o["n"])]
		"level":
			return "level %d/%d" % [me().champ.lvl, int(o["n"])]
		"items", "core_up":
			return "%d/%d" % [mini(int(o["count"]), int(o["n"])), int(o["n"])]
		"channel":
			var best := 0.0
			for i in o["points"].size():
				if not o["lit"][i]:
					best = maxf(best, float(o["prog"][i]) / float(o.get("secs", 6.0)))
			var need := int(o.get("n", o["points"].size()))
			return "%d/%d%s" % [lit_count(o), need, ("  ·  %d%%" % roundi(best * 100.0)) if best > 0.0 else ""]
	return ""


func _eval_objectives() -> void:
	var p = me()
	var ar = my_ar()
	for o in objs:
		if o["state"] != "active":
			continue
		match String(o["kind"]):
			"survive":
				# done once wave n is beaten (its road is clear), or at the latest when the next wave begins
				if sim.round_no > int(o["n"]) or (sim.round_no >= int(o["n"]) and _lane_clear()):
					_set_obj(o["id"], "done")
			"boss":
				if flags.has("boss_down:" + String(o["target"])):
					_set_obj(o["id"], "done")
			"kill":
				var tg: Array = o.get("target", [])
				var n := 0
				if tg.is_empty():
					n = kills_all
				else:
					for k in tg:
						n += int(kills.get(k, 0))
				o["count"] = n
				if n >= int(o["n"]):
					_set_obj(o["id"], "done")
				elif o.has("by_round") and sim.round_no >= int(o["by_round"]):
					_set_obj(o["id"], "failed")
			"core_floor":
				if ar.core_hp / ar.core_max < float(o["n"]):
					_set_obj(o["id"], "failed")
			"build":
				if p.tech >= int(o["n"]):
					_set_obj(o["id"], "done")
			"send":
				var total := 0
				for k in p.send_n:
					total += int(p.send_n[k])
				o["count"] = total
				if total >= int(o["n"]):
					_set_obj(o["id"], "done")
			"level":
				if p.champ.lvl >= int(o["n"]):
					_set_obj(o["id"], "done")
			"channel":
				o["count"] = lit_count(o)
				if lit_count(o) >= int(o.get("n", o["points"].size())):
					_set_obj(o["id"], "done")
			"items":
				o["count"] = p.champ.items.size()
				if p.champ.items.size() >= int(o["n"]):
					_set_obj(o["id"], "done")
			"core_up":
				o["count"] = p.core_buys
				if p.core_buys >= int(o["n"]):
					_set_obj(o["id"], "done")
			"protect":
				if flags.has("died:%d" % int(o["n"])):
					_set_obj(o["id"], "failed")
			"duel_win":
				if duel_w >= int(o["n"]):
					_set_obj(o["id"], "done")
				elif o.has("lose") and duel_l >= int(o["lose"]):
					_set_obj(o["id"], "failed")
			"duel_hp":
				if duel_best_hp > float(o["n"]):
					_set_obj(o["id"], "done")
			"deadline":
				if sim.round_no >= int(o["n"]):
					_set_obj(o["id"], "failed")
			"before":
				if sim.round_no >= int(o["n"]):
					_set_obj(o["id"], "failed")
			"camp":
				if camp_done:
					_set_obj(o["id"], "done")
			"flag":
				if flags.has(String(o["target"])):
					_set_obj(o["id"], "done")


func _check_end() -> void:
	if result != "":
		return
	for o in objs:
		if not o.get("bonus", false) and o["state"] != "done" and String(o["kind"]) != "deadline":
			return
	finish("win")


# The sim ended by itself (a Heartstone broke).
func on_sim_over() -> void:
	if result != "":
		return
	if sim.winner == me().team:
		for o in objs:
			if String(o["kind"]) == "destroy":
				o["state"] = "done"
		finish("win")
	else:
		lose_reason = "The Heartstone has fallen."
		finish("lose")


func finish(r: String) -> void:
	if result != "":
		return
	result = r
	if r == "win":
		for o in objs:
			if o["state"] == "active":
				var k := String(o["kind"])
				if k in ["core_floor", "deadline", "before", "protect"]:
					o["state"] = "done"
				elif k == "destroy":
					o["state"] = "done"
				elif o.get("bonus", false):
					o["state"] = "failed"
	sim.over = true
	if sim.winner < 0:
		sim.winner = me().team if r == "win" else 1 - me().team


func stars() -> int:
	if result != "win":
		return 0
	var s := 1
	for o in objs:
		if o.get("bonus", false) and o["state"] == "done":
			s += 1
	return mini(3, s)


# Flags this mission adds to the campaign (only kept on a win).
func new_flags() -> Dictionary:
	var out := {}
	for f in flags:
		if not Campaign.flags.has(f) and not String(f).begins_with("died:") and not String(f).begins_with("boss_down:"):
			out[f] = true
	return out
␀␀␀␀␀␀␀␀␀# Loads the 3D models (art/models3d/<name>.glb, exported from Blender by tools/blender/export_glb.py)
# and builds what the 3D view needs: one merged mesh per animated node with the game's materials,
# and every pose (walk/flap 0-2, wind-up 3, strike 4) as node transforms from art_src/models.json.
class_name Models3D
extends RefCounted

const DIR := "res://art/models3d/"
# (noise scale, ramp low, ramp high, bump) per surface kind, matching the Blender renderer
const TEX := {
	"plain": [4.0, 0.92, 1.04, 0.02], "skin": [6.0, 0.86, 1.06, 0.06], "cloth": [18.0, 0.8, 1.08, 0.12],
	"leather": [9.0, 0.75, 1.1, 0.15], "metal": [5.0, 0.82, 1.12, 0.05], "gold": [5.0, 0.85, 1.12, 0.04],
	"stone": [5.0, 0.62, 1.18, 0.45], "wood": [3.0, 0.7, 1.12, 0.25], "bark": [7.0, 0.55, 1.15, 0.6],
	"leaf": [11.0, 0.62, 1.22, 0.55], "fur": [26.0, 0.68, 1.14, 0.35], "bone": [6.0, 0.82, 1.06, 0.12],
	"scale": [10.0, 0.68, 1.16, 0.4], "slime": [3.0, 0.8, 1.2, 0.08], "crystal": [2.0, 0.85, 1.25, 0.05],
	"ghost": [4.0, 0.75, 1.25, 0.0], "dirt": [8.0, 0.65, 1.15, 0.4], "moss": [16.0, 0.65, 1.2, 0.5],
	"roof": [4.0, 0.75, 1.12, 0.3], "thatch": [30.0, 0.65, 1.15, 0.5], "rune": [4.0, 0.9, 1.1, 0.0],
	"paving": [7.0, 0.9, 1.05, 0.12],   # 0.47.1: bridge decks (stone's high contrast read as camouflage on a big flat deck)
}

static var _data := {}             # model name -> models.json entry
static var _templates := {}        # model name -> template dict (or {} when missing)
static var _merged := {}           # model name -> ArrayMesh of the whole model in pose 0
static var _shader: Shader
static var _shader_alpha: Shader
static var _shader_packed: Shader   # the unit shader reading its material from vertex attributes (see _pack)
static var _packed_mat: ShaderMaterial
static var lods := true             # build simplified LOD meshes for models (the viewport picks them by size)
static var _mats := {}


static func _ensure_data() -> void:
	if not _data.is_empty():
		return
	var txt := FileAccess.get_file_as_string("res://art_src/models.json")
	if txt == "":
		return
	var d = JSON.parse_string(txt)
	for m in d["models"]:
		_data[m["name"]] = m
	_shader = Shader.new()
	_shader_packed = Shader.new()
	_shader_alpha = Shader.new()
	_packed_mat = ShaderMaterial.new()
	_packed_mat.shader = _shader_packed
	_build_shaders()


static var cheap := false   # Low preset: one octave of surface noise instead of three (cheaper pixels)


static func set_cheap(on: bool) -> void:
	if on == cheap:
		return
	cheap = on
	if _shader != null:
		_build_shaders()


static func _build_shaders() -> void:
	# read the source rather than load() it: loading would compile the Forward+ version on Compatibility
	var code := FileAccess.get_file_as_string("res://shaders/unit3d.gdshader")
	if compat():
		# the Compatibility renderer has no per-instance uniforms: tints, skins and (0.26) the hit flash become
		# cached material variants there (_set_variant)
		code = code.replace("instance uniform", "uniform")
		# and no glow: use the hue-safe emission knee that stays below 1.0
		code = code.replace("#define HDR_EMIT\n", "\n")
	if cheap:
		code = code.replace("\treturn 0.55 * vnoise(p) + 0.3 * vnoise(p * 2.03 + 7.1) + 0.15 * vnoise(p * 4.1 + 3.3);", "\treturn vnoise(p);")
	_shader.code = code
	# packed: every opaque material of a model node merged into one surface; the per-material values ride
	# in CUSTOM0 (albedo, noise scale), CUSTOM1 (lo, hi, bump, rough) and CUSTOM2 (metal, emit)
	var pk := code
	for u in ["uniform vec3 albedo : source_color = vec3(0.7);", "uniform float lo = 0.9;", "uniform float hi = 1.05;", "uniform float nscale = 4.0;",
			"uniform float bump = 0.0;", "uniform float rough = 0.7;", "uniform float metal = 0.0;", "uniform float emit = 0.0;", "uniform float is_unit = 0.0;"]:
		var parts: PackedStringArray = u.split(" ")
		pk = pk.replace(u, "varying flat %s %s;" % [parts[1], parts[2]])
	pk = pk.replace("void vertex() {\n\topos = VERTEX;", "void vertex() {\n\topos = VERTEX;\n\talbedo = CUSTOM0.rgb;\n\tnscale = CUSTOM0.a;\n\tlo = CUSTOM1.r;\n\thi = CUSTOM1.g;\n\tbump = CUSTOM1.b;\n\trough = CUSTOM1.a;\n\tmetal = CUSTOM2.r;\n\temit = CUSTOM2.g;\n\tis_unit = CUSTOM2.b;")
	# ---- 0.44 perf ---- the crowd MultiMesh (ArenaView): the packed shader also takes a tint from the instance
	# colour and a hit flash from the instance custom data, so one draw call carries every still monster of a
	# kind. A plain mesh instance has no colour array (COLOR = white) and no custom data (0): nothing changes for it.
	pk = pk.replace("varying vec3 opos;", "varying vec3 opos;\nvarying flat vec4 mm_tint;\nvarying flat float mm_flash;")
	pk = pk.replace("void vertex() {\n\topos = VERTEX;", "void vertex() {\n\topos = VERTEX;\n\tmm_tint = COLOR;\n\tmm_flash = INSTANCE_CUSTOM.r;")
	pk = pk.replace("\tc *= tint.rgb;", "\tc *= tint.rgb * mm_tint.rgb;")
	pk = pk.replace("(c * 0.45 + 0.55) * flash * 0.62", "(c * 0.45 + 0.55) * (flash + mm_flash) * 0.62")
	# ---- end 0.44 perf ----
	_shader_packed.code = pk
	_shader_alpha.code = code.replace("//ALPHA", "ALPHA = tint.a * alpha;").replace("uniform float rim = 0.25;", "uniform float rim = 0.25;\nuniform float alpha = 1.0;").replace("depth_draw_opaque", "depth_draw_never")


static func data(name: String) -> Dictionary:
	_ensure_data()
	return _data.get(name, {})


static func exists(name: String) -> bool:
	return ResourceLoader.exists(DIR + name + ".glb")


# Blender (x, y, z) with Z up -> Godot (x, z, -y) with Y up.
static func conv(a: Array) -> Transform3D:
	var bx := Vector3(a[0], a[4], a[8])
	var by := Vector3(a[1], a[5], a[9])
	var bz := Vector3(a[2], a[6], a[10])
	var t := Vector3(a[3], a[7], a[11])
	var cv := func(v: Vector3) -> Vector3: return Vector3(v.x, v.z, -v.y)
	# columns of the converted basis: C * M * C^-1 applied to the Godot axes
	var gx: Vector3 = cv.call(bx)
	var gy: Vector3 = cv.call(bz)
	var gz: Vector3 = -cv.call(by)
	return Transform3D(Basis(gx, gy, gz), cv.call(t))


static func material(model: String, key: String) -> Material:
	var md := data(model)
	var mats: Dictionary = md.get("mats", {})
	var p: Dictionary = mats.get(key, {})
	var unit := String(md.get("category", "")) == "unit"
	var ck := JSON.stringify(p) + ("|u" if unit else "")
	if _mats.has(ck):
		return _mats[ck]
	var alpha := float(p.get("alpha", 1.0))
	var m := ShaderMaterial.new()
	m.shader = _shader_alpha if alpha < 0.999 else _shader
	var col: Array = p.get("col", [0.7, 0.7, 0.7])
	var tx: Array = TEX.get(String(p.get("tex", "plain")), TEX["plain"])
	m.set_shader_parameter("albedo", Color(col[0], col[1], col[2]))
	m.set_shader_parameter("nscale", tx[0] * 0.5)
	m.set_shader_parameter("lo", tx[1])
	m.set_shader_parameter("hi", tx[2])
	m.set_shader_parameter("bump", tx[3])
	m.set_shader_parameter("rough", float(p.get("rough", 0.7)))
	m.set_shader_parameter("metal", float(p.get("metal", 0.0)))
	m.set_shader_parameter("emit", float(p.get("emit", 0.0)))
	if alpha < 0.999:
		m.set_shader_parameter("alpha", alpha)
	m.set_shader_parameter("is_unit", 1.0 if unit else 0.0)
	if String(p.get("tex", "")) == "ghost":
		m.set_shader_parameter("emit", 0.5)
	_mats[ck] = m
	return m


static func _mat_key(model: String, mat: Material, md: Dictionary) -> String:
	var nm := mat.resource_name if mat != null else ""
	var dot := nm.rfind(".")
	if dot > 0 and nm.substr(dot + 1).is_valid_int():
		nm = nm.substr(0, dot)
	if nm.begins_with(model + "_"):
		var k := nm.substr(model.length() + 1)
		if md["mats"].has(k):
			return k
	# names from another model (shared materials): match by the tail
	for k in md["mats"]:
		if nm.ends_with("_" + k):
			return k
	return md["mats"].keys()[0] if not md["mats"].is_empty() else ""


# {"nodes": {nid: ArrayMesh}, "rest": {nid: Transform3D}, "poses": [{nid: Transform3D}], "md": Dictionary}
static func template(name: String) -> Dictionary:
	if _templates.has(name):
		return _templates[name]
	var md := data(name)
	var out := {}
	if md.is_empty() or not exists(name):
		_templates[name] = out
		return out
	var ps: PackedScene = load(DIR + name + ".glb")
	var root := ps.instantiate()
	var nodes := {}
	var rest := {}
	_collect(root, name, md, nodes, rest)
	root.free()
	var poses: Array = []
	for pw in md["pose_world"]:
		var d := {}
		for nid in pw:
			d[nid] = conv(pw[nid])
		poses.append(d)
	out = {"nodes": nodes, "rest": rest, "poses": poses, "md": md}
	_templates[name] = out
	return out


static func _collect(n: Node, model: String, md: Dictionary, nodes: Dictionary, rest: Dictionary) -> void:
	if n.name.begins_with("n_") and n is Node3D:
		var nid := String(n.name).substr(2)
		var surfs: Array = []   # [arrays, material]
		for ch in n.get_children():
			if ch is MeshInstance3D and ch.mesh != null:
				var mi: MeshInstance3D = ch
				for si in mi.mesh.get_surface_count():
					var arrays := mi.mesh.surface_get_arrays(si)
					if mi.transform != Transform3D.IDENTITY:
						var vs: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
						var ns = arrays[Mesh.ARRAY_NORMAL]
						for i in vs.size():
							vs[i] = mi.transform * vs[i]
						arrays[Mesh.ARRAY_VERTEX] = vs
						if ns != null:
							var nn: PackedVector3Array = ns
							for i in nn.size():
								nn[i] = (mi.transform.basis * nn[i]).normalized()
							arrays[Mesh.ARRAY_NORMAL] = nn
					arrays[Mesh.ARRAY_TANGENT] = null
					surfs.append([arrays, material(model, _mat_key(model, mi.mesh.surface_get_material(si), md))])
		var am := _pack(surfs, packable(model))
		if am.get_surface_count() > 0:
			nodes[nid] = am
		rest[nid] = (n as Node3D).transform
	for ch in n.get_children():
		_collect(ch, model, md, nodes, rest)


# Models whose surfaces are looked up by material elsewhere keep one surface per material
# (MonFx tints the summoned wolf's fur by swapping its body materials).
static func packable(model: String) -> bool:
	return not model.begins_with("sum_")


# 32-bit floats: half-float custom attributes misread on the Compatibility renderer (tested)
const CUSTOM_FMT := (Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM0_SHIFT) | (Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM1_SHIFT) | (Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM2_SHIFT)


# `unit` repeated n times (by doubling: a handful of appends per surface, not one per vertex).
static func _repeat(unit: PackedFloat32Array, n: int) -> PackedFloat32Array:
	if n <= 0:
		return PackedFloat32Array()
	var out := unit.duplicate()
	while out.size() < unit.size() * n:
		out.append_array(out)
	out.resize(unit.size() * n)
	return out


# Builds a node's mesh from [arrays, material] surfaces. Packed: all opaque unit-shader surfaces become one
# surface (one draw call instead of one per material) drawn by the packed shader, which reads each
# triangle's material values from its vertices; translucent ones stay separate. Then LODs are added.
static func _pack(surfs: Array, pack: bool) -> ArrayMesh:
	var out: Array = []
	var opaque: Array = []
	for sf in surfs:
		var m: Material = sf[1]
		if pack and m is ShaderMaterial and (m as ShaderMaterial).shader == _shader:
			opaque.append(sf)
		else:
			out.append([sf[0], m, 0])
	if not opaque.is_empty():
		var vs := PackedVector3Array()
		var ns := PackedVector3Array()
		var idx := PackedInt32Array()
		var c0 := PackedFloat32Array()
		var c1 := PackedFloat32Array()
		var c2 := PackedFloat32Array()
		for sf in opaque:
			var a: Array = sf[0]
			var m: ShaderMaterial = sf[1]
			var base := vs.size()
			var sv: PackedVector3Array = a[Mesh.ARRAY_VERTEX]
			vs.append_array(sv)
			if a[Mesh.ARRAY_NORMAL] != null:
				ns.append_array(a[Mesh.ARRAY_NORMAL])
			else:
				for i in sv.size():
					ns.append(Vector3.UP)
			var si = a[Mesh.ARRAY_INDEX]
			if si != null and (si as PackedInt32Array).size() > 0:
				for i in si:
					idx.append(base + i)
			else:
				for i in sv.size():
					idx.append(base + i)
			# a source_color uniform is linearised by Forward+ and used as is by Compatibility: match each
			var alb: Color = Color(m.get_shader_parameter("albedo"))
			if not compat():
				alb = alb.srgb_to_linear()
			var v0 := [alb.r, alb.g, alb.b, float(m.get_shader_parameter("nscale"))]
			var v1 := [float(m.get_shader_parameter("lo")), float(m.get_shader_parameter("hi")), float(m.get_shader_parameter("bump")), float(m.get_shader_parameter("rough"))]
			var iu = m.get_shader_parameter("is_unit")   # unset on materials made outside material() (ProcProps)
			var v2 := [float(m.get_shader_parameter("metal")), float(m.get_shader_parameter("emit")), float(iu) if iu != null else 0.0, 0.0]
			c0.append_array(_repeat(PackedFloat32Array(v0), sv.size()))
			c1.append_array(_repeat(PackedFloat32Array(v1), sv.size()))
			c2.append_array(_repeat(PackedFloat32Array(v2), sv.size()))
		var arr := []
		arr.resize(Mesh.ARRAY_MAX)
		arr[Mesh.ARRAY_VERTEX] = vs
		arr[Mesh.ARRAY_NORMAL] = ns
		arr[Mesh.ARRAY_INDEX] = idx
		arr[Mesh.ARRAY_CUSTOM0] = c0
		arr[Mesh.ARRAY_CUSTOM1] = c1
		arr[Mesh.ARRAY_CUSTOM2] = c2
		out.push_front([arr, _packed_mat, CUSTOM_FMT])
	if out.is_empty():
		return ArrayMesh.new()
	return _finish(out)


# The surfaces as one ArrayMesh. With lods on, simplified LOD index arrays (meshoptimizer, via ImporterMesh)
# are built on a worker thread and swapped into the same mesh when ready (poll_lods): the full mesh is
# unchanged, the renderer picks a coarser index list once a model is small on screen, and a new model never
# stalls the frame it first appears in.
static func _finish(list: Array) -> ArrayMesh:
	var am := ArrayMesh.new()
	for sf in list:
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, sf[0], [], {}, sf[2])
		am.surface_set_material(am.get_surface_count() - 1, sf[1])
	if lods and DisplayServer.get_name() != "headless":
		var job := {"mesh": am, "data": [], "out": []}
		for sf in list:
			job["data"].append([sf[0], sf[2]])
		job["task"] = WorkerThreadPool.add_task(_lod_job.bind(job), false, "model LODs")
		_lod_jobs.append(job)
	return am


static var _lod_jobs: Array = []


# Worker thread: plain arrays in, plain arrays out (no resources touch the RenderingServer here).
static func _lod_job(job: Dictionary) -> void:
	var im := ImporterMesh.new()
	for d in job["data"]:
		im.add_surface(Mesh.PRIMITIVE_TRIANGLES, d[0], [], {}, null, "", d[1])
	im.generate_lods(25.0, 60.0, [])
	var out: Array = []
	for i in im.get_surface_count():
		var ld := {}
		for l in im.get_surface_lod_count(i):
			ld[im.get_surface_lod_size(i, l)] = im.get_surface_lod_indices(i, l)
		out.append([im.get_surface_arrays(i), ld])
	job["out"] = out


# Main thread, once a frame (ArenaView): swaps finished LOD sets into their meshes.
static func poll_lods(budget := 6) -> void:
	var i := 0
	while i < _lod_jobs.size() and budget > 0:
		var job: Dictionary = _lod_jobs[i]
		if not WorkerThreadPool.is_task_completed(job["task"]):
			i += 1
			continue
		WorkerThreadPool.wait_for_task_completion(job["task"])
		_lod_jobs.remove_at(i)
		budget -= 1
		var am: ArrayMesh = job["mesh"]
		var out: Array = job["out"]
		if out.size() != am.get_surface_count():
			continue
		var mats: Array = []
		for si in am.get_surface_count():
			mats.append(am.surface_get_material(si))
		am.clear_surfaces()
		for si in out.size():
			am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, out[si][0], [], out[si][1], job["data"][si][1])
			am.surface_set_material(si, mats[si])


# The whole model as one mesh in its rest pose (for props drawn with MultiMesh).
static func merged(name: String) -> ArrayMesh:
	if _merged.has(name):
		return _merged[name]
	if ProcProps.overrides(name) or (not exists(name) and ProcProps.has(name)):
		_merged[name] = ProcProps.build(name)
		return _merged[name]
	var tp := template(name)
	if tp.is_empty():
		_merged[name] = null
		return null
	var pose: Dictionary = tp["poses"][0] if not tp["poses"].is_empty() else tp["rest"]
	# one surface for every packed (opaque) part of the model, one per translucent material
	var packed: Array = []
	var others: Array = []
	for nid in tp["nodes"]:
		var src: ArrayMesh = tp["nodes"][nid]
		var tr: Transform3D = pose.get(nid, tp["rest"].get(nid, Transform3D.IDENTITY))
		for si in src.get_surface_count():
			var arrays := src.surface_get_arrays(si)
			var vs: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
			for i in vs.size():
				vs[i] = tr * vs[i]
			arrays[Mesh.ARRAY_VERTEX] = vs
			var ns = arrays[Mesh.ARRAY_NORMAL]
			if ns != null:
				var nn: PackedVector3Array = ns
				for i in nn.size():
					nn[i] = (tr.basis * nn[i]).normalized()
				arrays[Mesh.ARRAY_NORMAL] = nn
			var m := src.surface_get_material(si)
			if m == _packed_mat:
				packed.append(arrays)
			else:
				others.append([arrays, m, 0])
	var list: Array = []
	if not packed.is_empty():
		list.append([_concat(packed), _packed_mat, CUSTOM_FMT])
	list.append_array(others)
	var am: ArrayMesh = _finish(list) if not list.is_empty() else ArrayMesh.new()
	_merged[name] = am
	return am


# Joins packed surfaces (vertex, normal, index, CUSTOM0-2) into one.
static func _concat(list: Array) -> Array:
	var out := []
	out.resize(Mesh.ARRAY_MAX)
	var vs := PackedVector3Array()
	var ns := PackedVector3Array()
	var idx := PackedInt32Array()
	var cs := [PackedFloat32Array(), PackedFloat32Array(), PackedFloat32Array()]
	for a in list:
		var base := vs.size()
		vs.append_array(a[Mesh.ARRAY_VERTEX])
		ns.append_array(a[Mesh.ARRAY_NORMAL])
		var ia: PackedInt32Array = a[Mesh.ARRAY_INDEX]
		for i in ia:
			idx.append(base + i)
		for k in 3:
			cs[k].append_array(a[Mesh.ARRAY_CUSTOM0 + k])
	out[Mesh.ARRAY_VERTEX] = vs
	out[Mesh.ARRAY_NORMAL] = ns
	out[Mesh.ARRAY_INDEX] = idx
	out[Mesh.ARRAY_CUSTOM0] = cs[0]
	out[Mesh.ARRAY_CUSTOM1] = cs[1]
	out[Mesh.ARRAY_CUSTOM2] = cs[2]
	return out


# A posable instance: a Node3D with one MeshInstance3D per animated node.
static func instance(name: String) -> Node3D:
	var tp := template(name)
	var root := Node3D.new()
	if tp.is_empty():
		var mi := MeshInstance3D.new()
		var cap := CapsuleMesh.new()
		cap.radius = 0.35
		cap.height = 1.6
		mi.mesh = cap
		mi.position = Vector3(0, 0.8, 0)
		root.add_child(mi)
		root.set_meta("parts", {})
		return root
	var parts := {}
	for nid in tp["nodes"]:
		var mi := MeshInstance3D.new()
		mi.mesh = tp["nodes"][nid]
		mi.transform = tp["poses"][0].get(nid, tp["rest"].get(nid, Transform3D.IDENTITY)) if not tp["poses"].is_empty() else tp["rest"][nid]
		root.add_child(mi)
		parts[nid] = mi
	root.set_meta("parts", parts)
	root.set_meta("model", name)
	return root


# Poses an instance between two poses (f = 0..1).
static func pose(inst: Node3D, p0: int, p1: int, f: float) -> void:
	var tp := template(String(inst.get_meta("model", "")))
	if tp.is_empty() or tp["poses"].is_empty():
		return
	var poses: Array = tp["poses"]
	p0 = clampi(p0, 0, poses.size() - 1)
	p1 = clampi(p1, 0, poses.size() - 1)
	var a: Dictionary = poses[p0]
	var b: Dictionary = poses[p1]
	var parts: Dictionary = inst.get_meta("parts")
	for nid in parts:
		if a.has(nid):
			var ta: Transform3D = a[nid]
			parts[nid].transform = ta if p0 == p1 or not b.has(nid) else ta.interpolate_with(b[nid], f)


static func compat() -> bool:
	return RenderingServer.get_rendering_device() == null


static func set_param(inst: Node3D, pname: String, v) -> void:
	if compat():
		if pname == "flash":
			# 0.26: the hit flash reaches Compatibility too, in half steps (0, 0.5, 1, 1.5) so the cached variant
			# materials stay few; nothing is rebuilt per hit once a model has flashed once
			v = snappedf(clampf(float(v), 0.0, 1.5), 0.5)
			var cur: Dictionary = inst.get_meta("variant", {})
			if float(cur.get("flash", 0.0)) == float(v):
				return
		if pname in VARIANT_PARAMS:
			_set_variant(inst, pname, v)
		return
	for mi in inst.get_children():
		if mi is GeometryInstance3D:
			mi.set_instance_shader_parameter(pname, v)


# ---- 0.44 rewards ----
# set_param for a lone MeshInstance3D (the crystal and castle props): the same per-instance uniform in Forward+, a
# cached material variant on Compatibility.
static func set_param_mi(mi: MeshInstance3D, pname: String, v) -> void:
	if not compat():
		mi.set_instance_shader_parameter(pname, v)
		return
	var vs: Dictionary = mi.get_meta("variant", {}).duplicate()
	vs[pname] = v
	mi.set_meta("variant", vs)
	var vkey := ""
	for k in VARIANT_PARAMS:
		if vs.has(k):
			vkey += "%s=%s;" % [k, str(vs[k])]
	if mi.mesh == null:
		return
	for si in mi.mesh.get_surface_count():
		var base: Material = mi.mesh.surface_get_material(si)
		if base is ShaderMaterial:
			mi.set_surface_override_material(si, _variant_mat(base, vs, vkey))


# ---------------------------------------------------------------- colour variants in Compatibility
# Compatibility has no per-instance uniforms (tint/skin become plain material uniforms), so a variant
# (a tinted monster, a hero skin, the grey wave tint) gets its own cached duplicate of each material
# with those uniforms set, keyed by base material and variant values, applied as surface overrides.
const VARIANT_PARAMS := ["tint", "skin", "skin2", "skin3", "flash"]   # 0.44 rewards: skin3 (rim glow, sheen hue)
static var _variant_mats := {}


static func _set_variant(inst: Node3D, pname: String, v) -> void:
	var vs: Dictionary = inst.get_meta("variant", {}).duplicate()
	vs[pname] = v
	inst.set_meta("variant", vs)
	var vkey := ""
	for k in VARIANT_PARAMS:
		if vs.has(k):
			vkey += "%s=%s;" % [k, str(vs[k])]
	for mi in inst.get_children():
		if not (mi is MeshInstance3D) or mi.mesh == null:
			continue
		var mesh: Mesh = mi.mesh
		for si in mesh.get_surface_count():
			var base: Material = mesh.surface_get_material(si)
			if not (base is ShaderMaterial):
				continue
			mi.set_surface_override_material(si, _variant_mat(base, vs, vkey))


static func _variant_mat(base: ShaderMaterial, vs: Dictionary, vkey: String) -> ShaderMaterial:
	var ck := "%d|%s" % [base.get_instance_id(), vkey]
	if _variant_mats.has(ck):
		return _variant_mats[ck]
	var m: ShaderMaterial = base.duplicate()
	for k in vs:
		m.set_shader_parameter(k, vs[k])
	_variant_mats[ck] = m
	return m


# ---------------------------------------------------------------- boss mark
# Bosses built on a regular monster model (campaign bosses) get a glowing ground ring with outward tines in their
# colour, so they read as bosses like the dedicated boss models (which carry their own ring or crown).
# Kept in a plain Node3D so set_param / variant code (direct GeometryInstance3D children only) never touch it.
static func boss_mark(inst: Node3D, col: Color) -> void:
	var e := extent(String(inst.get_meta("model", "")))
	var r := maxf(0.9, maxf(e.x, e.z) * 0.55)
	var holder := Node3D.new()
	holder.name = "boss_mark"
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.albedo_color = col.lerp(Color.WHITE, 0.25)
	var ring := MeshInstance3D.new()
	var tm := TorusMesh.new()
	tm.inner_radius = r - 0.06
	tm.outer_radius = r + 0.06
	tm.rings = 48
	tm.ring_segments = 6
	ring.mesh = tm
	ring.material_override = mat
	ring.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	ring.scale = Vector3(1.0, 0.3, 1.0)
	ring.position.y = 0.04
	holder.add_child(ring)
	var pm := PrismMesh.new()
	pm.size = Vector3(0.22, 0.34, 0.05)
	for i in 8:
		var a := TAU * i / 8.0
		var t := MeshInstance3D.new()
		t.mesh = pm
		t.material_override = mat
		t.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		# lying flat, pointing outward from the ring
		t.transform = Transform3D(Basis(Vector3.UP, -(a + PI / 2)) * Basis(Vector3.RIGHT, -PI / 2), Vector3(cos(a) * (r + 0.2), 0.05, sin(a) * (r + 0.2)))
		holder.add_child(t)
	inst.add_child(holder)


# ---------------------------------------------------------------- footprint
static var _ext := {}


# Size (model units) of the model's bounding box in its level pose (pose 1: wings spread flat for flyers).
static func extent(name: String) -> Vector3:
	if _ext.has(name):
		return _ext[name]
	var tp := template(name)
	var out := Vector3.ZERO
	if not tp.is_empty():
		var poses: Array = tp["poses"]
		var pose: Dictionary = poses[mini(1, poses.size() - 1)] if not poses.is_empty() else tp["rest"]
		var box := AABB()
		var first := true
		for nid in tp["nodes"]:
			var tr: Transform3D = pose.get(nid, tp["rest"].get(nid, Transform3D.IDENTITY))
			var bb: AABB = tr * (tp["nodes"][nid] as ArrayMesh).get_aabb()
			box = bb if first else box.merge(bb)
			first = false
		out = box.size
	_ext[name] = out
	return out


# ---- 0.44 perf ---- the still-mesh crowd as MultiMeshes (ArenaView): a merged model qualifies when its body
# is a packed surface (the packed shader reads the instance colour / custom data); the few translucent extra
# surfaces of some models ride along untinted
static func mm_ok(mesh: ArrayMesh) -> bool:
	return mesh != null and mesh.get_surface_count() >= 1 and mesh.surface_get_material(0) == _packed_mat
# ---- end 0.44 perf ----
␀␀␀␀␀␀␀# 0.45: the first-time "How this mode works" card. The first time the player chooses Draft, Mayhem, Weekly,
# Survival, All-Random, 1v1, 2v2 or the Lantern Cross map on the Single Player screen, a small plaque in the
# bottom-right corner (above the footer, so "Choose your hero" stays clickable: it never blocks a quick start)
# explains it in 3-5 lines. "Got it" (Enter, Esc, the pad's click on the button) never shows it again; "Don't show
# tips" turns off Settings > Display > Mode tips. Seen flags live in Profile.modes_seen (CodexData.CARD_IDS ids);
# the "?" on every mode card (and the Codex page) reopens it. Leaving the screen hides it; if it stayed up for a
# couple of seconds it counts as seen.
extends UIParts.Plaque

const W := 420.0
const SEEN_AFTER := 2.0          # seconds on screen after which leaving the screen counts as seen

var main
var cur := ""                    # the card shown ("" when hidden)
var host: Control = null         # the screen it belongs to (hidden with it)
var avoid: Control = null        # the mode card it explains: the plaque sits on the other side of the screen
var above := false               # 0.46.1 (online lobby): sit right above `avoid` (the Start column) instead
var shown_t := 0.0
var title_lbl: Label
var lines_box: VBoxContainer
var got_btn: Button
var off_btn: Button


func _init(m) -> void:
	super(18.0, 14.0)
	main = m
	visible = false
	z_index = 118
	mouse_filter = MOUSE_FILTER_STOP
	custom_minimum_size = Vector2(W, 0)


func build() -> void:
	var v: VBoxContainer = main.vbox(8)
	add_child(v)
	var head: HBoxContainer = main.hbox(10)
	v.add_child(head)
	var q: Label = main.head_lbl("?", 26, UIParts.GOLD_TEXT, 4)
	head.add_child(q)
	title_lbl = main.head_lbl("", 24, UIParts.GOLD, 4)
	title_lbl.size_flags_horizontal = SIZE_EXPAND_FILL
	head.add_child(title_lbl)
	var orn := UIParts.Ornament.new()
	orn.custom_minimum_size = Vector2(0, 8)
	orn.mouse_filter = MOUSE_FILTER_IGNORE
	v.add_child(orn)
	lines_box = main.vbox(5)
	v.add_child(lines_box)
	var foot: HBoxContainer = main.hbox(10)
	v.add_child(foot)
	off_btn = Button.new()
	off_btn.text = "Don't show tips"
	off_btn.focus_mode = FOCUS_NONE
	off_btn.custom_minimum_size = Vector2(150, 38)
	off_btn.tooltip_text = "Turn off these cards (Settings > Display > Mode tips turns them back on)."
	off_btn.pressed.connect(func():
		Settings.mode_tips = false
		Settings.save()
		dismiss(true))
	foot.add_child(off_btn)
	got_btn = main.primary_button("Got it")
	got_btn.custom_minimum_size = Vector2(0, 38)
	got_btn.add_theme_font_size_override("font_size", 18)
	got_btn.pressed.connect(func(): dismiss(true))
	foot.add_child(got_btn)
	main.get_viewport().size_changed.connect(_place)


static func should_show(id: String) -> bool:
	return Settings.mode_tips and not Profile.modes_seen.has(id) and not CodexData.mode_card(id).is_empty()


# The first time `id` comes up: show its card (no-op when seen, turned off, or there is no card).
func maybe_show(id: String, on: Control = null, near: Control = null) -> bool:
	if not should_show(id):
		return false
	open(id, false, on, near)
	return true


# Shows the card for `id` now (forced: the "?" and the Codex reopen it whatever the setting says).
func open(id: String, forced := false, on: Control = null, near: Control = null, sit_above := false) -> void:
	var d := CodexData.mode_card(id)
	if d.is_empty() or (not forced and not Settings.mode_tips):
		return
	cur = id
	host = on
	avoid = near
	above = sit_above
	shown_t = 0.0
	title_lbl.text = String(d["title"])
	for ch in lines_box.get_children():
		lines_box.remove_child(ch)
		ch.queue_free()
	for line in d["lines"]:
		var row: HBoxContainer = main.hbox(8)
		var dot: Label = main.lbl("·", 16, UIParts.BRONZE_LITE, false, 2)
		dot.size_flags_vertical = SIZE_SHRINK_BEGIN
		row.add_child(dot)
		var l: Label = main.lbl(String(line), 15, UIParts.TEXT, true, 2)
		l.custom_minimum_size = Vector2(W - 36.0 - 18.0, 0)   # a wrapped label measures its height at this width
		row.add_child(l)
		lines_box.add_child(row)
	off_btn.visible = not forced or Settings.mode_tips
	visible = true
	size = Vector2(W, 0)
	_place()
	move_to_front.call_deferred()
	_place.call_deferred()
	main.audio.play("click", -10.0)


func is_open() -> bool:
	return visible and cur != ""


# Hides the card; `mark` records it as seen for good.
func dismiss(mark: bool) -> void:
	if cur != "" and mark:
		Profile.modes_seen[cur] = true
		Profile.save()
	cur = ""
	host = null
	visible = false


func _place() -> void:
	if not visible:
		return
	var vp: Vector2 = main.get_viewport_rect().size
	var w := minf(W, vp.x - 32.0)
	size = Vector2(w, 0)
	reset_size()
	var h := get_combined_minimum_size().y
	size = Vector2(w, h)
	var x := vp.x - w - 28.0
	if above and avoid != null and is_instance_valid(avoid) and avoid.is_visible_in_tree():
		var br := avoid.get_global_rect()
		position = Vector2(clampf(br.end.x - w, 16.0, vp.x - w - 16.0), maxf(16.0, br.position.y - h - 10.0))
		return
	if avoid != null and is_instance_valid(avoid) and avoid.is_visible_in_tree():
		var ar := avoid.get_global_rect()
		if ar.end.x > x and ar.position.x < x + w and ar.end.y > vp.y - h - 92.0:
			x = 28.0   # the card it explains is under the corner: go to the left side
	position = Vector2(x, maxf(16.0, vp.y - h - 92.0))


func _process(delta: float) -> void:
	if not visible:
		return
	shown_t += delta
	# 0.45: big text wraps the lines after _place measured them; keep the whole card inside the window
	var vp: Vector2 = main.get_viewport_rect().size
	if position.y + size.y > vp.y - 16.0 or position.x + size.x > vp.x - 8.0:
		position = Vector2(clampf(position.x, 8.0, maxf(8.0, vp.x - size.x - 8.0)), maxf(8.0, vp.y - size.y - 16.0))
	if host != null and not host.is_visible_in_tree():
		dismiss(shown_t >= SEEN_AFTER)


func _input(event: InputEvent) -> void:
	if not visible or not (event is InputEventKey) or not event.pressed or event.echo:
		return
	var k: int = event.keycode
	if k == KEY_ESCAPE or k == KEY_ENTER or k == KEY_KP_ENTER:
		dismiss(true)
		get_viewport().set_input_as_handled()
␀␀␀␀␀␀␀␀␀␀# Monster effects in 3D (MONFX): a hand-built projectile model per monster family (art/fx3d/mfx_*.glb, specs in
# tools/handmade/specs/mfx_*.py, catalogue tools/handmade/mfx_catalog.py) with a particle trail, an impact burst
# on the hero, a splash crater, per-family summon and blink marks (grave, egg burst, void tear, burrow...) and a
# hovering chevron over boss dive warnings. Also tints hero summon wolves toward their hero's colour.
# The shared ground telegraph style (delayed blasts and monster warnings) is drawn by telegraph() into the
# ground decal layer (ArenaView.draw_under). View only: nothing here changes the game.
