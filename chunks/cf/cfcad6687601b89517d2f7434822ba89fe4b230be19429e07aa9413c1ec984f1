# Pushes the display settings to the window: borderless fullscreen, vsync and the UI scale.
static func apply_display(tree: SceneTree) -> void:
	if DisplayServer.get_name() == "headless":
		return
	var want := DisplayServer.WINDOW_MODE_FULLSCREEN if fullscreen else DisplayServer.WINDOW_MODE_WINDOWED
	if DisplayServer.window_get_mode() != want:
		DisplayServer.window_set_mode(want)
	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_BORDERLESS, fullscreen)
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_ENABLED if vsync else DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = fps_cap
	if tree != null and tree.root != null:
		tree.root.content_scale_factor = clampf(ui_scale, 0.8, 1.4)


static func toggle_fullscreen(tree: SceneTree) -> void:
	fullscreen = not fullscreen
	apply_display(tree)
	save()


static func key(action: String) -> int:
	ensure()
	return int(keys.get(action, 0))


# The name of what triggers an action, for keycaps, tooltips and tips: the controller button when a pad was
# used last (0.29), the key otherwise. kb_name always gives the key (the key-binding list).
static func key_name(action: String) -> String:
	if pad_on:
		return pad_name(action)
	return kb_name(action)


static func kb_name(action: String) -> String:
	var k := key(action)
	if k == 0:
		return "—"
	var short := {KEY_COMMA: ",", KEY_PERIOD: ".", KEY_SEMICOLON: ";", KEY_APOSTROPHE: "'", KEY_SLASH: "/", KEY_BRACKETLEFT: "[", KEY_BRACKETRIGHT: "]", KEY_MINUS: "-", KEY_EQUAL: "=", KEY_QUOTELEFT: "~"}
	return short.get(k, OS.get_keycode_string(k))


# The action bound to a key, or "".
static func action_for(k: int) -> String:
	ensure()
	for a in keys:
		if int(keys[a]) == k:
			return a
	return ""


# Binds a key; if another action already used it, that action gets this one's old key.
static func rebind(action: String, k: int) -> void:
	ensure()
	var other := action_for(k)
	if other != "" and other != action:
		keys[other] = keys[action]
	keys[action] = k
	save()


# "Ctrl+Q" on the keyboard, "Y+LB" on a controller: how to learn the ability on that action.
static func learn_name(action: String) -> String:
	if pad_on:
		return pad_name("pad_mod") + "+" + pad_name(action)
	return "Ctrl+" + kb_name(action)


# ---- controller binds and names
static func pad_button(action: String) -> int:
	ensure()
	return int(pads.get(action, -1))


static func pad_action_for(b: int) -> String:
	ensure()
	for a in pads:
		if int(pads[a]) == b:
			return a
	return ""


static func rebind_pad(action: String, b: int) -> void:
	ensure()
	var other := pad_action_for(b)
	if other != "" and other != action:
		pads[other] = pads[action]
	pads[action] = b
	save()


static func reset_pads() -> void:
	for a in PAD_ACTIONS:
		pads[a[0]] = a[2]
	save()


# The glyph style in effect (1 Xbox, 2 PlayStation, 3 Steam Deck, 4 Nintendo).
static func pad_style_now() -> int:
	return pad_style if pad_style > 0 else pad_auto_style


# Style from a controller's name (Input.get_joy_name); the Deck's built-in pad under Steam reads "Steam ..." too.
static func style_for_joy(n: String) -> int:
	var l := n.to_lower()
	if l.contains("dualsense") or l.contains("dualshock") or l.contains("playstation") or l.contains("sony") or l.contains("ps4") or l.contains("ps5") or l.begins_with("ps"):
		return 2
	if l.contains("nintendo") or l.contains("switch") or l.contains("joy-con") or l.contains("pro controller"):
		return 4
	if l.contains("steam deck") or l.contains("valve") or OS.get_environment("SteamDeck") == "1":
		return 3
	return 1


# Text name of a pad button code in the current style (Xbox: A B X Y LB RB LT RT; PlayStation: Cross ... L1 R1 L2 R2;
# Steam Deck: A B X Y L1 R1 L2 R2; Nintendo by position: B A Y X L R ZL ZR).
static func button_label(b: int) -> String:
	var st := pad_style_now()
	match b:
		JOY_BUTTON_A:
			return ["A", "A", "Cross", "A", "B"][st]
		JOY_BUTTON_B:
			return ["B", "B", "Circle", "B", "A"][st]
		JOY_BUTTON_X:
			return ["X", "X", "Square", "X", "Y"][st]
		JOY_BUTTON_Y:
			return ["Y", "Y", "Triangle", "Y", "X"][st]
		JOY_BUTTON_LEFT_SHOULDER:
			return ["LB", "LB", "L1", "L1", "L"][st]
		JOY_BUTTON_RIGHT_SHOULDER:
			return ["RB", "RB", "R1", "R1", "R"][st]
		PAD_LT:
			return ["LT", "LT", "L2", "L2", "ZL"][st]
		PAD_RT:
			return ["RT", "RT", "R2", "R2", "ZR"][st]
		JOY_BUTTON_LEFT_STICK:
			return "L3"
		JOY_BUTTON_RIGHT_STICK:
			return "R3"
		JOY_BUTTON_BACK:
			return ["View", "View", "Create", "View", "Minus"][st]
		JOY_BUTTON_START:
			return ["Menu", "Menu", "Options", "Menu", "Plus"][st]
		JOY_BUTTON_GUIDE:
			return "Home"
		JOY_BUTTON_DPAD_UP:
			return "D-Up"
		JOY_BUTTON_DPAD_DOWN:
			return "D-Down"
		JOY_BUTTON_DPAD_LEFT:
			return "D-Left"
		JOY_BUTTON_DPAD_RIGHT:
			return "D-Right"
	if b >= JOY_BUTTON_PADDLE1 and b <= JOY_BUTTON_PADDLE4:
		return ["L4", "R4", "L5", "R5"][b - JOY_BUTTON_PADDLE1] if st == 3 else "P%d" % (b - JOY_BUTTON_PADDLE1 + 1)
	return "B%d" % b if b >= 0 else "—"


# The controller name of an action: its own bind, the modifier combo, or the sends & buildings wheel.
static func pad_name(action: String) -> String:
	ensure()
	if pads.has(action) and int(pads[action]) >= 0:
		return button_label(int(pads[action]))
	for b in PAD_MOD_ACTIONS:
		if PAD_MOD_ACTIONS[b] == action:
			return button_label(pad_button("pad_mod")) + "+" + button_label(b)
	match action:
		"attack_move":
			return button_label(pad_button("pad_attack"))
		"lane", "build1", "build2", "build3", "build4", "build5", "build6", "send1", "send2", "send3", "send4", "send5", "send6", "send7", "send8":
			return button_label(pad_button("pad_mod"))
		"item3", "item4", "item5", "item6":
			return ""
	return "—"


static func reset_keys() -> void:
	for a in ACTIONS:
		keys[a[0]] = a[2]
	save()
␀␀␀␀␀␀␀# 0.35: the Settings screen. A stone plaque with a tab strip (Audio, Display, Gameplay, Interface, Controls,
# Controller, Online), a search box that filters rows across every tab, and one row per setting: the name and a
# short line under it on the left, the control on the right at one width (silver switches, segmented buttons,
# compact sliders, dropdowns). Controls holds the key bindings as keycaps grouped by area, with an inline
# conflict prompt (swap / cancel); Controller holds the 0.29 pad settings and binds with glyphs.
