# ---------------------------------------------------------------- 0.31 team pings
# Ping key (G by default since 0.35.5, Alt before; Settings "ping") + left click on the field or the minimap: a quick ping there, which
# reads what is under it (a monster: "Attack the Ogre", a boss, a camp, an ally: "Help Orrin", your crystal:
# "Defend our crystal"). Hold the click (or drag) instead: the ping wheel opens at that point; point at a call and
# let go (let go in the hub: cancel; right-click or Esc: cancel). A Ping key that is not a modifier also works on its
# own: tap = quick ping at the mouse, hold = the wheel. Controller: L3 tap / hold at the virtual cursor (scripts/pad.gd).
# Every ping is the lockstep "ping" command (Sim.ping_cmd): team-only on screen, recorded in replays, and a few kinds
# move one or two allied bots (Sim._ping_bots); handle_events -> on_ping_event draws, sounds and logs it.
const PING_HOLD := 0.3         # a press held this long (without a drag) opens the wheel
const PING_DRAG := 16.0        # ... or dragged this many pixels


func ping_held() -> bool:
	var k := Settings.key("ping")
	return k != 0 and Input.is_key_pressed(k)


func ping_ok(quiet := false) -> bool:
	if sim == null or sim.over or replay_mode or not game.visible:
		return false
	if sim.mode == "survival":
		if not quiet:
			show_error("Pings go to your team: there is no one to see them in Survival.")
		return false
	return true


# Starts a gesture at world point wp of arena a (screen point sp). src: "mouse" (the left button ends it), "key"
# (the Ping key ends it) or "pad" (L3 ends it). false: no ping here (the click carries on as a click).
func ping_begin(wp: Vector2, a: int, sp: Vector2, src: String) -> bool:
	if not ping_ok() or paused:
		return false
	ping_g = {"wp": wp, "a": a, "sp": sp, "t": 0.0, "src": src}
	return true


func ping_cancel() -> void:
	ping_g = {}
	if ping_wheel != null:
		ping_wheel.close()


func _ping_open_wheel() -> void:
	var src := String(ping_g["src"])
	var hint := "Point at a call and let go · right-click cancels"
	if src == "pad":
		hint = "Point a stick · let go of %s to send · %s cancels" % [Settings.pad_name("ping"), Settings.pad_name("pad_back")]
	elif src == "key":
		hint = "Point at a call and let go of %s" % Settings.kb_name("ping")
	ping_wheel.open_at(ping_g["sp"], hint)
	audio.play("click", -10.0)


func _ping_tick(delta: float) -> void:
	if ping_g.is_empty():
		return
	if not ping_ok(true) or paused or _modal_open():
		ping_cancel()
		return
	ping_g["t"] = float(ping_g["t"]) + delta
	var src := String(ping_g["src"])
	if ping_wheel.visible:
		if src != "pad" and ping_wheel.point_dir(get_viewport().get_mouse_position() - ping_wheel.center, 26.0):
			audio.play("click", -16.0)
	elif float(ping_g["t"]) >= PING_HOLD or (src != "pad" and get_viewport().get_mouse_position().distance_to(ping_g["sp"]) > PING_DRAG):
		_ping_open_wheel()


# The gesture ends: the wheel's choice (nothing when let go in the hub), else a quick ping that reads the spot.
func ping_release() -> void:
	if ping_g.is_empty():
		return
	var g := ping_g
	if ping_wheel.visible:
		var k := ping_wheel.kind()
		ping_cancel()
		if k == "":
			return
		var ctx := ping_context(g["wp"], int(g["a"]))
		var ref: Array = ctx[1] if (k == "attack" and String(ctx[0]) in ["attack", "boss", "camp"]) or (k == "defend" and String(ctx[0]) == "defend") or (k == "help" and String(ctx[0]) == "help") else []
		human_ping(k, g["wp"], int(g["a"]), ref)
		return
	ping_cancel()
	quick_ping(g["wp"], int(g["a"]))


func quick_ping(wp: Vector2, a: int) -> void:
	var ctx := ping_context(wp, a)
	human_ping(String(ctx[0]), wp, a, ctx[1])


# What a quick ping at wp (arena a) means: [kind, target ref].
func ping_context(wp: Vector2, a: int) -> Array:
	if sim == null:
		return ["here", []]
	var ar = sim.view_arena(a)
	var mt := myt()
	var o = arena_view.pick(wp) if a == arena_view.arena_idx else null
	if not (o is Sim.Mon or o is Sim.Champ):
		o = null
		var bd := INF
		for m in ar.mons:
			var d: float = m.p.distance_to(wp)
			if not m.dead and d < maxf(28.0, m.r * 1.8) and d < bd:
				bd = d
				o = m
	if o is Sim.Mon:
		if o.d.get("boss", false):
			return ["boss", ["m", o.uid]]
		if o.d.get("camp", false):
			return ["camp", ["m", o.uid]]
		return ["attack", ["m", o.uid]]
	if o is Sim.Champ and o.pl.team == mt and o.pl.id != sim.local:
		return ["help", ["c", o.pl.id]]
	if a == mt and wp.distance_to(Sim.CORE) < 230.0:
		return ["defend", ["core"]]
	if not ar.duel:
		for ci in mini(Sim.CAMPS.size(), ar.camps_up.size()):
			if ar.camps_up[ci] and wp.distance_to(sim.camp_pos(ci)) < 300.0:
				return ["camp", []]
	return ["here", []]


# The line a ping shows (world marker, chat): the kind's name, or what it points at.
func ping_label(k: String, ref: Array, u, p: Vector2, a: int) -> String:
	match k:
		"attack":
			if u is Sim.Mon:
				return ("Enemy send: %s" if u.sender != null else "Attack the %s") % String(u.d["name"])
		"boss":
			if u is Sim.Mon:
				return "Boss here: %s" % String(u.d["name"])
		"camp":
			var ar = sim.view_arena(a)
			if not ar.duel:
				for ci in mini(Sim.CAMPS.size(), ar.camps_up.size()):
					if p.distance_to(sim.camp_pos(ci)) < 450.0:
						return "Take the %s" % String(sim.camp_def(ci)["name"])
		"help":
			if u is Sim.Champ:
				return "Help %s" % u.pl.name
		"defend":
			if ref.size() >= 1 and String(ref[0]) == "core":
				return "Defend our crystal"
	return String(PingUI.kind(k)["name"])


func human_ping(k: String, wp: Vector2, a: int, ref: Array = []) -> bool:
	if not ping_ok():
		return false
	var now := Time.get_ticks_msec()
	ping_local = ping_local.filter(func(x): return now - int(x) < int(Sim.PING_RATE_T * 1000.0) + 250)
	if ping_local.size() >= Sim.PING_RATE_N or (not mp() and sim.ping_room(sim.local) <= 0):
		show_error("Easy on the pings: wait a moment.")
		audio.play("click", -10.0)
		return false
	ping_local.append(now)
	var res = act("ping", [k, wp, ref, a])
	if res is String and res == "rate":
		show_error("Easy on the pings: wait a moment.")
		return false
	pings_sent += 1
	return true


# A "ping" event from the sim (every computer gets every ping): shown to the sender's team only, unless that ally is
# muted or "Show ally pings" is off (your own always show).
func on_ping_event(e: Dictionary) -> void:
	var team := int(e.get("team", -1))
	var pid := int(e.get("pid", -1))
	if team != myt() or pid < 0 or pid >= sim.players.size():
		return
	if sim.t - float(e.get("t", sim.t)) > 3.0:
		return   # replayed by a rejoin's fast-forward: old news
	var mine := pid == sim.local
	if not mine and (not Settings.show_pings or ping_muted.has(pid)):
		return
	var k := String(e.get("kind", "here"))
	var ref: Array = e.get("ref", [])
	var a := int(e.get("a", 0))
	var p: Vector2 = e["p"]
	var u = sim.resolve(ref) if ref.size() >= 2 else null
	if u != null and u.dead:
		u = null
	var label := ping_label(k, ref, u, p, a)
	var who := String(e.get("who", "?"))
	arena_view.ping_marks.append({"k": k, "p": u.p if u != null else p, "a": a, "age": 0.0, "who": "You" if mine else who, "label": label, "u": u})
	if arena_view.ping_marks.size() > 12:
		arena_view.ping_marks.pop_front()
	minimap.team_ping(u.p if u != null else p, k, a)
	audio.play(String(PingUI.kind(k)["snd"]), -4.0 if mine else -2.0, "ping", 0.02)
	sim.feed.push_front({"t": sim.t, "team": team, "who": who, "chat": label, "ping": k})
	var bots: Array = e.get("bots", [])
	if PingUI.REPLIES.has(k):
		var lines: Array = PingUI.REPLIES[k]
		for bi in bots.size():
			var bp := int(bots[bi])
			if bp >= 0 and bp < sim.players.size():
				sim.feed.push_front({"t": sim.t, "team": team, "who": sim.players[bp].name, "chat": lines[(sim.tick + bi) % lines.size()]})
	if sim.feed.size() > 12:
		sim.feed.resize(12)


# 0.31: a controller's L3 press at the virtual cursor (viewport point sp): on the minimap, that spot; on the field,
# the ground under it.
func ping_pad_press(sp: Vector2) -> bool:
	if not ping_ok() or paused:
		return false
	if minimap != null and minimap.is_visible_in_tree() and minimap.get_global_rect().has_point(sp):
		var wa: Array = minimap.world_at(sp - minimap.global_position)
		return ping_begin(wa[0], int(wa[1]), sp, "pad")
	return ping_begin(arena_view.to_world(sp - arena_view.global_position), arena_view.arena_idx, sp, "pad")


# _input's share: the end of a gesture (button / key let go), its cancel, and a non-modifier Ping key on its own.
func _ping_input(event: InputEvent) -> bool:
	if ping_g.is_empty():
		if event is InputEventKey and event.pressed and not event.echo and rebinding == "":
			var pk := Settings.key("ping")
			if pk != 0 and event.keycode == pk and not pk in [KEY_ALT, KEY_SHIFT, KEY_CTRL, KEY_META]:
				if get_viewport().gui_get_focus_owner() is LineEdit or get_viewport().gui_get_focus_owner() is TextEdit or _modal_open() or paused:
					return false
				if mouse_in and ping_ok(true) and arena_view.is_visible_in_tree():
					return ping_begin(mouse_world, arena_view.arena_idx, get_viewport().get_mouse_position(), "key")
		return false
	var src := String(ping_g["src"])
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_RIGHT and event.pressed:
			ping_cancel()
			return true
		if event.button_index == MOUSE_BUTTON_LEFT:
			if src == "mouse" and not event.pressed:
				ping_release()
				return true
			if src == "key" and event.pressed:
				if ping_wheel.visible:
					ping_release()   # key held, wheel open: a click sends the pointed call
				elif mouse_in:
					ping_g = {"wp": mouse_world, "a": arena_view.arena_idx, "sp": get_viewport().get_mouse_position(), "t": 0.0, "src": "mouse"}
				return true
			return src == "mouse"
	if event is InputEventKey and not event.echo:
		if event.pressed and event.keycode == KEY_ESCAPE:
			ping_cancel()
			return true
		if src == "key" and not event.pressed and event.keycode == Settings.key("ping"):
			ping_release()
			return true
	return false


