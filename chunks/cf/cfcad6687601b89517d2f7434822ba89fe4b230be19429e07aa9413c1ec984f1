			net.rejoin_from_file())
		row.add_child(b)
		rejoin_plaque = pl
	rejoin_plaque.visible = not d.is_empty()
	if not d.is_empty():
		var mins := int(float(d.get("age", 0)) / 60.0)
		var where := ("room %s" % String(d["room"])) if String(d.get("transport", "")) == "relay" else ("Steam lobby" if String(d.get("transport", "")) == "steam" else String(d.get("addr", "")))
		rejoin_plaque_lbl.text = "Rejoin your last match  ·  %s  ·  %s" % [where, "just now" if mins < 1 else "%d min ago" % mins]



