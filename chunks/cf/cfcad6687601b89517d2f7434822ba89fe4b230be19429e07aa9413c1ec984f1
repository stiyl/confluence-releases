		_build_spectator_sim(cfg)
		announce("Watching", "%s vs %s" % [Sim.TEAM_NAMES[0], Sim.TEAM_NAMES[1]])
		return
	_build_online_sim(cfg, Net.slot_of(cfg, multiplayer.get_unique_id()))
	announce("Online match", "%s vs %s  ·  good luck" % [Sim.TEAM_NAMES[0], Sim.TEAM_NAMES[1]])


func _build_online_sim(cfg: Dictionary, slot: int) -> void:
	var match_sim := Sim.new("", false, int(cfg["diff"]), Array(cfg.get("bans", [])), {"seed": int(cfg["seed"]), "lineup": cfg["lineup"], "mode": cfg["mode"], "team_size": int(cfg["team_size"]), "map": int(cfg["map"]), "ai_tiers": true,
		"tune": cfg.get("tune", {}), "variant": String(cfg.get("variant", "")), "mods": cfg.get("mods", {})})   # 0.18.1: the host's balance knobs, the same on every client; 0.44: Draft / Mayhem
	last_lineup = cfg["lineup"]   # 0.30: names + verified friend codes for the right-click player menu
	_online_sim = match_sim
	match_sim.local = slot
	var mine = match_sim.players[match_sim.local]
	mine.champ.skin = Profile.skin_of(mine.champ_id)
	sel_id = mine.champ_id
	game_mode = String(cfg["mode"]) if String(cfg.get("variant", "")) == "" else String(cfg["variant"])   # 0.44: Draft / Mayhem keep their name in the record
	game_map = int(cfg["map"])
	Sim.set_map(game_map)
	net.sim = match_sim
	_screen(null)
	start_game(match_sim)


