# Name, the first stat line and the unique line; with a hero, a warning when it already owns the passive.
func _item_tooltip(id: String, c) -> String:
	var it := GameData.item(id)
	var lines: Array = GameData.item_lines(id)
	var out := String(it["name"])
	for ln in lines:
		out += "\n" + String(ln)   # 0.38: the lines are short now: all of them
	if it.has("u"):
		var src := _uniq_owner(c, String(it["u"]["k"]), id)
		if src != "":
			out += "\nYou already have this passive from %s: it would not stack." % src
	return out


# The item in the hero's bag that gives it the unique kind k (not `except`), or "".
func _uniq_owner(c, k: String, except: String) -> String:
	if c == null or not c.uniq.has(k):
		return ""
	for own in c.items:
		if own == except:
			continue
		var oit := GameData.item(own)
		if oit.has("u") and String(oit["u"]["k"]) == k:
			return String(oit["name"])
	return ""


