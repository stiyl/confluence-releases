func _refresh_spec_bar() -> void:
	if spec_bar == null or sim == null or not spectating:
		return
	net.spec_delay = Settings.spec_delay
	# ---- 0.44.1 polish ---- a narrow view (140% UI): the bar ends before the scoreboard strip instead of running
	# under it; the teams' gold line moves to the chips' tooltips and the words get shorter
