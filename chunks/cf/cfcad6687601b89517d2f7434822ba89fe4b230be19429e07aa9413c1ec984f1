# 0.32.1: centres its child like a CenterContainer and scales it down to fit the window (keeps its layout, just smaller), so a card
# (Settings, Profile, Codex, Friends) never runs off the screen at a big UI scale in a small window.
class FitCenter extends Container:
	func _get_minimum_size() -> Vector2:
		return Vector2.ZERO   # never grows past the window (a CenterContainer takes its child's size)

	func _notification(what: int) -> void:
		if what != NOTIFICATION_SORT_CHILDREN:
			return
		for ch in get_children():
			var c := ch as Control
			if c == null or not c.visible or c.top_level:
				continue
			var ms := c.get_combined_minimum_size()
			var k := minf(1.0, minf((size.x - 12.0) / maxf(ms.x, 1.0), (size.y - 12.0) / maxf(ms.y, 1.0)))
			k = maxf(k, 0.5)
			c.pivot_offset = Vector2.ZERO
			c.scale = Vector2(k, k)
			c.size = ms
			c.position = ((size - ms * k) / 2.0).floor()


