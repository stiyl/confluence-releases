# The host took us as a spectator: of its lobby (the state follows), or of its running match (the catch-up follows).
@rpc("authority", "reliable")
func _spec_ok(running: bool) -> void:
	spectating = true
	_want_spec = false
	_join_t = -1.0
	var p = multiplayer.multiplayer_peer
	if transport == "relay" and p != null and p.get("relay_spec") != null and not bool(p.relay_spec):
		_log("spectating through a relay without spectator slots (it needs the 0.44 deploy): we hold a player slot there")
	if running:
		rejoining = true          # the catch-up pieces come next (_cu_chunk)
		_rejoin_t = REJOIN_TIMEOUT
		in_lobby = false
		status.emit("Watching: catching up with the match…")
	else:
		in_lobby = true
		status.emit("Watching the lobby. The match starts when the host starts it.")
	_log("spectating (%s)" % ("match" if running else "lobby"))


# Spectator: how many ticks behind the newest bundle we stay (the delay setting), 0..10 s.
func _spec_delay_ticks() -> int:
	if match_cfg.has("ranked"):
		return int(round(maxf(clampf(spec_delay, 0.0, 10.0), RK_SPEC_DELAY) * 60.0))   # ---- 0.45 ranked ---- anti-ghosting
	return int(round(clampf(spec_delay, 0.0, 10.0) * 60.0))


# Spectator, every frame: like a player's jitter buffer, but _spec_delay_ticks() further behind the newest bundle.
func _run_spectate(delta: float, now: int) -> int:
	var n := 0
	var dt_ticks := _spec_delay_ticks()
	var ahead := _newest - tick + 1 - dt_ticks
	if _buffering:
		if ahead >= BUFFER_TICKS or (ahead > 0 and now - _last_bundle_ms > 300):
			_buffering = false
	if not _buffering:
		var speed := 1.0
		if ahead > BUFFER_TICKS * 6:
			speed = 4.0
		elif ahead > BUFFER_TICKS * 2:
			speed = 1.5
		elif ahead < BUFFER_TICKS / 2:
			speed = 0.85
		acc = minf(acc + delta * speed, TICK * 10)
		var budget := 24
		while acc >= TICK and budget > 0 and bundles.has(tick) and _newest - tick + 1 > dt_ticks:
			acc -= TICK
			var cmds: Array = bundles[tick]
			bundles.erase(tick)
			_exec(cmds)
			budget -= 1
			n += 1
		if not bundles.has(tick) or _newest - tick + 1 <= dt_ticks:
			acc = minf(acc, TICK)
			if ahead <= 0:
				_buffering = true
	return n
# ---- end 0.44 spect ----


@rpc("authority", "reliable")
func _roster(r: Dictionary) -> void:
	roster = r


# A piece of the catch-up log (the host sends one per frame; the relay and ENet both keep them in order).
@rpc("authority", "reliable")
func _cu_chunk(idx: int, n: int, bytes: PackedByteArray) -> void:
	if not rejoining:
		return
	_rejoin_t = REJOIN_TIMEOUT
	_cu_chunks[idx] = bytes
	if _cu_chunks.size() < n:
		return
	var all := PackedByteArray()
	for i in n:
		all.append_array(_cu_chunks[i])
	_cu_chunks.clear()
	var d = bytes_to_var(all.decompress_dynamic(-1, FileAccess.COMPRESSION_GZIP))
	if not d is Dictionary:
		_fail("The host's answer couldn't be read.")
		return
	rejoining = false
	is_dropped = false
	in_match = true
	in_lobby = false
	match_cfg = d["cfg"]
	match_id = int(d.get("mid", 0))
	roster = d.get("roster", {})
	var fresh := bool(d["fresh"])
	if fresh:
		tick = 0
		cmd_log = d["log"].duplicate()
	else:
		cmd_log.append_array(d["log"])
	for t in bundles.keys():
		if int(t) < int(d["upto"]):
			bundles.erase(t)
	_cu = {"log": d["log"], "i": 0, "upto": int(d["upto"])}
	acc = 0.0
	_buffering = false
	_stalled = false
	_newest = maxi(_newest, int(d["upto"]) - 1)
	_last_bundle_ms = Time.get_ticks_msec()
	desynced = false
	_log("catch-up from tick %d to %d (%d log entries, fresh=%s)" % [tick, int(d["upto"]), _cu["log"].size(), fresh])
	if not spectating:
		_save_rejoin_file()
	rejoin_started.emit(match_cfg, int(d["slot"]), fresh)


func catching_up() -> bool:
	return not _cu.is_empty()


# Client: play the log, then the bundles that arrived meanwhile, as fast as the frame budget allows.
func _run_catchup() -> void:
	var t0 := Time.get_ticks_usec()
	var upto: int = _cu["upto"]
	var log: Array = _cu["log"]
	while Time.get_ticks_usec() - t0 < 30000 and not sim.over:
		if tick < upto:
			var cmds: Array = []
			var i: int = _cu["i"]
			while i < log.size() and int(log[i][0]) < tick:
				i += 1
			if i < log.size() and int(log[i][0]) == tick:
				cmds = log[i][1]
				i += 1
			_cu["i"] = i
			_exec(cmds, false)
		elif bundles.has(tick):
			var cmds2: Array = bundles[tick]
			bundles.erase(tick)
			_exec(cmds2)
		else:
			break
	sim.events.clear()      # nothing from the fast-forward reaches the HUD
	var goal := maxi(_newest + 1, upto)
	catchup.emit(clampf(float(tick) / float(maxi(goal, 1)), 0.0, 1.0))
	_last_bundle_ms = Time.get_ticks_msec()
	var ahead := _newest - tick + 1
	if sim.over or (tick >= upto and ahead < BUFFER_TICKS * 2):
		_cu = {}
		_buffering = ahead < BUFFER_TICKS
		_log("caught up at tick %d (%d bundles ahead)" % [tick, ahead])
		if _peer_ok():
			_rejoined.rpc_id(1)
		rejoined.emit()


@rpc("any_peer", "reliable")
func _rejoined() -> void:
	var pid := multiplayer.get_remote_sender_id()
	_peer_seen[pid] = Time.get_ticks_msec()
	if is_host and in_match and peer_slot.has(pid):
		var i: int = peer_slot[pid]
		pending.append([i, "rejoin", []])
		_chat_all("%s is back." % String(match_cfg["lineup"][i].get("name", "A player")))
		if _rc_hold:
			_resume_held()


# ---------------------------------------------------------------- 0.25 host migration (relay)
# The relay relabelled the longest-connected player as peer 1 (relay_peer.gd). Nobody steps until the new host
# has every bundle anyone received and says where the match goes on from.
func _on_host_changed(me: bool, was: int) -> void:
	if rejoining and is_dropped and in_match and sim != null:
		# 0.26: promoted (or the host changed) while we wait for the old host's answer, which will never come
		if me:
			_log("promoted while rejoining at tick %d: hosting from here" % tick)
			rejoining = false
			is_dropped = false
			auto_rc = false
			_rc_hello_due = false
		else:
			_rc_hello_due = true   # ask the new host instead
			return
	elif is_dropped or rejoining:
		return
	_log("host changed (me=%s) in_match=%s tick=%d newest=%d" % [me, in_match, tick, _newest])
	if not in_match:
		if me and in_lobby:
			_take_over_lobby(was)
		return
	migrating = true
	_mig_fill_wait = false
	_stalled = false
	stall_changed.emit(false, 0.0)
	_last_bundle_ms = Time.get_ticks_msec()
	if me:
		is_host = true
		if multiplayer.multiplayer_peer != null and multiplayer.multiplayer_peer.get("room_secret") != null:
			room_secret = String(multiplayer.multiplayer_peer.room_secret)
		_mig_reports = {}
		_mig_t = 0.0
		_mig_asked = false
		sums.clear()
		pending.clear()
		var present: Array = multiplayer.multiplayer_peer.peer_ids() if multiplayer.multiplayer_peer != null and multiplayer.multiplayer_peer.has_method("peer_ids") else []
		var now := Time.get_ticks_msec()
		if roster.is_empty():
			var line: Array = match_cfg.get("lineup", [])
			for i in line.size():
				if bool(line[i].get("human", false)):
					roster[int(line[i].get("peer", 0))] = i
		peer_slot = {1: sim.local}
		for pid in roster:
			var p := int(pid)
			var slot := int(roster[pid])
			if p == 1 or slot == sim.local:
				continue
			if present.has(p):
				peer_slot[p] = slot
				_peer_seen[p] = now
		# the old host, and anyone who vanished with it, hand their heroes to the AI
		for pid in roster:
			var slot := int(roster[pid])
			if int(pid) != 1 and present.has(int(pid)):
				continue
			if slot != sim.local and sim.players[slot].human:
				pending.append([slot, "drop", []])
		_roster.rpc(peer_slot)
		# 0.44: the spectators still connected stay attached (they get our bundles like everyone else)
		for pid in spec_peers.keys():
			if not present.has(int(pid)):
				spec_peers.erase(pid)
		_spec_roster.rpc(spec_peers)
		_chat_all("The host left. %s hosts now." % my_name)
	else:
		_mig_report.rpc_id(1, tick, _newest)
	host_migrated.emit(me)


# The lobby's host left: carry the lobby on with the same slots.
func _take_over_lobby(was: int) -> void:
	is_host = true
	peer_slot.clear()
	var present: Array = multiplayer.multiplayer_peer.peer_ids() if multiplayer.multiplayer_peer != null and multiplayer.multiplayer_peer.has_method("peer_ids") else []
	for i in 8:
		var s: Dictionary = lobby["slots"][i]
		if s["kind"] != "human":
			continue
		var p := int(s["peer"])
		if p == was:
			s["peer"] = 1
			s["ready"] = true
			s["tok"] = my_secret.sha256_text()
			peer_slot[1] = i
		elif p != 1 and present.has(p):
			peer_slot[p] = i
		else:
			lobby["slots"][i] = {"kind": "ai", "peer": 0, "name": "", "champ": "", "ready": false}
	_push_lobby()
	_chat_all("The host left. %s hosts now." % my_name)
	status.emit("You are the host now.")


@rpc("any_peer", "reliable")
func _mig_report(t: int, newest: int) -> void:
	var pid := multiplayer.get_remote_sender_id()
	_peer_seen[pid] = Time.get_ticks_msec()
	if is_host and migrating:
		_mig_reports[pid] = maxi(newest, t - 1)


# New host, every frame while migrating: wait for the reports, fetch what we miss, then set the clock.
func _run_migration(dt: float) -> void:
	_mig_t += dt
	var all := true
	for pid in peer_slot:
		if int(pid) != 1 and not _mig_reports.has(pid):
			all = false
	if not all and _mig_t < MIG_WAIT:
		return
	var best_pid := 0
	var best := _newest
	for pid in _mig_reports:
		if int(_mig_reports[pid]) > best:
			best = int(_mig_reports[pid])
			best_pid = int(pid)
	var target := best + 1
	if target % BUNDLE_EVERY != 0:
		target += 1
	if _newest + 1 < target:
		if not _mig_asked:
			_mig_asked = true
			_mig_t = 0.0
			_mig_need.rpc_id(best_pid, _newest + 1)
			_log("migration: asking peer %d for bundles %d..%d" % [best_pid, _newest + 1, target - 1])
			return
		if _mig_t < 6.0:
			return
		# no answer: go on from what we have; a player ahead of this point rebuilds from the log
		target = _newest + 1
		if target % BUNDLE_EVERY != 0:
			target += 1
	# everything up to target is in hand: play it, then we are the clock from there
	while tick < target and not sim.over:
		var cmds: Array = bundles.get(tick, [])
		bundles.erase(tick)
		_exec(cmds)
	bundles.clear()
	migrating = false
	acc = 0.0
	tick = target if not sim.over else tick
	host_since = target
	_mig_resume.rpc(target)
	_log("migration: hosting from tick %d" % target)


# "Send me every bundle from this tick on" (new host <- the player who got furthest, or player <- new host).
@rpc("any_peer", "reliable")
func _mig_need(from: int) -> void:
	var pid := multiplayer.get_remote_sender_id()
	if not in_match or (not is_host and pid != 1):
		return
	var entries: Array = []
	for e in cmd_log:
		if int(e[0]) >= from:
			entries.append(e)
	var upto := tick
	if not is_host:
		for t in bundles:
			if int(t) >= from and not bundles[t].is_empty():
				entries.append([int(t), bundles[t]])
		upto = maxi(tick, _newest + 1)
	_mig_fill.rpc_id(pid, from, entries, upto)


@rpc("any_peer", "reliable")
func _mig_fill(from: int, entries: Array, upto: int) -> void:
	var pid := multiplayer.get_remote_sender_id()
	if not in_match or (not is_host and pid != 1):
		return
	for t in range(from, upto):
		if t >= tick and not bundles.has(t):
			bundles[t] = []
	for e in entries:
		if int(e[0]) >= tick:
			bundles[int(e[0])] = e[1]
	_newest = maxi(_newest, upto - 1)
	_mig_fill_wait = false
	_log("migration: got bundles %d..%d from peer %d" % [from, upto - 1, pid])


# The new host's clock starts at tick t: play what we hold up to there, fetch what we miss first.
@rpc("authority", "reliable")
func _mig_resume(t: int) -> void:
	if is_host or not migrating:
		return
	migrating = false
	_last_bundle_ms = Time.get_ticks_msec()
	if tick > t:
		# we had run past the point the others can reach: rebuild from the log
		_log("migration: we are at %d, the match resumes at %d: rejoining from scratch" % [tick, t])
		_drop("The host changed and your game ran ahead.")
		return
	if _newest + 1 < t:
		_mig_fill_wait = true
		_mig_need.rpc_id(1, _newest + 1)
	acc = 0.0
	_buffering = false


