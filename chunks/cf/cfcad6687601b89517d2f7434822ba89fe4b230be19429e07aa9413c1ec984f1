func _replay_feed() -> void:
	while replay_i < replay_cmds.size() and int(replay_cmds[replay_i][0]) <= sim.tick:
		var c: Array = replay_cmds[replay_i]
		sim.apply_cmd(int(c[3]) if c.size() > 3 else sim.local, String(c[1]), c[2])   # 0.26: online bug-report replays carry the slot
		replay_i += 1


# 0.49: a highlight's Watch button: the replay, a few seconds before the moment (already watching: just seek).
func watch_moment(path: String, tick: int) -> void:
	var to := maxi(0, tick - int(4.0 / SIM_STEP))
	if replay_mode and sim != null:
		if end_ov != null:
			end_ov.visible = false
		replay_seek_to(to)
		return
	if path == "" or not FileAccess.file_exists(path):
		show_error("The replay of this match wasn't saved.")
		return
	watch_replay(path)
	get_tree().create_timer(0.4).timeout.connect(func():
		if replay_mode and sim != null:
			replay_paused = false
			replay_seek_to(to))


func watch_replay(path: String) -> void:
	var r := Replay.load_file(path)
	if r.is_empty():
		show_error("That replay can't be read (it may be from an older version of the game).")
		return
	if replay_bar == null:
		_build_replay_bar()
	Replay.cancel() if Replay.recording else null
	replay_path = path
	replay_cmds = r["cmds"]
	replay_i = 0
	replay_rec = r
	replay_seek = -1
	_clip_stop(false)
	# its length: the recorded match time, else the last command (older replays)
	var secs := float(r.get("summary", {}).get("t", 0))
	replay_total = maxi(int(secs / SIM_STEP), int(replay_cmds[replay_cmds.size() - 1][0]) if not replay_cmds.is_empty() else 1)
	replay_tl.setup(replay_total, Array(r.get("marks", [])), SIM_STEP)
	replay_mode = true
	replay_paused = false
	replay_speed = 1.0
	Profile.add_stat("replays")
	award("spectator")
	_refresh_replay_bar()
	var s: Dictionary = r["setup"]
	game_mode = String(s.get("game_mode", "classic"))
	profile_ov.visible = false
	end_ov.visible = false
	var ms := Replay.make_sim(r)
	start_game(ms)
	replay_lbl.text = "REPLAY  ·  %s  ·  %s  ·  %s" % [String(s.get("label", "")), String(TalentData.champ(s["hero"])["name"]).split(" ")[0], String(r.get("date", ""))]


