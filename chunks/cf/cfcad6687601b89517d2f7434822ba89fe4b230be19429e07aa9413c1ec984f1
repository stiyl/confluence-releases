# ---- 0.36 vasska ----
# Vasska, the Coil of the Deep Sands (Might tank). Stonescale Hide (passive): a melee blow on him may stun and
# hurt the attacker (once per attacker every 2 s). Sandquake (Q): three pulses heave the ground at a point
# (damage and a stun). Coil and Hurl (W): he grabs the nearest enemy near him and hurls it to a point; it lands
# on its own road, hurt, and the impact hurts everything round it (more if it was stunned). Venom Spit (E): a
# short cone of venom: a hit, a poison and an armor shred. Colossal Growth (R, always on once learned, like
# Briony's hymns): every rank makes him permanently bigger, harder-hitting and tougher, slower to swing, and his
# hurls heavier.
const SERP_HURL_SPD := 0.6       # seconds a hurled enemy is in the air
const SERP_GROW_DUEL := 0.5      # 0.41: Colossal Growth's attack damage and armor count half in a duel (he won 97% of level-24 duels)


func is_serpent(c) -> bool:
	return c is Champ and String(c.def["passive"].get("t", "")) == "stonescale"


# Colossal Growth: the value of one of its stats ("size", "dmg", "armor", "as", "hurl") at the rank learned
# (0 before). Found by the act, so a Survival hero holding the card grows too.
func serp_grow_v(c, k: String) -> float:
	var sks: Array = c.def["skills"]
	for i in sks.size():
		var acts: Array = sks[i].get("acts", [])
		if acts.is_empty() or String(acts[0].get("t", "")) != "growth":
			continue
		var rk := int(c.ranks[i])
		if rk <= 0:
			return 0.0
		var arr: Array = acts[0].get(k, [0.0])
		var v := float(arr[mini(rk, arr.size()) - 1])
		if (k == "dmg" or k == "armor") and duel_on and c.ar == duel_ar and duel_pair.has(c):
			v *= SERP_GROW_DUEL   # 0.41: half the Growth's attack damage and armor in the duel ring
		return v
	return 0.0


# The hero's model scale (view): 1 + Colossal Growth's size.
func serp_scale(c) -> float:
	return 1.0 + serp_grow_v(c, "size")


# Armor from Colossal Growth, less Venom Spit's shred (a hero in a duel).
func serp_armor(c) -> float:
	return serp_grow_v(c, "armor") - (c.ven_arm if c.ven_t > 0.0 else 0.0)


# A rank of Colossal Growth was just learned: the shed-skin flash.
func serp_grow_check(ar, c) -> void:
	var rk := 0
	for i in 4:
		var acts: Array = c.def["skills"][i].get("acts", [])
		if not acts.is_empty() and String(acts[0].get("t", "")) == "growth":
			rk = int(c.ranks[i])
	if rk == c.grow_seen:
		return
	if rk > c.grow_seen and not c.dead:
		add_fx(ar, {"type": "ring", "p": c.p, "r": 60.0, "col": Color("#e8c860"), "t": 0.7, "dur": 0.7, "fill": true, "follow": c, "vis": "vasska:3", "hit": true})
		burst(ar, c.p, Color("#3aa86a"), 18, 150)
		add_text(ar, c.p + Vector2(0, -64), "COLOSSAL GROWTH", Color("#f0d878"), 1.6, 15)
		ev("growth", ar, c.p, {"pid": c.pl.id, "human": c.pl.id == local, "rank": rk})
	c.grow_seen = rk


# Stonescale Hide: hero c was just struck in melee by att (a monster, or the duel foe's blade).
func serp_hide(ar, c, att) -> void:
	if att == null or not is_serpent(c) or c.dead or att.dead or t < att.ss_next:
		return
	var p: Dictionary = c.def["passive"]
	if rng.randf() >= f(p, "ch", 0.12):
		return
	att.ss_next = t + f(p, "icd", 2.0)
	var dmg: float = (f(p, "dmg", 40.0) * lvl_mult(c) + f(p, "mig", 1.0) * attr(c, "mig")) * c.pow
	var big: bool = att is Mon and (att.d.get("boss", false) or att.cci)
	if not big:
		var s: float = f(p, "duel_stun", 0.5) if att is Champ else f(p, "stun", 1.0)
		att.stun = maxf(att.stun, s * att.ten)
	add_fx(ar, {"type": "ring", "p": att.p, "r": att.r + 14.0, "col": Color("#c8a860"), "t": 0.35, "dur": 0.35, "vis": "vasska:p", "hit": true})
	burst(ar, att.p, Color("#9a8a60"), 8, 90)
	ev_view("abhit", ar, att.p, {"vis": "vasska:p", "small": true, "human": c.pl.id == local})
	hurt(ar, att, dmg, c)


# Venom Spit's poison and shred on a monster or the duel foe. Returns true if the carrier died.
func serp_tick(ar, m, dt: float) -> bool:
	m.ven_t -= dt
	var src = m.ven_src
	_hit_ctx = "dot"
	if m is Champ:
		hurt_champ(ar, m, m.ven_dps * dt, src)
	else:
		hurt(ar, m, m.ven_dps * dt, src)
	_hit_ctx = ""
	if m.ven_t <= 0.0:
		m.ven_t = 0.0
		m.ven_arm = 0.0
		m.ven_src = null
	return m.dead


# The enemy Coil and Hurl would grab: the nearest within reach of him that can be thrown (not a boss, an
# unstoppable or rooted monster, or a camp that isn't fighting; not one already in the air).
func serp_grab_pick(ar, c, reach: float):
	var pick = null
	var pd := INF
	for m in ar.mons:
		if m.dead or m.hurl_k >= 0.0 or not void_ok(m):
			continue
		if m is Mon and (m.d.get("boss", false) or m.cci or m.spd <= 0.0):
			continue
		var d: float = m.p.distance_to(c.p) - m.r
		if d <= reach and d < pd:
			pd = d
			pick = m
	return pick


# Where a hurled enemy comes down near `want`: a lane monster on its own road (and the waypoint it walks on
# from there), a camp beast inside its clearing, a hero on walkable ground. -> [point, waypoint or -1]
func serp_land(m, want: Vector2) -> Array:
	if m is Champ:
		var q: Vector2 = walk_clamp(want, m.r)
		if duel_on and m.ar == duel_ar:
			q = JUNCTION_POS + (q - JUNCTION_POS).limit_length(DUEL_RING - 4.0)   # inside the ring
		return [q, -1]
	if m.d.get("camp", false):
		var dv: Vector2 = want - m.camp_home
		var lim := minf(CAMP_LEASH * 0.6, 120.0)
		return [m.camp_home + (dv.normalized() * lim if dv.length() > lim else dv), -1]
	if m.path.size() < 2:
		return [m.p, -1]
	var best: Vector2 = m.p
	var bd := INF
	var bwi: int = m.wi
	for i in range(1, m.path.size()):
		var a: Vector2 = mon_spot(m, i - 1)
		var b: Vector2 = mon_spot(m, i)
		var ab: Vector2 = b - a
		var u := 0.0
		if ab.length_squared() > 0.001:
			u = clampf((want - a).dot(ab) / ab.length_squared(), 0.0, 1.0)
		var q: Vector2 = a + ab * u
		var d := q.distance_squared_to(want)
		if d < bd:
			bd = d
			best = q
			bwi = i
	return [best, bwi]


func serp_act(ar, c, a: Dictionary, tp: Vector2, si: int, mul: float, vk: String) -> void:
	var col := Color("#3aa86a")
	match String(a["t"]):
		"quake":
			var ctr: Vector2 = aim_at(c, tp, f(a, "range", 500))["pt"]
			var n := int(a.get("n", 3))
			var span := f(a, "dur", 1.0)
			var st: float = f(a, "duel_stun", 0.8) if ar.duel else f(a, "stun", 1.2)
			add_fx(ar, {"type": "ring", "p": ctr, "r": f(a, "r"), "col": Color("#c8a860"), "t": 0.3, "dur": 0.3, "vis": vk})
			for k in n:
				var b := Pend.new()
				b.p = ctr
				b.r = f(a, "r")
				b.dmg = f(a, "dmg") / n * mul
				b.t = 0.05 + span * k / maxf(1.0, n - 1)
				b.dur = b.t
				# every pulse stuns until the same moment (st after the cast), at least 0.4 s for a late arrival
				b.fx = {"stun": maxf(0.4, st - span * k / maxf(1.0, n - 1))}
				b.c = c
				b.col = Color("#c8a860")
				b.vis = vk
				b.small = k > 0
				ar.pend.append(b)
		"hurl":
			var m = serp_grab_pick(ar, c, f(a, "grab", 220))
			if m == null:
				c.cds[si] = 1.0
				add_text(ar, c.p + Vector2(0, -30), "NOTHING TO GRAB", col, 0.9, 11)
				return
			var want: Vector2 = aim_at(c, tp, f(a, "range", 600))["pt"]
			var land: Array = serp_land(m, want)
			var gk: float = 1.0 + serp_grow_v(c, "hurl")
			var sk: float = 1.0 + f(a, "stun_k", 0.3) if m.stun > 0.0 else 1.0
			var h := {"m": m, "c": c, "s": m.p, "e": land[0], "wi": land[1], "t": 0.0, "dur": SERP_HURL_SPD,
				"dmg_t": f(a, "dmg") * (1.0 + f(a, "self_k", 0.2)) * mul * gk * sk, "dmg_s": f(a, "dmg") * mul * gk,
				"r": f(a, "r", 150), "vis": vk, "stunned": sk > 1.0}
			ar.hurls.append(h)
			m.hurl_k = 0.0
			m.stun = maxf(m.stun, SERP_HURL_SPD + 0.05)
			if m is Champ:
				m.dash = null
				m.chan = null
				m.moving = false
				m.route = []
			c.face = (m.p - c.p).angle()
			add_fx(ar, {"type": "ring", "p": m.p, "r": m.r + 18.0, "col": col, "t": 0.3, "dur": 0.3, "vis": "vasska:1g"})
			add_text(ar, m.p + Vector2(0, -m.r - 26), "HURLED!" if not h["stunned"] else "HURLED! +30%", Color("#e8d080"), 0.9, 12)
			ev_view("abhit", ar, m.p, {"vis": "vasska:1g", "small": true, "human": c.pl.id == local})
		"spit":
			var base_ang: float = (tp - c.p).angle()
			var reach := f(a, "range", 300)
			var half := f(a, "ang", 0.87) / 2.0
			add_fx(ar, {"type": "cone", "p": c.p, "a": base_ang, "s": f(a, "ang", 0.87), "r": reach, "col": Color("#c8e040"), "t": 0.35, "dur": 0.35, "vis": vk})
			for m in ar.mons:
				if not void_ok(m):
					continue
				var dd: float = m.p.distance_to(c.p)
				if dd - m.r > reach:
					continue
				var pad: float = atan(m.r / dd) if dd > 0 else 3.0
				if absf(angle_difference(base_ang, (m.p - c.p).angle())) > half + pad:
					continue
				var dur := f(a, "dur", 4.0)
				m.ven_t = dur
				m.ven_dps = f(a, "dot") / dur * mul
				m.ven_arm = f(a, "shred", 0.2)
				m.ven_src = c
				hurt(ar, m, f(a, "dmg") * mul, c)
		"growth":
			pass   # always on (see serp_grow_v); never cast


# Moves hurled enemies along their arc and brings them down: the thrown one takes the heavy hit, everything
# round the landing spot the impact. Deterministic: a straight line over SERP_HURL_SPD (the view adds the arc).
func serp_hurl_step(ar, dt: float, owner) -> void:
	for h in ar.hurls:
		if owner != null and h["c"] != owner:
			continue
		h["t"] = float(h["t"]) + dt
		var m = h["m"]
		var k := minf(1.0, float(h["t"]) / float(h["dur"]))
		if not m.dead:
			m.p = (h["s"] as Vector2).lerp(h["e"], k)
			m.hurl_k = k
			if k < 1.0:
				m.stun = maxf(m.stun, float(h["dur"]) - float(h["t"]) + 0.05)
		if k < 1.0:
			continue
		h["done"] = true
		var e: Vector2 = h["e"]
		var c = h["c"]
		m.hurl_k = -1.0
		if not m.dead:
			m.p = e
			if m is Mon:
				if int(h["wi"]) >= 1:
					m.wi = int(h["wi"])
					m.seg_wi = -1
				unsiege(m)
			else:
				m.moving = false
				m.route = []
		add_fx(ar, {"type": "ring", "p": e, "r": float(h["r"]), "col": Color("#c8a860"), "t": 0.45, "dur": 0.45, "fill": true, "vis": "vasska:1", "hit": true})
		burst(ar, e, Color("#8a7a50"), 16, 150)
		ev("boom", ar, e, {"vis": "vasska:1", "human": c != null and c.pl.id == local})
		if not m.dead:
			hurt(ar, m, float(h["dmg_t"]), c, bool(h["stunned"]))
		for o in mons_in(ar, e, float(h["r"])):
			if o != m and void_ok(o):
				hurt(ar, o, float(h["dmg_s"]), c)
	ar.hurls = ar.hurls.filter(func(x): return not x.get("done", false))


# AI for Vasska: Sandquake on a clump, a boss or a fleeing duel foe; Coil and Hurl throws the nearest enemy into
# the thickest crowd it can reach (lane monsters back down their road when it's a tie), and in a duel slams the
# foe down beside him; Venom Spit when the cone holds a few monsters or a big one. Colossal Growth needs no cast.
func ai_serp(ar, c, i: int, a: Dictionary, best, live: Array) -> bool:
	var tt := String(a["t"])
	var db: float = best.p.distance_to(c.p) if best != null else INF
	if tt == "growth":
		return false
	if tt == "quake":
		var reach := f(a, "range", 500) + 10.0
		if ar.duel:
			return best != null and db < reach and best.stun <= 0.2 and cast(ar, c, i, best.p)
		var pick = null
		var pn := 0.0
		for m in live:
			if m.p.distance_to(c.p) > reach or not void_ok(m):
				continue
			var nn := float(count_near(live, m.p, f(a, "r") - 25.0))
			if m is Mon and m.d.get("boss", false):
				nn += 3.0
			elif m.max_hp > 900:
				nn += 1.0
			if nn > pn:
				pn = nn
				pick = m
		if pick != null and pn >= 3.0:
			return cast(ar, c, i, pick.p)
		return false
	if tt == "hurl":
		var m = serp_grab_pick(ar, c, f(a, "grab", 220))
		if m == null:
			return false
		var reach := f(a, "range", 600)
		if ar.duel or m is Champ:
			return cast(ar, c, i, c.p + Vector2.from_angle(c.face) * 40.0)
		var pick = null
		var ps := -1.0
		for o in live:
			if o == m or o.p.distance_to(c.p) > reach or not void_ok(o):
				continue
			var sc := float(count_near(live, o.p, f(a, "r", 150) - 20.0)) - progress(o) * 0.0005
			if o.p.distance_to(m.p) < f(a, "r", 150) - 20.0:
				sc -= 1.0   # the thrown one is no part of the crowd it lands in
			if sc > ps:
				ps = sc
				pick = o
		# worth it on 2+ at the landing, or a stunned one (the +30%), or a big one to pull off him
		if pick != null and (ps >= 2.0 or m.stun > 0.0 or m.max_hp > 900):
			return cast(ar, c, i, pick.p)
		return false
	if tt == "spit":
		if best == null or db > f(a, "range", 300) - 10.0:
			return false
		if ar.duel:
			return cast(ar, c, i, best.p)
		var n := 0
		var half := f(a, "ang", 0.87) / 2.0 + 0.15
		var ba: float = (best.p - c.p).angle()
		for m in live:
			if m.p.distance_to(c.p) <= f(a, "range", 300) and absf(angle_difference(ba, (m.p - c.p).angle())) <= half:
				n += 1
		if n >= 3 or (best.max_hp > 900 and n >= 1):
			return cast(ar, c, i, best.p)
		return false
	return false
