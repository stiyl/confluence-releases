		var b := Button.new()
		b.flat = true
		b.focus_mode = FOCUS_NONE
		b.text = String(hc[1]).to_upper() + ((" ▼" if sort_desc else " ▲") if sort_key == hc[0] else "")
		b.add_theme_font_override("font", UIParts.font("caps"))
		b.add_theme_font_size_override("font_size", 11)
		b.add_theme_color_override("font_color", UIParts.GOLD_TEXT if sort_key == hc[0] else UIParts.GOLD)
		b.alignment = HORIZONTAL_ALIGNMENT_RIGHT if hc[3] else HORIZONTAL_ALIGNMENT_LEFT
		b.custom_minimum_size = Vector2(hc[2], 26)
		if hc[0] == "name":
			b.size_flags_horizontal = SIZE_EXPAND_FILL
		var k: String = hc[0]
		b.pressed.connect(func():
			if sort_key == k:
				sort_desc = not sort_desc
			else:
				sort_key = k
				sort_desc = k != "name"
			main.audio.play("click", -10.0)
			refresh())
		head.add_child(b)
	body.add_child(head)
	var ids: Array = []
	var order := {}
	for c in GameData.CHAMPS:
		order[c["id"]] = ids.size()
		ids.append(c["id"])
	var names := {}
	for c in GameData.CHAMPS:
		names[c["id"]] = String(c["name"])
	ids.sort_custom(func(a, b):
		var pa := _plays(a) > 0 or int(Profile.hero(a)["xp"]) > 0
		var pb := _plays(b) > 0 or int(Profile.hero(b)["xp"]) > 0
		if pa != pb:
			return pa
		if sort_key == "name":
			return (names[a] < names[b]) != (not sort_desc)
		var va := _hero_val(a, sort_key)
		var vb := _hero_val(b, sort_key)
		if va != vb:
			return va > vb if sort_desc else va < vb
		return int(order[a]) < int(order[b]))
	for id in ids:
		body.add_child(_hero_row(id))


