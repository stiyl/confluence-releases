func _init(m, a, n) -> void:
	main = m
	account = a
	net = n
	name = "Ranked"


func _ready() -> void:
	net.ranked_off.connect(_on_off)


# ---------------------------------------------------------------- rank maths (mirror of the relay)
static func tier_of(mmr: int, pos := 0) -> int:
	var t := 0
	for i in TIERS.size():
		if mmr >= int(TIERS[i]["min"]):
			t = i
	if t < 6 and pos > 0 and pos <= 10 and mmr >= 1700:
		t = 6
	return t


static func div_of(mmr: int, tier: int) -> int:
	if tier >= 5:
		return 0
	var lo := 700 if tier == 0 else int(TIERS[tier]["min"])
	return 3 - clampi(int(floor((mmr - lo) * 3.0 / 200.0)), 0, 2)


static func label(tier: int, div: int) -> String:
	tier = clampi(tier, 0, TIERS.size() - 1)
	return String(TIERS[tier]["name"]) + ((" " + ["", "I", "II", "III"][div]) if div >= 1 and div <= 3 else "")


# A view from the relay ({tier, div, placed, placement, mmr...}) -> "Gold II" / "Placement 3/5".
static func view_label(v: Dictionary) -> String:
	if v.is_empty():
		return "Unranked"
	if not bool(v.get("placed", false)):
		return "Placement %d/%d" % [int(v.get("placement", 0)), PLACEMENTS]
	return label(int(v.get("tier", 0)), int(v.get("div", 0)))


# "tier:div" (lobby slots, the line-up, friends) -> [tier, div] or [] for none.
static func parse_rk(s: String) -> Array:
	if s == "" or not s.contains(":"):
		return []
	return [clampi(int(s.get_slice(":", 0)), 0, TIERS.size() - 1), clampi(int(s.get_slice(":", 1)), 0, 3)]


static func rk_text(s: String) -> String:
	var p := parse_rk(s)
	return label(p[0], p[1]) if not p.is_empty() else ""


static func mode_name(id: String) -> String:
	for m in MODES:
		if m["id"] == id:
			return String(m["name"])
	return id


# ---------------------------------------------------------------- emblems
# A tier emblem in rect r: shield (tier colour, bevelled), a cut gem, Master wings / Champion crown, division pips.
# placement: a plain grey shield with a "?" gem (still placing). dim: greyed (locked / not reached).
static func draw_emblem(ci: CanvasItem, r: Rect2, tier: int, div := 0, placement := false, dim := false) -> void:
	tier = clampi(tier, 0, TIERS.size() - 1)
	var s := minf(r.size.x, r.size.y)
	var c := r.get_center()
	var col: Color = Color("#6a6660") if placement else TIERS[tier]["col"]
	var gem: Color = Color("#8a857c") if placement else TIERS[tier]["gem"]
	if dim:
		col = col.lerp(Color("#3a3833"), 0.65)
		gem = gem.lerp(Color("#4a4740"), 0.65)
	var big := tier >= 5 and not placement   # wings / a crown around it: a smaller shield keeps it inside r
	var w := s * (0.50 if big else 0.62)
	var h := s * (0.58 if big else 0.72)
	var top := c.y - h * 0.52 - (s * 0.04 if div > 0 else 0.0) + (s * 0.07 if tier == 6 and not placement else 0.0)
	# wings (Master and up) behind the shield
	if tier >= 5 and not placement:
		for sd in [-1.0, 1.0]:
			var wing := PackedVector2Array()
			var bx: float = c.x + sd * w * 0.42
			wing.append(Vector2(bx, top + h * 0.22))
			wing.append(Vector2(bx + sd * s * 0.25, top - h * 0.02))
			wing.append(Vector2(bx + sd * s * 0.21, top + h * 0.26))
			wing.append(Vector2(bx + sd * s * 0.27, top + h * 0.34))
			wing.append(Vector2(bx + sd * s * 0.18, top + h * 0.54))
			wing.append(Vector2(bx + sd * s * 0.20, top + h * 0.64))
			wing.append(Vector2(bx, top + h * 0.70))
			ci.draw_colored_polygon(wing, col.darkened(0.35))
			ci.draw_polyline(_closed(wing), col.lightened(0.25), maxf(1.0, s * 0.02), true)
	# the shield
	var sh := PackedVector2Array()
	sh.append(Vector2(c.x - w * 0.5, top))
	sh.append(Vector2(c.x - w * 0.18, top - h * 0.06))
	sh.append(Vector2(c.x, top + h * 0.02))
	sh.append(Vector2(c.x + w * 0.18, top - h * 0.06))
	sh.append(Vector2(c.x + w * 0.5, top))
	sh.append(Vector2(c.x + w * 0.5, top + h * 0.48))
	sh.append(Vector2(c.x + w * 0.30, top + h * 0.80))
	sh.append(Vector2(c.x, top + h))
	sh.append(Vector2(c.x - w * 0.30, top + h * 0.80))
	sh.append(Vector2(c.x - w * 0.5, top + h * 0.48))
	ci.draw_colored_polygon(sh, Color("#16130f"))
	var inner := PackedVector2Array()
	for p in sh:
		inner.append(c.lerp(p, 0.86) + Vector2(0, h * 0.02))
	ci.draw_colored_polygon(inner, col.darkened(0.45))
	var half := PackedVector2Array()   # the lit left half
	for i in [0, 1, 2]:
		half.append(inner[i])
	half.append(Vector2(c.x, inner[7].y))
	for i in [8, 9]:
		half.append(inner[i])
	ci.draw_colored_polygon(half, col.darkened(0.2))
	ci.draw_polyline(_closed(sh), col.lightened(0.15), maxf(1.2, s * 0.035), true)
	ci.draw_polyline(_closed(inner), col.darkened(0.6), maxf(1.0, s * 0.015), true)
	# the gem: a cut diamond
	var gc := Vector2(c.x, top + h * 0.44)
	var gr := s * (0.15 + 0.012 * tier)
	var g := PackedVector2Array([gc + Vector2(0, -gr), gc + Vector2(gr * 0.8, -gr * 0.15), gc + Vector2(0, gr), gc + Vector2(-gr * 0.8, -gr * 0.15)])
	ci.draw_colored_polygon(g, gem.darkened(0.25))
	ci.draw_colored_polygon(PackedVector2Array([g[0], g[1], gc + Vector2(0, -gr * 0.05), g[3]]), gem.lightened(0.2))
	ci.draw_colored_polygon(PackedVector2Array([g[3], gc + Vector2(0, -gr * 0.05), g[2]]), gem.darkened(0.05))
	ci.draw_polyline(_closed(g), gem.lightened(0.5), maxf(1.0, s * 0.015), true)
	if placement:
		var f := UIParts.font("num_semi")
		var fs := int(maxf(8.0, gr * 1.2))
		ci.draw_string(f, gc + Vector2(-fs * 0.28, fs * 0.38), "?", HORIZONTAL_ALIGNMENT_LEFT, -1, fs, Color("#2a2620"))
	# Champion: a crown over the shield
	if tier == 6 and not placement:
		var cy := top - h * 0.10
		var cw := w * 0.46
		var cr := PackedVector2Array([Vector2(c.x - cw, cy), Vector2(c.x - cw * 0.9, cy - s * 0.12), Vector2(c.x - cw * 0.45, cy - s * 0.04),
			Vector2(c.x, cy - s * 0.16), Vector2(c.x + cw * 0.45, cy - s * 0.04), Vector2(c.x + cw * 0.9, cy - s * 0.12), Vector2(c.x + cw, cy)])
		ci.draw_colored_polygon(cr, Color("#e8c060") if not dim else Color("#6a6050"))
		ci.draw_polyline(_closed(cr), Color("#fff0b8") if not dim else Color("#8a8070"), maxf(1.0, s * 0.015), true)
	# division pips: III = three, I = one
	if div > 0 and not placement:
		var pr := maxf(1.5, s * 0.035)
		var py := top + h + s * 0.09
		for i in div:
			var px := c.x + (i - (div - 1) * 0.5) * pr * 3.2
			var d := PackedVector2Array([Vector2(px, py - pr * 1.3), Vector2(px + pr, py), Vector2(px, py + pr * 1.3), Vector2(px - pr, py)])
			ci.draw_colored_polygon(d, gem.lightened(0.1))


static func _closed(p: PackedVector2Array) -> PackedVector2Array:
	var o := p.duplicate()
	o.append(p[0])
	return o


class Emblem extends Control:
	var tier := 0
	var div := 0
	var placement := false
	var dim := false
	func _init() -> void:
		mouse_filter = MOUSE_FILTER_PASS
	func set_rank(t: int, d: int, place := false) -> void:
		tier = t
		div = d
		placement = place
		queue_redraw()
	func _draw() -> void:
		Ranked.draw_emblem(self, Rect2(Vector2.ZERO, size), tier, div, placement, dim)


# ---------------------------------------------------------------- relay calls
func available() -> String:
	if not net.relay_configured():
		return "The online relay isn't set up in this build."
	if caps == 0:
		return OLD_RELAY
	if not account.has_name():
		return "Pick a profile name first (Profile)."
	if not account.verified:
		return "Your profile isn't verified on the server yet. Check your connection."
	return ""


func refresh() -> void:
	if not net.relay_configured() or not account.has_name() or not account.verified:
		return
	account.call_api("rk_me", {}, func(res: Dictionary):
		if bool(res.get("ok", false)):
			caps = 1
			me = res
			_set_my_rk()
			_check_rewards()
			_adopt_q(res.get("queue", {}))
		elif String(res.get("err", "")) == "bad_action":
			caps = 0
		changed.emit())


func view(mode: String) -> Dictionary:
	return me.get("modes", {}).get(mode, {})


func season() -> Dictionary:
	return me.get("season", {})


func season_left_text() -> String:
	var se := season()
	if se.is_empty():
		return ""
	var left := int(se.get("end", 0)) / 1000 - int(Time.get_unix_time_from_system())
	if left <= 0:
		return "ends soon"
	var d := left / 86400
	return ("%d day%s left" % [d, "" if d == 1 else "s"]) if d >= 1 else ("%d h left" % maxi(1, left / 3600))


# Our best placed rank this season as "tier:div" (rides in the lobby hello), "" when unplaced.
func _set_my_rk() -> void:
	var best := {}
	for m in MODES:
		var v := view(m["id"])
		if bool(v.get("placed", false)) and (best.is_empty() or int(v.get("mmr", 0)) > int(best.get("mmr", 0))):
			best = v
	net.my_rk = ("%d:%d" % [int(best["tier"]), int(best["div"])]) if not best.is_empty() else ""


func party_codes() -> Array:
	var out: Array = []
	if main.party == null or not main.party.active():
		return out
	for id in main.party.ordered_ids():
		var c := String(main.party.members[id].get("code", "")).replace("-", "")
		if c != "" and c != account.friend_code.replace("-", ""):
			out.append(c)
	return out


func join(mode: String) -> void:
	var why := available()
	if why != "":
		note = why
		changed.emit()
		return
	var party := party_codes()
	if main.party != null and main.party.active() and main.party.count() > 1:
		if mode == "1v1":
			note = "Ranked 1v1 is solo only: leave your party first."
			changed.emit()
			return
		if not main.party.is_leader():
			note = "Your party leader queues the party."
			changed.emit()
			return
	note = ""
	account.call_api("rk_queue", {"mode": mode, "party": party, "ping": _ping_ms()}, func(res: Dictionary):
		if bool(res.get("ok", false)):
			caps = 1
			_adopt_q(res.get("queue", {}))
		elif String(res.get("err", "")) == "bad_action":
			caps = 0
		else:
			note = String(res.get("msg", "Couldn't join the queue."))
		changed.emit())


func leave() -> void:
	account.call_api("rk_leave", {}, func(res: Dictionary):
		if bool(res.get("ok", false)):
			_adopt_q(res.get("queue", {}))
		changed.emit())
	q = {"state": "idle"}
	changed.emit()


# 4v4 after 3 minutes: leave the queue and play an unranked Classic 4v4 with bots in the empty slots.
func fill_bots() -> void:
	account.call_api("rk_fill", {}, func(_res: Dictionary): pass)
	q = {"state": "idle"}
	note = "Unranked match with bots: no rating change."
	changed.emit()
	main.ranked_fill_bots()


func accept() -> void:
	if String(q.get("state", "")) != "found":
		return
	q["me_ok"] = true
	account.call_api("rk_accept", {"id": String(q.get("id", ""))}, func(res: Dictionary):
		if bool(res.get("ok", false)):
			_adopt_q(res.get("queue", {}))
		else:
			note = String(res.get("msg", ""))
		changed.emit())
	changed.emit()


func decline() -> void:
	if String(q.get("state", "")) != "found":
		return
	account.call_api("rk_decline", {"id": String(q.get("id", ""))}, func(res: Dictionary):
		if bool(res.get("ok", false)):
			_adopt_q(res.get("queue", {}))
		changed.emit())


func _ping_ms() -> int:
	return 0   # (no reliable relay ping before a room exists; the relay then picks the earliest searcher)


func searching_line(mode: String) -> String:
	var n := int(q.get("searching", 0)) if String(q.get("mode", "")) == mode else int(me.get("searching", {}).get(mode, -1))
	if n < 0:
		return ""
	return "%d player%s searching" % [n, "" if n == 1 else "s"]


# A queue state from the relay (rk_poll, rk_queue, rk_accept, or a party member's sync).
func _adopt_q(nq) -> void:
	if not (nq is Dictionary) or nq.is_empty():
		return
	var was := String(q.get("state", "idle"))
	var was_id := String(q.get("id", ""))
	q = nq
	var st := String(q.get("state", "idle"))
	if q.has("note") and String(q["note"]) != "":
		note = String(q["note"])
	if st == "found" and (was != "found" or was_id != String(q.get("id", ""))):
		found.emit(q)
		main.audio.play("duel_win", -4.0)
	if st == "go" and _went != String(q.get("id", "")):
		_went = String(q.get("id", ""))
		_go(q)
	changed.emit()


# Called by account.gd with the "rk" of every sync answer (a party member learns its leader queued this way).
func on_sync(rkq, caps_ranked: int) -> void:
	if caps_ranked >= 0 and caps != caps_ranked and caps_ranked == 1:
		caps = 1
	if rkq is Dictionary and not rkq.is_empty():
		_adopt_q(rkq)
	elif String(q.get("state", "idle")) in ["queued", "found"] and not _polling():
		q = {"state": "idle"}
		changed.emit()


func _polling() -> bool:
	return String(q.get("state", "")) in ["queued", "found"] and (String(q.get("state", "")) == "found" or bool(q.get("leader", true)))


func _process(dt: float) -> void:
	var st := String(q.get("state", "idle"))
	if st in ["queued", "found"]:
		_poll_t -= dt
		if _poll_t <= 0.0 and not _busy:
			_poll_t = POLL_FOUND if st == "found" else POLL_QUEUED
			_busy = true
			account.call_api("rk_poll", {}, func(res: Dictionary):
				_busy = false
				if bool(res.get("ok", false)):
					_adopt_q(res.get("queue", {}))
				elif String(res.get("err", "")) == "bad_action":
					caps = 0
					q = {"state": "idle"}
					changed.emit())
		if st == "found":
			q["left_ms"] = maxi(0, int(q.get("left_ms", 0)) - int(dt * 1000.0))
	# the agreed result of our last match: asked until it is decided (the relay waits up to 2 minutes for reports)
	if reported != "" and result.is_empty():
		_res_t -= dt
		if _res_t <= 0.0 and _res_tries < 60:
			_res_t = 4.0
			_res_tries += 1
			account.call_api("rk_result", {"id": reported}, _on_result)


# ---------------------------------------------------------------- the match
func _go(go: Dictionary) -> void:
	cur = go.duplicate(true)
	result = {}
	reported = ""
	my_pick = ""
	main.ranked_go(go)


# Every human reports at the end: the winner team, the final checksum (lockstep: the same everywhere) and who is
# gone (a matched player not in the line-up, or whose hero the AI held at the end).
func report_end(sim, cfg: Dictionary) -> void:
	var rid := String(cfg.get("ranked", {}).get("id", ""))
	if rid == "" or rid == reported or net.spectating:
		return
	var left: Array = []
	var seen := {}
	var line: Array = cfg.get("lineup", [])
	for i in line.size():
		var e: Dictionary = line[i]
		if bool(e.get("human", false)):
			var fc := String(e.get("fc", "")).replace("-", "")
			seen[fc] = true
			if i < sim.players.size() and not bool(sim.players[i].human):
				left.append(fc)
	for tm in cur.get("teams", []):
		for c in tm:
			var cc := String(c).replace("-", "")
			if not seen.has(cc) and not left.has(cc):
				left.append(cc)
	var body := {"id": rid, "sum": str(sim.checksum()), "left": left}
	if int(sim.winner) in [0, 1]:
		body["win"] = int(sim.winner)
	else:
		body["void"] = true
	reported = rid
	result = {}
	_res_tries = 0
	_res_t = 2.0
	account.call_api("rk_report", body, _on_result)


func _on_result(res: Dictionary) -> void:
	if not bool(res.get("ok", false)):
		return
	var r: Dictionary = res.get("result", {})
	if String(r.get("state", "")) == "waiting":
		return
	result = r
	if r.has("view"):
		var md := String(cur.get("mode", ""))
		if md != "" and me.has("modes"):
			me["modes"][md] = r["view"]
		_set_my_rk()
	result_in.emit(r)
	changed.emit()
	refresh()


# The ranked lobby was called off (somebody never joined): everyone's game reports it, so the no-shows lose.
func _on_off(missing: Array) -> void:
	var rid := String(cur.get("id", ""))
	if rid == "" or rid == reported:
		return
	reported = rid
	account.call_api("rk_report", {"id": rid, "void": true, "left": missing}, _on_result)


