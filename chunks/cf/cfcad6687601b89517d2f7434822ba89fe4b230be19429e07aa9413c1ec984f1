	var list: Array = weekly_friends.get(k, [])
	list = list.filter(func(x): return String(x["name"]) != String(e["name"]))
	list.append({"name": e["name"], "score": e["score"], "won": e["won"], "round": e["round"], "kills": e["kills"], "hero": e["hero"]})
	weekly_friends[k] = list
