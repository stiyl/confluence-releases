␀␀␀␀␀␀␀␀␀# 0.43: one finished match as a compact history entry (Profile.add_history keeps the last Profile.HIST_MAX in
# user://history.json), the online rating update, and the achievements that read the history. main.gd calls
# record(main, won, replay_path) once per match from the end screen (and from the campaign's end).
# Keys (short, the file stays small): "d" date "yyyy-mm-dd hh:mm", "ts" unix time, "m" mode (classic, quick,
# allrandom, duo, solo, survival, daily, tutorial, campaign; 0.44: draft, mayhem, weekly), "on" online, "map", "s" seconds, "r" win / loss /
# run (Survival, Daily, tutorial) / left (the connection ended it), "rd" round, "h" hero id, "lv" hero level,
# "k" kills, "dt" deaths, "dmg" hero damage, "heal" health restored, "gs" gold spent on sends, "bk" boss damage,
# "it" final items, "du" your duels in order (true = won), "diff" AI difficulty, "rt" rating change (online
# against humans), "rp" replay file, "me" your index in "pl", "pl" every hero in the match:
# {"n" name, "h", "t" team, "hu" human, "lv", "k", "dt", "dmg", "heal", "gs", "it"}.
class_name MatchRecord
extends RefCounted


static func mode_of(main, sim) -> String:
	if main != null and main.campaign_ui != null and main.campaign_ui.in_mission():
		return "campaign"
	if sim.mode == "survival":
		return "daily" if sim.daily > 0 else "survival"
	if sim.mode == "tutorial":
		return "tutorial"
	var gm: String = String(main.game_mode) if main != null else sim.mode
	if sim.variant in ["draft", "mayhem", "weekly"]:
		return sim.variant   # 0.44: the new modes play classic rules under their own name
	if gm in ["classic", "quick", "allrandom", "duo", "solo"]:
		if gm == "classic" and sim.team_size == 2:
			return "duo"
		if gm == "classic" and sim.team_size == 1:
			return "solo"
		return gm
	return sim.mode


static func build(main, sim, won: bool, replay_path := "", online := false, lineup: Array = []) -> Dictionary:
	var me = sim.players[sim.local]
	var c = me.champ
	var d := Time.get_datetime_dict_from_system()
	var md := mode_of(main, sim)
	var res := "win" if won else "loss"
	if md in ["survival", "daily", "tutorial"]:
		res = "run"
	elif sim.winner < 0:
		res = "left"
	var rec := {"d": "%04d-%02d-%02d %02d:%02d" % [d["year"], d["month"], d["day"], d["hour"], d["minute"]],
		"ts": int(Time.get_unix_time_from_system()), "m": md, "map": Sim.map_id, "s": int(sim.t), "r": res,
		"rd": sim.round_no, "h": String(me.champ_id), "lv": int(c.lvl), "k": int(me.kills), "dt": int(me.deaths),
		"dmg": roundi(float(me.hero_dmg)), "heal": roundi(float(c.healed)), "gs": int(me.gold_sent), "bk": roundi(float(me.boss_dmg)),
		"it": c.items.duplicate(), "diff": int(sim.difficulty)}
	if online:
		rec["on"] = true
	if replay_path != "":
		rec["rp"] = replay_path
	if "contest_log" in sim and not sim.contest_log.is_empty():
		# 0.49 contests: how many came up, and how many your team won ("cn", "cw")
		rec["cn"] = sim.contest_log.size()
		rec["cw"] = sim.contest_log.filter(func(e): return int(e.get("first", -1)) == int(me.team)).size()
	var du: Array = []
	for dh in sim.duel_hist:
		if String(dh.get("w", "")) == me.name:
			du.append(true)
		elif String(dh.get("l", "")) == me.name:
			du.append(false)
	if not du.is_empty():
		rec["du"] = du
	var pl: Array = []
	for p in sim.players:
		if p.absent or p.champ == null:
			continue
		if p == me:
			rec["me"] = pl.size()
		pl.append({"n": String(p.name), "h": String(p.champ_id), "t": int(p.team), "hu": bool(p.human), "lv": int(p.champ.lvl),
			"k": int(p.kills), "dt": int(p.deaths), "dmg": roundi(float(p.hero_dmg)), "heal": roundi(float(p.champ.healed)),
			"gs": int(p.gold_sent), "it": p.champ.items.duplicate()})
	if pl.size() > 1 or md in ["survival", "daily"]:
		rec["pl"] = pl
	# rating: online, a decided match, at least one human on the other side
	if online and res in ["win", "loss"] and md != "tutorial":
		var mine: Array = []
		var theirs: Array = []
		for i in mini(lineup.size(), sim.players.size()):
			var e = lineup[i]
			if not (e is Dictionary) or not bool(e.get("human", false)):
				continue
			var p = sim.players[i]
			var r := float(Profile.rating_now()) if i == sim.local else float(clampi(int(e.get("rt", Profile.RATING_START)), 100, 4000))
			if int(e.get("rt", 0)) <= 0 and i != sim.local:
				r = Profile.RATING_START
			if p.team == me.team:
				mine.append(r)
			else:
				theirs.append(r)
		if not theirs.is_empty():
			if mine.is_empty():
				mine.append(float(Profile.rating_now()))
			rec["rt"] = Profile.rate_match(_avg(mine), _avg(theirs), won)
	return rec


static func _avg(a: Array) -> float:
	var s := 0.0
	for x in a:
		s += float(x)
	return s / maxf(1.0, a.size())


# Achievements that read the history and the lifetime totals (after Profile.add_history).
static func awards(rec: Dictionary) -> Array:
	var out: Array = []
	if Profile.games >= 10:
		out.append("games_10")
	if Profile.games >= 100:
		out.append("games_100")
	if Profile.wins >= 25:
		out.append("wins_25")
	if Profile.stat("win_run_best") >= 3:
		out.append("win_streak_3")
	if Profile.stat("duel_run_best") >= 5:
		out.append("duel_streak")
	if Array(Profile.stats.get("roles_won", [])).size() >= Profile.ROLES.size():
		out.append("role_all")
	if Profile.heroes_played() >= GameData.CHAMPS.size():
		out.append("heroes_all")
	if Profile.stat("kills") >= 10000:
		out.append("kills_10k")
	if Profile.stat("kills") >= 50000:
		out.append("kills_50k")
	if int(rec.get("dmg", 0)) >= 40000 and rec.get("m") != "tutorial":
		out.append("dmg_40k")
	if int(rec.get("gs", 0)) >= 5000:
		out.append("sender")
	if bool(rec.get("on", false)) and rec.has("rt") and rec.get("r") == "win":
		out.append("online_win")
	if Profile.rating_now() >= 1200:
		out.append("rating_1200")
	return out


# Records the match: history entry, hero totals, rating; returns the achievement ids to award.
static func record(main, won: bool, replay_path := "") -> Array:
	var sim = main.sim
	var online: bool = main.mp_or_ended()
	var rec := build(main, sim, won, replay_path, online, main.last_lineup if online else [])
	Profile.add_history(rec)
	main.set_meta("last_record", rec)
	main.set_meta("challenges", Profile.record_challenges(rec, int(rec.get("cw", 0))))   # 0.49 mastery challenges
	if rec.has("rt") and main.net != null and "my_rating" in main.net:
		main.net.my_rating = Profile.rating_now()   # the next lobby hello carries it
	return awards(rec)
