	if sim == null or pid < 0 or pid >= sim.players.size():
		return
	var pl = sim.players[pid]
	var fc := ""
	if pid < last_lineup.size() and mp_or_ended():
		fc = String(last_lineup[pid].get("fc", ""))
	var extra: Array = []
	if pid != sim.local and pl.human and pl.team == myt() and not sim.over:
		# 0.31: an ally's pings can be muted for the rest of the match
		extra.append(["Unmute pings" if ping_muted.has(pid) else "Mute pings from %s" % pl.name, func():
			if ping_muted.has(pid):
				ping_muted.erase(pid)
				notify("Showing %s's pings again." % pl.name)
			else:
				ping_muted[pid] = true
				notify("%s's pings are muted for this match." % pl.name)])
	whisper_ui.open_player_menu(pl.name, fc, pl.human and pid != sim.local and mp_or_ended(), Vector2(-1, -1), extra)


