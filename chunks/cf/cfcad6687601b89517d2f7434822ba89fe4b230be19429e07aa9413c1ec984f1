# A small stone plaque with the badge, "Achievement unlocked" and the name. In a running match it sits on the
# left below the announcements (the top right has the scoreboard), in menus at the bottom right; both stack
# without overlapping (at most 3), fade after a few seconds and take no clicks. On the end screen it is a line in
# the right column instead, under an "Achievements" head.
func toast(aid: String) -> void:
	var a := Profile.ach_def(aid)
	if a.is_empty():
		return
	var t := Toast.new()
	t.aid = aid
	t.title = String(a["name"])
	t.desc = String(a["desc"])
	var r := Cosmetics.reward_of(aid)   # 0.44: "New skin: Moonsilver" in the reward colour instead of the description
