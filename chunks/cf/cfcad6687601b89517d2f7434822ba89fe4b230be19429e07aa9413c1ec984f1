␀␀# 0.31: team pings, the presentation side. The kinds (label, colour, sound, icon), the icons drawn in code (one
# stroke style, like UIParts glyphs), the world markers (ArenaView draws them through draw_ground / draw_marker)
# and the ping wheel (mouse: hold the Ping key + hold the left button and drag; controller: hold L3 and point a
# stick). The game side is Sim.ping_cmd (the "ping" lockstep command); main.gd "team pings" wires the input.
class_name PingUI
extends RefCounted

# The wheel, clockwise from the top. "boss" is contextual only (a quick ping on a boss).
const WHEEL := ["here", "attack", "omw", "camp", "send", "defend", "help", "danger"]
const KINDS := {
	"here": {"name": "Look here", "short": "Look", "col": Color("#e8e8e2"), "snd": "ping_here"},
	"attack": {"name": "Attack here", "short": "Attack", "col": Color("#ff8a5a"), "snd": "ping_attack"},
	"danger": {"name": "Danger, fall back", "short": "Fall back", "col": Color("#ff4a3a"), "snd": "ping_danger"},
	"help": {"name": "Need help", "short": "Help", "col": Color("#ffc95a"), "snd": "ping_help"},
	"omw": {"name": "On my way", "short": "On my way", "col": Color("#7be08a"), "snd": "ping_omw"},
	"defend": {"name": "Defend here", "short": "Defend", "col": Color("#7ec8ff"), "snd": "ping_defend"},
	"camp": {"name": "Take the camp", "short": "Camp", "col": Color("#ffd24a"), "snd": "ping_camp"},
	"send": {"name": "Sending now", "short": "Sending", "col": Color("#c79bff"), "snd": "ping_send"},
	"boss": {"name": "Boss here", "short": "Boss", "col": Color("#ff6a4a"), "snd": "ping_attack"},
}
# what an allied bot says when it answers (Sim._ping_bots picked it)
const REPLIES := {
	"help": ["On my way!", "Coming!", "Hold on, I'm coming."],
	"attack": ["On it.", "Going for it.", "Attacking."],
	"boss": ["Going for the boss.", "Let's take it down!"],
	"camp": ["I'll take the camp.", "Heading to the camp."],
	"defend": ["Falling back to defend.", "Guarding it."],
	"danger": ["Pulling back.", "Backing off."],
}
const MARK_T := 4.0            # seconds a world marker lasts


static func kind(k: String) -> Dictionary:
	return KINDS.get(k, KINDS["here"])


static func col(k: String) -> Color:
	return Palette.ping(k)   # 0.43 (access): the Colour vision palette (Default: the KINDS colours above)


# 0.43 (access): a frame shape per kind, so colour is never the only cue (every Colour vision set but Default):
# sides (0 = circle), turn (radians). Look: circle, Attack / Boss: diamond, Fall back: triangle, Help: hexagon,
# On my way: pentagon, Defend: square, Camp: upside-down triangle, Sending: octagon.
const SHAPES := {"here": [0, 0.0], "attack": [4, 0.0], "boss": [4, 0.0], "danger": [3, 0.0], "help": [6, 0.0],
	"omw": [5, 0.0], "defend": [4, PI / 4.0], "camp": [3, PI], "send": [8, PI / 8.0]}


# The closed outline of kind k's frame at radius r, or an empty array for a circle (or with shapes off).
static func frame_pts(k: String, c: Vector2, r: float) -> PackedVector2Array:
	var out := PackedVector2Array()
	if not Palette.shapes:
		return out
	var sh: Array = SHAPES.get(k, [0, 0.0])
	var n := int(sh[0])
	if n < 3:
		return out
	var rr := r * (1.25 if n == 3 else (1.12 if n == 4 else 1.04))   # same visual weight as the circle
	for i in n + 1:
		var a := -PI / 2.0 + float(sh[1]) + TAU * i / n
		out.append(c + Vector2.from_angle(a) * rr)
	return out


# One icon per kind, drawn in code at centre c with radius r: a dark disc, a ring in the kind's colour and the
# symbol in light strokes (outlined so it reads over grass, lava and snow alike).
static func draw_icon(ci: CanvasItem, k: String, c: Vector2, r: float, a := 1.0, disc := true) -> void:
	var kc: Color = col(k)
	var fp := frame_pts(k, c, r)
	if disc and fp.size() > 0:
		ci.draw_colored_polygon(frame_pts(k, c, r + 1.5), Color(0, 0, 0, 0.75 * a))
		ci.draw_colored_polygon(fp, Color(UIParts.STONE_1, 0.95 * a))
		ci.draw_polyline(fp, Color(kc, a), maxf(1.5, r * 0.14), true)
	elif disc:
		ci.draw_circle(c, r + 1.5, Color(0, 0, 0, 0.75 * a))
		ci.draw_circle(c, r, Color(UIParts.STONE_1, 0.95 * a))
		ci.draw_arc(c, r, 0, TAU, 32, Color(kc, a), maxf(1.5, r * 0.14), true)
	var s := r * 0.55
	var w := maxf(1.6, r * 0.16)
	var fg := Color(kc.lightened(0.35), a)
	var sh := Color(0, 0, 0, 0.8 * a)
	var lines: Array = []      # polylines (PackedVector2Array)
	var dots: Array = []       # [centre, radius]
	match k:
		"here":
			# an exclamation mark
			lines.append(PackedVector2Array([c + Vector2(0, -s), c + Vector2(0, s * 0.35)]))
			dots.append([c + Vector2(0, s * 0.82), w * 0.75])
		"attack":
			# crossed swords
			lines.append(PackedVector2Array([c + Vector2(-s, -s), c + Vector2(s, s)]))
			lines.append(PackedVector2Array([c + Vector2(s, -s), c + Vector2(-s, s)]))
			lines.append(PackedVector2Array([c + Vector2(-s * 0.95, s * 0.35), c + Vector2(-s * 0.35, s * 0.95)]))
			lines.append(PackedVector2Array([c + Vector2(s * 0.95, s * 0.35), c + Vector2(s * 0.35, s * 0.95)]))
		"danger":
			# a warning triangle with a bar
			var tri := PackedVector2Array([c + Vector2(0, -s), c + Vector2(s, s * 0.8), c + Vector2(-s, s * 0.8), c + Vector2(0, -s)])
			lines.append(tri)
			lines.append(PackedVector2Array([c + Vector2(0, -s * 0.35), c + Vector2(0, s * 0.25)]))
			dots.append([c + Vector2(0, s * 0.55), w * 0.6])
		"help":
			# a raised hand: a plus inside a ring
			lines.append(PackedVector2Array([c + Vector2(0, -s * 0.8), c + Vector2(0, s * 0.8)]))
			lines.append(PackedVector2Array([c + Vector2(-s * 0.8, 0), c + Vector2(s * 0.8, 0)]))
		"omw":
			# a double chevron pointing ahead
			lines.append(PackedVector2Array([c + Vector2(-s * 0.9, -s * 0.7), c + Vector2(-s * 0.15, 0), c + Vector2(-s * 0.9, s * 0.7)]))
			lines.append(PackedVector2Array([c + Vector2(s * 0.05, -s * 0.7), c + Vector2(s * 0.8, 0), c + Vector2(s * 0.05, s * 0.7)]))
		"defend":
			# a shield
			var sp := PackedVector2Array()
			sp.append(c + Vector2(-s * 0.8, -s * 0.8))
			sp.append(c + Vector2(s * 0.8, -s * 0.8))
			for i in 7:
				var u := float(i) / 6.0
				sp.append((c + Vector2(s * 0.8 * cos(u * PI / 2.0), -s * 0.8 + s * 1.8 * sin(u * PI / 2.0))).lerp(c + Vector2(0, s), u * u))
			var left := PackedVector2Array()
			for i in range(sp.size() - 1, 1, -1):
				left.append(c + Vector2(-(sp[i] - c).x, (sp[i] - c).y))
			sp.append_array(left)
			sp.append(sp[0])
			lines.append(sp)
		"camp":
			# a fang / claw: three curved strokes
			for j in 3:
				var x0 := (j - 1) * s * 0.55
				lines.append(PackedVector2Array([c + Vector2(x0 - s * 0.15, -s * 0.8), c + Vector2(x0 + s * 0.05, -s * 0.1), c + Vector2(x0 - s * 0.05, s * 0.8)]))
		"send":
			# a banner on a pole
			lines.append(PackedVector2Array([c + Vector2(-s * 0.6, s), c + Vector2(-s * 0.6, -s)]))
			lines.append(PackedVector2Array([c + Vector2(-s * 0.6, -s), c + Vector2(s * 0.8, -s * 0.6), c + Vector2(-s * 0.6, -s * 0.15)]))
		"boss":
			# a horned skull: a crown of three points
			lines.append(PackedVector2Array([c + Vector2(-s, s * 0.6), c + Vector2(-s, -s * 0.6), c + Vector2(-s * 0.4, 0), c + Vector2(0, -s * 0.9), c + Vector2(s * 0.4, 0), c + Vector2(s, -s * 0.6), c + Vector2(s, s * 0.6), c + Vector2(-s, s * 0.6)]))
	for ln in lines:
		ci.draw_polyline(ln, sh, w + 2.0, true)
	for d in dots:
		ci.draw_circle(d[0], d[1] + 1.0, sh)
	for ln in lines:
		ci.draw_polyline(ln, fg, w, true)
	for d in dots:
		ci.draw_circle(d[0], d[1], fg)


# The ground part of a world marker (ArenaView.draw_under: a canvas laid on the ground): two rings expanding out of
# the point in the kind's colour over a dark rim, and a soft disc. age: seconds since the ping.
static func draw_ground(ci: CanvasItem, k: String, p: Vector2, age: float, rad := 26.0) -> void:
	var kc: Color = col(k)
	var fade := clampf((MARK_T - age) / 0.8, 0.0, 1.0)
	var pop := clampf(age / 0.18, 0.0, 1.0)
	var base := rad * (0.6 + 0.4 * pop)
	var fp := frame_pts(k, p, base)
	if fp.size() > 0:
		# 0.43: the kind's shape instead of a ring (the pulses keep it too)
		ci.draw_colored_polygon(fp, Color(kc, 0.10 * fade))
		ci.draw_polyline(fp, Color(0, 0, 0, 0.45 * fade), 4.5, true)
		ci.draw_polyline(fp, Color(kc, 0.9 * fade), 2.2, true)
	else:
		ci.draw_circle(p, base, Color(kc, 0.10 * fade))
		ci.draw_arc(p, base, 0, TAU, 40, Color(0, 0, 0, 0.45 * fade), 4.5, true)
		ci.draw_arc(p, base, 0, TAU, 40, Color(kc, 0.9 * fade), 2.2, true)
	for j in 2:
		var ph := fmod(age * 1.1 + j * 0.5, 1.0)
		if age < 0.5 * j:
			continue
		var pr := base + ph * rad * 1.6
		var pp := frame_pts(k, p, pr)
		if pp.size() > 0:
			ci.draw_polyline(pp, Color(kc, (1.0 - ph) * 0.7 * fade), 2.0, true)
		else:
			ci.draw_arc(p, pr, 0, TAU, 48, Color(kc, (1.0 - ph) * 0.7 * fade), 2.0, true)


# ---------------------------------------------------------------- the ping wheel
# Eight wedges round a hub (the look of the 0.29 sends wheel: stone wedges, silver rims, outlined text). The
# owner points it (point_dir: a stick, or the mouse offset from the centre); `sel` is -1 inside the hub (cancel).
class Wheel extends Control:
	var sel := -1
	var center := Vector2.ZERO
	var _t := 0.0
	var hint := ""             # the line under the hub ("release to send")
	const RO := 118.0
	const RI := 44.0

	func _init() -> void:
		visible = false
		set_anchors_preset(Control.PRESET_FULL_RECT)
		mouse_filter = Control.MOUSE_FILTER_IGNORE

	func open_at(c: Vector2, how: String) -> void:
		var vs := get_viewport_rect().size if is_inside_tree() else Vector2(1280, 720)
		center = Vector2(clampf(c.x, RO + 12.0, vs.x - RO - 12.0), clampf(c.y, RO + 30.0, vs.y - RO - 40.0))
		sel = -1
		_t = 0.0
		hint = how
		visible = true
		queue_redraw()

	func close() -> void:
		visible = false

	func kind() -> String:
		return PingUI.WHEEL[sel] if sel >= 0 else ""

	# v: a direction (length 0..1 for a stick, pixels for the mouse offset); dead: below this length = the hub
	func point_dir(v: Vector2, dead: float) -> bool:
		var n := PingUI.WHEEL.size()
		var s := -1
		if v.length() >= dead:
			var a := fposmod(v.angle() + PI / 2.0 + PI / n, TAU)
			s = int(a / (TAU / n)) % n
		if s != sel:
			sel = s
			queue_redraw()
			return true
		return false

	func _process(delta: float) -> void:
		if visible:
			_t += delta
			queue_redraw()

	func _draw() -> void:
		var c := center
		var n := PingUI.WHEEL.size()
		var grow := clampf(_t / 0.1, 0.0, 1.0)
		var ro := RO * (0.85 + 0.15 * grow)
		var ri := RI
		var f := UIParts.font("ui_semi")
		UIParts.soft_shade(self, c, ro * 1.3, ro * 1.3, 0.3)
		for i in n:
			var k: String = PingUI.WHEEL[i]
			var a0 := -PI / 2.0 - PI / n + TAU * i / n + 0.02
			var a1 := a0 + TAU / n - 0.04
			var pts := PackedVector2Array()
			for q in 9:
				pts.append(c + Vector2.from_angle(lerpf(a0, a1, q / 8.0)) * ro)
			for q in 9:
				pts.append(c + Vector2.from_angle(lerpf(a1, a0, q / 8.0)) * ri)
			var on := i == sel
			var fill := UIParts.STONE_2.lerp(Color("#4a463c"), 0.6) if on else UIParts.STONE_1
			draw_colored_polygon(pts, Color(fill, 0.95))
			pts.append(pts[0])
			draw_polyline(pts, Color(0, 0, 0, 0.8), 3.0, true)
			draw_polyline(pts, Color(PingUI.col(k), 0.95) if on else UIParts.BRONZE_DARK.lightened(0.25), 2.0 if on else 1.0, true)
			var mid := c + Vector2.from_angle((a0 + a1) / 2.0) * (ri + ro) / 2.0
			PingUI.draw_icon(self, k, mid + Vector2(0, -7), 13.0 if on else 11.5, 1.0 if on or sel < 0 else 0.75)
			var t: String = PingUI.kind(k)["short"]
			var tp := Vector2(mid.x - 50, mid.y + 21)
			draw_string_outline(f, tp, t, HORIZONTAL_ALIGNMENT_CENTER, 100, 12, 4, Color(0, 0, 0, 0.9))
			draw_string(f, tp, t, HORIZONTAL_ALIGNMENT_CENTER, 100, 12, UIParts.GOLD_TEXT if on else UIParts.TEXT)
		# hub
		draw_circle(c, ri - 5.0, Color(0, 0, 0, 0.8))
		draw_circle(c, ri - 6.0, UIParts.STONE)
		draw_arc(c, ri - 7.0, 0, TAU, 40, UIParts.BRONZE, 2.0, true)
		var title := "Cancel" if sel < 0 else String(PingUI.kind(PingUI.WHEEL[sel])["name"])
		var hf := UIParts.font("display")
		var fs := 15
		var tw := (ri - 10.0) * 2.0
		if sel >= 0:
			title = String(PingUI.kind(PingUI.WHEEL[sel])["short"])
		while fs > 10 and hf.get_string_size(title, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x > tw:
			fs -= 1
		draw_string_outline(hf, Vector2(c.x - tw / 2.0, c.y + 5), title, HORIZONTAL_ALIGNMENT_CENTER, tw, fs, 4, Color(0, 0, 0, 0.9))
		draw_string(hf, Vector2(c.x - tw / 2.0, c.y + 5), title, HORIZONTAL_ALIGNMENT_CENTER, tw, fs, UIParts.GOLD if sel >= 0 else UIParts.MUTED)
		if hint != "":
			var hy := c.y + ro + 20.0
			draw_string_outline(f, Vector2(c.x - 150, hy), hint, HORIZONTAL_ALIGNMENT_CENTER, 300, 13, 4, Color(0, 0, 0, 0.9))
			draw_string(f, Vector2(c.x - 150, hy), hint, HORIZONTAL_ALIGNMENT_CENTER, 300, 13, UIParts.TEXT)
␀# Props built in code for the Ashen Reach and Hollow maps: obsidian spires, ember vents, ash rocks,
# ruined pillars and walls, bone piles, void crystals, star shards and twisted void trees.
# Each is a few primitives merged into one mesh in the same units as the Blender props (Y up),
# using the shared unit material so lighting, tints and the chapter looks apply to them too.
class_name ProcProps
extends RefCounted

const NAMES := ["obsidian_spire", "ember_vent", "ash_rock", "ruin_pillar", "ruin_wall", "bone_pile",
	"void_crystal", "star_shard", "void_tree", "ash_tree", "cairn",
	"lamp", "brazier", "crystal_ward", "crystal_ember",
	# base dressing per team (World art pass 2): banners, the crystal's inlay ring, plaza lanterns / coal braziers
	"banner_ward", "banner_ember", "trim_ward", "trim_ember", "lantern_ward", "brazier_ember",
	# 0.47.4 (art audit): the dressed curb round the confluence plaza
	"plaza_curb"]
# built here even though a Blender .glb of the same name exists (Models3D.merged checks this first)
const OVERRIDES := ["lamp", "brazier"]   # crystals: the hand-built Blender models (art/models3d) are used now
# team colours (ART_BIBLE 2.2): crystal light colour and a deeper body shade for the facets
const TEAM := {"ward": [Color("#6cc3b5"), Color("#1f6b62")], "ember": [Color("#e0714a"), Color("#7a2a14")]}

static var _mats := {}


static func has(name: String) -> bool:
	return NAMES.has(name)


static func overrides(name: String) -> bool:
	return OVERRIDES.has(name)


static func mat(col: Color, rough := 0.8, metal := 0.0, emit := 0.0, tex := "stone", core := 0.0) -> Material:
	var key := "%s|%s|%s|%s|%s|%s" % [col.to_html(), rough, metal, emit, tex, core]
	if _mats.has(key):
		return _mats[key]
	Models3D._ensure_data()
	var m := ShaderMaterial.new()
	m.shader = Models3D._shader
	var tx: Array = Models3D.TEX.get(tex, Models3D.TEX["plain"])
	m.set_shader_parameter("albedo", col)
	m.set_shader_parameter("nscale", tx[0] * 0.5)
	m.set_shader_parameter("lo", tx[1])
	m.set_shader_parameter("hi", tx[2])
	m.set_shader_parameter("bump", tx[3])
	m.set_shader_parameter("rough", rough)
	m.set_shader_parameter("metal", metal)
	m.set_shader_parameter("emit", emit)
	if core > 0.0:
		m.set_shader_parameter("core", core)
	_mats[key] = m
	return m


# Adds a primitive mesh, transformed, to the ArrayMesh with a material.
static func _add(am: ArrayMesh, pm: PrimitiveMesh, xf: Transform3D, m: Material) -> void:
	var arrays := pm.get_mesh_arrays()
	var vs: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var ns: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL]
	for i in vs.size():
		vs[i] = xf * vs[i]
		ns[i] = (xf.basis * ns[i]).normalized()
	arrays[Mesh.ARRAY_VERTEX] = vs
	arrays[Mesh.ARRAY_NORMAL] = ns
	_queue(am, arrays, m)


# Adds raw mesh arrays (from SurfaceTool), transformed.
static func _add_arrays(am: ArrayMesh, arrays: Array, xf: Transform3D, m: Material) -> void:
	var vs: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var ns: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL]
	for i in vs.size():
		vs[i] = xf * vs[i]
		ns[i] = (xf.basis * ns[i]).normalized()
	arrays[Mesh.ARRAY_VERTEX] = vs
	arrays[Mesh.ARRAY_NORMAL] = ns
	_queue(am, arrays, m)


# A flat-shaded crystal: an n-sided prism (radius r, body height hb) with a pointed tip (ht) and a
# short point below (hd), base point at the origin, along +Y. Faces are slightly irregular.
static func _gem(rng: RandomNumberGenerator, sides: int, r: float, hb: float, ht: float, hd := 0.12) -> Array:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.set_smooth_group(-1)
	var lo: Array = []
	var hi: Array = []
	for i in sides:
		var a := i * TAU / sides + rng.randf_range(-0.12, 0.12)
		var rr := r * rng.randf_range(0.85, 1.1)
		lo.append(Vector3(cos(a) * rr * 0.92, hd, sin(a) * rr * 0.92))
		hi.append(Vector3(cos(a) * rr, hd + hb * rng.randf_range(0.9, 1.08), sin(a) * rr))
	var top := Vector3(rng.randf_range(-0.06, 0.06) * r, hd + hb + ht, rng.randf_range(-0.06, 0.06) * r)
	var bot := Vector3.ZERO
	for i in sides:
		var j := (i + 1) % sides
		# CCW seen from outside (Godot front faces are clockwise in screen space: add in reverse)
		for v in [lo[i], hi[j], hi[i], lo[i], lo[j], hi[j], hi[i], hi[j], top, lo[j], lo[i], bot]:
			st.add_vertex(v)
	st.generate_normals()
	return st.commit_to_arrays()


# Parts are queued per material (on the mesh's metadata) and merged by _compact into one surface per
# material, on the CPU, so it also works under the headless dummy renderer.
static func _queue(am: ArrayMesh, arrays: Array, m: Material) -> void:
	var q: Dictionary = am.get_meta("q", {})
	if not q.has(m):
		q[m] = {"v": PackedVector3Array(), "n": PackedVector3Array(), "uv": PackedVector2Array(), "i": PackedInt32Array()}
	var g: Dictionary = q[m]
	var vs: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var base: int = g["v"].size()
	g["v"].append_array(vs)
	g["n"].append_array(arrays[Mesh.ARRAY_NORMAL])
	var uv = arrays[Mesh.ARRAY_TEX_UV]
	if uv == null:
		uv = PackedVector2Array()
		uv.resize(vs.size())
	g["uv"].append_array(uv)
	var idx = arrays[Mesh.ARRAY_INDEX]
	if idx == null:
		idx = PackedInt32Array(range(vs.size()))
	var ii: PackedInt32Array = idx
	for k in ii.size():
		ii[k] += base
	g["i"].append_array(ii)
	am.set_meta("q", q)


static func _xf(pos: Vector3, rot := Vector3.ZERO, scl := Vector3.ONE) -> Transform3D:
	var b := Basis.from_euler(rot).scaled(scl)
	return Transform3D(b, pos)


static func _prism(h: float, r: float, sides := 5, top := 0.0) -> CylinderMesh:
	var c := CylinderMesh.new()
	c.top_radius = top
	c.bottom_radius = r
	c.height = h
	c.radial_segments = sides
	c.rings = 1
	return c


static func _box(x: float, y: float, z: float) -> BoxMesh:
	var b := BoxMesh.new()
	b.size = Vector3(x, y, z)
	return b


static func _ball(r: float, h := -1.0) -> SphereMesh:
	var s := SphereMesh.new()
	s.radius = r
	s.height = r * 2.0 if h < 0 else h
	s.radial_segments = 10
	s.rings = 6
	return s


static func _cyl(h: float, r0: float, r1: float, sides := 8) -> CylinderMesh:
	var c := CylinderMesh.new()
	c.top_radius = r1
	c.bottom_radius = r0
	c.height = h
	c.radial_segments = sides
	c.rings = 1
	return c


static func build(name: String) -> ArrayMesh:
	var am := ArrayMesh.new()
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(name)
	var obsidian := mat(Color(0.09, 0.08, 0.1), 0.25, 0.3, 0.0, "metal")
	var vein := mat(Color("#c0400e"), 0.6, 0.0, 2.2, "plain")
	var ash := mat(Color(0.36, 0.33, 0.31), 0.95, 0.0, 0.0, "stone")
	var ash2 := mat(Color(0.25, 0.23, 0.22), 0.95, 0.0, 0.0, "stone")
	var bone := mat(Color(0.86, 0.82, 0.72), 0.7, 0.0, 0.0, "plain")
	var marble := mat(Color(0.62, 0.58, 0.52), 0.85, 0.0, 0.0, "stone")
	# 0.47.1 (art audit): the Hollow's crystals glint instead of glow, so the fight reads before the forest
	var voidc := mat(Color("#55389e"), 0.25, 0.1, 0.72, "crystal", 0.45)
	var voido := mat(Color("#40325e"), 0.35, 0.1, 0.0, "crystal")   # unlit void-tree orbs
	var voidd := mat(Color(0.12, 0.07, 0.18), 0.6, 0.0, 0.0, "stone")
	var star := mat(Color("#8a78e0"), 0.25, 0.1, 1.3, "crystal", 0.5)
	var bark := mat(Color(0.12, 0.1, 0.12), 0.9, 0.0, 0.0, "bark")
	match name:
		"lamp":
			_lamp(am)
		"brazier":
			_brazier(am, rng)
		"brazier_ember":
			_brazier(am, rng, true)
		"banner_ward", "banner_ember":
			_banner(am, name == "banner_ward")
		"trim_ward", "trim_ember":
			_trim(am, name == "trim_ward")
		"lantern_ward":
			_lantern_ward(am)
		"plaza_curb":
			_plaza_curb(am)
		"crystal_ward", "crystal_ember":
			_crystal(am, rng, TEAM[name.substr(8)])
		"obsidian_spire":
			for i in 4:
				var a := i * TAU / 4.0 + rng.randf() * 0.8
				var h := rng.randf_range(2.2, 4.6) * (1.6 if i == 0 else 1.0)
				var off := Vector3(cos(a), 0, sin(a)) * (0.0 if i == 0 else rng.randf_range(0.4, 0.8))
				var tilt := Vector3(rng.randf_range(-0.25, 0.25), rng.randf() * TAU, rng.randf_range(-0.25, 0.25))
				_add(am, _prism(h, rng.randf_range(0.28, 0.45), 5), _xf(off + Vector3(0, h * 0.45, 0), tilt), obsidian)
			_add(am, _prism(0.7, 1.1, 7, 0.6), _xf(Vector3(0, 0.2, 0)), ash2)
			_add(am, _cyl(0.06, 0.9, 0.9, 12), _xf(Vector3(0, 0.03, 0)), vein)
		"ember_vent":
			_add(am, _cyl(0.7, 1.3, 0.55, 9), _xf(Vector3(0, 0.35, 0)), ash2)
			_add(am, _cyl(0.12, 0.5, 0.5, 9), _xf(Vector3(0, 0.71, 0)), vein)
			for i in 5:
				var a := i * TAU / 5.0
				_add(am, _box(0.4, 0.3, 0.3), _xf(Vector3(cos(a) * 1.2, 0.12, sin(a) * 1.2), Vector3(0, a, 0.3)), ash)
		"ash_rock":
			for i in 3:
				var s := rng.randf_range(0.5, 0.9)
				_add(am, _box(s * 1.2, s * 0.8, s), _xf(Vector3(rng.randf_range(-0.4, 0.4), s * 0.35, rng.randf_range(-0.4, 0.4)),
					Vector3(rng.randf_range(-0.3, 0.3), rng.randf() * TAU, rng.randf_range(-0.3, 0.3))), ash if i % 2 == 0 else ash2)
			_add(am, _box(0.5, 0.04, 0.12), _xf(Vector3(0.1, 0.62, 0.0), Vector3(0, 0.7, 0)), vein)
		"ruin_pillar":
			_add(am, _box(1.3, 0.35, 1.3), _xf(Vector3(0, 0.17, 0)), marble)
			var hh := rng.randf_range(1.8, 3.2)
			_add(am, _cyl(hh, 0.42, 0.38, 10), _xf(Vector3(0, 0.35 + hh * 0.5, 0)), marble)
			_add(am, _cyl(1.6, 0.4, 0.4, 10), _xf(Vector3(1.2, 0.35, 0.4), Vector3(0, 0.4, PI / 2)), marble)
			_add(am, _box(0.5, 0.3, 0.4), _xf(Vector3(-0.8, 0.15, 0.6), Vector3(0.2, 0.5, 0.1)), ash)
		"ruin_wall":
			_add(am, _box(3.4, 1.8, 0.5), _xf(Vector3(0, 0.9, 0)), marble)
			_add(am, _box(1.2, 1.0, 0.52), _xf(Vector3(0.6, 2.2, 0)), marble)
			_add(am, _box(0.9, 0.6, 0.6), _xf(Vector3(1.9, 0.3, 0.7), Vector3(0.1, 0.6, 0.2)), marble)
			_add(am, _box(0.6, 0.5, 0.5), _xf(Vector3(-1.6, 0.25, 0.8), Vector3(0.0, 0.3, 0.1)), ash)
		"bone_pile":
			_add(am, _ball(0.32), _xf(Vector3(0, 0.28, 0), Vector3.ZERO, Vector3(1.0, 0.9, 1.1)), bone)
			for i in 6:
				var a := rng.randf() * TAU
				_add(am, _cyl(rng.randf_range(0.7, 1.1), 0.06, 0.05, 6), _xf(Vector3(cos(a) * 0.4, 0.08, sin(a) * 0.4), Vector3(PI / 2, a, 0)), bone)
			_add(am, _ball(0.18), _xf(Vector3(0.5, 0.12, -0.3)), bone)
		"void_crystal":
			for i in 5:
				var a := i * TAU / 5.0 + rng.randf() * 0.6
				var h := rng.randf_range(1.0, 2.6) * (1.5 if i == 0 else 1.0)
				var off := Vector3(cos(a), 0, sin(a)) * (0.0 if i == 0 else rng.randf_range(0.3, 0.6))
				var tilt := Vector3(rng.randf_range(-0.5, 0.5), rng.randf() * TAU, rng.randf_range(-0.5, 0.5)) * (0.3 if i == 0 else 1.0)
				_add(am, _prism(h, rng.randf_range(0.18, 0.3), 6), _xf(off + Vector3(0, h * 0.4, 0), tilt), voidc)
			_add(am, _box(1.3, 0.4, 1.1), _xf(Vector3(0, 0.15, 0), Vector3(0, 0.4, 0)), voidd)
		"star_shard":
			_add(am, _prism(5.0, 0.35, 4), _xf(Vector3(0, 2.4, 0), Vector3(0.12, 0.3, 0.05)), star)
			_add(am, _prism(2.0, 0.22, 4), _xf(Vector3(0.5, 0.9, 0.2), Vector3(-0.4, 0.8, 0.3)), star)
			_add(am, _box(1.4, 0.35, 1.4), _xf(Vector3(0, 0.15, 0), Vector3(0, 0.7, 0)), voidd)
		"void_tree", "ash_tree":
			var wood: Material = bark if name == "void_tree" else mat(Color(0.2, 0.18, 0.17), 0.95, 0.0, 0.0, "bark")
			var th := rng.randf_range(2.8, 3.8)
			_add(am, _cyl(th, 0.32, 0.12, 7), _xf(Vector3(0, th * 0.5, 0), Vector3(0.08, 0, 0.1)), wood)
			for i in 5:
				var a := i * TAU / 5.0 + rng.randf() * 0.9
				var len := rng.randf_range(1.0, 1.8)
				var y := th * rng.randf_range(0.55, 0.95)
				var dir := Vector3(cos(a), 0.6, sin(a)).normalized()
				var basis := Basis(Vector3.UP.cross(dir).normalized() if absf(dir.y) < 0.99 else Vector3.RIGHT, Vector3.UP.angle_to(dir))
				_add(am, _cyl(len, 0.1, 0.03, 5), Transform3D(basis, Vector3(0, y, 0) + dir * len * 0.5), wood)
				if name == "void_tree":
					_add(am, _ball(0.16), _xf(Vector3(0, y, 0) + dir * len), voidc if i % 3 == 0 else voido)
			_add(am, _cyl(0.3, 0.6, 0.32, 7), _xf(Vector3(0, 0.15, 0)), wood)
		"cairn":
			var y := 0.0
			for i in 5:
				var s := 0.7 - i * 0.11
				_add(am, _box(s, s * 0.45, s * 0.9), _xf(Vector3(rng.randf_range(-0.05, 0.05), y + s * 0.22, 0), Vector3(0, rng.randf() * TAU, 0)), marble if i % 2 else ash)
				y += s * 0.44
			_add(am, _ball(0.08), _xf(Vector3(0, y + 0.1, 0)), vein)
	return _compact(am)


# One surface per material (fewer draw calls per MultiMesh).
static func _compact(am: ArrayMesh) -> ArrayMesh:
	var out := ArrayMesh.new()
	var q: Dictionary = am.get_meta("q", {})
	for m in q:
		var g: Dictionary = q[m]
		var arrays := []
		arrays.resize(Mesh.ARRAY_MAX)
		arrays[Mesh.ARRAY_VERTEX] = g["v"]
		arrays[Mesh.ARRAY_NORMAL] = g["n"]
		arrays[Mesh.ARRAY_TEX_UV] = g["uv"]
		arrays[Mesh.ARRAY_INDEX] = g["i"]
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		out.surface_set_material(out.get_surface_count() - 1, m)
	return out



# Lamp post (ART_BIBLE 7; 0.47.1 rebuild from the art audit: the old 2.5 m pole with a small lantern read as a
# crooked stick with a cube on top from the game camera). Short and chunky: a stepped stone foot, a thick timber
# post with iron bands, a heavy cross-arm with a brace, and a big caged lantern of warm amber glass.
# Lantern centre at (0.66, 1.45) model units (ArenaView.lanterns() places the light and halo there).
static func _lamp(am: ArrayMesh) -> void:
	var stone := mat(Color("#8a847a"), 0.9, 0.0, 0.0, "stone")
	var stone2 := mat(Color("#5e5a54"), 0.9, 0.0, 0.0, "stone")
	var wood := mat(Color("#5a3c24"), 0.85, 0.0, 0.0, "wood")
	var iron := mat(Color("#3a3836"), 0.45, 0.6, 0.0, "metal")
	# warm amber glass; peak_k lifts its emission ceiling so it reads lit even without glow (Compatibility)
	var glass := mat(Color("#ffb860"), 0.3, 0.0, 3.0, "plain")
	glass.set_shader_parameter("peak_k", 1.7)
