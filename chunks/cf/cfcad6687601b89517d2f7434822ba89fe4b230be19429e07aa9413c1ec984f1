# A two-step button: the first click turns it into "Confirm?" for three seconds, the second click acts.
func confirm_button(b: Button, action: Callable, label := "Confirm?") -> void:
	b.set_meta("confirm_armed", false)
	var get_text := func() -> String:
		return b.title_lbl.text if b is UIParts.MenuEntry else b.text
	var set_text := func(t: String, hot: bool) -> void:
		if b is UIParts.MenuEntry:
			b.title_lbl.text = t
		else:
			b.text = t
			if hot:
				b.add_theme_color_override("font_color", Color(1.0, 0.55, 0.45))
			else:
				b.remove_theme_color_override("font_color")
	b.pressed.connect(func():
		if bool(b.get_meta("confirm_armed", false)):
			b.set_meta("confirm_armed", false)
			set_text.call(String(b.get_meta("confirm_text", get_text.call())), false)
			action.call()
			return
		b.set_meta("confirm_text", get_text.call())
		b.set_meta("confirm_armed", true)
		set_text.call(label, true)
		audio.play("click", -8.0)
		var t := get_tree().create_timer(3.0)
		t.timeout.connect(func():
			if is_instance_valid(b) and bool(b.get_meta("confirm_armed", false)):
				b.set_meta("confirm_armed", false)
				set_text.call(String(b.get_meta("confirm_text", get_text.call())), false)))


