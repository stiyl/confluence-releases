# An achievement: the badge, the name, the line under it, and the unlock date or a progress bar on the right.
class AchTile extends Control:
	var aid := ""
	var title := ""
	var desc := ""
	var date := ""
	var icon := ""
	var got := false
	var secret := false
	var prog: Array = []
	var reward: Dictionary = {}      # 0.44: {"k", "id", "name"} what it unlocks
	var equipped := false

	func _ready() -> void:
		mouse_filter = Control.MOUSE_FILTER_PASS
		tooltip_text = title + ("" if secret else "\n" + desc) + (("\nReward: %s (%s)" % [reward["name"], String(Cosmetics.KIND_NAMES.get(reward["k"], reward["k"])).to_lower()]) if not reward.is_empty() else "")

	func _draw() -> void:
		var r := Rect2(Vector2.ZERO, size)
		draw_rect(r, Color(UIParts.STONE_1, 0.6 if got else 0.35))
		draw_rect(r, Color(UIParts.BRONZE if got else UIParts.BRONZE_DARK, 0.7 if got else 0.6), false, 1.0)
		var bs := size.y - 14.0
		ProfileBadge.draw_badge(self, Rect2(8, 7, bs, bs), icon, got, secret)
		var x := bs + 20.0
		var right_w := 176.0
		var tw := size.x - x - right_w - 10.0
		var fd := UIParts.font("display")
		var fu := UIParts.font("ui")
		var fn := UIParts.font("num")
		var tc := UIParts.GOLD_TEXT if got else UIParts.MUTED
		var tt := ProfileBadge.fit_text(fd, title, 16, tw)
		draw_string_outline(fd, Vector2(x, 26), tt, HORIZONTAL_ALIGNMENT_LEFT, -1, 16, 3, Color(0, 0, 0, 0.8))
		draw_string(fd, Vector2(x, 26), tt, HORIZONTAL_ALIGNMENT_LEFT, -1, 16, tc)
		var lines := _wrap(fu, desc, 12, tw)
		if lines.size() > 2:
			lines[1] = ProfileBadge.fit_text(fu, lines[1] + " " + " ".join(lines.slice(2)), 12, tw)
		for i in mini(2, lines.size()):
			draw_string(fu, Vector2(x, 43 + i * 14), lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, 12, UIParts.TEXT if got else UIParts.DISABLED.lightened(0.2))
		var rx := size.x - right_w - 8.0
		if got:
			var dw := fn.get_string_size(date, HORIZONTAL_ALIGNMENT_LEFT, -1, 11).x
			draw_string(fn, Vector2(rx, 24), date, HORIZONTAL_ALIGNMENT_RIGHT, right_w, 11, UIParts.MUTED)
			draw_string(UIParts.font("caps"), Vector2(rx, 24), "UNLOCKED", HORIZONTAL_ALIGNMENT_RIGHT, right_w - dw - 8.0, 10, Color("#9fd8a8"))
		elif prog.size() == 2 and not secret:
			var have := mini(int(prog[0]), int(prog[1]))
			var txt := "%s / %s" % [_k(have), _k(int(prog[1]))]
			draw_string(fn, Vector2(rx, 24), txt, HORIZONTAL_ALIGNMENT_RIGHT, right_w, 11, UIParts.TEXT)
			UIParts.bar(self, Rect2(rx + right_w - 60.0, 29, 60, 5), float(have) / maxf(1.0, float(prog[1])), UIParts.GOLD)
		# 0.44: the reward on the right, under the state: a colour dot (skin hue, crystal / recall colour) or a quote
		# mark for titles, "Skin: Moonsilver", and "equipped" when it is in use
		if not reward.is_empty() and not secret:
			var rc := UIParts.GOLD_TEXT if got else UIParts.MUTED
			var kind := String({"skin": "SKIN", "crystal": "CRYSTAL", "recall": "RECALL", "title": "TITLE"}.get(reward["k"], reward["k"]))
			var fc := UIParts.font("caps")
			var label := "%s  %s" % [kind, String(reward["name"])]
			var lw := fc.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 9).x
			var dot := Rect2(rx + right_w - lw - 17.0, 39, 10, 10)
			var dc := _reward_col()
			if dc.a > 0.0:
				draw_circle(dot.get_center(), 4.5, Color(dc, 1.0 if got else 0.45))
				draw_arc(dot.get_center(), 4.5, 0, TAU, 20, Color(0, 0, 0, 0.6), 1.0, true)
			else:
				draw_string(fc, dot.position + Vector2(1, 10), "“", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, rc)
			draw_string(fc, Vector2(rx, 48), label, HORIZONTAL_ALIGNMENT_RIGHT, right_w, 9, rc)
			if equipped and got:
				draw_string(fc, Vector2(rx, 59), "EQUIPPED", HORIZONTAL_ALIGNMENT_RIGHT, right_w, 8, Color("#9fd8a8"))

	func _reward_col() -> Color:
		match String(reward["k"]):
			"skin":
				var sd := Profile.skin_def(String(reward["id"]))
				return Color.from_hsv(float(sd["hue"]), clampf(maxf(0.45, float(sd["min_sat"])) * float(sd["sat_k"]), 0.1, 1.0), clampf(0.55 + 0.4 * float(sd["bright"]), 0.3, 1.0))
			"crystal": return Color(Cosmetics.crystal_def(String(reward["id"])).get("col", "#ffffff"))
			"recall": return Color(Cosmetics.recall_def(String(reward["id"]))["col"])
		return Color(0, 0, 0, 0)

	static func _k(n: int) -> String:
		return ("%dk" % (n / 1000)) if n >= 10000 else str(n)

	static func _wrap(f: Font, t: String, fs: int, w: float) -> Array:
		var out: Array = []
		var cur := ""
		for word in t.split(" "):
			var trial := word if cur == "" else cur + " " + word
			if f.get_string_size(trial, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x > w and cur != "":
				out.append(cur)
				cur = word
			else:
				cur = trial
		if cur != "":
			out.append(cur)
		return out


