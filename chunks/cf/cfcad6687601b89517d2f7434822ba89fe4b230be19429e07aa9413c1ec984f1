# results from pasted share codes, and your past weeks. `score` is the score just made (-1: none).
func _fill_weekly_board(box: VBoxContainer, week: int, score: int, new_best: bool, status: String) -> void:
	for ch in box.get_children():
		ch.queue_free()
	var me_name: String = net.my_name if net != null else "You"
	var tw := WeeklyData.twist_of(week)
