# A keycap button for a binding: a raised stone key with the key's name, "press a key…" while it waits, a red rim
# while it is part of a conflict. pad: shows the controller button as its glyph.
class KeyCap extends Button:
	var cap := ""
	var waiting := false
	var bad := false
	var pad := false
	var _hov := false
	var _t := 0.0

	func _init() -> void:
		focus_mode = Control.FOCUS_NONE
		custom_minimum_size = Vector2(112, 34)
		size_flags_vertical = Control.SIZE_SHRINK_CENTER
		for st in ["normal", "hover", "pressed", "disabled", "focus", "hover_pressed"]:
			add_theme_stylebox_override(st, StyleBoxEmpty.new())

	func _process(d: float) -> void:
		if waiting:
			_t += d
			queue_redraw()
		elif is_hovered() != _hov:
			_hov = is_hovered()
			queue_redraw()

	func _draw() -> void:
		var r := Rect2(2, 2, size.x - 4, size.y - 7)
		var base := Rect2(2, 5, size.x - 4, size.y - 7)
		draw_rect(base.grow(1), Color(0, 0, 0, 0.7))
		draw_rect(base, Color("#0e0d0b"))
		var face := UIParts.STONE_2.lightened(0.08) if _hov else UIParts.STONE_2
		draw_rect(r, face)
		draw_rect(Rect2(r.position, Vector2(r.size.x, 1)), Color(1, 1, 1, 0.12))
		var rim := UIParts.BRONZE_DARK.lightened(0.35)
		if bad:
			rim = UIParts.DANGER
		elif waiting:
			rim = UIParts.BRONZE_LITE.lerp(UIParts.BRONZE, 0.5 + 0.5 * sin(_t * 6.0))
		elif _hov:
			rim = UIParts.BRONZE_LITE
