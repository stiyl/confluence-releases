# The relay records, per finished season, how many ranked games you played and your peak placed tier; the client
# unlocks the season skin (>= 10 games) and the "S<n> <Tier>" title from that (Profile.ranked_rewards).
func _check_rewards() -> void:
	var got: Array = []
	for rw in me.get("rewards", []):
		var s := int(rw.get("s", 0))
		if s <= 0:
			continue
		if bool(rw.get("skin", false)) and Profile.add_ranked_reward("skin", s, 0):
			got.append({"k": "skin", "id": Profile.season_skin(s), "name": String(Profile.skin_def(Profile.season_skin(s)).get("name", ""))})
		var pk := int(rw.get("peak", -1))
		if pk >= 0 and Profile.add_ranked_reward("title", s, pk):
			got.append({"k": "title", "id": Profile.season_title_id(s, pk), "name": Cosmetics.title_text(Profile.season_title_id(s, pk))})
	for r in got:
		if r["id"] == "":
			continue
		if r["k"] == "skin" and main.profile_ui != null:
			main.profile_ui.toast_reward(r, "Ranked season reward")
		else:
			main.show_good("New title: %s (Profile > Cosmetics)" % r["name"])
