		_fill_weekly_board(box, week, score, new_best, msg))
	pr.add_child(pbn)
	box.add_child(pr)
	if status != "":
		box.add_child(lbl(status, 13, MUTED, true))
	var hist := Profile.weekly_history()
	if hist.size() > (1 if mine.is_empty() else 1):
		box.add_child(head_lbl("Your weeks", 15, GOLD, 2))
		var n := 0
		for h in hist:
			if int(h["week"]) == week:
				continue
			var htw := WeeklyData.twist_of(int(h["week"]))
