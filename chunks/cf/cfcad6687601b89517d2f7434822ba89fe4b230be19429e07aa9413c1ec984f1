# A reward is "equipped" when it is the crystal colour / title / recall flash in use, or a skin some hero wears.
func _reward_equipped(r: Dictionary) -> bool:
	if r.is_empty():
		return false
	if r["k"] == "skin":
		for id in Profile.heroes:
			if String(Profile.heroes[id].get("skin", "")) == String(r["id"]):
				return true
		return false
	return Profile.equipped(r["k"]) == String(r["id"])


