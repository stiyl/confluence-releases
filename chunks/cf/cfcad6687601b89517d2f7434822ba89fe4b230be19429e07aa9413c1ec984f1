func _process(dt: float) -> void:
	if steam_ok:
		steam.run_callbacks()
	_draft_process(dt)   # 0.44: the host runs the Draft lobby's pick/ban clock
	_rk_process(dt)      # ---- 0.45 ranked ----
	if _relay_pending != null:
		_relay_pending.poll()
	if not _send_q.is_empty():
		var c: Array = _send_q.pop_front()
		if _peer_ok() and multiplayer.get_peers().has(int(c[0])):
			_cu_chunk.rpc_id(int(c[0]), int(c[1]), int(c[2]), c[3])
	if _rc_hello_due and rejoining and _peer_ok():
		_rc_hello_due = false
		_send_rejoin_hello()
	if rejoining:
		_rejoin_t -= dt
		if _rejoin_t <= 0.0:
			_fail("The host didn't answer." if _rc_mode != "host" or not is_dropped else "The relay didn't answer.")
	if auto_rc and is_dropped:
		_rc_elapsed += dt
		if int(_rc_elapsed) != _rc_shown:
			_rc_shown = int(_rc_elapsed)
			reconnecting.emit("Reconnecting…", "%d s%s" % [_rc_shown, ("  ·  " + _rc_last) if _rc_last != "" else ""])
		if not rejoining:
			_rc_wait -= dt
			if _rc_elapsed >= RECONNECT_FOR:
				_rc_give_up("Couldn't reconnect within %d minutes.%s" % [int(RECONNECT_FOR / 60.0), (" Last answer: " + _rc_last) if _rc_last != "" else ""])
			elif _rc_wait <= 0.0:
				_rc_attempt()
	if _join_t > 0.0:
		_join_t -= dt
		if _join_t <= 0.0 and transport == "steam" and not is_host and not in_lobby:
			_fail("The lobby's host didn't answer over Steam. Ask them to invite you again.")
		elif _join_t <= 0.0 and transport == "ip" and not is_host and not in_lobby:
			_fail(("No answer from %s. Check that: the address is the host's PUBLIC address (or their LAN / Tailscale " +
				"address if you share a network); the host's router forwards UDP port %d to their PC, or showed " +
				"\"port opened automatically\"; the host allowed Confluence through Windows Firewall; you both run " +
				"the same game version.") % [_join_addr, PORT])


