			return
		var age := (Time.get_ticks_msec() - _born) / 1000.0   # real time: game speed and pause don't stretch it
		var life := 6.0 - age
		modulate.a = clampf(life / 0.8, 0.0, 1.0) * clampf(age / 0.25, 0.0, 1.0)
		if life <= 0.0 or (gone.is_valid() and bool(gone.call())):
			queue_free()

