func open_picker() -> void:
	if not main.account.has_name():
		main.friends_ui.require_name()
		return
	main.account.panel_open = true
	main.account.refresh_soon()
	pick_msg.text = " "
	_pick_key = ""
	_render_picker()
	pick_ov.visible = true
	pick_ov.move_to_front()
	main.audio.play("click", -6.0)


func close_picker() -> void:
	pick_ov.visible = false
	main.account.panel_open = main.friends_ui.friends_ov.visible


func _render_picker() -> void:
	var acct = main.account
	var k := JSON.stringify([acct.friends, acct.server, party.invited.keys(), party.members])
	if k == _pick_key:
		return
	_pick_key = k
	for ch in pick_list.get_children():
		ch.queue_free()
	var shown := 0
	for f in acct.friends:
		if not bool(f.get("online", false)):
			continue
		shown += 1
		var code := String(f.get("code", ""))
		var nm := String(f.get("name", ""))
		var b := invite_button(code, nm, String(f.get("status", "")), func(msg: String): pick_msg.text = msg)
		pick_list.add_child(main.friends_ui._person_row(f, main.friends_ui.status_col(f), main.friends_ui.status_text(f), [b]))
	if shown == 0:
		pick_list.add_child(main.lbl("None of your friends is online right now." if not acct.friends.is_empty() else "No friends yet: add them in the Friends panel with their name or friend code.", 14, UIParts.MUTED, true))


# The "Invite to party" button for a friend (picker and Friends panel). say(msg) reports the outcome.
func invite_button(code: String, nm: String, status: String, say: Callable) -> Button:
	var b := _btn("Invite to party", 150)
	b.custom_minimum_size = Vector2(150, 32)
	if party.has_member_code(code):
		b.text = "In your party"
		b.disabled = true
	elif party.invited.has(party.norm(code)):
		b.text = "Invited"
		b.disabled = true
	elif party.relay_note() != "":
		b.disabled = true
		b.tooltip_text = party.relay_note()
	elif status == "match":
		b.disabled = true
		b.tooltip_text = "%s is in a match. Invite them when it's over." % nm
	elif party.count() >= party.MAX_MEMBERS:
		b.disabled = true
		b.tooltip_text = "The party is full."
	else:
		main.style_primary(b)
		b.add_theme_font_size_override("font_size", 16)
		b.tooltip_text = "Invite %s to your party: you play together from the main menu." % nm
		b.pressed.connect(func():
			b.disabled = true
			b.text = "Inviting…"
			party.invite(code, nm, func(res: Dictionary):
				say.call(("Invited %s. It reaches them within seconds." % nm) if bool(res.get("ok", false)) else String(res.get("msg", "Couldn't invite %s." % nm)))))
	return b


