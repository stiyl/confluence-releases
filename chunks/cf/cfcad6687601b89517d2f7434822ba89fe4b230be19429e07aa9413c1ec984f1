func item_compare(c, id: String) -> String:
	if c.items.size() >= sim.inv_slots() and sim.items_after(c, id).size() > sim.inv_slots():
		return "Your %s slots are full: sell something first." % ["", "one", "two", "three", "four", "five", "six"][sim.inv_slots()]   # 0.44: the Thrift twist holds three
	return ""


func shop_price_of(c, key: String) -> int:
	if key == "potion":
		return Sim.POTION_COST
	if key.begins_with("scroll:"):
		return sim.scroll_cost(c, key.substr(7))
	return sim.item_price(c, key)


func human_potion() -> void:
	if sim == null or sim.over or replay_mode:
		return
	var c = sim.players[sim.local].champ
	if c.potions <= 0:
		show_error("No potions. Buy them at the Armory (%d gold each)." % Sim.POTION_COST)
	elif c.pot_t > 0:
		show_error("A potion is already working.")
	elif c.hp >= c.max_hp:
		show_error("Your hero is at full health.")
	elif act("potion"):
		potion_btn.flash = 0.3
		update_hud()


func human_buy_potion() -> void:
	if sim == null or replay_mode:
		return
	match act("buypot"):
		"ok", "sent":
			update_hud()
		"shop":
			show_error("Walk your hero to the Armory beside the castle to buy potions.")
		"gold":
			show_error("Not enough gold.")
		"full":
			show_error("You can carry at most %d potions." % Sim.POTION_MAX)
	refresh_shop()


func human_buy(id: String) -> void:
	if sim == null or replay_mode:
		return
	var pl = sim.players[sim.local]
	if id == "potion":
		human_buy_potion()
		return
	if id.begins_with("scroll:"):
		var sid := id.substr(7)
		match act("scroll", [sid]):
			"ok", "sent":
				show_good("Read %s." % GameData.scroll(sid)["name"])
				update_hud()
			"shop":
				show_error("Walk your hero to the Armory beside the castle to buy scrolls.")
			"gold":
				show_error("Not enough gold.")
			"max":
				show_error("You've read the most of that scroll you can (%d)." % GameData.SCROLL_MAX)
		refresh_shop()
		return
	match act("buy", [id]):
		"ok", "sent":
			show_good("Bought %s." % GameData.item(id)["name"])
			update_hud()
		"shop":
			show_error("Walk your hero to the Armory beside the castle to buy items.")
		"gold":
			show_error("Not enough gold: %s costs %d." % [GameData.item(id)["name"], sim.item_price(pl.champ, id)])
		"full":
			show_error("Your six item slots are full. Sell something or buy an item that combines what you have.")
		"survival":
			show_error("In Survival, items come from the item cards at the end of a round. The Armory still sells potions and scrolls.")
	refresh_shop()


