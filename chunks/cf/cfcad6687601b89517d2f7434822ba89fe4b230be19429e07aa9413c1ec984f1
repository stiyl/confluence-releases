	_peer_seen[pid] = Time.get_ticks_msec()
	if is_host and in_match and peer_slot.has(pid) and k != "drop" and k != "rejoin" and k != "tune":   # 0.18.1: balance knobs are the host's alone
		pending.append([peer_slot[pid], k, a])


# Called every frame by the HUD while a match runs; returns how many ticks were stepped.
func run(delta: float) -> int:
	if sim == null or is_dropped or rejoining:
		return 0
	if not _cu.is_empty():
		var t0 := tick
		_run_catchup()
		return tick - t0
	if _rc_hold:
		_run_hold(delta)
		return 0
	if migrating or _mig_fill_wait:
		if is_host and migrating:
			_run_migration(delta)
		elif Time.get_ticks_msec() - _last_bundle_ms > STALL_DROP * 1000.0:
			_fail("The new host didn't answer.")
		return 0
	var n := 0
	var now := Time.get_ticks_msec()
	if is_host:
		acc = minf(acc + delta, 0.25)
		while acc >= TICK:
			acc -= TICK
			var cmds: Array = []
			if tick % BUNDLE_EVERY == 0:
				cmds = pending
				pending = []
				if _peer_ok():
					_bundle.rpc(tick, cmds)
			_exec(cmds)
			n += 1
		# a player whose game stopped answering (crash, lost connection) is dropped so the match goes on
		for pid in _peer_seen.keys():
			if pid != 1 and peer_slot.has(pid) and now - int(_peer_seen[pid]) > PEER_DROP * 1000.0:
				_log("peer %d silent for %ds: dropping" % [pid, int(PEER_DROP)])
				_peer_seen.erase(pid)
				if multiplayer.multiplayer_peer != null:
					multiplayer.multiplayer_peer.disconnect_peer(pid)
				_on_peer_disconnected(pid)
		# 0.26: after a re-claim, players who didn't come back in time hand their heroes to the AI
		for slot in _rc_missing.keys():
			if now < int(_rc_missing[slot]):
				continue
			_rc_missing.erase(slot)
			if peer_slot.values().has(slot) or not sim.players[slot].human:
				continue
			pending.append([slot, "drop", []])
			_chat_all("%s didn't come back — slot held by AI." % String(match_cfg["lineup"][slot].get("name", "A player")))
	elif spectating:
		n = _run_spectate(delta, now)   # 0.44: the same buffer, spec_delay further behind
		var silent := (now - _last_bundle_ms) / 1000.0
		if silent > STALL_WARN and not _stalled:
			_stalled = true
			stall_changed.emit(true, silent)
		elif _stalled and silent <= STALL_WARN:
			_stalled = false
			stall_changed.emit(false, 0.0)
		elif _stalled:
			stall_changed.emit(true, silent)
		if silent > STALL_DROP:
			_fail("Lost the connection to the host: no word from them for %d seconds." % int(STALL_DROP))
	else:
		# Jitter buffer: play at a steady 60 ticks a second, BUFFER_TICKS behind the newest bundle, so bundles
		# that arrive in bursts don't turn into stutter. Catch up gently when far behind (after loading).
		var ahead := _newest - tick + 1          # bundles waiting to be played
		if _buffering:
			if ahead >= BUFFER_TICKS or (ahead > 0 and now - _last_bundle_ms > 300):
				_buffering = false
		if not _buffering:
			var speed := 1.0
			if ahead > BUFFER_TICKS * 6:
				speed = 4.0
			elif ahead > BUFFER_TICKS * 2:
				speed = 1.5
			elif ahead < BUFFER_TICKS / 2:
				speed = 0.85
			acc = minf(acc + delta * speed, TICK * 10)
			var budget := 24
			while acc >= TICK and budget > 0 and bundles.has(tick):
				acc -= TICK
				var cmds: Array = bundles[tick]
				bundles.erase(tick)
				_exec(cmds)
				budget -= 1
				n += 1
			if not bundles.has(tick):
				acc = minf(acc, TICK)         # don't bank time while starved
				if ahead <= 0:
					_buffering = true          # refill the buffer before playing on
		# watchdog: no word from the host
		var silent := (now - _last_bundle_ms) / 1000.0
		if silent > STALL_WARN and not _stalled:
			_stalled = true
			_log("no bundle from the host for %.1fs" % silent)
			stall_changed.emit(true, silent)
		elif _stalled and silent <= STALL_WARN:
			_stalled = false
			_log("host is back")
			stall_changed.emit(false, 0.0)
		elif _stalled:
			stall_changed.emit(true, silent)
		if silent > STALL_DROP:
			_fail("Lost the connection to the host: no word from them for %d seconds." % int(STALL_DROP))
	return n


@rpc("authority", "reliable")
func _bundle(t: int, cmds: Array) -> void:
	bundles[t] = cmds
	for k in range(1, BUNDLE_EVERY):
		bundles[t + k] = []           # the steps between bundles carry no commands
	_newest = maxi(_newest, t + BUNDLE_EVERY - 1)
	_last_bundle_ms = Time.get_ticks_msec()


func _exec(cmds: Array, log_it := true) -> void:
	if log_it and not cmds.is_empty():
		cmd_log.append([tick, cmds])
	for c in cmds:
		sim.apply_cmd(int(c[0]), String(c[1]), c[2])
	sim.step(TICK)
	tick += 1
	if tick % SUM_EVERY == 0:
		var h := sim.checksum()
		if tick % 600 == 0:
			sum_trace[tick] = h      # every 10 s, for the tests (and the log) to compare across games
		if is_host:
			sums[tick] = h
			if sums.size() > 20:
				sums.erase(sums.keys().min())
		elif _peer_ok() and _cu.is_empty():
			_sum.rpc_id(1, tick, h)


@rpc("any_peer", "reliable")
func _sum(t: int, h: int) -> void:
	_peer_seen[multiplayer.get_remote_sender_id()] = Time.get_ticks_msec()
	if not is_host or desynced or not sums.has(t):
		return
	if int(sums[t]) != h:
		desynced = true
		_log("DESYNC at tick %d" % t)
		var pid := multiplayer.get_remote_sender_id()
		var nm: String = lobby["slots"][peer_slot.get(pid, 0)]["name"] if peer_slot.has(pid) else ("spectator %s" % String(spec_peers[pid].get("name", "?")) if spec_peers.has(pid) else "a player")
		_chat_all("Desync with %s at tick %d: their game no longer matches the host's." % [nm, t])


# ---------------------------------------------------------------- 0.44 Draft lobby (pick/ban online)
# The host owns a Draft (scripts/draft.gd) and pushes it in lobby["draft"] on every step and once a second for
# the clock; clients render it and send their choice with draft_act(). A team's bans are made by its captain
# (the human in its lowest slot); each pick by the slot's owner; AI slots and expired timers by the bot rules.
var draft: Draft = null
var _draft_push_t := 0.0
const DRAFT_REVEAL := 2.0          # seconds the finished board stays before the match starts


func _draft_begin() -> void:
	draft = Draft.new(randi())
	_draft_push_t = 0.0
	lobby["draft"] = draft.to_dict()
	_push_lobby()
	_chat_all("The draft begins: %s ban first." % Sim.TEAM_NAMES[0])


func _draft_cancel() -> void:
	draft = null
	lobby.erase("draft")


# The slot that acts on the current step (-1: a bot's step).
func draft_actor() -> int:
	var d: Dictionary = lobby.get("draft", {})
	if d.is_empty() or String(d.get("phase", "done")) == "done":
		return -1
	var dr := Draft.from_dict(d)
	if dr.phase == "pick":
		var sl := dr.slot_now()
		return sl if sl >= 0 and lobby["slots"][sl]["kind"] == "human" else -1
	var tm := dr.team_now()
	for i in 4:
		if lobby["slots"][tm * 4 + i]["kind"] == "human":
			return tm * 4 + i
	return -1


func draft_my_turn() -> bool:
	return draft_actor() >= 0 and draft_actor() == my_slot()


func draft_act(champ: String) -> void:
	if is_host:
		_draft_do(1, champ)
	else:
		_draft_act_rpc.rpc_id(1, champ)


@rpc("any_peer", "reliable")
func _draft_act_rpc(champ: String) -> void:
	if is_host:
		_draft_do(multiplayer.get_remote_sender_id(), champ)


func _draft_do(pid: int, champ: String) -> void:
	if draft == null or draft.done() or not peer_slot.has(pid):
		return
	if draft_actor() != int(peer_slot[pid]):
		return
	if draft.act(champ):
		_draft_after_step()


func _draft_after_step() -> void:
	lobby["draft"] = draft.to_dict()
	_draft_push_t = 0.0
	_push_lobby()
	if draft.done():
		_chat_all("Draft complete. The match starts in a moment.")
		_draft_push_t = -DRAFT_REVEAL


func _draft_process(dt: float) -> void:
	if not is_host or draft == null or not in_lobby:
		return
	if draft.done():
		_draft_push_t += dt
		if _draft_push_t >= 0.0:
			start()
		return
	var human_slots: Array = []
	for i in 8:
		if lobby["slots"][i]["kind"] == "human":
			human_slots.append(i)
	var actor := draft_actor()
	var stepped := false
	if actor >= 0:
		stepped = draft.tick(dt)   # a human's step: only the clock can make it
	else:
		stepped = draft.bot_tick(dt, [], [])   # a bot's step after its think
	if stepped:
		_draft_after_step()
		return
	_draft_push_t += dt
	if _draft_push_t >= 1.0:
		_draft_push_t = 0.0
		lobby["draft"] = draft.to_dict()
		_push_lobby()


# ---- 0.45 ranked ----
# A ranked match (scripts/ranked.gd talks to the relay's matchmaker): when everyone accepted, the relay names a room
# code and a host. The host opens that room (host_relay(code)), seats only the matched players on the teams the
# matchmaker made (by verified friend code), fixes the rules (1v1: "solo" with a blind pick; 4v4: the 0.44 Draft;
# the map from the relay, Normal, no tune overrides, spectators with >= RK_SPEC_DELAY s delay) and starts by itself
# when everyone is in. A lobby that doesn't fill within RK_FILL_WAIT is called off (the no-shows lose on the relay).
# Online matches can't be paused at all, so the "2 x 60 s per team" pause rule has nothing to limit.
signal ranked_off(missing: Array)    # the ranked lobby was called off (everyone's game reports it; missing: friend codes)
const RK_FILL_WAIT := 60.0
const RK_PICK_TIME := 30.0
const RK_SPEC_DELAY := 30.0
const RK_JOIN_FOR := 25.0            # a joiner retries the room this long while the host opens it
var rk := {}                         # the relay's "go" for the match being set up / played ({} = not ranked)
var _rk_picks := {}                  # host, 1v1: peer id -> hero (nobody else sees them before the start)
var rk_my_pick := ""                 # our own blind pick (shown only to us)
var _rk_join_t := 0.0                # joiner: seconds of retrying left
var _rk_retry_in := 0.0
var _rk_lobby_t := 0.0               # host: seconds since the ranked lobby opened
var _rk_full_t := -1.0               # host: seconds since everyone was in (1v1: the pick clock)


func ranked_begin(go: Dictionary) -> void:
	var code := String(go.get("code", ""))
	if bool(go.get("host", false)):
		host_relay(code)
	else:
		join_relay(code)
		_rk_join_t = RK_JOIN_FOR
	rk = go.duplicate(true)
	_rk_lobby_t = 0.0
	_rk_full_t = -1.0
	_log("ranked match %s (%s): %s room %s" % [String(go.get("id", "")), String(go.get("mode", "")), "hosting" if bool(go.get("host", false)) else "joining", code])


func is_ranked() -> bool:
	return lobby.has("ranked") and (in_lobby or in_match) or match_cfg.has("ranked")


func _rk_blind() -> bool:
	return is_host and lobby.has("ranked") and String(lobby["ranked"].get("mode", "")) == "1v1"


func _rk_team_of(fc: String) -> int:
	var want := _fc_norm(fc)
	var teams: Array = rk.get("teams", [])
	for t in teams.size():
		for c in teams[t]:
			if _fc_norm(String(c)) == want and want != "":
				return t
	return -1


func _rk_setup_lobby() -> void:
	var r1v1 := String(rk.get("mode", "")) == "1v1"
	lobby["ranked"] = {"id": String(rk.get("id", "")), "mode": String(rk.get("mode", "")), "teams": rk.get("teams", []), "names": rk.get("names", {})}
	lobby["mode"] = "solo" if r1v1 else "draft"
	lobby["map"] = posmod(int(rk.get("map", 0)), Sim.MAPS.size())
	lobby["diff"] = 1
	lobby["tune"] = {}
	lobby["spec"] = "anyone"
	_rk_picks.clear()
	_rk_lobby_t = 0.0
	_rk_full_t = -1.0
	var t := _rk_team_of(my_fc)
	if t == 1:
		lobby["slots"][4] = lobby["slots"][0]
		lobby["slots"][0] = {"kind": "ai", "peer": 0, "name": "", "champ": "", "ready": false}
		peer_slot[1] = 4


func _rk_seat(pid: int, pname: String, lvl: int, x: Dictionary) -> void:
	var t := _rk_team_of(String(x.get("fc", "")))
	if t < 0:
		_kick.rpc_id(pid, "This is a ranked match: only the matched players can join.")
		return
	var ts := team_size()
	for i in range(t * 4, t * 4 + ts):
		if lobby["slots"][i]["kind"] != "human":
			lobby["slots"][i] = {"kind": "human", "peer": pid, "name": pname.substr(0, 20), "champ": "", "ready": true, "lvl": lvl, "tok": String(x.get("tok", "")), "fc": String(x.get("fc", "")).substr(0, 9), "av": String(x.get("av", "")).substr(0, 32), "rt": clampi(int(x.get("rt", 0)), 0, 4000),
				"cos": Cosmetics.clean(x.get("cos", {})), "rk": String(x.get("rk", "")).substr(0, 24)}
			peer_slot[pid] = i
			_push_lobby()
			_chat_all("%s joined." % pname)
			return
	_kick.rpc_id(pid, "Your team in this ranked match is already full.")


func _rk_blind_pick(pid: int, champ: String) -> void:
	_rk_picks[pid] = champ
	lobby["slots"][peer_slot[pid]]["rk_pick"] = champ != ""
	_push_lobby()


# The matched players (friend codes) not in the lobby.
func _rk_missing() -> Array:
	var have := {}
	for s in lobby.get("slots", []):
		if s["kind"] == "human":
			have[_fc_norm(String(s.get("fc", "")))] = true
	var out: Array = []
	for tm in lobby.get("ranked", {}).get("teams", []):
		for c in tm:
			if not have.has(_fc_norm(String(c))):
				out.append(String(c))
	return out


func _rk_process(dt: float) -> void:
	if _rk_retry_in > 0.0:
		_rk_retry_in -= dt
		_rk_join_t -= dt
		if _rk_retry_in <= 0.0 and not rk.is_empty():
			var keep := rk.duplicate(true)
			var left_t := _rk_join_t
			join_relay(String(keep.get("code", "")))
			rk = keep
			_rk_join_t = left_t
	if not is_host or not in_lobby or in_match or not lobby.has("ranked"):
		return
	_rk_lobby_t += dt
	var missing := _rk_missing()
	if not missing.is_empty():
		_rk_full_t = -1.0
		if _rk_lobby_t >= RK_FILL_WAIT:
			_rk_call_off(missing)
		return
	if _rk_full_t < 0.0:
		_rk_full_t = 0.0
		_chat_all("Everyone is here." + ("  Blind pick: choose your hero (%d s)." % int(RK_PICK_TIME) if _rk_blind() else "  The draft begins."))
	_rk_full_t += dt
	if _rk_blind():
		var picked := 0
		for s in lobby["slots"]:
			if s["kind"] == "human" and _rk_picks.has(int(s["peer"])) and String(_rk_picks[int(s["peer"])]) != "":
				picked += 1
		if (picked >= 2 or _rk_full_t >= RK_PICK_TIME) and can_start() == "":
			start()
	elif draft == null and _rk_full_t >= 2.0 and can_start() == "":
		start()   # opens the Draft (mode "draft"); _draft_process starts the match when it is complete


func _rk_call_off(missing: Array) -> void:
	_log("ranked lobby called off, missing %s" % str(missing))
	_rk_off.rpc(missing)
	_rk_off(missing)


@rpc("authority", "reliable")
func _rk_off(missing: Array) -> void:
	ranked_off.emit(missing)
	var names: Array = []
	for c in missing:
		names.append(String(lobby.get("ranked", {}).get("names", {}).get(String(c), c)))
	leave("The ranked match was called off: %s didn't join in time." % ", ".join(names))


# A joiner whose host hasn't opened the room yet (4004) tries again for RK_JOIN_FOR s.
func _rk_retry(msg: String) -> bool:
	if rk.is_empty() or is_host or in_lobby or in_match or _rk_join_t <= 0.0:
		return false
	if not (msg.begins_with("No game with that room code") or msg.begins_with("Couldn't connect") or msg.begins_with("Couldn't reach the relay") or msg.begins_with("Disconnected")):
		return false
	_close_peer()
	_rk_retry_in = 1.5
	return true
# ---- end 0.45 ranked ----
␀␀␀␀␀␀␀␀␀␀␀␀␀# 0.29: controller support (Xbox / PlayStation / Switch pads, the Steam Deck's built-in controls).
# Two layers on top of the existing mouse-and-keyboard game, switching on the last device used:
#  1. a virtual cursor everywhere: a stick moves the real mouse pointer (warped, plus a synthesized motion event so
#     headless tests and every Control see it), A clicks (press / release, drags work), B is Esc, triggers scroll menus;
#  2. direct match controls: left stick walks, shoulders / triggers cast (hold to aim, release to cast), X attacks,
#     Y opens the sends & buildings wheel (tap) or is the modifier (hold), d-pad potion / Armory / items, Start pauses.
# Every match action calls the same main.gd functions the keys do (main.run_action / human_* -> act()), so the
# lockstep sim never sees the difference. Settings: Settings.pad_* and the [pad] binds.
class_name Pad
extends Node

const SYNTH := 77                   # device id of the mouse / key events made here (the device switch ignores them)
const CURSOR_SPEED := 1150.0        # viewport pixels a second at full tilt (x Settings.pad_cursor)
const EDGE := 14.0                  # the cursor stops this far inside the window; pushing on pans the camera
const MOVE_EVERY := 0.15            # left-stick walking: at most one move order per 0.15 s ...
const MOVE_REFRESH := 0.5           # ... and one at least every 0.5 s while the stick is held
const MOVE_TURN := 0.3              # ... or sooner when the direction turns by more than ~17 degrees
const MOVE_AHEAD := 170.0           # world units ahead of the hero the move order points
const AIM_FRESH := 1.5              # seconds: a cursor moved this recently aims abilities and attacks itself
const TAP := 0.4                    # Y released within this (and nothing pressed with it) = tap: the wheel

var main                            # scripts/main.gd
var axes := {}                      # JoyAxis -> value (the device used last)
var held := {}                      # button code (JoyButton or Settings.PAD_LT / PAD_RT) -> true while down
var device := 0
var cursor := Vector2(-1, -1)       # viewport coordinates
var cursor_t := 99.0                # seconds since a stick last moved the cursor
var pad_t := 99.0                   # seconds since the last controller event
var _click := false
var mod_used := false
var mod_t := 0.0
var aiming := -1
var board_t := -1.0                 # View held: the scoreboard peeks while held, a tap toggles it
var moving := false
var move_dir := Vector2.ZERO
var move_t := 99.0
var walk_lock := Vector2.ZERO       # an X order given while walking holds until the stick turns away or lets go
var scroll_acc := 0.0
var layer: CanvasLayer
var radial: Radial
var osk: Osk
var rebinding := ""                 # pad action waiting for a button (Settings page)
var on_rebound := Callable()        # the Settings page refresh
var log_cmds := false               # tests: count the move orders sent
var move_orders := 0
# rumble watch
var _hp_prev := -1.0
var _dmg_acc := 0.0
var _kills_prev := -1
var _dead_prev := false


func _init(m) -> void:
	main = m


func _ready() -> void:
	layer = CanvasLayer.new()
	layer.layer = 90
	add_child(layer)
	radial = Radial.new(self)
	layer.add_child(radial)
	osk = Osk.new(self)
	layer.add_child(osk)
	Input.joy_connection_changed.connect(_on_joy)
	for d in Input.get_connected_joypads():
		Settings.pad_auto_style = Settings.style_for_joy(Input.get_joy_name(d))
	if main.arena_view != null:
		main.arena_view.sfx.connect(func(snd: String, _v: float, _g: String):
			if snd.begins_with("boss"):
				rumble(0.5, 0.6, 0.45))


func _on_joy(d: int, connected: bool) -> void:
	if connected:
		Settings.pad_auto_style = Settings.style_for_joy(Input.get_joy_name(d))
	elif Settings.pad_on and Input.get_connected_joypads().is_empty():
		_set_pad(false)


func joy_name() -> String:
	var l := Input.get_connected_joypads()
	return Input.get_joy_name(l[0]) if not l.is_empty() else ""


func _set_pad(on: bool) -> void:
	if Settings.pad_on == on:
		return
	Settings.pad_on = on
	if not on:
		radial.close()
		osk.close()
	if main.has_method("refresh_hotkeys"):
		main.refresh_hotkeys()
		if main.sim != null and main.get("tut") != null and main.tut.running:
			main.tut.refresh()


# ---------------------------------------------------------------- input
func _input(event: InputEvent) -> void:
	if event is InputEventJoypadButton or event is InputEventJoypadMotion:
		if not Settings.pad_enabled:
			return
		get_viewport().set_input_as_handled()   # no GUI focus navigation underneath: the cursor does that
		if event is InputEventJoypadMotion:
			var v: float = event.axis_value
			axes[event.axis] = v
			if event.axis == JOY_AXIS_TRIGGER_LEFT or event.axis == JOY_AXIS_TRIGGER_RIGHT:
				var code := Settings.PAD_LT if event.axis == JOY_AXIS_TRIGGER_LEFT else Settings.PAD_RT
				if v > 0.5 and not held.has(code):
					_touch(event.device)
					_button(code, true)
				elif v < 0.3 and held.has(code):
					_button(code, false)
			elif absf(v) > Settings.pad_dead:
				_touch(event.device)
			return
		_touch(event.device)
		_button(event.button_index, event.pressed)
		return
	# a real key or mouse button hands the glyphs back to the keyboard (not within 1.5 s of a pad event: the Deck's
	# trackpad clicks while playing on the pad)
	if event.device == SYNTH:
		return
	if (event is InputEventKey and event.pressed and not event.echo) or (event is InputEventMouseButton and event.pressed):
		if Settings.pad_on and pad_t > 1.5:
			_set_pad(false)


func _touch(d: int) -> void:
	device = d
	pad_t = 0.0
	if not Settings.pad_on:
		if Settings.pad_style == 0:
			Settings.pad_auto_style = Settings.style_for_joy(Input.get_joy_name(d))
		_set_pad(true)


func in_match() -> bool:
	if main.sim == null or main.game == null or not main.game.visible or main.sim.over or main.paused or main.replay_mode:
		return false
	if main._modal_open() or main.end_ov.visible:
		return false
	if main.campaign_ui != null and main.campaign_ui.scene_on:
		return false
	if main.boon_ov != null and main.boon_ov.visible:
		return false
	return not (get_viewport().gui_get_focus_owner() is LineEdit)


func _button(code: int, pressed: bool) -> void:
	if pressed:
		held[code] = true
	else:
		held.erase(code)
	if rebinding != "":
		if pressed:
			if code != JOY_BUTTON_START or rebinding == "pause":
				Settings.rebind_pad(rebinding, code)
			rebinding = ""
			if on_rebound.is_valid():
				on_rebound.call()
		return
	var act := Settings.pad_action_for(code)
	if osk.visible:
		_osk_button(code, act, pressed)
		return
	if in_match():
		_match_button(code, act, pressed)
	else:
		_menu_button(code, act, pressed)


func _menu_button(code: int, act: String, pressed: bool) -> void:
	if pressed and main.friends_ui != null and main.friends_ui.pad_toast(code):
		return   # 0.30: X joins / Y declines an invite toast
	if code == JOY_BUTTON_X:
		_mouse(MOUSE_BUTTON_RIGHT, pressed)   # 0.30: X is right-click in menus (a player's name: Add friend / Whisper ...)
		return
	if act == "pad_click":
		if main.campaign_ui != null and main.campaign_ui.scene_on and not main.paused:
			if pressed:
				_key(KEY_SPACE)   # a scene: A moves the dialogue on, like Space
			return
		_mouse(MOUSE_BUTTON_LEFT, pressed)
		return
	if not pressed:
		return
	if act == "pad_back":
		if main.mode_card != null and main.mode_card.is_open():
			main.mode_card.dismiss(true)   # 0.46.1: B closes the first-time mode card ("Got it"), like Esc
			return
		_key(KEY_ESCAPE)
	elif act == "pause":
		if main.campaign_ui != null and main.campaign_ui.scene_on:
			main.toggle_pause()
		elif main.sim != null and main.game.visible and main.paused and not main._modal_open():
			main.toggle_pause()
	elif (code == JOY_BUTTON_LEFT_SHOULDER or code == JOY_BUTTON_RIGHT_SHOULDER) and main.settings_ov != null and main.settings_ov.is_visible_in_tree():
		main.settings_ui.cycle_tab(-1 if code == JOY_BUTTON_LEFT_SHOULDER else 1)   # 0.35: LB / RB switch the Settings tabs
	elif (code == JOY_BUTTON_LEFT_SHOULDER or code == JOY_BUTTON_RIGHT_SHOULDER) and main.profile_ov != null and main.profile_ov.is_visible_in_tree() and main.profile_ui != null:
		main.profile_ui.cycle_tab(-1 if code == JOY_BUTTON_LEFT_SHOULDER else 1)   # 0.43: ... and the Profile tabs
	elif code == JOY_BUTTON_LEFT_SHOULDER:
		_wheel(MOUSE_BUTTON_WHEEL_UP, 3)
	elif code == JOY_BUTTON_RIGHT_SHOULDER:
		_wheel(MOUSE_BUTTON_WHEEL_DOWN, 3)
	elif code >= JOY_BUTTON_DPAD_UP and code <= JOY_BUTTON_DPAD_RIGHT:
		snap([Vector2.UP, Vector2.DOWN, Vector2.LEFT, Vector2.RIGHT][code - JOY_BUTTON_DPAD_UP])


func _match_button(code: int, act: String, pressed: bool) -> void:
	var modb := Settings.pad_button("pad_mod")
	if code == modb:
		if pressed:
			mod_used = false
			mod_t = 0.0
		elif not mod_used and mod_t < TAP:
			radial.toggle()
		return
	if held.has(modb) and pressed:
		mod_used = true
		var si: int = main._skill_actions().find(act)
		if si >= 0:
			main.human_learn(si)
		elif Settings.PAD_MOD_ACTIONS.has(code):
			main.pad_action(Settings.PAD_MOD_ACTIONS[code])
		return
	if main.ping_wheel != null and main.ping_wheel.visible and String(main.ping_g.get("src", "")) == "pad" and pressed:
		# 0.31: the ping wheel is open (L3 held): A sends the pointed call, B cancels
		if act == "pad_click":
			main.ping_release()
			return
		if act == "pad_back":
			main.ping_cancel()
			return
	if pressed and (code == JOY_BUTTON_LEFT_SHOULDER or code == JOY_BUTTON_RIGHT_SHOULDER) and main.shop_panel != null and main.shop_panel.visible and not radial.visible:
		main.shop_panel.cycle_filter(-1 if code == JOY_BUTTON_LEFT_SHOULDER else 1)   # 0.39: LB / RB switch the Armory's filters
		return
	if radial.visible and pressed:
		if act == "pad_click":
			radial.accept()
			return
		if act == "pad_back":
			radial.back()
			return
		if act == "pad_attack":
			main.run_action("lane")
			return
	match act:
		"pad_click":
			_mouse(MOUSE_BUTTON_LEFT, pressed)
		"pad_back":
			if pressed:
				back()
		"pad_attack":
			if pressed:
				attack()
		"skill_q", "skill_w", "skill_e", "skill_r":
			var i: int = main._skill_actions().find(act)
			if pressed:
				aim_start(i)
			elif aiming == i:
				aim_release(i)
		"potion":
			if pressed:
				main.pad_action("buyback" if main.sim.players[main.sim.local].champ.dead else "potion")
		"item1", "item2":
			if pressed:
				use_active(0 if act == "item1" else 1)
		"board":
			if pressed:
				main.pad_action("board")
				board_t = 0.0 if main.board_open else -1.0
			elif board_t > 0.35 and main.board_open:
				main.pad_action("board")   # held: a peek, closed on release
		"shop", "center", "pause":
			if pressed:
				main.pad_action(act)
		"ping":
			# 0.31: L3 tap = a quick ping at the cursor, hold = the ping wheel (a stick points, let go sends)
			if pressed:
				if cursor.x < 0:
					cursor = get_viewport().get_mouse_position()
				main.ping_pad_press(cursor)
			elif String(main.ping_g.get("src", "")) == "pad":
				main.ping_release()


# B: the Esc chain of the match (wheel, aim, attack-move, swap, open panel), then Stop.
func back() -> void:
	if main.preview_i >= 0:
		main.cancel_preview()
		aiming = -1
		return
	if main.amove_armed:
		main.set_amove_armed(false)
		return
	if main.swap_from >= 0:
		main.swap_from = -1
		main.update_hud()
		return
	if main._close_top_overlay():
		return
	main.pad_action("stop")


# ---------------------------------------------------------------- the match: walking, attacking, aiming
func _hero():
	if main.sim == null:
		return null
	return main.sim.players[main.sim.local].champ


# A stick direction (screen space) as a world direction for the hero: the camera may look from either side.
func world_dir(v: Vector2) -> Vector2:
	var c = _hero()
	if c == null or v == Vector2.ZERO:
		return Vector2.ZERO
	var av: ArenaView = main.arena_view
	var hs := av.to_screen(c.p)
	var d: Vector2 = av.to_world(hs + v.normalized() * 120.0) - c.p
	return d.normalized() if d.length() > 0.001 else Vector2.ZERO


func walk(v: Vector2, delta: float) -> void:
	var c = _hero()
	move_t += delta
	if walk_lock != Vector2.ZERO:
		if v == Vector2.ZERO:
			walk_lock = Vector2.ZERO
			moving = false
			return
		if world_dir(v).dot(walk_lock) > 0.7:
			return
		walk_lock = Vector2.ZERO
	if c == null or c.dead or v == Vector2.ZERO:
		if moving:
			moving = false
			if c != null and not c.dead and main.my_view():
				main.act("order", ["stop"])
		move_t = 99.0
		return
	if not main.my_view() or not main.arena_view.follow:
		main.center_on_hero()   # walking with the stick brings the camera along
	var wd := world_dir(v)
	if wd == Vector2.ZERO:
		return
	var turn := absf(wd.angle_to(move_dir)) if moving else PI
	if move_t >= MOVE_EVERY and (turn > MOVE_TURN or move_t >= MOVE_REFRESH):
		if main.amove_armed:
			main.set_amove_armed(false)
		main.act("order", ["move", c.p + wd * MOVE_AHEAD])
		move_orders += 1
		moving = true
		move_dir = wd
		move_t = 0.0


# The enemy to hit: under a freshly moved cursor, else the nearest in reach (favouring the left stick's direction).
func pick_target(reach := 450.0):
	var c = _hero()
	if c == null or c.ar == null:
		return null
	if c.ar.duel and main.sim.duel_pair.size() == 2:
		return main.sim.duel_pair[1] if main.sim.duel_pair[0] == c else main.sim.duel_pair[0]
	if cursor_t < AIM_FRESH and main.mouse_in:
		var o = main.arena_view.pick(main.mouse_world)
		if o is Sim.Mon and not o.dead:
			return o
	var wd := world_dir(_stick(true))
	var best = null
	var bs := INF
	for m in c.ar.mons:
		if m.dead:
			continue
		var dv: Vector2 = m.p - c.p
		var d := dv.length()
		if d > reach:
			continue
		var s := d
		if wd != Vector2.ZERO and d > 1.0:
			s -= wd.dot(dv / d) * 180.0
		if s < bs:
			bs = s
			best = m
	return best


func attack() -> void:
	var c = _hero()
	if c == null or c.dead or main.replay_mode:
		return
	if not main.my_view():
		main.center_on_hero()
	main.set_amove_armed(false)
	var t = pick_target()
	var sd := world_dir(_stick(true))
	if sd != Vector2.ZERO:
		walk_lock = sd   # keep the stick held: the attack goes on instead of the next walk order
	moving = false
	if t != null:
		main.act("order", ["attack", t.p, main.sim.ref_of(t)])
		main.arena_view.move_mark = {"p": t.p, "t": 0.5, "col": Color(1.0, 0.3, 0.25)}
		return
	var wd := world_dir(_stick(true))
	if wd != Vector2.ZERO:
		var p: Vector2 = c.p + wd * 300.0
		main.act("order", ["amove", p])
		main.arena_view.move_mark = {"p": main.sim.walk_clamp(p), "t": 0.5, "col": Color(1.0, 0.3, 0.25)}
	else:
		main.show_error("Nothing to attack nearby: push the left stick and press %s to attack-move." % Settings.key_name("pad_attack"))


# Where an ability aims when the cursor was not moved just now: the enemy in the left stick's direction, a point
# that way, or the keyboard's auto-aim (the duel foe, else the monster furthest along the road).
func aim_point(c) -> Vector2:
	var v := _stick(true)
	if v != Vector2.ZERO:
		var t = pick_target(420.0)
		var wd := world_dir(v)
		if t != null and (t.p - c.p).normalized().dot(wd) > 0.7:
			return t.p
		return c.p + wd * 220.0
	return main.auto_aim(c)


func aim_start(i: int) -> void:
	var c = _hero()
	if c == null:
		return
	if not main.my_view():
		main.human_cast(i, true)
		return
	if not (cursor_t < AIM_FRESH and main.mouse_in):
		var p := aim_point(c)
		place_cursor(main.arena_view.get_global_transform() * main.arena_view.to_screen(p))
		main.mouse_world = p
		main.mouse_in = true
	if Settings.quick_cast:
		main.human_cast(i, false)
		return
	main.begin_preview(i, -1)
	if main.preview_i == i:
		aiming = i


func aim_release(i: int) -> void:
	aiming = -1
	if main.preview_i == i:
		main.release_preview()


# The d-pad's item buttons use the first / second item that has an active, wherever it sits in the bag.
func active_slots() -> Array:
	var c = _hero()
	var out: Array = []
	if c == null:
		return out
	for s in c.items.size():
		if GameData.item(c.items[s]).has("act"):
			out.append(s)
	return out


func use_active(n: int) -> void:
	var sl := active_slots()
	if n >= sl.size():
		main.show_error("No item with an active in that slot: actives go on %s and %s, in bag order." % [Settings.pad_name("item1"), Settings.pad_name("item2")])
		return
	main.pad_action("item%d" % (sl[n] + 1))


# ---------------------------------------------------------------- the cursor and synthesized mouse events
func _stick(left: bool) -> Vector2:
	if Settings.pad_southpaw:
		left = not left
	var v := Vector2(float(axes.get(JOY_AXIS_LEFT_X if left else JOY_AXIS_RIGHT_X, 0.0)), float(axes.get(JOY_AXIS_LEFT_Y if left else JOY_AXIS_RIGHT_Y, 0.0)))
	var l := v.length()
	var dz := Settings.pad_dead
	if l < dz:
		return Vector2.ZERO
	return v / l * minf(1.0, (l - dz) / (1.0 - dz))


func _vp_size() -> Vector2:
	return get_viewport().get_visible_rect().size


func place_cursor(p: Vector2) -> void:
	var sz := _vp_size()
	cursor = Vector2(clampf(p.x, EDGE, sz.x - EDGE), clampf(p.y, EDGE, sz.y - EDGE))
	cursor_t = 0.0
	_motion()


func _motion() -> void:
	var vp := get_viewport()
	if DisplayServer.get_name() != "headless" and DisplayServer.window_is_focused():
		vp.warp_mouse(cursor)
	var ev := InputEventMouseMotion.new()
	ev.device = SYNTH
	var wp: Vector2 = vp.get_final_transform() * cursor
	ev.position = wp
	ev.global_position = wp
	ev.button_mask = MOUSE_BUTTON_MASK_LEFT if _click else 0
	Input.parse_input_event(ev)


func _mouse(btn: int, pressed: bool) -> void:
	if cursor.x < 0:
		cursor = get_viewport().get_mouse_position()
	if btn == MOUSE_BUTTON_LEFT:
		if pressed == _click:
			return
		_click = pressed
	var ev := InputEventMouseButton.new()
	ev.device = SYNTH
	var wp: Vector2 = get_viewport().get_final_transform() * cursor
	ev.position = wp
	ev.global_position = wp
	ev.button_index = btn
	ev.pressed = pressed
	ev.button_mask = MOUSE_BUTTON_MASK_LEFT if _click else 0
	Input.parse_input_event(ev)


func _wheel(btn: int, n := 1) -> void:
	for i in n:
		_mouse(btn, true)
		_mouse(btn, false)


func _key(k: int) -> void:
	for down in [true, false]:
		var ev := InputEventKey.new()
		ev.device = SYNTH
		ev.keycode = k
		ev.physical_keycode = k
		ev.pressed = down
		Input.parse_input_event(ev)


# D-pad in menus: jump the cursor to the nearest button that way (on the topmost overlay when one is open).
func snap(dir: Vector2) -> void:
	if cursor.x < 0:
		cursor = get_viewport().get_mouse_position()
	var root: Node = main
	for ov in [main.settings_ov, main.profile_ov, main.codex_ov, main.gloss_ov, main.talent_ov, main.hex_ov, main.tune_ui] + (main.friends_ui.overlays() if main.friends_ui != null else []) + [main.pause_ov, main.end_ov]:
		if ov != null and ov.is_visible_in_tree():
			root = ov
			break
	var best: Control = null
	var bs := INF
	var sz := _vp_size()
	for b in root.find_children("*", "BaseButton", true, false):
		var bc := b as BaseButton
		if not bc.is_visible_in_tree() or bc.disabled or bc.mouse_filter == Control.MOUSE_FILTER_IGNORE:
			continue
		var cc := bc.get_global_transform() * (bc.size / 2.0)   # 0.35: right inside a scaled-down (FitCenter) card too
		if not Rect2(Vector2.ZERO, sz).has_point(cc):
			continue
		var dv := cc - cursor
		var along := dv.dot(dir)
		if along < 8.0:
			continue
		var s := along + absf(dv.dot(dir.orthogonal())) * 2.5
		if s < bs:
			bs = s
			best = bc
	if best != null:
		var sc := best.get_parent()
		while sc != null and not (sc is ScrollContainer) and sc != root:
			sc = sc.get_parent()
		if sc is ScrollContainer:
			(sc as ScrollContainer).ensure_control_visible(best)   # 0.35: a long Settings tab scrolls to the snapped control
			await get_tree().process_frame
		place_cursor(best.get_global_transform() * (best.size / 2.0))


func _process(delta: float) -> void:
	pad_t += delta
	cursor_t += delta
	mod_t += delta
	if board_t >= 0.0:
		board_t += delta
	if not Settings.pad_enabled:
		return
	var vp := get_viewport()
	var real := vp.get_mouse_position()
	if cursor.x < 0 or (cursor_t > 0.25 and real.distance_to(cursor) > 2.0):
		cursor = real   # the mouse (or the Deck's trackpad) moved it
	var ctx := in_match()
	if radial.visible and not ctx:
		radial.close()
	if aiming >= 0 and not ctx:
		aiming = -1   # paused or a panel opened while aiming: the aim is dropped, nothing casts on release
		if main.preview_i >= 0:
			main.cancel_preview()
	var l := _stick(true)
	var r := _stick(false)
	var cv := r if ctx else (r if r.length() > l.length() else l)
	if osk.visible:
		cv = r if r.length() > l.length() else l
	if radial.visible:
		var pick := l if l.length() > r.length() else r
		radial.point(pick)
		cv = Vector2.ZERO
	var pinging: bool = ctx and main.ping_wheel != null and main.ping_wheel.visible and String(main.ping_g.get("src", "")) == "pad"
	if pinging:
		# 0.31: the ping wheel: either stick points (the hero stops walking while it is open)
		if main.ping_wheel.point_dir(l if l.length() > r.length() else r, 0.5):
			main.audio.play("click", -16.0)
		cv = Vector2.ZERO
	if cv != Vector2.ZERO:
		var sp := CURSOR_SPEED * Settings.pad_cursor * pow(cv.length(), 1.7)
		var want := cursor + cv.normalized() * sp * delta
		var sz := _vp_size()
		var push := Vector2(
			-1.0 if want.x < EDGE else (1.0 if want.x > sz.x - EDGE else 0.0),
			-1.0 if want.y < EDGE else (1.0 if want.y > sz.y - EDGE else 0.0))
		place_cursor(want)
		if ctx and push != Vector2.ZERO:
			main.arena_view.pad_pan(push.normalized() * cv.length(), delta)
	if ctx and not radial.visible and not osk.visible and not pinging:
		walk(l, delta)
	elif moving:
		walk(Vector2.ZERO, delta)
	if not ctx and not osk.visible:
		# menus: the triggers scroll whatever is under the cursor
		var t := float(axes.get(JOY_AXIS_TRIGGER_RIGHT, 0.0)) - float(axes.get(JOY_AXIS_TRIGGER_LEFT, 0.0))
		if absf(t) > 0.15:
			scroll_acc += t * 14.0 * delta
			while absf(scroll_acc) >= 1.0:
				_wheel(MOUSE_BUTTON_WHEEL_DOWN if scroll_acc > 0 else MOUSE_BUTTON_WHEEL_UP)
				scroll_acc -= signf(scroll_acc)
		else:
			scroll_acc = 0.0
	_osk_watch()
	_rumble_watch(delta)


# ---------------------------------------------------------------- rumble (light; Settings "Vibration")
func rumble(weak: float, strong: float, secs: float) -> void:
	if not Settings.pad_on or not Settings.pad_rumble:
		return
	Input.start_joy_vibration(device, clampf(weak, 0.0, 1.0), clampf(strong, 0.0, 1.0), secs)


func _rumble_watch(delta: float) -> void:
	var c = _hero()
	if c == null or main.replay_mode or not main.game.visible:
		_hp_prev = -1.0
		_kills_prev = -1
		return
	if _hp_prev >= 0.0 and c.hp < _hp_prev:
		_dmg_acc += _hp_prev - c.hp
	_dmg_acc = maxf(0.0, _dmg_acc - c.max_hp * 0.25 * delta)
	if _dmg_acc > c.max_hp * 0.18:
		_dmg_acc = 0.0
		rumble(0.35, 0.2, 0.14)
	_hp_prev = c.hp
	if c.dead and not _dead_prev:
		rumble(0.6, 0.7, 0.4)
	_dead_prev = c.dead
	if _kills_prev >= 0 and c.kills > _kills_prev:
		rumble(0.45, 0.15, 0.12)
	_kills_prev = c.kills


# ---------------------------------------------------------------- on-screen keyboard
func _osk_watch() -> void:
	var f := get_viewport().gui_get_focus_owner()
	var want: bool = Settings.pad_on and f is LineEdit and f.editable and pad_t < 600.0 \
		and not (main.net != null and main.net.steam_ok and main.net.steam_deck)
	if want and (not osk.visible or osk.target != f):
		osk.open(f)
	elif not want and osk.visible:
		osk.close()


func _osk_button(code: int, act: String, pressed: bool) -> void:
	if act == "pad_click":
		_mouse(MOUSE_BUTTON_LEFT, pressed)
		return
	if not pressed:
		return
	if act == "pad_back":
		osk.backspace()
	elif act == "pause":
		osk.done()
	elif code == Settings.pad_button("pad_mod"):
		osk.shift = not osk.shift
		osk.relabel()
	elif act == "pad_attack":
		osk.type(" ")
	elif code >= JOY_BUTTON_DPAD_UP and code <= JOY_BUTTON_DPAD_RIGHT:
		osk.nav([Vector2i(0, -1), Vector2i(0, 1), Vector2i(-1, 0), Vector2i(1, 0)][code - JOY_BUTTON_DPAD_UP])
	elif code == JOY_BUTTON_LEFT_SHOULDER or code == JOY_BUTTON_RIGHT_SHOULDER:
		osk.caret(-1 if code == JOY_BUTTON_LEFT_SHOULDER else 1)


# ================================================================= the sends & buildings wheel
# Ring 1: the six buildings (owned: open its sends; the next one: build it). Ring 2: that building's eight sends.
# A stick points, A buys (again and again), B steps back / closes, X switches the rift. Same human_build /
# human_send calls as the keys, so the refusals and toasts are the same.
class Radial extends Control:
	var pad
	var stage := 0          # 0 buildings, 1 sends of `bld`
	var bld := 0
	var sel := 0
	var _t := 0.0

	func _init(p) -> void:
		pad = p
		visible = false
		set_anchors_preset(Control.PRESET_FULL_RECT)
		mouse_filter = Control.MOUSE_FILTER_IGNORE

	func toggle() -> void:
		if visible:
			close()
		else:
			open()

	func open() -> void:
		var m = pad.main
		if m.sim == null:
			return
		if m.sim.mode == "survival":
			m.show_error("There is no enemy team in Survival: spend your gold on items, scrolls and the crystal.")
			return
		var pl = m.sim.players[m.sim.local]
		stage = 0
		sel = clampi(m.send_tab, 0, 5)
		if pl.tech > 0:
			stage = 1
			bld = clampi(m.send_tab, 0, pl.tech - 1)
			sel = 0
		visible = true
		m.audio.play("click", -8.0)
		queue_redraw()

	func close() -> void:
		visible = false

	func count() -> int:
		return 6 if stage == 0 else GameData.sends_of(bld).size()

	func point(v: Vector2) -> void:
		if v.length() < 0.55:
			return
		var n := count()
		var a := fposmod(v.angle() + PI / 2.0 + PI / n, TAU)   # wedge 0 at the top, clockwise
		var s := int(a / (TAU / n)) % n
		if s != sel:
			sel = s
			pad.main.audio.play("click", -16.0)

	func accept() -> void:
		var m = pad.main
		var pl = m.sim.players[m.sim.local]
		if stage == 0:
			if sel < pl.tech:
				stage = 1
				bld = sel
				sel = 0
				m.set_send_tab(bld)
			else:
				m.human_build(sel)
				if pl.tech > sel:
					stage = 1
					bld = sel
					sel = 0
		else:
			var ids: Array = GameData.sends_of(bld)
			if sel < ids.size():
				if m.send_tab != bld:
					m.set_send_tab(bld)
				m.human_send(ids[sel], sel)
		queue_redraw()

	func back() -> void:
		if stage == 1:
			stage = 0
			sel = bld
		else:
			close()

	func _process(delta: float) -> void:
		if visible:
			_t += delta
			queue_redraw()

	func _center() -> Vector2:
		return Vector2(size.x / 2.0, 34.0 + (size.y - 212.0 - 34.0) / 2.0)

	func _draw() -> void:
		var m = pad.main
		if m.sim == null:
			return
		var pl = m.sim.players[m.sim.local]
		var c := _center()
		var ro := minf(205.0, (size.y - 212.0 - 34.0) / 2.0 - 8.0)
		var ri := ro * 0.42
		var n := count()
		var f := UIParts.font("ui_semi")
		var fnum := UIParts.font("num_semi")
		UIParts.soft_shade(self, c, ro * 1.25, ro * 1.25, 0.35)
		for i in n:
			var a0 := -PI / 2.0 - PI / n + TAU * i / n + 0.012
			var a1 := a0 + TAU / n - 0.024
			var pts := PackedVector2Array()
			for k in 13:
				pts.append(c + Vector2.from_angle(lerpf(a0, a1, k / 12.0)) * ro)
			for k in 13:
				pts.append(c + Vector2.from_angle(lerpf(a1, a0, k / 12.0)) * ri)
			var on := i == sel
			var state := ""   # "", "dim", "lock"
			var icon := ""
			var line := ""
			var col := UIParts.TEXT
			if stage == 0:
				var bd: Dictionary = GameData.BUILDINGS[i]
				icon = "bld_" + String(bd["id"])
				if i < pl.tech:
					line = String(bd["name"]).split(" ")[-1]
				elif i == pl.tech and i < int(m.sim.max_tech[pl.team]):
					line = "%d" % Sim.building_cost(i)
					col = UIParts.COIN_LITE if pl.gold >= Sim.building_cost(i) else UIParts.DANGER
				else:
					state = "lock"
			else:
				var k: int = GameData.sends_of(bld)[i]
				icon = "mon:" + String(GameData.SENDS[k]["k"])
				var cost: int = m.sim.send_cost(k, m.myt())
				line = "%d" % cost
				col = UIParts.COIN_LITE if pl.gold >= cost and m.sim.send_refusal(pl, k) == "" else UIParts.DANGER
			var fill := UIParts.STONE_2.lerp(Color("#4a463c"), 0.6) if on else UIParts.STONE_1
			draw_colored_polygon(pts, Color(fill, 0.95))
			pts.append(pts[0])
			draw_polyline(pts, Color(0, 0, 0, 0.8), 3.0, true)
			draw_polyline(pts, UIParts.BRONZE_LITE if on else UIParts.BRONZE_DARK.lightened(0.25), 2.0 if on else 1.0, true)
			var mid := c + Vector2.from_angle((a0 + a1) / 2.0) * (ri + ro) / 2.0
			var isz := minf(52.0, (ro - ri) * 0.55)
			var ir := Rect2(mid - Vector2(isz, isz) / 2.0 - Vector2(0, 7), Vector2(isz, isz))
			if icon.begins_with("mon:"):
				if not UIParts.draw_tight(self, Sprites.mon_sheet(icon.substr(4)), ir, 3):
					draw_circle(ir.get_center(), isz * 0.3, Color(GameData.MON[icon.substr(4)]["col"]))
			elif not Sprites.draw_fit(self, icon, ir.grow(4), 0, 0, 1.15):
				UIParts.draw_glyph(self, "summon", ir, UIParts.TEXT)
			if state == "lock":
				draw_colored_polygon(pts, Color(0.03, 0.02, 0.02, 0.55))
				UIParts.lock_glyph(self, mid + Vector2(0, -6), 0.9)
			if line != "":
				var fl: Font = fnum if line.is_valid_int() else f
				var tp := Vector2(mid.x - 60, ir.end.y + 13)
				draw_string_outline(fl, tp, line, HORIZONTAL_ALIGNMENT_CENTER, 120, 13, 4, Color(0, 0, 0, 0.9))
				draw_string(fl, tp, line, HORIZONTAL_ALIGNMENT_CENTER, 120, 13, col)
		# hub: a round stone plate with what A would do and the rift
		draw_circle(c, ri - 6.0, Color(0, 0, 0, 0.8))
		draw_circle(c, ri - 7.0, UIParts.STONE)
		draw_arc(c, ri - 8.0, 0, TAU, 48, UIParts.BRONZE, 2.0, true)
		draw_arc(c, ri - 11.0, 0, TAU, 48, Color(UIParts.BRONZE_LITE, 0.2), 1.0, true)
		var title := ""
		var sub := ""
		if stage == 0:
			var bd: Dictionary = GameData.BUILDINGS[sel]
			title = String(bd["name"])
			if sel < pl.tech:
				sub = "open"
			elif sel == pl.tech and sel < int(m.sim.max_tech[pl.team]):
				sub = "build"
			else:
