func show_inv_tip(slot: int) -> void:
	if sim == null:
		return
	var c = inv_hero()
	if c != sim.players[sim.local].champ:
		var who := "%s (%s)" % [c.pl.name, String(c.def["name"]).split(" ")[0]]
		if slot >= c.items.size():
			show_tip(inv_btns[slot], "Empty slot", who, "No item in this slot yet.")
			return
		var oid: String = c.items[slot]
		var oit := GameData.item(oid)
		var om := "Carried by " + who
		if oit.has("act"):
			var ocd: float = float(c.act_cd.get(oid, 0.0))
			om += "  ·  %s %s" % [oit["act"]["name"], ("ready" if ocd <= 0.0 else "ready in %ds" % ceili(ocd))]
		show_tip(inv_btns[slot], oit["name"], om, "\n".join(GameData.item_lines(oid)))
		return
	if slot >= c.items.size():
		show_tip(inv_btns[slot], "Empty slot", "", "Buy items at the Armory beside the castle (B). Up to six items.")
		return
	var id: String = c.items[slot]
	var it := GameData.item(id)
	var meta := "Sells for %d gold  ·  right-click to sell at the Armory  ·  drag or Shift+click to swap slots" % sim.sell_value(id)
	if it.has("act"):
		meta = "Click or press %s to use %s  ·  %s" % [Settings.key_name("item%d" % (slot + 1)), it["act"]["name"], meta]
	show_tip(inv_btns[slot], it["name"], meta, "\n".join(GameData.item_lines(id)))


