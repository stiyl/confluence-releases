const INV_SLOTS := 6

static var _item_idx := {}


static func item(id: String) -> Dictionary:
	if _item_idx.is_empty():
		for it in ITEMS:
			_item_idx[it["id"]] = it
	return _item_idx.get(id, {})


# Full price of an item bought from nothing.
static func item_total(id: String) -> int:
	var it := item(id)
	var c := int(it["cost"])
	for k in it["from"]:
		c += item_total(k)
	return c


static func builds_into(id: String) -> Array:
	var out: Array = []
	for it in ITEMS:
		if id in it["from"] and not out.has(it["id"]):
			out.append(it["id"])
	return out


# 0.38 Armory filter: an item's stats priced in gold (roughly what the basic items pay per point), summed per
# category. An item shows under every category worth at least a quarter of it; its main category sorts it.
const ITEM_CATS := ["attack", "ability", "defense", "speed", "utility"]
const _CAT_OF := {"dmg": "attack", "as": "attack", "crit": "attack", "ls": "attack", "onhit": "attack",
	"ap": "ability", "cdr": "ability", "sv": "ability", "hp": "defense", "armor": "defense", "regen": "defense",
	"ms": "speed", "gpk": "utility", "mig": "utility", "res": "utility", "cun": "utility"}
const _GOLD_PER := {"dmg": 8.5, "as": 650.0, "crit": 1100.0, "ls": 1000.0, "onhit": 8.0, "ap": 640.0, "cdr": 1500.0,
	"sv": 1000.0, "hp": 0.5, "armor": 1300.0, "regen": 15.0, "ms": 670.0, "gpk": 50.0, "mig": 10.0, "res": 10.0, "cun": 10.0}


static func item_cat_values(it: Dictionary) -> Dictionary:
	var v := {}
	for k in _CAT_OF:
		if it.has(k):
			var c: String = _CAT_OF[k]
			v[c] = float(v.get(c, 0.0)) + float(it[k]) * float(_GOLD_PER[k])
	if it.has("u") or it.has("act"):
		v["utility"] = float(v.get("utility", 0.0)) * 0.5   # a unique leans on its main stats
	return v


# The categories an item shows under in the Armory filter (boots are always Speed too).
static func item_cats(it: Dictionary) -> Array:
	var v := item_cat_values(it)
	var tot := 0.0
	for c in v:
		tot += float(v[c])
	var out: Array = []
	for c in ITEM_CATS:
		if tot > 0.0 and float(v.get(c, 0.0)) >= 0.25 * tot:
			out.append(c)
	if it.get("boots", false) and not out.has("speed"):
		out.append("speed")
	return out


static func item_cat(it: Dictionary) -> String:
	if it.get("boots", false):
		return "speed"
	var v := item_cat_values(it)
	var best := "utility"
	var bv := 0.0
	for c in ITEM_CATS:
		if float(v.get(c, 0.0)) > bv:
			best = c
			bv = float(v[c])
	return best


# 0.38: short item text, numbers first. "dmg" is Attack Power (basic attacks only), "ap" is Ability Power
# (abilities only), shown as points: 1 point = abilities 1% stronger.
static func stat_line(k: String, v: float) -> String:
	match k:
		"mig": return "+%d Might" % roundi(v)
		"res": return "+%d Resolve" % roundi(v)
		"cun": return "+%d Cunning" % roundi(v)
		"dmg": return "+%d Attack Power" % roundi(v)
		"ap": return "+%d Ability Power" % roundi(v * 100)
		"as": return "+%d%% Attack Speed" % roundi(v * 100)
		"hp": return "+%d Health" % roundi(v)
		"armor": return "+%d%% Armor" % roundi(v * 100)
		"ms": return "+%d%% Movement Speed" % roundi(v * 100)
		"regen": return "+%s Health Regen" % (str(roundi(v)) if v == roundf(v) else "%.1f" % v)
		"cdr": return "+%d%% Cooldown Reduction" % roundi(v * 100)
		"ls": return "+%d%% Life Steal" % roundi(v * 100)
		"sv": return "+%d%% Spell Vamp" % roundi(v * 100)
		"crit": return "+%d%% Critical Chance" % roundi(v * 100)
		"onhit": return "+%d On-Hit Damage" % roundi(v)
		"gpk": return "+%d Gold per Kill" % roundi(v)
	return ""


static func item_lines(id: String) -> Array:
	var it := item(id)
	var out: Array = []
	for k in ITEM_STATS:
		if it.has(k):
			out.append(stat_line(k, float(it[k])))
	if it.get("boots", false):
		out.append("Boots: only your fastest pair counts.")
	if it.has("u"):
		out.append("Unique · %s: %s" % [it["uname"], it["udesc"]])
	if it.has("act"):
		out.append("Active · %s (%ds): %s" % [it["act"]["name"], int(it["act"]["cd"]), it["act"]["desc"]])
	return out


