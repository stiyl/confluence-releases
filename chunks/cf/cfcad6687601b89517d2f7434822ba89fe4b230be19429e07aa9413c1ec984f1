# ---- 0.27 caelum: Gathering Dark shows its current bonus ----
func _passive_now(c) -> String:
	if String(c.def["passive"].get("t", "")) == "gather" and sim != null:
		return "\nNow: +%d Resolve from Gathering Dark." % roundi(sim.gather_bonus(c))
	if String(c.def["passive"].get("t", "")) == "stonescale" and sim != null:
		# 0.36 Vasska's Stonescale Hide: the blow it deals now, and what Colossal Growth has added
		var pp: Dictionary = c.def["passive"]
		var sd: float = (float(pp.get("dmg", 40)) * sim.lvl_mult(c) + float(pp.get("mig", 1.0)) * sim.attr(c, "mig")) * c.pow
		var gs: float = sim.serp_grow_v(c, "size")
		return "\nNow: %d damage per stun." % roundi(sd) + (("\nColossal Growth: %d%% bigger." % roundi(gs * 100.0)) if gs > 0.0 else "")
	if String(c.def["passive"].get("t", "")) == "undying" and sim != null:
		# 0.34 the Cultist's Undying Will: ready, holding him, or resting
		if c.uw_t > 0.0:
			return "\nNow: holding you for %.1fs more (no healing)." % c.uw_t
		if c.uw_cd > 0.0:
			return "\nNow: resting, ready in %ds." % ceili(c.uw_cd)
		if sim.duel_on and c.ar == sim.duel_ar and c.uw_duel:
			return "\nNow: already spent in this duel."
		return "\nNow: ready."
	return ""


