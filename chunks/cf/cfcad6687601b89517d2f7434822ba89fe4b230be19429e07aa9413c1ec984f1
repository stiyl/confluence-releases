	Settings.save()
	_apply_filter()
	refresh()
	main.refresh_hotkeys()


func _process(_delta: float) -> void:
	if not is_visible_in_tree():
		return
	var h: Control = null
	if Rect2(Vector2.ZERO, scroll.size).has_point(scroll.get_local_mouse_position()):
		for r in rows:
			if r.is_visible_in_tree() and Rect2(Vector2.ZERO, r.size).has_point(r.get_local_mouse_position()):
				h = r
				break
	if h != hover_row:
		if hover_row != null and is_instance_valid(hover_row):
			hover_row.hot = false
			hover_row.queue_redraw()
		hover_row = h
		if h != null:
			h.hot = true
			h.queue_redraw()


