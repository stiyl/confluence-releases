func refresh() -> void:
	if card == null:
		return
	var old: bool = rk.caps == 0
	old_box.visible = old
	body.visible = not old
	fn.visible = not old
	card.custom_minimum_size = Vector2(560, 0) if old else Vector2.ZERO
	var se: Dictionary = rk.season()
	head_sub.text = "" if old else ("%s  ·  %s  ·  %s" % [String(se.get("name", "")), ("reward skin: " + String(se.get("skin", ""))) if String(se.get("skin", "")) != "" else "", rk.season_left_text()]).replace("  ·    ·  ", "  ·  ") if not se.is_empty() else ("" if rk.caps != -1 else "Connecting…")
	var why: String = rk.available()
	var st := String(rk.q.get("state", "idle"))
	for md in Ranked.MODES:
		var mid: String = md["id"]
		var c: Dictionary = mode_cards[mid]
		var v: Dictionary = rk.view(mid)
		var placed := bool(v.get("placed", false))
		(c["emblem"] as Ranked.Emblem).set_rank(int(v.get("tier", 1)), int(v.get("div", 0)), not placed)
		c["rank"].text = Ranked.view_label(v) + (("  ·  %d" % int(v.get("mmr", 0))) if placed else "")
		var g := int(v.get("games", 0))
		var w := int(v.get("wins", 0))
		c["line"].text = String(md["sub"]) if v.is_empty() or g == 0 else "Season record %d–%d  ·  peak %d%s" % [w, g - w, int(v.get("peak", 0)), ("  ·  #%d" % int(v["pos"])) if int(v.get("pos", 0)) > 0 else ""]
		var mine := String(rk.q.get("mode", "")) == mid
		var queued := st == "queued" and mine
		var btn: Button = c["btn"]
		btn.text = "Leave queue" if queued else "Find match"
		btn.disabled = why != "" or (st in ["queued", "found", "cooldown"] and not queued) or (queued and not bool(rk.q.get("leader", true)))
		btn.tooltip_text = why if why != "" else ("Waiting %s" % _cool_text()) if st == "cooldown" else ""
		var ql: Label = c["queue"]
		ql.visible = queued or (st == "found" and mine)
		c["bots"].visible = queued and bool(rk.q.get("bots", false)) and bool(rk.q.get("leader", true))
		if not queued:
			var sl: String = rk.searching_line(mid)
			if sl != "" and why == "":
				c["line"].text += "  ·  " + sl
	note_lbl.text = rk.note if rk.note != "" else ("" if why == "" else why)
	if st == "cooldown":
		note_lbl.text = "Queue opens again in %s." % _cool_text() + ("  " + rk.note if rk.note != "" else "")
	for mid in board_btns:
		board_btns[mid].set_pressed_no_signal(mid == board_mode)
	_tick_queue_lines()
	_refresh_found()


func _cool_text() -> String:
	var s := ceili(int(rk.q.get("left_ms", 0)) / 1000.0)
	return "%d:%02d" % [s / 60, s % 60]


func _tick_queue_lines() -> void:
	var st := String(rk.q.get("state", "idle"))
	for mid in mode_cards:
		var ql: Label = mode_cards[mid]["queue"]
		if not ql.visible:
			continue
		if st == "found":
			ql.text = "Match found!"
			continue
		var s := int(rk.q.get("waited", 0)) / 1000
		var party := int(rk.q.get("party", 1))
		ql.text = "Searching  %d:%02d  ·  ±%d  ·  %s%s" % [s / 60, s % 60, int(rk.q.get("window", 150)), rk.searching_line(mid), ("  ·  party of %d" % party) if party > 1 else ""]


func _process(dt: float) -> void:
	_t += dt
	var st := String(rk.q.get("state", "idle"))
	if st == "queued":
		rk.q["waited"] = int(rk.q.get("waited", 0)) + int(dt * 1000.0)
	elif st == "cooldown":
		rk.q["left_ms"] = maxi(0, int(rk.q.get("left_ms", 0)) - int(dt * 1000.0))
		if int(rk.q["left_ms"]) == 0:
			rk.q = {"state": "idle"}
			refresh()
	if visible and _t >= 0.5:
		_t = 0.0
		_tick_queue_lines()
		if st == "cooldown":
			note_lbl.text = "Queue opens again in %s." % _cool_text()
	if visible:
		_board_t += dt
		if _board_t >= 30.0:
			_load_board(false)
	if found_box != null and found_box.visible:
		_refresh_found()


