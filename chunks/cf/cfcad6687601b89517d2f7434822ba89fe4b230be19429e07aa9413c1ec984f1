func _disconnect_peer(p_peer: int, _p_force: bool) -> void:
	if server and ws.get_ready_state() == WebSocketPeer.STATE_OPEN:
		ws.send_text(JSON.stringify({"t": "kick", "id": p_peer}))
	if _peers.has(p_peer):
		_peers.erase(p_peer)
		peer_disconnected.emit(p_peer)


func _close() -> void:
	if ws.get_ready_state() == WebSocketPeer.STATE_OPEN and server:
		ws.send_text('{"t":"bye"}')   # 0.26: a leave on purpose: the relay migrates at once instead of waiting for us
		ws.poll()                      # (flush it: nobody polls this peer after close)
	if ws.get_ready_state() != WebSocketPeer.STATE_CLOSED:
		ws.close()
		ws.poll()
	status = MultiplayerPeer.CONNECTION_DISCONNECTED
	_peers.clear()
	_in.clear()
␀␀␀␀␀␀␀␀␀# Match replays. The simulation is deterministic: the same seed, the same match settings and the same
# player commands at the same simulation steps always play out the same match. So a replay is only the
# setup plus the list of commands, each stamped with the step it was applied before.
# Skirmish and Survival matches are recorded automatically (not the campaign, the tutorial or online
# matches); the newest KEEP replays are kept in user://replays/.
class_name Replay
extends RefCounted

const DIR := "user://replays/"
const KEEP := 20
const VERSION := 1

static var rec: Dictionary = {}
static var recording := false
static var last_path := ""


# setup: {"hero", "diff", "bans", "opts" (must include "seed"), "skin", "game_mode", "label"}; 0.26: a bug report's
# replay of an online match adds "local" (the reporter's slot) and stamps each command with its player's slot
# as a fourth element, [tick, k, a, pid].
static func begin(setup: Dictionary) -> void:
	var d := Time.get_datetime_dict_from_system()
	rec = {"v": VERSION, "setup": setup.duplicate(true), "cmds": [],
		"date": "%04d-%02d-%02d %02d:%02d" % [d["year"], d["month"], d["day"], d["hour"], d["minute"]],
		"stamp": "%04d%02d%02d_%02d%02d%02d" % [d["year"], d["month"], d["day"], d["hour"], d["minute"], d["second"]]}
	recording = true


static func record(tick: int, k: String, a: Array) -> void:
	if recording:
		rec["cmds"].append([tick, k, a.duplicate(true)])


# 0.48 Replay theatre: a moment worth jumping to, stamped with its step: kind "fight" (heroes down), "boss",
# "duel", "final". Consecutive hero deaths within FIGHT_GAP steps merge into one fight.
const FIGHT_GAP := 60 * 8


static func mark(tick: int, kind: String, label: String) -> void:
	if not recording:
		return
	var ms: Array = rec.get("marks", [])
	if kind == "fight" and not ms.is_empty():
		var last: Array = ms[ms.size() - 1]
		if String(last[1]) == "fight" and tick - int(last[3]) <= FIGHT_GAP:
			last[2] = int(last[2]) + 1
			last[3] = tick
			last[4] = label
			return
	# [first tick, kind, count, last tick, label]
	ms.append([tick, kind, 1, tick, label])
	rec["marks"] = ms


static func cancel() -> void:
	recording = false
	rec = {}


# Saves the finished match; returns the file path ("" when nothing was being recorded).
static func finish(summary: Dictionary) -> String:
	if not recording:
		return ""
	recording = false
	rec["summary"] = summary
	DirAccess.make_dir_recursive_absolute(DIR)
	var path := DIR + "%s.replay" % rec["stamp"]
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		return ""
	f.store_string(var_to_str(rec))
	f.close()
	last_path = path
	_prune()
	return path


static func _files() -> Array:
	var out: Array = []
	var da := DirAccess.open(DIR)
	if da == null:
		return out
	for fn in da.get_files():
		if fn.ends_with(".replay"):
			out.append(DIR + fn)
	out.sort()
	out.reverse()
	return out


static func _prune() -> void:
	var files := _files()
	for i in range(KEEP, files.size()):
		DirAccess.remove_absolute(files[i])


# Deletes every saved replay. Returns how many were removed.
static func delete_all() -> int:
	var files := _files()
	for f in files:
		DirAccess.remove_absolute(f)
	last_path = ""
	return files.size()


static func load_file(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var txt := FileAccess.get_file_as_string(path)
	var v = str_to_var(txt)
	if not (v is Dictionary) or int(v.get("v", 0)) != VERSION:
		return {}
	return v


# Newest first: [{"path", "date", "summary"}].
static func list() -> Array:
	var out: Array = []
	for path in _files():
		var r := load_file(path)
		if r.is_empty():
			continue
		out.append({"path": path, "date": r.get("date", ""), "summary": r.get("summary", {}), "setup": r.get("setup", {})})
	return out


# 0.44: an online match as a replay (the players' bug reports write the same; now the spectator's "Watch again" keeps
# the whole match): the host's config as main._build_online_sim hands it to Sim.new, and Net's command log with each
# command's slot as the fourth element. Returns the path ("" when nothing could be written).
static func save_online(cfg: Dictionary, cmd_log: Array, local: int, summary: Dictionary) -> String:
	if cfg.is_empty():
		return ""
	var lineup: Array = []
	for e0 in cfg.get("lineup", []):
		var e: Dictionary = e0.duplicate()
		e.erase("peer")
		e.erase("tok")
		lineup.append(e)
	var opts := {"seed": int(cfg["seed"]), "lineup": lineup, "mode": cfg["mode"], "team_size": int(cfg["team_size"]), "map": int(cfg["map"]), "ai_tiers": true,
		"tune": cfg.get("tune", {}), "variant": String(cfg.get("variant", "")), "mods": cfg.get("mods", {})}   # 0.48: Mayhem / Draft rules (they were dropped, so an online Mayhem replay ran on classic rules)
	var dd := Time.get_datetime_dict_from_system()
	var rec_o := {"v": VERSION, "setup": {"hero": "", "diff": int(cfg["diff"]), "bans": Array(cfg.get("bans", [])), "opts": opts, "skin": "", "game_mode": String(cfg["mode"]),
		"local": local, "label": String(summary.get("label", "Online  ·  %s" % String(cfg["mode"]).capitalize()))},
		"cmds": [], "date": "%04d-%02d-%02d %02d:%02d" % [dd["year"], dd["month"], dd["day"], dd["hour"], dd["minute"]],
		"stamp": "%04d%02d%02d_%02d%02d%02d" % [dd["year"], dd["month"], dd["day"], dd["hour"], dd["minute"], dd["second"]], "summary": summary}
	for e in cmd_log:
		for c in e[1]:
			rec_o["cmds"].append([int(e[0]), String(c[1]), c[2], int(c[0])])
	DirAccess.make_dir_recursive_absolute(DIR)
	var path := DIR + "%s.replay" % rec_o["stamp"]
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		return ""
	f.store_string(var_to_str(rec_o))
	f.close()
	last_path = path
	_prune()
	return path


static func make_sim(r: Dictionary) -> Sim:
	var s: Dictionary = r["setup"]
	var sim := Sim.new(String(s["hero"]), false, int(s["diff"]), s["bans"].duplicate(), s["opts"].duplicate(true))
	sim.players[0].champ.skin = String(s.get("skin", ""))
	if s.get("cos") is Dictionary:
		sim.players[0].cos = s["cos"]   # 0.44: the recorder's cosmetics (crystal colour, recall flash, title)
	sim.local = clampi(int(s.get("local", 0)), 0, 7)
	return sim
␀# 0.48 Replay theatre: the scrub bar under the replay controls. Shows how far the replay has played, the moments the
# match recorded (fights, bosses, duels, the last wave) as coloured pins, and where a seek is heading. Click or drag
# to seek; hover a pin for what happened there.
class_name ReplayTimeline
extends Control

signal seek_requested(tick: int)

const COLS := {"fight": Color("#e0604a"), "boss": Color("#e8b040"), "duel": Color("#7ab8ff"), "final": Color("#f0f0f0"), "contest": Color("#7ad87a")}

var total := 1            # steps in the whole replay
var now := 0              # the step the replay is at
var target := -1          # a seek in progress (-1: none)
var marks: Array = []     # Replay marks: [first tick, kind, count, last tick, label]
var step := 1.0 / 60.0    # seconds per step (Main.SIM_STEP)
var _hover := -1
var _drag := false
# 0.48.1: marks closer than MERGE_PX on screen draw as one pin (a long Mayhem replay has dozens of kills)
const MERGE_PX := 10.0
const PRIO := {"boss": 4, "contest": 3, "duel": 2, "final": 1, "fight": 0}
var _groups: Array = []   # [{"x", "tick", "kind", "heroes", "items": [mark...]}]
var _groups_w := -1.0


func _init() -> void:
	custom_minimum_size = Vector2(200, 30)
	mouse_filter = MOUSE_FILTER_STOP
	mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND


func setup(total_steps: int, mk: Array, sim_step: float) -> void:
	total = maxi(1, total_steps)
	marks = mk
	step = sim_step
	now = 0
	target = -1
	_groups_w = -1.0
	queue_redraw()


func _x(tick: int) -> float:
	return 6.0 + (size.x - 12.0) * clampf(float(tick) / float(total), 0.0, 1.0)


func _tick_at(x: float) -> int:
	return int(clampf((x - 6.0) / maxf(1.0, size.x - 12.0), 0.0, 1.0) * float(total))


static func clock(secs: float) -> String:
	var s := int(secs)
	return "%d:%02d" % [s / 60, s % 60]


# Marks grouped by where they land on the bar (rebuilt when the bar changes width).
func groups() -> Array:
	if is_equal_approx(_groups_w, size.x):
		return _groups
	_groups_w = size.x
	_groups = []
	var sorted := marks.duplicate()
	sorted.sort_custom(func(a, b): return int(a[0]) < int(b[0]))
	for m in sorted:
		var mx := _x(int(m[0]))
		var kind := String(m[1])
		var heroes := int(m[2]) if kind == "fight" else 0
		if not _groups.is_empty() and mx - float(_groups[-1]["x1"]) < MERGE_PX:
			var g: Dictionary = _groups[-1]
			g["items"].append(m)
			g["x1"] = mx
			g["heroes"] = int(g["heroes"]) + heroes
			if int(PRIO.get(kind, 0)) > int(PRIO.get(String(g["kind"]), 0)):
				g["kind"] = kind
			continue
		_groups.append({"x": mx, "x1": mx, "tick": int(m[0]), "kind": kind, "heroes": heroes, "items": [m]})
	for g in _groups:
		g["x"] = (float(g["x"]) + float(g["x1"])) * 0.5
	return _groups


# A lone kill is a small moment; fights, bosses and duels are the big ones.
static func _minor(g: Dictionary) -> bool:
	return String(g["kind"]) == "fight" and (g["items"] as Array).size() == 1 and int(g["heroes"]) <= 1


# The first mark after (dir 1) or before (dir -1) a step, or -1.
func mark_from(tick: int, dir: int) -> int:
	var best := -1
	for m in marks:
		var mt := int(m[0])
		if dir > 0 and mt > tick + 30 and (best < 0 or mt < best):
			best = mt
		elif dir < 0 and mt < tick - 90 and (best < 0 or mt > best):
			best = mt
	return best


func _gui_input(ev: InputEvent) -> void:
	if ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_LEFT:
		if ev.pressed:
			_drag = true
			_pick(ev.position.x)
		else:
			_drag = false
		accept_event()
	elif ev is InputEventMouseMotion:
		var h := _group_at(ev.position.x)
		if h != _hover:
			_hover = h
			tooltip_text = _group_text(groups()[h]) if h >= 0 else ""
			queue_redraw()
		if _drag:
			_pick(ev.position.x)


func _pick(x: float) -> void:
	# a click close to a pin snaps to the moment just before it, so the fight is seen from its start
	var tk := _tick_at(x)
	var gi := _group_at(x)
	if gi >= 0:
		tk = maxi(0, int(groups()[gi]["tick"]) - int(4.0 / step))
	seek_requested.emit(tk)


func _group_at(x: float) -> int:
	var best := -1
	var bd := 6.0
	var gs := groups()
	for i in gs.size():
		var d := absf(float(gs[i]["x"]) - x)
		if d < bd:
			bd = d
			best = i
	return best


func _group_text(g: Dictionary) -> String:
	var items: Array = g["items"]
	var lines: Array = []
	for i in mini(items.size(), 4):
		lines.append(_mark_text(items[i]))
	if items.size() > 4:
		lines.append("+%d more" % (items.size() - 4))
	return "\n".join(lines)


func _mark_text(m: Array) -> String:
	var t := clock(float(m[0]) * step)
	if String(m[1]) == "fight":
		return "%s  ·  %s" % [t, ("Fight: %d heroes down" % int(m[2])) if int(m[2]) > 1 else String(m[4])]
	return "%s  ·  %s" % [t, String(m[4])]


func _draw() -> void:
	var y := size.y * 0.5
	var x0 := 6.0
	var x1 := size.x - 6.0
	draw_rect(Rect2(x0, y - 4.0, x1 - x0, 8.0), Color(0.04, 0.035, 0.03, 0.95))
	draw_rect(Rect2(x0, y - 4.0, _x(now) - x0, 8.0), Color(0.82, 0.82, 0.76, 0.85))
	draw_rect(Rect2(x0, y - 4.0, x1 - x0, 8.0), Color(0.6, 0.6, 0.55, 0.6), false, 1.0)
	var gs := groups()
	for i in gs.size():
		var g: Dictionary = gs[i]
		var mx: float = g["x"]
		var col: Color = COLS.get(String(g["kind"]), Color.WHITE)
		if _minor(g):
			# a lone kill: a faint tick under the bar, so the real fights stand out
			col.a = 0.9 if i == _hover else 0.5
			draw_rect(Rect2(mx - 1.0, y + 4.0, 2.0, 5.0 if i == _hover else 4.0), col)
			continue
		var big := String(g["kind"]) != "fight" or int(g["heroes"]) >= 3 or (g["items"] as Array).size() >= 3
		var hh := (10.0 if big else 7.0) + (2.0 if i == _hover else 0.0)
		var w := 3.0 if String(g["kind"]) != "fight" else minf(7.0, 2.0 + float(g["heroes"]) * 0.8)
		draw_rect(Rect2(mx - w * 0.5 - 1.0, y - hh - 1.0, w + 2.0, hh * 2.0 + 2.0), Color(0.05, 0.04, 0.03, 0.8))
		draw_rect(Rect2(mx - w * 0.5, y - hh, w, hh * 2.0), col)
	if target >= 0:
		var tx := _x(target)
		draw_line(Vector2(tx, 1), Vector2(tx, size.y - 1), Color(1.0, 0.85, 0.4, 0.9), 2.0)
	var nx := _x(now)
	draw_circle(Vector2(nx, y), 6.0, Color(0.95, 0.95, 0.9))
	draw_circle(Vector2(nx, y), 6.0, Color(0.1, 0.09, 0.08), false, 1.5)
␀␀␀␀␀␀# 0.18 Tab scoreboard (presentation only): a plaque at the top right. Collapsed it is one strip
# ("Round 10 · Crystals 100% : 100%" with the keycap); open it adds the two crystal bars, a team block per
# side (player, hero disc, level, kills, income per round, sends, buildings, the six item slots), dead heroes
