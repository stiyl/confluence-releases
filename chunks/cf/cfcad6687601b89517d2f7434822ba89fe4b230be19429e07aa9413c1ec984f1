# Elo for an online match against other players: your team's average rating against theirs (players without
# a rating, and older games, count as RATING_START). Returns the change. Local to this profile: no server keeps it.
static func rate_match(team_avg: float, enemy_avg: float, won: bool) -> int:
	ensure()
	var exp_win := 1.0 / (1.0 + pow(10.0, (enemy_avg - team_avg) / 400.0))
	var k := RATING_K * (1.5 if rated_games() < 10 else 1.0)   # settles faster for the first ten games
	var d := roundi(k * ((1.0 if won else 0.0) - exp_win))
	if d == 0:
		d = 1 if won else -1
	var r := maxi(100, rating_now() + d)
	rating["r"] = r
	rating["n"] = rated_games() + 1
	rating["w"] = int(rating.get("w", 0)) + (1 if won else 0)
	rating["peak"] = maxi(int(rating.get("peak", RATING_START)), r)
	save()
	return d


