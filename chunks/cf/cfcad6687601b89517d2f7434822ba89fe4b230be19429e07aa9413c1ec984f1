# 0.24 (Tab): the camera jumps to a random living enemy hero, a different one from the last press when there is a
# choice; with none to show (all dead, or none in a view the camera may take) it falls back to switching lanes.
# Presentation only: the pick uses the global RNG, never the sim's.
var _tab_last_pid := -1


func jump_enemy_hero() -> void:
	if sim == null:
		return
	var cands: Array = []
	for pl in sim.players:
		var ch = pl.champ
		if pl.team == myt() or ch == null or ch.dead or ch.ar == null:
			continue
		if sim.duel_on and ch.ar.idx != 2:
			continue   # the duel holds the camera
		cands.append(pl)
	if cands.is_empty():
		toggle_enemy_view()
		return
	if cands.size() > 1:
		cands = cands.filter(func(p): return p.id != _tab_last_pid)
	var pl = cands[randi() % cands.size()]
	_tab_last_pid = pl.id
	set_view_arena(pl.champ.ar.idx)
	if arena_view.arena_idx != pl.champ.ar.idx:
		return
	arena_view.selected = pl.champ
	arena_view.follow_obj = pl.champ
	arena_view.follow = true
	arena_view.cam = pl.champ.p
	update_hud()


