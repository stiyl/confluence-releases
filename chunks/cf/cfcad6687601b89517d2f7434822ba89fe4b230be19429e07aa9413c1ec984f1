					award("boss")
					var all_five := true
					for bkind in Sim.BOSSES:
						if not Profile.bosses_beaten.has(bkind):
							all_five = false
					if all_five:
						award("all_bosses")
				event_hud.on_event(e)   # 0.16: the BOSS DOWN card (replaces the "has fallen" line; gold when it fell in your lane)
			"duel_soon":
