# in the pause menu.
class_name TipsData
extends RefCounted

const TIPS := {
	"basics": {"title": "Hold your road", "text": "Monsters march down both roads to your crystal. Right-click to move, A then click to attack-move, and stand in the way. If your crystal falls, you lose; break the enemy's to win."},
	"learn": {"title": "Learn an ability", "text": "You have an ability point. Click the + above an ability or press Ctrl with its key (Q W E R). R, your ultimate, opens at level 6."},
	"sends": {"title": "Send monsters", "text": "Build the Beast Warren (Z), then buy monsters with 1–8. They join the next wave on the enemy's road, and every monster you send raises your income for good. Dearer sends earn more per gold (3% of the price a round for the cheapest, 6% for the dearest) but pay the enemy more when killed; the last two of each building are power sends that cost income instead."},
	"setup": {"title": "Setup", "text": "The first wave comes after a minute of setup. Shop, build the Beast Warren (Z) and send, learn an ability and walk to your post. Your first income arrives when the setup ends, and then once at the end of every round."},
