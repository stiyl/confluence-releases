# ---- 0.48 replay theatre ----
# Seek to a step: forward fast-forwards the match; backward rebuilds it from the start first (the replay is only
# the setup and the commands, so the match can be played again to any point).
func replay_seek_to(tick: int) -> void:
	if not replay_mode or spectating or replay_rec.is_empty() or sim == null:
		return
	replay_seek = clampi(tick, 0, replay_total)
	replay_seek_rebuilt = false
	replay_tl.target = replay_seek
	if clip != null:
		_clip_stop(true)   # a clip is one continuous stretch


func _seek_step() -> void:
	if replay_seek < sim.tick and not replay_seek_rebuilt:
		var ms := Replay.make_sim(replay_rec)
		replay_i = 0
		start_game(ms)
		replay_seek_rebuilt = true
	var t0 := Time.get_ticks_usec()
	while sim.tick < replay_seek and not sim.over and Time.get_ticks_usec() - t0 < 14000:
		_replay_feed()
		sim.step(SIM_STEP)
		sim.events.clear()   # a seek makes no sound and shows no banners
	if sim.tick >= replay_seek or sim.over:
		replay_seek = -1
		replay_tl.target = -1
		step_acc = 0.0
		last_round = sim.round_no
		last_lvl = sim.players[sim.local].champ.lvl
		event_hud.reset()


func _replay_jump(dir: int) -> void:
	if replay_tl == null:
		return
	var at := replay_seek if replay_seek >= 0 else (sim.tick if sim != null else 0)
	var m := replay_tl.mark_from(at, dir)
	if m < 0:
		show_error("No %s fight, boss or duel in this replay." % ("later" if dir > 0 else "earlier") if not replay_tl.marks.is_empty() else "This replay has no marked moments (it was recorded before 0.48).")
		return
	replay_seek_to(maxi(0, m - int(4.0 / SIM_STEP)))


# 0.48.1: the bar sits at the bottom, centred just above the hero console (where a video player keeps its scrub bar),
# so it never covers the top-left lines (the next duel, the team vote) or the scoreboard.
func _place_replay_bar() -> void:
	var vp: Vector2 = replay_bar.get_parent_control().size
	var bottom := vp.y - CONSOLE_H * hud_fit - 10.0
	if core_panel != null and core_panel.is_visible_in_tree():
		bottom = minf(bottom, core_panel.get_global_rect().position.y - game.get_global_rect().position.y - 8.0)
	replay_bar.position = Vector2(maxf(8.0, (vp.x - replay_bar.size.x) * 0.5), maxf(TOPBAR_H + 8.0, bottom - replay_bar.size.y))


# The prompt lines and the alerts at the bottom move up over the replay bar while it shows, and back after.
var _toast_lift := 0.0
func _replay_lift_toasts() -> void:
	var lift := 0.0
	if replay_bar != null and replay_bar.visible and replay_mode:
		lift = replay_bar.size.y + 12.0
	if is_equal_approx(lift, _toast_lift):
		return
	var d := lift - _toast_lift
	_toast_lift = lift
	for c in [error_lbl, good_lbl, alert_box]:
		if c != null:
			c.offset_top -= d
			c.offset_bottom -= d


# Called every frame while watching: the timeline, the clock and the clip.
func _replay_theatre_tick(delta: float) -> void:
	if replay_tl == null or not replay_mode or spectating or sim == null:
		return
	replay_tl.now = sim.tick
	replay_tl.queue_redraw()
	_place_replay_bar()
	replay_time_lbl.text = "%s / %s" % [ReplayTimeline.clock(sim.tick * SIM_STEP), ReplayTimeline.clock(replay_total * SIM_STEP)]
	if clip != null and replay_seek < 0:
		# the clip follows match time: as many frames as the match advanced (at 2x speed or on a slow PC a frame
		# repeats, so the clip still plays at the match's own pace)
		var due := int(float(sim.tick - clip_tick0) * SIM_STEP * float(clip.fps)) - clip.frames.size()
		if due > 0:
			var img := get_viewport().get_texture().get_image()
			var before := int(clip.seconds())
			for i in mini(due, 12):
				var took: bool = clip.add(img) if i == 0 else clip.add_repeat(img)
				if not took:
					_clip_stop(true)
					break
			if clip != null and int(clip.seconds()) != before:
				_refresh_replay_bar()


func _clip_start() -> void:
	var vs := get_viewport().get_visible_rect().size
	var w := 960
	var h := int(round(960.0 * vs.y / maxf(1.0, vs.x) / 2.0)) * 2
	clip = ClipWriter.new(w, h, 30)
	clip_acc = 0.0
	clip_tick0 = sim.tick if sim != null else 0
	if replay_paused:
		replay_paused = false
	_refresh_replay_bar()
	show_good("Recording a clip: press Stop clip when you're done (up to 45s).")


func _clip_stop(save: bool) -> void:
	if clip == null:
		return
	var c := clip
	clip = null
	_refresh_replay_bar()
	if not save or c.frames.size() < 15:
		return
	var d := Time.get_datetime_dict_from_system()
	var path := "user://clips/clip_%04d%02d%02d_%02d%02d%02d.avi" % [d["year"], d["month"], d["day"], d["hour"], d["minute"], d["second"]]
	var err := c.save(path)
	if err != "":
		show_error(err)
		return
	last_clip_path = ProjectSettings.globalize_path(path)
	show_good("Clip saved (%ds): %s" % [int(c.seconds()), last_clip_path])
	if replay_clips_btn != null:
		replay_clips_btn.visible = true
