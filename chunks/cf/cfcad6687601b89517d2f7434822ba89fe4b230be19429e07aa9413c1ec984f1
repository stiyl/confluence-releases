# A swatch button: the colour disc (or a quote mark for titles) and the name; pressed = equipped.
func _cos_btn(k: String, id: String, name: String, col: Color) -> Button:
	var b := CosBtn.new()
	b.col = col
	b.text = name
	b.toggle_mode = true
	b.focus_mode = FOCUS_NONE
	b.custom_minimum_size = Vector2(0, 34)
	b.add_theme_font_size_override("font_size", 12)
	var owned := Profile.owns(k, id)
	b.disabled = not owned
	b.set_pressed_no_signal(Profile.equipped(k) == id)
	b.tooltip_text = name if owned else "%s: unlocks with %s" % [name, Cosmetics.source_of(k, id)]
