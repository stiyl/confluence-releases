# Short trait labels for tooltips and the selection panel.
# What a monster does besides walk and bite, as full sentences with the numbers (tooltips, Codex).
static func traits(kind: String) -> Array:
	var d: Dictionary = MON[kind]
	var out: Array = []
	if d.get("boss", false):
		out.append("BOSS: tough, slow, hits the crystal hard, and has special attacks")
	if d.get("fly", false):
		out.append("Flying: flies straight between the road's bends, skipping the long way round")
	if d.has("ranged"):
		var r: Dictionary = d["ranged"]
		out.append("Ranged: stops to shoot heroes within %d for %d damage every %.1fs%s%s" % [int(r["range"]), int(r["dmg"]), float(r.get("cd", 1.5)), " and slows them" if r.has("slow") else "", ", splashing nearby heroes" if r.has("splash") else ""])
	if float(d.get("armor", 0.0)) > 0:
		out.append("Armored: takes %d%% less damage" % roundi(float(d["armor"]) * 100))
	if d.get("cci", false):
		out.append("Unstoppable: immune to stuns, slows and knockbacks")
	elif float(d.get("ten", 1.0)) < 1.0:
		out.append("Stubborn: stuns and slows last %d%% as long" % roundi(float(d["ten"]) * 100))
	if d.has("heal"):
		out.append("Healing aura: heals every monster within %d for %d health a second" % [int(d["heal"]["r"]), int(d["heal"]["hps"])])
	if d.has("haste"):
		out.append("Haste aura: monsters within %d move %d%% faster" % [int(d["haste"]["r"]), roundi((float(d["haste"]["mult"]) - 1.0) * 100)])
	if d.has("ward"):
		out.append("Armor aura: monsters within %d take %d%% less damage" % [int(d["ward"]["r"]), roundi(float(d["ward"]["add"]) * 100)])
	if d.has("split"):
		var sp: Dictionary = d["split"]
		out.append("Splits on death into %d %ss" % [int(sp["n"]), String(MON[sp["kind"]]["name"]) if MON.has(sp["kind"]) else String(sp["kind"])])
	if d.has("explode"):
		out.append("Explodes on death: %d damage to heroes within %d" % [int(d["explode"]["dmg"]), int(d["explode"]["r"])])
	if d.has("spawner"):
		var sw: Dictionary = d["spawner"]
		out.append("Summoner: raises a %s every %ds (up to %d at once)" % [String(MON[sw["kind"]]["name"]) if MON.has(sw["kind"]) else String(sw["kind"]), int(sw["every"]), int(sw["max"])])
	if d.has("blink"):
		out.append("Burrower: tunnels ahead along the road every few seconds")
	if d.has("totems"):
		out.append("Warded: its totems halve the damage it takes until they are broken")
	if d.get("camp", false):
		out.append("Neutral camp: clear it for the %s" % {"beast": "Packlord's Hunt", "spirit": "Wisp Veil"}.get(String(d.get("camp_kind", "")), "Cairnstone Blessing"))
	if float(d.get("drain", 0.0)) > 0:
		out.append("Draining: heals itself for %d%% of the damage it deals" % roundi(float(d["drain"]) * 100))
	if d.has("dive"):
		out.append("Diver: swoops onto a hero, marking the spot a moment before it lands")
	if float(d.get("regen", 0.0)) > 0:
		out.append("Regenerates %.1f%% of its health a second" % (float(d["regen"]) * 100))
	if float(d.get("evasion", 0.0)) > 0:
		out.append("Evasive: dodges %d%% of attacks" % roundi(float(d["evasion"]) * 100))
	if float(d.get("frenzy", 0.0)) > 0:
		out.append("Frenzy: attacks and moves faster the more it is hurt")
	return out


# A short tag and colour for the monster's most important trait, for the send buttons.
static func trait_tag(kind: String) -> Array:
	var d: Dictionary = MON[kind]
	if d.get("boss", false):
		return ["BOSS", Color("#ff8a3a")]
	if d.has("heal"):
		return ["HEAL", Color("#7dff9a")]
	if d.has("haste"):
		return ["HASTE", Color("#ffd24a")]
	if d.has("ward"):
		return ["AURA", Color("#8fd8ff")]
	if d.has("spawner"):
		return ["SUMMON", Color("#c89bff")]
	if d.has("explode"):
		return ["BOOM", Color("#ff6a4a")]
	if d.has("split"):
		return ["SPLIT", Color("#9fe060")]
	if d.get("fly", false):
		return ["FLY", Color("#9fd8ff")]
	if d.has("ranged"):
		return ["RANGED", Color("#ffb070")]
	if d.has("blink"):
		return ["BURROW", Color("#d0b080")]
	if d.get("cci", false):
		return ["IMMUNE", Color("#e0e0e0")]
	if float(d.get("regen", 0.0)) > 0:
		return ["REGEN", Color("#7dff9a")]
	if float(d.get("evasion", 0.0)) > 0:
		return ["EVASIVE", Color("#e0e0ff")]
	if float(d.get("armor", 0.0)) >= 0.2:
		return ["ARMOR", Color("#c8c8d8")]
	if float(d.get("frenzy", 0.0)) > 0:
		return ["FRENZY", Color("#ff8a8a")]
	return ["", Color.WHITE]


static func sends_of(b: int) -> Array:
	var out: Array = []
	for i in SENDS.size():
		if int(SENDS[i]["b"]) == b:
			out.append(i)
	return out


