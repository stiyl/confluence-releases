# ---------------------------------------------------------------- ability previews (hold to aim, release to cast)
func begin_preview(i: int, key: int) -> void:
	var c = sim.players[sim.local].champ
	if c.dead:
		show_error("Your hero is dead.")
		return
	if c.ranks[i] <= 0:
		show_error("You haven't learned %s yet. Spend an ability point on it (%s or the + button)." % [c.def["skills"][i]["name"], Settings.learn_name(["skill_q", "skill_w", "skill_e", "skill_r"][i])])
		return
	preview_i = i
	preview_key = key
	arena_view.preview = i


func release_preview() -> void:
	var i := preview_i
	cancel_preview()
	if i >= 0:
		human_cast(i, false)


func cancel_preview() -> void:
	preview_i = -1
	preview_key = 0
	arena_view.preview = -1


