# Old profiles (format 1): hero records gain their new totals lazily (hero_tot reads with defaults), and the
# saved replays seed the history so the History tab isn't empty after the update (their own line only).
static func _migrate() -> void:
	if history.is_empty():
		for rp in Replay.list():
			var sm: Dictionary = rp["summary"]
			var hid := _hero_id(String(sm.get("hero", "")))
			if hid == "":
				continue
			var md := String(rp.get("setup", {}).get("game_mode", sm.get("mode", "classic")))
			var surv := String(sm.get("mode", "")) == "survival"
			history.append({"d": String(rp["date"]), "m": md, "map": int(rp.get("setup", {}).get("opts", {}).get("map", 0)),
				"s": int(sm.get("t", 0)), "r": "run" if surv else ("win" if bool(sm.get("won", false)) else "loss"), "rd": int(sm.get("round", 0)),
				"h": hid, "rp": String(rp["path"]), "old": true})
		history = history.slice(0, HIST_MAX)
		save_history()
	ver = VER
	save()


static func _hero_id(name: String) -> String:
	for c in GameData.CHAMPS:
		if c["name"] == name or c["id"] == name:
			return c["id"]
	return ""


static func _load_history() -> void:
	history = []
	if not FileAccess.file_exists(HIST_PATH):
		return
	var v = JSON.parse_string(FileAccess.get_file_as_string(HIST_PATH))
	if v is Dictionary and v.get("matches") is Array:
		history = v["matches"]
	elif v is Array:
		history = v


static func save_history() -> void:
	var f := FileAccess.open(HIST_PATH, FileAccess.WRITE)
	if f == null:
		return
	f.store_string(JSON.stringify({"v": 1, "matches": history}))
	f.close()


