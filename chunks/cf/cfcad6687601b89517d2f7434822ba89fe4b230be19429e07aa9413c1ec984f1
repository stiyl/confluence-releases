func _history_detail(r: Dictionary) -> void:
	var top: HBoxContainer = main.hbox(12)
	var back := Button.new()
	back.text = "‹  All matches"
	back.focus_mode = FOCUS_NONE
	back.custom_minimum_size = Vector2(150, 34)
	back.pressed.connect(func():
		detail = -1
		main.audio.play("click", -10.0)
		refresh())
	top.add_child(back)
	var t: Label = main.head_lbl(result_text(r), 26, result_col(r), 4)
	top.add_child(t)
	var secs := int(r.get("s", 0))
	var sub: Label = main.lbl("%s  ·  round %d  ·  %d:%02d  ·  %s%s" % [_mode_line(r), int(r.get("rd", 0)), secs / 60, secs % 60, String(r.get("d", "")),
		("  ·  rating %s%d" % ["+" if int(r["rt"]) >= 0 else "", int(r["rt"])]) if r.has("rt") else ""], 13, UIParts.TEXT)
	sub.size_flags_horizontal = SIZE_EXPAND_FILL
	sub.size_flags_vertical = SIZE_SHRINK_CENTER
	top.add_child(sub)
	if _replay_ok(r):
		var wb: Button = main.primary_button("Watch replay")
		wb.custom_minimum_size = Vector2(160, 36)
		var path := String(r["rp"])
		wb.pressed.connect(func():
			main.profile_ov.visible = false
			main.watch_replay(path))
		top.add_child(wb)
	body.add_child(top)
	if r.get("old", false):
		_note("Recorded before 0.43: only the result was kept.")
		return
	var pl: Array = r.get("pl", [])
	if pl.is_empty():
		pl = [{"n": "You", "h": r.get("h", ""), "t": 0, "hu": true, "lv": r.get("lv", 1), "k": r.get("k", 0), "dt": r.get("dt", 0),
			"dmg": r.get("dmg", 0), "heal": r.get("heal", 0), "gs": r.get("gs", 0), "it": r.get("it", [])}]
		r = r.duplicate()
		r["me"] = 0
		_note("Older match: only your own line was kept.")
	var me_i := int(r.get("me", -1))
	var my_team := int(pl[me_i]["t"]) if me_i >= 0 and me_i < pl.size() else 0
	var cols := [["", 30, false], ["Player", 150, false], ["Lvl", 34, true], ["K / D", 60, true], ["Hero dmg", 76, true], ["Healing", 70, true], ["Gold sent", 84, true], ["Items", 158, false]]
	var head: HBoxContainer = main.hbox(8)
	for i in cols.size():
		var l := _cell(String(cols[i][0]).to_upper(), cols[i][1], cols[i][2], UIParts.GOLD, 11, "caps")
		if i == 1:
			l.size_flags_horizontal = SIZE_EXPAND_FILL
		head.add_child(l)
	body.add_child(head)
	for tm in [my_team, 1 - my_team]:
		var any := false
		for p in pl:
			if int(p.get("t", 0)) == tm:
				any = true
		if not any:
			continue
		var won_t: bool = (r.get("r") == "win") == (tm == my_team)
		var tl: Label = main.lbl(Sim.TEAM_NAMES[clampi(tm, 0, 1)].to_upper() + ("  ·  your team" if tm == my_team else "") + ("  ·  winners" if won_t and r.get("r") in ["win", "loss"] else ""), 11, main.WARD if tm == 0 else main.EMBER, false, 2)
		tl.add_theme_font_override("font", UIParts.font("caps"))
		body.add_child(tl)
		for i in pl.size():
			var p: Dictionary = pl[i]
			if int(p.get("t", 0)) != tm:
				continue
			body.add_child(_player_row(p, i == me_i, cols))


