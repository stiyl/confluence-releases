func _refresh_modes() -> void:
	if game_mode == "tutorial":
		game_mode = "classic"
	for k in mode_cards:
		mode_cards[k].set_pressed_no_signal(k == game_mode)
	for k in map_btns.size():
		map_btns[k].set_pressed_no_signal(k == game_map)
	for k in diff_btns.size():
		diff_btns[k].set_pressed_no_signal(k == difficulty)
	mode_desc_lbl.text = "%s on %s: %s" % [mode_info(game_mode)[1], Sim.MAPS[game_map]["name"], Sim.MAPS[game_map]["desc"]]
	if modes_compact > 0:   # ---- 0.44.1 polish ---- compact cards cut their text short: the mode's line goes here
		mode_desc_lbl.text = "%s: %s  ·  %s: %s" % [mode_info(game_mode)[1], String(mode_info(game_mode)[2]).trim_suffix("."), Sim.MAPS[game_map]["name"], Sim.MAPS[game_map]["desc"]]
	var dl := game_mode == "daily"
	for b in map_btns + diff_btns:
		b.disabled = dl or game_mode == "weekly"
	# ---- 0.44 modes ----
	var wk := WeeklyData.this_week()
	var tw := WeeklyData.twist_of(wk)
	if mode_cards.has("weekly") and mode_cards["weekly"].has_meta("desc_lbl"):
		var wbest: Dictionary = Profile.weekly.get(str(wk), {})
		mode_cards["weekly"].tooltip_text = "This week's twist: " + CodexData.twist_line(tw)   # ---- 0.45 codex ----
		(mode_cards["weekly"].get_meta("desc_lbl") as Label).text = "%s: %s.  %s left.  %s" % [String(tw["name"]), String(tw["desc"]).trim_suffix("."), WeeklyData.left_label(WeeklyData.seconds_left()), ("Your best: %d." % int(wbest["score"])) if not wbest.is_empty() else "Not played yet."]
	weekly_btn.visible = game_mode == "weekly"
	if game_mode == "weekly":
		var wm := WeeklyData.map_of(wk, Sim.MAPS.size())
		for k in map_btns.size():
			map_btns[k].set_pressed_no_signal(k == wm)
		for k in diff_btns.size():
			diff_btns[k].set_pressed_no_signal(k == WeeklyData.DIFF)
		var wb2: Dictionary = Profile.weekly.get(str(wk), {})
		mode_desc_lbl.text = "Weekly Challenge %s on %s at Normal: %s. One seed for everyone, any hero.  %s left%s." % [WeeklyData.week_label(wk), Sim.MAPS[wm]["name"], String(tw["name"]), WeeklyData.left_label(WeeklyData.seconds_left()), ("  ·  your best %d" % int(wb2["score"])) if not wb2.is_empty() else ""]
	# ---- end 0.44 modes ----
	if dl:
		var td := SurvivalData.today()
		var dm := SurvivalData.daily_map(td, Sim.MAPS.size())
		for k in map_btns.size():
			map_btns[k].set_pressed_no_signal(k == dm)
		for k in diff_btns.size():
			diff_btns[k].set_pressed_no_signal(k == 1)
		var best: Dictionary = Profile.daily.get(str(td), {})
		mode_desc_lbl.text = "Daily Run %s: %s on %s at Normal, the same for everyone today.%s  Streak: %d." % [Profile.date_label(td), String(find_champ(SurvivalData.daily_hero(td))["name"]), Sim.MAPS[dm]["name"], ("  Your best today: round %d." % int(best["round"])) if not best.is_empty() else "", Profile.daily_streak(td)]


