# 0.38.1 UI scale: the console (minimap, hero panel, items, buildings, abilities) at any window and UI scale. The
# right-hand block keeps its size; the hero panel takes the room between it and the minimap. When the full layout
# does not fit, the compact one (smaller minimap and portrait, narrower stat values and rift buttons) is used, and
# if even that is too wide the console scales itself down just enough (hud_fit; Settings shows the cap).
const HUD_RIGHT_W := 566.0   # the item slots' owner line to the right edge


func _queue_hud_layout() -> void:
	if _hud_layout_queued:
		return
	_hud_layout_queued = true
	_layout_hud.call_deferred()


func _hud_left_end() -> float:
	var minimap_c: Control = hud_parts.get("minimap")
	return minimap_c.offset_right + 8.0 + 48.0


func _hud_need() -> float:
	var info: Control = hud_parts["info"]
	return _hud_left_end() + 8.0 + info.offset_left + info.get_combined_minimum_size().x + 8.0 + 8.0 + HUD_RIGHT_W


func _hud_compact(on: bool) -> void:
	hud_compact = on
	var mmw := 200.0 if on else 300.0
	set_anchor_rect(minimap, 0, 0, 0, 0, 12, 29, 12 + mmw, 207)
	var bx := 12.0 + mmw + 8.0
	for pair in [[view_btn, 36], [follow_btn, 90], [cmd_btn, 144]]:
		set_anchor_rect(pair[0], 0, 0, 0, 0, bx, pair[1], bx + 48, pair[1] + 48)
	var pw := 96.0 if on else 130.0
	var px := 8.0 if on else 18.0
	set_anchor_rect(portrait, 0, 0, 0, 0, px, 16, px + pw, 16 + pw)
	set_anchor_rect(hp_bar, 0, 0, 0, 0, px, 22 + pw, px + pw, 40 + pw)
	set_anchor_rect(xp_bar, 0, 0, 0, 0, px, 46 + pw, px + pw, 53 + pw)
	(hud_parts["stats"] as GridContainer).add_theme_constant_override("h_separation", 8 if on else 14)
	for v in stat_vals:
		v.custom_minimum_size.x = 48.0 if on else 80.0
	own_row.add_theme_constant_override("separation", 6 if on else 10)
	for b in sel_skill_btns:   # ---- 0.44.1 polish ---- an inspected hero's skills: smaller on the compact console
		b.custom_minimum_size = Vector2(34, 34) if on else Vector2(40, 40)
	sel_extra.add_theme_font_size_override("font_size", 12 if on else 13)
	var short := {"North rift": "North", "Alternate": "Alt", "South rift": "South"}
	for b in lane_btns:
		var full_t: String = String(b.get_meta("full_text", b.text))
		b.set_meta("full_text", full_t)
		b.text = String(short.get(full_t, full_t)) if on else full_t
		b.tooltip_text = full_t if on else ""
		b.custom_minimum_size.x = 50.0 if on else 88.0
		b.add_theme_font_size_override("font_size", 11 if on else 12)
	(hud_parts["qcol"] as Control).custom_minimum_size.x = 76.0 if on else 130.0
	var cap: Label = hud_parts.get("lane_cap")
	if cap != null:
		cap.text = "SENDS" if on else "SENDS GO THROUGH"
	# ---- 0.44.1 polish ---- the info column's offset is set last, after its children's minimum widths changed, and
	# its size re-taken from the anchors: an anchored box that once grew to a wider minimum keeps that width otherwise
	# (the stats grid ran past the hero panel at 125% when the compact layout was the first one used)
	var info: Control = hud_parts["info"]
	info.offset_left = px + pw + 14.0 if on else 166.0
	info.offset_right = -9.0   # set_offset ignores an unchanged value; two writes make it re-take its size
	info.offset_right = -8.0


func _layout_hud() -> void:
	_hud_layout_queued = false
	if game == null or not hud_parts.has("console"):
		return
	var vp: Vector2 = get_viewport().get_visible_rect().size
	if vp.x < 100.0:
		return
	_hud_compact(false)
	var need := _hud_need()
	if need > vp.x:
		_hud_compact(true)
		need = _hud_need()
	hud_fit = minf(1.0, vp.x / need)
	_fit_topbar(vp.x)   # ---- 0.44.1 polish ----
	var console: Control = hud_parts["console"]
	var w := vp.x / hud_fit
	console.scale = Vector2(hud_fit, hud_fit)
	console.offset_left = 0.0
	console.offset_right = w - vp.x
	console.offset_top = -CONSOLE_H * hud_fit
	console.offset_bottom = console.offset_top + CONSOLE_H
	# the hero panel: from a quarter of the way across (or the minimap's edge) to the item slots
	var center: Control = hud_parts["center"]
	var x1 := w - HUD_RIGHT_W - 8.0
	var x0 := clampf(w * 0.25, _hud_left_end() + 8.0, maxf(_hud_left_end() + 8.0, x1 - (need - _hud_left_end() - 16.0 - HUD_RIGHT_W)))
	set_anchor_rect(center, 0, 0, 0, 1, x0, 0, maxf(x0, x1), 0)
	console.queue_redraw()
	_hud_info_w = (hud_parts["info"] as Control).get_combined_minimum_size().x
	_fit_core_panel()
	if shop_panel != null and shop_panel.visible:
		shop_panel.fit()   # 0.39


# 0.38.1: the Crystal panel sits on the console and shrinks (keeping its layout) when the view is too short for it.
func _fit_core_panel() -> void:
	if core_panel == null:
		return
	var vp: Vector2 = get_viewport().get_visible_rect().size
	var bottom := -CONSOLE_H * hud_fit - 12.0
	core_panel.offset_bottom = bottom
	core_panel.offset_top = bottom
	if not core_panel.visible:
		return
	var h: float = core_panel.size.y   # laid out (a wrapping label's minimum before layout is meaningless)
	var room: float = vp.y + bottom - TOPBAR_H - 8.0
	var k := clampf(room / maxf(h, 1.0), 0.5, 1.0)
	core_panel.pivot_offset = Vector2(core_panel.size.x / 2.0, h)
	core_panel.scale = Vector2(k, k)


# The console's effective scale (the UI scale times hud_fit), for the Settings row.
func hud_effective_scale() -> float:
	return Settings.ui_scale * hud_fit


# Narrow windows: the lane buttons drop their words (icons, badges and tooltips stay).
func _fit_topbar(w: float) -> void:
	for b in view_btns:
		var want: String = String(b.get_meta("label", "")) if w >= 1450.0 else ""
		if b.label != want:
			b.label = want
			b.fit()
			b.queue_redraw()
	if interest_lbl != null:
		interest_lbl.custom_minimum_size.x = 78.0 if w >= 1450.0 else 0.0
		interest_lbl.visible = w >= 1300.0   # 0.38.1: big UI scales; the gold tooltip still explains interest
	# 0.38.1: below 1300 the round line drops filler words and the vote button its word
	topbar_tight = w < 1300.0
	topbar_w = w
	var trow_c: Control = hud_parts.get("topbar_row")
	if trow_c != null:
		trow_c.add_theme_constant_override("separation", 5 if topbar_tight else 8)
	var tm_c: Control = hud_parts.get("topbar_margin")   # ---- 0.44.1 polish ----
	if tm_c != null:
		tm_c.add_theme_constant_override("margin_left", 6 if w < 1200.0 else 10)
		tm_c.add_theme_constant_override("margin_right", 8 if w < 1200.0 else 14)
	if vote_ui != null and vote_ui.btn != null and vote_ui.btn.compact != topbar_tight:
		vote_ui.btn.compact = topbar_tight
		vote_ui.btn.fit()
		vote_ui.btn.queue_redraw()


