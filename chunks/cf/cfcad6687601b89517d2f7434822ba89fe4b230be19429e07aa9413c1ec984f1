␀␀␀␀␀␀␀␀␀# 0.43: Steam achievements (and nothing else yet). Net._init_steam starts Steam; main.gd calls attach(net) once,
# which also pushes every achievement already earned in this profile (earned offline, before Steam, or on another
# PC that synced the profile through Steam Cloud). Profile.unlock calls unlock(id) for each new one.
# The Steam API names are our achievement ids (Profile.ACHIEVEMENTS); store/steam/achievements.csv lists them for
# Steamworks. With the test app id 480 (Spacewar) Steam simply rejects names it doesn't know: harmless.
# Without Steam (no GodotSteam, no client, steam_ok false) every call returns at once.
#
# Cloud saves need no code: the profile, history, settings, account and campaign files live in user://, and
# Steam Auto-Cloud (configured in Steamworks, see store/steam/README.md) syncs them.
class_name SteamExtras
extends RefCounted

static var steam = null          # the GodotSteam singleton while Steam is running for us
static var pushed := 0           # achievements sent to Steam this session (tests read it)
static var log_lines: Array = [] # what happened, for tests and bug reports


static func attach(net) -> void:
	steam = null
	if net == null or not ("steam_ok" in net) or not bool(net.steam_ok) or net.steam == null:
		return
	steam = net.steam
	sync_all()


static func ok() -> bool:
	return steam != null


static func _note(t: String) -> void:
	log_lines.append(t)
	if log_lines.size() > 40:
		log_lines.pop_front()


# Sends every achievement this profile has to Steam (Steam ignores ones it already has).
static func sync_all() -> void:
	if steam == null:
		return
	Profile.ensure()
	var n := 0
	for aid in Profile.achieved:
		if _push(String(aid)):
			n += 1
	if n > 0:
		_store()
	_note("synced %d achievements" % n)


static func unlock(aid: String) -> void:
	if steam == null:
		return
	if _push(aid):
		_store()


static func _push(aid: String) -> bool:
	if not steam.has_method("setAchievement"):
		return false
	if steam.has_method("getAchievement"):
		var g = steam.getAchievement(aid)
		if g is Dictionary and bool(g.get("achieved", false)):
			return false
	var ok_set = steam.setAchievement(aid)
	if ok_set is bool and not ok_set:
		_note("Steam refused %s (not set up in Steamworks for this app id?)" % aid)
		return false
	pushed += 1
	return true


static func _store() -> void:
	if steam.has_method("storeStats"):
		steam.storeStats()


# Steamworks CSV: API name, display name, description, hidden (0/1). Written by tests/stats_test.gd --write-csv
# into store/steam/achievements.csv.
static func achievements_csv() -> String:
	var lines := PackedStringArray(["api_name,display_name,description,hidden"])
	for a in Profile.ACHIEVEMENTS:
		lines.append("%s,%s,%s,%d" % [a["id"], _csv(String(a["name"])), _csv(String(a["desc"])), 1 if bool(a.get("hidden", false)) else 0])
	return "\n".join(lines) + "\n"


static func _csv(t: String) -> String:
	if t.contains(",") or t.contains("\""):
		return "\"%s\"" % t.replace("\"", "\"\"")
	return t
␀␀␀␀␀␀␀␀␀␀␀␀␀# 0.33: a MultiplayerPeer over Steam, built on GodotSteam's own Networking Messages API (sendMessageToUser /
# receiveMessagesOnChannel / acceptSessionWithUser), so Steam play needs no second native library (the old plan's
# separate SteamMultiplayerPeer extension shipped its own, older libsteam_api). Steam routes the messages through
# its relay (no port forwarding, IPs hidden) and keeps them reliable and in order on one channel.
# To the rest of the game it behaves like relay_peer.gd: the host is peer 1, joiners get ids 2, 3, ... from the
# host, every packet is reliable, players only talk to the host (no server relay).
#   host:  SteamPeer.new().host(api, my_steam_id, allow)      allow: Callable(steam_id) -> bool (lobby members)
#   join:  SteamPeer.new().join(api, my_steam_id, host_steam_id)
# `api` is the GodotSteam singleton, or anything with the same four calls and the session signals
# (tests/steam_peer_test.gd runs two peers in one process through a fake).
#
# Wire format (channel 0, every message reliable): byte 0 = kind.
#   HELLO   player -> host  [1][u32 nonce]          resent every second until the WELCOME (the first message opens
#                                                     the Steam session; the host accepts it if allow(id) says so)
#   WELCOME host -> player  [2][s32 id][u32 nonce]
#   DATA    both ways       [3][payload]            (the host knows who sent it; a player only hears the host)
#   BYE     both ways       [4][u8 why]             why: 0 left, 1 kicked, 2 refused (full / not in the lobby)
#   PING    both ways       [5]                     every 5 s, so a silent peer is noticed (TIMEOUT)
extends MultiplayerPeerExtension

signal lost(msg: String, fatal: bool)   # a player lost the host; fatal: a real goodbye (left / kicked / refused), not a dead link

const CH := 0
const SEND_RELIABLE := 8        # k_nSteamNetworkingSend_Reliable
const SEND_AUTO_RESTART := 32   # k_nSteamNetworkingSend_AutoRestartBrokenSession
const MAX_MSG := 512 * 1024     # Steam's limit for one reliable message
const HELLO_EVERY := 1.0
const PING_EVERY := 5.0
const TIMEOUT := 60.0           # nothing at all from a peer this long: it is gone (longer than net.gd PEER_DROP / STALL_DROP, which act first)
enum { HELLO = 1, WELCOME = 2, DATA = 3, BYE = 4, PING = 5 }

var api = null
var my_sid := 0
var host_sid := 0
var allow := Callable()
var my_id := 0
var server := false
var status := MultiplayerPeer.CONNECTION_DISCONNECTED
var target := 0
var mode := MultiplayerPeer.TRANSFER_MODE_RELIABLE
var channel := 0
var refusing := false
var _in: Array = []             # [from id, PackedByteArray]
var _sid_of := {}               # host: peer id -> steam id (a player: {1: host})
var _id_of := {}                # host: steam id -> peer id
var _nonce_of := {}             # host: steam id -> the nonce of the HELLO that got its id
var _seen := {}                 # peer id -> last time we heard from it (ms)
var _next_id := 2
var _nonce := 0
var _hello_t := 0.0
var _ping_t := 0.0
var _last := 0
var timeout_s := TIMEOUT        # (tests shorten these)
var ping_every := PING_EVERY
var send_fail := 0              # messages Steam refused (logged once a second)
var _fail_t := 0


func host(p_api, p_my_sid: int, p_allow := Callable()) -> Error:
	if p_api == null:
		return ERR_UNCONFIGURED
	_bind(p_api, p_my_sid)
	server = true
	allow = p_allow
	my_id = 1
	status = MultiplayerPeer.CONNECTION_CONNECTED
	return OK


func join(p_api, p_my_sid: int, p_host_sid: int) -> Error:
	if p_api == null or p_host_sid == 0:
		return ERR_UNCONFIGURED
	_bind(p_api, p_my_sid)
	server = false
	host_sid = p_host_sid
	_nonce = randi() & 0x7fffffff
	status = MultiplayerPeer.CONNECTION_CONNECTING
	_send_hello()
	return OK


func _bind(p_api, p_my_sid: int) -> void:
	api = p_api
	my_sid = p_my_sid
	_last = Time.get_ticks_msec()
	if api.has_signal("network_messages_session_request") and not api.network_messages_session_request.is_connected(_on_session_request):
		api.network_messages_session_request.connect(_on_session_request)
	if api.has_signal("network_messages_session_failed") and not api.network_messages_session_failed.is_connected(_on_session_failed):
		api.network_messages_session_failed.connect(_on_session_failed)


func _unbind() -> void:
	if api == null:
		return
	if api.has_signal("network_messages_session_request") and api.network_messages_session_request.is_connected(_on_session_request):
		api.network_messages_session_request.disconnect(_on_session_request)
	if api.has_signal("network_messages_session_failed") and api.network_messages_session_failed.is_connected(_on_session_failed):
		api.network_messages_session_failed.disconnect(_on_session_failed)


# The players this side knows (the host: every player; a player: just the host).
func peer_ids() -> Array:
	return _sid_of.keys()


func steam_id_of(pid: int) -> int:
	return int(_sid_of.get(pid, 0))


# The host: a Steam user left the lobby (lobby_chat_update) -> drop that player at once.
func drop_steam_user(sid: int) -> void:
	if server and _id_of.has(sid):
		_remove(int(_id_of[sid]), true)


# ---------------------------------------------------------------- Steam side
func _on_session_request(sid: int) -> void:
	# a host takes sessions from the lobby's members; a player only from its host
	var ok := (sid == host_sid) if not server else (not refusing and (not allow.is_valid() or bool(allow.call(sid))))
	if ok and status != MultiplayerPeer.CONNECTION_DISCONNECTED:
		api.acceptSessionWithUser(sid)


func _on_session_failed(a = null, b = null, _c = null, _d = null) -> void:
	# GodotSteam: (reason, remote_steam_id, connection_state, debug_message); be lenient about the order
	var sid := int(b) if b != null else 0
	if sid == 0 and a != null and (server and _id_of.has(int(a)) or int(a) == host_sid):
		sid = int(a)
	if server:
		if _id_of.has(sid):
			_remove(int(_id_of[sid]), false)
	elif sid == host_sid or sid == 0:
		_lose("The Steam connection to the host failed.", false)


func _send(sid: int, bytes: PackedByteArray) -> int:
	var r = api.sendMessageToUser(sid, bytes, SEND_RELIABLE | SEND_AUTO_RESTART, CH)
	var code := int(r) if (r is int or r is float) else 1
	if code != 1:   # k_EResultOK
		send_fail += 1
		var now := Time.get_ticks_msec()
		if now - _fail_t > 1000:
			_fail_t = now
			print("[steam] send failed (result %d): %d bytes to %d" % [code, bytes.size(), sid])
	return code


func _send_hello() -> void:
	var b := PackedByteArray([HELLO, 0, 0, 0, 0])
	b.encode_u32(1, _nonce)
	_send(host_sid, b)
	_hello_t = HELLO_EVERY


func _send_bye(sid: int, why: int) -> void:
	_send(sid, PackedByteArray([BYE, why]))


# ---------------------------------------------------------------- MultiplayerPeerExtension
func _poll() -> void:
	if api == null or status == MultiplayerPeer.CONNECTION_DISCONNECTED:
		return
	var now := Time.get_ticks_msec()
	var dt := (now - _last) / 1000.0
	_last = now
	for _round in 16:   # up to 16 x 64 messages a frame
		var msgs = api.receiveMessagesOnChannel(CH, 64)
		if not msgs is Array or msgs.is_empty():
			break
		for m in msgs:
			if m is Dictionary:
				_handle(int(m.get("remote_steam_id", m.get("identity", 0))), m.get("payload", PackedByteArray()))
			if api == null or status == MultiplayerPeer.CONNECTION_DISCONNECTED:
				return
		if msgs.size() < 64:
			break
	if status == MultiplayerPeer.CONNECTION_CONNECTING:
		_hello_t -= dt
		if _hello_t <= 0.0:
			_send_hello()
		return
	_ping_t -= dt
	if _ping_t <= 0.0:
		_ping_t = ping_every
		for pid in _sid_of.keys():
			_send(int(_sid_of[pid]), PackedByteArray([PING]))
	for pid in _seen.keys():
		if now - int(_seen[pid]) > int(timeout_s * 1000.0):
			if server:
				_remove(int(pid), false)
			else:
				_lose("The host stopped answering over Steam.", false)
				return


func _handle(sid: int, b: PackedByteArray) -> void:
	if b.is_empty() or sid == 0:
		return
	var kind := b[0]
	if server:
		if kind == HELLO and b.size() >= 5:
			var nonce := b.decode_u32(1)
			if _id_of.has(sid):
				var old := int(_id_of[sid])
				if int(_nonce_of.get(sid, -1)) == nonce:
					_welcome(sid, old, nonce)   # a resent HELLO: answer again
					return
				_remove(old, false)               # the same Steam user from a restarted game: a new player
			if refusing or (allow.is_valid() and not bool(allow.call(sid))):
				_send_bye(sid, 2)
				return
			var pid := _next_id
			_next_id += 1
			_id_of[sid] = pid
			_sid_of[pid] = sid
			_nonce_of[sid] = nonce
			_seen[pid] = Time.get_ticks_msec()
			_welcome(sid, pid, nonce)
			peer_connected.emit(pid)
			return
		if not _id_of.has(sid):
			return   # not one of ours (yet): ignore
		var from := int(_id_of[sid])
		_seen[from] = Time.get_ticks_msec()
		match kind:
			DATA:
				_in.append([from, b.slice(1)])
			BYE:
				_remove(from, false)
		return
	# a player: only the host counts
	if sid != host_sid:
		return
	if _sid_of.has(1):
		_seen[1] = Time.get_ticks_msec()
	match kind:
		WELCOME:
			if b.size() >= 9 and status == MultiplayerPeer.CONNECTION_CONNECTING and b.decode_u32(5) == _nonce:
				my_id = b.decode_s32(1)
				status = MultiplayerPeer.CONNECTION_CONNECTED
				_sid_of[1] = host_sid
				_seen[1] = Time.get_ticks_msec()
				_ping_t = ping_every
				peer_connected.emit(1)
		DATA:
			if status == MultiplayerPeer.CONNECTION_CONNECTED:
				_in.append([1, b.slice(1)])
		BYE:
			var why := int(b[1]) if b.size() > 1 else 0
			_lose(["The host left.", "Removed by the host.", "The host's lobby is full, or you're not in it."][clampi(why, 0, 2)], true)


func _welcome(sid: int, pid: int, nonce: int) -> void:
	var w := PackedByteArray([WELCOME, 0, 0, 0, 0, 0, 0, 0, 0])
	w.encode_s32(1, pid)
	w.encode_u32(5, nonce)
	_send(sid, w)


func _remove(pid: int, say_bye: bool) -> void:
	if not _sid_of.has(pid):
		return
	var sid := int(_sid_of[pid])
	if say_bye:
		_send_bye(sid, 1)
	_sid_of.erase(pid)
	_id_of.erase(sid)
	_nonce_of.erase(sid)
	_seen.erase(pid)
	if not say_bye:
		api.closeSessionWithUser(sid)   # (a kicked player's session stays open until the BYE is out)
	peer_disconnected.emit(pid)


func _lose(msg: String, fatal: bool) -> void:
	if status == MultiplayerPeer.CONNECTION_DISCONNECTED:
		return
	var was := status == MultiplayerPeer.CONNECTION_CONNECTED
	status = MultiplayerPeer.CONNECTION_DISCONNECTED
	if host_sid != 0:
		api.closeSessionWithUser(host_sid)
	_sid_of.clear()
	_seen.clear()
	if was:
		peer_disconnected.emit(1)
	lost.emit(msg, fatal)


func _get_available_packet_count() -> int:
	return _in.size()


func _get_packet_script() -> PackedByteArray:
	if _in.is_empty():
		return PackedByteArray()
	return _in.pop_front()[1]


func _get_packet_peer() -> int:
	return 0 if _in.is_empty() else int(_in[0][0])


func _get_packet_mode() -> MultiplayerPeer.TransferMode:
	return MultiplayerPeer.TRANSFER_MODE_RELIABLE


func _get_packet_channel() -> int:
	return 0


func _put_packet_script(p_buffer: PackedByteArray) -> Error:
	if status != MultiplayerPeer.CONNECTION_CONNECTED:
		return ERR_UNCONFIGURED
	if p_buffer.size() + 1 > MAX_MSG:
		return ERR_OUT_OF_MEMORY
	var out := PackedByteArray([DATA])
	out.append_array(p_buffer)
	var ids: Array = []
	if not server:
		if target == 0 or target == 1:
			ids = [1]
	elif target == 0:
		ids = _sid_of.keys()
	elif target < 0:
		ids = _sid_of.keys().filter(func(i): return i != -target)
	elif _sid_of.has(target):
		ids = [target]
	var err := OK
	for pid in ids:
		if _send(int(_sid_of[pid]), out) != 1:
			err = ERR_CONNECTION_ERROR
	return err


func _get_max_packet_size() -> int:
	return MAX_MSG - 1


func _set_transfer_mode(p_mode: MultiplayerPeer.TransferMode) -> void:
	mode = p_mode


func _get_transfer_mode() -> MultiplayerPeer.TransferMode:
	return mode


func _set_transfer_channel(p_channel: int) -> void:
	channel = p_channel


func _get_transfer_channel() -> int:
	return channel


func _set_target_peer(p_peer: int) -> void:
	target = p_peer


func _is_server() -> bool:
	return server


func _is_server_relay_supported() -> bool:
	return false


func _get_unique_id() -> int:
	return my_id


func _get_connection_status() -> MultiplayerPeer.ConnectionStatus:
	return status


func _set_refuse_new_connections(p_enable: bool) -> void:
	refusing = p_enable


func _is_refusing_new_connections() -> bool:
	return refusing


func _disconnect_peer(p_peer: int, _p_force: bool) -> void:
	if server:
		_remove(p_peer, true)


func _close() -> void:
	if api != null and status != MultiplayerPeer.CONNECTION_DISCONNECTED:
		for pid in _sid_of.keys():
			var sid := int(_sid_of[pid])
			_send_bye(sid, 0)
		if not server and host_sid != 0 and not _sid_of.has(1):
			_send_bye(host_sid, 0)
		# the sessions are left open so the BYEs still go out; Steam times idle sessions out by itself
	status = MultiplayerPeer.CONNECTION_DISCONNECTED
	_sid_of.clear()
	_id_of.clear()
	_nonce_of.clear()
	_seen.clear()
	_in.clear()
	_unbind()
␀␀␀␀# 0.43 (access): subtitles. A caption line above the console for the big moments and for cues that are only a sound
# today: the war horn of a new round, a boss roar, the duel gong, the crystal alarm, ally deaths, allies' pings,
# camps waking, the endgame horns, victory and defeat. Each line is "[Sound]  what it means", outlined text (no box),
# two lines at most, the newest at the bottom, fading after a few seconds; a repeat of the same cue refreshes its line
# instead of stacking. Settings > Accessibility > Subtitles (default on). Fed by Main.handle_events (on_event) and by
# its own look at the sim (victory / defeat). Presentation only: reads the sim, never writes it.
class_name Subtitles
extends Control

const LIFE := 4.5          # seconds a line stays
const FADE := 0.6
const MAX_LINES := 2
const BASE_PX := 17        # caption size at 100 % text

var main
var lines: Array = []      # {"key", "tag", "text", "col", "t"}
var cd := {}               # cue key -> seconds before it may show again
var _sim_id := 0
var _over_seen := false


func _ready() -> void:
	set_anchors_preset(PRESET_FULL_RECT)
	mouse_filter = MOUSE_FILTER_IGNORE   # drawn in tree order: over the battlefield and event HUD, under panels and overlays


# A caption. key: lines with the same key replace each other; cool: seconds before that key may show again.
func say(key: String, tag: String, text: String, col := UIParts.TEXT, cool := 0.0) -> void:
	if not Settings.subtitles:
		return
	if float(cd.get(key, 0.0)) > 0.0:
		return
	if cool > 0.0:
		cd[key] = cool
	for l in lines:
		if l["key"] == key:
			lines.erase(l)
			break
	lines.append({"key": key, "tag": tag, "text": text, "col": col, "t": LIFE})
	while lines.size() > MAX_LINES:
		lines.pop_front()
	queue_redraw()


func clear() -> void:
	lines.clear()
	cd.clear()
	queue_redraw()


# Main.handle_events hands every sim event over (after the audio hook); only the ones with a sound worth reading
# become captions.
func on_event(k: String, e: Dictionary, my_team: int) -> void:
	if main == null or main.sim == null:
		return
	var sim = main.sim
	match k:
		"wave":
			say("round", "War horn", "Round %d: the wave marches" % int(e.get("round", sim.round_no)), UIParts.TEXT)
		"boss":
			say("boss", "Roar", "Boss incoming: %s" % String(e.get("name", "a boss")), Palette.danger.lerp(Color.WHITE, 0.35))
		"boss_down":
			var ours: bool = int(e.get("a", -1)) == my_team
			say("boss_down", "Fanfare", ("%s has fallen" if ours else "The enemy felled %s") % String(e.get("name", "the boss")), UIParts.GOLD_TEXT)
		"core_hit":
			if int(e.get("team", -1)) == my_team:
				say("core", "Alarm", "Your crystal is under attack", Palette.danger.lerp(Color.WHITE, 0.3), 9.0)
		"hdie":
			if e.get("human", false):
				say("you_die", "Death knell", "You have fallen", Palette.danger.lerp(Color.WHITE, 0.3))
			elif int(e.get("team", -1)) == my_team:
				say("ally_die", "Knell", "Ally down: %s" % String(e.get("who", "an ally")), Palette.get_c("ward_txt"), 3.0)
		"duel_soon":
			var mine: bool = e.get("human", false)
			say("duel", "Gong", ("Your duel is in %d rounds" if mine else "A duel in %d rounds") % Sim.DUEL_NOTICE, UIParts.GOLD_TEXT)
		"duel_start":
			say("duel", "Gong", "Duel: %s vs %s" % [String(e.get("pa", "?")), String(e.get("pb", "?"))], UIParts.GOLD_TEXT)
		"duel_end":
			say("duel", "Fanfare", "%s wins the duel" % String(e.get("winner", "?")), Palette.team(int(e.get("team", 0))).lerp(Color.WHITE, 0.3))
		"endgame":
			say("endgame", "Horns", "The endgame: every wave deadlier, a boss with each", UIParts.GOLD_TEXT)
		"final_wave":
			say("endgame", "Horns", "The last wave: every boss at once", Palette.danger.lerp(Color.WHITE, 0.35))
		"omen":
			var od: Dictionary = SurvivalData.OMENS.get(e.get("id", ""), {"name": String(e.get("id", "?"))})
			say("omen", "Omen", "Omen: %s" % String(od["name"]), UIParts.GOLD_TEXT)
		"life_lost":
			say("life", "Toll", "A life lost" if int(e.get("left", 0)) > 0 else "Your last life is gone", Palette.danger.lerp(Color.WHITE, 0.3))
		"camp_up":
			if int(e.get("team", -1)) == my_team and sim.mode != "survival":
				var ckd: Dictionary = Sim.CAMP_KINDS.get(String(e.get("kind", "ancient")), {"name": "camp"})
				say("camp_" + String(e.get("kind", "")), "Horn", "The %s is up on your road" % String(ckd["name"]), UIParts.TEXT, 20.0)
		"camp_cleared":
			var ck: Dictionary = Sim.CAMP_KINDS.get(String(e.get("kind", "ancient")), {"name": "camp", "bless": "Blessing"})
			if int(e.get("team", -1)) == my_team:
				say("camp_clear", "Fanfare", "Your team: %s" % String(ck.get("bless", "a blessing")), UIParts.GOLD_TEXT)
			else:
				say("camp_clear", "Horn", "The enemy cleared their %s" % String(ck["name"]), main.ENEMY_TXT, 20.0)
		"ping":
			var pid := int(e.get("pid", -1))
			if int(e.get("team", -1)) != my_team or pid == sim.local or not Settings.show_pings:
				return
			if main.ping_muted.has(pid) or sim.t - float(e.get("t", sim.t)) > 3.0:
				return
			var kd: String = String(e.get("kind", "here"))
			say("ping_%d" % pid, "Ping", "%s: %s" % [String(e.get("who", "?")), String(PingUI.kind(kd)["name"])], Palette.ping(kd).lerp(Color.WHITE, 0.3), 1.5)


func _process(delta: float) -> void:
	var sim = main.sim if main != null else null
	var sid: int = sim.get_instance_id() if sim != null else 0
	if sid != _sim_id:
		_sim_id = sid
		_over_seen = sim != null and sim.over
		clear()
	if sim != null and sim.over and not _over_seen:
		_over_seen = true
		if sim.winner >= 0 and sim.mode != "survival":
			var won: bool = sim.winner == sim.players[sim.local].team
			say("end", "Fanfare" if won else "Low horns", "Victory" if won else "Defeat", UIParts.GOLD_TEXT if won else Palette.danger.lerp(Color.WHITE, 0.35))
	for k in cd.keys():
		cd[k] = float(cd[k]) - delta
		if float(cd[k]) <= 0.0:
			cd.erase(k)
	if lines.is_empty():
		return
	var keep: Array = []
	for l in lines:
		l["t"] = float(l["t"]) - delta
		if float(l["t"]) > 0.0:
			keep.append(l)
	lines = keep
	queue_redraw()


# Above the console and the error / "bought" lines (main.gd: error_lbl at -CONSOLE_H-40, good_lbl at -72).
func _draw() -> void:
	if lines.is_empty() or main == null or main.sim == null or not Settings.subtitles:
		return
	var vs := get_viewport_rect().size
	var fit: float = main.hud_fit if "hud_fit" in main else 1.0
	var px := roundi(BASE_PX * Settings.text_scale)
	var tpx := roundi(px * 0.78)
	var lh := px * 1.45
	# the last line's baseline sits just above the "bought" line (good_lbl), which sits above the error line
	var bottom := vs.y - float(main.CONSOLE_H) * fit - 84.0
	if main.good_lbl != null:
		bottom = main.good_lbl.global_position.y - global_position.y - px * 0.35
	var y := bottom - lh * (lines.size() - 1)
	var f: Font = UIParts.font("ui_semi")
	var fc: Font = UIParts.font("caps")
	for l in lines:
		var a := clampf(float(l["t"]) / FADE, 0.0, 1.0) * clampf((LIFE - float(l["t"])) / 0.15 + 0.2, 0.0, 1.0)
		var tag := String(l["tag"]).to_upper()
		var tw := fc.get_string_size(tag, HORIZONTAL_ALIGNMENT_LEFT, -1, tpx).x
		var gap := 14.0
		var txt := String(l["text"])
		var xw := f.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, px).x
		var x0 := (vs.x - (tw + gap + xw)) * 0.5
