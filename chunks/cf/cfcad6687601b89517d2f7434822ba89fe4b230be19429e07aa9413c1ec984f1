func upd_champ(ar, c, dt: float) -> void:
	if c.guard_cd > 0:
		c.guard_cd -= dt
	if c.rebirth_cd > 0:
		c.rebirth_cd -= dt
	if c.inv_t > 0:
		c.inv_t -= dt
	if c.golden_t > 0:
		c.golden_t -= dt
	for aid in c.act_cd:
		if c.act_cd[aid] > 0:
			c.act_cd[aid] -= dt
	# ability and item cooldowns both keep ticking while the hero waits to respawn
	for i in 4:
		if c.cds[i] > 0:
			c.cds[i] -= dt * quicken_rate(c, i)   # 0.27 briony: Quickening (1.0 without it)
	if c.silence > 0:
		c.silence -= dt
	if c.uw_cd > 0.0:
		c.uw_cd -= dt   # 0.34 Undying Will cools down while he waits to respawn too
	if c.dead:
		c.chan = null
		c.recall = 0.0
		c.respawn -= dt
		if c.respawn <= 0:
			c.dead = false
			c.hp = c.max_hp
			c.p = CORE + Vector2(-120, rng.randf_range(-60, 60))
			c.moving = false
			c.order = "idle"
			c.cur_tgt = null
			c.anchor = c.p
		return
	if c.uniq.has("immolate") or c.uniq.has("rally"):
		c.aura_t -= dt
		if c.aura_t <= 0:
			c.aura_t = 0.5
			if c.uniq.has("immolate"):
				var im: Dictionary = c.uniq["immolate"]
				for m in mons_in(ar, c.p, f(im, "r")):
					hurt(ar, m, f(im, "dps") * 0.5 * lvl_mult(c) * c.pow, c, false, true)
			if c.uniq.has("rally"):
				# Warlord's Mantle: allied heroes near the bearer (and the bearer) fight with extra armor
				var ra: Dictionary = c.uniq["rally"]
				for o in ar.champs:
					if o.dead or o.pl.team != c.pl.team or o.p.distance_to(c.p) > f(ra, "r"):
						continue
					o.buffs = o.buffs.filter(func(b): return not (b.has("rally") and b["rally"] == c.pl.id))
					o.buffs.append({"t": 0.75, "rally": c.pl.id, "armor_add": f(ra, "armor")})
	for b in c.buffs:
		b["t"] -= dt
	c.buffs = c.buffs.filter(func(b): return b["t"] > 0)
	if c.shield_t > 0:
		c.shield_t -= dt
		if c.shield_t <= 0:
			c.shield = 0
	if c.cast_flash > 0:
		c.cast_flash -= dt
	if c.anim_t > 0:
		c.anim_t -= dt
	c.spd = c_ms(c)
	c.ang = c.face
	if c.slow_t > 0:
		c.slow_t -= dt
		if c.slow_t <= 0:
			c.slow = 0.0
	if c.hex > 0:
		c.hex -= dt
	if c.burn_t > 0:
		c.burn_t -= dt
		_hit_ctx = "dot"
		hurt_champ(ar, c, c.burn_dps * dt, c.burn_src)
		_hit_ctx = ""
	if c.hol_t > 0.0 or c.ent_t > 0.0 or c.unr_t > 0.0:
		void_tick(ar, c, dt)   # 0.27 Caelum's marks (a hero in a duel)
	if c.uw_t > 0.0 or c.dm_t > 0.0 or c.doom_t > 0.0 or not c.cult_log.is_empty():
		if cult_tick(ar, c, dt):
			return   # 0.34 the Cultist's window and marks (a hero in a duel)
	if c.wc_t > 0.0 and necro_tick(ar, c, dt):
		return   # 0.36 Withering Curse (a hero in a duel)
	if c.ven_t > 0.0 and serp_tick(ar, c, dt):
		return   # 0.36 Venom Spit (a hero in a duel)
	heal_champ(c, c_regen(c) * dt)
	if c.pot_t > 0:
		c.pot_t -= dt
		heal_champ(c, c.pot_rate * dt)
	if c.p.distance_to(CORE) < FOUNTAIN_R:
		heal_champ(c, c.max_hp * (0.05 + f(c.uniq.get("homeward", {}), "pct")) * dt)   # 0.26 Waystone: Homeward heals faster here
	var p: Dictionary = c.def["passive"]
	var pt: String = p["t"]
	if pt == "thorns":
		c.thorn_t -= dt
		if c.thorn_t <= 0:
			c.thorn_t = 0.25
			for m in mons_in(ar, c.p, f(p, "r")):
				hurt(ar, m, f(p, "dps") * 0.25 * lvl_mult(c) * (1.0 + c_ap(c)), c)   # 0.38: an aura passive grows with Ability Power
	elif pt == "auraheal":
		for o in ar.champs:
			if not o.dead and o.pl.team == c.pl.team and o.p.distance_to(c.p) < f(p, "r"):
				heal_champ(o, f(p, "hps") * lvl_mult(c) * (1.0 + c_ap(c)) * dt)   # 0.38: Ability Power
	elif pt == "oath":
		# 0.19 Silver Oath: Ysolde and the allied heroes near her hit harder
		c.oath_t -= dt
		if c.oath_t <= 0:
			c.oath_t = 0.5
			var op := oath_pct(c)
			for o in ar.champs:
				if o.dead or o.pl.team != c.pl.team or (o != c and o.p.distance_to(c.p) > f(p, "r")):
					continue
				o.buffs = o.buffs.filter(func(b): return not b.has("oath"))
				o.buffs.append({"t": 0.75, "oath": op if o == c else op * f(p, "ally")})
	elif pt == "quicken":
		briony_auras(ar, c, dt)   # 0.27 briony
	elif pt == "stonescale":
		serp_grow_check(ar, c)   # 0.36 Vasska: a new rank of Colossal Growth
	elif pt == "runic":
		c.pass_t += dt
		if c.pass_t >= f(p, "every"):
			c.pass_t = 0
			c.shield = maxf(c.shield, f(p, "shield") * lvl_mult(c) * (1.0 + c_ap(c)) * duel_sus(c))   # 0.38: Ability Power
			c.shield_t = maxf(c.shield_t, 6.0)
	if pt != "quicken" and not c.hymns.is_empty():
		briony_auras(ar, c, dt)   # 0.27 briony: a hymn borrowed from a Survival card
	if c.dash != null:
		recall_cancel(c)
		c.dash["t"] += dt
		var k := minf(1.0, c.dash["t"] / c.dash["dur"])
		c.p = c.dash["s"].lerp(c.dash["e"], k)
		if k >= 1:
			c.dash = null
		return
	if c.chan != null and (c.stun > 0 or c.silence > 0):
		c.chan = null   # a stun or a silence breaks a channel
	if c.recall > 0 and c.stun > 0:
		recall_cancel(c)   # a stun or a knock breaks a Recall (damage alone does not)
	if c.stun > 0:
		c.stun -= dt
		return
	if c.recall > 0 and duel_on:
		recall_cancel(c)   # a duel starting moves everyone to the ring: nobody blinks home out of it
	if c.recall > 0:
		c.recall -= dt
		c.moving = false
		if c.recall <= 0:
			recall_done(ar, c)
		return   # channelling Recall: stand still, no attacks
	if c.chan != null and chan_step(ar, c, dt):
		c.moving = false
		return
	if c.pl.human:
		human_orders(ar, c, dt)
	var p0: Vector2 = c.p
	var step0 := 0.0
	if c.moving:
		var stepd := c_ms(c) * dt
		step0 = stepd
		while stepd > 0 and not c.route.is_empty():
			var tgt: Vector2 = c.route[0]
			var dv: Vector2 = tgt - c.p
			var d := dv.length()
			if d <= stepd:
				c.p = tgt
				stepd -= d
