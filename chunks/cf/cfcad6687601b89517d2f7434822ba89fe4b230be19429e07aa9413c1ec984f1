# ---------------------------------------------------------------- tooltips
func show_tip(src, title: String, meta: String, desc: String, icon: Texture2D = null) -> void:
	if tip_source != src or not tooltip.visible:
		# above the command card, or under the top bar for the top-bar numbers
		if src is Control and src.has_meta("stat_tip"):
			var x: float = clampf((src as Control).get_global_rect().position.x - 120.0, 10.0, size.x - 410.0)
			set_anchor_rect(tooltip, 0, 0, 0, 0, x, TOPBAR_H + 6, x + 390, TOPBAR_H + 6)
			tooltip.grow_vertical = GROW_DIRECTION_END
		else:
			set_anchor_rect(tooltip, 1, 1, 1, 1, -400, -CONSOLE_H - 8, -10, -CONSOLE_H - 8)
			tooltip.grow_vertical = GROW_DIRECTION_BEGIN
			tooltip.grow_horizontal = GROW_DIRECTION_BEGIN
	tip_source = src
	tip_icon.texture = icon
	tip_icon.visible = icon != null
	tip_title.text = title
	# plain metas may contain "[": escape them unless the caller passed BBCode (marked with [color)
	tip_meta.text = meta if meta.contains("[color") else meta.replace("[", "[lb]")
	tip_meta.visible = meta != ""
	tip_desc.text = desc
	tooltip.visible = true
	tooltip.reset_size()
	_clamp_tip.call_deferred()


# keep the whole tooltip on screen, however long its text is
func _clamp_tip() -> void:
	if tooltip == null or not tooltip.visible:
		return
	var r := tooltip.get_global_rect()
	var vs: Vector2 = size
	var dx := 0.0
	var dy := 0.0
	if r.end.x > vs.x - 6.0:
		dx = vs.x - 6.0 - r.end.x
	if r.position.x + dx < 6.0:
		dx = 6.0 - r.position.x
	if r.position.y < 6.0:
		dy = 6.0 - r.position.y
	if dx != 0.0 or dy != 0.0:
		tooltip.position += Vector2(dx, dy)


# Leaving a button doesn't hide its tooltip straight away: the tooltip stays while the mouse is still over
