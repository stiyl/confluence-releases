func set_end_chart(kind: String) -> void:
	end_chart_kind = kind
	for b in end_chart_btns:
		b.set_pressed_no_signal(b.get_meta("kind") == kind)
	if sim == null:
		return
	var xs: Array = []
	for h in sim.hist:
		xs.append(h["t"])
	end_chart.xs = xs
	end_chart.series = []
	end_chart.y_max_fixed = -1.0
	if kind == "core":
		end_chart.title = "Crystal health (%)"
		end_chart.y_fmt = "%d%%"
		end_chart.y_max_fixed = 100.0
		for tm in (1 if sim.mode == "survival" else 2):
			var ys: Array = []
			for h in sim.hist:
				ys.append(float(h["core"][tm]) * 100.0)
			end_chart.series.append({"name": ("Your crystal" if tm == myt() else Sim.TEAM_NAMES[tm] + " crystal"), "col": WARD if tm == 0 else EMBER, "ys": ys, "w": 3.5 if tm == myt() else 2.5, "dash": tm != myt(), "bold": tm == myt()})
	else:
		end_chart.title = "Damage dealt by each hero" if kind == "dmg" else "Gold earned by each player"
		end_chart.y_fmt = "%d"
		for i in sim.players.size():
			var pl = sim.players[i]
			if pl.absent:
				continue
			var ys: Array = []
			for h in sim.hist:
				ys.append(h[kind][i])
			var col := Color(pl.champ.def["color"])
			if pl.team != myt():
				col = col.lerp(EMBER, 0.25)
			var me_pl: bool = i == sim.local
			end_chart.series.append({"name": "You" if me_pl else pl.name, "col": Color(0.4, 1.0, 0.45) if me_pl else col, "ys": ys, "w": 4.5 if me_pl else 2.0, "dash": pl.team != myt(), "bold": me_pl})
	end_chart.queue_redraw()


func mvp_score(pl) -> float:
	return pl.kills * 2.0 + pl.champ.dmg_done / 400.0 + pl.duel_w * 25.0 + pl.sent / 40.0 + pl.earned / 200.0 - pl.deaths * 3.0


# The daily board: your best run today plus friends' results from pasted share codes.
func _daily_board(parent: Control, date: int, new_best := false) -> void:
	var box := vbox(6)
	parent.add_child(box)
	_fill_daily_board(box, date, new_best, "")


func _fill_daily_board(box: VBoxContainer, date: int, new_best: bool, status: String) -> void:
	for ch in box.get_children():
		ch.queue_free()
	var me_name: String = net.my_name if net != null else "You"
	box.add_child(head_lbl("Daily Run  ·  %s" % Profile.date_label(date), 19, GOLD, 3))
	var streak := Profile.daily_streak(SurvivalData.today())
	var mine: Dictionary = Profile.daily.get(str(date), {})
	box.add_child(lbl(("New best for today!  " if new_best else "") + ("Best: round %d with %d kills  ·  %d attempt%s" % [int(mine["round"]), int(mine["kills"]), int(mine.get("tries", 1)), "" if int(mine.get("tries", 1)) == 1 else "s"] if not mine.is_empty() else "Not played yet.") + "  ·  streak %d day%s" % [streak, "" if streak == 1 else "s"], 14, Color(0.6, 1.0, 0.7) if new_best else TEXT, true))
	var board := Profile.daily_board(date, me_name, account.friends if account != null else [])
	var k := 1
	for e in board.slice(0, 10):
		box.add_child(lbl("%d.  %s  ·  round %d  ·  %d kills  ·  %s" % [k, e["name"], int(e["round"]), int(e["kills"]), e["hero"]], 14, GOLD if e.get("me", false) else TEXT))
		k += 1
	if board.size() <= 1:
		box.add_child(lbl("Everyone gets the same cards today. Send your code to friends and paste theirs here to race them.", 13, MUTED, true))
	if not mine.is_empty():
		var code := Profile.daily_code(date, me_name, mine)
		var cr := hbox(6)
		var ce := LineEdit.new()
		ce.text = code
		ce.editable = false
		ce.size_flags_horizontal = SIZE_EXPAND_FILL
		ce.custom_minimum_size = Vector2(0, 30)
		cr.add_child(ce)
		var cb := Button.new()
		cb.text = "Copy my code"
		cb.focus_mode = FOCUS_NONE
		cb.pressed.connect(func():
			DisplayServer.clipboard_set(code)
			cb.text = "Copied!")
		cr.add_child(cb)
		box.add_child(cr)
	var pr := hbox(6)
	var pe := LineEdit.new()
	pe.placeholder_text = "Paste a friend's code (CF-...)"
	pe.size_flags_horizontal = SIZE_EXPAND_FILL
	pe.custom_minimum_size = Vector2(0, 30)
	pr.add_child(pe)
	var pb := Button.new()
	pb.text = "Add"
	pb.focus_mode = FOCUS_NONE
	pb.pressed.connect(func():
		var err := Profile.add_daily_friend(pe.text)
		var e2 := Profile.parse_daily_code(pe.text)
		if err == "":
			Profile.add_stat("codes")
			award("friend_code")
		var msg := err
		if err == "" and int(e2["date"]) != date:
			msg = "Added %s's run, but it's from %s, not this day." % [e2["name"], Profile.date_label(int(e2["date"]))]
		elif err == "":
			msg = "Added %s." % e2["name"]
		_fill_daily_board(box, date, new_best, msg))
	pr.add_child(pb)
	box.add_child(pr)
	if status != "":
		box.add_child(lbl(status, 13, MUTED, true))


