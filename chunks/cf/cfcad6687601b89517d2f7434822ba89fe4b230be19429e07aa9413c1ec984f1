func human_command(k: String, at = null) -> void:
	if sim == null or sim.over or replay_mode:
		return
	if sim.mode == "survival":
		show_error("You have no allies in Survival.")
		return
	var me = sim.players[sim.local]
	var p: Vector2 = me.champ.p if at == null else at
	if k == "boss":
		var b = sim.boss_near(sim.arenas[me.team], p)   # a boss in each rift: the one nearest you
		if b == null:
			show_error("There is no boss in your lane right now.")
			return
		p = b.p
	var res = act("command", [k, p])
	var who: Array = res if res is Array else [me.champ]
	if k == "lanes":
		show_error("Allies: back to your lanes.")
		audio.play("click", -4.0)
		return
	if who.is_empty():
		show_error("No allies can answer right now.")
		return
	orders_given += 1
	if orders_given >= 5:
		award("commander")
	minimap.ping(p, Color(0.45, 0.85, 1.0), me.team)
	audio.play("alert", -6.0)
	var lines: Array = CMD_LINES[k]
	for c in who:
		sim.feed.push_front({"t": sim.t, "team": me.team, "who": c.pl.name, "chat": lines[randi() % lines.size()]})
