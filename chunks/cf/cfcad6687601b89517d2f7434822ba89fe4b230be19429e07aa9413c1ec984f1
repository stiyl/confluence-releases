func skill_kind(s: Dictionary) -> String:
	var acts: Array = s["acts"]
	if acts.is_empty():
		return "empty"
	# the ability's own rendered icon (art/ui/abilities), found by name so Survival's borrowed skills work too
	var ak := UIParts.ability_key_of(s)
	if ak != "" and UIParts.ability_tex(ak) != null:
		return "ab:" + ak
	var kinds: Array = acts.map(func(a): return a["t"])
	if "blink" in kinds:
		return "blink"
	if "dash" in kinds:
		return "dash"
	return kinds[0]


