func _report_last_session() -> void:
	var cf := ConfigFile.new()
	cf.load(ID_PATH)
	var log_path := _previous_log()
	var last_done := String(cf.get_value("telemetry", "last_log", ""))
	var log_txt := ""
	if log_path != "" and log_path.get_file() != last_done:
		log_txt = FileAccess.get_file_as_string(log_path)
		cf.set_value("telemetry", "last_log", log_path.get_file())
		cf.save(ID_PATH)
	var prev_ver := _log_version(log_txt)
	if FileAccess.file_exists(FLAG_PATH):
		var flag = JSON.parse_string(FileAccess.get_file_as_string(FLAG_PATH))
		if not (flag is Dictionary):
			flag = {}
		if flag.has("v"):
			prev_ver = String(flag["v"])
		_crash_event(flag, log_txt)
	if log_txt != "":
		var errs := parse_errors(log_txt)
		for e in errs.slice(0, MAX_ERRORS):
			_error_event(e, prev_ver)


# The version the previous session ran (its log's "[telemetry] version" line, 0.46+), else this one.
static func _log_version(log_txt: String) -> String:
	var i := log_txt.find("[telemetry] version ")
	if i >= 0:
		return log_txt.substr(i + 20, 32).split("\n")[0].strip_edges()
	return version()


# The newest rotated log (Godot renames the last session's godot.log to godot_<date>.log at launch).
static func _previous_log() -> String:
	var log_dir := String(ProjectSettings.get_setting("debug/file_logging/log_path", "user://logs/godot.log")).get_base_dir() + "/"
	var da := DirAccess.open(log_dir)
	if da == null:
		return ""
	var newest := ""
	var newest_t := 0
	for fn in da.get_files():
		if not fn.ends_with(".log") or fn == "godot.log":
			continue
		var t := FileAccess.get_modified_time(log_dir + fn)
		if t >= newest_t:
			newest_t = t
			newest = fn
	return log_dir + newest if newest != "" else ""


# Groups the error lines of a log: [{kind, msg, func, file, line, count}], most frequent first.
static func parse_errors(txt: String) -> Array:
	var lines := txt.split("\n")
	var by_key := {}
	var order: Array = []
	for i in lines.size():
		var ln := lines[i].strip_edges(false, true)
		var kind := ""
		for k in ["SCRIPT ERROR", "USER ERROR", "ERROR"]:
			if ln.begins_with(k + ": "):
				kind = k
				break
		if kind == "":
			continue
		var msg := ln.substr(kind.length() + 2).strip_edges()
		var fn := ""
		var file := ""
		var line := 0
		if i + 1 < lines.size() and lines[i + 1].strip_edges().begins_with("at: "):
			var at := lines[i + 1].strip_edges().substr(4)   # "func (res://scripts/x.gd:12)"
			var o := at.rfind("(")
			if o >= 0:
				fn = at.substr(0, o).strip_edges()
				var loc := at.substr(o + 1).trim_suffix(")")
				var c := loc.rfind(":")
				file = loc.substr(0, c) if c > 0 else loc
				line = loc.substr(c + 1).to_int() if c > 0 else 0
			else:
				fn = at
		var key := "%s|%s|%s:%d" % [kind, msg.left(200), file, line]
		if not by_key.has(key):
			by_key[key] = {"kind": kind, "msg": msg.left(500), "func": fn, "file": file, "line": line, "count": 0}
			order.append(key)
		by_key[key]["count"] += 1
	var out: Array = []
	for k in order:
		out.append(by_key[k])
	# the game's own errors before engine noise, then the most frequent
	var rank := {"SCRIPT ERROR": 0, "USER ERROR": 1, "ERROR": 2}
	out.sort_custom(func(a, b):
		if rank[a["kind"]] != rank[b["kind"]]:
			return rank[a["kind"]] < rank[b["kind"]]
		return int(a["count"]) > int(b["count"]))
	return out


# Last lines of a log with chat lines dropped and the player's / OS user's names blanked.
func scrub_log(txt: String) -> String:
	var lines := txt.split("\n")
	lines = lines.slice(maxi(0, lines.size() - CRASH_LOG_LINES))
	var names: Array = []
	if main != null and main.account != null and String(main.account.profile_name).length() >= 2:
		names.append(String(main.account.profile_name))
	for env in ["USERNAME", "USER"]:
		var u := OS.get_environment(env)
		if u.length() >= 2 and not names.has(u):
			names.append(u)
	var homes: Array = []
	for env in ["USERPROFILE", "HOME"]:
		var h := OS.get_environment(env)
		if h.length() >= 3:
			homes.append(h)
			homes.append(h.replace("\\", "/"))
	var out := PackedStringArray()
	for ln in lines:
		var low := ln.to_lower()
		if low.contains("chat") or low.contains("whisper") or low.contains("[party]"):
			continue
		for h in homes:
			ln = ln.replace(h, "~")
		for n in names:
			ln = ln.replace(n, "<name>")
		out.append(ln)
	return "\n".join(out)


func _base_event(level: String) -> Dictionary:
	return {"event_id": _uuid_hex(), "timestamp": Time.get_unix_time_from_system(), "platform": "other",
		"level": level, "logger": "godot", "release": "confluence@" + version(),
		"environment": "dev" if OS.has_feature("editor") else "release", "user": {"id": anon_id},
		"tags": {"os": OS.get_name(), "renderer": String(ProjectSettings.get_setting("rendering/renderer/rendering_method", ""))},
		"contexts": {"os": {"name": OS.get_name(), "version": OS.get_version()},
			"device": {"arch": Engine.get_architecture_name()},
			"gpu": {"name": RenderingServer.get_video_adapter_name(), "vendor_name": RenderingServer.get_video_adapter_vendor()}}}


func _crash_event(flag: Dictionary, log_txt: String) -> void:
	var ev := _base_event("fatal")
	var where := String(flag.get("where", "?"))
	ev["release"] = "confluence@" + String(flag.get("v", version()))
	ev["tags"]["where"] = where
	ev["exception"] = {"values": [{"type": "Crash", "value": "The game closed unexpectedly (%s)" % ("in the menus" if where == "menu" else "during " + where),
		"mechanism": {"type": "session", "handled": false}}]}
	ev["fingerprint"] = ["crash", where]
	var errs := parse_errors(log_txt) if log_txt != "" else []
	if not errs.is_empty():
		ev["extra"] = {"last_error": "%s: %s" % [errs[0]["kind"], errs[0]["msg"]]}
	var att := scrub_log(log_txt).to_utf8_buffer() if log_txt != "" else PackedByteArray()
	sentry_out.append(_envelope(ev, att))


func _error_event(e: Dictionary, ver: String) -> void:
	var ev := _base_event("error")
	ev["release"] = "confluence@" + ver
	var frame := {"function": String(e["func"]) if String(e["func"]) != "" else "?", "in_app": true}
	if String(e["file"]) != "":
		frame["filename"] = String(e["file"])
		frame["abs_path"] = String(e["file"])
	if int(e["line"]) > 0:
		frame["lineno"] = int(e["line"])
	ev["exception"] = {"values": [{"type": String(e["kind"]), "value": String(e["msg"]), "stacktrace": {"frames": [frame]},
		"mechanism": {"type": "log", "handled": true}}]}
	ev["fingerprint"] = [String(e["kind"]), String(e["msg"]).left(120), "%s:%d" % [e["file"], e["line"]]]
	ev["extra"] = {"times_in_session": int(e["count"])}
	sentry_out.append(_envelope(ev, PackedByteArray()))


func _envelope(ev: Dictionary, attachment: PackedByteArray) -> PackedByteArray:
	var body := PackedByteArray()
	var head := {"event_id": ev["event_id"], "sent_at": _iso_now(),
		"dsn": SENTRY_HOST.replace("https://", "https://%s@" % SENTRY_KEY) + "/" + SENTRY_PROJECT}
	var evb := JSON.stringify(ev).to_utf8_buffer()
	body.append_array((JSON.stringify(head) + "\n").to_utf8_buffer())
	body.append_array((JSON.stringify({"type": "event", "length": evb.size()}) + "\n").to_utf8_buffer())
	body.append_array(evb)
	body.append_array("\n".to_utf8_buffer())
	if not attachment.is_empty():
		body.append_array((JSON.stringify({"type": "attachment", "length": attachment.size(), "filename": "godot.log",
			"content_type": "text/plain"}) + "\n").to_utf8_buffer())
		body.append_array(attachment)
		body.append_array("\n".to_utf8_buffer())
	return body


func _send_sentry(env: PackedByteArray) -> void:
	var url := _base(SENTRY_HOST) + "/api/%s/envelope/" % SENTRY_PROJECT
	var auth := "X-Sentry-Auth: Sentry sentry_version=7, sentry_key=%s, sentry_client=confluence/%s" % [SENTRY_KEY, version()]
	if _se.request_raw(url, ["Content-Type: application/x-sentry-envelope", auth], HTTPClient.METHOD_POST, env) == OK:
		_se_busy = true


func _on_se_done(result: int, code: int, _h: PackedStringArray, _b: PackedByteArray) -> void:
	_se_busy = false
	if result != HTTPRequest.RESULT_SUCCESS or code >= 300:
		print("[telemetry] crash/error report not sent (result %d, HTTP %d)" % [result, code])
	else:
		print("[telemetry] crash/error report sent")


# ---------------------------------------------------------------- storage
func _load_id() -> void:
	var cf := ConfigFile.new()
	cf.load(ID_PATH)
	anon_id = String(cf.get_value("telemetry", "id", ""))
	if anon_id.length() != 32:
		anon_id = _uuid_hex()
		cf.set_value("telemetry", "id", anon_id)
		cf.save(ID_PATH)


func _load_queue() -> void:
	if not FileAccess.file_exists(QUEUE_PATH):
		return
	var q = JSON.parse_string(FileAccess.get_file_as_string(QUEUE_PATH))
	if q is Array:
		queue = q.slice(maxi(0, q.size() - QUEUE_MAX))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(QUEUE_PATH))


func _save_queue() -> void:
	if queue.is_empty():
		if FileAccess.file_exists(QUEUE_PATH):
			DirAccess.remove_absolute(ProjectSettings.globalize_path(QUEUE_PATH))
		return
	var f := FileAccess.open(QUEUE_PATH, FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(queue))
		f.close()


func _drop_waiting() -> void:
	queue.clear()
	sentry_out.clear()
	for p in [QUEUE_PATH, FLAG_PATH]:
		if FileAccess.file_exists(p):
			DirAccess.remove_absolute(ProjectSettings.globalize_path(p))
␀␀␀␀␀␀# Loads the map layout (art/layout.json) and the minimap image produced by tools/terrain/build_terrain.py.
class_name Terrain
extends RefCounted

static var layout := {}
static var dressing := {}             # dressing.json (tools/terrain): what the 3D view places: [x, y, model, scale, yaw]
static var minimap: Texture2D = null
static var plots: Array = []          # 16 Vector2: team slot * 4 + building index
static var braziers: Array = []
static var lamps: Array = []
static var castle := Vector2(5020, 1024)
static var map_id := 0


static func dir() -> String:
	return String(Sim.MAPS[map_id]["dir"])


static func path(file: String) -> String:
	if dir() == "":
		return "res://art/" + ("layout.json" if file == "layout.json" else "terrain/" + file)
	return dir() + file


# A ground texture: the map's own version if it has one, otherwise the shared one.
static func tex_path(file: String) -> String:
	if dir() != "" and ResourceLoader.exists(dir() + file):
		return dir() + file
	return "res://art/terrain/" + file


static func set_map(i: int) -> void:
	if i == map_id and not layout.is_empty():
		return
	map_id = i
	layout = {}
	dressing = {}
	braziers = []
	lamps = []
	plots = []
	minimap = null
	ensure()


static func ensure() -> void:
	if not layout.is_empty():
		return
	var txt := FileAccess.get_file_as_string(path("layout.json"))
	if txt == "":
		layout = {"props": [], "plots": []}
	else:
		layout = JSON.parse_string(txt)
	plots = []
	for p in layout.get("plots", []):
		plots.append(Vector2(p[0], p[1]))
	if layout.has("castle"):
		castle = Vector2(layout["castle"][0], layout["castle"][1])
	var dtxt := FileAccess.get_file_as_string(path("dressing.json")) if FileAccess.file_exists(path("dressing.json")) else ""
	dressing = JSON.parse_string(dtxt) if dtxt != "" else {}
	if dressing == null:
		dressing = {}
	for it in props():
		if it[2] == "brazier":
			braziers.append(Vector2(it[0], it[1]))
		elif it[2] == "lamp":
			lamps.append(Vector2(it[0], it[1]))
	if ResourceLoader.exists(path("minimap.png")):
