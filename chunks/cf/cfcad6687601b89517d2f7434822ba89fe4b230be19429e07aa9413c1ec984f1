func _init(m, p) -> void:
	main = m
	party = p
	name = "PartyUI"


func build() -> void:
	bar = VBoxContainer.new()
	bar.name = "PartyBar"
	bar.add_theme_constant_override("separation", 6)
	bar.set_anchors_preset(Control.PRESET_TOP_RIGHT)
	bar.offset_right = -24
	bar.offset_left = -24 - WIDTH
	bar.offset_top = 112
	bar.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# the header: a button the size of a plate
	head = Button.new()
	head.name = "PartyHeader"
	head.focus_mode = Control.FOCUS_NONE
	head.custom_minimum_size = Vector2(WIDTH, 50)
	for st in ["normal", "hover", "pressed", "hover_pressed"]:
		var s: StyleBoxFlat = main.stone_panel(8)
		s.bg_color = Color(UIParts.STONE, 0.94) if st == "normal" else Color(UIParts.STONE_1, 0.97)
		s.border_color = UIParts.BRONZE if st == "normal" else UIParts.BRONZE_LITE
		head.add_theme_stylebox_override(st, s)
	head.pressed.connect(func(): set_open(not is_open(), true))
	head_h = main.hbox(8)
	head_h.set_anchors_preset(Control.PRESET_FULL_RECT)
	head_h.offset_left = 14
	head_h.offset_right = -12
	head_h.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head.add_child(head_h)
	bar.add_child(head)
	drop = PanelContainer.new()
	drop.name = "PartyDrop"
	var ds: StyleBoxFlat = main.stone_panel(12)
	ds.bg_color = Color(UIParts.STONE, 0.95)
	drop.add_theme_stylebox_override("panel", ds)
	drop.custom_minimum_size = Vector2(WIDTH, 0)
	drop.visible = false
	drop.mouse_filter = Control.MOUSE_FILTER_STOP
	var dv: VBoxContainer = main.vbox(8)
	drop.add_child(dv)
	bar_v = main.vbox(6)
	dv.add_child(bar_v)
	chat_box = main.vbox(4)
	dv.add_child(chat_box)
	chat_view = ChatView.new("Message your party…", 150, 13)
	chat_view.submitted.connect(func(t: String):
		var back: String = main.chat.submit(t, func(x: String): party.say(x))
		if back != "":
			news(back))
	say_edit = chat_view.edit
	chat_box.add_child(chat_view)
	bar.add_child(drop)
	main.add_child(bar)   # shown on the main menu and the Multiplayer screen (party chat there too)
	avatar_ui = AvatarUIScript.new(main)
	add_child(avatar_ui)
	avatar_ui.build()
	_build_picker()
	_build_news()
	party.changed.connect(refresh)
	party.notice.connect(func(t: String): main.notify(t))
	party.chat_line.connect(func(_t: String):
		_chat_n += 1
		if not is_open():
			unread += 1)
	main.account.changed.connect(refresh)
	main.account.friends_changed.connect(func():
		if pick_ov.visible:
			_render_picker()
		refresh())
	refresh()


func overlays() -> Array:
	return [pick_ov, avatar_ui.ov]


func is_open() -> bool:
	return drop != null and drop.visible


# open / close the dropdown; by_user: remembered for the session (an automatic open is not)
func set_open(v: bool, by_user := false) -> void:
	if by_user or not v:
		user_open = v
	if not v:
		auto_t = 0.0
	if drop.visible != v:
		drop.visible = v
		if v:
			unread = 0
			if by_user:
				main.audio.play("click", -6.0)
		_head_key = ""
		_layout()


# Bottom edge of the bar in the menu's coordinates (the invite toast sits under it).
func bottom() -> float:
	if bar == null or not bar.visible:
		return 110.0
	return bar.offset_top + bar.get_combined_minimum_size().y


func _process(dt: float) -> void:
	if bar == null:
		return
	var want: bool = main.account.has_name() and main.net.relay_configured() and ((main.menu != null and main.menu.visible) or (main.mp_ov != null and main.mp_ov.visible))
	want = want and main.notes_ov == null   # 0.32.5: the patch notes come first; the bar returns when they close
	want = want and not main._modal_open()   # 0.44.1: not over the Profile / Settings / Codex card (it overlapped the Profile's buttons at 1280 wide)
	if bar.visible != want:
		bar.visible = want
		if want:
			bar.move_to_front()
	if news_box != null and news_box.visible:
		news_t -= dt
		if news_t <= 0.0:
			news_box.visible = false
	if not want:
		# hidden (a match, another screen): only track the roster so a join while away doesn't pop it open later
		_last_count = party.members.size() if party.state == "in" else 0
		_last_state = party.state
		return
	# someone joined / we joined a party: open for a few seconds (not when the player closed it on purpose just now)
	var cnt: int = party.members.size() if party.state == "in" else 0
	if (cnt > _last_count and cnt > 1) or (party.state == "in" and _last_state == "joining"):
		if not drop.visible:
			auto_t = AUTO_OPEN_SECS
			set_open(true)
	_last_count = cnt
	_last_state = party.state
	if auto_t > 0.0 and not user_open:
		var over := drop.get_global_rect().has_point(drop.get_global_mouse_position()) or say_edit.has_focus()
		if not over:
			auto_t -= dt
			if auto_t <= 0.0:
				set_open(false)
	if drop.visible and not user_open and auto_t <= 0.0:
		set_open(false)
	elif user_open and not drop.visible:
		set_open(true, false)
	# under the profile plate, and under the "Rejoin your last match" / update plaques when they show (no overlap)
	var top := 112.0 if main.menu.visible else 22.0
	if main.menu.visible:
		var my: float = main.menu.get_global_rect().position.y
		for c in [main.friends_ui.plate, main.get("rejoin_plaque"), main.get("upd_plaque")]:
			if c != null and c is Control and c.visible and c.is_inside_tree():
				top = maxf(top, (c as Control).get_global_rect().end.y - my + 10.0)
		# 0.35.3: the Steam files note sits there too, then the bar under it
		var sp = main.get("steam_plaque")
		if sp != null and is_instance_valid(sp) and sp.visible and sp.is_inside_tree():
			if absf(sp.offset_top - top) > 0.5:
				sp.offset_top = top
				sp.offset_bottom = top
			top = maxf(top, sp.get_global_rect().end.y - my + 10.0)
	if absf(bar.offset_top - top) > 0.5:
		bar.offset_top = top
	# rebuilt only when something it shows changed
	var k := _state_key()
	if k != _key:
		refresh()
	_refresh_head()
	_refresh_chat()
	_layout()


# Keeps the dropdown inside the window: the chat well takes what height is left (scrolls beyond that).
func _layout() -> void:
	if bar == null:
		return
	var vp: Vector2 = main.get_viewport_rect().size
	if chat_box.visible:
		var others: float = drop.get_combined_minimum_size().y - chat_view.well.custom_minimum_size.y
		var room: float = vp.y - bar.offset_top - head.custom_minimum_size.y - 6.0 - 16.0 - others
		var want := clampf(room, 72.0, 210.0)
		if absf(chat_view.well.custom_minimum_size.y - want) > 1.0:
			chat_view.well.custom_minimum_size.y = want
	var h: float = bar.get_combined_minimum_size().y
	if bar.offset_left != bar.offset_right - WIDTH:
		bar.offset_left = bar.offset_right - WIDTH
	if absf(bar.offset_bottom - (bar.offset_top + h)) > 0.5:
		bar.offset_bottom = bar.offset_top + h


func _state_key() -> String:
	var n = main.net
	var acct = main.account
	return JSON.stringify([party.state, party.my_id, party.members, party.note, party.lobby_room, party.watch_room, party.last_mode, party.my_ready,
		party.relay_note(), acct.profile_name, acct.level(), acct.avatar, String(main.sel_id), n.in_lobby, n.room_code, Settings.pad_on,
		acct.friends.map(func(f): return f.get("code", "")), acct.incoming.map(func(f): return f.get("code", "")),
		acct.outgoing.map(func(f): return f.get("code", "")), _req_sent.keys()])


# ---------------------------------------------------------------- the header
func _refresh_head() -> void:
	var hk := JSON.stringify([party.state, party.members, unread, drop.visible, main.account.avatar, String(main.sel_id), main.account.profile_name])
	if hk == _head_key:
		return
	_head_key = hk
	for ch in head_h.get_children():
		head_h.remove_child(ch)
		ch.queue_free()
	var hl: Label = main.head_lbl("Party", 20, UIParts.GOLD, 3)
	hl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head_h.add_child(hl)
	var n: int = party.members.size() if party.active() and not party.members.is_empty() else 1
	var cnt: Label = main.lbl(("%d / %d" % [n, party.MAX_MEMBERS]) if party.active() else "just you", 13, UIParts.MUTED, false, 2)
	cnt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head_h.add_child(cnt)
	var sp := Control.new()
	sp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sp.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head_h.add_child(sp)
	# stacked avatars (up to 5), the leader first
	var stack := Control.new()
	stack.mouse_filter = Control.MOUSE_FILTER_IGNORE
	stack.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var entries: Array = []
	if party.active() and not party.members.is_empty():
		for id in party.ordered_ids():
			entries.append(party.members[id])
	else:
		entries.append({"name": main.account.profile_name, "hero": String(main.sel_id), "av": main.account.avatar})
	var shown := entries.slice(0, 5)
	var px := 30.0
	var step := 21.0
	stack.custom_minimum_size = Vector2(px + step * (shown.size() - 1), px)
	for i in range(shown.size() - 1, -1, -1):
		var e: Dictionary = shown[i]
		var f := _face_of(e, px)
		f.position = Vector2(step * i, 0)
		f.size = Vector2(px, px)
		stack.add_child(f)
	head_h.add_child(stack)
	if entries.size() > 5:
		var more: Label = main.lbl("+%d" % (entries.size() - 5), 13, UIParts.MUTED, false, 2)
		more.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		head_h.add_child(more)
	if unread > 0 and not drop.visible:
		var b: Label = main.lbl(str(mini(unread, 99)), 12, Color("#1a1814"), false, 0)
		b.add_theme_font_override("font", UIParts.font("ui_bold"))
		var bs: StyleBoxFlat = main.sb(UIParts.GOLD_TEXT, UIParts.BRONZE_DARK, 9, 1, 0)
		bs.content_margin_left = 6
		bs.content_margin_right = 6
		b.add_theme_stylebox_override("normal", bs)
		b.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		b.tooltip_text = "New party chat"
		head_h.add_child(b)
	var chev := Chevron.new()
	chev.up = drop.visible
	chev.custom_minimum_size = Vector2(16, 16)
	chev.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	chev.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head_h.add_child(chev)
	head.tooltip_text = "Close the party panel." if drop.visible else ("Open the party panel: members, invites and party chat." + ("  (%d new)" % unread if unread > 0 else ""))


func _face_of(e: Dictionary, px: float) -> Control:
	return Avatars.face(String(e.get("av", "")), String(e.get("hero", "")), String(e.get("name", "?")), px)


# ---------------------------------------------------------------- the dropdown
func refresh() -> void:
	if bar_v == null:
		return
	_key = _state_key()
	for ch in bar_v.get_children():
		bar_v.remove_child(ch)
		ch.queue_free()
	var acct = main.account
	# members (yourself alone when there is no party yet)
	if party.active() and not party.members.is_empty():
		for id in party.ordered_ids():
			var e: Dictionary = party.members[id]
			if int(id) != party.my_id:
				acct.remember_avatar(String(e.get("code", "")), String(e.get("av", "")))
			bar_v.add_child(_member_row(int(id), e))
	else:
		bar_v.add_child(_member_row(-1, {"name": acct.profile_name, "lvl": acct.level(), "hero": String(main.sel_id), "ready": false, "av": acct.avatar}))
	var rn: String = party.relay_note()
	chat_box.visible = party.state == "in" and party.members.size() > 1
	if rn != "":
		bar_v.add_child(_note(rn, Color(1.0, 0.68, 0.45)))
		_head_key = ""
		return
	if party.state in ["opening", "joining"]:
		bar_v.add_child(_note("Joining the party…" if party.state == "joining" else "Making a party…", UIParts.MUTED))
	elif party.state == "lost":
		bar_v.add_child(_note("Reconnecting to the party…", UIParts.MUTED))
	if party.count() < party.MAX_MEMBERS and party.state in ["", "in"]:
		var add := _btn("+   Invite a friend", 0)
		add.custom_minimum_size = Vector2(0, 34)
		add.alignment = HORIZONTAL_ALIGNMENT_LEFT
		add.tooltip_text = "Invite an online friend to your party."
		add.pressed.connect(open_picker)
		bar_v.add_child(add)
	if party.state == "in" and party.members.size() > 1:
		var row: HBoxContainer = main.hbox(8)
		if party.is_leader():
			var n = main.net
			if not (n.in_lobby or n.in_match):
				if party.last_mode != "":
					var pa: Button = main.primary_button("Play again  ·  %s" % _mode_name(party.last_mode))
					pa.custom_minimum_size = Vector2(0, 38)
					pa.add_theme_font_size_override("font_size", 17)
					pa.size_flags_horizontal = Control.SIZE_EXPAND_FILL
					pa.tooltip_text = "Host the same mode again: the party follows you into the lobby."
					pa.pressed.connect(func(): party.play_again())
					row.add_child(pa)
				var ho: Button = _btn("Host online" if party.last_mode == "" else "Other mode", 0)
				if party.last_mode == "":
					main.style_primary(ho)
					ho.add_theme_font_size_override("font_size", 17)
				ho.custom_minimum_size = Vector2(0, 38)
				ho.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				ho.tooltip_text = "Multiplayer: host an online game. Your party joins your lobby by itself."
				ho.pressed.connect(func(): main.show_mp())
				row.add_child(ho)
		else:
			var rd := _btn("Not ready" if party.my_ready else "Ready", 0)
			if not party.my_ready:
				main.style_primary(rd)
				rd.add_theme_font_size_override("font_size", 17)
			rd.custom_minimum_size = Vector2(0, 38)
			rd.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			rd.pressed.connect(func(): party.set_ready(not party.my_ready))
			row.add_child(rd)
			if party.lobby_room != "" and String(main.net.room_code) != party.lobby_room:
				var jb: Button = main.primary_button("Join the lobby")
				jb.custom_minimum_size = Vector2(0, 38)
				jb.add_theme_font_size_override("font_size", 17)
				jb.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				jb.pressed.connect(func(): party.follow())
				row.add_child(jb)
			elif party.watch_room != "" and not main.net.in_match and String(main.net.room_code) != party.watch_room:
				# 0.44: the leader's match runs and takes spectators: watch it
				var wb: Button = main.primary_button("Watch the match")
				wb.custom_minimum_size = Vector2(0, 38)
				wb.add_theme_font_size_override("font_size", 17)
				wb.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				wb.tooltip_text = "Watch %s's match live (room %s)." % [party.leader_name(), party.watch_room]
				wb.pressed.connect(func():
					main.show_mp()
					main.net.watch_relay(party.watch_room))
				row.add_child(wb)
		var lv := _btn("Leave", 78)
		lv.custom_minimum_size = Vector2(78, 38)
		lv.tooltip_text = "Leave the party."
		lv.pressed.connect(func(): party.leave())
		row.add_child(lv)
		bar_v.add_child(row)
		if not party.is_leader() and party.lobby_room == "":
			bar_v.add_child(_note("%s picks the game. You follow into the lobby." % party.leader_name(), UIParts.MUTED))
	elif party.active():
		var lv2 := _btn("Leave the party", 0)
		lv2.pressed.connect(func(): party.leave())
		bar_v.add_child(lv2)
	if party.note != "" and party.state != "lost":
		bar_v.add_child(_note(party.note, UIParts.GOLD_TEXT))
	_head_key = ""


# The chat lines, sender-coloured (you / friends / others; joins and leaves as muted system lines).
func _refresh_chat() -> void:
	if chat_view == null or not chat_box.visible:
		return
	var ck := "%d|%d|%s" % [_chat_n, party.chat_lines.size(), _key]
	if ck == _chat_key:
		return
	_chat_key = ck
	var names := {}
	for id in party.members:
		names[String(party.members[id].get("name", ""))] = String(party.members[id].get("code", ""))
	var acct = main.account
	var lines: Array = []
	for raw in party.chat_lines:
		var t := String(raw)
		var i := t.find(": ")
		var who := t.substr(0, i) if i > 0 else ""
		if who != "" and (names.has(who) or who == acct.profile_name or (i <= 20 and not who.contains(" ") and not t.ends_with("."))):
			var kind := "me" if who == acct.profile_name else ("friend" if acct.is_friend_code(String(names.get(who, ""))) else "other")
			lines.append({"kind": kind, "who": who, "text": main.chat.clean(t.substr(i + 2))})
		else:
			lines.append({"kind": "sys", "who": "", "text": t})
	chat_view.set_lines(lines, "No messages yet. Say hi to your party!")


func _mode_name(m: String) -> String:
	for md in main.MP_MODES:
		if md[0] == m:
			return md[1]
	return m.capitalize()


func _btn(text: String, w: float) -> Button:
	var b := Button.new()
	b.text = text
	b.focus_mode = Control.FOCUS_NONE
	b.custom_minimum_size = Vector2(w, 30)
	b.add_theme_font_size_override("font_size", 14)
	return b


func _note(text: String, col: Color) -> Label:
	var l: Label = main.lbl(text, 13, col, true, 2)
	l.custom_minimum_size = Vector2(WIDTH - 40, 0)
	return l


func _member_row(id: int, e: Dictionary) -> Control:
	var acct = main.account
	var me: bool = id == -1 or id == party.my_id
	var code := String(e.get("code", ""))
	var r: HBoxContainer = main.hbox(10)
	r.custom_minimum_size = Vector2(0, 44)
	r.mouse_filter = Control.MOUSE_FILTER_PASS
	var f := _face_of(e, 40)
	if me:
		# your own picture: click to change it
		var ab := Button.new()
		ab.flat = true
		ab.focus_mode = Control.FOCUS_NONE
		ab.custom_minimum_size = Vector2(44, 44)
		ab.tooltip_text = "Change your picture"
		f.set_anchors_preset(Control.PRESET_FULL_RECT)
		f.offset_left = 2
		f.offset_top = 2
		f.offset_right = -2
		f.offset_bottom = -2
		ab.add_child(f)
		var pen := PenMark.new()
		pen.set_anchors_preset(Control.PRESET_FULL_RECT)
		pen.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ab.add_child(pen)
		ab.pressed.connect(func(): avatar_ui.open())
		r.add_child(ab)
	else:
		f.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		r.add_child(f)
	var nv: VBoxContainer = main.vbox(0)
	nv.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	nv.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	nv.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var nl: Label = main.lbl(String(e.get("name", "?")) + ("  (you)" if me and id != -1 else ""), 16, Color(0.55, 1.0, 0.6) if me and id != -1 else UIParts.TEXT, false, 2)
	nl.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	nl.custom_minimum_size = Vector2(110, 0)
	nv.add_child(nl)
	var sub := "Level %d" % int(e.get("lvl", 1))
	var h: Dictionary = main.find_champ(String(e.get("hero", ""))) if String(e.get("hero", "")) != "" else {}
	if not h.is_empty():
		sub += "  ·  " + String(h.get("name", "")).split(" ")[0]
	var sl: Label = main.lbl(sub, 12, UIParts.MUTED, false, 2)
	sl.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	sl.custom_minimum_size = Vector2(110, 0)
	nv.add_child(sl)
	r.add_child(nv)
	# 0.32.1: befriend party members you don't know yet (friends of the friend who invited you)
	if not me and code != "":
		var c: String = party.norm(code)
		if acct.is_friend_code(code):
			var fl: Label = main.lbl("Friends", 12, UIParts.MUTED, false, 2)
			fl.name = "FriendsTag"
			fl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			fl.tooltip_text = "%s is on your friends list." % String(e.get("name", ""))
			fl.mouse_filter = Control.MOUSE_FILTER_PASS
			r.add_child(fl)
		elif acct.incoming.any(func(x): return party.norm(String(x.get("code", ""))) == c):
			var acc := _btn("Accept", 72)
			acc.name = "AcceptFriend"
			main.style_primary(acc)
			acc.add_theme_font_size_override("font_size", 14)
			acc.custom_minimum_size = Vector2(72, 30)
			acc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			acc.tooltip_text = "%s wants to be your friend: accept." % String(e.get("name", ""))
			acc.pressed.connect(func():
				acc.disabled = true
				acct.respond(code, true, func(res: Dictionary):
					news(("You and %s are now friends." % String(e.get("name", ""))) if bool(res.get("ok", false)) else String(res.get("msg", "Couldn't accept.")))))
			r.add_child(acc)
		elif _req_sent.has(c) or acct.outgoing.any(func(x): return party.norm(String(x.get("code", ""))) == c):
			var rs: Label = main.lbl("Request sent", 12, UIParts.MUTED, false, 2)
			rs.name = "RequestSent"
			rs.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			rs.tooltip_text = "Waiting for %s to accept your friend request." % String(e.get("name", ""))
			rs.mouse_filter = Control.MOUSE_FILTER_PASS
			r.add_child(rs)
		else:
