func human_build(k: int) -> void:
	if sim == null or sim.over or paused:
		return
	if sim.mode == "survival":
		show_error("There is no enemy team in Survival: spend your gold on items, scrolls and the crystal.")
		return
	if replay_mode:
		return
	var pl = sim.players[sim.local]
	if k < pl.tech:
		set_send_tab(k)
		bld_btns[k].flash = 0.2
		update_hud()
		return
	var res = act("build", [k])
	match res:
		"ok", "sent":
			bld_btns[k].flash = 0.3
			set_send_tab(k)
			var names: Array = []
			for i in GameData.sends_of(k).slice(0, 4):
				names.append(GameData.SENDS[i]["name"])
			announce("%s built" % GameData.BUILDINGS[k]["name"], "Eight new monsters to send, including " + ", ".join(names))
			update_hud()
		"locked":
			show_error("Build the %s first." % GameData.BUILDINGS[k - 1]["name"])
		"gold":
			show_error("Not enough gold. The %s costs %d." % [GameData.BUILDINGS[k]["name"], Sim.building_cost(k)])


