# Every week you played, newest first.
static func weekly_history() -> Array:
	ensure()
	var out: Array = []
	for k in weekly:
		var e: Dictionary = weekly[k].duplicate()
		e["week"] = int(k)
		out.append(e)
	out.sort_custom(func(a, b): return int(a["week"]) > int(b["week"]))
	return out


static func weekly_code(week: int, name: String, e: Dictionary) -> String:
	var nm := name.strip_edges().replace("-", " ").substr(0, 16)
	var body := "%d-%d-%d-%d-%d-%s-%s" % [week, int(e["score"]), 1 if bool(e.get("won", false)) else 0, int(e.get("round", 0)), int(e.get("kills", 0)), String(e.get("hero", "")).split(" ")[0], nm.replace(" ", "_")]
	return "CW-%s-%s" % [body, String.num_int64(_code_sum(body), 36).to_upper()]


static func parse_weekly_code(code: String) -> Dictionary:
	var c := code.strip_edges()
	if not c.begins_with("CW-"):
		return {}
	var parts := c.substr(3).split("-")
	if parts.size() != 8:
		return {}
	var body := "-".join(parts.slice(0, 7))
	if String.num_int64(_code_sum(body), 36).to_upper() != parts[7].to_upper():
		return {}
	for i in 5:
		if not parts[i].is_valid_int():
			return {}
	return {"week": int(parts[0]), "score": int(parts[1]), "won": int(parts[2]) == 1, "round": int(parts[3]), "kills": int(parts[4]), "hero": parts[5], "name": parts[6].replace("_", " ")}


# Adds a friend's result from a share code. Returns an error message, or "" if it worked.
