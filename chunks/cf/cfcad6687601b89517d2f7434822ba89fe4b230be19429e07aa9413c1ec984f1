# Host: who may open a Steam session with us - members of our lobby, or our Steam friends (the lobby is
# friends-only; a friend's session request can arrive before Steam has told us they joined).
func _steam_may_join(sid: int) -> bool:
	if not steam_ok or lobby_id == 0:
		return false
	for i in int(steam.getNumLobbyMembers(lobby_id)):
		if int(steam.getLobbyMemberByIndex(lobby_id, i)) == sid:
			return true
	return int(steam.getFriendRelationship(sid)) == 3   # k_EFriendRelationshipFriend


