		round_t = round_len - tv("setup_len")   # the setup minute: shop, build, send; the first wave at 60 s
	income_t = income_every if not income_per_round else round_len - round_t
	bans = banned.duplicate()
	for c in GameData.CHAMPS:
		champ_by_id[c["id"]] = c
	var pool: Array = []
	for c in GameData.CHAMPS:
		if c["id"] != human_id and not bans.has(c["id"]):
			pool.append(c["id"])
	_shuffle(pool)
	var picks: Array = []
	picks.append(pool.pop_back() if human_id == "" else human_id)
	for i in 7:
		picks.append(pool[i])
	# multiplayer (and any fixed line-up): who plays which slot is decided before the match
	var lineup: Array = opts.get("lineup", [])
	for i in mini(lineup.size(), 8):
		if String(lineup[i].get("champ", "")) != "":
			picks[i] = String(lineup[i]["champ"])
	for tm in 2:
		var ar := Arena.new()
		ar.team = tm
		ar.idx = tm
		arenas.append(ar)
	duel_ar = Arena.new()
	duel_ar.idx = 2
	duel_ar.duel = true
	var pick_i := 0
	for tm in 2:
		for i in 4:
			var pl := Player.new()
			pl.id = players.size()
			pl.team = tm
			pl.human = tm == 0 and i == 0 and not all_ai
			if tm == 0 and i == 0:
				pl.name = "Autopilot" if all_ai else "You"
			else:
				pl.name = AI_NAMES[tm][i - 1 if tm == 0 else i]
			pl.champ_id = picks[pick_i]
			pl.diff = difficulty if tm == 1 else 1
			if ai_tiers:
				pl.diff = mini(difficulty + AI_TIER_SHIFT, DIFF_HERO.size() - 1)   # allies play exactly as well as the enemy
			if pick_i < lineup.size():
				var slot: Dictionary = lineup[pick_i]
				pl.human = bool(slot.get("human", false))
				pl.name = String(slot.get("name", pl.name))
				pl.diff = int(slot.get("diff", pl.diff))
				if ai_tiers and slot.has("diff"):
					pl.diff = mini(int(slot["diff"]) + AI_TIER_SHIFT, DIFF_HERO.size() - 1)
				if slot.get("cos") is Dictionary:
					pl.cos = slot["cos"]   # ---- 0.44 rewards ---- (view-only; the checksum never reads it)
			pick_i += 1
			pl.gold = start_gold
			pl.income = start_inc
			pl.absent = (mode == "survival" and not (tm == 0 and i == 0)) or i >= team_size
			pl.send_t = rng.randf_range(2.0, 5.0)
			players.append(pl)
			var home: int = [2, 0, 1, 3][i] if tm == 0 else i
			if team_size < 4:
				# small teams hold the shared road after the confluence, where both lanes have merged
				home = [2, 3, 0, 1][i]
			pl.champ = make_champ(champ_by_id[pl.champ_id], pl, arenas[tm], home)
			if pl.human and pl.cos.has("sk"):
				pl.champ.skin = String(pl.cos["sk"])   # ---- 0.44 rewards ---- the line-up's skin (humans only; bots keep their random one)
			if not pl.absent:
				arenas[tm].champs.append(pl.champ)
	if mode == "quick":
		for ar in arenas:
			ar.core_max *= 0.65
			ar.core_hp = ar.core_max
	if team_size < 4 and mode != "survival":
		# with fewer heroes the crystal carries more of the defence
		for ar in arenas:
			ar.core_max *= 1.8 if team_size == 1 else 1.35
			ar.core_hp = ar.core_max
	if mode == "survival":
		arenas[0].core_max *= 1.8
		arenas[0].core_hp = arenas[0].core_max
		surv_lives = SurvivalData.START_LIVES
	if mods.has("core_k"):   # 0.44 modes (Brittle)
		for ar in arenas:
			ar.core_max *= mk("core_k")
			ar.core_hp = ar.core_max
	if opts.has("cfg"):
		apply_cfg(opts["cfg"])
	if mode == "survival":
		surv_strip(players[0].champ)
		if opts.has("talents") and daily == 0:
			apply_talents(players[0], opts["talents"])
		offer_cards("first")
	hero_hp_sync()   # 0.32 Heroes tab: start with the set's max-health multipliers


# ---------------------------------------------------------------- 0.18.1 live balance knobs
# Whether this match reads the knobs: classic / quick always; the 10 s modes and the campaign only with "apply_surv".
func tune_applies() -> bool:
	if mode in ["classic", "quick"] and cfg.is_empty():
		return true
	return float(tune.get("apply_surv", 0.0)) >= 0.5


func tune_set(set: Dictionary) -> void:
	tune = Tune.clean(set)
	_tune_on = tune_applies()
	tune_bind()


# Points the static Tune.active at this sim's set (or the defaults when the knobs don't apply here).
func tune_bind() -> void:
	Tune.active = tune if _tune_on else Tune.LEGACY   # 0.24: the 10 s modes / campaign keep the 0.23 numbers (not the new built-in defaults)


# This sim's value of a knob.
func tv(name: String) -> float:
	tune_bind()
	return Tune.v(name)


# The "tune" command: one knob, snapped to its step; defaults are erased from the set. Some knobs act at once
# on the running round (round and setup length); the rest are read wherever the constant used to be.
func tune_cmd(name: String, value: float) -> bool:
	if not Tune.DEFS.has(name):
		return false
	var old := Tune.value_in(tune, name)
	Tune.set_knob(tune, name, value)
	var nv := Tune.value_in(tune, name)
	tune_cmds += 1
	_tune_on = tune_applies()
	tune_bind()
	hero_hp_sync()   # 0.32: a hero's max health moves at once (and back to the shipped numbers if the knobs stop applying)
	if not _tune_on:
		return true
	match name:
		"round_len":
			if mode == "classic":
				round_len = roundf(nv * mk("round_len_k"))
			elif mode == "quick":
				round_len = roundf(nv * 24.0 / 35.0 * mk("round_len_k"))
			round_t = minf(round_t, round_len)
		"setup_len":
			if in_setup():
				round_t = clampf(round_t + old - nv, 0.0, round_len)
	return true


