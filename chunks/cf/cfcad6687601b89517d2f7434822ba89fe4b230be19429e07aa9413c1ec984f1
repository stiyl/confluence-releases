	var app_id := int(steam.getAppID()) if steam.has_method("getAppID") else 0
	var n := int(steam.getFriendCount(4))
	for i in mini(n, 500):
		var fid := int(steam.getFriendByIndex(i, 4))
		if fid == 0:
			continue
		var st := int(steam.getFriendPersonaState(fid))
		var in_game := false
		if steam.has_method("getFriendGamePlayed"):
			var gp = steam.getFriendGamePlayed(fid)
			in_game = gp is Dictionary and app_id != 0 and int(gp.get("id", 0)) == app_id
		out.append({"id": fid, "name": String(steam.getFriendPersonaName(fid)), "state": STEAM_STATES[clampi(st, 0, 6)],
			"online": st != 0, "in_game": in_game})
	out.sort_custom(func(a, b):
		if a["in_game"] != b["in_game"]:
			return a["in_game"]
		if a["online"] != b["online"]:
			return a["online"]
		return String(a["name"]).nocasecmp_to(String(b["name"])) < 0)
	return out


# Invites a Steam friend to the Steam lobby you are in. False if there is no lobby (host one first).
var _steam_invite_queue := []


# Friends panel: invite a Steam friend before a lobby exists - sent once host_steam's lobby is created.
func steam_invite_when_open(friend_id: int) -> void:
	if not _steam_invite_queue.has(friend_id):
		_steam_invite_queue.append(friend_id)


func steam_invite(friend_id: int) -> bool:
	if not steam_ok or steam == null or lobby_id == 0 or not steam.has_method("inviteUserToLobby"):
		return false
	return bool(steam.inviteUserToLobby(lobby_id, friend_id))


func join_steam(lid: int) -> void:
	if not steam_ok:
		return
	if lid == lobby_id:
		return
	if transport != "" or lobby_id != 0:
		leave()
	status.emit("Joining the Steam lobby…")
	steam.joinLobby(lid)


const LOBBY_ENTER := {2: "the lobby doesn't exist any more", 3: "not allowed", 4: "the lobby is full", 5: "Steam error",
	6: "you are banned from it", 7: "limited Steam account", 8: "clan disabled", 9: "community ban", 10: "a member blocked you", 11: "you blocked a member"}
func _on_steam_lobby_joined(lid: int, _perm: int, _locked: bool, response: int) -> void:
	if response != 1:   # k_EChatRoomEnterResponseSuccess
		_fail("Couldn't join that Steam lobby: %s." % LOBBY_ENTER.get(response, "response %d" % response))
		return
	if int(steam.getLobbyOwner(lid)) == steam_id:
		return   # we made it; already hosting
	var ver := String(steam.getLobbyData(lid, "ver"))
	if ver != "" and ver != game_version() and not rejoining:
		steam.leaveLobby(lid)
		_fail("Version mismatch: the host runs Confluence %s, you run %s. You both need the same build." % [ver, game_version()])
		return
	lobby_id = lid
	_steam_connect(lid)


# Open the Steam session to the lobby's owner (a fresh join, or a reconnection to the same lobby).
var _steam_host := 0   # the Steam id we joined (a reconnection only goes back to the same host)


func _steam_connect(lid: int) -> void:
	var owner := int(steam.getLobbyOwner(lid))
	if owner == 0 or owner == steam_id or (rejoining and _steam_host != 0 and owner != _steam_host):
		_fail("The host left the Steam lobby.", true)   # Steam handed the lobby to someone else: the host is gone
		return
	_close_peer()
	var peer = SteamPeerScript.new()
	var err: Error = peer.join(steam, steam_id, owner)
	if err != OK:
		_fail("Steam networking failed to connect (error %d)." % err)
		return
	peer.lost.connect(func(msg: String, fatal: bool): _fail(msg, fatal))
	multiplayer.multiplayer_peer = peer
	transport = "steam"
	is_host = false
	_steam_host = owner
	_steam_presence(lid)
	_join_t = JOIN_TIMEOUT * 2.0   # Steam's relay can take a while to find the route
	_log("Steam: joining lobby %d (host %d)" % [lid, owner])


# Friends see "Join Game" on us in their Steam friends list while we are in a lobby.
func _steam_presence(lid: int) -> void:
	if not steam_ok or not steam.has_method("setRichPresence"):
		return
	if lid == 0:
		steam.clearRichPresence()
	else:
		steam.setRichPresence("connect", "+connect_lobby %d" % lid)
		steam.setRichPresence("status", "In a Confluence lobby")


# ---------------------------------------------------------------- relay (room codes)
func relay_configured() -> bool:
	return not relay_url.contains("REPLACE_ME")


func host_relay(want_code := "") -> void:
	if not relay_configured():
		status.emit("The online relay isn't set up in this build yet. Use a direct connection for now.")
		return
	leave()
	var peer = RelayPeerScript.new()
	var err: Error = peer.host(relay_url) if want_code == "" else peer.rehost(relay_url, want_code, "")   # 0.45 ranked: the relay picked the code
	if err != OK:
		status.emit("Couldn't start connecting to the relay (error %d)." % err)
		return
	_relay_pending = peer
	transport = "relay"
	peer.room_ready.connect(func(c: String):
		_relay_pending = null
		room_code = c
		room_secret = String(peer.room_secret)
		multiplayer.multiplayer_peer = peer
		_become_host()
		host_info = {"relay": c}
		host_info_changed.emit()
		status.emit("Room %s is open. Friends join with this code." % c))
	peer.relay_error.connect(func(msg: String, fatal: bool):
		_relay_pending = null
		_fail(msg, fatal))
	peer.host_changed.connect(_on_host_changed)
	status.emit("Opening a room on the relay…")


func join_relay(code: String, spec := false) -> void:
	var c := code.strip_edges().to_upper().replace(" ", "")
	if c == "":
		status.emit("Type the room code first.")
		return
	if not relay_configured():
		status.emit("The online relay isn't set up in this build yet. Use a direct connection for now.")
		return
	leave()
	var peer = RelayPeerScript.new()
	var err: Error = peer.watch(relay_url, c) if spec else peer.join(relay_url, c)   # 0.44: a spectator slot
	_want_spec = spec
	if err != OK:
		status.emit("Couldn't start connecting to the relay (error %d)." % err)
		return
	peer.relay_error.connect(func(msg: String, fatal: bool): _fail(msg, fatal))
	peer.host_changed.connect(_on_host_changed)
	peer.host_back.connect(_on_host_back)
	multiplayer.multiplayer_peer = peer
	transport = "relay"
	is_host = false
	room_code = c
	status.emit(("Joining room %s to watch…" if spec else "Joining room %s…") % c)


# ---------------------------------------------------------------- direct IP
func host_ip(port := PORT) -> void:
	var peer := ENetMultiplayerPeer.new()
	var err := peer.create_server(port, 7 + MAX_SPECT)   # 0.44: + spectators
	if err != OK:
		_fail("Couldn't open port %d (error %d). Is another copy of the game already hosting?" % [port, err])
		return
	multiplayer.multiplayer_peer = peer
	transport = "ip"
	_become_host()
	host_info = {"lan": lan_addresses(), "public": "", "upnp": "trying", "note": "Asking your router to open the port…"}
	host_info_changed.emit()
	_start_upnp(port)


# The machine's own private addresses (LAN, and Tailscale / Radmin style VPN ranges).
static func lan_addresses() -> Array:
	var out: Array = []
	for a in IP.get_local_addresses():
		if a.contains(":") or a.begins_with("127.") or a.begins_with("169.254."):
			continue
		out.append(a)
	out.sort_custom(func(x, y): return _addr_rank(x) < _addr_rank(y))
	return out


static func _addr_rank(a: String) -> int:
	if a.begins_with("192.168.") or a.begins_with("10."):
		return 0
	if a.begins_with("100.") or a.begins_with("26."):   # Tailscale (100.64/10), Radmin VPN (26.x)
		return 1
	return 2


static func _is_private(a: String) -> bool:
	var p := a.split(".")
	if p.size() != 4:
		return false
	var b0 := int(p[0])
	var b1 := int(p[1])
	return b0 == 10 or (b0 == 192 and b1 == 168) or (b0 == 172 and b1 >= 16 and b1 <= 31) or (b0 == 100 and b1 >= 64 and b1 <= 127)


# UPnP discovery blocks for a couple of seconds, so it runs on a thread and reports back.
func _start_upnp(port: int) -> void:
	_stop_upnp()
	_upnp_port = port
	_upnp_thread = Thread.new()
	_upnp_thread.start(_upnp_work.bind(port))


func _upnp_work(port: int) -> void:
	var u := UPNP.new()
	var res := {"upnp": "failed", "public": ""}
	var err := u.discover(2500, 2, "InternetGatewayDevice")
	if err == UPNP.UPNP_RESULT_SUCCESS and u.get_gateway() != null and u.get_gateway().is_valid_gateway():
		var ext := u.query_external_address()
		res["public"] = ext
		var e1 := u.add_port_mapping(port, port, "Confluence", "UDP", 0)
		if e1 == UPNP.UPNP_RESULT_SUCCESS:
			res["upnp"] = "cgnat" if (ext != "" and _is_private(ext)) else "ok"
			_upnp = u
	call_deferred("_upnp_done", res)


func _upnp_done(res: Dictionary) -> void:
	if _upnp_thread != null:
		_upnp_thread.wait_to_finish()
		_upnp_thread = null
	if not is_host or transport != "ip":
		_stop_upnp()
		return
	host_info["public"] = res["public"]
	host_info["upnp"] = res["upnp"]
	match String(res["upnp"]):
		"ok":
			host_info["note"] = "Your router opened UDP port %d automatically. Friends on the internet join with your public address." % PORT
		"cgnat":
			host_info["note"] = ("Your router reports a shared address (%s): your internet provider puts you behind carrier NAT, so " +
				"friends on the internet can't reach you directly. Let a friend host, or all join the same Tailscale / Radmin VPN network and use those addresses.") % res["public"]
		_:
			host_info["note"] = ("Your router didn't open the port automatically (UPnP is off or unsupported). For internet play, forward " +
				"UDP port %d on your router to this PC's LAN address, or use Tailscale / Radmin VPN. LAN players can join right away.") % PORT
	host_info_changed.emit()
	status.emit(host_info["note"])


func _stop_upnp() -> void:
	if _upnp != null and _upnp_port > 0:
		_upnp.delete_port_mapping(_upnp_port, "UDP")
	_upnp = null
	if _upnp_thread != null and not _upnp_thread.is_alive():
		_upnp_thread.wait_to_finish()
		_upnp_thread = null


# "1.2.3.4", "1.2.3.4:24680", "host.example.com", " 1.2.3.4 " -> [address, port]
static func parse_address(text: String) -> Array:
	var t := text.strip_edges().replace(" ", "")
	for pre in ["udp://", "http://", "https://"]:
		if t.begins_with(pre):
			t = t.substr(pre.length())
	var port := PORT
	if t.count(":") == 1:
		var parts := t.split(":")
		t = parts[0]
		if parts[1].is_valid_int():
			port = int(parts[1])
	return [t, port]


func join_ip(address: String, port := PORT) -> void:
	var pa := parse_address(address)
	var addr: String = pa[0]
	if port == PORT:
		port = int(pa[1])
	if addr == "":
		status.emit("Type the host's address first.")
		return
	var peer := ENetMultiplayerPeer.new()
	var err := peer.create_client(addr, port)
	if err != OK:
		_fail("Couldn't start connecting to %s (error %d). Check the address." % [addr, err])
		return
	multiplayer.multiplayer_peer = peer
	transport = "ip"
	is_host = false
	_join_addr = "%s:%d" % [addr, port]
	_join_t = JOIN_TIMEOUT
	status.emit("Connecting to %s…" % _join_addr)


func leave(reason := "", keep_rejoin := false) -> void:
	if steam_ok and lobby_id != 0:
		steam.leaveLobby(lobby_id)
		_steam_presence(0)
	lobby_id = 0
	_close_peer()
	if _relay_pending != null:
		_relay_pending.close()
		_relay_pending = null
	room_code = ""
	_stop_upnp()
	_join_t = -1.0
	host_info = {}
	in_lobby = false
	in_match = false
	is_host = false
	transport = ""
	sim = null
	draft = null   # 0.44
	peer_slot.clear()
	bundles.clear()
	pending.clear()
	# 0.25
	is_dropped = false
	rejoining = false
	migrating = false
	_cu = {}
	_cu_chunks.clear()
	_send_q.clear()
	cmd_log.clear()
	roster.clear()
	match_cfg = {}
	auto_rc = false
	_rc_hold = false
	_rc_hello_due = false
	_rc_missing.clear()
	_relay_pending = null
	room_secret = ""
	spectating = false   # 0.44
	_want_spec = false
	spec_peers.clear()
	rk = {}   # ---- 0.45 ranked ---- (ranked_begin sets it again after its own leave)
	_rk_picks.clear()
	rk_my_pick = ""
	_rk_join_t = 0.0
	if not keep_rejoin:
		_clear_rejoin_file()
	if reason != "":
		left.emit(reason)


func _close_peer() -> void:
	if multiplayer.multiplayer_peer != null:
		multiplayer.multiplayer_peer.close()
	multiplayer.multiplayer_peer = null


# fatal: the room itself is gone (the host left on a relay without migration, kicked, no such room), so
# there is nothing to rejoin.
func _fail(msg: String, fatal := false) -> void:
	_log("fail: " + msg)
	if _rk_retry(msg):
		return   # ---- 0.45 ranked ---- the host's room isn't open yet: try again in a moment
	_steam_invite_queue.clear()
	if is_dropped and not rejoining:
		return   # already frozen and waiting for the player's choice
	if rejoining:
		# a rejoin attempt failed: the frozen match stays (the player may try again or leave)
		rejoining = false
		_relay_pending = null
		if not is_dropped and in_match and sim != null and not sim.over and _can_rejoin():
			# 0.26: a rejoin over our live socket (the host came back or changed) got no answer: a drop, retried below
			_drop(msg)
			return
		_close_peer()
		if auto_rc and is_dropped:
			# 0.26: not the end unless the answer was final; otherwise the next attempt comes in RECONNECT_EVERY s
			if _rc_terminal(msg, fatal):
				_rc_give_up(msg)
			else:
				_rc_last = msg.trim_suffix(".")
				_rc_wait = RECONNECT_EVERY
				_log("reconnect attempt failed (%s), next in %ds, %ds left" % [msg, int(RECONNECT_EVERY), int(RECONNECT_FOR - _rc_elapsed)])
			return
		if fatal and msg.begins_with("No game with that room code"):
			msg = "That match has ended: the room is closed."
		if not is_dropped:
			leave()
			status.emit(msg)
		rejoin_failed.emit(msg)
		return
	if in_match and not is_dropped and not fatal and sim != null and not sim.over and _can_rejoin():
		_drop("Lost the connection to the host." if msg == "The host left." else msg)   # a dead socket, not a goodbye
		return
	var was := in_lobby or in_match
	leave()
	left.emit(msg)
	if not was:
		status.emit(msg)


# ---------------------------------------------------------------- 0.25 rejoin
func _can_rejoin() -> bool:
	# the relay keeps the room (and migrates the host); a direct-IP or Steam host that is gone can't be rejoined,
	# but a player whose own connection blinked can come back to a host that is still there
	if spectating:
		return false   # 0.44: a spectator who loses the host just leaves (with the reason); watching again is one click
	return transport == "relay" or not is_host


# We lost the host mid-match: keep the match frozen and offer to rejoin.
func _drop(msg: String) -> void:
	if is_dropped:
		return
	_log("dropped: " + msg)
	is_dropped = true
	rejoining = false
	migrating = false
	_cu = {}
	_cu_chunks.clear()
	_send_q.clear()
	bundles.clear()
	pending.clear()
	_newest = tick - 1           # the bundles we held are gone; the log catch-up brings everything from `tick` on
	var p = multiplayer.multiplayer_peer
	if p != null and p.get("close_code") != null:
		_log("relay socket close code %d reason '%s'" % [int(p.close_code), String(p.close_reason)])
	if is_host and transport == "relay" and p != null and p.get("room_secret") != null and String(p.room_secret) != "":
		room_secret = String(p.room_secret)
	_close_peer()
	if _stalled:
		_stalled = false
		stall_changed.emit(false, 0.0)
	# 0.26: reconnect on our own; the host re-claims its room, a player rejoins
	auto_rc = true
	_rc_mode = "host" if is_host and transport == "relay" else "join"
	_rc_elapsed = 0.0
	_rc_wait = 0.0
	_rc_last = ""
	_rc_shown = -1
	_log("auto-reconnect (%s) every %ds for %ds, room %s" % [_rc_mode, int(RECONNECT_EVERY), int(RECONNECT_FOR), room_code])
	dropped.emit(msg)


static func _new_secret() -> String:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var s := ""
	for i in 4:
		s += "%08x" % rng.randi()
	return s


# Reconnect to the host we were playing with and ask for the match since the tick we stopped at.
func rejoin() -> void:
	if not is_dropped or rejoining:
		return
	if auto_rc:
		_rc_wait = 0.0   # "retry now"
		return
	_since = tick if sim != null else -1
	_reconnect()


# ---------------------------------------------------------------- 0.26 automatic reconnection
func _rc_attempt() -> void:
	_rc_wait = RECONNECT_EVERY
	if _rc_mode == "host":
		_rehost()
	else:
		_since = tick if sim != null else -1
		_reconnect()


# Answers that end the match for good (the room was closed on purpose, we were kicked, the match is over, the
# host moved on). Everything else (no room yet, no answer, the relay unreachable, the host changing) is retried.
func _rc_terminal(msg: String, fatal: bool) -> bool:
	if msg in ["That match has ended.", "That match has already started."] or msg.begins_with("Version mismatch"):
		return true
	if fatal and not (msg.begins_with("No game with that room code") or msg.begins_with("That room is full")):
		return true
	return false


func _rc_give_up(msg: String) -> void:
	_log("reconnection over: " + msg)
	auto_rc = false
	var was := in_lobby or in_match
	leave()
	left.emit(msg)
	if not was:
		status.emit(msg)


# The relay host: open the same room again (the relay keeps it for us, or we create it anew with the same code).
func _rehost() -> void:
	rejoining = true
	_rejoin_t = REJOIN_TIMEOUT
	is_host = true
	peer_slot = {1: sim.local} if sim != null else {}
	_peer_seen.clear()
	bundles.clear()
	pending.clear()
	var peer = RelayPeerScript.new()
	var err: Error = peer.rehost(relay_url, room_code, room_secret)
	if err != OK:
		_fail("Couldn't start connecting to the relay (error %d)." % err)
		return
	_relay_pending = peer
	peer.room_ready.connect(func(c: String):
		_relay_pending = null
		multiplayer.multiplayer_peer = peer
		call_deferred("_on_rehosted", peer))   # after the peer has announced the players still in the room
	peer.relay_error.connect(func(msg: String, fatal: bool):
		_relay_pending = null
		_fail(msg, fatal))
	peer.rehost_refused.connect(func(why: String):
		_relay_pending = null
		if why == "taken":
			# another player hosts the room now (promoted while we were away): we come back as a player
			_log("re-claim refused: the room has a new host; rejoining as a player")
			rejoining = false
			is_host = false
			_rc_mode = "join"
			_rc_wait = 0.0
		else:
			_fail("The relay closed the room and can't reopen it (the relay needs the 0.26 update).", true))
	peer.host_changed.connect(_on_host_changed)
	status.emit("Reopening room %s…" % room_code)


func _on_rehosted(peer) -> void:
	rejoining = false
	is_dropped = false
	auto_rc = false
	is_host = true
	room_secret = String(peer.room_secret)
	peer_slot = {1: sim.local}
	_peer_seen.clear()
	sums.clear()
	pending.clear()
	bundles.clear()
	_cu = {}
	acc = 0.0
	# the match waits for the first player to come back (PEER_DROP at most); the rest have until then too
	_rc_hold = true
	_rc_hold_t = 0.0
	_rc_shown = -1
	_rc_missing.clear()
	var deadline := Time.get_ticks_msec() + int(PEER_DROP * 1000.0)
	var line: Array = match_cfg.get("lineup", [])
	for i in line.size():
		if i != sim.local and i < sim.players.size() and sim.players[i].human:
			_rc_missing[i] = deadline
	var present: Array = peer.peer_ids() if peer.has_method("peer_ids") else []
	_log("room %s reopened at tick %d after %.0fs; %d players still connected, %d slots to come back" % [room_code, tick, _rc_elapsed, present.size(), _rc_missing.size()])
	_save_rejoin_file()
	reconnecting.emit("Reconnected", "Waiting for the others…")


# Re-claimed host, every frame while the match is held: resume when the first player is back, or after PEER_DROP.
func _run_hold(dt: float) -> void:
	_rc_hold_t += dt
	if int(_rc_hold_t) != _rc_shown:
		_rc_shown = int(_rc_hold_t)
		reconnecting.emit("Reconnected", "Waiting for the others…  %d s" % _rc_shown)
	if _rc_hold_t >= PEER_DROP:
		_log("nobody came back in %ds: the match goes on (AI takes the empty slots)" % int(PEER_DROP))
		_resume_held()


func _resume_held() -> void:
	_rc_hold = false
	acc = 0.0
	_last_bundle_ms = Time.get_ticks_msec()
	_log("resuming at tick %d with peers %s" % [tick, str(peer_slot)])
	rejoined.emit()


# A player: the host's game is back on a new socket (the relay said "rehost"); ask it for what we missed. The hello
# goes out next frame, after the relay peer has re-announced peer 1 (so the RPC path cache starts over).
func _on_host_back() -> void:
	if not in_match or is_dropped or sim == null:
		return
	_log("the host is back (relay rehost) at tick %d: asking to rejoin" % tick)
	rejoining = true
	_rejoin_t = REJOIN_TIMEOUT
	_since = tick
	bundles.clear()
	_cu = {}
	_cu_chunks.clear()
	migrating = false
	_mig_fill_wait = false
	_newest = tick - 1
	if _stalled:
		_stalled = false
		stall_changed.emit(false, 0.0)
	_rc_hello_due = true


func _send_rejoin_hello() -> void:
	status.emit("Connected. Asking to rejoin…")
	_hello.rpc_id(1, my_name, "%s|%d" % [game_version(), my_level], {"rejoin": my_secret, "since": _since, "mid": match_id})


# "Rejoin your last match" on the main menu: the game was closed (or crashed) during an online match less than
# REJOIN_MAX_AGE ago. Returns {} when there is nothing to offer.
func rejoin_offer() -> Dictionary:
	var f := FileAccess.open(REJOIN_FILE, FileAccess.READ)
	if f == null:
		return {}
	var d = JSON.parse_string(f.get_as_text())
	f.close()
	if not d is Dictionary or String(d.get("ver", "")) != game_version():
		return {}
	var age := Time.get_unix_time_from_system() - float(d.get("t", 0))
	if age < 0 or age > REJOIN_MAX_AGE:
		return {}
	d["age"] = age
	return d


func rejoin_from_file() -> void:
	var d := rejoin_offer()
	if d.is_empty() or in_match or in_lobby:
		return
	leave("", true)
	transport = String(d.get("transport", ""))
	room_code = String(d.get("room", ""))
	_join_addr = String(d.get("addr", ""))
	lobby_id = int(d.get("lobby", 0))
	my_secret = String(d.get("secret", ""))
	match_id = int(d.get("mid", 0))
	if String(d.get("name", "")) != "":
		my_name = String(d["name"])
	sim = null
	tick = 0
	_since = -1
	_reconnect()


func _reconnect() -> void:
	rejoining = true
	_rejoin_t = REJOIN_TIMEOUT
	is_host = false
	in_lobby = false
	peer_slot.clear()
	bundles.clear()
	pending.clear()
	_cu = {}
	_cu_chunks.clear()
	match transport:
		"relay":
			var peer = RelayPeerScript.new()
			var err: Error = peer.join(relay_url, room_code)
			if err != OK:
				_fail("Couldn't start connecting to the relay (error %d)." % err)
				return
			peer.relay_error.connect(func(msg: String, fatal: bool): _fail(msg, fatal))
			peer.host_changed.connect(_on_host_changed)
			peer.host_back.connect(_on_host_back)
			multiplayer.multiplayer_peer = peer
			status.emit("Reconnecting to room %s…" % room_code)
		"ip":
			var pa := parse_address(_join_addr)
			var peer := ENetMultiplayerPeer.new()
			var err := peer.create_client(String(pa[0]), int(pa[1]))
			if err != OK:
				_fail("Couldn't start connecting to %s (error %d)." % [_join_addr, err])
				return
			multiplayer.multiplayer_peer = peer
			status.emit("Reconnecting to %s…" % _join_addr)
		"steam":
			if not steam_ok or lobby_id == 0:
				_fail("Steam isn't available.")
				return
			_steam_connect(lobby_id)   # still in the Steam lobby: just a new session to its host
			status.emit("Reconnecting to the Steam lobby…")
		_:
			_fail("Nothing to rejoin.")


func _save_rejoin_file() -> void:
	if transport == "ip" and is_host:
		return   # a direct-IP host that closes its game takes the match with it
	var d := {"t": Time.get_unix_time_from_system(), "ver": game_version(), "transport": transport, "room": room_code,
		"addr": _join_addr, "lobby": lobby_id, "secret": my_secret, "mid": match_id, "name": my_name, "mode": String(match_cfg.get("mode", ""))}
	var f := FileAccess.open(REJOIN_FILE, FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(d))
		f.close()


func _clear_rejoin_file() -> void:
	if FileAccess.file_exists(REJOIN_FILE):
		DirAccess.remove_absolute(REJOIN_FILE)


