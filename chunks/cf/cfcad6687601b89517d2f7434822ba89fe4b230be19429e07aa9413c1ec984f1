func _replay_mark(k: String, e: Dictionary) -> void:
	match k:
		"hdie":
			Replay.mark(sim.tick, "fight", "%s fell" % String(e.get("who", "A hero")))
		"boss":
			Replay.mark(sim.tick, "boss", String(e.get("name", "A boss")))
		"duel_start":
			Replay.mark(sim.tick, "duel", "Duel: %s vs %s" % [String(e.get("pa", "?")), String(e.get("pb", "?"))])
		"final_wave":
