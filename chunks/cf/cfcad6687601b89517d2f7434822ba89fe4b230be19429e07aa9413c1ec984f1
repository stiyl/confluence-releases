# Lobby extras: everyone's rank on their slot; a ranked lobby's fixed rules, blind pick and auto start.
func _ranked_lobby_refresh(l: Dictionary, me_slot: int) -> void:
	var rkd: Dictionary = l.get("ranked", {})
	if l.get("draft", {}).is_empty():
		for i in 8:
			var s: Dictionary = l["slots"][i]
			if s["kind"] != "human":
				continue
			var b: Button = lobby_slot_btns[i]
			var rt := Ranked.rk_text(String(s.get("rk", "")))
			if not rkd.is_empty() and String(rkd.get("mode", "")) == "1v1":
				var picked := bool(s.get("rk_pick", false))
				var mine := i == me_slot
				b.text = b.text.replace("choosing…", (("%s (only you see it)" % String(find_champ(net.rk_my_pick)["name"])) if mine and net.rk_my_pick not in ["", "random"] else ("random hero" if mine and net.rk_my_pick == "random" else "hero picked")) if picked else "choosing…")
			if rt != "":
				b.text += "  ·  " + rt
	if rkd.is_empty():
		return
	var r1 := String(rkd.get("mode", "")) == "1v1"
	lobby_title.text = Ranked.mode_name(String(rkd.get("mode", "")))
	lobby_info.text = "Matched by the relay  ·  %s  ·  rules fixed (Normal, no balance changes)" % Sim.MAPS[int(l.get("map", 0))]["name"]
	for arr in [lobby_mode_btns, lobby_map_btns, lobby_diff_btns, lobby_spec_btns]:
		for bb in arr:
			(bb as Button).disabled = true
	for i in 8:
		lobby_slot_btns[i].disabled = true
	if l.get("draft", {}).is_empty():
		lobby_go.disabled = true
		var missing := 0
		for tm in rkd.get("teams", []):
			missing += (tm as Array).size()
		for s in l["slots"]:
			if s["kind"] == "human":
				missing -= 1
		lobby_go.text = ("Waiting for %d more player%s…" % [missing, "" if missing == 1 else "s"]) if missing > 0 else ("Blind pick: choose your hero" if r1 else "The draft begins…")
		lobby_note.text = ("Blind pick: neither player sees the other's hero until the match starts (the same hero is allowed). %d s, then a random hero." % int(Net.RK_PICK_TIME)) if r1 else "Ranked 4v4: Classic rules with the pick / ban Draft. It starts once all eight players are in."
		if r1:
			for id in lobby_hero_btns:
				(lobby_hero_btns[id] as Button).disabled = false
				(lobby_hero_btns[id] as Button).set_pressed_no_signal(id == net.rk_my_pick)
		lobby_note.text += "  ·  Spectators watch %d s behind." % int(Net.RK_SPEC_DELAY)
