func fit(vp: Vector2) -> void:
	custom_minimum_size = Vector2(clampf(vp.x - 48.0, 860.0, 1120.0), 0)
	# ---- 0.44.1 polish ---- the list's height also leaves room for the card's own head, tabs and foot as they are
	# measured (they grow with Text size: at 150% on a 720-tall view the fixed 400 px left the card too tall, and the
	# whole card was shrunk to 87%)
	var h := vp.y - 400.0
	if is_inside_tree():
		var chrome: float = get_combined_minimum_size().y - scroll.get_combined_minimum_size().y
		h = minf(h, vp.y - 28.0 - chrome)
	scroll.custom_minimum_size = Vector2(0, clampf(h, 180.0, 560.0))


func select_tab(i: int, user := false) -> void:
	tab = clampi(i, 0, TABS.size() - 1)
	last_tab = tab
	if user:
		detail = -1
		main.audio.play("click", -10.0)
	refresh()


func cycle_tab(d: int) -> void:
	select_tab(posmod(tab + d, TABS.size()), true)


