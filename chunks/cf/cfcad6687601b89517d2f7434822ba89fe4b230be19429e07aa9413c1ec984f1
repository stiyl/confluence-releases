static func enabled() -> bool:
	if Updater.arg("no-telemetry") != "":
		return false
	Settings.ensure()
	if not Settings.share_data:
		return false
	if forced():
		return true
	return not (OS.has_feature("editor") or DisplayServer.get_name() == "headless")


static func _base(def: String) -> String:
