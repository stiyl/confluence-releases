func _hero_val(id: String, key: String) -> float:
	var ph := Profile.hero(id)
	var tt := Profile.hero_tot(id)
	match key:
		"name": return 0.0
		"mastery": return float(ph["xp"])
		"games": return float(_plays(id))
		"winrate": return (float(ph["wins"]) / float(ph["games"])) if int(ph["games"]) > 0 else -1.0
		"kills": return float(ph.get("kills", 0))
		"deaths": return (float(tt["dt"]) / float(tt["hg"])) if int(tt["hg"]) > 0 else -1.0
		"dmg": return (float(tt["dmg"]) / float(tt["hg"])) if int(tt["hg"]) > 0 else -1.0
		"items": return float(tt["it"].size())
	return 0.0


func _page_heroes() -> void:
	_note("Click a column to sort. Deaths and damage are per match, counted from 0.43 on. Mastery 2, 3, 5 and 7 unlock skins.")
	var head: HBoxContainer = main.hbox(8)
	head.add_child(_spacer(38))
