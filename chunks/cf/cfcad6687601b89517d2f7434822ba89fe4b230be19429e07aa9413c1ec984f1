static func steam_app_id() -> int:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--steam-appid="):
			return int(a.substr(14))
	var e := OS.get_environment("CONFLUENCE_STEAM_APPID")
	return int(e) if e.is_valid_int() else STEAM_APP_ID


func _init_steam() -> void:
	if not Engine.has_singleton("Steam"):
		steam_note = "GodotSteam isn't installed in this build."
		steam_libs_missing = steam_libs_expected()
		if steam_libs_missing:
			steam_note = "This game folder has no Steam libraries (it came from an older download). Download the new zip for Steam support."
			_log(steam_note)
		return
	var app_id := steam_app_id()
	# 0.35.1: always our app id. Launched as a "non-Steam game" shortcut, Steam fills SteamAppId / SteamGameId with the
	# shortcut's own id (or 0), and the Steam API then refused to start - no Steam friends, no lobbies. A real Steam
	# launch of our own app sets the same id we put here, so overriding is always right.
	var was := OS.get_environment("SteamAppId")
	if was != str(app_id):
		if was != "":
			_log("Steam: launched with SteamAppId=%s (a non-Steam shortcut?) - using %d" % [was, app_id])
		OS.set_environment("SteamAppId", str(app_id))
		OS.set_environment("SteamGameId", str(app_id))
	steam = Engine.get_singleton("Steam")
	# 4.15: steamInitEx(app_id) -> {"status": 0 ok / 1 failed / 2 no Steam client / 3 version mismatch, "verbal"}
	var res = steam.steamInitEx(app_id)
	var st := int(res.get("status", 1)) if res is Dictionary else (0 if res else 1)
	if st != 0:
		var verbal := String(res.get("verbal", "")) if res is Dictionary else str(res)
		var low := verbal.to_lower()
		if st == 3:
			steam_note = "Steam needs an update (%s)." % verbal
		elif st == 2 or low.contains("steamclient") or low.contains("running") or low.contains("no steam"):
			steam_note = "Steam isn't running. Start Steam, then the game (%s)." % verbal
		else:
			steam_note = "Steam wouldn't start for this game (%s)." % verbal
		_log("Steam not available: %s [SteamAppId was %s]" % [str(res), was])
		steam = null
		return
	steam_ok = true
	steam_id = int(steam.getSteamID())
	steam_name = String(steam.getPersonaName())
	if my_name == "Player" and steam_name != "":
		my_name = steam_name   # only until the profile name is known (account.gd sets it); the profile name is who we are
	steam_deck = steam.has_method("isSteamRunningOnSteamDeck") and bool(steam.isSteamRunningOnSteamDeck())
	if steam.has_method("initRelayNetworkAccess"):
		steam.initRelayNetworkAccess()   # Steam Datagram Relay: no port forwarding, IPs stay hidden
	steam.lobby_created.connect(_on_steam_lobby_created)
	steam.lobby_joined.connect(_on_steam_lobby_joined)
	steam.lobby_chat_update.connect(_on_steam_lobby_chat_update)
	# an invite accepted in the overlay / Steam chat while the game runs
	steam.join_requested.connect(func(lid, _friend): join_steam(int(lid)))
	# "Join Game" on a friend in the Steam friends list (rich presence "connect" = "+connect_lobby <id>")
	if steam.has_signal("join_game_requested"):
		steam.join_game_requested.connect(func(_friend, connect_str):
			var lid := _lobby_from_args(String(connect_str).split(" ", false))
			if lid != 0:
				join_steam(lid))
	_log("Steam on: app %d, %s%s" % [app_id, steam_name, " (Steam Deck)" if steam_deck else ""])
	# launched from a friend's invite / Join Game while the game was closed: +connect_lobby <id>
	var lid := _lobby_from_args(OS.get_cmdline_args())
	if lid == 0 and steam.has_method("getLaunchCommandLine"):
		lid = _lobby_from_args(String(steam.getLaunchCommandLine()).split(" ", false))
	if lid != 0:
		call_deferred("join_steam", lid)


