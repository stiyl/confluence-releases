		end_side.add_child(lbl("%s challenges complete!  +%d mastery XP%s" % [tn, Profile.CH_XP[maxi(0, ti)], ("  ·  new title: %s" % Profile.hero_title(hid)) if ti == Profile.CH_TIERS.size() - 1 else ""], 15, Color(Profile.CH_COLS[maxi(0, ti)]), true, 2))
