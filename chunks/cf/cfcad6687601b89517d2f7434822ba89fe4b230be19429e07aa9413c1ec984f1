		cb.pressed.connect(func():
			DisplayServer.clipboard_set(code)
			cb.text = "Copied!")
		cr.add_child(cb)
		box.add_child(cr)
	var pr := hbox(6)
	var pe := LineEdit.new()
	pe.placeholder_text = "Paste a friend's code (CW-...)"
	pe.size_flags_horizontal = SIZE_EXPAND_FILL
	pe.custom_minimum_size = Vector2(0, 30)
	pr.add_child(pe)
	var pbn := Button.new()
	pbn.text = "Add"
	pbn.focus_mode = FOCUS_NONE
	pbn.pressed.connect(func():
		var err := Profile.add_weekly_friend(pe.text)
		var e2 := Profile.parse_weekly_code(pe.text)
		if err == "":
			Profile.add_stat("codes")
			award("friend_code")
