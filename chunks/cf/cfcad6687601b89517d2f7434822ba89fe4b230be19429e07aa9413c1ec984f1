		_refresh_spec_bar()   # 0.44
	var me = sim.players[sim.local]
	var c = me.champ
	round_lbl.text = "Round %d   ·   Next wave %ds   ·   Income in %ds" % [sim.round_no, ceili(sim.round_len - sim.round_t), ceili(sim.income_t)]
	if sim.final_round > 0:
		if sim.round_no >= sim.final_round:
			round_lbl.text = "THE LAST WAVE   ·   %d monsters left, then the healthier crystal wins   ·   %s" % [sim.final_left, "No more income" if sim.income_per_round else "Income in %ds" % ceili(sim.income_t)]
