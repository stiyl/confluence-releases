# The attribute column an item goes in: the attribute it mostly raises, or for a plain stat item the
# attribute that stat suits (health/armor -> Might, cooldowns/regen -> Resolve, speed/crit/on-hit -> Cunning);
# items that raise all three equally, or only gold, are General.
const STAT_ATTR := {"hp": "mig", "armor": "mig", "dmg": "mig", "ls": "mig", "regen": "res", "cdr": "res", "ap": "res",
	"as": "cun", "crit": "cun", "ms": "cun", "onhit": "cun"}


static func item_attr(it: Dictionary) -> String:
	if it.has("attr"):
		return String(it["attr"])   # 0.34.1: an item can name its column (Dragon's Hoard is General)
	var best := "gen"
	var bv := 0.0
	var tie := false
	for a in ["mig", "res", "cun"]:
		var v := float(it.get(a, 0.0))
		if v > bv:
			best = a
			bv = v
			tie = false
		elif v == bv and v > 0.0:
			tie = true
	if tie:
		return "gen"
	if bv > 0.0:
		return best
	for k in it:
		if STAT_ATTR.has(k):
			return STAT_ATTR[k]
	return "gen"


