# The match's standout moments, best first: the biggest kill burst, a crystal that held on by a thread, contests won,
# bosses slain, duels. Each has a Watch button that opens the replay a few seconds before it.
const HL_MAX := 5


static func highlight_list(p_sim) -> Array:
	var out: Array = []
	var names := func(pid: int) -> String:
		if pid < 0 or pid >= p_sim.players.size():
			return ""
		var pl = p_sim.players[pid]
		return "%s (%s)" % [pl.name, String(pl.champ.def["name"]).split(" ")[0]] if pl.champ != null else String(pl.name)
	# the biggest kill burst
	var bb = null
	for pl in p_sim.players:
		if not pl.absent and (bb == null or pl.burst_best > bb.burst_best):
			bb = pl
	if bb != null and bb.burst_best >= 8:
		out.append({"score": 50 + bb.burst_best, "tick": bb.burst_tick, "team": bb.team,
			"text": "%s cut down %d monsters in %d seconds" % [names.call(bb.id), bb.burst_best, int(Sim.BURST_T)]})
	# a crystal that held on (the winner's, or both when nobody won)
	for ti in 2:
		if float(p_sim.core_low[ti]) < 0.2 and float(p_sim.core_low[ti]) > 0.0 and (p_sim.winner == ti or p_sim.winner < 0):
			out.append({"score": 90, "tick": int(p_sim.core_low_tick[ti]), "team": ti,
				"text": "The %s crystal held at %d%% and %s" % [Sim.TEAM_NAMES[ti], maxi(1, roundi(float(p_sim.core_low[ti]) * 100.0)), "won the match" if p_sim.winner == ti else "kept standing"]})
	var seen_boss := {}
	for h in p_sim.highlights:
		if String(h["k"]) == "boss":
			# a boss down both rifts is one moment: the first kill of it that round
			var bk := "%s|%d" % [h["name"], int(h["round"])]
			if seen_boss.has(bk):
				continue
			seen_boss[bk] = true
		match String(h["k"]):
			"contest":
				out.append({"score": 40, "tick": int(h["tick"]), "team": int(h["team"]),
					"text": "%s won %s in %d seconds (round %d)" % [Sim.TEAM_NAMES[int(h["team"])], h["name"], roundi(float(h.get("secs", 0.0))), int(h["round"])]})
			"boss":
				if int(h["pid"]) >= 0:
					out.append({"score": 30 + int(h["round"]) * 0.2, "tick": int(h["tick"]), "team": int(h["team"]),
						"text": "%s landed the killing blow on %s (round %d)" % [names.call(int(h["pid"])), h["name"], int(h["round"])]})
			"duel":
				out.append({"score": 25, "tick": int(h["tick"]), "team": int(h["team"]),
					"text": "%s won the round %d duel against %s" % [names.call(int(h["pid"])), int(h["round"]), h["name"]]})
	out.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]) or (float(a["score"]) == float(b["score"]) and int(a["tick"]) < int(b["tick"])))
	return out.slice(0, HL_MAX)


func _highlights() -> Control:
	if not ("highlights" in sim):
