func _talent_card(hero: String, t: Dictionary, taken: Array, pts: int) -> Control:
	var has := taken.has(t["id"])
	var why := TalentData.why_not(hero, taken, t["id"], pts)
	var can := why == ""
	var b := Button.new()
	b.focus_mode = FOCUS_NONE
	var cap: bool = int(t["tier"]) == 4
	b.custom_minimum_size = Vector2(120, [0, 96, 150, 132, 96][int(t["tier"])])
	b.size_flags_horizontal = SIZE_EXPAND_FILL
	var border := GOLD_HOT if has else (Color(0.85, 0.6, 1.0) if can else Color(0.35, 0.32, 0.3))
	var bg := Color(0.24, 0.17, 0.06) if has else Color(0.08, 0.07, 0.06)
	b.add_theme_stylebox_override("normal", sb(bg, border, 6, 3 if has or cap else 2, 8))
	b.add_theme_stylebox_override("hover", sb(bg.lightened(0.1), border.lightened(0.2), 6, 3, 8))
	b.add_theme_stylebox_override("pressed", sb(bg, border, 6, 3, 8))
	var v := vbox(3)
	v.set_anchors_and_offsets_preset(PRESET_FULL_RECT, PRESET_MODE_MINSIZE, 10)
	v.mouse_filter = MOUSE_FILTER_IGNORE
	var nm := lbl(String(t["name"]) + ("  ·  %d pts" % TalentData.cost(t) if TalentData.cost(t) > 1 else ""), 15, GOLD if has else (TEXT if can else MUTED), true)
	nm.mouse_filter = MOUSE_FILTER_IGNORE
	v.add_child(nm)
	var ds := lbl(String(t["desc"]), 12, TEXT if has or can else MUTED, true)
	ds.mouse_filter = MOUSE_FILTER_IGNORE
	v.add_child(ds)
	if not has and not can and int(t["tier"]) != 2:
		var wl := lbl(why, 11, Color(1.0, 0.6, 0.45), true)
		wl.mouse_filter = MOUSE_FILTER_IGNORE
		v.add_child(wl)
	b.add_child(v)
	b.tooltip_text = String(t["desc"]) + ("\n(taken: click to refund)" if has else ("\n" + why if why != "" else "\nClick to take"))
	var id: String = t["id"]
	b.pressed.connect(func():
		var cur: Array = Profile.talents_taken(hero)
		if cur.has(id):
			Profile.set_talents(hero, TalentData.without(hero, cur, id))
		elif TalentData.why_not(hero, cur, id, Profile.talent_points(hero)) == "":
			var nt := cur.duplicate()
			nt.append(id)
			Profile.set_talents(hero, nt)
		_render_talents())
	return b



