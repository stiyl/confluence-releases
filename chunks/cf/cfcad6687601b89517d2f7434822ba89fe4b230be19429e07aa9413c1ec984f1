func _exit_tree() -> void:
	# a clean quit: the session did not crash
	if FileAccess.file_exists(FLAG_PATH):
		DirAccess.remove_absolute(ProjectSettings.globalize_path(FLAG_PATH))
	if enabled():
		_save_queue()
	if _instance == self:
		_instance = null


func _process(delta: float) -> void:
	if not enabled():
		if not _off:
			_off = true
			_drop_waiting()   # switched off: nothing waiting goes out, and no crash report for this session
		return
	if _off:
		_off = false          # switched back on
		_write_flag()
	if not _se_busy and not sentry_out.is_empty():
		_send_sentry(sentry_out.pop_front())
	_wait -= delta
	if _wait <= 0.0:
		_wait = FLUSH_SEC
		flush()


# ---------------------------------------------------------------- usage events (PostHog)
func track(event: String, props := {}) -> void:
	if not enabled():
		return
	if anon_id == "":
		_load_id()   # turned on during the session
	var p := props.duplicate()
	p["distinct_id"] = anon_id
	p["$process_person_profile"] = false
	p["$session_id"] = _session_id
	p["$lib"] = "confluence"
	p["app_version"] = version()
	p["os"] = OS.get_name()
	if OS.has_feature("editor"):
		p["dev"] = true   # dev / test runs: dashboards leave these out
	queue.append({"event": event, "timestamp": _iso_now(), "properties": p})
	while queue.size() > QUEUE_MAX:
		queue.pop_front()


func flush() -> void:
	if _ph_inflight > 0 or queue.is_empty() or not enabled():
		return
	var n := mini(BATCH_MAX, queue.size())
	var body := JSON.stringify({"api_key": POSTHOG_KEY, "batch": queue.slice(0, n)})
	if _ph.request(_base(POSTHOG_URL) + "/batch/", ["Content-Type: application/json"], HTTPClient.METHOD_POST, body) == OK:
		_ph_inflight = n


func _on_ph_done(result: int, code: int, _h: PackedStringArray, _b: PackedByteArray) -> void:
	var n := _ph_inflight
	_ph_inflight = 0
	if result == HTTPRequest.RESULT_SUCCESS and code >= 200 and code < 300:
		queue = queue.slice(mini(n, queue.size()))
		_wait = 1.0 if not queue.is_empty() else FLUSH_SEC
	elif result == HTTPRequest.RESULT_SUCCESS and code >= 400 and code < 500:
		queue = queue.slice(mini(n, queue.size()))   # rejected: retrying would never work
		print("[telemetry] usage batch rejected (HTTP %d)" % code)
	else:
		_wait = RETRY_SEC


