func human_buyback() -> void:
	if sim == null or sim.over or replay_mode:
		return
	var why = act("buyback")
	if why is String and why != "" and why != "sent" and why != "none" and why != "ok":
		show_error(why)


func update_death() -> void:
	var me = sim.players[sim.local]
	var c = me.champ
	var dead: bool = c.dead and not sim.over
	death_box.visible = dead
	arena_view.modulate = Color(0.62, 0.6, 0.66) if dead and my_view() else Color.WHITE
	if dead:
		death_sub.text = "Back at your crystal in %d seconds" % ceili(c.respawn)
		if death_tip != null and not was_dead:   # ---- 0.45 codex ---- a tip while you wait
			death_tip.text = "TIP  ·  " + TipsData.loading_tip(_codex_ctx()) if Settings.tips and game_mode not in ["tutorial", "campaign"] and not replay_mode else ""
		if sim.mode == "survival":
			death_sub.text += "  ·  the run is over" if sim.surv_lives <= 0 else ""
		var cost: int = sim.buyback_cost(me)
		if me.bb_cd > 0:
			buyback_btn.text = "Buy-back ready in %ds" % ceili(me.bb_cd)
			buyback_btn.disabled = true
		else:
			buyback_btn.text = "Buy back now (%s)  ·  %d gold" % [Settings.key_name("buyback"), cost]
			buyback_btn.disabled = me.gold < cost
		if arena_view.death_cam <= 0 and arena_view.follow == false and my_view():
			pass
	if was_dead and not c.dead:
		center_on_hero()
	was_dead = c.dead


