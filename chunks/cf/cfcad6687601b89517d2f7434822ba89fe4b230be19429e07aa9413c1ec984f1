# Announcements are a short queue: each shows for its time; a round announcement (priority 0) never
# overwrites a boss, omen or duel announcement that arrived in the same step, and is dropped first when
# the queue is full.
func announce(title: String, sub := "", prio := 1, secs := 3.2) -> void:
	if announce_t > 0.0 and prio > announce_prio:
		# something more important interrupts a plain round announcement
		if announce_prio == 0:
			announce_q.push_front([announce_lbl.text, announce_sub.text, minf(announce_t, 1.5), announce_prio])
		_show_announce([title, sub, secs, prio])
		return
	if announce_t <= 0.0 and announce_q.is_empty():
		_show_announce([title, sub, secs, prio])
		return
	if prio == 0:
		# only one round announcement waits at a time
		for i in range(announce_q.size() - 1, -1, -1):
			if int(announce_q[i][3]) == 0:
				announce_q.remove_at(i)
	announce_q.append([title, sub, secs, prio])
	while announce_q.size() > 3:
		var drop := 0
		for i in announce_q.size():
			if int(announce_q[i][3]) < int(announce_q[drop][3]):
				drop = i
		announce_q.remove_at(drop)


func _show_announce(a: Array) -> void:
	announce_lbl.text = a[0]
	announce_sub.text = a[1]
	announce_t = float(a[2])
	announce_prio = int(a[3])


