			bl.append("%s  ·  %ds" % [Sim.CAMP_KINDS[k]["bless"], ceili(my_ar.bless[k])])
	if bl.is_empty() and sim.mode != "survival":
		var soon := -1
		for ci in my_ar.camps_t.size():
			if my_ar.camps_t[ci] > 0 and not my_ar.camps_up[ci] and (soon < 0 or my_ar.camps_t[ci] < my_ar.camps_t[soon]):
				soon = ci
		if soon >= 0:
			bl.append("%s: back in %ds" % [Sim.CAMP_KINDS[Sim.CAMPS[soon]["kind"]]["name"], ceili(my_ar.camps_t[soon])])
	bless_lbl.text = "\n".join(bl)
	var bar_ar = sim.view_arena(arena_view.arena_idx)
	if bar_ar.duel:
		bar_ar = sim.arenas[myt()]
	var boss = sim.lead_boss(bar_ar)   # boss rounds send one down each rift: the bar tracks the one furthest along
	boss_box.visible = false   # 0.16: the boss bars moved to the top centre (EventHud.BossBars); the old top-left bar stays off
	if boss_box.visible:
		var bname := String(boss.d.get("name", GameData.MON.get(boss.kind, {}).get("name", "Boss")))
		var more: int = bar_ar.mons.filter(func(o): return not o.dead and o != boss and o.d.get("boss", false)).size()
		boss_name_lbl.text = "%s%s  ·  %s lane" % [bname, ("  +%d more" % more) if more > 0 else "", "your" if bar_ar.team == myt() or sim.mode == "survival" else "enemy"]
		boss_bar.max_value = boss.max_hp
		boss_bar.value = boss.hp
	update_selection_panel()
	for i in 4:
		var b: UIParts.CmdButton = skill_btns[i]
		var kind := skill_kind(c.def["skills"][i])
		if b.icon_kind != kind:
			b.icon_kind = kind   # survival: the slot was just filled from a card
			b.queue_redraw()
		var cd: float = maxf(0.0, c.cds[i])
		var tot: float = maxf(0.1, sim.skill_cd(c, i))
		b.cd_frac = minf(1.0, cd / tot) if cd > 0 else 0.0
		b.cd_text = ("%.1f" % cd if cd < 10 else str(ceili(cd))) if cd > 0 else ""
		if c.def["skills"][i].get("always", false):
			b.cd_text = "ON" if c.ranks[i] > 0 else ""   # 0.27.1: an always-on aura
		b.unusable = c.dead
		b.rank = c.ranks[i]
		b.danger = i == 3 and sim.is_cultist(c) and c.ranks[3] > 0 and not sim.cult_ready(c)   # 0.34: Inevitable Demise would kill him
		var can: bool = sim.can_learn(c, i)
		b.learnable = can
		learn_btns[i].visible = can and not spectating   # (0.44: not a spectator's to spend)
	var ic = inv_hero()
	var other: bool = ic != c
	inv_owner_lbl.text = ("%s's items" % String(ic.def["name"]).split(" ")[0]) if other else ""
	inv_owner_lbl.add_theme_color_override("font_color", (WARD.lightened(0.3) if ic.pl.team == myt() else ENEMY_TXT) if other else GOLD)
	for slot in inv_btns.size():
		var ib: UIParts.CmdButton = inv_btns[slot]
		ib.visible = slot < sim.inv_slots()   # 0.44: the Thrift twist holds three
		ib.icon_kind = ("item:" + ic.items[slot]) if slot < ic.items.size() else "empty"
		ib.gold_frame = slot < ic.items.size() and int(GameData.item(ic.items[slot])["tier"]) >= 3
		ib.selected = slot == swap_from and not other
		var has_act: bool = slot < ic.items.size() and GameData.item(ic.items[slot]).has("act")
		ib.hotkey = Settings.key_name("item%d" % (slot + 1)) if has_act and not other else ""
		if Settings.pad_on and pad != null and has_act and not other:
			var an: int = pad.active_slots().find(slot)   # 0.29: the d-pad uses the first / second active, in bag order
			ib.hotkey = Settings.pad_name("item%d" % (an + 1)) if an >= 0 and an < 2 else ""
		if has_act:
			var iid: String = ic.items[slot]
			var acd: float = float(ic.act_cd.get(iid, 0.0))
			var tot: float = float(GameData.item(iid)["act"]["cd"])
			ib.cd_frac = clampf(acd / tot, 0.0, 1.0) if acd > 0 else 0.0
			ib.cd_text = (str(ceili(acd)) if acd > 0 else "")
			ib.unusable = ic.dead
		else:
			ib.cd_frac = 0.0
			ib.cd_text = ""
			ib.unusable = false
	shop_btn.add_theme_color_override("font_color", GOLD if sim.near_shop(c) else TEXT)
	potion_btn.badge = "×%d" % c.potions if c.potions > 0 else ""
	potion_btn.unusable = c.potions <= 0 or c.dead
	potion_btn.cd_frac = c.pot_t / Sim.POTION_DUR if c.pot_t > 0 else 0.0
	refresh_shop()
	refresh_core()
	var mine_by_kind := {}
	var lane_n := [0, 0]
	for q in sim.arenas[1 - myt()].queued:
		if q[2] == me:
			mine_by_kind[q[0]] = int(mine_by_kind.get(q[0], 0)) + 1
			lane_n[q[1]] += 1
	var total: int = lane_n[0] + lane_n[1]
	queued_lbl.text = ("%d queued  (N %d · S %d)" % [total, lane_n[0], lane_n[1]]) if total > 0 else ("no sends in this chapter" if int(sim.max_tech[me.team]) <= 0 else ("build a Warren (%s)" % Settings.key_name("build1") if me.tech == 0 else "nothing queued"))
	queued_lbl.add_theme_color_override("font_color", GOOD if total > 0 else MUTED)
	if unsend_btn != null:
		unsend_btn.visible = total > 0 and sim.mode != "survival" and not replay_mode
	for slot in send_btns.size():
		var k := send_index(slot)
		var cost := sim.send_cost(k, myt())
		var s: Dictionary = GameData.SENDS[k]
		var unlocked := Sim.send_unlocked(me, k)
		send_btns[slot].corner = str(cost) if unlocked else ""
		send_btns[slot].locked = not unlocked
		send_btns[slot].unusable = me.gold < cost or not sim.send_income_ok(me, k)
		var qn: int = int(mine_by_kind.get(s["k"], 0)) / maxi(1, int(s["n"]))
		send_btns[slot].badge = ("×%d" % qn) if qn > 0 else ""
		send_btns[slot].mark = ""   # traits are in the hover tooltip; no tag on the button face
		send_btns[slot].gold_frame = unlocked and bool(s.get("power", false))   # power sends: cost income, much stronger
	for k in bld_btns.size():
		var b: UIParts.CmdButton = bld_btns[k]
		b.gold_frame = k < me.tech and k == send_tab
		b.locked = k > me.tech
		b.unusable = k == me.tech and me.gold < Sim.building_cost(k)
		b.corner = "" if k < me.tech else str(Sim.building_cost(k))
		b.badge = "✓" if k < me.tech else ""
	if tip_source != null and tooltip.visible:
		if tip_source is Control and tip_source.has_meta("stat_tip"):
			show_stat_tip(tip_source, tip_source.get_meta("stat_tip"))
		var bi := bld_btns.find(tip_source)
		if bi >= 0:
			show_build_tip(bi)
		var idx := send_btns.find(tip_source)
		if idx >= 0:
			show_send_tip(send_index(idx))
		var si := skill_btns.find(tip_source)
		if si >= 0:
			show_skill_tip(si)
	if arena_view.arena_idx == 2:
		status_lbl.text = ""   # 0.24: no "Watching the duel" line; 0.38.1: no "DUEL! Defeat … right-click to attack" hint either
	elif arena_view.arena_idx == lane_idx(1):
		status_lbl.text = "Looking at the " + team_name(1 - myt()) + "'s lane  ·  click any unit to inspect it  ·  %s to return" % Settings.key_name("center")
		status_lbl.add_theme_color_override("font_color", EMBER)
	else:
		status_lbl.text = ""
	view_btn.gold_frame = arena_view.arena_idx == lane_idx(1)
	follow_btn.gold_frame = arena_view.follow and my_view() and arena_view.follow_obj == c
	# message log
	# 0.47.2 (art audit item 10): match lines stay 8 s (fading from 6 s), at most 4 of them, and a player's repeated
	# builds of one building merge into one line ("Cinder Host built 4 Ossuaries"). Chat keeps its 12 s.
	var lines: Array = []
	var built_at := {}
	for fd in sim.feed:
		var age: float = sim.t - float(fd.get("t", 0.0))
		if age > FEED_LIFE:
			break
		if fd.has("what"):
			continue          # sends aren't listed: only buildings, crystal upgrades and big moments
		if fd.has("built"):
			var bk := "%s|%s" % [fd["who"], fd["built"]]
			if built_at.has(bk):
				lines[built_at[bk]][2] += 1
				continue
			built_at[bk] = lines.size()
		lines.append([fd, age, 1])
	if lines.size() > FEED_LINES:
		lines.resize(FEED_LINES)
	if mp() or not mp_chat.is_empty():
		# online chat ages in real time (it isn't part of the match), and stays up a little longer (0.30: whispers too)
		var nowm := Time.get_ticks_msec()
		for ch in mp_chat:
			var ca: float = (nowm - int(ch[1])) / 1000.0 * 12.0 / 20.0
			if ca <= 12.0:
				lines.append([{"mpchat": ch[0], "team": 0}, ca, 1])
		lines.sort_custom(func(a, b): return a[1] < b[1])
	for i in log_lbls.size():
		var l: Label = log_lbls[log_lbls.size() - 1 - i]
		if i < lines.size():
			var fd: Dictionary = lines[i][0]
			var age: float = lines[i][1]
			var ours: bool = fd["team"] == 0
			if fd.has("mpchat"):
				l.text = String(fd["mpchat"])
			elif fd.has("built"):
				var nb: int = lines[i][2]
				if nb > 1:
					l.text = "%s built %d %s" % [fd["who"], nb, _plural(String(fd["built"]))]
				else:
					l.text = "%s built %s %s" % [fd["who"], "an" if "AEIOU".contains(String(fd["built"]).left(1)) else "a", fd["built"]]   # 0.41: "an Ossuary"
			elif fd.has("contest"):
				l.text = "%s %s %s (+%d gold each)" % [fd["who"], "won" if fd.get("first", false) else "finished", Sim.CONTESTS[String(fd["contest"])]["name"], fd["gold"]]
			elif fd.has("camp"):
				l.text = "%s cleared the %s (+%d gold each)" % [fd["who"], Sim.CAMP_KINDS[String(fd.get("kind", "ancient"))]["name"], fd["camp"]]
			elif fd.has("chat"):
				l.text = "%s: %s" % [fd["who"], fd["chat"]]
			elif fd.has("duel"):
				l.text = "%s won the duel against %s  (+%d gold)" % [fd["who"], fd["duel"], fd["gold"]]
			elif fd.has("boss"):
				l.text = "%s slew %s" % [fd["who"], fd["boss"]]
			elif fd.has("core"):
				l.text = "%s upgraded %s crystal: %s %d" % [fd["who"], "your" if ours else "their", fd["core"], fd["lv"]]
			else:
				l.text = "%s will send %s through %s %s rift next wave" % [fd["who"], fd["what"], "the enemy's" if ours else "your", "south" if fd["lane"] == 1 else "north"]
			l.add_theme_color_override("font_color", Color(1.0, 0.93, 0.7) if fd.has("mpchat") else (WARD.lightened(0.2) if ours else ENEMY_TXT))
			l.modulate.a = clampf((12.0 - age) / 3.0, 0.0, 1.0) if fd.has("mpchat") else clampf((FEED_LIFE - age) / (FEED_LIFE - FEED_FADE), 0.0, 1.0)
			l.visible = true
		else:
			l.text = ""
			l.visible = false
	# scoreboard (0.18: the plaque draws its own rows; income is per round from pl.income)
	board.refresh(selected())


const FEED_LIFE := 8.0     # 0.47.2: seconds a match line stays in the message log
const FEED_FADE := 6.0     # it starts fading here
const FEED_LINES := 4      # at most this many match lines (chat can add more)


# "Ossuary" -> "Ossuaries", "Forge" -> "Forges", "Beast Warren" -> "Beast Warrens"
static func _plural(n: String) -> String:
	if n.ends_with("y") and not "aeiou".contains(n.substr(n.length() - 2, 1)):
		return n.left(n.length() - 1) + "ies"
	if n.ends_with("s") or n.ends_with("x") or n.ends_with("ch") or n.ends_with("sh"):
		return n + "es"
	return n + "s"


func show_end() -> void:
	show_end_screen()

# ---------------------------------------------------------------- sound, alerts and pings
const CAST_SOUNDS := {"shot": "cast_zap", "chain": "cast_zap", "beam": "cast_zap", "bounce": "cast_zap", "storm": "cast_zap",
	"blast": "cast_fire", "burn": "cast_fire", "rain": "cast_fire", "cone": "cast_fire", "volatile": "cast_fire",
	"nova": "cast_wave", "zone": "cast_wave", "pull": "cast_wave", "knock": "cast_wave", "chill": "cast_wave",
	"buff": "cast_buff", "heal": "cast_buff", "team": "cast_buff", "auraheal": "cast_buff", "thorns": "cast_buff", "siphon": "cast_buff",
	"summon": "cast_summon", "dash": "cast_dash", "blink": "cast_dash"}


func _heard(e: Dictionary) -> bool:
	return int(e["a"]) == arena_view.arena_idx and arena_view.world_view_rect().grow(260).has_point(e["p"])


func push_alert(kind: String, text: String, col: Color, cd := 8.0, sound := "alert") -> void:
	if float(alert_cd.get(kind, 0.0)) > 0.0:
		return
	alert_cd[kind] = cd
	if sound != "":
		audio.play(sound, -2.0)
	if not Settings.alerts:
		return
	var l := lbl(text, 17, col, true, 5)
	l.add_theme_font_override("font", display_font)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	alert_box.add_child(l)
	alerts.append([l, 4.5])
	while alerts.size() > 4:
		alerts[0][0].queue_free()
		alerts.remove_at(0)


func handle_events() -> void:
	var me = sim.players[sim.local]
	var hc = me.champ
	for e in sim.events:
		var k: String = e["k"]
		if Replay.recording:
			_replay_mark(k, e)   # 0.48 Replay theatre: the moments the timeline jumps to
		# extra sounds for any event live in GameAudio.on_event (the audio team's hook)
		audio.on_event(k, e, me.team, _heard(e))
		subtitles.on_event(k, e, me.team)   # 0.43 (access): captions (scripts/subtitles.gd)
		match k:
			"ping":
				on_ping_event(e)
			"swing":   # 0.16: the melee-swing cue (was "hit"; "hit" is now the damage event, see sim.emit_hit)
				if e.get("human", false) or _heard(e):
					var sw := "atk_" + String(e.get("hero", ""))   # 0.36: a melee hero's own swing when it has one (Vasska)
					if audio.has_sound(sw):
						audio.play(sw, -2.0 if e.get("human", false) else -9.0, "hit", 0.08)
					else:
						audio.play("hit%d" % (randi() % 3 + 1), 0.0 if e.get("human", false) else -7.0, "hit")
			"hit":     # a blow landed (dmg, crit, abil, src, to, pid, vic_pid): numbers, hit-stop, flash (Juice) and the crit thunk
				if int(e["a"]) == arena_view.arena_idx:
					arena_view.juice.on_hit(e, sim.local, sim.view_arena(arena_view.arena_idx))
				if e.get("crit", false) and (int(e.get("pid", -1)) == sim.local or int(e.get("vic_pid", -1)) == sim.local or _heard(e)):
					audio.play("crit_thunk", -3.0 if int(e.get("pid", -1)) == sim.local else -9.0, "crit", 0.08)
			"shoot":
				if e.get("human", false) or _heard(e):
					var atk := "atk_" + String(e.get("hero", ""))
					if audio.has_sound(atk):
						audio.play(atk, -2.0 if e.get("human", false) else -9.0, "shoot", 0.08)
					else:
						audio.play("shoot%d" % (randi() % 2 + 1), -1.0 if e.get("human", false) else -8.0, "shoot")
			"cast":
				arena_view.on_cast(e)
				if e.get("human", false) or _heard(e):
					var v := 0.0 if e.get("human", false) else -6.0
					# a dedicated sound per ability when it exists (it carries an ult's weight itself);
					# otherwise the generic family for the ability's action, plus a boom under an ult
					var ab := audio.ability_sound(String(e.get("vis", "")))
					if ab != "":
						audio.play(ab, v, "cast", 0.03)
					else:
						audio.play(CAST_SOUNDS.get(e["t"], "cast_fire"), v, "cast")
						if e.get("ult", false):
							audio.play("boom", v - 4.0, "boom")
			"mhit":
				if _heard(e):
					if e.get("big", false):
						audio.play("hit_heavy", -6.0, "mhit")
					else:
						audio.play("hit%d" % (randi() % 3 + 1), -13.0, "mhit", 0.15)
			"mshoot":
				if _heard(e):
					var msnd := audio.mshot_sound(String(e.get("kind", "")))
					if audio.has_sound(msnd):
						audio.play(msnd, -7.0, "mshot", 0.1)
					else:
						audio.play("shoot2", -12.0, "shoot", 0.15)
			"mphit":
				# a monster bolt striking a hero: louder when it is your hero
				if e.get("human", false) or _heard(e):
					audio.play("mshot_hit", -4.0 if e.get("human", false) else -10.0, "mhit", 0.12)
			"abhit":
				# a rain strike or an exploding ability projectile landing (sound only)
				if e.get("human", false) or _heard(e):
					var hs := audio.ability_sound(String(e.get("vis", "")), "abhit_")
					if hs != "":
						var small: bool = e.get("small", false)
						var hv := (0.0 if e.get("human", false) else -6.0) - (2.0 if small else 3.0)
						audio.play(hs, hv, "abhit" if small else "boom", 0.08)
			"mdie":
				if _heard(e):
					if e.get("big", false):
						audio.play("mdie_big", -3.0, "mdie")
						arena_view.add_shake(2.5)
					else:
						audio.play("mdie%d" % (randi() % 2 + 1), -8.0, "mdie", 0.12)
				if int(e.get("by_pid", -1)) == sim.local:
					# your kill: its own confirm, by size (the boss one rides under boss_down's stinger)
					var kboss: bool = GameData.MON.get(String(e.get("kind", "")), {}).get("boss", false)
					audio.play("kill_boss" if kboss else ("kill_big" if e.get("big", false) else "kill_small"), -1.0 if kboss else (-3.0 if e.get("big", false) else -6.0), "kill", 0.05)
				if e.get("sent", false):
					event_hud.on_event(e)   # the send feed: whose send died, to whom
			"send_reach", "boss_warn", "duel_fight", "round_end", "wave_in":
				if not (sim.mk("blackout", 0.0) > 0.0 and String(e["k"]) in ["boss_warn", "wave_in"]):   # 0.44 Blackout twist: no wave warnings
					event_hud.on_event(e)   # 0.16 cards and feed lines (scripts/event_hud.gd)
			"vote_start", "vote_cast", "vote_result", "team_ready", "setup_end":
				vote_ui.on_event(e)   # 0.17 "start next round" vote card (scripts/vote_ui.gd)
			"explode", "boom":
				if e.get("human", false) or _heard(e):
					# a hero's delayed blast landing has its own payoff sound when one exists
					var bs := audio.ability_sound(String(e.get("vis", "")), "abhit_")
					if bs != "":
						audio.play(bs, -3.0 if e.get("human", false) else -8.0, "boom", 0.05)
					else:
						audio.play("boom", -5.0, "boom")
					arena_view.add_shake(4.0)
			# ---- 0.34 cultist ----
			"undying":
				# Undying Will caught the Cultist: a deep toll; your own hero also gets a jolt of shake
				if e.get("human", false) or _heard(e):
					audio.play("cult_undying", 0.0 if e.get("human", false) else -7.0, "boom", 0.03)
					if e.get("human", false):
						arena_view.add_shake(5.0)
			"cult_arm":
				if e.get("human", false):
					audio.play("cult_arm", -2.0, "click")   # "press again": a short warning bell
			# ---- end 0.34 cultist ----
			"growth":
				# 0.36 Vasska's Colossal Growth ranked up: the skin tears away with a rumble
				if e.get("human", false) or _heard(e):
					audio.play("vasska_growth", 0.0 if e.get("human", false) else -7.0, "boom", 0.03)
					if e.get("human", false):
						arena_view.add_shake(3.0)
			"interest":
				audio.play("coin", -2.0)
			"item":
				if e.get("human", false) or _heard(e):
					var snd: String = {"burst": "cast_zap", "thunder": "cast_zap", "firestorm": "cast_fire", "flight": "cast_dash", "shadowstep": "cast_dash", "golden": "coin", "recall": "cast_summon", "recall_done": "boon"}.get(e.get("act", ""), "cast_buff")
					audio.play(snd, 0.0 if e.get("human", false) else -6.0, "cast")
			"camp_up":
				var ckd: Dictionary = Sim.CAMP_KINDS[String(e.get("kind", "ancient"))]
				minimap.ping(e["p"], Color(String(ckd["col"])), int(e["a"]))
				if int(e["team"]) == me.team and sim.mode != "survival":
					push_alert("camp_up" + String(e.get("kind", "")), "The %s is up on your road: clear it for the %s." % [ckd["name"], ckd["bless"]], Color(String(ckd["col"])), 20.0, "alert")
			# ---- 0.49 contests ----
			"contest_soon":
				var ckn: Dictionary = Sim.CONTESTS[String(e["kind"])]
				push_alert("contest_soon", "Next round: %s. %s" % [ckn["name"], ckn["desc"]], Color(String(ckn["col"])), 20.0, "alert")
			"contest_start":
				var cks: Dictionary = Sim.CONTESTS[String(e["kind"])]
				announce(String(cks["name"]).to_upper(), "%s  ·  first team to finish: %s" % [cks["desc"], cks["short"]], 2, 4.5)
				audio.play("omen", -4.0, "boss")
				for q in Sim.contest_points(String(e["kind"])):
					minimap.ping(q, Color(String(cks["col"])), myt())
			"contest_point":
				if int(e["team"]) == me.team:
					audio.play("boon", -6.0, "click")
					minimap.ping(e["p"], Color(String(Sim.CONTESTS[String(e["kind"])]["col"])), int(e["a"]))
			"contest_done":
				var ckd2: Dictionary = Sim.CONTESTS[String(e["kind"])]
				if int(e["team"]) == me.team:
					if e.get("first", false):
						announce(String(ckd2["bless"]), "Your team won %s: %s for %d seconds  ·  +%d gold each" % [ckd2["name"], ckd2["short"], int(Sim.CONTEST_BLESS), int(e["gold"])], 2)
						audio.play("duel_win", -1.0)
					else:
						announce("%s done" % ckd2["name"], "The enemy got there first  ·  +%d gold each" % int(e["gold"]))
						audio.play("coin", -2.0)
				elif e.get("first", false):
					push_alert("contest_enemy", "The enemy team won %s and took %s. Finish yours for half the gold." % [ckd2["name"], ckd2["bless"]], ENEMY_TXT, 10.0, "alert")
			"contest_end":
				if int(e.get("first", -1)) < 0:
					push_alert("contest_none", "Nobody finished %s in time." % Sim.CONTESTS[String(e["kind"])]["name"], Color(0.8, 0.8, 0.75), 10.0, "alert")
			# ---- end 0.49 contests ----
			"camp_cleared":
				var ckd: Dictionary = Sim.CAMP_KINDS[String(e.get("kind", "ancient"))]
				if int(e["team"]) == me.team:
					announce(String(ckd["bless"]), "Your team: %s for %d seconds  ·  +%d gold each" % [ckd["short"], int(Sim.BLESS_TIME), int(e["gold"])])
					audio.play("duel_win", -2.0)
				else:
					push_alert("camp_enemy", "The enemy team cleared their %s and are blessed." % ckd["name"], ENEMY_TXT, 20.0, "alert")
			"totems":
				minimap.ping(e["p"], Color(0.5, 1.0, 0.5), int(e["a"]))
				if int(e["a"]) == me.team:
					push_alert("totems", "The Warden raised its totems: destroy them to break its shield!", Color(0.6, 1.0, 0.55), 10.0, "cast_summon")
			"dive":
				if _heard(e):
