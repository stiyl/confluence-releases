func _pick_mode_card(m: String) -> void:
	game_mode = m
	_refresh_modes()
	# ---- 0.45 codex ---- the first time a mode is chosen: how it works (never in the way of a quick start)
	if mode_card != null:
		if mode_card.is_open() and mode_card.cur != m:
			mode_card.dismiss(mode_card.shown_t >= mode_card.SEEN_AFTER)
		mode_card.maybe_show(m, modes_ov, mode_cards.get(m))


# ---- 0.44.1 polish ---- roomy (1920x1080 at 100%: the 0.44 look) or compact (1280 wide, 720 tall, big UI scales):
# smaller margins and title, cards with the picture and the name only, and the selected mode's line below the row.
func _modes_fit() -> void:
	if modes_ov == null or modes_grid == null:
		return
	var vp: Vector2 = modes_ov.size
	if vp.x < 100.0:
		return
	# 0 roomy (1600x900: 1080p at 100%), 1 compact with three lines of text (1280x800: the Deck at 125%, 140%),
	# 2 bare cards (1143x643: 720p at 140%)
	var compact := 0 if (vp.y >= 820.0 and vp.x >= 1500.0) else (1 if vp.y >= 700.0 else 2)
