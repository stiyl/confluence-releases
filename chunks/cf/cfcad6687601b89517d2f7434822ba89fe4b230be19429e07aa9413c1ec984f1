static func _fc_norm(c: String) -> String:
	return c.strip_edges().to_upper().replace("-", "").replace(" ", "")


# Host: someone asks to watch. x: {"spec": true, "fc", "party", "since"?, "mid"?} (since/mid: a spectator already in
# the match asks the new host, after a migration, for what it missed).
func _accept_spectator(pid: int, pname: String, x: Dictionary) -> void:
	var mode := spec_mode()
	var known := spec_peers.has(pid)
	if not known:
		if mode == "off":
			_kick.rpc_id(pid, "%s doesn't allow spectators in this match." % my_name)
			return
		var in_party := party_code != "" and String(x.get("party", "")) == party_code
		if mode == "party" and not in_party:
			_kick.rpc_id(pid, "Only %s's party may watch this match." % my_name)
			return
		if mode == "friends":
			var fc := _fc_norm(String(x.get("fc", "")))
			var ok := fc != "" and friend_check.is_valid() and bool(friend_check.call(fc))
			if not ok and not in_party:
				_kick.rpc_id(pid, "Only %s's friends may watch this match." % my_name)
				return
		if spec_peers.size() >= MAX_SPECT:
			_kick.rpc_id(pid, "That match already has %d spectators." % MAX_SPECT)
			return
		if peer_slot.has(pid):
			return   # a player can't also watch
		spec_peers[pid] = {"name": pname, "fc": String(x.get("fc", "")).substr(0, 9)}
	_peer_seen[pid] = Time.get_ticks_msec()
	_spec_roster.rpc(spec_peers)
	_spec_ok.rpc_id(pid, in_match)
	if in_match:
		_send_catchup(pid, -1, int(x.get("since", -1)), int(x.get("mid", 0)))
	else:
		_push_lobby()
	if not known:
		_chat_all("%s is watching." % pname)
	spectators_changed.emit()


func spectator_names() -> Array:
	var out: Array = []
	for pid in spec_peers:
		out.append(String(spec_peers[pid].get("name", "?")))
