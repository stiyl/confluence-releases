func _upd_refresh() -> void:
	if upd_plaque == null or updater == null:
		return
	var st := updater.state
	upd_plaque.visible = (st == Updater.DOWNLOADING or st == Updater.READY) and notes_ov == null
	upd_btn.visible = st == Updater.READY
	if st == Updater.READY:
		upd_lbl.text = "Update %s ready" % updater.latest_ver
	elif st == Updater.DOWNLOADING:
		upd_lbl.text = "Downloading update %s  ·  %d%%" % [updater.latest_ver, int(updater.progress * 100.0)]


func _notes_versions() -> Array:
	var f := FileAccess.open(NOTES_PATH, FileAccess.READ)
	if f == null:
		return []
	var d = JSON.parse_string(f.get_as_text())
	var out: Array = d.get("versions", []) if d is Dictionary else []
	out.sort_custom(func(a, b): return Updater.cmp(String(a.get("version", "")), String(b.get("version", ""))) > 0)
	return out


# At launch: notes for every version newer than the last one shown. A brand-new player gets none (the tutorial
# offer greets them) and starts counting from here; a tester coming from a build before 0.24 sees this version's.
func _patch_notes_auto() -> void:
	var cur := Updater.version()
	if Settings.last_notes == "" and Profile.games == 0 and not Profile.tutorial_done:
		Settings.last_notes = cur
		Settings.save()
		return
	if Settings.last_notes == "" or Updater.cmp(cur, Settings.last_notes) > 0:
		# 0.24.1: a tester who still has to choose a profile name gets that prompt first; the notes follow it
		if account != null and not account.has_name():
			if not account.changed.is_connected(_patch_notes_auto):
				account.changed.connect(_patch_notes_auto, CONNECT_DEFERRED)
			return
		if account != null and account.changed.is_connected(_patch_notes_auto):
			account.changed.disconnect(_patch_notes_auto)
		open_patch_notes(true)


func open_patch_notes(auto: bool) -> void:
	var cur := Updater.version()
	var since := Settings.last_notes
	var vers := []
	for e in _notes_versions():
		var v := String(e.get("version", ""))
		if Updater.cmp(v, cur) > 0:
			continue   # written for a build that isn't out yet
		if auto and since != "" and Updater.cmp(v, since) <= 0:
			continue
		vers.append(e)
	vers = vers.slice(0, 1 if auto and since == "" else (6 if auto else 12))
	if since == "" or Updater.cmp(cur, since) > 0:
		Settings.last_notes = cur
		Settings.save()
	if vers.is_empty() or menu == null:
		return
	if notes_ov != null:
		notes_ov.queue_free()
	# a stone plaque right of the menu column (the update plaque and the tutorial offer step aside meanwhile)
	var pl := UIParts.Plaque.new(26.0, 20.0)
	set_anchor_rect(pl, 1, 0, 1, 1, -660, 72, -52, -72)
	pl.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	menu.add_child(pl)
	pl.z_index = 20   # 0.32.5: over the party bar (the bar steps aside while the notes are open, see party_ui.gd)
	notes_ov = pl
	var v := vbox(12)
	pl.add_child(v)
	v.add_child(head_lbl("What's new" if auto else "Patch notes", 30, GOLD, 4))
	var sc := ScrollContainer.new()
	sc.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	sc.size_flags_vertical = SIZE_EXPAND_FILL
	v.add_child(sc)
	var inner := MarginContainer.new()
	inner.size_flags_horizontal = SIZE_EXPAND_FILL
	inner.add_theme_constant_override("margin_right", 16)   # text stays clear of the scrollbar
	sc.add_child(inner)
	var body := vbox(7)
	body.size_flags_horizontal = SIZE_EXPAND_FILL
	inner.add_child(body)
	for i in vers.size():
		if i > 0:
			var gap := Control.new()
			gap.custom_minimum_size = Vector2(0, 8)
			body.add_child(gap)
		body.add_child(head_lbl("Version %s" % String(vers[i].get("version", "")), 20, GOLD, 3))
		for n in vers[i].get("notes", []):
			var sub := String(n).begins_with("  ")
			var l := lbl(("      –  " if sub else "•  ") + String(n).strip_edges(), 14 if sub else 15, MUTED if sub else TEXT, true, 2)
			body.add_child(l)
	var br := hbox(8)
	br.alignment = BoxContainer.ALIGNMENT_END
